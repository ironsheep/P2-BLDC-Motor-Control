'' =================================================================================================
''
''   File....... demo_single_motor.spin2
''   Purpose.... Demonstrate control of a single BLDC Motor, and reading what the drive reports
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2022 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Feb 2022
''   Updated.... 03 Oct 2026
''
''   What it shows, in order:
''   1. start() checks the motor before anything moves, and refuses one that fails -- how to tell why (getHealth())
''   2. checkWiring(): an opt-in check that turns the wheel a little to prove the hall and phase wiring
''   3. the fault response in effect (FR_GRADED by default), and how to choose another (setFaultResponse())
''   4. driving: always arm a limit BEFORE the drive it guards, so the motor never runs without one
''   5. after each drive: why it ended (getStopReason()), and what the drive handled on its own (getEvent())
''
'' =================================================================================================

' Select the single-motor configuration in isp_bldc_motor_userconfig.spin2
#DEFINE CFG_SINGLE_MOTOR
#IFDEF __PNUT_TS__
#PRAGMA EXPORTDEF CFG_SINGLE_MOTOR
#ENDIF

CON { timing }

  ' The motor objects work at any clock from the lowest start() accepts up to 350 MHz (DEVELOP.md, "Choosing a clock").
  '  With the HDMI display in use, its video driver sets the clock its mode needs (270 MHz) when it starts, which is
  '  before the motor starts (it takes its timing from the clock at start()).
  CLK_FREQ = 270_000_000                                        ' system freq as a constant
  _clkfreq = CLK_FREQ                                           ' set system clock

CON { fixed io pins }

  RX1      = 63  { I }                                          ' programming / debug
  TX1      = 62  { O }

  SF_CS    = 61  { O }                                          ' serial flash
  SF_SCK   = 60  { O }
  SF_SDO   = 59  { O }
  SF_SDI   = 58  { I }

CON { application io pins }

    ' describe where things are attached to our JonnyMac eval board

    HDMI_BASE_PIN       = tvDebug.PINS_P8_P15

CON { the demo's drives }

    MTR_HOLD_AT_SPEED_IN_SEC = 15       ' each time-limited drive's limit
    END_HOLD_MS         = 20_000        ' a pause after the last drive, before stop(): the HDMI display stays live to read
    HOLD_SLICE_MS       = 1_000         ' END_HOLD_MS is waited in slices this long, under waitms()'s bound at any clock

    ' bWaitUntilMotorDone()'s bound: the limit armed for the drive, plus this for the ramp down and a margin. A drive that
    '  is not over by then is stopped, and reported: something ended it late, or its limit never fired.
    MOVE_MARGIN_MS      = 5_000
    MOVE_POLL_MS        = 10

OBJ { our Motor(s) }

#ifdef BENCH_CFG
    user        :   "isp_bldc_motor_userconfig_bench"   ' bench rig configuration (-D BENCH_CFG, tools/bench-run.sh demo-single)
#else
    user        :   "isp_bldc_motor_userconfig"     ' driver configuration
#endif
    tvDebug     :   "isp_hdmi_debug"         ' HDMI debug object
    wheel       :   "isp_bldc_motor"        ' the single BLDC motor
    names       :   "demo_drive_names"      ' words for the drive's reported values, for the debug output

CON { the motor this demo drives }

#ifdef BENCH_CFG
    ' The bench rig is a two-wheel platform, so its config names no ONLY_* motor: this demo drives its RIGHT wheel (the
    '  P16 board), as the bench's single-motor tiers do. Bench builds only; a normal build reads the ONLY_* values.
    MOTOR_BASE          = user.RIGHT_MOTOR_BASE
    MOTOR_BOARD_TYPE    = user.RIGHT_BOARD_TYPE
#else
    MOTOR_BASE          = user.ONLY_MOTOR_BASE
    MOTOR_BOARD_TYPE    = user.ONLY_BOARD_TYPE
#endif

DAT { run-time condition vars }

    bUseHDMI    LONG   TRUE       ' set to TRUE to enable HDMI use/output


PUB main() | nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars, motorCog, basePin, voltage, motor, detectMode, eError
'' DEMO Driving a single wheeled platform
''

' Local Variables:
' @local nGroups - number of display groups in the tables
' @local pGroupTitles - pointer to the table of group-title string pointers
' @local pGroupNames - pointer to the table of variable-name string pointers, by group
' @local pGroupVarCts - pointer to the table of variable counts, one per group
' @local pGroupVars - pointer to the table of variable-value pointers, by group
' @local motorCog - the motor driver's cog id (0-7), or -1 when it did not start
' @local basePin - the validated HDMI base pin, then the validated motor base pin (INVALID_PIN_BASE when not legal)
' @local voltage - the validated drive voltage, or INVALID_VOLTAGE
' @local motor - the validated motor type, or INVALID_MOTOR
' @local detectMode - the validated board detection mode, or INVALID_DET_MODE
' @local eError - the start error, or the result of the latest command (the limit, then the drive it guards)

    showLine(@"* single motor demo")

    ' start our HDMI debug output
    if bUseHDMI
        basePin := tvDebug.validBasePinForChoice(HDMI_BASE_PIN)
        if basePin <> tvDebug.INVALID_PIN_BASE
            tvDebug.start(basePin)
            showLine(@"* HDMI started")
        else
            showLine(@"* ERROR HDMI base pin not valid: no display")

    ' validate user settings/choices
    '  do NOT start motor unless all are legit!
    basePin := wheel.validBasePinForChoice(MOTOR_BASE)
    detectMode := wheel.validDetectModeForChoice(MOTOR_BOARD_TYPE)
    voltage := wheel.validVoltageForChoice(user.DRIVE_VOLTAGE)
    motor := wheel.validMotorForChoice(user.MOTOR_TYPE)

    if basePin <> wheel.INVALID_PIN_BASE and voltage <> wheel.INVALID_VOLTAGE and motor <> wheel.INVALID_MOTOR and detectMode <> wheel.INVALID_DET_MODE
        ' 1. start() checks the hall sensors, current sense and motor leads with nothing moving, retries a check
        '  that fails, and refuses to start if one still fails. TRUE is the default; setStartChecks(false), called
        '  before start(), starts the motor anyway (getHealth() still reports what failed).
        wheel.setStartChecks(true)

        ' start our single motor driver and its front cog, which enforces the stop limits (2 cogs)
        motorCog := wheel.start(basePin, voltage, detectMode)
        if motorCog < 0
            ' start() refused: the cause is waiting in getError(). A refused start check is ERR_START_CHECK_FAILED,
            '  and getHealth() then names the check -- a disconnected motor lead, say
            eError := wheel.getError()
            dbgBegin(@"* ERROR motor did not start: ")
            dbgText(names.errorName(eError))
            dbgShow()
            showHealth()
        else
            showHealth()                                        ' what the start checks found, even when they passed
            showPack()

            if bUseHDMI
                nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars := wheel.getDebugData()
                showReceived(@"* Received:", nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars)

                tvDebug.registerDisplay(nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars)

            ' coast at rest: the default, set here so you can find it. holdAtStop(true) holds the shaft's position at
            '  rest instead, drawing current to do it
            wheel.holdAtStop(false)
            ' override the default top speed (75 %) with 100 % for this demo
            wheel.setMaxSpeed(100)

            ' wait until the driver is ready to be commanded, before anything moves
            waitUntilMotorReady()

            ' 2. prove the wiring. This TURNS THE MOTOR one electrical cycle forward and back (a quarter turn of the
            '  DocoEng motor's shaft; on a wheel, that turn's share of its tyre). Its verdict is getHealth()'s HLT_WIRING bit.
            if bCommandSucceeded(wheel.checkWiring(), @"checkWiring")
                showWiring()

            ' 3. what the motor does if its rotor cannot follow the field (an overload or a stall)
            showFaultResponse()

            ' 4. now drive! -- always arm the limit BEFORE driving, so the motor never runs without one
            showLine(@"* FWD at 100 % power")
            eError := wheel.stopAfterTime(MTR_HOLD_AT_SPEED_IN_SEC, wheel.DTU_SEC)      ' stop after MTR_HOLD_AT_SPEED_IN_SEC
            if eError == wheel.NO_ERROR
                eError := wheel.driveAtPower(100)                       ' then go FWD at 100 % power
            if bCommandSucceeded(eError, @"FWD run")
                bWaitUntilMotorDone(MTR_HOLD_AT_SPEED_IN_SEC * 1_000 + MOVE_MARGIN_MS)
            showWhatHappened()                                  ' 5. expect SR_AT_LIMIT: the time limit was reached

            showLine(@"* REV at 100 % power")
            eError := wheel.stopAfterTime(MTR_HOLD_AT_SPEED_IN_SEC, wheel.DTU_SEC)      ' stop after MTR_HOLD_AT_SPEED_IN_SEC
            if eError == wheel.NO_ERROR
                eError := wheel.driveAtPower(-100)                      ' then go REV at 100 % power
            if bCommandSucceeded(eError, @"REV run")
                bWaitUntilMotorDone(MTR_HOLD_AT_SPEED_IN_SEC * 1_000 + MOVE_MARGIN_MS)
            showWhatHappened()

            dbgBegin(@"* holding ")
            dbgUdec(END_HOLD_MS / 1_000)
            dbgText(@" s before stop()...")
            dbgShow()
            repeat END_HOLD_MS / HOLD_SLICE_MS                  ' in slices: one waitms() over 2^31 clocks returns at once
                waitms(HOLD_SLICE_MS)

        ' turn off our motor drivers (safe whether or not they started)
        wheel.stop()
    else
        showLine(@"* ERROR user configuration NOT valid!")

    showLine(@"* DONE")
#ifdef BENCH_CFG
    ' bench builds only (tools/bench-run.sh demo-single): the marker that closes the terminal session. Plain text, not
    '  backticked -- a backtick makes it a display command, and pnut-term-ts never sees the marker.
    showLine(@"DEBUG_END_SESSION")
#endif

PRI bCommandSucceeded(eError, pWhat) : bSucceeded | eFirstError
' Report a refused command, and collect its error so the next failure records its own cause.
'
' @param eError - the result a command returned
' @param pWhat - pointer to a short name of what was attempted, for the report
' @returns bSucceeded - T/F where T means the command was accepted and its motion can be waited on

' Local Variables:
' @local eFirstError - this cog's first recorded error, collected (outside debug(), which a non-debug build removes)

    bSucceeded := (eError == wheel.NO_ERROR)
    if bSucceeded == FALSE
        eFirstError := wheel.getError()
        dbgBegin(@"* ERROR ")
        dbgText(pWhat)
        dbgText(@" refused: ")
        dbgText(names.errorName(eError))
        dbgText(@" (first: ")
        dbgText(names.errorName(eFirstError))
        dbgText(@")")
        dbgShow()

PRI showHealth() | nChecked, nFailed, nRecovered
' Report what start() checked, which checks failed, and which failed at first and passed on a retry.
'
' getHealth() returns three masks of HLT_* bits. A recovered check started the motor normally -- worth knowing
' about (a loose connector can look like that), but not a failure.

' Local Variables:
' @local nChecked - the HLT_* bits that were checked
' @local nFailed - ...that still failed
' @local nRecovered - ...that failed, then passed on a retry

    nChecked, nFailed, nRecovered := wheel.getHealth()
    dbgBegin(@"* start checks: checked ")
    dbgHex(nChecked, 2)
    dbgShow()
    showHealthBits(@"FAILED", nFailed)
    showHealthBits(@"recovered on a retry", nRecovered)

PRI showHealthBits(pWhat, nBits) | nBit
' Name each check set in a getHealth() mask.
'
' @param pWhat - pointer to what the mask means (failed, or recovered)
' @param nBits - the mask of HLT_* bits

' Local Variables:
' @local nBit - the bit being tested

    repeat nBit from 0 to names.HEALTH_BITS - 1
        if nBits & (1 << nBit)
            dbgBegin(@"*   ")
            dbgText(names.healthBit(nBit))
            dbgText(@" ")
            dbgText(pWhat)
            dbgShow()

PRI showWiring() | nFailed
' Report checkWiring()'s verdict: its HLT_WIRING bit in getHealth()'s failed mask.

' Local Variables:
' @local nFailed - the failed bits

    _, nFailed, _ := wheel.getHealth()
    dbgBegin(@"* wiring: ")
    dbgText((nFailed & wheel.HLT_WIRING) ? @"FAILED" : @"ok")
    dbgShow()

PRI showPack() | ePackStatus, nMilliVolts
' Report the battery pack's voltage, when the optional pack voltage sensor is fitted (VOLTAGE-SENSOR.md).

' Local Variables:
' @local ePackStatus - PACK_NOT_FITTED, PACK_ABSENT or PACK_PRESENT
' @local nMilliVolts - the pack voltage, mV, when PACK_PRESENT

    ePackStatus, nMilliVolts := wheel.getPackVoltage()
    dbgBegin(@"* pack: ")
    dbgText(names.packStatus(ePackStatus))
    dbgText(@" ")
    dbgUdec(nMilliVolts)
    dbgText(@" mV")
    dbgShow()

PRI showFaultResponse() | eMode, brakePct
' Report the fault response in effect.
'
' FR_GRADED, the default, re-syncs from the hall sensors and stops along the ramp when the rotor cannot follow its
' field; if control is lost anyway it coasts, or with holdAtStop(TRUE) brakes at 10 %. FR_SHIPPED coasts or brakes
' with the full short at once (per holdAtStop()) instead:
'   wheel.setFaultResponse(wheel.FR_SHIPPED, 10)
' start() restores the default, so a program sets its choice after each start().

' Local Variables:
' @local eMode - FR_SHIPPED or FR_GRADED
' @local brakePct - the graded brake's share of a full short, %

    eMode, brakePct := wheel.getFaultResponse()
    dbgBegin(@"* fault response: ")
    dbgText(names.faultResponse(eMode))
    dbgText(@", brake ")
    dbgUdec(brakePct)
    dbgText(@" %")
    dbgShow()

PRI showWhatHappened() | eReason
' After a drive: why it ended, then every event the drive logged since the last look.
'
' getStopReason() answers "why did it stop?" -- SR_AT_LIMIT for a limit you armed, SR_COMMANDED for a stop you
' asked for, and otherwise something you did NOT ask for: a fault, a blocked wheel, a lost link, an emergency stop.
' It stays readable until the next drive command.

' Local Variables:
' @local eReason - the SR_* value

    eReason := wheel.getStopReason()
    dbgBegin(@"* stopped: ")
    dbgText(names.stopReason(eReason))
    dbgShow()
    showEvents()

PRI showEvents() | eKind, nMs, nValue
' Drain this cog's event log: what the drive handled on its own, oldest first.
'
' Each cog reads every event for itself. A cog that falls more than EV_QUEUE_DEPTH events behind is told first, with
' EV_LOST (its value: how many it lost) -- so a gap never reads as "nothing happened". EV_STOP's value is the stop
' reason; most others carry a count or a measurement (DRIVE-OBJECTS.md, "Stop reasons and events").

' Local Variables:
' @local eKind - the event's EV_* kind; EV_NONE when all are read
' @local nMs - getms() when it happened
' @local nValue - the event's value

    repeat
        eKind, nMs, nValue := wheel.getEvent()
        if eKind == wheel.EV_NONE
            quit
        dbgBegin(@"*   event ")
        dbgUdec(nMs)
        dbgText(@" ms ")
        dbgText(names.eventKind(eKind))
        dbgText(@" ")
        if eKind == wheel.EV_STOP
            dbgText(names.stopReason(nValue))                  ' a stop's value is its reason, SR_*
        else
            dbgSdec(nValue)
        dbgShow()

PRI waitUntilMotorReady()
' if the motor is NOT ready, then wait until it is

    if wheel.isReady() == false
        showLine(@"* wait motor ready...")
        repeat
            if wheel.isReady()
                quit
            else
                waitms(2)
    showLine(@"* Motor ready, let's drive!")


PRI bWaitUntilMotorDone(maxMs) : bDone | startMs, eReason, eError
' Wait, at most {maxMs}, for the drive just commanded to be over -- however it ends -- then say why it ended.
'
' isMoveDone() is TRUE once the motor is at rest with no drive commanded, and at once on a fault, an emergency stop or
' a protective stop, so this cannot hang on one of those (waiting for isStopped() alone did). It is FALSE from the
' moment the drive command is accepted, so no short-lived state can be missed between polls. The bound covers the one
' case it cannot: a drive whose limit never fires. Then the motor is stopped here, and getError() is reported.
'
' @param maxMs - the longest the drive may take, ms: its limit plus a margin
' @returns bDone - T/F where T means the drive ended by itself within {maxMs}

' Local Variables:
' @local startMs - getms() when the wait began
' @local eReason - why the drive ended, getStopReason()
' @local eError - this cog's first recorded error, on a timeout (collected outside debug(), which a non-debug build removes)

    showLine(@"* wait until motor finishes...")
    startMs := getms()
    repeat until wheel.isMoveDone() or (getms() - startMs >= maxMs)
        waitms(MOVE_POLL_MS)
    bDone := wheel.isMoveDone()
    if bDone == FALSE
        wheel.stopMotor()                                       ' the drive outlived its bound: end it, then report
        eError := wheel.getError()
        dbgBegin(@"* TIMEOUT: the drive was not over after ")
        dbgUdec(maxMs)
        dbgText(@" ms, stopped; error: ")
        dbgText(names.errorName(eError))
        dbgShow()
    eReason := wheel.getStopReason()
    dbgBegin(@"* Motor done in ")
    dbgUdec(getms() - startMs)
    dbgText(@" ms: ")
    dbgText(names.stopReason(eReason))
    dbgShow()

PRI showReceived(pLead, nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars)
' Print the display-table set main() is about to register, after a lead-in, each value labelled with main()'s name
' for it.
'
' @param pLead - pointer to the text before the values
' @param nGroups - number of display groups in the tables
' @param pGroupTitles - pointer to the table of group-title string pointers
' @param pGroupNames - pointer to the table of variable-name string pointers, by group
' @param pGroupVarCts - pointer to the table of variable counts, one per group
' @param pGroupVars - pointer to the table of variable-value pointers, by group

    dbgBegin(pLead)
    dbgText(@" nGroups = ")
    dbgUdec(nGroups)
    dbgText(@", pGroupTitles = ")
    dbgHex(pGroupTitles, 8)
    dbgText(@", pGroupNames = ")
    dbgHex(pGroupNames, 8)
    dbgText(@", pGroupVarCts = ")
    dbgHex(pGroupVarCts, 8)
    dbgText(@", pGroupVars = ")
    dbgHex(pGroupVars, 8)
    dbgShow()

PRI showLine(pText)
' Print one line of fixed text.
'
' @param pText - pointer to the zero-terminated text to print

    dbgBegin(pText)
    dbgShow()

CON { the debug line builder }

' WHY THIS DEMO BUILDS ITS DEBUG LINES. Each debug() statement is compiled into its own record, its text and its
' formatting included, and a -d image drops every record that lies too far into it (DOCs/procedures/
' PLOT-DISPLAY-RULES.md, rules 1-2). So this demo builds each line it prints in a hub buffer, with ordinary code that
' is in the image with or without -d, and prints it with the one debug() in dbgShow(). A line is started with
' dbgBegin(), extended with dbgText() / dbgUdec() / dbgSdec() / dbgHex() / dbgWheels(), and printed with dbgShow().
' The numbers come out as the debug formatters print them: dbgUdec() as udec_() and dbgSdec() as sdec_() (an
' underscore every three digits, 20_711), dbgHex() as uhex_byte_() or uhex_long_() ($0F, $09F4_9F49). A labelled
' formatter such as sdec(x) prints "x = 5", and ", " between two values in a row; those are written here as text.
' One cog -- the demo's main cog -- builds and prints lines.

    DBG_LINE_BYTES = 256                ' the longest line here is under 200 bytes; anything past the end is dropped

VAR

    byte    dbgLine[DBG_LINE_BYTES]     ' the line being built, zero-terminated
    long    dbgLineLen                  ' its length, not counting the terminator

PRI dbgBegin(pText)
' Start a new debug line with {pText}.
'
' @param pText - pointer to the line's first text

    dbgLineLen := 0
    dbgLine[0] := 0
    dbgText(pText)

PRI dbgText(pText)
' Append zero-terminated text to the debug line.
'
' @param pText - pointer to the text

    repeat strsize(pText)
        dbgChar(byte[pText++])

PRI dbgWheels(pLeft, pRight)
' Append the two wheels' words: "LEFT <left>, RIGHT <right>".
'
' @param pLeft - pointer to the left wheel's word
' @param pRight - pointer to the right wheel's word

    dbgText(@"LEFT ")
    dbgText(pLeft)
    dbgText(@", RIGHT ")
    dbgText(pRight)

PRI dbgUdec(nValue) | nPlace, nDigits
' Append {nValue} as an unsigned decimal, as udec_() prints it: an underscore every three digits (20_711).
'
' @param nValue - the value, taken as unsigned

' Local Variables:
' @local nPlace - the place value of the digit being appended (1, 10, 100 ...)
' @local nDigits - digits still to append

    nPlace := 1
    nDigits := 1
    repeat while (nPlace < 1_000_000_000) and ((nValue +/ nPlace) >= 10)    ' +/ and +// are the unsigned divides
        nPlace *= 10
        nDigits++
    repeat
        dbgChar("0" + ((nValue +/ nPlace) +// 10))
        nPlace /= 10
        nDigits--
        if (nDigits > 0) and (nDigits // 3 == 0)
            dbgChar("_")
    until nDigits == 0

PRI dbgSdec(nValue)
' Append {nValue} as a signed decimal, as sdec_() prints it (-15_090_904).
'
' @param nValue - the value

    if nValue < 0
        dbgChar("-")
        nValue := 0 - nValue            ' -2_147_483_648 stays $8000_0000, which dbgUdec() prints as 2_147_483_648
    dbgUdec(nValue)

PRI dbgHex(nValue, nDigits) | nNibble
' Append the low {nDigits} hex digits of {nValue} after a "$", with an underscore every four digits, as uhex_byte_()
' (2 digits, $0F) and uhex_long_() (8 digits, $09F4_9F49) print them.
'
' @param nValue - the value
' @param nDigits - how many hex digits to append

' Local Variables:
' @local nNibble - the digit's value, 0 to 15

    dbgChar("$")
    repeat while nDigits > 0
        nDigits--
        nNibble := (nValue >> (nDigits << 2)) & $F
        dbgChar(nNibble < 10 ? "0" + nNibble : "A" + nNibble - 10)
        if (nDigits > 0) and (nDigits // 4 == 0)
            dbgChar("_")

PRI dbgChar(charByte)
' Append one character to the debug line, dropping any past its end.
'
' @param charByte - the character

    if dbgLineLen < DBG_LINE_BYTES - 1
        dbgLine[dbgLineLen] := charByte
        dbgLineLen++
        dbgLine[dbgLineLen] := 0

PRI dbgShow()
' Print the debug line: this demo's one debug() statement (the section's header says why).

    debug(zstr_(@dbgLine))

CON { license }
