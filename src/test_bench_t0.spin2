''               17 Sep 2026 -- SRC_REV=3: this tier is now built with -D BENCH_QUIET (PL-74). No line
''               of this file changes behaviour; only the LIBRARY's debug channels are quieted, and this
''               binary judges RETURN CODES, not library chatter -- every cell below prints through a
''               plain debug() that no channel mask touches. WHY: at SRC_REV 2 this tier emitted NOTHING
''               on two separate runs, on two machines and two pnut-ts versions, from images that were
''               MEASURED to be debug builds (43_784 bytes with -d against 25_764 without). SRC_REV 2 is
''               also what added motorP and steer, taking this binary to SIX isp_bldc_motor instances
''               plus a steering object -- more than any other tier, and the only one compiled with the
''               library's nine channels live in all of them. MEASURED: -D BENCH_QUIET removes 2_866
''               bytes of library debug data from this build. THAT IS A HYPOTHESIS WITH A TEST, NOT AN
''               ESTABLISHED CAUSE; PL-74 records what the next run discriminates either way.
''               17 Sep 2026 -- task 3570, SRC_REV 4: T0-23 / R17-T0-NOBOARDSTART (PL-73): a start() on
''               the empty group is refused with ERR_BOARD_NOT_DETECTED and leaks nothing.
''               18 Sep 2026 -- task 3517, SRC_REV 5: style guide 5.4.1 -- waitReady() is bWaitReady(). No
''               line changes.
''               18 Sep 2026 -- task 3543, SRC_REV 7 (PL-41, PL-85): the cog bursts that cut records at
''               Visit 5 are designed out. benchLog.countFreeCogs() counts with COGCHK() and starts nothing; T0-8,
''               T0-15b and T0-22 share one occupancy in runExhaustionPhase(), run last (T0-22 moves there,
''               a new T0-EXH line brackets the phase); every start()/stop() and spacer burst sits in a
''               benchLog cog-event quiet window. Every cell id, criterion and record format is unchanged.
''               19 Sep 2026 -- task 3577, SRC_REV 8: three cells for task 3569's API promises, which no
''               cell could certify. R17-T0-ACCEL (G): T0-5 becomes a cell -- setAcceleration() refuses a
''               rate outside its range and changes nothing, and an accepted rate is a constant mm/s^2 ramp
''               anchored on the library's own default. R17-T0-KMMI (K), in T0-3 on its running motor:
''               kilometres and miles convert exactly and can be commanded. R17-T0-VOLTGET (AK), in T0-19:
''               the drive voltage getter answers on both objects, and not before a start.
''               19 Sep 2026 -- task 3574, SRC_REV 9: prints for findings fixed in source are retired. T0-1
''               becomes R17-T0-DEADGAP (A1: the dead gap is at least 250 ns at this clock); T0-2 (A2/A3) and
''               T0-4 (O) are deleted, T0-4's testSetup() moving into T0-5; T0-10 drops its start_return
''               print (AD+). Cell R17-T0-DEADGAP is new; every other cell is unchanged.
''               23 Sep 2026 -- task 3585, SRC_REV 11: the build now fits its DEBUG data (DBG-1). Records
''               past image offset 13,684 were cut or never sent: t0-hand and t0-stopmode lost their whole
''               panels, and t0 lost R17-T0-NOBOARDSTART and R1-T0-EXHAUST (PL-94). T0_ATTENDED compiles
''               the unattended test bodies out of both attended builds (DBG-16). Literal SIGNOFF and
''               SIGNOFF-DECL lines now go through emitCellBool(), emitCellDecl() and the new emitCellNum()
''               from hub strings (DBG-2). Footprints: t0 16,004 -> 10,511, t0-hand 15,674 -> 7,592,
''               t0-stopmode 16,611 -> 8,529 bytes. No record's text changes.
''               23 Sep 2026 -- task 3613, SRC_REV 12: a hand row waits for the hand. At Visit 10 every hand
''               row ended before Stephen touched the wheel. A hold row's watch bound ran from START, so
''               rows 1 and 2 ended 2 s and 3 s after START. A coast row's 400 ms rest test counted from
''               START, so a wheel not yet spun read as at rest. Now a hold row's bound runs from the
''               first displacement, and a coast row can end at rest only after its first hall tick.
''               Before that, only DONE, ABORT or the 120 s T0_24_HAND_CAP_MS ends a row.
''               24 Sep 2026 -- task 3617, SRC_REV 13 (PL-123, VISIT-10-PASS2-EVALUATION.md SS3.6). Four
''               instrument fixes to T0-24, one per PL-123 item:
''               (1) Each hold row re-arms the hold before it runs (bT0sRearmHold(): SM_FLOAT for
''               T0_24_REARM_MS, then SM_BRAKE again), and is set up only when getHoldStatus() then reads
''               HS_HOLDING at displacement 0 with no fault signal. The watch's first sample must read the
''               same, or the row's cell is NOMEAS. New record T0-24,row,N,rearm; hold_result gains
''               start_hs, start_disp and start_held.
''               (2) The half-rate time is replaced by a speed-invariant reading: band_ticks, the hall ticks
''               the wheel carries from T0_24_BAND_RATE (120 ticks/s) to rest. The band is fixed and the same
''               for every row, so the reading does not depend on how fast the wheel was spun or driven. A
''               row released below the band is NOMEAS (in_band FALSE). The limits are re-derived from the
''               logs on record (CON { T0-24 sign-off limits }). The numeric cells now print units TICKS,
''               and the seven stop cells' criterion tokens are renamed to say so. Every six-tick span now covers six tick
''               intervals, one electrical cycle. Up to SRC_REV 12, t0sProbe() and t0sMeasureSteadyRate()
''               covered five, so their release_span_ms values in older logs are five intervals. The coast
''               row no longer reads the panel's input or redraws it while the wheel is turning. Each such
''               read stops the hall poll for about 30 ms, and at speed that dropped ticks. Records: the
''               coast record and the row record replace half_ms with band_ticks, band_ms and in_band.
''               The coast record also gains band_span_ms and band_entered, and at_rest gains band_entered.
''               (3) The fault rows force the fault with testForceFault() (DRIVER_REV 12+) under FR_SHIPPED,
''               not the offset shift, which plugged the motor instead (PL-119, pass 2 aborted at 10.4 A).
''               The provoke record changes shape. The rows end with testResetFault(), because
''               DCS_FAULTED is a latch since DRIVER_REV 14.
''               (4) The panel names the wheel, RIGHT WHEEL (P16 BOARD), from the first screen on. The
''               window title carries it, and so does the header art (tools/gen_t0stop_assets.py
''               HEADER_TEXT).
''               Same task, the arbiter's ruling on the first round (P7: nothing silent):
''               The art is regenerated. The fault row under SM_BRAKE is labelled "FAULT, BRAKE MODE",
''               since "hold" means only the hold at rest. The spin rows ask for a HARD spin that must
''               pass the measuring speed. A spin row whose try is not measured shows a TOO SLOW cell
''               that keeps the row's prediction, and it is tried again, up to T0_24_SPIN_TRIES (3)
''               (t0sRunSpinRow(), record T0-24,row,N,try). Only then, or when DONE / ABORT ended a try,
''               is it NOMEAS, on a screen that says why (T0_24_ACT_SPIN_NOMEAS). The E-STOP row is spun
''               FREE, and t0sProbe() applies emergencyCutoff() at the band-entry tick: a hand cannot
''               spin a shorted wheel into the band (pass 2 reached 22.5 ticks/s). It counts only when
''               the short was applied there and latched. The coast record gains shorted.
''               t0sBandTick() enters the band only after a release above it.
''               24 Sep 2026 -- task 3619, SRC_REV 14 (PL-127, DOCs/plans/T0-24-INTERACTION-DESIGN.md): T0-24's
''               interaction is rebuilt as a lesson. Stephen, at pass 3: rows moved on without him, the
''               panel did not say enough, DONE and ABORT did nothing, and there was no way to redo a row.
''               - Every row runs INTRO (a preview, then START ROW) -> SETUP -> ACT -> RESULT. A hand row's
''                 ACT ends only on DONE or ABORT, never on a timer: the hold rows' watch bounds and the
''                 120 s cap are gone, and a spin row takes as many spins as he gives it (each a logged try;
''                 the SPIN_TRIES limit is gone). Setup and the two powered rows end by themselves.
''               - The RESULT screen stays until NEXT ROW (FINISH on the last) or REDO ROW. A redo re-runs
''                 the row's setup and ACT; the cells use each row's last run.
''               - Only live buttons are drawn: the forward action in the right slot, ABORT or REDO in the
''                 left. Enter and Esc duplicate them; S, D and SPACE are retired.
''               - Cog 0 is the panel, and polls PC_MOUSE on every pass (~30 ms), because a click is a live
''                 button state. A new measure cog (t0sWorker()) owns the hall poll, the hold samples and
''                 every timed act, and prints nothing. Its tries and hold samples are printed by cog 0
''                 after each step, so the hold_log lines now carry ms and arrive after the row.
''               - New records: T0-24,screen / status / input (every press, with the button it chose,
''                 MISS or IGNORED) / cogs / row,N,run,K,result. The row and hold_result records gain run.
''               - The art is eight layers from tools/gen_t0stop_assets.py, which also prints the screen
''                 table t0sScreenTab that picks each (row, phase)'s banner, card, labels and buttons, and
''                 renders every screen with --storyboard for the desk review.
''               24 Sep 2026 -- SRC_REV 15 (PL-128): the window title loses its parentheses. At src_rev 14 the ')' of
''               '(P16 BOARD)' closed the debug() call, the rest of the line became a comment, and the window opened at
''               the host's default size, a quarter of the panel. No record changes.
''               24 Sep 2026 -- SRC_REV 16 (PL-130, PL-131): HOLD-RISE judges the hold's rise from its rate while
''               displaced (rise_ms, new on the hold_start record), in 220-280 ms, not the wall time from his first
''               push; a slip or limit after the ceiling no longer fails it. Its res1 is rise_ms. Rows 1, 4 and 6
''               ask on the panel for the three deliberate acts (the empty-panel click, a REDO, an ABORT).
''               25 Sep 2026 -- SRC_REV 17 (PL-134, PL-135): HOLD-RISE's rate counts a pair only while getHoldStatus()
''               reads HS_HOLDING at both ends; and the three acts are REQUIRED on their row's first run by a screen
''               drawing only the control that performs each (t0sTestTab): row 1's grey box, row 4's and row 6's REDO,
''               row 6's ABORT. The screen record gains panel_test.
''               25 Sep 2026 -- task 3621 (R20.1 part 3), SRC_REV 18: the driver's reporting (DRIVER-REPORTING-DESIGN.md
''               SS6). New build -D T0_STOPREASON (tier t0-stopreason, UNATTENDED, the RIGHT wheel driven at power 15):
''               T0-25 runs the four stop-reason legs and the event-log checks -- R20-T0-SR-COMMANDED, -SR-ATLIMIT,
''               -SR-ESTOP, -SR-LINKLOST, R20-T0-EV-STOP, -EV-LOST, -EV-TOTAL and -EV-2COG. New records T0-25,leg / ev /
''               lost / total / twocog. T0_ATTENDED becomes T0_OWN_TIER: it compiles the unattended bodies out of every
''               build that runs one test of its own, which now includes an unattended one. T0-24 (t0-stopmode) gains
''               R20-T0-EV-HOLD: after each hold row's ACT, cog 0 reads the event log, and the hand-offs it reports must
''               match the hold states the measure cog saw. New record T0-24,row,N,run,K,events.
''
'' =================================================================================================

{ Rig: the dual 6.5" platform -- two Rev B boards, 18.5V pack.

  BUILD WITH -D BENCH_CFG. That selects isp_bldc_motor_userconfig_bench.spin2,
  a peer config file stating the bench and nothing else, in place of
  isp_bldc_motor_userconfig.spin2. Nobody has to activate a block, and the
  file end users edit is neither read nor written by a bench run:

      pnut-ts -l -d -D BENCH_CFG test_bench_t0.spin2

  It still compiles without the flag -- build-check.sh does exactly that --
  against whichever user block is active. Under a block with
  WHEEL_DIA_IN_INCH = 0.0 the T0-3 and T0-6 distance conversions correctly
  report themselves unavailable rather than returning a tick count.

  Every test below calls testSetup(), which runs the whole of init() -- board
  detection, constant derivation, power tables, unit conversion -- WITHOUT
  starting a driver cog, so the motor rail can stay off and the motor can stay
  unplugged. The exceptions are T0-10 (needs a real, running driver cog so the
  fourth ADC channel is actively calibrated and frame-locked; it still
  commands zero speed, so nothing turns), T0-11 (five real start()/stop()
  cycles reading live telemetry at zero command), T0-13 (a real start() held
  at zero command for 1000 ms), T0-14b (a real start()/stop() cycle to prove
  the post-stop board-type read stays clean), T0-15 (start()/stop() cycles
  probing cog accounting), T0-3 (a stop limit is accepted only by a started
  motor), and T0-17, T0-19, T0-20 and T0-22 (the 6.0.0 start, steering-start,
  rest-zero and front-cog-failure cells). Keep the motor rail on for all of
  these; none of them ever commands nonzero speed.

  Output: one tagged line per data point, "T0-n,field,value,...", on the plain
  debug stream. Sign-off records ("SIGNOFF-DECL,..." / "SIGNOFF,...") are a
  second, separately-tagged stream, read from the log into each visit's
  analysis report (design DOCs/plans/VISIT-SIGNOFF-DESIGN.md).

  TRAPS (task 3539, PL-44/PL-47): a `\`-trap is an exceptional-return-path
  device, not a routine way to capture a normal result (STEPHEN: "traps are
  an exeptional return path - not normal use"). Since the 6.0.0 error contract
  (tasks 3554/3555) the library aborts nowhere: every command returns a status
  (0 or a negative ERR_*) and records it for getError(), and start()/startEx()
  return the cog id 0..7 or -1 with the cause in getError(). So every call below
  is UNTRAPPED and judged by its returned value and getError().

  ONE top-level trap covers the whole suite: main() calls `\runTier0Tests()`
  and prints its trapped value on EVERY run, so an abort nothing anticipated
  still shows up instead of silently ending the session. A testT0_n() that goes
  silent under such an abort skips its own SIGNOFF lines, and any declared cell
  with no verdict is NOMEAS by the host's convention (reason NOT_REACHED).

  T0-1's six derived constants (dead_gap, pwm_limit, duty_min, duty_max,
  adc_fram, frame_cnt) and T0-3 (finding F) both read via two new TEST-USE
  ONLY getters on isp_bldc_motor.spin2: testGetDriveConstants() and
  testGetStopHallTicks(). Both are pure read-only snapshots.

  Every start() here, the steering start included, commands zero speed, so
  nothing turns. If anything behaves unexpectedly: physical battery
  disconnect. emergencyCutoff() latches until clearEmergency() since task
  3556 (S-4 retired), but it is a software stop, not a panic button.

  T0-12 (hand-rotation anchor) is deliberately NOT part of this unattended
  run. It is compiled in only under -D T0_HAND, has its own bench-run.sh tier
  (t0-hand), waits on an operator keypress rather than a timer, and carries
  no sign-off cell.
}

' T0_OWN_TIER is set by every build that runs one test of its own (T0_HAND, T0_STOPMODE, T0_STOPREASON). It
' COMPILES OUT every unattended test body, not just its call: a call gated at run time still compiles its debug()
' records, and this binary's DEBUG data has a hard end. Any record whose bytes lie past image offset 13,684 is cut
' at that byte or never sent -- measured three times: 2026-09-20 t0-hand's PLOT create stopped at
' "hand-rotation an", t0's "T0-23,begin,no_bo" (PL-94) stopped at the same offset, and 2026-09-22's
' USB captures carried no display command at all (P2-HAZARD-REGISTER DBG-1, DBG-16). Gating the bodies
' takes t0-hand's DEBUG footprint from 15,674 to about 7,250 bytes, and changes nothing it prints.
' (Named T0_ATTENDED until task 3621: T0_STOPREASON runs its own test unattended, so "attended" no longer said it.)
#ifdef T0_HAND
#define T0_OWN_TIER
#endif
#ifdef T0_STOPMODE
#define T0_OWN_TIER
#endif
#ifdef T0_STOPREASON
#define T0_OWN_TIER
#endif

CON { bench target }

' Which motor this harness talks to. Deliberately NOT read from the user
' config: a dual-motor block defines LEFT_MOTOR_BASE and RIGHT_MOTOR_BASE and
' no ONLY_MOTOR_BASE at all, so reading that user constant will not COMPILE on
' a dual bench -- which is what the real bench is (dual 6.5" wheels, Rev B
' boards, 18.5V pack). PINS_P16_P31 is a real motor under every config block
' in isp_bldc_motor_userconfig.spin2: the right wheel on the dual 6.5"/18.5V
' block, the left wheel on the alternate dual block, and the sole motor on
' every single-motor block. Everything else -- motor type, drive voltage,
' wheel diameter -- still comes from whichever block is active, so the harness
' describes the hardware the operator says is connected.
    T0_MOTOR_BASE = motor.PINS_P16_P31

' Second populated base for T0-14's board-detection sweeps (R2-T0-REPEAT,
' R2-T0-DIRTY). PINS_P32_P47 is a legal enum value under every config block
' regardless of which is active, so this compiles everywhere; it is only
' actually wired to a second board on the dual-motor bench. Using the raw
' PINS_* enum (not user.LEFT_MOTOR_BASE) sidesteps the same single-motor
' compile hazard T0_MOTOR_BASE's comment above describes.
    T0_SECOND_BASE = motor.PINS_P32_P47

CON { build identity }

    SRC_REV = 18                                            ' hand-bumped whenever this file changes; printed in the banner

CON { timing }

    CLK_FREQ = 270_000_000                                      ' matches the audit's worked dead_gap example
    _clkfreq = CLK_FREQ
    READY_WAIT_MS  = 2_000                                      ' bound on a started driver reporting ready
    READY_POLL_MS  = 10

CON { 6.0.0 cells (task 3560) }

    BAD_PIN_BASE     = 99                                       ' not a PINS_* value: start() must reject it before any cog or pin is touched
    PL48_MARK_BASE   = 8                                        ' P8..P15: the release demo's HDMI group (PL-48)
    PL48_MARK_SPAN   = 7                                        ' addpins operand: 8 pins
    PL48_MARK_MASK   = $FF                                      ' DIRA bits 8..15, shifted down
    PL48_MARK_SHIFT  = 8
    SF_START_COGS    = 2                                        ' DERIVED -- task 3513: a single-motor start() is the driver plus its front cog
    SF_STEER_COGS    = 3                                        ' DERIVED -- task 3513: two owned drivers plus the steering front cog
    REST_SAMPLES     = 50                                       ' R16-T0-RESTZERO: getCurrent() reads averaged per board
    REST_SAMPLE_MS   = 20
    SF_REST_LO       = -100                                     ' DERIVED -- +/-10 mA (0.1 mA units); unfixed LEFT read ~535 (PL-45, Visit 1)
    SF_REST_HI       = 100

CON { API promise and regression cells (tasks 3577, 3574) }

' R17-T0-ACCEL: the library documents its built-in ramp as starting "near 44 mm/s squared", and that ramp's
'  start is the default ramp_min it reads back before any call. DERIVED: 1_500 steps x 0.02945 mm/s^2 per
'  step (1913 passes/s, 6 ticks per electrical cycle, 5.76 mm per tick, 2^32 per cycle) = 44.2 mm/s^2. So
'  setAcceleration(ACCEL_ANCHOR_MM_S2) must land within 1% of the default ramp_min: a factor wrong anywhere
'  in the conversion moves it far outside that.
    ACCEL_ANCHOR_MM_S2 = 44
    ACCEL_ANCHOR_TOL_DIV = 100                                  ' 1% of the default ramp_min
    ACCEL_BELOW_RANGE  = -1                                     ' a negative rate, as well as the one just below range
' R17-T0-KMMI: exact unit identities the conversion must reproduce tick for tick
    M_PER_KM           = 1_000
    FT_PER_MI          = 5_280
' R17-T0-VOLTGET: the bench pack's nominal voltage (the bench config's PWR_18p5V, the 5S pack -- STEPHEN
'  2026-09-17, "18.5 V nominal 5S"). The harness is built with -D BENCH_CFG, so that is the voltage start() gets.
    SF_PACK_MV         = 18_500
' R17-T0-DEADGAP (task 3574, A1 / PL-9): both 64010 manuals' minimum commutation dead gap, either board
    DEADTIME_MIN_NS    = 250
    HZ_PER_MHZ         = 1_000_000
    NS_PER_US          = 1_000
' each cell's n: the claims its one verdict covers
    DEADGAP_READS_JUDGED = 1
    ACCEL_CALLS_JUDGED = 5                                      ' three refusals, the anchor, the top rate
    KMMI_CLAIMS_JUDGED = 3                                      ' km conversion, mi conversion, the refusal
    VOLT_READS_JUDGED  = 3                                      ' motor, steering running, steering not started

CON { cog-exhaustion probe (T0-8, T0-15) }

    MAX_SPACER_COGS   = 7                                       ' every cog besides this harness's own
    SPACER_STACK_LONGS = 32                                     ' generous headroom for a trivial idle loop

CON { stop reasons and the event log (T0-25, -D T0_STOPREASON only; task 3621, DRIVER-REPORTING-DESIGN.md SS6) }

' The RIGHT wheel (T0_MOTOR_BASE) is driven at T0_25_POWER, wheels up, and stopped each way a program can stop it.
'  Each value is the design's pre-registered one (SS6), not tuned here.
    T0_25_POWER         = 15                                    ' every drive in T0-25
    T0_25_RUN_MS        = 300                                   ' a leg drives this long before its stop
    T0_25_STICKY_MS     = 500                                   ' COMMANDED: the reason still reads the same this much later
    T0_25_LIMIT_MS      = 300                                   ' ATLIMIT: stopAfterTime()'s limit, DTU_MILLISEC
    T0_25_EARLY_MS      = 100                                   ' ATLIMIT's negative: stopMotor() this soon, the limit still armed
    T0_25_TIMEOUT_MS    = 100                                   ' LINKLOST: setCommandTimeout()
    T0_25_SILENT_MS     = 400                                   ' ...and no command for this long
    T0_25_REFRESH_MS    = 30                                    ' LINKLOST's negative: the drive re-sent this often, for T0_25_SILENT_MS
    T0_25_REST_MS       = 3_000                                 ' bound on the driver reading DCS_STOPPED after a stop
    T0_25_EV_STOPS      = 7                                     ' EV-STOP: the stops the SR legs record, in order (t0rWantStop())
    T0_25_CYCLES        = 20                                    ' EV-LOST: drive/stop cycles with nothing read
    T0_25_CYCLE_MS      = 60                                    ' each cycle's drive, and its pause after the stop
    T0_25_COG_CYCLES    = 4                                     ' EV-2COG: the stops both reading cogs must each read
    T0_25_HELPER_STACK  = 128                                   ' the helper reader cog: getEvent() and its callee, with headroom
    T0_25_HANDSHAKE_MS  = 2_000                                 ' bound on each of the helper cog's two handshakes
    T0_25_DRAIN_MAX     = 40                                    ' bound on one drain: EV_QUEUE_DEPTH + EV_LOST + what arrives meanwhile

  ' T0-25's seven stop legs, run in this order (t0rLeg()); each reads getStopReason() as its drive opens, after its stop,
  '  and once more after the leg's own later act:
  '  T0R_LEG_CMD       - stopMotor() after T0_25_RUN_MS: SR_COMMANDED, and still SR_COMMANDED T0_25_STICKY_MS later
  '  T0R_LEG_LIMIT     - stopAfterTime(T0_25_LIMIT_MS) armed, then the drive: the limit stops it, SR_AT_LIMIT
  '  T0R_LEG_LIMIT_NEG - the same limit armed, stopMotor() at T0_25_EARLY_MS: SR_COMMANDED, and still so once the
  '                      limit's deadline has passed at rest (a limit firing with no drive open records nothing)
  '  T0R_LEG_ESTOP     - emergencyCutoff() at speed: SR_EMERGENCY, and still so after clearEmergency()
  '  T0R_LEG_ESTOP_NEG - stopMotor(), rest, then emergencyCutoff() AT REST: SR_COMMANDED both times (first cause wins)
  '  T0R_LEG_LINK      - setCommandTimeout(T0_25_TIMEOUT_MS), the drive, then no command for T0_25_SILENT_MS: SR_LINK_LOST
  '  T0R_LEG_LINK_NEG  - the same timeout, the drive re-sent every T0_25_REFRESH_MS for T0_25_SILENT_MS (the drive still
  '                      open, SR_NONE), then stopMotor(): SR_COMMANDED; the timeout is turned off again
    #0, T0R_LEG_CMD, T0R_LEG_LIMIT, T0R_LEG_LIMIT_NEG, T0R_LEG_ESTOP, T0R_LEG_ESTOP_NEG, T0R_LEG_LINK, T0R_LEG_LINK_NEG
    T0R_LEGS            = T0R_LEG_LINK_NEG + 1

CON { hand-rotation anchor (T0-12, -D T0_HAND only) }

    T0_12_HALL_OFFSET = 5                                       ' pin_hall_u is base+5; hall inputs are base+5..base+7
    T0_12_HALL_SPAN   = 2                                       ' addpins operand: three hall pins
    T0_12_POLL_MS     = 1                                       ' hall poll period while counting
    T0_12_KEY_POLLS   = 100                                     ' polls between keypress checks (~100 ms) -- matches
                                                                 ' PC_KEY's own ~100 ms keypress-latch window
                                                                 ' (DISPLAY-PATTERNS-builders-guide.md SS7)
    T0_12_PRINT_POLLS = 500                                     ' polls between progress lines AND panel redraws
                                                                 ' (~500 ms); the panel rides this existing cadence
                                                                 ' rather than adding a new one, so it costs nothing
                                                                 ' extra against the 1 ms hall poll (PL-42 fix)
    T0_12_KEY_WAIT_MS = 50                                      ' keypress poll period before counting starts
    T0_12_KEY_START   = "S"                                     ' starts the count (either case); no other key does
    T0_12_KEY_START_LC = "s"
    T0_12_KEY_STOP    = " "                                     ' SPACE stops the count; no other key does
    T0_12_REVOLUTIONS = 3                                       ' operator turns exactly this many full revolutions;
                                                                 ' baked into t0h_bg.bmp -- regenerate that asset
                                                                 ' (tools/gen_t0hand_assets.py) if this changes

' PL-39: the direction the operator is TOLD to turn, viewed from the hub side, is fixed at CW. The
' panel background bakes the instruction in (tools/gen_t0hand_assets.py), so a second direction
' would need a second asset set that could disagree with the log; instead one known direction plus
' the signed tick change (pos) is enough to tie the tick sign to the physical direction.
    T0_12_TOLD_CCW    = FALSE

