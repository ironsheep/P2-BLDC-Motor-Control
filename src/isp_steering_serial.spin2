'' =================================================================================================
''
''   File....... isp_steering_serial.spin2
''   Purpose.... Top-level Object providing serial control over steering of a twin-bldc-motor platform
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2022 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Apr 2022
''   Updated.... 4 May 2022
''
'' =================================================================================================

CON { timing }

  CLK_FREQ = 270_000_000                                        ' system freq as a constant
  _clkfreq = CLK_FREQ                                           ' set system clock

CON { application io pins }

  GW_RX2      = 57  { I }                                       ' programming / debug
  GW_TX2      = 56  { O }

  GW_BAUDRATE = 624_000                                         ' 624kb/s - allow P2 rx to keep up!

DAT { our hardware ID strings and 1-wire buffers, collection names }

p2HardwareID    byte    "P2 Edge - 2WheelBot",0

OBJ { our Motors }

#ifdef BENCH_CFG
    user        : "isp_bldc_motor_userconfig_bench"             ' bench rig configuration (-D BENCH_CFG, VISIT-10 serial step)
#else
    user        : "isp_bldc_motor_userconfig"                   ' driver configuration
#endif
    wheels      : "isp_steering_2wheel"                       ' our steering object
    hostIF      : "isp_host_serial"                             ' serial I/O to/from host (RPi, Arduino, etc.)
    serialQueue : "isp_queue_serial"                            ' access to our received data
    strFmt      : "isp_mem_strings"                             ' format to memory routines

CON { command-names enum }

#0, CMD_Unknown, CMD_DRV_DIR, CMD_DRV_DIST, CMD_DRV_PWR
#4, CMD_STP_ROT, CMD_STP_DIST, CMD_STP_TIME, CMD_STP_MOT
#8, CMD_EMER_CUT, CMD_EMER_CLR
#10, CMD_SET_ACCEL, CMD_SET_SPD, CMD_SET_DIST_SPD
#13, CMD_HOLD, CMD_RST_TRKG
#15, CMD_GET_DIST, CMD_GET_ROT, CMD_GET_PWR
#18, CMD_GET_STAT, CMD_GET_MAX_SPD, CMD_GET_MAX_DIST_SPD
#21, CMD_GET_VOLT, CMD_SET_TIMEOUT
#23, CMD_PROT_CLR, CMD_GET_PROT
#25, CMD_GET_STOP_RSN, CMD_GET_HEALTH, CMD_GET_EVENT, CMD_GET_EV_TOTAL
#29, CMD_SET_FAULT_RESP, CMD_GET_FAULT_RESP, CMD_SET_HOLD_LIM, CMD_GET_HOLD_LIM
#33, CMD_GET_ERROR
#34, CMD_GET_PACK_VOLT, CMD_GET_CURRENT, CMD_GET_FAULT_CAUSE, CMD_GET_HOLD_STAT
#38, CMD_GET_HALL_COUNTS, CMD_GET_HALL_ILLEGAL, CMD_CHECK_WIRING, CMD_SET_START_CHK
#42, CMD_SET_DECEL, CMD_GET_ACCEL, CMD_GET_DECEL

CON { command loop }

    IDLE_POLL_MS = 1        ' PL-154: with no command queued, the loop looks again after this long (was 1 s)

DAT { command table }

    ' first our command strings
    cmdDrvDir           BYTE    "drivedir",0
    cmdDrvDist          BYTE    "drivedist",0
    cmdDrvPwr           BYTE    "drivepwr",0
    cmdStpAftRot        BYTE    "stopaftrot",0
    cmdStpAftDist       BYTE    "stopaftdist",0
    cmdStpAftTime       BYTE    "stopafttime",0
    cmdStpMot           BYTE    "stopmotors",0
    cmdEmerCut          BYTE    "emercutoff",0
    cmdEmerClr          BYTE    "emerclear",0
    cmdSetAccel         BYTE    "setaccel",0
    cmdSetSpd           BYTE    "setspeed",0
    cmdSetDistSpd       BYTE    "setspeedfordist",0
    cmdHold             BYTE    "hold",0
    cmdRstTrack         BYTE    "resettracking",0
    cmdGetDist          BYTE    "getdist",0
    cmdGetRot           BYTE    "getrot",0
    cmdGetPwr           BYTE    "getpwr",0
    cmdGetStat          BYTE    "getstatus",0
    cmdGetMaxSpd        BYTE    "getmaxspd",0
    cmdGetMaxDistSpd    BYTE    "getmaxspdfordist",0
    cmdGetVolt          BYTE    "getvoltage",0
    cmdSetTimeout       BYTE    "settimeout",0
    cmdProtClr          BYTE    "protclear",0
    cmdGetProt          BYTE    "getprot",0
    cmdGetStopRsn       BYTE    "getstopreason",0
    cmdGetHealth        BYTE    "gethealth",0
    cmdGetEvent         BYTE    "getevent",0
    cmdGetEvTotal       BYTE    "getevtotal",0
    cmdSetFaultResp     BYTE    "setfaultresp",0
    cmdGetFaultResp     BYTE    "getfaultresp",0
    cmdSetHoldLim       BYTE    "setholdlimits",0
    cmdGetHoldLim       BYTE    "getholdlimits",0
    cmdGetError         BYTE    "geterror",0
    cmdGetPackVolt      BYTE    "getpackvolt",0
    cmdGetCurrent       BYTE    "getcurrent",0
    cmdGetFaultCause    BYTE    "getfaultcause",0
    cmdGetHoldStat      BYTE    "getholdstatus",0
    cmdGetHallCounts    BYTE    "gethallcounts",0
    cmdGetHallIllegal   BYTE    "gethallillegal",0
    cmdCheckWiring      BYTE    "checkwiring",0
    cmdSetStartChk      BYTE    "setstartchecks",0
    cmdSetDecel         BYTE    "setdecel",0
    cmdGetAccel         BYTE    "getaccel",0
    cmdGetDecel         BYTE    "getdecel",0

    ' now describe cmd enum and # parms for each string
    cmdsFirst   long  @cmdDrvDir, CMD_DRV_DIR, 2
                long  @cmdDrvDist, CMD_DRV_DIST, 3
                long  @cmdDrvPwr, CMD_DRV_PWR, 2
                long  @cmdStpAftRot, CMD_STP_ROT, 2
                long  @cmdStpAftDist, CMD_STP_DIST, 2
                long  @cmdStpAftTime, CMD_STP_TIME, 2
                long  @cmdStpMot, CMD_STP_MOT, 0
                long  @cmdEmerCut, CMD_EMER_CUT, 0
                long  @cmdEmerClr, CMD_EMER_CLR, 0
                long  @cmdSetAccel, CMD_SET_ACCEL, 1
                long  @cmdSetSpd, CMD_SET_SPD, 1
                long  @cmdSetDistSpd, CMD_SET_DIST_SPD, 1
                long  @cmdHold, CMD_HOLD, 1
                long  @cmdRstTrack, CMD_RST_TRKG, 0
                long  @cmdGetDist, CMD_GET_DIST, 1
                long  @cmdGetRot, CMD_GET_ROT, 1
                long  @cmdGetPwr, CMD_GET_PWR, 0
                long  @cmdGetStat, CMD_GET_STAT, 0
                long  @cmdGetMaxSpd, CMD_GET_MAX_SPD, 0
                long  @cmdGetMaxDistSpd, CMD_GET_MAX_DIST_SPD, 0
                long  @cmdGetVolt, CMD_GET_VOLT, 0
                long  @cmdSetTimeout, CMD_SET_TIMEOUT, 1
                long  @cmdProtClr, CMD_PROT_CLR, 0
                long  @cmdGetProt, CMD_GET_PROT, 0
                long  @cmdGetStopRsn, CMD_GET_STOP_RSN, 0
                long  @cmdGetHealth, CMD_GET_HEALTH, 0
                long  @cmdGetEvent, CMD_GET_EVENT, 0
                long  @cmdGetEvTotal, CMD_GET_EV_TOTAL, 1
                long  @cmdSetFaultResp, CMD_SET_FAULT_RESP, 2
                long  @cmdGetFaultResp, CMD_GET_FAULT_RESP, 0
                long  @cmdSetHoldLim, CMD_SET_HOLD_LIM, 3
                long  @cmdGetHoldLim, CMD_GET_HOLD_LIM, 0
                long  @cmdGetError, CMD_GET_ERROR, 0
                long  @cmdGetPackVolt, CMD_GET_PACK_VOLT, 0
                long  @cmdGetCurrent, CMD_GET_CURRENT, 0
                long  @cmdGetFaultCause, CMD_GET_FAULT_CAUSE, 0
                long  @cmdGetHoldStat, CMD_GET_HOLD_STAT, 0
                long  @cmdGetHallCounts, CMD_GET_HALL_COUNTS, 0
                long  @cmdGetHallIllegal, CMD_GET_HALL_ILLEGAL, 0
                long  @cmdCheckWiring, CMD_CHECK_WIRING, 0
                long  @cmdSetStartChk, CMD_SET_START_CHK, 1
                long  @cmdSetDecel, CMD_SET_DECEL, 1
                long  @cmdGetAccel, CMD_GET_ACCEL, 0
                long  @cmdGetDecel, CMD_GET_DECEL, 0
    cmdLast
    ' calculate the number of entries in table
    cmdEntryCt long ((@cmdLast - @cmdsFirst) / 4) / 3


    msgWork             BYTE    0[256]     ' 256 bytes in which to format the outgoing message


PUB main() | opStatus, pValues, basePinLt, basePinRt, voltage, motor, detectModeLt, detectModeRt, senseCog, eError, eLeftError, eRightError
'' DEMO Driving a two wheeled platform
''
'' R20.1: when start()'s checks refuse the platform, the host link still opens, answering only gethealth, geterror and
'' setstartchecks (every other command is answered ERR_NOT_STARTED), so the host can learn why the motors did not start,
'' and may start them anyway with setstartchecks 0 (PL-157).
''
'' PL-154: with no command waiting, the loop looks again every IDLE_POLL_MS (1 ms), so a command is handled about
'' 1 ms after its line ends.
''

' Local Variables:
' @local opStatus - OP_SUCCESS when the command's parameters were parsed
' @local pValues - pointer to the parsed command descriptor (ENT_* indexes)
' @local basePinLt - the validated left-motor base pin, or INVALID_PIN_BASE
' @local basePinRt - the validated right-motor base pin, or INVALID_PIN_BASE
' @local voltage - the validated drive voltage, or INVALID_VOLTAGE
' @local motor - the validated motor type, or INVALID_MOTOR
' @local detectModeLt - the validated left board detection mode, or INVALID_DET_MODE
' @local detectModeRt - the validated right board detection mode, or INVALID_DET_MODE
' @local senseCog - the steering front cog's id (0-7), or -1 when the motors did not start
' @local eError - this cog's collected steering error, after a failed start
' @local eLeftError - this cog's collected left-wheel error
' @local eRightError - this cog's collected right-wheel error

    debug("* Serial I/F to dual motor platform")

    ' replace original addresses with better values
    long[@cmdsFirst][0 * 3] := @cmdDrvDir
    long[@cmdsFirst][1 * 3] := @cmdDrvDist
    long[@cmdsFirst][2 * 3] := @cmdDrvPwr
    long[@cmdsFirst][3 * 3] := @cmdStpAftRot
    long[@cmdsFirst][4 * 3] := @cmdStpAftDist
    long[@cmdsFirst][5 * 3] := @cmdStpAftTime
    long[@cmdsFirst][6 * 3] := @cmdStpMot
    long[@cmdsFirst][7 * 3] := @cmdEmerCut
    long[@cmdsFirst][8 * 3] := @cmdEmerClr
    long[@cmdsFirst][9 * 3] := @cmdSetAccel
    long[@cmdsFirst][10 * 3] := @cmdSetSpd
    long[@cmdsFirst][11 * 3] := @cmdSetDistSpd
    long[@cmdsFirst][12 * 3] := @cmdHold
    long[@cmdsFirst][13 * 3] := @cmdRstTrack
    long[@cmdsFirst][14 * 3] := @cmdGetDist
    long[@cmdsFirst][15 * 3] := @cmdGetRot
    long[@cmdsFirst][16 * 3] := @cmdGetPwr
    long[@cmdsFirst][17 * 3] := @cmdGetStat
    long[@cmdsFirst][18 * 3] := @cmdGetMaxSpd
    long[@cmdsFirst][19 * 3] := @cmdGetMaxDistSpd
    long[@cmdsFirst][20 * 3] := @cmdGetVolt
    long[@cmdsFirst][21 * 3] := @cmdSetTimeout
    long[@cmdsFirst][22 * 3] := @cmdProtClr
    long[@cmdsFirst][23 * 3] := @cmdGetProt
    long[@cmdsFirst][24 * 3] := @cmdGetStopRsn
    long[@cmdsFirst][25 * 3] := @cmdGetHealth
    long[@cmdsFirst][26 * 3] := @cmdGetEvent
    long[@cmdsFirst][27 * 3] := @cmdGetEvTotal
    long[@cmdsFirst][28 * 3] := @cmdSetFaultResp
    long[@cmdsFirst][29 * 3] := @cmdGetFaultResp
    long[@cmdsFirst][30 * 3] := @cmdSetHoldLim
    long[@cmdsFirst][31 * 3] := @cmdGetHoldLim
    long[@cmdsFirst][32 * 3] := @cmdGetError
    long[@cmdsFirst][33 * 3] := @cmdGetPackVolt
    long[@cmdsFirst][34 * 3] := @cmdGetCurrent
    long[@cmdsFirst][35 * 3] := @cmdGetFaultCause
    long[@cmdsFirst][36 * 3] := @cmdGetHoldStat
    long[@cmdsFirst][37 * 3] := @cmdGetHallCounts
    long[@cmdsFirst][38 * 3] := @cmdGetHallIllegal
    long[@cmdsFirst][39 * 3] := @cmdCheckWiring
    long[@cmdsFirst][40 * 3] := @cmdSetStartChk
    long[@cmdsFirst][41 * 3] := @cmdSetDecel
    long[@cmdsFirst][42 * 3] := @cmdGetAccel
    long[@cmdsFirst][43 * 3] := @cmdGetDecel

    ' validate user settings/choicess
    '  do NOT start motor unless all are legit!
    basePinLt := wheels.validBasePinForChoice(user.LEFT_MOTOR_BASE)
    basePinRt := wheels.validBasePinForChoice(user.RIGHT_MOTOR_BASE)
    detectModeLt := wheels.validDetectModeForChoice(user.LEFT_BOARD_TYPE)
    detectModeRt := wheels.validDetectModeForChoice(user.RIGHT_BOARD_TYPE)
    voltage := wheels.validVoltageForChoice(user.DRIVE_VOLTAGE)
    motor := wheels.validMotorForChoice(user.MOTOR_TYPE)

    if basePinLt <> wheels.INVALID_PIN_BASE and basePinRt <> wheels.INVALID_PIN_BASE and voltage <> wheels.INVALID_VOLTAGE and motor <> wheels.INVALID_MOTOR and detectModeLt <> wheels.INVALID_DET_MODE and detectModeRt <> wheels.INVALID_DET_MODE
        ' start our dual motor driver

        ' kept for setstartchecks 0, which retries a start its checks refused
        startPinLt := basePinLt
        startPinRt := basePinRt
        startVoltage := voltage
        startDetectLt := detectModeLt
        startDetectRt := detectModeRt

        ' start our motor drivers (left and right)
        senseCog := wheels.start(basePinLt, basePinRt, voltage, detectModeLt, detectModeRt)
        bStartRefused := FALSE
        if senseCog < 0
            ' never offer the host a command interface to motors that are not running. R20.1 (Q6): a start its checks
            '  refused still opens the host link, answering only gethealth and geterror, so the host can ask why; its
            '  errors are left for geterror, not drained here
            bStartRefused := bStartChecksRefused()
            if bStartRefused == TRUE
                debug("* ERROR motors did not start: a start check failed; the host may ask gethealth and geterror")
            else
                eError, eLeftError, eRightError := wheels.getError()
                debug("* ERROR motors did not start: ", sdec_long(eError), sdec_long(eLeftError), sdec_long(eRightError))
        if (senseCog >= 0) or (bStartRefused == TRUE)
            '' start our serial host communications
            hostIF.startx(GW_RX2, GW_TX2, GW_BAUDRATE, hostIF.PU_15K)    ' tell singleton our pins and rate

            ' (one time) tell the RPi about how to identify this hardware
            hostIF.identify(@p2HardwareID)

            debug("* command loop *")

            repeat
                if serialQueue.hasCommand(@cmdsFirst, cmdEntryCt)
                    opStatus, pValues := serialQueue.getCommandParms()
                    if opStatus == serialQueue.OP_SUCCESS
                        if (bStartRefused == TRUE) and (bSaysWhy(pValues) == FALSE)
                            replyNotStarted(pValues)
                        else
                            processCommand(pValues)
                else
                    ' PL-154: an idle link is the normal state between a host's commands; look again soon, so a
                    '  command (emercutoff included) is handled about IDLE_POLL_MS after its line ends
                    waitms(IDLE_POLL_MS)
    else
        debug("* ERROR user configuration NOT valid!")

    debug("* DONE")

DAT { parse work variables }

    cmdEnum         LONG    0
    drvDir          LONG    0
    drvPwr1         LONG    0
    drvPwr2         LONG    0
    onlyValue       LONG    0
    ltValue         LONG    0
    rtValue         LONG    0
    nRate           LONG    0
    nRot            LONG    0
    nRotUnits       LONG    0
    nTime           LONG    0
    nTimeUnits      LONG    0
    nDist           LONG    0
    nDistUnits      LONG    0
    nSpeed          LONG    0
    bHoldEnable     LONG    0
    nTimeout        LONG    0
    nEvKind         LONG    0
    nFaultMode      LONG    0
    nBrakePct       LONG    0
    nHoldCeilPct    LONG    0
    nHoldRiseMs     LONG    0
    nHoldLimitMs    LONG    0
    bRefuseChecks   LONG    0

DAT { start state: setstartchecks 0 retries a start its checks refused with these }

    bStartRefused   LONG    FALSE   ' T/F where T means start()'s checks refused the platform, so the host link answers only why
    startPinLt      LONG    0       ' the validated left-motor base pin
    startPinRt      LONG    0       ' the validated right-motor base pin
    startVoltage    LONG    0       ' the validated drive voltage
    startDetectLt   LONG    0       ' the validated left board detection mode
    startDetectRt   LONG    0       ' the validated right board detection mode

PRI processCommand(pValues) | eError, nOut1, nOut2, nOut3, nOut4, nOut5, nOut6
' F-7: every command calls the library first and replies from its status, so a request the library
'  refuses gets an ERROR reply naming the code instead of an OK for work that never happened
'
' @param pValues - the parsed command entry

' Local Variables:
' @local eError - the library's result for the command
' @local nOut1 - a getter's first result, in reply order (R20.1's multi-value replies)
' @local nOut2 - its second result
' @local nOut3 - its third result
' @local nOut4 - its fourth result
' @local nOut5 - its fifth result
' @local nOut6 - its sixth result

    debug("* HANDLE ", zstr_(long [pValues][serialQueue.ENT_CMDSTR_IDX]))
'   pValues -> [0:nbrValues(1-n)]  (doesn't count "full string")    ENT_VALUE_CT_IDX
'              [1:pStr] -> "full string"                            ENT_RAWSTR_IDX
'              [2:pCmd] -> "cmd"                                    ENT_CMDSTR_IDX
'              [3:eCmd]                                             ENT_CMDENUM_IDX
'              [4:nValue1]                                          ENT_PARM1_IDX
'              [5:nValue2]                                          ENT_PARM2_IDX
'              [6:nValue3]                                          ENT_PARM3_IDX
'              [7:nValue4]                                          ENT_PARM4_IDX
'              [etc] - up to 6 max values
    cmdEnum := long [pValues][serialQueue.ENT_CMDENUM_IDX]
    case cmdEnum
        CMD_DRV_DIR:
            ' get incoming parm values
            drvPwr1 := LONG[pValues][serialQueue.ENT_PARM1_IDX]
            drvDir := LONG[pValues][serialQueue.ENT_PARM2_IDX]
            ' validate values
            if not bInRange(drvPwr1, -100, 100)
                ' invalid, report so...
                strFmt.sFormatStr1(@msgWork, @"Power (%d) out of range [-100, 100]", drvPwr1)
                serialQueue.sendError(@msgWork)
            elseif not bInRange(drvDir, -100, 100)
                ' invalid, report so...
                strFmt.sFormatStr1(@msgWork, @"Direction (%d) out of range [-100, 100]", drvDir)
                serialQueue.sendError(@msgWork)
            else
                ' all good, act on request, then report its outcome
                eError := wheels.driveDirection(drvPwr1, drvDir)
                replyWithStatus(pValues, eError)

        CMD_DRV_DIST:
            ' get incoming parm values
            ltValue := LONG[pValues][serialQueue.ENT_PARM1_IDX]
            rtValue := LONG[pValues][serialQueue.ENT_PARM2_IDX]
            nDistUnits := LONG[pValues][serialQueue.ENT_PARM3_IDX]
            ' validate values
            if not isPostiveValue(ltValue)
                ' invalid, report so...
                strFmt.sFormatStr1(@msgWork, @"LT-distance (%d)  must be positive value", ltValue)
                serialQueue.sendError(@msgWork)
            elseif not isPostiveValue(rtValue)
                ' invalid, report so...
                strFmt.sFormatStr1(@msgWork, @"RT-distance (%d)  must be positive value", rtValue)
                serialQueue.sendError(@msgWork)
            elseif not isValidDistanceUnit(nDistUnits, @msgWork)    ' fills in msgWork with error msg
                ' invalid, report so...
                serialQueue.sendError(@msgWork)
            else
                ' all good, act on request, then report its outcome
                eError := wheels.driveForDistance(ltValue, rtValue, nDistUnits)
                replyWithStatus(pValues, eError)

        CMD_DRV_PWR:
            ' get incoming parm values
            drvPwr1 := LONG[pValues][serialQueue.ENT_PARM1_IDX]
            drvPwr2 := LONG[pValues][serialQueue.ENT_PARM2_IDX]
            ' validate values
            if not bInRange(drvPwr1, -100, 100)
                ' invalid, report so...
                strFmt.sFormatStr1(@msgWork, @"LT-Power (%d) out of range [-100, 100]", drvPwr1)
                serialQueue.sendError(@msgWork)
            elseif not bInRange(drvPwr2, -100, 100)
                ' invalid, report so...
                strFmt.sFormatStr1(@msgWork, @"RT-Power (%d) out of range [-100, 100]", drvPwr2)
                serialQueue.sendError(@msgWork)
            else
                ' all good, act on request, then report its outcome
                eError := wheels.driveAtPower(drvPwr1, drvPwr2)
                replyWithStatus(pValues, eError)

        CMD_STP_ROT:
            ' get incoming parm values
            nRot := LONG[pValues][serialQueue.ENT_PARM1_IDX]
            nRotUnits := LONG[pValues][serialQueue.ENT_PARM2_IDX]
            ' validate values
            if not isValidRotationUnit(nRotUnits, @msgWork)    ' fills in msgWork with error msg
                ' invalid, report so...
                serialQueue.sendError(@msgWork)
            elseif not isPostiveValue(nRot)
                 ' invalid, report so...
               strFmt.sFormatStr1(@msgWork, @"Rotation Count (%d) must be positive value", nRot)
                serialQueue.sendError(@msgWork)
            else
                ' all good, act on request, then report its outcome
                eError := wheels.stopAfterRotation(nRot, nRotUnits)
                replyWithStatus(pValues, eError)

        CMD_STP_DIST:
            ' get incoming parm values
            nDist := LONG[pValues][serialQueue.ENT_PARM1_IDX]
            nDistUnits := LONG[pValues][serialQueue.ENT_PARM2_IDX]
            ' validate values
            if not isValidDistanceUnit(nDistUnits, @msgWork)    ' fills in msgWork with error msg
                ' invalid, report so...
                serialQueue.sendError(@msgWork)
            elseif not isPostiveValue(nDist)
                ' invalid, report so...
                strFmt.sFormatStr1(@msgWork, @"Distance Value (%d) must be positive", nDist)
                serialQueue.sendError(@msgWork)
            else
                ' all good, act on request, then report its outcome
                eError := wheels.stopAfterDistance(nDist, nDistUnits)
                replyWithStatus(pValues, eError)

        CMD_STP_TIME:
            ' get incoming parm values
            nTime := LONG[pValues][serialQueue.ENT_PARM1_IDX]
            nTimeUnits := LONG[pValues][serialQueue.ENT_PARM2_IDX]
            ' validate values
            if not isValidTimeUnit(nTimeUnits, @msgWork)    ' fills in msgWork with error msg
                ' invalid, report so...
                serialQueue.sendError(@msgWork)
            elseif not isPostiveValue(nTime)
                ' invalid, report so...
                strFmt.sFormatStr1(@msgWork, @"Time Value (%d) must be positive", nTime)
                serialQueue.sendError(@msgWork)
            else
                ' all good, act on request, then report its outcome
                eError := wheels.stopAfterTime(nTime, nTimeUnits)
                replyWithStatus(pValues, eError)

        CMD_STP_MOT:
            ' act on request, then report its outcome
            eError := wheels.stopMotors()
            replyWithStatus(pValues, eError)

        CMD_EMER_CUT:
            ' act on request, then report its outcome
            eError := wheels.emergencyCutoff()
            replyWithStatus(pValues, eError)

        CMD_EMER_CLR:
            ' act on request, then report its outcome
            eError := wheels.clearEmergency()
            replyWithStatus(pValues, eError)

        CMD_SET_ACCEL:
            ' get incoming parm values
            nRate := LONG[pValues][serialQueue.ENT_PARM1_IDX]
            ' validate values
            if not bInRange(nRate, wheels.ACCEL_MIN_MM_S2, wheels.ACCEL_MAX_MM_S2)
                ' invalid, report so...
                strFmt.sFormatStr3(@msgWork, @"Accel Rate (%d) out of range [%d, %d] mm/s^2", nRate, wheels.ACCEL_MIN_MM_S2, wheels.ACCEL_MAX_MM_S2)
                serialQueue.sendError(@msgWork)
            else
                ' all good, act on request, then report its outcome
                eError := wheels.setAcceleration(nRate)
                replyWithStatus(pValues, eError)

        CMD_SET_DECEL:
            ' get incoming parm values (PL-160)
            nRate := LONG[pValues][serialQueue.ENT_PARM1_IDX]
            ' validate values
            if not bInRange(nRate, wheels.DECEL_MIN_MM_S2, wheels.DECEL_MAX_MM_S2)
                ' invalid, report so...
                strFmt.sFormatStr3(@msgWork, @"Decel Rate (%d) out of range [%d, %d] mm/s^2", nRate, wheels.DECEL_MIN_MM_S2, wheels.DECEL_MAX_MM_S2)
                serialQueue.sendError(@msgWork)
            else
                ' all good, act on request, then report its outcome
                eError := wheels.setDeceleration(nRate)
                replyWithStatus(pValues, eError)

        CMD_GET_ACCEL:
            ' PL-160: the speed-up rate, mm/s^2; the built-in 1_000 until setAcceleration() (DRIVER_REV 38)
            onlyValue := wheels.getAcceleration()
            strFmt.sFormatStr1(@msgWork, @"accel %d\n", onlyValue)
            serialQueue.sendResponse(@msgWork)

        CMD_GET_DECEL:
            ' PL-160: the slow-down and stop rate, mm/s^2 (the built-in rate until setdecel)
            onlyValue := wheels.getDeceleration()
            strFmt.sFormatStr1(@msgWork, @"decel %d\n", onlyValue)
            serialQueue.sendResponse(@msgWork)

        CMD_SET_SPD:
            ' get incoming parm values
            nSpeed := LONG[pValues][serialQueue.ENT_PARM1_IDX]
            ' validate values
            if not bInRange(nSpeed, 1, 100)
                ' invalid, report so...
                strFmt.sFormatStr1(@msgWork, @"MaxSpeed (%d) out of range [1, 100]", nSpeed)
                serialQueue.sendError(@msgWork)
            else
                ' all good, act on request, then report its outcome
                eError := wheels.setMaxSpeed(nSpeed)
                replyWithStatus(pValues, eError)

        CMD_SET_DIST_SPD:
            ' get incoming parm values
            nSpeed := LONG[pValues][serialQueue.ENT_PARM1_IDX]
            ' validate values
            if not bInRange(nSpeed, 1, 100)
                ' invalid, report so...
                strFmt.sFormatStr1(@msgWork, @"MaxSpeedForDistance (%d) out of range [1, 100]", nSpeed)
                serialQueue.sendError(@msgWork)
            else
                ' all good, act on request, then report its outcome
                eError := wheels.setMaxSpeedForDistance(nSpeed)
                replyWithStatus(pValues, eError)

        CMD_HOLD:
            ' get incoming parm values
            bHoldEnable := LONG[pValues][serialQueue.ENT_PARM1_IDX]
            ' validate values
            if not (bHoldEnable == TRUE or bHoldEnable == FALSE)
                ' invalid, report so...
                strFmt.sFormatStr1(@msgWork, @"HoldAtStop (%d) out of range [-1, 0] (T/F)", bHoldEnable)
                serialQueue.sendError(@msgWork)
            else
                ' all good, act on request, then report its outcome
                eError := wheels.holdAtStop(bHoldEnable)
                replyWithStatus(pValues, eError)

        CMD_RST_TRKG:
            ' act on request, then report its outcome
            eError := wheels.resetTracking()
            replyWithStatus(pValues, eError)

        CMD_GET_DIST:
             ' get incoming parm values
            nDistUnits := LONG[pValues][serialQueue.ENT_PARM1_IDX]
            ' validate values
            if not isValidDistanceUnit(nDistUnits, @msgWork)    ' fills in msgWork with error msg
                ' invalid, report so...
                serialQueue.sendError(@msgWork)
            else
                ' get requested value(s)
                ltValue, rtValue := wheels.getDistance(nDistUnits)
                ' format response
                strFmt.sFormatStr2(@msgWork, @"dist %d %d\n", ltValue, rtValue)
                ' send to host
                serialQueue.sendResponse(@msgWork)

        CMD_GET_ROT:
            ' get incoming parm values
            nRotUnits := LONG[pValues][serialQueue.ENT_PARM1_IDX]
            ' validate values
            if not isValidRotationUnit(nRotUnits, @msgWork)    ' fills in msgWork with error msg
                ' invalid, report so...
                serialQueue.sendError(@msgWork)
            else
                ' get requested value(s)
                ltValue, rtValue := wheels.getRotationCount(nRotUnits)
                ' format response
                strFmt.sFormatStr2(@msgWork, @"rot %d %d\n", ltValue, rtValue)
                ' send to host
                serialQueue.sendResponse(@msgWork)

        CMD_GET_PWR:
            ' get requested value(s)
            ltValue, rtValue := wheels.getPower()
            ' format response
            strFmt.sFormatStr2(@msgWork, @"pwr %d %d\n", ltValue, rtValue)
            ' send to host
            serialQueue.sendResponse(@msgWork)

        CMD_GET_STAT:
            ' get requested value(s)
            ltValue, rtValue := wheels.getStatus()
            ' format response
            strFmt.sFormatStr2(@msgWork, @"stat %d %d\n", ltValue, rtValue)
            ' send to host
            serialQueue.sendResponse(@msgWork)

        CMD_GET_MAX_SPD:
            ' get requested value(s)
            onlyValue := wheels.getMaxSpeed()
            ' format response
            strFmt.sFormatStr1(@msgWork, @"speedmax %d\n", onlyValue)
            ' send to host
            serialQueue.sendResponse(@msgWork)

        CMD_GET_MAX_DIST_SPD:
            ' get requested value(s)
            onlyValue := wheels.getMaxSpeedForDistance()
            ' format response
            strFmt.sFormatStr1(@msgWork, @"speeddistmax %d\n", onlyValue)
            ' send to host
            serialQueue.sendResponse(@msgWork)

        CMD_SET_TIMEOUT:
            ' get incoming parm values: the link-loss guard is the host's choice, off until it asks (S-8)
            nTimeout := LONG[pValues][serialQueue.ENT_PARM1_IDX]
            ' validate values
            if (nTimeout <> wheels.CMD_TIMEOUT_OFF) and not bInRange(nTimeout, wheels.CMD_TIMEOUT_MIN_MS, wheels.CMD_TIMEOUT_MAX_MS)
                ' invalid, report so...
                strFmt.sFormatStr3(@msgWork, @"Timeout (%d) not 0 (off) or in range [%d, %d] ms", nTimeout, wheels.CMD_TIMEOUT_MIN_MS, wheels.CMD_TIMEOUT_MAX_MS)
                serialQueue.sendError(@msgWork)
            else
                ' all good, act on request, then report its outcome
                eError := wheels.setCommandTimeout(nTimeout)
                replyWithStatus(pValues, eError)

        CMD_GET_VOLT:
            ' get requested value(s): the configured drive voltage (PWR_* value) and its nominal mV
            ltValue, rtValue := wheels.getDriveVoltage()
            ' format response
            strFmt.sFormatStr2(@msgWork, @"volt %d %d\n", ltValue, rtValue)
            ' send to host
            serialQueue.sendResponse(@msgWork)

        CMD_PROT_CLR:
            ' PL-111: the host's only way to release a latched protective stop (emerclear does not)
            eError := wheels.clearProtectiveStop()
            replyWithStatus(pValues, eError)

        CMD_GET_PROT:
            ' get requested value(s): each wheel's latched protective-stop code, NO_ERROR when none
            ltValue, rtValue := wheels.getProtectiveStop()
            ' format response
            strFmt.sFormatStr2(@msgWork, @"prot %d %d\n", ltValue, rtValue)
            ' send to host
            serialQueue.sendResponse(@msgWork)

        CMD_GET_STOP_RSN:
            ' R20.1: why each wheel's last drive ended, SR_* (40-48)
            ltValue, rtValue := wheels.getStopReason()
            strFmt.sFormatStr2(@msgWork, @"stopreason %d %d\n", ltValue, rtValue)
            serialQueue.sendResponse(@msgWork)

        CMD_GET_HEALTH:
            ' R20.1: each wheel's checked, failed and recovered HLT_* bits; answered after a refused start too
            nOut1, nOut2, nOut3, nOut4, nOut5, nOut6 := wheels.getHealth()
            strFmt.sFormatStr6(@msgWork, @"health %d %d %d %d %d %d\n", nOut1, nOut2, nOut3, nOut4, nOut5, nOut6)
            serialQueue.sendResponse(@msgWork)

        CMD_GET_EVENT:
            ' R20.1: this cog's next event, one per request: kind (EV_*), ms, wheel (EVW_*), value; kind 60 when none
            nOut1, nOut2, nOut3, nOut4 := wheels.getEvent()
            strFmt.sFormatStr4(@msgWork, @"event %d %d %d %d\n", nOut1, nOut2, nOut3, nOut4)
            serialQueue.sendResponse(@msgWork)

        CMD_GET_EV_TOTAL:
            ' get incoming parm values
            nEvKind := LONG[pValues][serialQueue.ENT_PARM1_IDX]
            ' validate values: the counted kinds, EV_STOP to EV_FOLDBACK
            if not bInRange(nEvKind, wheels.EV_STOP, wheels.EV_FOLDBACK)
                ' invalid, report so...
                strFmt.sFormatStr3(@msgWork, @"EventKind (%d) out of range [%d, %d]", nEvKind, wheels.EV_STOP, wheels.EV_FOLDBACK)
                serialQueue.sendError(@msgWork)
            else
                nOut1, nOut2, nOut3 := wheels.getEventTotal(nEvKind)
                strFmt.sFormatStr3(@msgWork, @"evtotal %d %d %d\n", nOut1, nOut2, nOut3)
                serialQueue.sendResponse(@msgWork)

        CMD_SET_FAULT_RESP:
            ' get incoming parm values
            nFaultMode := LONG[pValues][serialQueue.ENT_PARM1_IDX]
            nBrakePct := LONG[pValues][serialQueue.ENT_PARM2_IDX]
            ' validate values
            if (nFaultMode <> wheels.FR_SHIPPED) and (nFaultMode <> wheels.FR_GRADED)
                ' invalid, report so...
                strFmt.sFormatStr3(@msgWork, @"FaultMode (%d) not [%d (FR_SHIPPED), %d (FR_GRADED)]", nFaultMode, wheels.FR_SHIPPED, wheels.FR_GRADED)
                serialQueue.sendError(@msgWork)
            elseif not bInRange(nBrakePct, 0, 100)
                ' invalid, report so...
                strFmt.sFormatStr1(@msgWork, @"BrakePct (%d) out of range [0, 100]", nBrakePct)
                serialQueue.sendError(@msgWork)
            else
                ' all good, act on request, then report its outcome
                eError := wheels.setFaultResponse(nFaultMode, nBrakePct)
                replyWithStatus(pValues, eError)

        CMD_GET_FAULT_RESP:
            nOut1, nOut2 := wheels.getFaultResponse()
            strFmt.sFormatStr2(@msgWork, @"faultresp %d %d\n", nOut1, nOut2)
            serialQueue.sendResponse(@msgWork)

        CMD_SET_HOLD_LIM:
            ' get incoming parm values
            nHoldCeilPct := LONG[pValues][serialQueue.ENT_PARM1_IDX]
            nHoldRiseMs := LONG[pValues][serialQueue.ENT_PARM2_IDX]
            nHoldLimitMs := LONG[pValues][serialQueue.ENT_PARM3_IDX]
            ' validate values
            if not bInRange(nHoldCeilPct, 1, 100)
                ' invalid, report so...
                strFmt.sFormatStr1(@msgWork, @"HoldCeilingPct (%d) out of range [1, 100]", nHoldCeilPct)
                serialQueue.sendError(@msgWork)
            elseif not bInRange(nHoldRiseMs, 1, wheels.HOLD_RISE_MS_MAX)
                ' invalid, report so...
                strFmt.sFormatStr2(@msgWork, @"HoldRiseMs (%d) out of range [1, %d]", nHoldRiseMs, wheels.HOLD_RISE_MS_MAX)
                serialQueue.sendError(@msgWork)
            elseif not bInRange(nHoldLimitMs, 1, wheels.HOLD_LIMIT_MS_MAX)
                ' invalid, report so...
                strFmt.sFormatStr2(@msgWork, @"HoldLimitMs (%d) out of range [1, %d]", nHoldLimitMs, wheels.HOLD_LIMIT_MS_MAX)
                serialQueue.sendError(@msgWork)
            else
                ' all good, act on request, then report its outcome
                eError := wheels.setHoldLimits(nHoldCeilPct, nHoldRiseMs, nHoldLimitMs)
                replyWithStatus(pValues, eError)

        CMD_GET_HOLD_LIM:
            nOut1, nOut2, nOut3 := wheels.getHoldLimits()
            strFmt.sFormatStr3(@msgWork, @"holdlimits %d %d %d\n", nOut1, nOut2, nOut3)
            serialQueue.sendResponse(@msgWork)

        CMD_GET_ERROR:
            ' R20.1: this cog's first recorded errors -- the platform's, the left wheel's, the right wheel's -- read and
            '  cleared; answered after a refused start too. The reply is "err", so no host reads it as an ERROR reply.
            nOut1, nOut2, nOut3 := wheels.getError()
            strFmt.sFormatStr3(@msgWork, @"err %d %d %d\n", nOut1, nOut2, nOut3)
            serialQueue.sendResponse(@msgWork)

        CMD_GET_PACK_VOLT:
            ' PL-157: the optional pack sensor's reading: PACK_* status and mV (0 unless PACK_PRESENT)
            nOut1, nOut2 := wheels.getPackVoltage()
            strFmt.sFormatStr2(@msgWork, @"packvolt %d %d\n", nOut1, nOut2)
            serialQueue.sendResponse(@msgWork)

        CMD_GET_CURRENT:
            ' PL-157: each motor's current (0.1 mA units) and power draw (mW), net of the rest zero
            nOut1, nOut2, nOut3, nOut4 := wheels.getCurrent()
            strFmt.sFormatStr4(@msgWork, @"current %d %d %d %d\n", nOut1, nOut2, nOut3, nOut4)
            serialQueue.sendResponse(@msgWork)

        CMD_GET_FAULT_CAUSE:
            ' PL-157: why each wheel's most recent fault since start happened, FC_*
            nOut1, nOut2 := wheels.getFaultCause()
            strFmt.sFormatStr2(@msgWork, @"faultcause %d %d\n", nOut1, nOut2)
            serialQueue.sendResponse(@msgWork)

        CMD_GET_HOLD_STAT:
            ' PL-157: each wheel's hold at rest, HS_*, and its signed displacement in hall ticks
            nOut1, nOut2, nOut3, nOut4 := wheels.getHoldStatus()
            strFmt.sFormatStr4(@msgWork, @"holdstatus %d %d %d %d\n", nOut1, nOut2, nOut3, nOut4)
            serialQueue.sendResponse(@msgWork)

        CMD_GET_HALL_COUNTS:
            ' PL-157: each motor's missed hall transitions and illegal hall codes since start
            nOut1, nOut2, nOut3, nOut4 := wheels.getHallIntegrityCounts()
            strFmt.sFormatStr4(@msgWork, @"hallcounts %d %d %d %d\n", nOut1, nOut2, nOut3, nOut4)
            serialQueue.sendResponse(@msgWork)

        CMD_GET_HALL_ILLEGAL:
            ' PL-157: each motor's illegal hall codes split by kind: %000 entries, then %111 entries
            nOut1, nOut2, nOut3, nOut4 := wheels.getHallIllegalCodes()
            strFmt.sFormatStr4(@msgWork, @"hallillegal %d %d %d %d\n", nOut1, nOut2, nOut3, nOut4)
            serialQueue.sendResponse(@msgWork)

        CMD_CHECK_WIRING:
            ' PL-157: turns the platform a few degrees in place and back (blocks about 1.3 s, at most about 4 s); the verdict is each
            '  wheel's HLT_WIRING bit in gethealth. OK means the walk ran, whatever its verdict
            eError := wheels.checkWiring()
            replyWithStatus(pValues, eError)

        CMD_SET_START_CHK:
            ' get incoming parm values
            bRefuseChecks := LONG[pValues][serialQueue.ENT_PARM1_IDX]
            ' validate values
            if not (bRefuseChecks == TRUE or bRefuseChecks == FALSE)
                ' invalid, report so...
                strFmt.sFormatStr1(@msgWork, @"StartChecks (%d) out of range [-1, 0] (T/F)", bRefuseChecks)
                serialQueue.sendError(@msgWork)
            elseif bStartRefused == FALSE
                ' the motors started at power-up, before the host link opened: there is no start left to choose for
                serialQueue.sendError(@"StartChecks apply only to a start its checks refused: the motors are running")
            else
                retryStart(pValues, bRefuseChecks)

        other:
            debug("ERROR bad ENUM for command:", udec_(cmdEnum))

PRI bInRange(nCheckVal, min, max) : bInRangeStatus
' Return TRUE when a value is within an inclusive range.
'
' @param nCheckVal - the host-supplied value
' @param min - the lowest legal value
' @param max - the highest legal value
' @returns bInRangeStatus - TRUE when {nCheckVal} is within [min, max]

    bInRangeStatus := TRUE
    if nCheckVal < min or nCheckVal > max
        bInRangeStatus := FALSE

PRI replyWithStatus(pValues, eError) | eSteerError, eLeftError, eRightError
' Reply OK for a command the library accepted, else an ERROR reply naming the code.
'
' @param pValues - the parsed command entry, for the command's name
' @param eError - the library's result for the command

' Local Variables:
' @local eSteerError - this cog's collected steering error (drained, so the next failure records its own cause)
' @local eLeftError - this cog's collected left-wheel error
' @local eRightError - this cog's collected right-wheel error

    if eError == wheels.NO_ERROR
        serialQueue.sendOK()
    else
        ' drain this cog's error slots: they are sticky-first, and the next command's cause must be recordable
        eSteerError, eLeftError, eRightError := wheels.getError()
        debug("* command failed ", sdec_long(eError), sdec_long(eSteerError), sdec_long(eLeftError), sdec_long(eRightError))
        strFmt.sFormatStr3(@msgWork, @"%s failed: %s (%d)", long[pValues][serialQueue.ENT_CMDSTR_IDX], errorName(eError), eError)
        serialQueue.sendError(@msgWork)

PRI bStartChecksRefused() : bRefused | nLeftFailed, nRightFailed
' Return TRUE when a failed start() was refused by its start checks (R20.1), read from getHealth(), not getError(), so
' this cog's errors are left for the host's geterror.
'
' A start refused by its checks leaves a refusing HLT_* bit failed on a wheel; every other failure returns before the
' checks run (they never ran: nothing failed) or after they all passed. This top level never opts out of the refusal.
'
' @returns bRefused - T/F where T means a wheel still fails a check that refuses the start (HLT_ALL_CHECKS)

' Local Variables:
' @local nLeftFailed - the left wheel's failed HLT_* bits
' @local nRightFailed - the right wheel's failed HLT_* bits

    _, nLeftFailed, _, _, nRightFailed, _ := wheels.getHealth()
    bRefused := ((nLeftFailed | nRightFailed) & wheels.HLT_ALL_CHECKS) <> 0

PRI bSaysWhy(pValues) : bWhy | eCmd
' Return TRUE for a command the host link answers after a refused start (R20.1): gethealth, geterror and
' setstartchecks (PL-157).
'
' @param pValues - the parsed command entry
' @returns bWhy - T/F where T means the command is gethealth, geterror or setstartchecks

' Local Variables:
' @local eCmd - the command's CMD_* enum

    eCmd := long[pValues][serialQueue.ENT_CMDENUM_IDX]
    bWhy := (eCmd == CMD_GET_HEALTH) or (eCmd == CMD_GET_ERROR) or (eCmd == CMD_SET_START_CHK)

PRI retryStart(pValues, bRefuse) | senseCog, eError, eLeftError, eRightError
' Apply a host's setstartchecks after start()'s checks refused the platform (PL-157). TRUE keeps the refusal and replies
' OK. FALSE starts the platform anyway, as setStartChecks(FALSE) before start() would have, and replies OK once it runs
' (the link then answers every command), or an ERROR naming the code that stopped it. Nothing moves: start()'s checks
' only probe. It blocks for the start, about 1 s, plus up to about 4 s per wheel whose check still fails.
'
' @param pValues - the parsed command entry, for the command's name
' @param bRefuse - T/F where T means keep refusing a start whose checks fail, F means start anyway

' Local Variables:
' @local senseCog - the steering front cog's id (0-7), or -1 when the motors did not start
' @local eError - this cog's collected steering error, after a failed start
' @local eLeftError - this cog's collected left-wheel error
' @local eRightError - this cog's collected right-wheel error

    wheels.setStartChecks(bRefuse)
    if bRefuse == TRUE
        serialQueue.sendOK()
    else
        ' the refusal's errors have been the host's to read; this start records its own
        wheels.getError()
        senseCog := wheels.start(startPinLt, startPinRt, startVoltage, startDetectLt, startDetectRt)
        if senseCog >= 0
            bStartRefused := FALSE
            debug("* motors started with the start checks' refusal off")
            serialQueue.sendOK()
        else
            ' still not started: the link keeps answering only why
            eError, eLeftError, eRightError := wheels.getError()
            if eError == wheels.NO_ERROR
                eError := (eLeftError <> wheels.NO_ERROR) ? eLeftError : eRightError
            if eError == wheels.NO_ERROR
                eError := wheels.ERR_NOT_STARTED
            debug("* ERROR motors did not start: ", sdec_long(eError), sdec_long(eLeftError), sdec_long(eRightError))
            strFmt.sFormatStr3(@msgWork, @"%s failed: %s (%d)", long[pValues][serialQueue.ENT_CMDSTR_IDX], errorName(eError), eError)
            serialQueue.sendError(@msgWork)

PRI replyNotStarted(pValues)
' Reply to a command the host link does not answer after a refused start (R20.1): an ERROR naming ERR_NOT_STARTED.
' This cog's recorded errors are not drained, so geterror still returns the refusal's.
'
' @param pValues - the parsed command entry, for the command's name

    strFmt.sFormatStr3(@msgWork, @"%s failed: %s (%d)", long[pValues][serialQueue.ENT_CMDSTR_IDX], errorName(wheels.ERR_NOT_STARTED), wheels.ERR_NOT_STARTED)
    serialQueue.sendError(@msgWork)

PRI errorName(eError) : pName
' Return the name of a library error code, for a host reply.
'
' @param eError - an ERR_* code
' @returns pName - pointer to the code's name, or to "ERR_UNKNOWN" for a value that is not one

    case eError
        wheels.ERR_BAD_PIN_GROUP:
            pName := @"ERR_BAD_PIN_GROUP"
        wheels.ERR_PIN_GROUP_IN_USE:
            pName := @"ERR_PIN_GROUP_IN_USE"
        wheels.ERR_BAD_VOLTAGE:
            pName := @"ERR_BAD_VOLTAGE"
        wheels.ERR_BAD_DETECT_MODE:
            pName := @"ERR_BAD_DETECT_MODE"
        wheels.ERR_NO_FREE_COG:
            pName := @"ERR_NO_FREE_COG"
        wheels.ERR_ABI_MISMATCH:
            pName := @"ERR_ABI_MISMATCH"
        wheels.ERR_NOT_STARTED:
            pName := @"ERR_NOT_STARTED"
        wheels.ERR_NO_SENSE_TASK:
            pName := @"ERR_NO_SENSE_TASK"
        wheels.ERR_BAD_UNITS:
            pName := @"ERR_BAD_UNITS"
        wheels.ERR_BAD_COUNT:
            pName := @"ERR_BAD_COUNT"
        wheels.ERR_NO_WHEEL_DIA:
            pName := @"ERR_NO_WHEEL_DIA"
        wheels.ERR_LIMIT_UNRESOLVABLE:
            pName := @"ERR_LIMIT_UNRESOLVABLE"
        wheels.ERR_SYNC_TIMEOUT:
            pName := @"ERR_SYNC_TIMEOUT"
        wheels.ERR_BUSY:
            pName := @"ERR_BUSY"
        wheels.ERR_FAULT_NOT_CLEARED:
            pName := @"ERR_FAULT_NOT_CLEARED"
        wheels.ERR_EMERGENCY_STOPPED:
            pName := @"ERR_EMERGENCY_STOPPED"
        wheels.ERR_NO_RESPONSE:
            pName := @"ERR_NO_RESPONSE"
        wheels.ERR_BOARD_NOT_DETECTED:
            pName := @"ERR_BOARD_NOT_DETECTED"
        wheels.ERR_COMMAND_TIMEOUT:
            pName := @"ERR_COMMAND_TIMEOUT"
        wheels.ERR_START_CHECK_FAILED:
            pName := @"ERR_START_CHECK_FAILED"
        wheels.ERR_NOT_IMPLEMENTED:
            pName := @"ERR_NOT_IMPLEMENTED"
        wheels.ERR_PROTECTIVE_STOP:
            pName := @"ERR_PROTECTIVE_STOP"
        wheels.ERR_PLATFORM_BLOCKED:
            pName := @"ERR_PLATFORM_BLOCKED"
        other:
            pName := @"ERR_UNKNOWN"

PRI isPostiveValue(nCheckVal) : bPositiveStatus
' Return TRUE when a host-supplied distance, rotation or time count is at least 1 (the library's lower bound).
'
' @param nCheckVal - the host-supplied value
' @returns bPositiveStatus - TRUE when {nCheckVal} is at least 1

    bPositiveStatus := TRUE
    if nCheckVal < 1
        bPositiveStatus := FALSE

PRI isValidTimeUnit(timeUnits, pMsgBffr) : bValidStatus
' validate and return message when invalid
'
' @param timeUnits - the host-supplied DTU_* value
' @param pMsgBffr - pointer to a buffer for the error text, or 0 for none
' @returns bValidStatus - TRUE when the units are legal (the error text is written otherwise)

    bValidStatus := TRUE
    case timeUnits
        wheels.DTU_MILLISEC:
        wheels.DTU_SEC:
        other:
            bValidStatus := FALSE
            if pMsgBffr <> 0
                strFmt.sFormatStr1(pMsgBffr, @"TimeUnits (%d) not [DTU_MILLISEC, DTU_SEC]", timeUnits)

PRI isValidRotationUnit(rotUnits, pMsgBffr) : bValidStatus
' validate and return message when invalid
'
' @param rotUnits - the host-supplied DRU_* value
' @param pMsgBffr - pointer to a buffer for the error text, or 0 for none
' @returns bValidStatus - TRUE when the units are legal (the error text is written otherwise)

    bValidStatus := TRUE
    case rotUnits
        wheels.DRU_DEGREES:
        wheels.DRU_ROTATIONS:
        wheels.DRU_HALL_TICKS:
        other:
            bValidStatus := FALSE
            if pMsgBffr <> 0
                strFmt.sFormatStr1(pMsgBffr, @"RotationUnits (%d) not [DRU_DEGREES, DRU_ROTATIONS, DRU_HALL_TICKS]", rotUnits)

PRI isValidDistanceUnit(distUnits, pMsgBffr) : bValidStatus
' validate and return message when invalid
'
' @param distUnits - the host-supplied DDU_* value
' @param pMsgBffr - pointer to a buffer for the error text, or 0 for none
' @returns bValidStatus - TRUE when the units are legal (the error text is written otherwise)

    bValidStatus := TRUE
    case distUnits
        wheels.DDU_IN:
        wheels.DDU_MM:
        wheels.DDU_CM:
        wheels.DDU_FT:
        wheels.DDU_M:
        wheels.DDU_KM:
        wheels.DDU_MI:
        other:
            bValidStatus := FALSE
            if pMsgBffr <> 0
                strFmt.sFormatStr1(pMsgBffr, @"DistanceUnits (%d) not [DDU_IN, DDU_MM, DDU_CM, DDU_FT, DDU_M, DDU_KM, DDU_MI]", distUnits)

