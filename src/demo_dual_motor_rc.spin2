CON { timing }

  CLK_FREQ = 270_000_000                                        ' system freq as a constant
  _clkfreq = CLK_FREQ                                           ' set system clock

CON { fixed io pins }

  RX1      = 63  { I }                                          ' programming / debug
  TX1      = 62  { O }

  SF_CS    = 61  { O }                                          ' serial flash
  SF_SCK   = 60  { O }
  SF_SDO   = 59  { O }
  SF_SDI   = 58  { I }

  LA_CHAN0 = 56  { O }
  LA_CHAN1 = 57  { O }

  SBUS_RX  = 58  { I }



OBJ { our Drive Subsystem }

    user        : "isp_bldc_motor_userconfig"       ' driver configuration
    wheels      : "isp_steering_2wheel"                    ' the dual-drive BLDC motors
    remoteCtl   : "isp_flysky_rx"                   ' the FlySky Transmitter

VAR

    long    remoteCog


PUB main() | statusOK, basePinLt, basePinRt, voltage, motor, detectModeLt, detectModeRt, senseCog
'' DEMO Driving a two wheeled platform
''

' Local Variables:
' @local statusOK - TRUE when the S.BUS receiver cog started
' @local basePinLt - the validated left-motor base pin, or INVALID_PIN_BASE
' @local basePinRt - the validated right-motor base pin, or INVALID_PIN_BASE
' @local voltage - the validated drive voltage, or INVALID_VOLTAGE
' @local motor - the validated motor type, or INVALID_MOTOR
' @local detectModeLt - the validated left board detection mode, or INVALID_DET_MODE
' @local detectModeRt - the validated right board detection mode, or INVALID_DET_MODE
' @local senseCog - the steering front cog's id (0-7), or -1 when the motors did not start

    debug("* demo dual motor control via R/C")

    ' validate user settings/choicess
    '  do NOT start motor unless all are legit!
    basePinLt := wheels.validBasePinForChoice(user.LEFT_MOTOR_BASE)
    basePinRt := wheels.validBasePinForChoice(user.RIGHT_MOTOR_BASE)
    detectModeLt := wheels.validDetectModeForChoice(user.LEFT_BOARD_TYPE)
    detectModeRt := wheels.validDetectModeForChoice(user.RIGHT_BOARD_TYPE)
    voltage := wheels.validVoltageForChoice(user.DRIVE_VOLTAGE)
    motor := wheels.validMotorForChoice(user.MOTOR_TYPE)

    if basePinLt <> wheels.INVALID_PIN_BASE and basePinRt <> wheels.INVALID_PIN_BASE and voltage <> wheels.INVALID_VOLTAGE and motor <> wheels.INVALID_MOTOR and detectModeLt <> wheels.INVALID_DET_MODE and detectModeRt <> wheels.INVALID_DET_MODE
        ' start our dual motor driver

        ' start our motor drivers (left and right)
        senseCog := wheels.start(basePinLt, basePinRt, voltage, detectModeLt, detectModeRt)
        if senseCog < 0
            ' start() returned -1: getError() says why, and which wheel
            bCommandSucceeded(senseCog, @"start")
        else
            ' override defaults, use 100 %
            wheels.setMaxSpeed(100)
            wheels.setMaxSpeedForDistance(100)
            ' just don't draw current at stop
            wheels.holdAtStop(false)

            ' ---- TEST TEST TEST ----
            'remoteCtl.manualCalibrate()
            'debug("-- HOLD --")
            'repeat  ' hold here for now
            ' ---- TEST TEST TEST ----

            debug("* Set up - remote control")

            remoteCog := remoteCtl.start(SBUS_RX)
            statusOK := remoteCog <> 0 ? TRUE : FALSE
            if statusOK
                'remoteCtl.manualCalibrate()
                debug("R/C Running...")
                remoteControlMotor()
            else
                debug("EEEE: SBUS rcvr not started?!")

            ' turn off our SBUS drivers
            remoteCtl.stop()
        ' turn off our motor drivers (safe whether or not they started)
        wheels.stop()
    else
        debug("* ERROR user configuration NOT valid!")

    debug("* DONE")

PUB remoteControlMotor() | bIgnoreJoySticks, bDoneTesting, bShowState, loopCt, bShowDebugStatus, bEmerCutoff, bShowDriveStates, accrate, bOneRotation, accRngMin, accRngMax
'' Listen to FlySky and control motor, get status based on Switch/Joystick inputs
''

' Local Variables:
' @local bIgnoreJoySticks - TRUE while switch A is ON: joystick driving is disabled
' @local bDoneTesting - TRUE when switch C is OFF: end the control loop
' @local bShowState - TRUE while switch B is OFF: show the motor currents
' @local loopCt - passes of the control loop
' @local bShowDebugStatus - TRUE to turn on the receiver object's debug output for the switch-D read (fixed FALSE)
' @local bEmerCutoff - TRUE while switch D is OFF: emergency cutoff
' @local bShowDriveStates - TRUE while switch C is in its middle position: show the drive states
' @local accrate - the acceleration the VRA knob selects, mm/s squared
' @local bOneRotation - the channel-11 switch state: OFF asks for one rotation, ON re-arms it
' @local accRngMin - the VRA knob's lowest recorded reading
' @local accRngMax - the VRA knob's highest recorded reading

    waitms(500)    ' wait for 1/2 sec for backend to catch up

    'arm.gripClosed()
    debug("------")
    debug("- Lt Joy Hz - direction")
    debug("- Rt Joy Vt - speed")
    debug("------")
    debug("* swA DN     - enable joystick servo control")
    debug("* swB Toggle - show state")
    'debug("* swC UP     - ---")
    'debug("* swC MID    - ---")
    debug("* swC DN     - end control")
    debug("* swD DN     - emer cutoff")
    debug("* swE DN     - 1 rotation")
    debug("* VRA        - acceleration")
    debug("------")

    bLastShowState := VALUE_NOT_SET ' value can't happen
    bLastIgnoreJoyStks := VALUE_NOT_SET ' value can't happen
    bLastEmerCutoff := VALUE_NOT_SET ' value can't happen
    bLastShowDriveStates := VALUE_NOT_SET ' value can't happen

    loopCt := 0
    repeat
        'debug("* ", udec_long(loopCt))
        bShowDebugStatus := FALSE 'loopCt < 2 ? TRUE : FALSE
        'remoteCtl.showDebug(bShowDebugStatus)

        ' SwA Ignore JoySticks
        'debug("-- -- SW -- --")
        bIgnoreJoySticks := remoteCtl.isSwitchOn(remoteCtl.CTL_SW_A)
        bShowState := remoteCtl.isSwitchOff(remoteCtl.CTL_SW_B)
        ' SwC done, end loop!
        bDoneTesting := remoteCtl.isSwitchOff(remoteCtl.CTL_SW_C)
        bShowDriveStates := remoteCtl.isSwitchMiddle(remoteCtl.CTL_SW_C)
        ' SwD down = Emergency Cutoff
        remoteCtl.showDebug(bShowDebugStatus)
        bEmerCutoff := remoteCtl.isSwitchOff(remoteCtl.CTL_SW_D)
        remoteCtl.showDebug(FALSE)

        bOneRotation := remoteCtl.isSwitchOn(remoteCtl.CH_11)

        ' setAcceleration() takes mm/s squared, so the knob's travel is mapped onto a range in those units
        accRngMin, accRngMax := remoteCtl.chanMinMax(remoteCtl.CTL_VRA)
        accrate := map(remoteCtl.readchannel(remoteCtl.CTL_VRA), accRngMin, accRngMax, RC_ACCEL_MIN_MM_S2, RC_ACCEL_MAX_MM_S2)

        if bLastShowDriveStates <> bShowDriveStates
            debug("- sho ", sdec_long_(bShowDriveStates))
            if bShowDriveStates
                wheels.showDriveStates()
            bLastShowDriveStates := bShowDriveStates

        if bShowState <> bLastShowState
            'showServoPositions()
            if bShowState
                nLtAmps, nLtWatts, nRtAmps, nRtWatts := wheels.getCurrent()
                debug("  ltA=", sdec_long_(nLtAmps), ", rtA=", sdec_long_(nRtAmps))
            bLastShowState := bShowState

        if bEmerCutoff <> bLastEmerCutoff
            'debug("  NEW E VALUE")
            if bEmerCutoff
                debug("-------  Motor E-OFF")
                wheels.emergencyCutoff()
            else
                wheels.clearEmergency()
                if not bIgnoreJoySticks
                    debug("  Motor Enabled")
                else
                    debug("  Motor Disabled")
            bLastEmerCutoff := bEmerCutoff

        if not bShowDebugStatus and bLastIgnoreJoyStks <> bIgnoreJoySticks
            if bIgnoreJoySticks
                debug("  Motor CTL OFF")
            else
                debug("  Motor CTL enabled")
            bLastIgnoreJoyStks := bIgnoreJoySticks

        if accrate <> 0 and nAccelerationRate <> accrate
            nAccelerationRate := accrate
            debug("  Setting Motor Acceleration:", sdec(nAccelerationRate))
            wheels.setAcceleration(nAccelerationRate)

        if (not bEmerCutoff) and (remoteCtl.hasSignal() == FALSE)
            ' S-8: no transmitter -- the stick values are stale or the receiver's failsafe defaults, so
            '  nothing may drive on them: stop once, and drive again only when the signal returns
            if (priorSpeed <> 0) or (priorDirection <> 0)
                debug("- SIGNAL LOST: stopping the motors")
                bCommandSucceeded(wheels.stopMotors(), @"signal lost stop")
                priorSpeed := priorDirection := 0
        elseif not bEmerCutoff
            rcSpeed, rcDirection := updPosnBothJoy()
            if not bIgnoreJoySticks
                if priorDirection <> rcDirection or priorSpeed <> rcSpeed
                    debug("- JOY ", sdec_long(rcSpeed), sdec_long(rcDirection))
                    bCommandSucceeded(wheels.driveDirection(rcSpeed, rcDirection), @"joystick drive")
                    priorDirection := rcDirection
                    priorSpeed := rcSpeed
            elseif priorSpeed <> 0 and rcSpeed == 0
                ' if we were running when motors control stopped then allow a stop when it happens
                debug("- JOY (last) ", sdec_long(rcSpeed), sdec_long(rcDirection))
                bCommandSucceeded(wheels.driveDirection(rcSpeed, rcDirection), @"joystick stop")
                priorDirection := rcDirection
                priorSpeed := rcSpeed
            elseif bOneRotation == false and nDoingOneRotation == false         ' no emergency cutoff and no joystick before accept 1 rotation
                nDoingOneRotation := true
                doOneRotation()
            elseif bOneRotation == true and nDoingOneRotation == true           ' switch must be reset before allowed again
                nDoingOneRotation := false

        if bDoneTesting
            debug("--> quit loop")
            quit

        waitms(250) ' wait 1/4 second, before next loop
        loopCt++

    ' done, stop our motors
    wheels.stop()

PRI bCommandSucceeded(eError, pWhat) : bSucceeded | eSteerError, eLeftError, eRightError
' Report a refused command with the cause and the wheel, and collect this cog's errors so the next failure records its own.
'
' @param eError - the result a command returned (a start()'s -1 is reported the same way)
' @param pWhat - pointer to a short name of what was attempted, for the report
' @returns bSucceeded - T/F where T means the command was accepted and its motion can be waited on

' Local Variables:
' @local eSteerError - this cog's first steering-object error (collected outside debug(), which a non-debug build removes)
' @local eLeftError - this cog's first left-wheel error
' @local eRightError - this cog's first right-wheel error

    bSucceeded := (eError == wheels.NO_ERROR)
    if bSucceeded == FALSE
        eSteerError, eLeftError, eRightError := wheels.getError()
        debug("* ERROR ", zstr_(pWhat), " refused: ", sdec_long(eError), sdec_long(eSteerError), sdec_long(eLeftError), sdec_long(eRightError))

PRI waitUntilMotorReady()
    if wheels.isReady() == false
        debug("* wait motors ready...")
        repeat
            if wheels.isReady()
                quit
            else
                waitms(2)
    debug("* Motors ready, let's drive!")


PRI waitUntilMotorDone()
    if wheels.isStarting() == false
         debug("* wait until motors start...")
         repeat
            if wheels.isStarting()
                quit
            else
                waitms(2)

    if wheels.isStopped() == false
        debug("* wait until motors finish...")
        repeat
            if wheels.isStopped()
                quit
            else
                waitms(2)
    debug("* Motors stopped!")

CON

   VALUE_NOT_SET = -2

   ' the VRA knob's travel maps onto this acceleration range, mm/s squared (setAcceleration())
   RC_ACCEL_MIN_MM_S2 = 200
   RC_ACCEL_MAX_MM_S2 = 3_000

VAR

    long    priorSpeed
    long    priorDirection
    long    rcSpeed
    long    rcDirection
    long    nLtAmps
    long    nLtWatts
    long    nRtAmps
    long    nRtWatts

    long    bLastShowState
    long    bLastEmerCutoff
    long    bLastIgnoreJoyStks
    long    bLastShowDriveStates
    long    nAccelerationRate
    long    nDoingOneRotation

PRI doOneRotation() | ltdegree, rtdegree, eError
' Drive forward slowly until the left wheel turns one more full rotation, reporting the rotation counts.

' Local Variables:
' @local ltdegree - the left wheel's rotation count, degrees
' @local rtdegree - the right wheel's rotation count, degrees
' @local eError - the result of the rotation limit, then of the drive it guards

    ltdegree, rtdegree := wheels.getRotationCount(wheels.DRU_DEGREES)           ' get current wheel rotation
    ' arm the limit first and drive only if it was accepted, so the wheels never run without one
    eError := wheels.stopAfterRotation(ltdegree+360, wheels.DRU_DEGREES)        ' stop after 360degree wheel rotation
    if eError == wheels.NO_ERROR
        eError := wheels.driveDirection(10, 0)                                  ' drive forward slowly
    if bCommandSucceeded(eError, @"one rotation")
        debug("  Onrotation Driving:", sdec(ltdegree), " ", sdec(rtdegree))
        ltdegree, rtdegree := wheels.getRotationCount(wheels.DRU_DEGREES)       ' get current wheel rotation
        debug("  Onrotation Stopped:", sdec(ltdegree), " ", sdec(rtdegree))
        waitms(1000)
        ltdegree, rtdegree := wheels.getRotationCount(wheels.DRU_DEGREES)       ' get current wheel rotation
        debug("  Onrotation Check:", sdec(ltdegree), " ", sdec(rtdegree))

PRI updPosnBothJoy(): speed, direction | rawSpeed, rawDirection, rngMin, rngMax
' Read both joysticks and scale them to a drive speed and direction.
'
' @returns speed - the right stick's vertical position as a speed [-100 to 100]
' @returns direction - the left stick's horizontal position as a direction [-100 to 100]

' Local Variables:
' @local rawSpeed - the right stick's vertical channel reading
' @local rawDirection - the left stick's horizontal channel reading
' @local rngMin - the channel's lowest recorded reading
' @local rngMax - the channel's highest recorded reading

    ' route Rt Joystick Vt (spring center) to FWD/REV (speed)
    'debug("-- JOY -- JOY --")
    rawSpeed := remoteCtl.readChannel(remoteCtl.CTL_RT_JOY_VT)
    rngMin, rngMax := remoteCtl.chanMinMax(remoteCtl.CTL_RT_JOY_VT)
    speed := map(rawSpeed, rngMin, rngMax, -100, +100)

    ' route Lt Joystick Hz (spring center) to direction
    rawDirection := remoteCtl.readChannel(remoteCtl.CTL_LT_JOY_HZ)
    rngMin, rngMax := remoteCtl.chanMinMax(remoteCtl.CTL_LT_JOY_HZ)
    direction := map(rawDirection, rngMin, rngMax, -100, +100)

PRI map(inValue,  inMin,  inMax,  outMin,  outMax) : outValue
' Re-map a value from one range onto another, after Arduino's map()
'  (REF: https://www.arduino.cc/reference/en/language/functions/math/map), with two differences:
'  - it clamps: an input at or beyond an end of [inMin, inMax] returns that end of the output range
'  - so {inMin} must be below {inMax}; the output range may run either way (outMin > outMax reverses it)
'  Integer math: fractions are truncated, not rounded.
'
' @param inValue - the value to re-map
' @param inMin - the input range's low end
' @param inMax - the input range's high end
' @param outMin - the output value for {inMin}
' @param outMax - the output value for {inMax}
' @returns outValue - {inValue} re-mapped onto [outMin, outMax], clamped to its ends

    if (inValue <= inMin)
        outValue := outMin
    elseif (inValue >= inMax)
        outValue :=  outMax
    else
        outValue := (inValue - inMin) * (outMax - outMin) / (inMax - inMin) + outMin


