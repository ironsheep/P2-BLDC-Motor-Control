'' =================================================================================================
''
''   File....... demo_dual_motor_hdmi.spin2
''   Purpose.... Demonstrate driving a two-wheeled platform with both motors' live values on an HDMI display
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2023 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Mar 2023
''   Updated.... 1 Oct 2026
''
''   demo_dual_motor.spin2's reporting, with an HDMI display and one steady drive to watch it by. In order:
''   1. start() checks each wheel before anything moves, and refuses a wheel that fails -- how to tell why (getHealth())
''   2. checkWiring(): an opt-in check that moves the robot a few degrees to prove the hall and phase wiring
''   3. the fault response in effect (FR_GRADED by default), and how to choose another (setFaultResponse())
''   4. one drive, both wheels at different powers for 10 s, with the limit armed BEFORE the drive it guards
''   5. after it: why it ended (getStopReason()), and what the drive handled on its own (getEvent())
''
'' =================================================================================================

' Select the two-wheel configuration in isp_bldc_motor_userconfig.spin2
#DEFINE CFG_DUAL_MOTOR
#IFDEF __PNUT_TS__
#PRAGMA EXPORTDEF CFG_DUAL_MOTOR
#ENDIF

CON { timing }

  ' This demo runs at its HDMI video mode's clock: the video driver sets 270 MHz when the display starts, which is
  '  before the motors start (they take their timing from the clock at start()).
  CLK_FREQ = 270_000_000                                        ' system freq as a constant
  _clkfreq = CLK_FREQ                                           ' set system clock

CON { fixed io pins }

  RX1      = 63  { I }                                          ' programming / debug
  TX1      = 62  { O }

  SF_CS    = 61  { O }                                          ' serial flash
  SF_SCK   = 60  { O }
  SF_SDO   = 59  { O }
  SF_SDI   = 58  { I }

CON { application io pins }

    HDMI_BASE_PIN       = tvDebug.PINS_P0_P7

CON { the demo's drive }

    WATCH_SECS          = 10                ' the drive's time limit, long enough to watch the display
    ' bWaitUntilMotorDone()'s bound is the limit plus this, for the ramp down and a margin. A drive that is not over
    '  by then is stopped, and reported: something ended it late, or its limit never fired.
    MOVE_MARGIN_MS      = 5_000
    MOVE_POLL_MS        = 10

OBJ { our Drive Subsystem }

    user    :   "isp_bldc_motor_userconfig"             ' driver configuration
    wheels  :   "isp_steering_2wheel"                   ' the dual-drive BLDC motors
    tvDebug :   "isp_hdmi_debug"                        ' HDMI debug object
    names   :   "demo_drive_names"                      ' words for the drive's reported values, for the debug output

DAT { run-time condition vars }

    bUseHDMI    LONG   TRUE       ' set to TRUE to enable HDMI use/output

PUB main() | basePinLt, basePinRt, voltage, motor, basePin, detectModeLt, detectModeRt, senseCog, eError
'' DEMO Driving a two wheeled platform
''

' Local Variables:
' @local basePinLt - the validated left-motor base pin, or INVALID_PIN_BASE
' @local basePinRt - the validated right-motor base pin, or INVALID_PIN_BASE
' @local voltage - the validated drive voltage, or INVALID_VOLTAGE
' @local motor - the validated motor type, or INVALID_MOTOR
' @local basePin - the validated HDMI base pin, or INVALID_PIN_BASE
' @local detectModeLt - the validated left board detection mode, or INVALID_DET_MODE
' @local detectModeRt - the validated right board detection mode, or INVALID_DET_MODE
' @local senseCog - the steering front cog's id (0-7), or -1 when the motors did not start
' @local eError - the result of the latest command (the limit, then the drive it guards)

    showLine(@"* dual motor demo w/HDMI")

    ' start our HDMI debug output
    if bUseHDMI
        basePin := tvDebug.validBasePinForChoice(HDMI_BASE_PIN)
        if basePin <> tvDebug.INVALID_PIN_BASE
            tvDebug.start(basePin)
            showLine(@"* HDMI started")
        else
            showLine(@"* ERROR HDMI base pin not valid: no display")

    ' validate user settings/choices
    '  do NOT start motor unless all are legit!
    basePinLt := wheels.validBasePinForChoice(user.LEFT_MOTOR_BASE)
    basePinRt := wheels.validBasePinForChoice(user.RIGHT_MOTOR_BASE)
    detectModeLt := wheels.validDetectModeForChoice(user.LEFT_BOARD_TYPE)
    detectModeRt := wheels.validDetectModeForChoice(user.RIGHT_BOARD_TYPE)
    voltage := wheels.validVoltageForChoice(user.DRIVE_VOLTAGE)
    motor := wheels.validMotorForChoice(user.MOTOR_TYPE)

    if basePinLt <> wheels.INVALID_PIN_BASE and basePinRt <> wheels.INVALID_PIN_BASE and voltage <> wheels.INVALID_VOLTAGE and motor <> wheels.INVALID_MOTOR and detectModeLt <> wheels.INVALID_DET_MODE and detectModeRt <> wheels.INVALID_DET_MODE
        ' 1. start() checks each wheel's hall sensors, current sense and motor leads with nothing moving, retries a
        '  check that fails, and refuses to start if one still fails. TRUE is the default; setStartChecks(false),
        '  called before start(), starts the platform anyway (getHealth() still reports what failed).
        wheels.setStartChecks(true)

        ' start our motor drivers (left and right)
        senseCog := wheels.start(basePinLt, basePinRt, voltage, detectModeLt, detectModeRt)
        if senseCog < 0
            ' start() returned -1: getError() says why, and for which wheel. A refused start check is
            '  ERR_START_CHECK_FAILED, and getHealth() then names the check -- a disconnected motor lead, say
            bCommandSucceeded(senseCog, @"start")
            showHealth()
        else
            showHealth()                                        ' what the start checks found, even when they passed
            showPack()

            ' coast at rest: the default, set here so you can find it. holdAtStop(true) holds each wheel's position at
            '  rest instead, drawing current to do it
            wheels.holdAtStop(false)

            ' wait until both drivers are ready to be commanded, before anything moves
            waitUntilMotorReady()

            ' 2. prove the wiring. This MOVES THE ROBOT: each wheel turns one electrical cycle (about 3.5 cm at the
            '  tyre) out and back, the two wheels opposite ways, so the platform turns a few degrees in place and
            '  returns. Its verdict is each wheel's HLT_WIRING bit in getHealth().
            if bCommandSucceeded(wheels.checkWiring(), @"checkWiring")
                showWiring()

            ' 3. what a wheel does if its rotor cannot follow the field (an overload or a stall)
            showFaultResponse()

            if bUseHDMI
                connectMotorToHDMI()

            ' 4. now drive! -- always arm the limit BEFORE driving, so the motors never run without one
            showLine(@"* BOTH Wheels, different powers (left 40, right 50)")
            eError := wheels.stopAfterTime(WATCH_SECS, wheels.DTU_SEC)      ' stop after WATCH_SECS, time to watch the display
            if eError == wheels.NO_ERROR
                eError := wheels.driveAtPower(40, 50)
            if bCommandSucceeded(eError, @"both wheels")
                bWaitUntilMotorDone(WATCH_SECS * 1_000 + MOVE_MARGIN_MS)
            showWhatHappened()                                  ' 5. expect SR_AT_LIMIT: the time limit was reached

        ' turn off our motor drivers (safe whether or not they started)
        wheels.stop()
    else
        showLine(@"* ERROR user configuration NOT valid!")

    showLine(@"* DONE")

PRI showHealth() | nLeftChecked, nLeftFailed, nLeftRecovered, nRightChecked, nRightFailed, nRightRecovered
' Report what start() checked on each wheel, which checks failed, and which failed at first and passed on a retry.
'
' getHealth() returns three masks of HLT_* bits per wheel. A recovered check started the motor normally -- it is
' worth knowing about (a loose connector can look like that), but it is not a failure.

' Local Variables:
' @local nLeftChecked - the left wheel's HLT_* bits that were checked
' @local nLeftFailed - ...that still failed
' @local nLeftRecovered - ...that failed, then passed on a retry
' @local nRightChecked - the right wheel's, likewise
' @local nRightFailed - the right wheel's still failing
' @local nRightRecovered - the right wheel's recovered

    nLeftChecked, nLeftFailed, nLeftRecovered, nRightChecked, nRightFailed, nRightRecovered := wheels.getHealth()
    dbgBegin(@"* start checks: LEFT checked ")
    dbgHex(nLeftChecked, 2)
    dbgText(@", RIGHT checked ")
    dbgHex(nRightChecked, 2)
    dbgShow()
    showHealthBits(@"LEFT", @"FAILED", nLeftFailed)
    showHealthBits(@"LEFT", @"recovered on a retry", nLeftRecovered)
    showHealthBits(@"RIGHT", @"FAILED", nRightFailed)
    showHealthBits(@"RIGHT", @"recovered on a retry", nRightRecovered)

PRI showHealthBits(pWheel, pWhat, nBits) | nBit
' Name each check set in a getHealth() mask.
'
' @param pWheel - pointer to the wheel's name
' @param pWhat - pointer to what the mask means (failed, or recovered)
' @param nBits - the mask of HLT_* bits

' Local Variables:
' @local nBit - the bit being tested

    repeat nBit from 0 to names.HEALTH_BITS - 1
        if nBits & (1 << nBit)
            dbgBegin(@"*   ")
            dbgText(pWheel)
            dbgText(@" ")
            dbgText(names.healthBit(nBit))
            dbgText(@" ")
            dbgText(pWhat)
            dbgShow()

PRI showWiring() | nLeftFailed, nRightFailed
' Report checkWiring()'s verdict for each wheel: its HLT_WIRING bit in getHealth()'s failed mask.

' Local Variables:
' @local nLeftFailed - the left wheel's failed bits
' @local nRightFailed - the right wheel's failed bits

    _, nLeftFailed, _, _, nRightFailed, _ := wheels.getHealth()
    dbgBegin(@"* wiring: ")
    dbgWheels((nLeftFailed & wheels.HLT_WIRING) ? @"FAILED" : @"ok", (nRightFailed & wheels.HLT_WIRING) ? @"FAILED" : @"ok")
    dbgShow()

PRI showPack() | ePackStatus, nMilliVolts
' Report the battery pack's voltage, when the optional pack voltage sensor is fitted (VOLTAGE-SENSOR.md).

' Local Variables:
' @local ePackStatus - PACK_NOT_FITTED, PACK_ABSENT or PACK_PRESENT
' @local nMilliVolts - the pack voltage, mV, when PACK_PRESENT

    ePackStatus, nMilliVolts := wheels.getPackVoltage()
    dbgBegin(@"* pack: ")
    dbgText(names.packStatus(ePackStatus))
    dbgText(@" ")
    dbgUdec(nMilliVolts)
    dbgText(@" mV")
    dbgShow()

PRI showFaultResponse() | eMode, brakePct
' Report the fault response in effect.
'
' FR_GRADED, the default, re-syncs from the hall sensors and stops along the ramp when a wheel's rotor cannot follow
' its field, which is gentle on a tall robot; if control is lost anyway it coasts, or with holdAtStop(TRUE) brakes at
' 10 %. FR_SHIPPED coasts or brakes with the full short at once (per holdAtStop()) instead:
'   wheels.setFaultResponse(wheels.FR_SHIPPED, 10)
' start() restores the default, so a program sets its choice after each start().

' Local Variables:
' @local eMode - FR_SHIPPED or FR_GRADED
' @local brakePct - the graded brake's share of a full short, %

    eMode, brakePct := wheels.getFaultResponse()
    dbgBegin(@"* fault response: ")
    dbgText(names.faultResponse(eMode))
    dbgText(@", brake ")
    dbgUdec(brakePct)
    dbgText(@" %")
    dbgShow()

PRI showWhatHappened() | eLeftReason, eRightReason
' After a drive: why each wheel's drive ended, then every event the drive logged since the last look.
'
' getStopReason() answers "why did it stop?" -- SR_AT_LIMIT for a limit you armed, SR_COMMANDED for a stop you
' asked for, and otherwise something you did NOT ask for: a fault, a blocked wheel, a lost link, an emergency stop.
' SR_PARTNER means the other wheel's condition stopped this one; read the other wheel's reason. It stays readable
' until that wheel's next drive command.

' Local Variables:
' @local eLeftReason - the left wheel's SR_* value
' @local eRightReason - the right wheel's SR_* value

    eLeftReason, eRightReason := wheels.getStopReason()
    dbgBegin(@"* stopped: ")
    dbgWheels(names.stopReason(eLeftReason), names.stopReason(eRightReason))
    dbgShow()
    showEvents()

PRI showEvents() | eKind, nMs, eWheel, nValue
' Drain this cog's event log: what the drive handled on its own, oldest first, both wheels merged.
'
' Each cog reads every event for itself. A cog that falls more than EV_QUEUE_DEPTH events behind is told first, with
' EV_LOST (its value: how many it lost) -- so a gap never reads as "nothing happened". EV_STOP's value is the stop
' reason; most others carry a count or a measurement (DRIVE-OBJECTS.md, "Stop reasons and events").

' Local Variables:
' @local eKind - the event's EV_* kind; EV_NONE when all are read
' @local nMs - getms() when it happened
' @local eWheel - EVW_LEFT, EVW_RIGHT or EVW_PLATFORM
' @local nValue - the event's value

    repeat
        eKind, nMs, eWheel, nValue := wheels.getEvent()
        if eKind == wheels.EV_NONE
            quit
        dbgBegin(@"*   event ")
        dbgUdec(nMs)
        dbgText(@" ms ")
        dbgText(wheelName(eWheel))
        dbgText(@" ")
        dbgText(names.eventKind(eKind))
        dbgText(@" ")
        if eKind == wheels.EV_STOP
            dbgText(names.stopReason(nValue))                  ' a stop's value is its reason, SR_*
        else
            dbgSdec(nValue)
        dbgShow()

PRI wheelName(eWheel) : pName
' Name getEvent()'s wheel: the left's, the right's, or the platform's own event (a late front-cog pass, the pack).
'
' @param eWheel - EVW_LEFT, EVW_RIGHT or EVW_PLATFORM
' @returns pName - pointer to its name

    case eWheel
        wheels.EVW_LEFT:
            pName := @"LEFT"
        wheels.EVW_RIGHT:
            pName := @"RIGHT"
        other:
            pName := @"PLATFORM"

PRI connectMotorToHDMI() | nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars
' connect our two motors to the HDMI display mech

' Local Variables:
' @local nGroups - number of display groups in the tables
' @local pGroupTitles - pointer to the table of group-title string pointers
' @local pGroupNames - pointer to the table of variable-name string pointers, by group
' @local pGroupVarCts - pointer to the table of variable counts, one per group
' @local pGroupVars - pointer to the table of variable-value pointers, by group

    if bUseHDMI
        nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars := wheels.getLeftDebugData()
        showReceived(@"* Received Lt:", nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars)
        tvDebug.registerDisplay(nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars)

        ' the right wheel's set
        nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars := wheels.getRightDebugData()
        showReceived(@"* Received Rt:", nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars)
        tvDebug.registerDisplay(nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars)

        ' and the steering object's own set
        nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars := wheels.getDebugData()
        showReceived(@"* Received Steer:", nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars)
        tvDebug.registerDisplay(nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars)

PRI showReceived(pLead, nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars)
' Print one display-table set connectMotorToHDMI() is about to register, after a lead-in, each value labelled with
' connectMotorToHDMI()'s name for it.
'
' @param pLead - pointer to the text before the values
' @param nGroups - number of display groups in the tables
' @param pGroupTitles - pointer to the table of group-title string pointers
' @param pGroupNames - pointer to the table of variable-name string pointers, by group
' @param pGroupVarCts - pointer to the table of variable counts, one per group
' @param pGroupVars - pointer to the table of variable-value pointers, by group

    dbgBegin(pLead)
    dbgText(@" nGroups = ")
    dbgUdec(nGroups)
    dbgText(@", pGroupTitles = ")
    dbgHex(pGroupTitles, 8)
    dbgText(@", pGroupNames = ")
    dbgHex(pGroupNames, 8)
    dbgText(@", pGroupVarCts = ")
    dbgHex(pGroupVarCts, 8)
    dbgText(@", pGroupVars = ")
    dbgHex(pGroupVars, 8)
    dbgShow()

PRI bCommandSucceeded(eError, pWhat) : bSucceeded | eSteerError, eLeftError, eRightError
' Report a refused command with the cause and the wheel, and collect this cog's errors so the next failure records its own.
'
' @param eError - the result a command returned (a start()'s -1 is reported the same way)
' @param pWhat - pointer to a short name of what was attempted, for the report
' @returns bSucceeded - T/F where T means the command was accepted and its motion can be waited on

' Local Variables:
' @local eSteerError - this cog's first steering-object error (collected outside debug(), which a non-debug build removes)
' @local eLeftError - this cog's first left-wheel error
' @local eRightError - this cog's first right-wheel error

    bSucceeded := (eError == wheels.NO_ERROR)
    if bSucceeded == FALSE
        eSteerError, eLeftError, eRightError := wheels.getError()
        dbgBegin(@"* ERROR ")
        dbgText(pWhat)
        dbgText(@" refused: ")
        dbgText(names.errorName(eSteerError))
        dbgText(@", ")
        dbgWheels(names.errorName(eLeftError), names.errorName(eRightError))
        dbgShow()

PRI waitUntilMotorReady()
' if wheels are NOT ready, then wait until they are ready

    if wheels.isReady() == false
        showLine(@"* wait motors ready...")
        repeat
            if wheels.isReady()
                quit
            else
                waitms(2)
    showLine(@"* Motors ready, let's drive!")


PRI bWaitUntilMotorDone(maxMs) : bDone | startMs, eLeftReason, eRightReason, eSteerError, eLeftError, eRightError
' Wait, at most {maxMs}, for the drive just commanded to be over on both wheels -- however it ends -- then say why.
'
' isMoveDone() is TRUE once both wheels are at rest with no drive commanded, and at once on a fault, an emergency stop
' or a protective stop, so this cannot hang on one of those (waiting for isStopped() alone did). It is FALSE from the
' moment the drive command is accepted, so no short-lived state can be missed between polls. The bound covers the one
' case it cannot: a drive whose limit never fires. Then both motors are stopped here, and getError() is reported.
'
' @param maxMs - the longest the drive may take, ms: its limit plus a margin
' @returns bDone - T/F where T means the drive ended by itself within {maxMs}

' Local Variables:
' @local startMs - getms() when the wait began
' @local eLeftReason - why the left wheel's drive ended, getStopReason()
' @local eRightReason - why the right wheel's drive ended
' @local eSteerError - this cog's first steering-object error, on a timeout (collected outside debug())
' @local eLeftError - this cog's first left-wheel error, on a timeout
' @local eRightError - this cog's first right-wheel error, on a timeout

    showLine(@"* wait until motors finish...")
    startMs := getms()
    repeat until wheels.isMoveDone() or (getms() - startMs >= maxMs)
        waitms(MOVE_POLL_MS)
    bDone := wheels.isMoveDone()
    if bDone == FALSE
        wheels.stopMotors()                                     ' the drive outlived its bound: end it, then report
        eSteerError, eLeftError, eRightError := wheels.getError()
        dbgBegin(@"* TIMEOUT: the drive was not over after ")
        dbgUdec(maxMs)
        dbgText(@" ms, stopped; errors: ")
        dbgText(names.errorName(eSteerError))
        dbgText(@", ")
        dbgWheels(names.errorName(eLeftError), names.errorName(eRightError))
        dbgShow()
    eLeftReason, eRightReason := wheels.getStopReason()
    dbgBegin(@"* Motors done in ")
    dbgUdec(getms() - startMs)
    dbgText(@" ms: ")
    dbgWheels(names.stopReason(eLeftReason), names.stopReason(eRightReason))
    dbgShow()

PRI showLine(pText)
' Print one line of fixed text.
'
' @param pText - pointer to the zero-terminated text to print

    dbgBegin(pText)
    dbgShow()

CON { the debug line builder }

' WHY THIS DEMO BUILDS ITS DEBUG LINES. Each debug() statement is compiled into its own record, its text and its
' formatting included, and a -d image drops every record that lies too far into it (DOCs/procedures/
' PLOT-DISPLAY-RULES.md, rules 1-2). So this demo builds each line it prints in a hub buffer, with ordinary code that
' is in the image with or without -d, and prints it with the one debug() in dbgShow(). A line is started with
' dbgBegin(), extended with dbgText() / dbgUdec() / dbgSdec() / dbgHex() / dbgWheels(), and printed with dbgShow().
' The numbers come out as the debug formatters print them: dbgUdec() as udec_() and dbgSdec() as sdec_() (an
' underscore every three digits, 20_711), dbgHex() as uhex_byte_() or uhex_long_() ($0F, $09F4_9F49). A labelled
' formatter such as sdec(x) prints "x = 5", and ", " between two values in a row; those are written here as text.
' One cog -- the demo's main cog -- builds and prints lines.

    DBG_LINE_BYTES = 256                ' the longest line here is under 200 bytes; anything past the end is dropped

VAR

    byte    dbgLine[DBG_LINE_BYTES]     ' the line being built, zero-terminated
    long    dbgLineLen                  ' its length, not counting the terminator

PRI dbgBegin(pText)
' Start a new debug line with {pText}.
'
' @param pText - pointer to the line's first text

    dbgLineLen := 0
    dbgLine[0] := 0
    dbgText(pText)

PRI dbgText(pText)
' Append zero-terminated text to the debug line.
'
' @param pText - pointer to the text

    repeat strsize(pText)
        dbgChar(byte[pText++])

PRI dbgWheels(pLeft, pRight)
' Append the two wheels' words: "LEFT <left>, RIGHT <right>".
'
' @param pLeft - pointer to the left wheel's word
' @param pRight - pointer to the right wheel's word

    dbgText(@"LEFT ")
    dbgText(pLeft)
    dbgText(@", RIGHT ")
    dbgText(pRight)

PRI dbgUdec(nValue) | nPlace, nDigits
' Append {nValue} as an unsigned decimal, as udec_() prints it: an underscore every three digits (20_711).
'
' @param nValue - the value, taken as unsigned

' Local Variables:
' @local nPlace - the place value of the digit being appended (1, 10, 100 ...)
' @local nDigits - digits still to append

    nPlace := 1
    nDigits := 1
    repeat while (nPlace < 1_000_000_000) and ((nValue +/ nPlace) >= 10)    ' +/ and +// are the unsigned divides
        nPlace *= 10
        nDigits++
    repeat
        dbgChar("0" + ((nValue +/ nPlace) +// 10))
        nPlace /= 10
        nDigits--
        if (nDigits > 0) and (nDigits // 3 == 0)
            dbgChar("_")
    until nDigits == 0

PRI dbgSdec(nValue)
' Append {nValue} as a signed decimal, as sdec_() prints it (-15_090_904).
'
' @param nValue - the value

    if nValue < 0
        dbgChar("-")
        nValue := 0 - nValue            ' -2_147_483_648 stays $8000_0000, which dbgUdec() prints as 2_147_483_648
    dbgUdec(nValue)

PRI dbgHex(nValue, nDigits) | nNibble
' Append the low {nDigits} hex digits of {nValue} after a "$", with an underscore every four digits, as uhex_byte_()
' (2 digits, $0F) and uhex_long_() (8 digits, $09F4_9F49) print them.
'
' @param nValue - the value
' @param nDigits - how many hex digits to append

' Local Variables:
' @local nNibble - the digit's value, 0 to 15

    dbgChar("$")
    repeat while nDigits > 0
        nDigits--
        nNibble := (nValue >> (nDigits << 2)) & $F
        dbgChar(nNibble < 10 ? "0" + nNibble : "A" + nNibble - 10)
        if (nDigits > 0) and (nDigits // 4 == 0)
            dbgChar("_")

PRI dbgChar(charByte)
' Append one character to the debug line, dropping any past its end.
'
' @param charByte - the character

    if dbgLineLen < DBG_LINE_BYTES - 1
        dbgLine[dbgLineLen] := charByte
        dbgLineLen++
        dbgLine[dbgLineLen] := 0

PRI dbgShow()
' Print the debug line: this demo's one debug() statement (the section's header says why).

    debug(zstr_(@dbgLine))

