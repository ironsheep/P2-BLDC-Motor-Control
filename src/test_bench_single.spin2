    benchLog.numField(@"arr_tol_pm", RAMPARR_TOL_PM, LIM_SMALL)
    lineEmit()
    ' phase 2b's numbers (each row's coast bound prints in B1-ROW): L-coast and L-passprb, then L-offscan
    benchLog.begin(@"B1-MOTOR3")
    benchLog.numField(@"coast_us", COAST_SAMPLE_US, LIM_SMALL)
    benchLog.numField(@"coast_max_n", COAST_MAX_SAMPLES, LIM_SMALL)
