    benchLog.textField(@"lead_fitq", (LEADMOVE_FITQ == FITQ_DC) ? @sFitqDc : @sFitqDuty)    ' arbiter decision D9
    lineEmit()
    ' phase 2c's numbers (each row's steps print in the leg's own records)
    benchLog.begin(@"B1-MOTOR5")
    benchLog.numField(@"hand_power", HAND_POWER, LIM_TINY)
    benchLog.numField(@"contact_pm", HAND_CONTACT_PM, LIM_SMALL)
