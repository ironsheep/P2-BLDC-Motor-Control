    benchLog.numField(@"cap_incr", PK1_CAP_INCR, LIM_BIG)
    benchLog.numField(@"cap_from_mv", PK1_CAP_FROM_MV, LIM_MID)
    benchLog.numField(@"ext_rungs", LADDER_EXT_COUNT, LIM_TINY)
    benchLog.boolField(@"ke_fitted", KE_IS_FITTED)
    benchLog.numField(@"ke_used", KE_USED_MV_PER_KRPM, LIM_SMALL)  ' task 3686: the fitted Ke in a SINGLE_QUALIFY build
