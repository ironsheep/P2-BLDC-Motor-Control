sPhIntro        BYTE    "INTRO", 0
sPhSetup        BYTE    "SETUP", 0
sPhAct          BYTE    "ACT", 0
sPhRestore      BYTE    "RESTORE", 0
sPhResult       BYTE    "RESULT", 0
sPhSkip         BYTE    "SKIP", 0
sPhStarting     BYTE    "STARTING", 0
sPhStopped      BYTE    "STOPPED", 0
sPhAllDone      BYTE    "ALLDONE", 0
sBtStart        BYTE    "START_STEP", 0
sBtDone         BYTE    "DONE", 0
sBtNext         BYTE    "NEXT_STEP", 0
sBtFinish       BYTE    "FINISH", 0
sBtStop         BYTE    "STOP_MOTOR", 0
sBtRedo         BYTE    "REDO_STEP", 0
sBtMiss         BYTE    "MISS", 0
sBtIgnored      BYTE    "IGNORED", 0
sSfPass         BYTE    "PASS", 0
sSfFail         BYTE    "FAIL", 0
sSfNomeas       BYTE    "NOMEAS", 0

VAR { the run }

    LONG    runStartMs                                      ' getms() when the run began: RUN_TIME_CAP_S counts from here
    LONG    eAbortReason                                    ' AR_*: the first cause the run ended early
    LONG    abortDetail                                     ' the abort's detail (see AR_*)
    LONG    eBoardPre                                       ' REV_*: the board read before start()
    LONG    eBoardStarted                                   ' REV_*: the board start() recorded
    LONG    senseMvPerA                                     ' the detected board's current-sense scale, mV per A
    LONG    zeroMvX10                                       ' the rest zero of the current sense, mV x10
    LONG    chargeMaMs                                      ' the DC-link charge while driven, mA x ms (signed: noise cancels)
    LONG    peakMa                                          ' the highest DC-link sample while driven, mA
    LONG    overSamples                                     ' consecutive samples at or over abortMa
    LONG    abortMa                                         ' phase 2c: the absolute abort in force, mA (ABS_ABORT_MA but in the default step)
    LONG    runIdleMs                                       ' phase 2c: ms a screen waited on the operator, which the time cap does not count
    LONG    stepStallMaMs, legStallMaMs                     ' phase 2c: the stall charge (above NO_LOAD_MA_MAX), mA x ms: a step's, the leg's
    LONG    stepStallCapMas, legStallCapMas                 ' phase 2c: their caps in force, mA x s (0: none)

VAR { the burst under way: its captured edges }

    LONG    burstEdges                                      ' edges taken this burst (the stored ones, and any after)
    LONG    edgeEnc[BURST_SPAN_EDGES]                       ' the encoder count the PASM capture latched at each edge
    LONG    edgeCodes[BURST_SPAN_EDGES]                     ' the new hall code | the previous one << CODE_PREV_SHIFT
    LONG    edgeDtUs[BURST_SPAN_EDGES]                      ' microseconds since the previous captured edge

VAR { the hall map, per set }

    LONG    legBase                                         ' the encoder count 30 counts before the leg's first edge: slot 0 begins here
    LONG    bLegBaseSet
    LONG    slotSum[SET_CELLS]                              ' the sum of each slot's edge positions, counts past its slot base
    LONG    slotCount[SET_CELLS]                            ' edges in each slot
    LONG    slotKind[SET_CELLS]                             ' the hall boundary (0..5) the slot's first edge crossed
    LONG    slotMisfit[SET_CELLS]                           ' edges in the slot that crossed another boundary
    LONG    setWidthX10[SET_CELLS]                          ' each slot's width to the next, counts x10
    LONG    zFirst[SET_COUNT]                               ' the set's first edge's zero estimate, counts (0..359)
    LONG    zSumDev[SET_COUNT]                              ' the sum of every later estimate's offset from it, unwrapped
    LONG    zCount[SET_COUNT]
    LONG    setZx10[SET_COUNT]                              ' the hall pattern's zero in the encoder's frame, counts x10 (0..3_599)
    LONG    setTicks[SET_COUNT]                             ' the set's signed hall ticks: its measured direction
    LONG    setBadEdges[SET_COUNT]                          ' skipped or illegal transitions among the mapped edges
    LONG    setEncDevWorst[SET_COUNT]                       ' R23-SGL-ENCCHK: the worst burst
    LONG    setBurstsChecked[SET_COUNT]
    LONG    setBurstsMapped[SET_COUNT]
    LONG    setSectDevX10[SET_COUNT]                        ' R23-SGL-SECTOR: the worst sector, or SECTOR_BROKEN_X10
    LONG    bSetFinished[SET_COUNT]

VAR { phase 2a: the row, the drive's constants, the sampler }

    LONG    rowIdx                                          ' the told voltage's row in DAT rowMv, or -1
    LONG    rowCeil                                         ' the row's shipped ceiling (the mirror), increment
    LONG    rowTop                                          ' the row's top: the ceiling, capped at PK1_CAP_INCR from PK1_CAP_FROM_MV up
    LONG    rowTopPower                                     ' the power that commands no more than rowTop
    LONG    cpsLawK                                         ' the drive law in counts: counts/s x 1000 = |incr| x this / 2^31
    LONG    dutyMax                                         ' the drive's duty ceiling (testGetDriveConstants())
    LONG    frameCnt                                        ' the PWM frame, clocks (testGetDriveConstants())
    LONG    rampJerkUp, rampAccelUp, rampJerkDn, rampAccelDn ' the built-in ramp's four limits (testGetRampLimits())
    LONG    encPosSign                                      ' bWindowEncOk(): 0 until set, then +1 / -1, the encoder's sign per hall tick
    LONG    winChkWorst                                     ' bWindowEncOk(): the worst window's |dev|, counts

    LONG    smpPeriodCt, smpNextCt                          ' the sampler's cadence
    LONG    smpEnc, smpCt, smpMs, smpPos                    ' the latest reading: encoder, getct(), getms(), the driver's hall position
    LONG    smpDuty, smpErr, smpSenseMv, smpState, bSmpFault ' ... the drive's telemetry
    LONG    smpLagHeld, smpDutyCapped, smpDrvIncr           ' ... and its health counters
    LONG    bSmpMoved, smpZeroMs                            ' the field has moved since sampleBegin(); getms() it first read 0 after
    LONG    arrEnc[ARR_RING], arrCt[ARR_RING], arrHead, arrFill     ' the arrival speed's ring
    LONG    restEnc[REST_RING], restMs[REST_RING], restHead, restFill ' the rest instant's ring

    LONG    winEnc0, winCt0, winMs0, winPos0, winLag0, winCap0, winFold0, winResync0     ' a window's start
    LONG    winN, winDutySum, winDutyMin, winDutyMax, winAbsErrSum, winErrPeak, winSenseSum
    LONG    winEncSpan, winPosSpan, winDct, winMs, winLagD, winCapD, winFoldD, winResyncD, winCpsX10, winDcMa

VAR { phase 2a: L-ladder }

    LONG    ladRungs                                        ' rungs this row runs (LADDER_MAX_RUNGS at most)
    LONG    ladRungIncr[LADDER_MAX_RUNGS]                   ' each rung's increment, magnitude
    LONG    ladRungPct[LADDER_MAX_RUNGS]                    ' its % of the ceiling (0: an extension rung)
    LONG    rgOutcome[LADDER_SLOTS], rgIncr[LADDER_SLOTS], rgArrMs[LADDER_SLOTS], rgWinMs[LADDER_SLOTS]
    LONG    rgEnc[LADDER_SLOTS], rgCpsX10[LADDER_SLOTS], rgCmdCpsX10[LADDER_SLOTS], rgFolPm[LADDER_SLOTS], rgWchk[LADDER_SLOTS]
    LONG    rgDuty[LADDER_SLOTS], rgDutyLo[LADDER_SLOTS], rgDutyHi[LADDER_SLOTS], rgErrX10[LADDER_SLOTS], rgErrPk[LADDER_SLOTS]
    LONG    rgHeld[LADDER_SLOTS], rgCapped[LADDER_SLOTS], rgFolds[LADDER_SLOTS], rgResyncs[LADDER_SLOTS], rgDrvIncr[LADDER_SLOTS]
    LONG    rgDcMa[LADDER_SLOTS], rgN[LADDER_SLOTS], bRgClean[LADDER_SLOTS]
    LONG    fitOk[SIGN_COUNT], fitA[SIGN_COUNT], fitB[SIGN_COUNT], fitRms[SIGN_COUNT], fitPts[SIGN_COUNT]     ' fitA/B/Rms are floats
    LONG    fitLoCps[SIGN_COUNT], fitHiCps[SIGN_COUNT], fitResIncr[SIGN_COUNT], bFitResExtrap[SIGN_COUNT], fitVpredMv[SIGN_COUNT]
    LONG    fitRatioPpm[SIGN_COUNT]                         ' phase 2b: the predicted supply / TOLD_MV - 1, ppm (arbiter decision D5)

VAR { phase 2a: L-mininc }

    LONG    miOutcome[MININC_SLOTS], miIncr[MININC_SLOTS], miTpsX100[MININC_SLOTS], miWinMs[MININC_SLOTS]
    LONG    miTravel[MININC_SLOTS], miExpect[MININC_SLOTS], miSubWorstPm[MININC_SLOTS], miDuty[MININC_SLOTS]
    LONG    miHeld[MININC_SLOTS], bMiSteady[MININC_SLOTS], miProtect[MININC_SLOTS]
    LONG    miSubTravel[MININC_SUBWINS], miSubExpect[MININC_SUBWINS]   ' the rung under way's sub-windows

VAR { phase 2a: the cells' accumulators }

    LONG    sfMinTps[SIGN_COUNT], bSfMinMeas[SIGN_COUNT]
    LONG    sfFolWorst[SIGN_COUNT], sfFolN[SIGN_COUNT]
    LONG    sfMisPm[SIGN_COUNT], bSfMisMeas[SIGN_COUNT]
    LONG    sfSmooth[SMOOTH_COUNT], sfSmoothN[SMOOTH_COUNT]
    LONG    sfArrPm[SIGN_COUNT * CHG_COUNT], sfArrN[SIGN_COUNT * CHG_COUNT]
    LONG    sfRotDev[SIGN_COUNT * KIND_COUNT], sfRotN[SIGN_COUNT * KIND_COUNT]
    LONG    sfTimeDev[SIGN_COUNT * KIND_COUNT], sfTimeN[SIGN_COUNT * KIND_COUNT]

VAR { phase 2b: the hall zero at speed (the sampler takes every captured edge into it while bSmpZ), the front cog }

    LONG    bSmpZ                                           ' T/F where T means sampleNext() takes the captured edges into the zero
    LONG    zFirstS                                         ' the first edge's zero estimate, counts (0..359)
    LONG    zSumS                                           ' every later estimate's offset from it, unwrapped, summed
    LONG    zCntS, zBadS, zTicksS                           ' edges taken, skipped or illegal ones, signed ticks
    LONG    zLostS                                          ' edges the ring overwrote inside the windows (L-offscan)
    LONG    frontLatePrev, frontPassesPrev                  ' testGetFrontStats() at the previous B1-FRONT

VAR { phase 2b: the cells' accumulators }

    LONG    sfCoastMs[SIGN_COUNT], bSfCoastMeas[SIGN_COUNT]
    LONG    sfLeadSpread[SIGN_COUNT], sfLeadN[SIGN_COUNT]
    LONG    sfPassPpm[SIGN_COUNT], bSfPassMeas[SIGN_COUNT]

VAR { task 3686: the public start path, L-wiring's walk, R23-SGL-TOPSPD }

    LONG    bQsTried                                        ' T/F where T means start() was called (the board read as expected)
    LONG    qsCog                                           ' start()'s result: the driver's cog, or -1 (refused)
    LONG    bQsReady                                        ' T/F where T means the started motor reported ready in READY_TIMEOUT_MS
    LONG    bQsWalkRan                                      ' T/F where T means checkWiring() was called on the started motor
    LONG    qsWalkErr                                       ' checkWiring()'s result
    LONG    qsWalkChecked, qsWalkFailed, qsWalkRecovered    ' getHealth() after the walk: HLT_* bits
    LONG    qsFwdTicks, qsRevTicks                          ' testGetWalk(): each leg's raw hall ticks
    LONG    qsEncNet, qsEncHi, qsEncLo                      ' the encoder: its travel over the walk, its captured edges' extremes, counts
    LONG    qsEdges, qsLost                                 ' the captured edges taken over the walk, and the ring's lost ones
    LONG    sfTopDev[SMOOTH_COUNT], sfTopN[SMOOTH_COUNT]    ' R23-SGL-TOPSPD: the worst |following - 1|, per mille, and the runs

#ifdef SINGLE_PART_POWER
VAR { task 3686: L-power -- each rung's readings (slot = power sign x POWER_RUNG_COUNT + rung) and the cell's accumulators }

    LONG    pwPower[POWER_SLOTS], pwIncr[POWER_SLOTS], pwOutcome[POWER_SLOTS], pwArrMs[POWER_SLOTS], pwWinMs[POWER_SLOTS]
    LONG    pwCpsX10[POWER_SLOTS], pwCmdX10[POWER_SLOTS], pwFolPm[POWER_SLOTS], pwWchk[POWER_SLOTS], pwDuty[POWER_SLOTS]
    LONG    pwHeld[POWER_SLOTS], pwCapped[POWER_SLOTS], pwFolds[POWER_SLOTS], pwResyncs[POWER_SLOTS], pwDcMa[POWER_SLOTS]
    LONG    sfPowDev[POWER_SIGNS], sfPowN[POWER_SIGNS]
#endif

#ifdef SINGLE_PART_COAST
VAR { phase 2b: L-coast -- the coast under way, one reading every COAST_SAMPLE_US }

    LONG    coastEnc[COAST_MAX_SAMPLES]                     ' the encoder count at each reading
    LONG    coastDct[COAST_MAX_SAMPLES]                     ' its getct() less the one taken before testForceFault(), clocks
    LONG    coastN                                          ' readings taken (past COAST_MAX_SAMPLES they are not stored)
#endif

#ifdef SINGLE_PART_OFFSCAN
VAR { phase 2b: L-offscan -- the shipped pair, the speed under way's points, and each speed's fit }

    LONG    ofsShipFwd, ofsShipRev                          ' the shipped pair, degrees, read before the leg drives
    LONG    opOutcome[OFS_POINTS], opD[OFS_POINTS], opDeg[OFS_POINTS], opWinMs[OFS_POINTS], opCpsX10[OFS_POINTS]
    LONG    opFolPm[OFS_POINTS], opDuty[OFS_POINTS], opDutyLo[OFS_POINTS], opDutyHi[OFS_POINTS], opErrX10[OFS_POINTS]
    LONG    opErrPk[OFS_POINTS], opHeld[OFS_POINTS], opCapped[OFS_POINTS], opFolds[OFS_POINTS], opResyncs[OFS_POINTS]
    LONG    opDcMa[OFS_POINTS], opN[OFS_POINTS], opWchk[OFS_POINTS], bOpClean[OFS_POINTS]
    LONG    ofVertX10[OFS_SPEED_SLOTS], bOfRes[OFS_SPEED_SLOTS]     ' the DC-link fit's vertex (degrees x10 from shipped)
    LONG    ofDuVertX10[OFS_SPEED_SLOTS], bOfDuRes[OFS_SPEED_SLOTS] ' phase 2c: the duty fit's (arbiter decision D9's primary)
    LONG    ofZx10[OFS_SPEED_SLOTS], ofZCnt[OFS_SPEED_SLOTS], ofZTicks[OFS_SPEED_SLOTS]   ' the hall zero at the speed
#endif

#ifdef SINGLE_ATTENDED
VAR { phase 2c: the panel (cog 0), the measure cog's mailbox, and what each attended step measured }

    LONG    sgMouse[SG_MOUSE_LONGS]                         ' PC_MOUSE's seven longs (sgReadInput())
    LONG    sgPrevLbtn                                      ' the left button at the last read: a press is its 0 -> -1 edge
    LONG    sgIgnoreUntilMs                                 ' a press before this getms() belongs to the last screen
    LONG    sgInputs[SG_INPUT_MAX * SG_INPUT_LONGS]         ' the presses on the screen up, logged after it (B1-UI)
    LONG    sgInputN                                        ' presses on the screen up (more than SG_INPUT_MAX are counted)
    LONG    sgLegToken                                      ' the leg the panel runs, its token (B1-SCREEN, B1-UI)
    LONG    bSgNoSteps                                      ' T/F where T means the leg had no steps at the told row

    LONG    wkCog                                           ' the measure cog's id + 1 (0: not running)
    LONG    wkJobSeq, wkTakenSeq, wkDoneSeq                 ' the mailbox: cog 0 posts, the measure cog answers (T0-24's)
    LONG    wkStep, wkRun                                   ' the job: an SG_STEP_* and its run, 1-based
    LONG    wkPhase, wkStatus, wkRead1, wkRead2             ' published live: the phase, the SEEN NOW phrase, the two readings
    LONG    bWkStopReq, bWkDoneReq                          ' cog 0's requests: STOP MOTOR, DONE (written only by cog 0)
    LONG    wkWhy, wkRes1, wkRes2                           ' the step's RESULT phrase and readings (-1: none)
    LONG    wkStack[WK_STACK_LONGS]

    ' L-handload, per step (HL_*), its last run: what the measure cog read, printed by cog 0 after the step
    LONG    hlEnd[HL_COUNT], hlRun[HL_COUNT], hlLimA[HL_COUNT], hlPeakRead[HL_COUNT], hlContRead[HL_COUNT], hlLimErr[HL_COUNT]
    LONG    hlCmdIncr[HL_COUNT], hlArrMs[HL_COUNT], hlContactMs[HL_COUNT], hlContactEnc[HL_COUNT], hlLastTickMs[HL_COUNT]
    LONG    hlLatchMs[HL_COUNT], hlLatchFromTick[HL_COUNT], hlLatchFromContact[HL_COUNT], hlStandMs[HL_COUNT]
    LONG    bHlLatchByEvent[HL_COUNT], hlProt[HL_COUNT], hlStopReason[HL_COUNT]
    LONG    hlDcPeak[HL_COUNT], hlDcMean[HL_COUNT], hlDutyPeak[HL_COUNT], hlDutyMean[HL_COUNT], hlErrPeak[HL_COUNT]
    LONG    hlFolds[HL_COUNT], hlIlim[HL_COUNT], hlHeld[HL_COUNT], hlCapped[HL_COUNT], hlResyncs[HL_COUNT], hlFaults[HL_COUNT]
    LONG    hlStallMas[HL_COUNT], hlCreep[HL_COUNT], hlStandSpan[HL_COUNT], hlRestEnc[HL_COUNT]
    LONG    bHlContact[HL_COUNT], bHlLatched[HL_COUNT], bHlStood[HL_COUNT], bHlRestored[HL_COUNT]

    ' L-heldpush, per step (0: HP_ONE, 1: HP_OTHER), its last run
    LONG    hpRun[2], bHpFresh[2], hpOffHs[2], hpStartHs[2], hpStartDisp[2], hpRestEnc[2], hpDutyMin[2], hpCeil[2]
    LONG    hpPreDispMax[2], hpFirstEdgeCnt[2], hpFirstEdgeMs[2], hpRiseSpan[2], hpRiseGain[2], hpRiseMs[2], hpPeakDuty[2]
    LONG    hpCeilMs[2], hpSlipMs[2], hpSlipCnt[2], hpSlipTicks[2], hpSlipDps[2], hpLimitMs[2], hpNetTicks[2], hpEdges[2]
    LONG    hpBad[2], hpLost[2], hpMaxTurn[2], hpDcCeil[2], hpSlipsD[2], hpLimitsD[2], bHpTurned[2], bHpSlipped[2]
    LONG    bHpRestored[2]
    LONG    hpLimitTicks[2]                                 ' task 3686: |net ticks| of the push at the first HS_LIMITED (-1 none)
    ' ... and per measured direction (DIR_*), the last run in that direction: the cells' readings
    LONG    sfRiseMs[DIR_COUNT], bSfRiseMeas[DIR_COUNT], sfSlipTicks[DIR_COUNT], bSfSlipMeas[DIR_COUNT]

    ' L-sag: the last run, and its trace (a ring: SAG_TRACE_MAX readings, one every SAG_TRACE_MS)
    LONG    sgSagEnd, sgSagRun, sgSagIncr, sgSagArrMs, sgSagAtMs, sgSagLossCps, sgSagLossDuty, sgSagHeld, sgSagResyncs
    LONG    sgSagStopReason, sgSagFaultCause, sgSagDuty0, bSgSagFault
    LONG    sagTrMs[SAG_TRACE_MAX], sagTrCps[SAG_TRACE_MAX], sagTrDuty[SAG_TRACE_MAX], sagTrHeld[SAG_TRACE_MAX]
    LONG    sagTrState[SAG_TRACE_MAX], sagTrN
    LONG    sfSagFirst, bSfSagMeas

    ' L-pinch: the last run, and its trace (PINCH_TRACE_MAX means of PINCH_TRACE_MS)
    LONG    pnEnd, pnRun, pnIncr, pnIdleMa, pnIdleDuty, pnPeakMa, pnPeakDuty, pnSeenMs, pnGoneMs, pnLoadedMa, bPnSeen
    LONG    pnTrMs[PINCH_TRACE_MAX], pnTrMa[PINCH_TRACE_MAX], pnTrDuty[PINCH_TRACE_MAX], pnTrErrPk[PINCH_TRACE_MAX], pnTrN
#endif

PUB main()
'' Run every leg this image carries on the Doco bench, then print every declared cell's verdict and end the session.
''

    runStartMs := getms()
    runIdleMs := 0
    eAbortReason := AR_NONE
    abortDetail := 0
    abortMa := ABS_ABORT_MA
    emitBanner()
    emitBuild()
    emitMotor()
#ifdef SINGLE_ATTENDED
    sgSetupPanel()                                          ' the attended legs' window: STARTING, before anything starts
#endif
    if BUILT_FOR_DOCO == FALSE
        setAbort(AR_NOT_DOCO, 0)                            ' -D BENCH_CFG -D BENCH_DOCO is how this harness is built
    elseif PART_ANY_BUILT == FALSE
        setAbort(AR_NO_PART, 0)                             ' no -D SINGLE_PART_*: nothing to run
    else
        emitSignoffDecls()
        runSession()
    emitSignoffs()
    emitEnd()
#ifdef SINGLE_ATTENDED
    sgFinalScreen()                                         ' the motor is stopped: ALL STEPS DONE or RUN STOPPED, until FINISH
#endif
    debug("DEBUG_END_SESSION")

PRI runSession() | bGoOn
' The Doco session: read the board, start the motor under its test limit, start the encoder, read the rest zero, run every
' leg compiled in; then stop the motor and the encoder, whatever happened.

' Local Variables:
' @local bGoOn - T/F where T means every step so far succeeded

    bGoOn := bFindRow()
    if bGoOn
        bGoOn := bBoardIsExpected()
    if bGoOn
        bGoOn := bStartMotor()
    if bGoOn
        bGoOn := bStartEncoder()
#ifdef SINGLE_PART_WIRING
    if bGoOn
        bGoOn := bRunWiring()                               ' task 3686: before the rest zero, so no harness check excludes it
        emitFront(@sLegWiring)
#endif
    if bGoOn
        bGoOn := bMeasureZero()
    if bGoOn
        bGoOn := bPrepareDrive()
    if bGoOn
        emitFront(@sLegStart)                               ' the front cog's statistics before any leg drives
#ifdef SINGLE_PART_HALLMAP
    if bGoOn
        bGoOn := bRunHallMap()
        emitFront(@sLegHallmap)                             ' after every leg, at rest (or stopped)
#endif
#ifdef SINGLE_PART_MININC
    if bGoOn
        bGoOn := bRunMinInc()
        emitFront(@sLegMininc)
#endif
#ifdef SINGLE_PART_POWER
    if bGoOn
        bGoOn := bRunPowerLeg()
        emitFront(@sLegPower)
#endif
#ifdef SINGLE_PART_LADDER
    if bGoOn
        bGoOn := bRunLadder()
        emitFront(@sLegLadder)
#endif
#ifdef SINGLE_PART_RAMP
    if bGoOn
        bGoOn := bRunRampLeg()
        emitFront(@sLegRamp)
#endif
#ifdef SINGLE_PART_STOPS
    if bGoOn
        bGoOn := bRunStopsLeg()
        emitFront(@sLegStops)
#endif
#ifdef SINGLE_PART_COAST
    if bGoOn
        bGoOn := bRunCoastLeg()
        emitFront(@sLegCoast)
#endif
#ifdef SINGLE_PART_OFFSCAN
    if bGoOn
        bGoOn := bRunOffScan()
        emitFront(@sLegOffscan)
#endif
#ifdef SINGLE_PART_PASSPROBE
    if bGoOn
        bGoOn := bRunPassProbe()
        emitFront(@sLegPassprb)
#endif
#ifdef SINGLE_PART_HANDLOAD
    if bGoOn
        bGoOn := bRunHandLoad()
        emitFront(@sLegHandload)
#endif
#ifdef SINGLE_PART_HELDPUSH
    if bGoOn
        bGoOn := bRunHeldPush()
        emitFront(@sLegHeldpush)
#endif
#ifdef SINGLE_PART_SAG
    if bGoOn
        bGoOn := bRunSag()
        emitFront(@sLegSag)
#endif
#ifdef SINGLE_PART_PINCH
    if bGoOn
        bGoOn := bRunPinch()
        emitFront(@sLegPinch)
#endif
    shutdown()

PRI bFindRow() : bFound | idx, nLadderA
' Find the told voltage's row in DAT rowMv, and derive the row's top: its shipped ceiling, capped at PK1_CAP_INCR from
' PK1_CAP_FROM_MV up, and the power that commands no more than that top (topPowerFor()). Emits B1-ROW. Nothing is started.
'
' @returns bFound - T/F where T means the told voltage has a row

' Local Variables:
' @local idx - a row
' @local nLadderA - the row's ladder test limit, A (0 with no row)

    rowIdx := -1
    repeat idx from 0 to ROW_COUNT - 1
        if rowMv[idx] == TOLD_MV
            rowIdx := idx
    bFound := (rowIdx >= 0)
    rowCeil := 0
    rowTop := 0
    rowTopPower := 0
    nLadderA := 0
    if bFound
        rowCeil := rowCeilIncr[rowIdx]
        rowTop := rowCeil
        if (TOLD_MV >= PK1_CAP_FROM_MV) and (rowTop > PK1_CAP_INCR)
            rowTop := PK1_CAP_INCR
        rowTopPower := topPowerFor(rowCeil, rowTop)
        nLadderA := rowLadderA[rowIdx]
    benchLog.begin(@"B1-ROW")
    benchLog.numField(@"told_mv", TOLD_MV, LIM_MID)
    benchLog.naNumField(@"row", rowIdx, LIM_TINY, bFound)
    benchLog.naNumField(@"ceil_incr", rowCeil, LIM_BIG, bFound)
    benchLog.naNumField(@"top_incr", rowTop, LIM_BIG, bFound)
    benchLog.naNumField(@"top_power", rowTopPower, LIM_TINY, bFound)
    benchLog.numField(@"cap_incr", PK1_CAP_INCR, LIM_BIG)
    benchLog.numField(@"cap_from_mv", PK1_CAP_FROM_MV, LIM_MID)
    benchLog.naNumField(@"ladder_a", nLadderA, LIM_TINY, bFound)
    benchLog.numField(@"shipped_min", SHIPPED_MIN_INCR, LIM_BIG)
    if bFound                                               ' phase 2b: whether L-coast and L-offscan drive here, the coast cell's bound
        benchLog.boolField(@"l13", rowL13[rowIdx])
        benchLog.numField(@"coast_lo_ms", coastLoMs[rowIdx], LIM_SMALL)
        benchLog.numField(@"coast_hi_ms", coastHiMs[rowIdx], LIM_SMALL)
    else
        benchLog.textField(@"l13", @sNa)
        benchLog.textField(@"coast_lo_ms", @sNa)
        benchLog.textField(@"coast_hi_ms", @sNa)
    lineEmit()
    if bFound == FALSE
        setAbort(AR_ROW, TOLD_MV)

PRI topPowerFor(nCeil, nTop) : nPower
' The largest power whose increment stays at or under {nTop}, by the library's own mapping of power to increment
' (incrementForPower(): the row's minimum at power 1 to the ceiling at 100, linearly). It is computed from the reverse
' sign's minimum, SHIPPED_MIN_INCR, the larger of the two (the forward one is 1), so it holds for both signs; every
' power-commanded drive also reads back what the library wrote (bCheckTop()). 100 when the top is the ceiling.
'
' @param nCeil - the row's ceiling, increment
' @param nTop - the row's top, increment, at most nCeil
' @returns nPower - 1..100

    nPower := 100
    if nTop < nCeil
        nPower := 1 + muldiv64(nTop - SHIPPED_MIN_INCR, 99, nCeil - SHIPPED_MIN_INCR)

PRI bPrepareDrive() : bReady | eSpdErr
' Read the drive's constants and the built-in ramp's limits the 2a legs predict from, and allow power 100
' (setMaxSpeed(100): the library's default holds every power to 75). Emits B1-DRIVE. Nothing moves.
'
' @returns bReady - T/F where T means setMaxSpeed() took 100

' Local Variables:
' @local eSpdErr - setMaxSpeed()'s result

    eSpdErr := wheel.setMaxSpeed(100)
    _, _, _, dutyMax, _, frameCnt := wheel.testGetDriveConstants()
    rampJerkUp, rampAccelUp, rampJerkDn, rampAccelDn := wheel.testGetRampLimits()
    cpsLawK := muldiv64(ENC_COUNTS_PER_ECYCLE * wheel.PWM_RATE_IN_HZ, PM, 2 * wheel.DRIVE_PASS_FRAMES)
    encPosSign := 0
    winChkWorst := 0
    bReady := (eSpdErr == wheel.NO_ERROR)
    benchLog.begin(@"B1-DRIVE")
    benchLog.numField(@"spd_err", eSpdErr, LIM_SMALL)
    benchLog.numField(@"duty_max", dutyMax, LIM_MID)
    benchLog.numField(@"frame_cnt", frameCnt, LIM_MID)
    benchLog.numField(@"jerk_up", rampJerkUp, LIM_MID)
    benchLog.numField(@"accel_up", rampAccelUp, LIM_MID)
    benchLog.numField(@"jerk_dn", rampJerkDn, LIM_MID)
    benchLog.numField(@"accel_dn", rampAccelDn, LIM_MID)
    benchLog.numField(@"cps_law_k", cpsLawK, LIM_BIG)
    benchLog.numField(@"pass_frames", wheel.DRIVE_PASS_FRAMES, LIM_TINY)
    lineEmit()
    if bReady == FALSE
        setAbort(AR_LIMITS, eSpdErr)

PRI bBoardIsExpected() : bExpected | eSetupErr
' Read the board at the motor's pin group BEFORE anything is started (testSetup() claims the group without starting a
' cog; getBoardType() then measures), release it, and compare with the bench's EXPECTED_BOARD.
'
' @returns bExpected - T/F where T means the board read is the expected one

' Local Variables:
' @local eSetupErr - testSetup()'s result

    eBoardPre := wheel.REV_Unknown
    eSetupErr := wheel.testSetup(MOTOR_BASE, user.DRIVE_VOLTAGE, MOTOR_DET_MODE)
    if eSetupErr == wheel.NO_ERROR
        eBoardPre := wheel.getBoardType()
    benchLog.cogEventBegin()                                ' (PL-41, as every stop: the style gate's T41)
    wheel.stop()                                            ' releases the claim testSetup() took; no cog was started
    bExpected := (eBoardPre == expectedRevision())
    benchLog.begin(@"B1-BOARD")
    benchLog.numField(@"setup_err", eSetupErr, LIM_SMALL)
    benchLog.tokenField(@"read", revisionToken(eBoardPre), TOKMAX_BOARD)
    benchLog.tokenField(@"expected", revisionToken(expectedRevision()), TOKMAX_BOARD)
    benchLog.boolField(@"match", bExpected)
    lineEmit()
    if bExpected == FALSE
        setAbort(AR_BOARD, eBoardPre)

PRI bStartMotor() : bStarted | motorCog, eStartErr, nChecked, nFailed, nRecovered, eLimErr, nPeakA, nContA, bReady, nWaitStart
' Start the motor (its driver and front cog), wait until it is ready, check it recorded the expected board, and put it
' under the test current limit. Nothing moves.
'
' @returns bStarted - T/F where T means the motor is ready, on the expected board, under the test limit

' Local Variables:
' @local motorCog - start()'s result: the driver's cog id, or -1
' @local eStartErr - getError() after a refused start, else NO_ERROR
' @local nChecked - getHealth(): the checks start() ran
' @local nFailed - getHealth(): the checks that still failed
' @local nRecovered - getHealth(): the checks that passed on a retry
' @local eLimErr - testSetCurrentLimits()'s result
' @local nPeakA - the peak limit read back, A
' @local nContA - the continuous limit read back, A
' @local bReady - T/F where T means isReady() came true within READY_TIMEOUT_MS
' @local nWaitStart - getms() when the ready wait began

    bStarted := FALSE
    eStartErr := wheel.NO_ERROR
    eLimErr := wheel.NO_ERROR
    nPeakA := 0
    nContA := 0
    bReady := FALSE
    wheel.setStartChecks(TRUE)                              ' a failed start check refuses the start
    wheel.holdAtStop(FALSE)                                 ' coast at rest: nothing is held between bursts
    benchLog.cogEventBegin()
    motorCog := wheel.start(MOTOR_BASE, user.DRIVE_VOLTAGE, MOTOR_DET_MODE)
    benchLog.cogEventEnd()
    bQsTried := TRUE                                        ' task 3686: R23-SGL-START's public start path
    qsCog := motorCog
    if motorCog < 0
        eStartErr := wheel.getError()
    nChecked, nFailed, nRecovered := wheel.getHealth()
    eBoardStarted := wheel.getBoardType()                   ' with the driver running: the revision start() recorded
    if motorCog >= 0
        nWaitStart := getms()
        repeat until wheel.isReady() or (getms() - nWaitStart >= READY_TIMEOUT_MS)
            waitms(READY_POLL_MS)
        bReady := wheel.isReady()
        bQsReady := bReady                                  ' task 3686: a start that never reports ready is R23-SGL-START's 0
        if eBoardStarted == expectedRevision()
            senseMvPerA := senseMvPerAmp(eBoardStarted)
            eLimErr := wheel.testSetCurrentLimits(TEST_PEAK_A, TEST_CONT_A)
            nPeakA, nContA, _, _, _ := wheel.testGetCurrentLimitState()
    benchLog.begin(@"B1-START")
    benchLog.numField(@"cog", motorCog, LIM_TINY)
    benchLog.numField(@"err", eStartErr, LIM_SMALL)
    benchLog.hexField(@"checked", nChecked)
    benchLog.hexField(@"failed", nFailed)
    benchLog.hexField(@"recovered", nRecovered)
    benchLog.boolField(@"ready", bReady)
    benchLog.tokenField(@"board", revisionToken(eBoardStarted), TOKMAX_BOARD)
    benchLog.numField(@"mv_per_a", senseMvPerA, LIM_SMALL)
    benchLog.numField(@"lim_err", eLimErr, LIM_SMALL)
    benchLog.numField(@"peak_a", nPeakA, LIM_TINY)
    benchLog.numField(@"cont_a", nContA, LIM_TINY)
    lineEmit()
    if (motorCog < 0) or (bReady == FALSE)
        setAbort(AR_START, eStartErr)
    elseif eBoardStarted <> expectedRevision()
        setAbort(AR_BOARD, eBoardStarted)
    elseif (eLimErr <> wheel.NO_ERROR) or (nPeakA <> TEST_PEAK_A) or (nContA <> TEST_CONT_A)
        setAbort(AR_LIMITS, (eLimErr <> wheel.NO_ERROR) ? eLimErr : nPeakA)
    else
        bStarted := TRUE

PRI bStartEncoder() : bStarted | eEncErr
' Start the shaft encoder's smart pin and its hall-edge capture cog (one cog), inside a cog-event quiet window.
'
' @returns bStarted - T/F where T means the encoder runs

' Local Variables:
' @local eEncErr - enc.start()'s result

    benchLog.cogEventBegin()
    eEncErr := enc.start(ENC_PIN_A, ENC_PIN_B, MOTOR_BASE)
    benchLog.cogEventEnd()
    bStarted := (eEncErr == enc.ENC_OK)
    if bStarted
        enc.emitInit()
    else
        setAbort(AR_ENC_START, eEncErr)

PRI bMeasureZero() : bHealthy | nSample, nSumMv, nMinMv, nMaxMv, nSenseMv, nSpreadMv, nLoMv, nHiMv
' Read the current sense's rest zero with the bridge coasting, ZERO_SAMPLES samples SAMPLE_MS apart. It must be alive
' (its readings differ) and inside the detected board's rest-zero band (the library's own, REST_ZERO_*), or no current
' guard of this run could work.
'
' @returns bHealthy - T/F where T means the zero is alive and in band

' Local Variables:
' @local nSample - the sample being taken
' @local nSumMv - the readings' sum, mV
' @local nMinMv - the lowest reading, mV
' @local nMaxMv - the highest reading, mV
' @local nSenseMv - one reading, mV
' @local nSpreadMv - the highest less the lowest, mV
' @local nLoMv - the board's band, low end, mV
' @local nHiMv - the board's band, high end, mV

    nSumMv := 0
    nMinMv := posx
    nMaxMv := negx
    repeat nSample from 1 to ZERO_SAMPLES
        _, _, nSenseMv, _, _, _, _, _ := wheel.testGetTelemetry()
        nSumMv += nSenseMv
        nMinMv <#= nSenseMv
        nMaxMv #>= nSenseMv
        waitms(SAMPLE_MS)
    zeroMvX10 := divRound(nSumMv * X10, ZERO_SAMPLES)
    nSpreadMv := nMaxMv - nMinMv
    if eBoardStarted == wheel.REV_A
        nLoMv := wheel.REST_ZERO_MIN_MV_REVA
        nHiMv := wheel.REST_ZERO_MAX_MV_REVA
    else
        nLoMv := wheel.REST_ZERO_MIN_MV
        nHiMv := wheel.REST_ZERO_MAX_MV
    bHealthy := (nSpreadMv >= ZERO_SPREAD_MIN_MV) and (zeroMvX10 >= nLoMv * X10) and (zeroMvX10 <= nHiMv * X10)
    benchLog.begin(@"B1-ZERO")
    benchLog.numField(@"zero_mv_x10", zeroMvX10, LIM_MID)
    benchLog.numField(@"spread_mv", nSpreadMv, LIM_SMALL)
    benchLog.numField(@"n", ZERO_SAMPLES, LIM_SMALL)
    benchLog.numField(@"band_lo_mv", nLoMv, LIM_SMALL)
    benchLog.numField(@"band_hi_mv", nHiMv, LIM_SMALL)
    benchLog.boolField(@"healthy", bHealthy)
    lineEmit()
    if bHealthy == FALSE
        setAbort(AR_ZERO, zeroMvX10)

PRI shutdown()
' Stop the motor and the encoder: safe whether or not either started, and on every path.

    benchLog.cogEventBegin()
    wheel.stop()
    enc.stop()

CON { --- task 3686: L-wiring, the public start path and the wiring walk (R23-SGL-START) --- }

#ifdef SINGLE_PART_WIRING
PRI bRunWiring() : bPassed | nEnc0, nLost0, bTaken, nEnc, nOfs
' L-wiring (plan sec 7), on the motor bStartMotor() started through the public path with its checks refusing: call
' checkWiring() -- one electrical cycle out and back at the library's WALK_POWER under the test limit, blocking about
' 1.3 s -- and read its verdict from getHealth()'s HLT_WIRING, never from its return alone (NO_ERROR whatever the
' verdict). Beside it, the encoder: its travel over the walk, and the extremes of the counts the PASM capture latched at
' every hall edge (the two legs' reach). Run before the rest zero is read, so no harness check can exclude it. Emits
' B1-WIRING at rest. A walk that does not pass ends the run (AR_WIRING): a motor whose wiring is not proven is driven
' no further.
'
' @returns bPassed - T/F where T means the start and the walk both passed (R23-SGL-START reads 1)

' Local Variables:
' @local nEnc0 - the encoder's count before the walk
' @local nLost0 - the encoder object's lost edges before it
' @local bTaken - T/F where T means takeEdge() returned an edge
' @local nEnc - its latched count
' @local nOfs - that count less nEnc0

    drainEdges()                                            ' only the walk's edges
    nLost0 := enc.edgesLost()
    nEnc0 := enc.readCount()
    qsEdges := 0
    qsEncHi := 0
    qsEncLo := 0
    qsWalkErr := wheel.checkWiring()                        ' blocks: both legs, each ending at rest
    bQsWalkRan := TRUE
    waitms(STOP_SETTLE_MS)                                  ' the back leg's last edges
    qsEncNet := enc.readCount() - nEnc0
    repeat
        bTaken, nEnc, _, _, _ := enc.takeEdge()
        if bTaken == FALSE
            quit
        nOfs := nEnc - nEnc0
        qsEncHi #>= nOfs
        qsEncLo <#= nOfs
        qsEdges++
    qsLost := enc.edgesLost() - nLost0
    qsWalkChecked, qsWalkFailed, qsWalkRecovered := wheel.getHealth()
    qsFwdTicks, qsRevTicks := wheel.testGetWalk()
    bPassed := (startWireValue() == START_OK)
    benchLog.begin(@"B1-WIRING")
    benchLog.numField(@"walk_err", qsWalkErr, LIM_SMALL)
    benchLog.hexField(@"checked", qsWalkChecked)
    benchLog.hexField(@"failed", qsWalkFailed)
    benchLog.hexField(@"recovered", qsWalkRecovered)
    benchLog.numField(@"fwd_ticks", qsFwdTicks, LIM_SMALL)
    benchLog.numField(@"rev_ticks", qsRevTicks, LIM_SMALL)
    benchLog.numField(@"band_lo", wheel.WALK_TICKS - wheel.WALK_SHORT_TICKS, LIM_TINY)
    benchLog.numField(@"band_hi", wheel.WALK_TICKS + wheel.WALK_OVERSHOOT_TICKS, LIM_TINY)
    benchLog.numField(@"enc_net", qsEncNet, LIM_MID)
    benchLog.numField(@"enc_hi", qsEncHi, LIM_MID)
    benchLog.numField(@"enc_lo", qsEncLo, LIM_MID)
    benchLog.numField(@"edges", qsEdges, LIM_SMALL)
    benchLog.numField(@"lost", qsLost, LIM_SMALL)
    benchLog.boolField(@"pass", bPassed)
    lineEmit()
    if bPassed == FALSE
        coastNow()
        setAbort(AR_WIRING, (qsWalkErr <> wheel.NO_ERROR) ? qsWalkErr : qsWalkFailed)

PRI startWireValue() : nOk
' R23-SGL-START's reading: START_OK when start() returned a cog that reported ready, and the walk ran and passed by
' getHealth() -- HLT_WIRING among the checks run, none of HLT_ALL_CHECKS or HLT_WIRING failed -- with checkWiring()
' returning NO_ERROR; else 0.
'
' @returns nOk - START_OK or 0

    nOk := 0
    if (qsCog >= 0) and bQsReady and bQsWalkRan and (qsWalkErr == wheel.NO_ERROR)
        if ((qsWalkChecked & wheel.HLT_WIRING) <> 0) and ((qsWalkFailed & (wheel.HLT_ALL_CHECKS | wheel.HLT_WIRING)) == 0)
            nOk := START_OK

PRI bStartMeasured() : bMeasured
' R23-SGL-START's precondition: start() was attempted, and it refused, or its motor never reported ready (each a measured
' 0), or the walk ran.
'
' @returns bMeasured - T/F where T means judged

    bMeasured := bQsTried and ((qsCog < 0) or (bQsReady == FALSE) or bQsWalkRan)
#endif

CON { --- the hall-map leg (L-hallmap) --- }

#ifdef SINGLE_PART_HALLMAP
PRI bRunHallMap() : bCompleted | eRung, eSign, setIdx, burstIdx, nIncr, bGoOn
' L-hallmap: at each crawl rung, slow first, drive each increment sign BURSTS_PER_SET bursts of exactly BURST_REVS
' revolutions, self-check every burst, map its edges, then reduce each set to its sector widths and its hall zero.
'
' @returns bCompleted - T/F where T means every set finished

' Local Variables:
' @local eRung - RUNG_SLOW or RUNG_FAST
' @local eSign - SIGN_NEG or SIGN_POS
' @local setIdx - SET_*
' @local burstIdx - the burst within its set, 1-based
' @local nIncr - the driver increment of this set
' @local bGoOn - T/F where T means nothing has stopped the leg

    clearHallMap()
    enc.emitHallEdges(enc.RING_ENTRIES)                     ' anything the start moved, before the first burst
    bGoOn := TRUE
    repeat eRung from RUNG_SLOW to RUNG_FAST
        repeat eSign from SIGN_NEG to SIGN_POS
            setIdx := eRung * SIGN_COUNT + eSign
            nIncr := hallMapIncrement(setIdx)
            emitRung(setIdx, nIncr)
            repeat burstIdx from 1 to BURSTS_PER_SET
                if bGoOn
                    bGoOn := bRunBurst(setIdx, burstIdx, nIncr)
            if bGoOn
                finishSet(setIdx)
        if bGoOn
            emitHyst(eRung)
    if bGoOn
        emitSpeedCompare(SIGN_NEG)
        emitSpeedCompare(SIGN_POS)
    bCompleted := bGoOn

PRI bRunBurst(setIdx, burstIdx, nIncr) : bOk | eOutcome, nStartMs, nLastEdgeMs, nStopSeenMs, nNextCt, nSampleCt, bStopSent, bStopSeen, nRingStart, nLostStart, nPreEdges, nRingEdges, nTimeoutMs, nTicks, nEncSpan, nDev, bPass, eReason
' Drive one burst at {nIncr} until BURST_SPAN_EDGES hall edges have been captured, stop, and settle; take the encoder
' count the PASM capture latched at every edge; guard the current, the charge, the fault, the stall and the time every
' SAMPLE_MS; then, at rest, emit the stored edges (B1-EDGE), run the encoder's self-check over exactly BURST_REVS
' revolutions, and map the edges. NO record is emitted while the motor is driven.
'
' THE CAPTURE IS THE PASM COG'S (phase 2a, arbiter ruling D1): isp_bench_encoder latches the count AT every hall edge
' (<= 48 clocks after it) and takeEdge() hands each latched edge over without printing. Phase 1 polled the hall code
' from here instead; its cross-check (the poll's edge count against the PASM's) is RETIRED with the poll, as there is
' now one observer. B1-BURST keeps ring_edges (the PASM's captures over the burst) and lost (edges the ring overwrote
' before this loop took them, a drain that fell behind): every captured edge is either taken or lost, so the record's
' check is lost 0 -- every edge reached the map. pre counts the edges drained before the command (motion at rest).
'
' @param setIdx - SET_*
' @param burstIdx - the burst within its set, 1-based
' @param nIncr - the driver increment to run at
' @returns bOk - T/F where T means the burst completed and its self-check passed

' Local Variables:
' @local eOutcome - BO_*
' @local nStartMs - getms() when the drive was commanded
' @local nLastEdgeMs - getms() when the latest edge was taken
' @local nStopSeenMs - getms() when the drive first reported stopped after the stop command
' @local nNextCt - getct() of the next guard pass
' @local nSampleCt - SAMPLE_MS in system ticks
' @local bStopSent - T/F where T means the stop has been commanded
' @local bStopSeen - T/F where T means the drive has reported stopped since
' @local nRingStart - the PASM capture's edge count when the burst was commanded
' @local nLostStart - the encoder object's lost-edge count then
' @local nPreEdges - edges drained (and discarded) before the command
' @local nRingEdges - the edges the PASM capture saw during the burst
' @local nTimeoutMs - the burst's bound
' @local nTicks - the signed hall ticks over the self-check span
' @local nEncSpan - the encoder counts over the same span
' @local nDev - |nEncSpan - 60 x nTicks|
' @local bPass - the self-check's verdict
' @local eReason - the self-check's CHK_* reason

    bOk := FALSE
    burstEdges := 0
    overSamples := 0
    bStopSent := FALSE
    bStopSeen := FALSE
    nStopSeenMs := 0
    nTicks := 0
    nEncSpan := 0
    nDev := 0
    bPass := FALSE
    eReason := enc.CHK_TOO_SHORT
    nTimeoutMs := BURST_TIME_FACTOR * BURST_SPAN_EDGES * wheel.MS_PER_SEC / rungTps(setIdx) + BURST_MARGIN_MS
    nPreEdges := drainEdges()                               ' an edge from rest is not this burst's
    nRingStart := enc.edgesCaptured()
    nLostStart := enc.edgesLost()
    eOutcome := BO_RUNNING
    if wheel.testDriveAtMotorIncrement(nIncr) <> wheel.NO_ERROR
        eOutcome := BO_REFUSED
    nStartMs := getms()
    nLastEdgeMs := nStartMs
    nSampleCt := clkfreq / wheel.MS_PER_SEC * SAMPLE_MS
    nNextCt := getct() + nSampleCt
    repeat while eOutcome == BO_RUNNING
        if takeBurstEdges() > 0
            nLastEdgeMs := getms()
            if (burstEdges >= BURST_SPAN_EDGES) and (bStopSent == FALSE)
                bStopSent := TRUE
                if wheel.testDriveAtMotorIncrement(0) <> wheel.NO_ERROR
                    eOutcome := BO_REFUSED
        if (eOutcome == BO_RUNNING) and (getct() - nNextCt >= 0)
            nNextCt += nSampleCt
            eOutcome := sampleGuards()
            if eOutcome == BO_RUNNING
                if bStopSent == FALSE
                    if getms() - nLastEdgeMs > HALLMAP_STALL_MS
                        eOutcome := BO_STALL
                elseif bStopSeen == FALSE
                    if wheel.isStopped()
                        bStopSeen := TRUE
                        nStopSeenMs := getms()
                elseif getms() - nStopSeenMs >= STOP_SETTLE_MS
                    eOutcome := BO_DONE
            if (eOutcome == BO_RUNNING) and (getms() - nStartMs > nTimeoutMs)
                eOutcome := BO_TIMEOUT
    if eOutcome <> BO_DONE
        coastNow()                                          ' coast at once: before any record is emitted
    takeBurstEdges()                                        ' the last of the settle's edges
    nRingEdges := enc.edgesCaptured() - nRingStart
    emitBurstEdges(setIdx, burstIdx)                        ' B1-EDGE: every stored edge, at rest
    if burstEdges >= BURST_SPAN_EDGES
        nTicks := spanTicks()
        nEncSpan := edgeEnc[BURST_SPAN_TICKS] - edgeEnc[0]
        nDev := abs(nEncSpan - ENC_COUNTS_PER_TICK * nTicks)
        bPass, eReason := enc.emitCheck(nEncSpan, nTicks)   ' BE-CHECK, with the CHK_* name
        setEncDevWorst[setIdx] #>= nDev
        setBurstsChecked[setIdx]++
        setTicks[setIdx] += nTicks
    emitBurst(setIdx, burstIdx, nIncr, eOutcome, nPreEdges, nRingEdges, enc.edgesLost() - nLostStart, nStartMs, nTicks, nEncSpan, nDev)
    if eOutcome <> BO_DONE
        setAbort(AR_BURST, eOutcome)
    elseif burstEdges < BURST_SPAN_EDGES
        setAbort(AR_BURST, eOutcome)
    elseif bPass == FALSE
        setAbort(AR_ENC_CHECK, eReason)                     ' a failed self-check stops the run, with its name
    else
        accumulateBurst(setIdx)
        setBurstsMapped[setIdx]++
        bOk := TRUE

PRI takeBurstEdges() : nTaken | bTaken, nEnc, nCode, nPrev, nDtUs
' Take every captured edge waiting in the encoder's ring into the burst: the first BURST_SPAN_EDGES are stored (the count
' the PASM capture latched, the codes either side, the gap); every one is counted in burstEdges.
'
' @returns nTaken - edges taken this call

' Local Variables:
' @local bTaken - T/F where T means takeEdge() returned an edge
' @local nEnc - its latched encoder count
' @local nCode - its hall code after the edge
' @local nPrev - its hall code before
' @local nDtUs - microseconds since the previous captured edge

    nTaken := 0
    repeat
        bTaken, nEnc, nCode, nPrev, nDtUs := enc.takeEdge()
        if bTaken == FALSE
            quit
        if burstEdges < BURST_SPAN_EDGES
            edgeEnc[burstEdges] := nEnc
            edgeCodes[burstEdges] := (nCode & CODE_MASK) | ((nPrev & CODE_MASK) << CODE_PREV_SHIFT)
            edgeDtUs[burstEdges] := nDtUs
        burstEdges++
        nTaken++

PRI emitBurstEdges(setIdx, burstIdx) | edgeIdx
' Emit B1-EDGE for every stored edge of the burst just ended (the raw hall map, as phase 1's BE-HALL was): its index, the
' codes either side, the latched count and the gap. At rest.
'
' @param setIdx - SET_*
' @param burstIdx - the burst within its set, 1-based

' Local Variables:
' @local edgeIdx - a stored edge

    edgeIdx := 0
    repeat while edgeIdx < (burstEdges <# BURST_SPAN_EDGES)   ' (a from..to loop would count down when none was stored)
        benchLog.begin(@"B1-EDGE")
        benchLog.tokenField(@"set", setToken(setIdx), TOKMAX_SET)
        benchLog.numField(@"burst", burstIdx, LIM_TINY)
        benchLog.numField(@"idx", edgeIdx, LIM_TINY)
        benchLog.numField(@"code", edgeCodes[edgeIdx] & CODE_MASK, LIM_TINY)
        benchLog.numField(@"prev", (edgeCodes[edgeIdx] >> CODE_PREV_SHIFT) & CODE_MASK, LIM_TINY)
        benchLog.numField(@"enc", edgeEnc[edgeIdx], LIM_BIG)
        benchLog.numField(@"dt_us", edgeDtUs[edgeIdx], LIM_BIG)
        lineEmit()
        edgeIdx++

PRI sampleGuards() : eOutcome | nSenseMv, bFault
' One guard pass while driven: read the current sense and the fault, and judge every run-scope limit (judgeGuards()).
'
' @returns eOutcome - BO_RUNNING, or the BO_* that ends the burst

' Local Variables:
' @local nSenseMv - the current-sense reading, mV
' @local bFault - T/F where T means the driver has faulted

    _, _, nSenseMv, _, _, _, _, bFault := wheel.testGetTelemetry()
    eOutcome := judgeGuards(nSenseMv, bFault)                ' (judgeGuards() is shared with the 2a legs, below)

PRI spanTicks() : nTicks | edgeIdx, nTick
' The signed hall ticks between the burst's first captured edge and the edge BURST_SPAN_TICKS later: each transition's
' own tick, by the instrument's order table, so a skipped or illegal transition counts none.
'
' @returns nTicks - the signed ticks over the span

' Local Variables:
' @local edgeIdx - the edge whose transition is counted
' @local nTick - its tick: TICK_RISE, TICK_FALL or TICK_BAD

    nTicks := 0
    repeat edgeIdx from 1 to BURST_SPAN_TICKS
        nTick, _ := classifyEdge(edgeCodes[edgeIdx])
        nTicks += nTick

PRI accumulateBurst(setIdx) | edgeIdx, nTick, nBoundary, nPos, nRel, cellIdx, nZ, nOffset
' Map the burst's edges 0 .. BURST_MAP_EDGES - 1 (one per boundary per revolution) into the set: each edge's position
' within the revolution, past the leg's base, into its sector slot; and each edge's estimate of the hall zero.
'
' @param setIdx - SET_*

' Local Variables:
' @local edgeIdx - the edge
' @local nTick - its tick (TICK_BAD: not mapped)
' @local nBoundary - the hall boundary it crossed, 0..5
' @local nPos - its encoder count
' @local nRel - its position past the leg's base, within one revolution, counts
' @local cellIdx - its set's slot accumulator
' @local nZ - its estimate of the hall zero: its electrical angle less its boundary's ideal place, counts 0..359
' @local nOffset - that estimate less the set's first, unwrapped to -180..180

    repeat edgeIdx from 0 to BURST_MAP_EDGES - 1
        nTick, nBoundary := classifyEdge(edgeCodes[edgeIdx])
        if nTick == TICK_BAD
            setBadEdges[setIdx]++
        else
            nPos := edgeEnc[edgeIdx]
            if bLegBaseSet == FALSE
                legBase := nPos - ENC_COUNTS_PER_TICK / 2        ' the leg's first edge sits in the middle of slot 0
                bLegBaseSet := TRUE
            nRel := wrapPositive(nPos - legBase, ENC_COUNTS_PER_REV)
            cellIdx := setIdx * HALL_TICKS_PER_REV + nRel / ENC_COUNTS_PER_TICK
            slotSum[cellIdx] += nRel
            slotCount[cellIdx]++
            if slotKind[cellIdx] == NO_BOUNDARY
                slotKind[cellIdx] := nBoundary
            elseif slotKind[cellIdx] <> nBoundary
                slotMisfit[cellIdx]++
            nZ := wrapPositive(nPos - nBoundary * ENC_COUNTS_PER_BOUNDARY, ENC_COUNTS_PER_ECYCLE)
            if zCount[setIdx] == 0
                zFirst[setIdx] := nZ
            nOffset := nZ - zFirst[setIdx]
            if nOffset > ENC_COUNTS_PER_ECYCLE / 2
                nOffset -= ENC_COUNTS_PER_ECYCLE
            elseif nOffset < -(ENC_COUNTS_PER_ECYCLE / 2)
                nOffset += ENC_COUNTS_PER_ECYCLE
            zSumDev[setIdx] += nOffset
            zCount[setIdx]++

PRI finishSet(setIdx) | slotIdx, cellIdx, nextCell, nExpected, bBroken, nWorstX10, nWorstSlot, nBadSlots, nWidthX10, nDevX10
' Reduce a set: every slot must hold one edge per revolution of one boundary, the boundaries stepping by one around the
' revolution; each sector's width is the next slot's mean less its own; the worst |width - 60| is the set's SECTOR
' reading (SECTOR_BROKEN_X10 when a slot breaks the rule); the hall zero is the mean of every edge's estimate. Emits a
' B1-SLOT per slot and the set's B1-SECT.
'
' @param setIdx - SET_*

' Local Variables:
' @local slotIdx - the slot, 0..23
' @local cellIdx - its accumulator
' @local nextCell - the next slot's accumulator, around the revolution
' @local nExpected - edges a slot must hold: one per revolution mapped
' @local bBroken - T/F where T means some slot broke the rule
' @local nWorstX10 - the worst |width - 60| so far, counts x10
' @local nWorstSlot - the slot it belongs to
' @local nBadSlots - slots that broke the rule
' @local nWidthX10 - one slot's width, counts x10
' @local nDevX10 - |nWidthX10 - 600|

    nExpected := setBurstsMapped[setIdx] * BURST_REVS
    bBroken := FALSE
    nBadSlots := 0
    nWorstX10 := 0
    nWorstSlot := 0
    repeat slotIdx from 0 to HALL_TICKS_PER_REV - 1
        cellIdx := setIdx * HALL_TICKS_PER_REV + slotIdx
        nextCell := setIdx * HALL_TICKS_PER_REV + ((slotIdx + 1) // HALL_TICKS_PER_REV)
        if (slotCount[cellIdx] <> nExpected) or (slotMisfit[cellIdx] <> 0) or (slotKind[cellIdx] == NO_BOUNDARY)
            bBroken := TRUE
            nBadSlots++
        elseif slotKind[nextCell] <> (slotKind[cellIdx] + 1) // HALL_ORDER_LEN
            bBroken := TRUE
            nBadSlots++
    repeat slotIdx from 0 to HALL_TICKS_PER_REV - 1
        cellIdx := setIdx * HALL_TICKS_PER_REV + slotIdx
        nextCell := setIdx * HALL_TICKS_PER_REV + ((slotIdx + 1) // HALL_TICKS_PER_REV)
        nWidthX10 := slotMeanX10(nextCell) - slotMeanX10(cellIdx)
        if slotIdx == HALL_TICKS_PER_REV - 1
            nWidthX10 += ENC_COUNTS_PER_REV * X10           ' the last sector closes the revolution
        setWidthX10[cellIdx] := nWidthX10
        nDevX10 := abs(nWidthX10 - ENC_COUNTS_PER_TICK * X10)
        if nDevX10 > nWorstX10
            nWorstX10 := nDevX10
            nWorstSlot := slotIdx
        emitSlot(setIdx, slotIdx, cellIdx, nWidthX10)
    setSectDevX10[setIdx] := bBroken ? SECTOR_BROKEN_X10 : nWorstX10
    setZx10[setIdx] := wrapPositive(zFirst[setIdx] * X10 + divRound(zSumDev[setIdx] * X10, zCount[setIdx] #> 1), ENC_COUNTS_PER_ECYCLE * X10)
    bSetFinished[setIdx] := TRUE
    benchLog.begin(@"B1-SECT")
    benchLog.tokenField(@"set", setToken(setIdx), TOKMAX_SET)
    benchLog.tokenField(@"dir", directionToken(setTicks[setIdx]), TOKMAX_DIR)
    benchLog.numField(@"revs", nExpected, LIM_TINY)
    benchLog.numField(@"bad_slots", nBadSlots, LIM_TINY)
    benchLog.numField(@"bad_edges", setBadEdges[setIdx], LIM_SMALL)
    benchLog.numField(@"worst_dev_x10", nWorstX10, LIM_SMALL)
    benchLog.numField(@"worst_slot", nWorstSlot, LIM_TINY)
    benchLog.numField(@"sector_dev_x10", setSectDevX10[setIdx], LIM_SMALL)
    benchLog.numField(@"z_x10", setZx10[setIdx], LIM_SMALL)
    benchLog.numField(@"z_edges", zCount[setIdx], LIM_SMALL)
    lineEmit()

PRI slotMeanX10(cellIdx) : nMeanX10
' Return a slot's mean edge position past the leg's base, counts x10 (0 for an empty slot, which finishSet() has already
' counted as broken).
'
' @param cellIdx - the slot's accumulator
' @returns nMeanX10 - the mean position, counts x10

    nMeanX10 := divRound(slotSum[cellIdx] * X10, slotCount[cellIdx] #> 1)

PRI clearHallMap() | cellIdx, setIdx
' Clear every hall-map accumulator before the leg.

' Local Variables:
' @local cellIdx - a slot accumulator
' @local setIdx - a set

    bLegBaseSet := FALSE
    legBase := 0
    repeat cellIdx from 0 to SET_CELLS - 1
        slotSum[cellIdx] := 0
        slotCount[cellIdx] := 0
        slotKind[cellIdx] := NO_BOUNDARY
        slotMisfit[cellIdx] := 0
        setWidthX10[cellIdx] := 0
    repeat setIdx from 0 to SET_COUNT - 1
        zFirst[setIdx] := 0
        zSumDev[setIdx] := 0
        zCount[setIdx] := 0
        setZx10[setIdx] := 0
        setTicks[setIdx] := 0
        setBadEdges[setIdx] := 0
        setEncDevWorst[setIdx] := 0
        setBurstsChecked[setIdx] := 0
        setBurstsMapped[setIdx] := 0
        setSectDevX10[setIdx] := 0
        bSetFinished[setIdx] := FALSE

PRI hallMapIncrement(setIdx) : nIncr
' Return the driver increment of a set: its rung's hall-tick rate through the drive law, ticks/s = increment x 6 ticks per
' electrical cycle x (PWM_RATE_IN_HZ / DRIVE_PASS_FRAMES) passes/s / 2^32 (PL-50, C-1), signed by the set's sign.
' 24 ticks/s is 8_980_386; 96 is 35_921_544.
'
' @param setIdx - SET_*
' @returns nIncr - the signed increment

    nIncr := muldiv64(rungTps(setIdx) * wheel.DRIVE_PASS_FRAMES * 2, $8000_0000, wheel.HALL_TICKS_PER_CYCLE * wheel.PWM_RATE_IN_HZ)
    if (setIdx == SET_NEG_SLOW) or (setIdx == SET_NEG_FAST)
        nIncr := -nIncr

PRI rungTps(setIdx) : nTps
' Return a set's crawl rate, hall ticks per second.
'
' @param setIdx - SET_*
' @returns nTps - HALLMAP_SLOW_TPS or HALLMAP_FAST_TPS

    nTps := HALLMAP_SLOW_TPS
    if (setIdx == SET_NEG_FAST) or (setIdx == SET_POS_FAST)
        nTps := HALLMAP_FAST_TPS

PRI emitRung(setIdx, nIncr)
' Emit B1-HMRUNG: the set about to run, its rate and its increment.
'
' @param setIdx - SET_*
' @param nIncr - the signed increment

    benchLog.begin(@"B1-HMRUNG")
    benchLog.tokenField(@"set", setToken(setIdx), TOKMAX_SET)
    benchLog.numField(@"tps", rungTps(setIdx), LIM_SMALL)
    benchLog.numField(@"incr", nIncr, LIM_BIG)
    benchLog.numField(@"bursts", BURSTS_PER_SET, LIM_TINY)
    benchLog.numField(@"span_ticks", BURST_SPAN_TICKS, LIM_SMALL)
    lineEmit()

PRI emitBurst(setIdx, burstIdx, nIncr, eOutcome, nPreEdges, nRingEdges, nLost, nStartMs, nTicks, nEncSpan, nDev) | bSpan
' Emit B1-BURST: one burst's outcome, the edges it took against the PASM capture's and the ring's losses over it (lost 0:
' every captured edge reached the map), the self-check span and its deviation, and the run's charge and peak so far.
'
' @param setIdx - SET_*
' @param burstIdx - the burst within its set, 1-based
' @param nIncr - the signed increment
' @param eOutcome - BO_*
' @param nPreEdges - edges drained before the command (motion at rest)
' @param nRingEdges - the edges the PASM capture saw during the burst
' @param nLost - edges the ring overwrote before they were taken, during the burst
' @param nStartMs - getms() when the drive was commanded
' @param nTicks - the signed hall ticks over the self-check span
' @param nEncSpan - the encoder counts over it
' @param nDev - |nEncSpan - 60 x nTicks|

' Local Variables:
' @local bSpan - T/F where T means the burst captured a whole self-check span

    bSpan := (burstEdges >= BURST_SPAN_EDGES)
    benchLog.begin(@"B1-BURST")
    benchLog.tokenField(@"set", setToken(setIdx), TOKMAX_SET)
    benchLog.numField(@"burst", burstIdx, LIM_TINY)
    benchLog.numField(@"incr", nIncr, LIM_BIG)
    benchLog.tokenField(@"outcome", outcomeToken(eOutcome), TOKMAX_OUTCOME)
    benchLog.numField(@"pre", nPreEdges, LIM_SMALL)
    benchLog.numField(@"edges", burstEdges, LIM_SMALL)
    benchLog.numField(@"ring_edges", nRingEdges, LIM_SMALL)
    benchLog.numField(@"lost", nLost, LIM_SMALL)
    benchLog.numField(@"ms", getms() - nStartMs, LIM_MID)
    benchLog.naNumField(@"ticks", nTicks, LIM_SMALL, bSpan)
    benchLog.naNumField(@"enc_span", nEncSpan, LIM_MID, bSpan)
    benchLog.naNumField(@"dev", nDev, LIM_MID, bSpan)
    benchLog.numField(@"charge_mas", chargeMaMs / wheel.MS_PER_SEC, LIM_MID)
    benchLog.numField(@"peak_ma", peakMa, LIM_MID)
    lineEmit()

PRI emitSlot(setIdx, slotIdx, cellIdx, nWidthX10)
' Emit B1-SLOT: one sector slot of a set -- its boundary, edges, mean position past the leg's base, and width to the next.
'
' @param setIdx - SET_*
' @param slotIdx - the slot, 0..23
' @param cellIdx - its accumulator
' @param nWidthX10 - its width to the next slot, counts x10

    benchLog.begin(@"B1-SLOT")
    benchLog.tokenField(@"set", setToken(setIdx), TOKMAX_SET)
    benchLog.numField(@"slot", slotIdx, LIM_TINY)
    benchLog.numField(@"boundary", slotKind[cellIdx], LIM_TINY)
    benchLog.numField(@"n", slotCount[cellIdx], LIM_SMALL)
    benchLog.numField(@"misfit", slotMisfit[cellIdx], LIM_SMALL)
    benchLog.numField(@"mean_x10", slotMeanX10(cellIdx), LIM_MID)
    benchLog.numField(@"width_x10", nWidthX10, LIM_MID)
    lineEmit()

PRI emitHyst(eRung) | setNeg, setPos, nRiseX10, nFallX10, nHystX10, bDirsKnown
' Emit B1-HYST for one rung: the hall zero each increment sign measured, which way its halls moved, and -- when the two
' moved opposite ways -- the hysteresis (the rising set's zero less the falling set's) and their mean, the hall pattern's
' zero with the halls' hysteresis cancelled, in the encoder's frame (counts x10 = electrical degrees x10).
'
' @param eRung - RUNG_SLOW or RUNG_FAST

' Local Variables:
' @local setNeg - the rung's negative-increment set
' @local setPos - its positive-increment set
' @local nRiseX10 - the rising set's zero
' @local nFallX10 - the falling set's zero
' @local nHystX10 - nRiseX10 - nFallX10, wrapped to -1_800..1_800
' @local bDirsKnown - T/F where T means one set rose and the other fell

    setNeg := eRung * SIGN_COUNT + SIGN_NEG
    setPos := eRung * SIGN_COUNT + SIGN_POS
    bDirsKnown := ((setTicks[setNeg] > 0) and (setTicks[setPos] < 0)) or ((setTicks[setNeg] < 0) and (setTicks[setPos] > 0))
    nRiseX10 := 0
    nFallX10 := 0
    nHystX10 := 0
    if bDirsKnown
        if setTicks[setPos] > 0
            nRiseX10 := setZx10[setPos]
            nFallX10 := setZx10[setNeg]
        else
            nRiseX10 := setZx10[setNeg]
            nFallX10 := setZx10[setPos]
        nHystX10 := wrapSigned(nRiseX10 - nFallX10, ENC_COUNTS_PER_ECYCLE * X10)
    benchLog.begin(@"B1-HYST")
    benchLog.tokenField(@"rung", rungToken(eRung), TOKMAX_SET)
    benchLog.numField(@"z_neg_x10", setZx10[setNeg], LIM_SMALL)
    benchLog.tokenField(@"neg_dir", directionToken(setTicks[setNeg]), TOKMAX_DIR)
    benchLog.numField(@"z_pos_x10", setZx10[setPos], LIM_SMALL)
    benchLog.tokenField(@"pos_dir", directionToken(setTicks[setPos]), TOKMAX_DIR)
    benchLog.naNumField(@"hyst_x10", nHystX10, LIM_SMALL, bDirsKnown)
    benchLog.naNumField(@"z_mid_x10", wrapPositive(nFallX10 + nHystX10 / 2, ENC_COUNTS_PER_ECYCLE * X10), LIM_SMALL, bDirsKnown)
    lineEmit()

PRI emitSpeedCompare(eSign) | setSlow, setFast, slotIdx, nDiffX10, nWorstX10
' Emit B1-SPDCMP for one increment sign: the hall zero and the sector widths at the two rungs. Geometry is the same at
' both. A width difference is a timing error that differs between sensors (SECTOR's rival explanation); a zero
' difference with equal widths is a timing error common to all three.
'
' @param eSign - SIGN_NEG or SIGN_POS

' Local Variables:
' @local setSlow - the sign's slow set
' @local setFast - its fast set
' @local slotIdx - a slot
' @local nDiffX10 - one slot's |slow width - fast width|, counts x10
' @local nWorstX10 - the largest such difference

    setSlow := RUNG_SLOW * SIGN_COUNT + eSign
    setFast := RUNG_FAST * SIGN_COUNT + eSign
    nWorstX10 := 0
    repeat slotIdx from 0 to HALL_TICKS_PER_REV - 1
        nDiffX10 := abs(setWidthX10[setSlow * HALL_TICKS_PER_REV + slotIdx] - setWidthX10[setFast * HALL_TICKS_PER_REV + slotIdx])
        nWorstX10 #>= nDiffX10
    benchLog.begin(@"B1-SPDCMP")
    benchLog.tokenField(@"sign", (eSign == SIGN_NEG) ? @sSignNeg : @sSignPos, TOKMAX_SIGN)
    benchLog.numField(@"z_slow_x10", setZx10[setSlow], LIM_SMALL)
    benchLog.numField(@"z_fast_x10", setZx10[setFast], LIM_SMALL)
    benchLog.numField(@"z_diff_x10", wrapSigned(setZx10[setFast] - setZx10[setSlow], ENC_COUNTS_PER_ECYCLE * X10), LIM_SMALL)
    benchLog.numField(@"max_wdiff_x10", nWorstX10, LIM_SMALL)
    lineEmit()
#endif

CON { --- phase 2a: the sampler, the measuring window and the drive helpers every 2a leg shares --- }

  ' waitPhase()'s conditions:
  '  UNTIL_ARRIVED   - the drive reads DCS_AT_SPEED with its field's increment at the command
  '  UNTIL_STOPPED   - the drive reads DCS_STOPPED
  '  UNTIL_ELAPSED   - the bound itself: the phase is a fixed time (a settle, a window)
  '  UNTIL_MOVE_DONE - isMoveDone(): a limited drive has ended and the motor rests
    #0, UNTIL_ARRIVED, UNTIL_STOPPED, UNTIL_ELAPSED, UNTIL_MOVE_DONE

    F_SQRT3 = 1.7320508                                     ' line-to-line peak / phase peak
    F_2POW31 = 2147483648.0
    F_2POW32 = 4294967296.0                                 ' phase 2b: one turn of the driver's angle

PRI sampleBegin()
' Start the sampler: its first reading SAMPLE_MS from now, both rings and the field-zero watch emptied, the consecutive
' over-current count cleared.

    smpPeriodCt := clkfreq / wheel.MS_PER_SEC * SAMPLE_MS
    smpNextCt := getct() + smpPeriodCt
    arrHead := 0
    arrFill := 0
    restHead := 0
    restFill := 0
    bSmpMoved := FALSE
    smpZeroMs := 0
    overSamples := 0

PRI sampleNext() : eOutcome
' Wait for the next reading's time (a busy wait on getct(): no waitct() can wrap), then read the encoder, the drive's
' telemetry and its health counters, push both rings, note the first reading whose field increment is 0 after a moving
' one (the field's zero instant), take the captured hall edges into the zero at speed while bSmpZ (takeZEdges(), phase
' 2b), and judge the run's guards (judgeGuards()). A reading more than a period late is taken at once and the cadence
' re-anchored, never replayed.
'
' @returns eOutcome - BO_RUNNING; BO_FAULT (the driver faulted: the leg records it); or the guard's BO_* that ends the run

    repeat until getct() - smpNextCt >= 0
    if getct() - smpNextCt >= smpPeriodCt
        smpNextCt := getct()
    smpNextCt += smpPeriodCt
    smpEnc := enc.readCount()
    smpCt := getct()
    smpMs := getms()
    smpDuty, smpErr, smpSenseMv, _, _, _, smpState, bSmpFault := wheel.testGetTelemetry()
    smpLagHeld, smpDutyCapped, smpDrvIncr, smpPos := wheel.testGetDriveHealth()
    arrEnc[arrHead] := smpEnc
    arrCt[arrHead] := smpCt
    arrHead := (arrHead + 1) // ARR_RING
    arrFill := (arrFill + 1) <# ARR_RING
    restEnc[restHead] := smpEnc
    restMs[restHead] := smpMs
    restHead := (restHead + 1) // REST_RING
    restFill := (restFill + 1) <# REST_RING
    if smpDrvIncr <> 0
        bSmpMoved := TRUE
        smpZeroMs := 0
    elseif bSmpMoved and (smpZeroMs == 0)
        smpZeroMs := smpMs
    if bSmpZ                                                ' phase 2b: L-offscan's windows take every captured edge
        takeZEdges()
    eOutcome := judgeGuards(smpSenseMv, bSmpFault)

PRI judgeGuards(nSenseMv, bFault) : eOutcome | nNetMa
' Integrate the charge and judge every run-scope limit from one reading: the fault, the absolute current, the run's charge
' and its time. The current is the net DC-link reading in mA, through the detected board's scale (netMilliamps()). Shared
' by the hall map's bursts (sampleGuards()) and the 2a legs' sampler (sampleNext()).
'
' Phase 2a orders the run-ending guards BEFORE the fault: a 2a leg reads the (sticky) fault signal as a finding and
' recovers from it, and an over-current, the charge cap or the time cap must still end the run while it does (phase 1
' tested the fault first; in the hall map every outcome but BO_RUNNING ends the run, so only the name a simultaneous
' cause is reported under changes).
'
' Phase 2c: the absolute abort is abortMa (ABS_ABORT_MA, but HAND_DEF_ABORT_MA in the default-limit hand-load step's
' own drive); the STALL charge -- the reading above NO_LOAD_MA_MAX -- is integrated for the step's and the leg's caps
' when they are in force (stepStallCapMas, legStallCapMas: L-handload's only); and the time cap does not count the time a
' screen waited on the operator (runIdleMs).
'
' @param nSenseMv - the current-sense reading, mV
' @param bFault - T/F where T means the driver has faulted
' @returns eOutcome - BO_RUNNING, or the BO_* that ends the burst (in a 2a leg BO_FAULT is a finding, the rest end the
'   run; phase 2c's BO_STEP_CAP ends the step, not the run)

' Local Variables:
' @local nNetMa - the reading net of the rest zero, mA

    eOutcome := BO_RUNNING
    nNetMa := netMilliamps(nSenseMv)
    chargeMaMs += nNetMa * SAMPLE_MS
    peakMa #>= nNetMa
    if nNetMa > NO_LOAD_MA_MAX
        stepStallMaMs += (nNetMa - NO_LOAD_MA_MAX) * SAMPLE_MS
        legStallMaMs += (nNetMa - NO_LOAD_MA_MAX) * SAMPLE_MS
    if nNetMa >= abortMa
        overSamples++
    else
        overSamples := 0
    if overSamples >= ABS_ABORT_SAMPLES
        eOutcome := BO_OVER_CURRENT
    elseif chargeMaMs >= RUN_CHARGE_CAP_MAS * wheel.MS_PER_SEC
        eOutcome := BO_CHARGE_CAP
    elseif (legStallCapMas > 0) and (legStallMaMs >= legStallCapMas * wheel.MS_PER_SEC)
        eOutcome := BO_LEG_CAP
    elseif getms() - runStartMs - runIdleMs >= RUN_TIME_CAP_S * wheel.MS_PER_SEC
        eOutcome := BO_TIME_CAP
    elseif (stepStallCapMas > 0) and (stepStallMaMs >= stepStallCapMas * wheel.MS_PER_SEC)
        eOutcome := BO_STEP_CAP
    elseif bFault
        eOutcome := BO_FAULT

PRI bGuardStops(eOutcome) : bStops
' Whether a sampler outcome ends the run -- anything but BO_RUNNING, BO_FAULT (a fault is a 2a leg's finding) and
' BO_STEP_CAP (phase 2c: it ends a hand-load step, whose own code stops the motor) -- and, when it does, coast the motor
' at once (coastNow(): the driver cog stops) and record why (AR_GUARD).
'
' @param eOutcome - sampleNext()'s outcome
' @returns bStops - T/F where T means the run ends now

    bStops := (eOutcome <> BO_RUNNING) and (eOutcome <> BO_FAULT) and (eOutcome <> BO_STEP_CAP)
    if bStops
        coastNow()
        setAbort(AR_GUARD, eOutcome)

PRI coastNow()
' Coast the motor at once by stopping its driver (wheel.stop(): the bridge floats, the run cannot drive again), opening
' the cog-event quiet window first as every stop does (PL-41; a stop needs no close). Every early end of a run's drive
' comes through here: a guard, a failed encoder check, a fault that will not clear, a stop that never rests, a limit
' not taken, an increment past the row's top, and a hall-map burst that did not complete.

    benchLog.cogEventBegin()
    wheel.stop()

PRI waitPhase(eUntil, nTarget, nBoundMs, bWindow) : eRo, nMs | nStartMs, eOutcome, bHeld
' Take readings until the condition {eUntil} holds, the driver faults, a guard ends the run, or {nBoundMs} passes;
' with {bWindow} each reading is added to the open window (windowAdd()).
'
' @param eUntil - UNTIL_*
' @param nTarget - UNTIL_ARRIVED's increment (the command, signed); unused otherwise
' @param nBoundMs - the phase's bound, ms (UNTIL_ELAPSED: its length)
' @param bWindow - T/F where T means add every reading to the open window
' @returns eRo - RO_DONE (the condition held; UNTIL_ELAPSED: the time passed), RO_TIMEOUT, RO_FAULT or RO_ABORTED
' @returns nMs - ms from the call to that reading

' Local Variables:
' @local nStartMs - getms() at the call
' @local eOutcome - one reading's outcome
' @local bHeld - T/F where T means the condition holds at this reading

    nStartMs := getms()
    eRo := RO_TIMEOUT
    repeat
        eOutcome := sampleNext()
        if bWindow
            windowAdd()
        if eOutcome == BO_FAULT
            eRo := RO_FAULT
            quit
        if bGuardStops(eOutcome)
            eRo := RO_ABORTED
            quit
        case eUntil
            UNTIL_ARRIVED:   bHeld := (smpState == wheel.DCS_AT_SPEED) and (smpDrvIncr == nTarget)
            UNTIL_STOPPED:   bHeld := (smpState == wheel.DCS_STOPPED)
            UNTIL_MOVE_DONE: bHeld := wheel.isMoveDone()
            other:           bHeld := FALSE
        if bHeld
            eRo := RO_DONE
            quit
        if smpMs - nStartMs >= nBoundMs
            if eUntil == UNTIL_ELAPSED
                eRo := RO_DONE
            quit
    nMs := smpMs - nStartMs

PRI windowBegin()
' Open a measuring window at the latest reading: its counts, its counters, and empty sums.

    winEnc0 := smpEnc
    winCt0 := smpCt
    winMs0 := smpMs
    winPos0 := smpPos
    winLag0 := smpLagHeld
    winCap0 := smpDutyCapped
    winFold0 := wheel.getEventTotal(wheel.EV_FOLDBACK)
    _, _, winResync0 := wheel.testGetFaultResponse()
    winN := 0
    winDutySum := 0
    winDutyMin := posx
    winDutyMax := negx
    winAbsErrSum := 0
    winErrPeak := 0
    winSenseSum := 0

PRI windowAdd()
' Add the latest reading to the open window.

    winN++
    winDutySum += smpDuty
    winDutyMin <#= smpDuty
    winDutyMax #>= smpDuty
    winAbsErrSum += abs(smpErr)
    winErrPeak #>= abs(smpErr)
    winSenseSum += smpSenseMv

PRI windowEnd() | nResync
' Close the window at the latest reading: the encoder's and the halls' spans, the counters' deltas (held and capped
' passes, fold-back engages, re-synced faults), the encoder's speed over the window's own getct() span (counts/s x10,
' signed; a window is at most LADDER_WINDOW_MS, under a signed getct() difference at 350 MHz), and the DC link's mean.

' Local Variables:
' @local nResync - the re-synced faults since start, now

    winEncSpan := smpEnc - winEnc0
    winPosSpan := smpPos - winPos0
    winDct := smpCt - winCt0
    winMs := smpMs - winMs0
    winLagD := smpLagHeld - winLag0
    winCapD := smpDutyCapped - winCap0
    winFoldD := wheel.getEventTotal(wheel.EV_FOLDBACK) - winFold0
    _, _, nResync := wheel.testGetFaultResponse()
    winResyncD := nResync - winResync0
    winCpsX10 := 0
    if winDct > 0
        winCpsX10 := signedMulDiv(winEncSpan * X10, clkfreq, winDct)
    winDcMa := meanDcMa(winSenseSum, winN)

PRI bWindowEncOk() : bOk, nDev | nExpect, bSameWay
' The encoder against the driver's hall position over the window just closed: |counts| within WINCHK_TOL_COUNTS of 60 x
' |ticks|, and the encoder turning the way the first judged window set against the halls. Judged only over a revolution
' of ticks or more. A disagreement ends the run (AR_ENC_WIN): a slipping coupling or a lost line corrupts every speed
' after it. (The hall map's self-check is the exact one, at captured edges; this is its running stand-in, two reads apart
' at each end, hence the two ticks.)
'
' @returns bOk - T/F where T means the encoder agrees, or the window was too short to judge
' @returns nDev - ||counts| - 60 x |ticks||, or -1 when not judged

' Local Variables:
' @local nExpect - 60 x |ticks|
' @local bSameWay - T/F where T means the counts and the ticks have one sign

    bOk := TRUE
    nDev := -1
    if abs(winPosSpan) >= HALL_TICKS_PER_REV
        nExpect := ENC_COUNTS_PER_TICK * abs(winPosSpan)
        nDev := abs(abs(winEncSpan) - nExpect)
        winChkWorst #>= nDev
        bSameWay := ((winEncSpan < 0) == (winPosSpan < 0))
        if encPosSign == 0
            encPosSign := bSameWay ? 1 : -1
        if nDev > WINCHK_TOL_COUNTS
            bOk := FALSE
            setAbort(AR_ENC_WIN, nDev)
        elseif bSameWay <> (encPosSign == 1)
            bOk := FALSE
            setAbort(AR_ENC_WIN, -1)
        if bOk == FALSE
            coastNow()

PRI ringSpeedCps() : nCps | iNew, iOld, nDct
' The encoder's speed over the arrival ring (the last ARR_RING readings, 35 ms), counts/s, signed; 0 under two readings.
'
' @returns nCps - counts per second

' Local Variables:
' @local iNew - the newest reading's slot
' @local iOld - the oldest's
' @local nDct - the clocks between them

    nCps := 0
    if arrFill >= 2
        iNew := (arrHead + ARR_RING - 1) // ARR_RING
        iOld := (arrHead + ARR_RING - arrFill) // ARR_RING
        nDct := arrCt[iNew] - arrCt[iOld]
        if nDct > 0
            nCps := signedMulDiv(arrEnc[iNew] - arrEnc[iOld], clkfreq, nDct)

PRI restQuiet() : bGoOn, nFinal, nRestMs, bRingShort | nRef, nQuietMs, nStartMs, eOutcome, idx, nBack
' Take readings until the shaft's count has stayed within REST_JITTER_COUNTS for REST_QUIET_MS (bounded by
' REST_WAIT_MAX_MS): its final count, and its rest INSTANT -- scanning back through the rest ring, the earliest reading
' of the unbroken run already within REST_JITTER_COUNTS of the final count. Guards still apply.
'
' @returns bGoOn - T/F where T means no guard ended the run
' @returns nFinal - the count at rest
' @returns nRestMs - getms() of the rest instant
' @returns bRingShort - T/F where T means the whole ring was already at rest: the instant is at most this early

' Local Variables:
' @local nRef - the count the quiet is measured against
' @local nQuietMs - getms() since which the count stayed near nRef
' @local nStartMs - getms() at the call
' @local eOutcome - one reading's outcome
' @local idx - a rest-ring slot
' @local nBack - readings scanned back

    bGoOn := TRUE
    nStartMs := getms()
    nRef := smpEnc
    nQuietMs := smpMs
    repeat
        eOutcome := sampleNext()
        if bGuardStops(eOutcome)
            bGoOn := FALSE
            quit
        if abs(smpEnc - nRef) > REST_JITTER_COUNTS
            nRef := smpEnc
            nQuietMs := smpMs
        if (smpMs - nQuietMs >= REST_QUIET_MS) or (smpMs - nStartMs >= REST_WAIT_MAX_MS)
            quit
    nFinal := smpEnc
    nRestMs := smpMs
    nBack := 0
    repeat while nBack < restFill
        idx := (restHead + REST_RING - 1 - nBack) // REST_RING
        if abs(restEnc[idx] - nFinal) > REST_JITTER_COUNTS
            quit
        nRestMs := restMs[idx]
        nBack++
    bRingShort := (nBack == restFill)

PRI bFaultRecover() : bGoOn | nWholeMs, nStartMs, eOutcome
' After a fault on a 2a drive: first wait, guarded, until the drive rests -- a re-synced fault (FR_GRADED, the default)
' ramps down on the built-in deceleration, up to 6 s from a Doco top, and a hard one sits DCS_FAULTED -- bounded by
' twice the stop from the field's speed; then testResetFault() (it stops the motor, clears the fault's signal and waits
' at most ~2 s more for rest), and a protective stop it latched is cleared, so the leg may drive again; then
' LEG_REST_MS at rest. A fault that will not clear ends the run.
'
' @returns bGoOn - T/F where T means the motor is at rest and may be driven

' Local Variables:
' @local nWholeMs - the generator's time to stop from the field's speed at the fault
' @local nStartMs - getms() when the wait began
' @local eOutcome - a reading's outcome (BO_FAULT is the fault being recovered: ignored)

    bGoOn := TRUE
    _, nWholeMs := scurveMs(abs(smpDrvIncr) #> 1, rampAccelDn, rampJerkDn, 0)
    nStartMs := getms()
    repeat
        eOutcome := sampleNext()
        if bGuardStops(eOutcome)
            bGoOn := FALSE
            quit
        if (smpState == wheel.DCS_STOPPED) or (smpState == wheel.DCS_FAULTED) or (getms() - nStartMs >= 2 * nWholeMs + ARRIVE_MARGIN_MS)
            quit
    if bGoOn
        bGoOn := (wheel.testResetFault() == wheel.NO_ERROR)
        clearProtect()
        if bGoOn
            waitms(LEG_REST_MS)
        else
            coastNow()
            setAbort(AR_GUARD, BO_FAULT)

PRI clearProtect() : eProt
' Clear a latched protective stop (a drive it refuses would leave the leg unable to drive), returning its cause.
'
' @returns eProt - the cause latched (NO_ERROR when none)

    eProt := wheel.getProtectiveStop()
    if eProt <> wheel.NO_ERROR
        wheel.clearProtectiveStop()

PRI bStopAndRest(bByTestPath) : bGoOn, eProt | eRo, nWholeMs
' Stop the motor -- by the test path (testDriveAtMotorIncrement(0)) for an increment-commanded drive, else stopMotor() --
' both on the built-in ramp down; wait, guarded, until the drive reads DCS_STOPPED; then LEG_REST_MS at rest. A
' protective stop the drive latched (a crawl that stalled: the blocked-shaft stop) has already stopped it: it is cleared
' first (the front cog writes a zero command before releasing) and returned. A fault on the way down is cleared; a stop
' that does not reach rest in its bound, or a guard, ends the run.
'
' @param bByTestPath - T/F where T means stop by testDriveAtMotorIncrement(0)
' @returns bGoOn - T/F where T means the motor rests and may be driven
' @returns eProt - the protective stop that was latched (NO_ERROR when none)

' Local Variables:
' @local eRo - the wait's outcome
' @local nWholeMs - the generator's time to stop from the field's speed now

    bGoOn := TRUE
    eProt := clearProtect()
    if eProt == wheel.NO_ERROR                              ' (one latched has stopped the motor; its clear wrote the zero)
        if bByTestPath
            if wheel.testDriveAtMotorIncrement(0) <> wheel.NO_ERROR
                wheel.stopMotor()                           ' never refuses
        else
            wheel.stopMotor()
    _, nWholeMs := scurveMs(abs(smpDrvIncr) #> 1, rampAccelDn, rampJerkDn, 0)
    eRo, _ := waitPhase(UNTIL_STOPPED, 0, 2 * nWholeMs + ARRIVE_MARGIN_MS, FALSE)
    if eRo == RO_FAULT
        bGoOn := bFaultRecover()
    elseif eRo == RO_ABORTED
        bGoOn := FALSE
    elseif eRo == RO_TIMEOUT
        coastNow()
        setAbort(AR_GUARD, BO_TIMEOUT)
        bGoOn := FALSE
    else
        waitms(LEG_REST_MS)

PRI scurveMs(nChange, nAccel, nJerk, nBandPm) : nBandMs, nWholeMs | nTau, nCorner, nRemain, nWholeP, nBandP
' The jerk-limited generator's time for a change of {nChange} (increment units) at the limit {nAccel} per pass with jerk
' {nJerk} per pass per pass (testGetRampLimits()): the whole change, and the time until the change still to come is
' {nBandPm} per mille of it -- 97 % of the way for a speed-up, 3 % of the start speed left for a stop. DERIVED (the
' generator's S-curve, as test_bench_dual's sCurve(), in passes): when the change is at least A^2 / J the acceleration
' holds its limit, the whole change takes C / A + A / J passes, and its last A^2 / 2J is the final jerk phase, J s^2 / 2
' left s passes before the end; below that it is a triangle, 2 sqrt(C / J) passes, J s^2 / 2 left s passes before the end.
'
' @param nChange - the change, increment units, above 0
' @param nAccel - the acceleration limit, increment units per pass
' @param nJerk - the jerk, increment units per pass per pass
' @param nBandPm - the change left at the reading, per mille
' @returns nBandMs - ms until the change left is {nBandPm} per mille of it
' @returns nWholeMs - ms for the whole change

' Local Variables:
' @local nTau - passes the jerk takes to bring the acceleration to its limit, A / J
' @local nCorner - the change one jerk phase covers, A^2 / 2J
' @local nRemain - the change left at the reading
' @local nWholeP - passes for the whole change
' @local nBandP - passes until the reading

    nJerk #>= 1
    nAccel #>= 1
    nRemain := nChange / PM * nBandPm
    nTau := nAccel / nJerk
    nCorner := nAccel / 2 * nTau
    if nChange >= 2 * nCorner
        nWholeP := nChange / nAccel + nTau
        if nRemain <= nCorner
            nBandP := nWholeP - sqrt(2 * nRemain / nJerk)
        else
            nBandP := nWholeP - nTau - (nRemain - nCorner) / nAccel
    else
        nWholeP := 2 * sqrt(nChange / nJerk)
        if 2 * nRemain <= nChange
            nBandP := nWholeP - sqrt(2 * nRemain / nJerk)
        else
            nBandP := sqrt(2 * (nChange - nRemain) / nJerk)
    nBandMs := passesToMs(nBandP #> 0)
    nWholeMs := passesToMs(nWholeP)

PRI passesToMs(nPasses) : nMs
' Drive passes to ms: DRIVE_PASS_FRAMES PWM frames a pass at PWM_RATE_IN_HZ.
'
' @param nPasses - passes, at least 0
' @returns nMs - ms

    nMs := muldiv64(nPasses, wheel.DRIVE_PASS_FRAMES * wheel.MS_PER_SEC, wheel.PWM_RATE_IN_HZ)

PRI cmdCpsX1000(nIncr) : nCpsX1000
' The drive law in encoder counts: |nIncr| x ENC_COUNTS_PER_ECYCLE counts per electrical cycle x (PWM_RATE_IN_HZ /
' DRIVE_PASS_FRAMES) passes/s / 2^32, x 1000 (cpsLawK holds all but the 2^31).
'
' @param nIncr - a driver increment, either sign
' @returns nCpsX1000 - the field's speed, encoder counts/s x 1000

    nCpsX1000 := muldiv64(abs(nIncr), cpsLawK, $8000_0000)

PRI incrForTpsX100(nTpsX100) : nIncr
' The drive law inverted: the increment for a hall-tick rate (as hallMapIncrement()).
'
' @param nTpsX100 - hall ticks/s x 100
' @returns nIncr - the increment, positive

    nIncr := muldiv64(nTpsX100 * wheel.DRIVE_PASS_FRAMES * 2, $8000_0000, wheel.HALL_TICKS_PER_CYCLE * wheel.PWM_RATE_IN_HZ * X100)

PRI tpsX100ForIncr(nIncr) : nTpsX100
' The drive law: the hall-tick rate of an increment, x 100, rounded.
'
' @param nIncr - a driver increment, either sign
' @returns nTpsX100 - hall ticks/s x 100

    nTpsX100 := divRound(muldiv64(abs(nIncr), wheel.HALL_TICKS_PER_CYCLE * wheel.PWM_RATE_IN_HZ * X100, $8000_0000), 2 * wheel.DRIVE_PASS_FRAMES)

PRI followPm(nCpsX10, nIncr) : nFolPm | nCmdX10
' The encoder's speed as a fraction of the commanded one, per mille (PM is following).
'
' @param nCpsX10 - the encoder's speed, counts/s x 10, either sign
' @param nIncr - the command, either sign
' @returns nFolPm - per mille; 0 when nothing is commanded

' Local Variables:
' @local nCmdX10 - the commanded speed, counts/s x 10

    nFolPm := 0
    nCmdX10 := cmdCpsX1000(nIncr) / X100
    if nCmdX10 > 0
        nFolPm := muldiv64(abs(nCpsX10), PM, nCmdX10)

PRI bSetTestLimit(nAmps) : bSet | eLimErr, nPeakA, nContA
' Put the motor under a test current limit of {nAmps}, peak and continuous, and read it back (at rest). Emits B1-LIMIT. A
' limit not taken ends the run (AR_LIMITS).
'
' @param nAmps - the limit, whole amps
' @returns bSet - T/F where T means the limit reads back as asked

' Local Variables:
' @local eLimErr - testSetCurrentLimits()'s result
' @local nPeakA - the peak limit read back, A
' @local nContA - the continuous limit read back, A

    eLimErr := wheel.testSetCurrentLimits(nAmps, nAmps)
    nPeakA, nContA, _, _, _ := wheel.testGetCurrentLimitState()
    bSet := (eLimErr == wheel.NO_ERROR) and (nPeakA == nAmps) and (nContA == nAmps)
    benchLog.begin(@"B1-LIMIT")
    benchLog.numField(@"amps", nAmps, LIM_TINY)
    benchLog.numField(@"lim_err", eLimErr, LIM_SMALL)
    benchLog.numField(@"peak_a", nPeakA, LIM_TINY)
    benchLog.numField(@"cont_a", nContA, LIM_TINY)
    lineEmit()
    if bSet == FALSE
        coastNow()
        setAbort(AR_LIMITS, (eLimErr <> wheel.NO_ERROR) ? eLimErr : nPeakA)

PRI bCheckTop(nCmd) : bOk
' A power-commanded drive's increment, read back from the library, must not pass the row's top (PK1_CAP_INCR from
' PK1_CAP_FROM_MV up): if it does, the motor coasts at once and the run ends (AR_CAP) -- a harness defect (a stale
' mirror, or topPowerFor()), never a finding.
'
' @param nCmd - the increment the library wrote
' @returns bOk - T/F where T means it is within the row's top

    bOk := (abs(nCmd) <= rowTop)
    if bOk == FALSE
        coastNow()
        setAbort(AR_CAP, nCmd)

PRI meanDcMa(nSumMv, nSamples) : nMa | nMeanX100
' The mean of {nSamples} current-sense readings summing {nSumMv}, net of the rest zero, in mA of DC link through the
' detected board's scale (a long mean resolves what one Rev A reading cannot: the unloaded tops read 0.35-0.8 mV).
'
' @param nSumMv - the readings' sum, mV
' @param nSamples - how many
' @returns nMa - mA; 0 for no readings

' Local Variables:
' @local nMeanX100 - the mean reading, mV x100

    nMa := 0
    if nSamples > 0
        nMeanX100 := divRound(nSumMv * X100, nSamples)
        nMa := divRound((nMeanX100 - zeroMvX10 * X10) * X10, senseMvPerA #> 1)

PRI signedMulDiv(nValue, nMult, nDiv) : nResult
' {nValue} x {nMult} / {nDiv} with a 64-bit product, the sign {nValue}'s ({nMult} and {nDiv} above 0, unsigned).
'
' @param nValue - any value
' @param nMult - the multiplier, above 0
' @param nDiv - the divisor, above 0
' @returns nResult - the signed quotient, truncated toward 0

    nResult := muldiv64(abs(nValue), nMult, nDiv)
    if nValue < 0
        nResult := -nResult

PRI signOfIncr(nIncr) : eSign
' The increment sign's SIGN_*.
'
' @param nIncr - an increment
' @returns eSign - SIGN_NEG for a negative increment, else SIGN_POS

    eSign := (nIncr < 0) ? SIGN_NEG : SIGN_POS

PRI noteSmooth(eInst, bBad)
' Count one run into R23-SGL-SMOOTH's instance {eInst}: a run that faulted or re-synced is bad.
'
' @param eInst - SIGN_NEG, SIGN_POS or SMOOTH_REVERSAL
' @param bBad - T/F where T means the run faulted or re-synced

    sfSmoothN[eInst]++
    if bBad
        sfSmooth[eInst]++

PRI noteTopSpd(eInst, nDev)
' Count one run into R23-SGL-TOPSPD's instance {eInst} (task 3686): its deviation from the speed law, the worst kept.
'
' @param eInst - SIGN_NEG, SIGN_POS or SMOOTH_REVERSAL
' @param nDev - |following - 1|, per mille; PM for a run that faulted or whose window never ran

    sfTopN[eInst]++
    sfTopDev[eInst] #>= nDev

CON { --- phase 2b: the helpers the 2b legs share --- }

PRI drainEdges() : nDrained | bTaken
' Take and discard every captured edge waiting in the encoder's ring (the hall map before a burst; phase 2b, L-offscan
' before a window, so the zero at speed sees only the window's edges).
'
' @returns nDrained - edges discarded

' Local Variables:
' @local bTaken - T/F where T means takeEdge() returned an edge

    nDrained := 0
    repeat
        bTaken, _, _, _, _ := enc.takeEdge()
        if bTaken == FALSE
            quit
        nDrained++

PRI zBegin()
' Empty the hall zero at speed: the next edges taken (takeZEdges()) start it.

    zFirstS := 0
    zSumS := 0
    zCntS := 0
    zBadS := 0
    zTicksS := 0
    zLostS := 0

PRI takeZEdges() | bTaken, nEnc, nCode, nPrev, nTick, nBoundary, nZ
' Take every captured edge waiting in the encoder's ring into the hall zero at speed: each legal transition's estimate
' of the hall pattern's zero in the encoder's frame -- its latched count less its boundary's ideal place, within the
' electrical cycle -- as L-hallmap's accumulateBurst() takes it, unwrapped against the first; an illegal or skipped
' transition is counted and not used. Called by sampleNext() while bSmpZ.

' Local Variables:
' @local bTaken - T/F where T means takeEdge() returned an edge
' @local nEnc - its latched encoder count
' @local nCode - its hall code after the edge
' @local nPrev - its hall code before
' @local nTick - its tick: TICK_RISE, TICK_FALL or TICK_BAD
' @local nBoundary - the boundary it crossed, 0..5
' @local nZ - its estimate of the zero, counts 0..359

    repeat
        bTaken, nEnc, nCode, nPrev, _ := enc.takeEdge()
        if bTaken == FALSE
            quit
        nTick, nBoundary := classifyEdge((nCode & CODE_MASK) | ((nPrev & CODE_MASK) << CODE_PREV_SHIFT))
        if nTick == TICK_BAD
            zBadS++
        else
            zTicksS += nTick
            nZ := wrapPositive(nEnc - nBoundary * ENC_COUNTS_PER_BOUNDARY, ENC_COUNTS_PER_ECYCLE)
            if zCntS == 0
                zFirstS := nZ
            zSumS += wrapSigned(nZ - zFirstS, ENC_COUNTS_PER_ECYCLE)
            zCntS++

PRI zNowX10() : nZx10
' The hall zero at speed so far, counts x10 = electrical degrees x10 on this motor (0..3_599); 0 with no edge.
'
' @returns nZx10 - the mean estimate, wrapped into one electrical cycle

    nZx10 := wrapPositive(zFirstS * X10 + divRound(zSumS * X10, zCntS #> 1), ENC_COUNTS_PER_ECYCLE * X10)

PRI clampedRound(fValue, nLimit) : nValue
' A float rounded to the nearest integer, held to +-{nLimit} (a record field's width; round() of a float past 2^31 is
' not defined).
'
' @param fValue - the float
' @param nLimit - the bound, above 0
' @returns nValue - round(fValue), within -nLimit .. nLimit

    if fValue >. float(nLimit)
        nValue := nLimit
    elseif fValue <. float(-nLimit)
        nValue := -nLimit
    else
        nValue := round(fValue)

PRI speedIncr(pctIdx, eSign) : nIncr
' A 2b speed's increment: DAT speedPcts % of the row's shipped ceiling, capped at the row's top (as ladderPlan()), signed.
'
' @param pctIdx - 0 .. SPEED_PCT_COUNT - 1
' @param eSign - SIGN_NEG or SIGN_POS
' @returns nIncr - the signed increment

    nIncr := (rowCeil / 100 * speedPcts[pctIdx]) <# rowTop
    if eSign == SIGN_NEG
        nIncr := -nIncr

PRI emitLegSkip(pLeg)
' Emit B1-LEGSKIP: a 2b leg that drives only at a DAT rowL13 row was built into a run at another, and drove nothing.
'
' @param pLeg - the leg's token

    benchLog.begin(@"B1-LEGSKIP")
    benchLog.tokenField(@"leg", pLeg, TOKMAX_LEG)
    benchLog.numField(@"told_mv", TOLD_MV, LIM_MID)
    benchLog.boolField(@"l13", FALSE)
    lineEmit()

PRI emitFront(pLeg) | nPasses, nLate, nMaxTicks, nStackHw
' Emit B1-FRONT after a leg, at rest: the front cog's passes and late passes (each in all and since the previous
' B1-FRONT), its worst pass body in system ticks AND in microseconds at the running clock (x10), and its stack's high
' water against its size (testGetFrontStats()). The worst pass is cumulative from start(): a rise names the leg it came
' in. For one motor, the clock floor's input (plan sec 13).
'
' @param pLeg - the leg just ended (START: before any leg)

' Local Variables:
' @local nPasses - passes since start()
' @local nLate - late passes since start()
' @local nMaxTicks - the longest pass body since start(), system ticks
' @local nStackHw - stack longs ever used

    nPasses, nLate, nMaxTicks, nStackHw := wheel.testGetFrontStats()
    benchLog.begin(@"B1-FRONT")
    benchLog.tokenField(@"leg", pLeg, TOKMAX_LEG)
    benchLog.numField(@"passes", nPasses, LIM_BIG)
    benchLog.numField(@"passes_d", nPasses - frontPassesPrev, LIM_BIG)
    benchLog.numField(@"late", nLate, LIM_MID)
    benchLog.numField(@"late_d", nLate - frontLatePrev, LIM_MID)
    benchLog.numField(@"max_ticks", nMaxTicks, LIM_BIG)
    benchLog.numField(@"max_us_x10", muldiv64(nMaxTicks, US_PER_S * X10, clkfreq), LIM_MID)
    benchLog.numField(@"stack_hw", nStackHw, LIM_SMALL)
    benchLog.numField(@"stack_size", wheel.STACK_SIZE_LONGS, LIM_SMALL)
    benchLog.numField(@"clkfreq", clkfreq, LIM_BIG)
    lineEmit()
    frontPassesPrev := nPasses
    frontLatePrev := nLate

CON { --- L-mininc (PL-71) --- }

#ifdef SINGLE_PART_MININC
PRI bRunMinInc() : bCompleted | eSign, rungIdx, slotIdx, bGoOn, bSteady, bDescend, nMinTps
' L-mininc: each increment sign, NEG then POS, the descending sweep of DAT minincTpsX100 from rest, rung by rung, until
' one does not turn steadily (the rest SKIPPED); the smallest steady rate is the sign's minimum (R23-SGL-MININC). The
' records, at rest, after both signs.
'
' @returns bCompleted - T/F where T means no guard ended the run

' Local Variables:
' @local eSign - SIGN_NEG or SIGN_POS
' @local rungIdx - a rung of the sweep
' @local slotIdx - its record slot
' @local bGoOn - T/F where T means nothing has ended the run
' @local bSteady - T/F where T means the rung turned steadily
' @local bDescend - T/F where T means every rung so far was steady
' @local nMinTps - the sign's smallest steady rate so far

    repeat slotIdx from 0 to MININC_SLOTS - 1
        miOutcome[slotIdx] := RO_NOT_RUN
        bMiSteady[slotIdx] := FALSE
    bGoOn := TRUE
    repeat eSign from SIGN_NEG to SIGN_POS
        bDescend := TRUE
        nMinTps := MININC_NONE_TPS_X100
        repeat rungIdx from 0 to MININC_RUNGS - 1
            slotIdx := eSign * MININC_RUNGS + rungIdx
            if bGoOn and bDescend
                bGoOn, bSteady := bMinIncRung(eSign, rungIdx, slotIdx)
                bDescend := bSteady
                if bSteady
                    nMinTps := miTpsX100[slotIdx]
            elseif bGoOn
                miOutcome[slotIdx] := RO_SKIPPED
        slotIdx := eSign * MININC_RUNGS
        if (miOutcome[slotIdx] == RO_DONE) or (miOutcome[slotIdx] == RO_FAULT)
            bSfMinMeas[eSign] := TRUE                       ' the sweep's first rung was driven
            sfMinTps[eSign] := nMinTps
    repeat slotIdx from 0 to MININC_SLOTS - 1
        if miOutcome[slotIdx] <> RO_NOT_RUN
            emitMinInc(slotIdx)
    bCompleted := bGoOn

PRI bMinIncRung(eSign, rungIdx, slotIdx) : bGoOn, bSteady | nTps, nIncr, nCmdX1000, nWinMs, nResync0
' One rung of the sweep from rest: its increment by the drive law, its window -- MININC_SUBWINS sub-windows, together at
' least MININC_MIN_WIN_MS and one electrical cycle at the rate (MININC_WIN_COUNTS), at most MININC_MAX_WIN_MS; then the
' command, and the measurement (bMinIncMeasure()). A refused command (a protective stop latched: cleared) is not steady.
'
' @param eSign - SIGN_NEG or SIGN_POS
' @param rungIdx - the rung of DAT minincTpsX100
' @param slotIdx - its record slot
' @returns bGoOn - T/F where T means nothing ended the run
' @returns bSteady - T/F where T means the rung turned steadily

' Local Variables:
' @local nTps - the rung's rate, hall ticks/s x 100
' @local nIncr - its increment, signed
' @local nCmdX1000 - the field's speed, counts/s x 1000
' @local nWinMs - the window's planned length
' @local nResync0 - re-synced faults before the rung

    bGoOn := TRUE
    bSteady := FALSE
    nTps := minincTpsX100[rungIdx]
    if nTps == MININC_SHIPPED_RUNG
        nIncr := SHIPPED_MIN_INCR
        nTps := tpsX100ForIncr(nIncr)
    else
        nIncr := incrForTpsX100(nTps)
    if eSign == SIGN_NEG
        nIncr := -nIncr
    miIncr[slotIdx] := nIncr
    miTpsX100[slotIdx] := nTps
    miWinMs[slotIdx] := 0
    miTravel[slotIdx] := 0
    miExpect[slotIdx] := 0
    miSubWorstPm[slotIdx] := 0
    miDuty[slotIdx] := 0
    miHeld[slotIdx] := 0
    miProtect[slotIdx] := wheel.NO_ERROR
    nCmdX1000 := cmdCpsX1000(nIncr)
    nWinMs := (MININC_MIN_WIN_MS #> muldiv64(MININC_WIN_COUNTS, US_PER_S, nCmdX1000 #> 1)) <# MININC_MAX_WIN_MS
    _, _, nResync0 := wheel.testGetFaultResponse()
    sampleBegin()
    if wheel.testDriveAtMotorIncrement(nIncr) == wheel.NO_ERROR
        bGoOn, bSteady := bMinIncMeasure(slotIdx, nCmdX1000, nWinMs / MININC_SUBWINS, nResync0)
    else
        miOutcome[slotIdx] := RO_REFUSED                    ' nothing moved: not steady, the sweep ends here
        miProtect[slotIdx] := clearProtect()
    bMiSteady[slotIdx] := bSteady

PRI bMinIncMeasure(slotIdx, nCmdX1000, nSubMs, nResync0) : bGoOn, bSteady | subIdx, eRo, nLastEnc, nSubStartMs, nSubs, nSubPm, bSubsOk, nExpect, nResync1
' A commanded crawl rung: settle MININC_SETTLE_MS, measure MININC_SUBWINS sub-windows of {nSubMs}, then stop to rest.
' STEADY: the window's travel within MININC_SYNC_TOL_COUNTS of the field's, every sub-window advancing the window's way by
' MININC_SUB_MIN_PCT % of its share, no fault, no re-sync, no protective stop latched.
'
' @param slotIdx - the rung's record slot
' @param nCmdX1000 - the field's speed, counts/s x 1000
' @param nSubMs - one sub-window's planned length, ms
' @param nResync0 - re-synced faults before the command
' @returns bGoOn - T/F where T means nothing ended the run
' @returns bSteady - T/F where T means the rung turned steadily

' Local Variables:
' @local subIdx - a sub-window
' @local eRo - a phase's outcome
' @local nLastEnc - the count at the sub-window's start
' @local nSubStartMs - getms() at its start
' @local nSubs - sub-windows completed
' @local nSubPm - a sub-window's travel as a share of the field's, per mille, negative when it ran against the window
' @local bSubsOk - T/F where T means every sub-window advanced enough
' @local nExpect - the field's travel over the window, counts
' @local nResync1 - re-synced faults after the window

    bGoOn := TRUE
    bSteady := FALSE
    eRo, _ := waitPhase(UNTIL_ELAPSED, 0, MININC_SETTLE_MS, FALSE)
    bSubsOk := TRUE
    nSubs := 0
    if eRo == RO_DONE
        windowBegin()
        nLastEnc := smpEnc
        nSubStartMs := smpMs
        repeat subIdx from 0 to MININC_SUBWINS - 1
            eRo, _ := waitPhase(UNTIL_ELAPSED, 0, nSubMs, TRUE)
            if eRo <> RO_DONE
                quit
            miSubTravel[subIdx] := smpEnc - nLastEnc
            miSubExpect[subIdx] := muldiv64(nCmdX1000, smpMs - nSubStartMs, US_PER_S)
            nLastEnc := smpEnc
            nSubStartMs := smpMs
            nSubs++
        windowEnd()
    if eRo == RO_DONE
        ' each sub-window judged against the WINDOW's way (the encoder's sign for this increment is not assumed)
        miSubWorstPm[slotIdx] := PM
        repeat subIdx from 0 to nSubs - 1
            nSubPm := 0
            if miSubExpect[subIdx] > 0
                nSubPm := muldiv64(abs(miSubTravel[subIdx]), PM, miSubExpect[subIdx])
            if (miSubTravel[subIdx] <> 0) and ((miSubTravel[subIdx] < 0) <> (winEncSpan < 0))
                nSubPm := -nSubPm                           ' it ran against the window
            miSubWorstPm[slotIdx] <#= nSubPm
            if nSubPm * X100 < MININC_SUB_MIN_PCT * PM
                bSubsOk := FALSE
        nExpect := muldiv64(nCmdX1000, winMs, US_PER_S)
        miWinMs[slotIdx] := winMs
        miTravel[slotIdx] := winEncSpan
        miExpect[slotIdx] := nExpect
        miDuty[slotIdx] := divRound(winDutySum, winN #> 1)
        miHeld[slotIdx] := winLagD
        miOutcome[slotIdx] := RO_DONE
        _, _, nResync1 := wheel.testGetFaultResponse()
        bSteady := bSubsOk and (abs(abs(winEncSpan) - nExpect) <= MININC_SYNC_TOL_COUNTS) and (nResync1 == nResync0)
        bGoOn, miProtect[slotIdx] := bStopAndRest(TRUE)     ' a blocked-shaft stop latched on the crawl is returned here
        if miProtect[slotIdx] <> wheel.NO_ERROR
            bSteady := FALSE
    elseif eRo == RO_FAULT
        miOutcome[slotIdx] := RO_FAULT
        bGoOn := bFaultRecover()
    else
        miOutcome[slotIdx] := RO_ABORTED
        bGoOn := FALSE

PRI emitMinInc(slotIdx)
' Emit B1-MININC: one rung of the sweep -- its rate and increment, how it ended, the window, the encoder's travel against
' the field's, the weakest sub-window's share (per mille, negative when it ran backwards), duty, held passes, the
' protective stop it latched (0 none), and the verdict.
'
' @param slotIdx - the rung's record slot

    benchLog.begin(@"B1-MININC")
    benchLog.tokenField(@"sign", (slotIdx < MININC_RUNGS) ? @sSignNeg : @sSignPos, TOKMAX_SIGN)
    benchLog.numField(@"rung", slotIdx // MININC_RUNGS, LIM_TINY)
    benchLog.numField(@"tps_x100", miTpsX100[slotIdx], LIM_SMALL)
    benchLog.numField(@"incr", miIncr[slotIdx], LIM_BIG)
    benchLog.tokenField(@"outcome", roToken(miOutcome[slotIdx]), TOKMAX_RO)
    benchLog.numField(@"win_ms", miWinMs[slotIdx], LIM_SMALL)
    benchLog.numField(@"travel", miTravel[slotIdx], LIM_MID)
    benchLog.numField(@"expect", miExpect[slotIdx], LIM_MID)
    benchLog.numField(@"sub_worst_pm", miSubWorstPm[slotIdx], LIM_SMALL)
    benchLog.numField(@"duty", miDuty[slotIdx], LIM_MID)
    benchLog.numField(@"held", miHeld[slotIdx], LIM_MID)
    benchLog.numField(@"protect", miProtect[slotIdx], LIM_SMALL)
    benchLog.boolField(@"steady", bMiSteady[slotIdx])
    lineEmit()
#endif

CON { --- task 3686: L-power, the power rungs on the public path (R23-SGL-POWER) --- }

#ifdef SINGLE_PART_POWER
PRI bRunPowerLeg() : bCompleted | nPowIdx, rungIdx, slotIdx, bGoOn
' L-power (plan sec 7): under the row's ladder test limit (DAT rowLadderA), each power sign, + then -, every DAT
' powerPcts rung capped at the row's top power, each from rest (bPowerRung()); then the run's test limit back; then, at
' rest, every rung's record and R23-SGL-POWER's readings (powerFinish()).
'
' @returns bCompleted - T/F where T means no guard ended the run

' Local Variables:
' @local nPowIdx - 0: + power, 1: - power
' @local rungIdx - a rung
' @local slotIdx - its record slot
' @local bGoOn - T/F where T means nothing has ended the run

    repeat slotIdx from 0 to POWER_SLOTS - 1
        pwOutcome[slotIdx] := RO_NOT_RUN
        pwPower[slotIdx] := 0
        pwIncr[slotIdx] := 0
        pwArrMs[slotIdx] := -1
        pwWchk[slotIdx] := -1
    bGoOn := bSetTestLimit(rowLadderA[rowIdx])
    repeat nPowIdx from 0 to POWER_SIGNS - 1
        repeat rungIdx from 0 to POWER_RUNG_COUNT - 1
            if bGoOn
                bGoOn := bPowerRung(nPowIdx, rungIdx)
    if bGoOn
        bGoOn := bSetTestLimit(TEST_PEAK_A)
    powerFinish()
    bCompleted := bGoOn

PRI bPowerRung(nPowIdx, rungIdx) : bGoOn | slotIdx, nPower, nCmd, nWholeMs, nResync0, nResync1, eRo, eRo2, nArrMs, bOk, nDev
' One power rung from rest, by driveAtPower() -- the user's path: the increment the library wrote is read back
' (testGetDriveFollow()) and must not pass the row's top (bCheckTop()); then, as a ladder rung, the arrival at it
' (bounded by twice the generator's time plus ARRIVE_MARGIN_MS; one not arrived is measured as far as it got),
' LADDER_SETTLE_MS, the LADDER_WINDOW_MS window, the encoder check, and stopMotor() to rest. A refused command (a
' protective stop latched: cleared) and a fault (recovered) are each recorded, and read PM by the cell.
'
' @param nPowIdx - 0: + power, 1: - power
' @param rungIdx - the rung, 0 .. POWER_RUNG_COUNT - 1
' @returns bGoOn - T/F where T means nothing ended the run

' Local Variables:
' @local slotIdx - the rung's record slot
' @local nPower - the power commanded
' @local nCmd - the increment the library wrote for it
' @local nWholeMs - the generator's time from rest to it
' @local nResync0 - re-synced faults before the command
' @local nResync1 - after the window
' @local eRo - the arrival's outcome
' @local eRo2 - the settle's and the window's
' @local nArrMs - ms to arrive
' @local bOk - the window's encoder check
' @local nDev - its deviation

    bGoOn := TRUE
    slotIdx := nPowIdx * POWER_RUNG_COUNT + rungIdx
    nPower := powerPcts[rungIdx] <# rowTopPower
    if nPowIdx == 1
        nPower := -nPower
    pwPower[slotIdx] := nPower
    _, _, nResync0 := wheel.testGetFaultResponse()
    sampleBegin()
    if wheel.driveAtPower(nPower) <> wheel.NO_ERROR
        pwOutcome[slotIdx] := RO_REFUSED
        clearProtect()
    else
        nCmd, _, _, _, _, _ := wheel.testGetDriveFollow()
        pwIncr[slotIdx] := nCmd
        if bCheckTop(nCmd) == FALSE
            pwOutcome[slotIdx] := RO_ABORTED                ' past the row's top: the run ends, coasting (a harness defect)
            bGoOn := FALSE
        else
            _, nWholeMs := scurveMs(abs(nCmd) #> 1, rampAccelUp, rampJerkUp, 0)
            eRo, nArrMs := waitPhase(UNTIL_ARRIVED, nCmd, 2 * nWholeMs + ARRIVE_MARGIN_MS, FALSE)
            eRo2 := eRo
            if eRo == RO_DONE
                pwArrMs[slotIdx] := nArrMs
            if (eRo == RO_DONE) or (eRo == RO_TIMEOUT)      ' not arrived: measured anyway, following says how far short
                eRo2, _ := waitPhase(UNTIL_ELAPSED, 0, LADDER_SETTLE_MS, FALSE)
                if eRo2 == RO_DONE
                    windowBegin()
                    eRo2, _ := waitPhase(UNTIL_ELAPSED, 0, LADDER_WINDOW_MS, TRUE)
                    windowEnd()
            _, _, nResync1 := wheel.testGetFaultResponse()
            pwResyncs[slotIdx] := nResync1 - nResync0
            if eRo2 == RO_DONE
                pwOutcome[slotIdx] := (eRo == RO_DONE) ? RO_DONE : RO_TIMEOUT
                storePowerRung(slotIdx, nCmd)
                bOk, nDev := bWindowEncOk()
                pwWchk[slotIdx] := nDev
                if bOk
                    bGoOn, _ := bStopAndRest(FALSE)
                else
                    bGoOn := FALSE                          ' the encoder disagreed with the halls: coasted, the run ends
            elseif eRo2 == RO_FAULT
                pwOutcome[slotIdx] := RO_FAULT
                bGoOn := bFaultRecover()
            else
                pwOutcome[slotIdx] := RO_ABORTED
                bGoOn := FALSE

PRI storePowerRung(slotIdx, nCmd)
' Keep the window just closed as the power rung's readings.
'
' @param slotIdx - the rung's record slot
' @param nCmd - the increment the library wrote, signed

    pwWinMs[slotIdx] := winMs
    pwCpsX10[slotIdx] := winCpsX10
    pwCmdX10[slotIdx] := cmdCpsX1000(nCmd) / X100
    pwFolPm[slotIdx] := followPm(winCpsX10, nCmd)
    pwDuty[slotIdx] := divRound(winDutySum, winN #> 1)
    pwHeld[slotIdx] := winLagD
    pwCapped[slotIdx] := winCapD
    pwFolds[slotIdx] := winFoldD
    pwDcMa[slotIdx] := winDcMa

PRI powerFinish() | nPowIdx, rungIdx, slotIdx, nDev
' At rest after L-power: R23-SGL-POWER's reading per power sign -- the worst |following - 1| over its rungs, PM for a
' rung that faulted or was refused -- and every rung's B1-POWER.

' Local Variables:
' @local nPowIdx - a power sign
' @local rungIdx - a rung
' @local slotIdx - its record slot
' @local nDev - the rung's deviation, per mille (-1: not judged)

    repeat nPowIdx from 0 to POWER_SIGNS - 1
        sfPowDev[nPowIdx] := 0
        sfPowN[nPowIdx] := 0
        repeat rungIdx from 0 to POWER_RUNG_COUNT - 1
            slotIdx := nPowIdx * POWER_RUNG_COUNT + rungIdx
            nDev := -1
            case pwOutcome[slotIdx]
                RO_DONE, RO_TIMEOUT:    nDev := abs(pwFolPm[slotIdx] - PM)
                RO_FAULT, RO_REFUSED:   nDev := PM          ' it did not hold its speed
            if nDev >= 0
                sfPowDev[nPowIdx] #>= nDev
                sfPowN[nPowIdx]++
            if pwOutcome[slotIdx] <> RO_NOT_RUN
                emitPowerRung(nPowIdx, slotIdx)

PRI emitPowerRung(nPowIdx, slotIdx)
' Emit B1-POWER for one rung: the power and the increment the library wrote for it (its sign is the increment's), how
' it ended, the encoder's speed against the command's, the window's encoder check, and the drive's readings.
'
' @param nPowIdx - the power sign
' @param slotIdx - the rung's record slot

    benchLog.begin(@"B1-POWER")
    benchLog.tokenField(@"psign", powToken(nPowIdx), TOKMAX_INST)
    benchLog.numField(@"power", pwPower[slotIdx], LIM_TINY)
    benchLog.numField(@"lib_incr", pwIncr[slotIdx], LIM_BIG)
    benchLog.tokenField(@"outcome", roToken(pwOutcome[slotIdx]), TOKMAX_RO)
    benchLog.naNumField(@"arr_ms", pwArrMs[slotIdx], LIM_SMALL, pwArrMs[slotIdx] >= 0)
    benchLog.numField(@"win_ms", pwWinMs[slotIdx], LIM_SMALL)
    benchLog.numField(@"cps_x10", pwCpsX10[slotIdx], LIM_MID)
    benchLog.numField(@"cmd_x10", pwCmdX10[slotIdx], LIM_MID)
    benchLog.numField(@"fol_pm", pwFolPm[slotIdx], LIM_SMALL)
    benchLog.naNumField(@"wchk", pwWchk[slotIdx], LIM_SMALL, pwWchk[slotIdx] >= 0)
    benchLog.numField(@"duty", pwDuty[slotIdx], LIM_MID)
    benchLog.numField(@"held", pwHeld[slotIdx], LIM_MID)
    benchLog.numField(@"capped", pwCapped[slotIdx], LIM_MID)
    benchLog.numField(@"folds", pwFolds[slotIdx], LIM_SMALL)
    benchLog.numField(@"resyncs", pwResyncs[slotIdx], LIM_SMALL)
    benchLog.numField(@"dc_ma", pwDcMa[slotIdx], LIM_MID)
    lineEmit()

PRI powToken(nPowIdx) : pToken
' R23-SGL-POWER's instance token: the power's sign, the API's own.
'
' @param nPowIdx - 0: + power, 1: - power
' @returns pToken - pointer to PWR-POS or PWR-NEG

    pToken := (nPowIdx == 0) ? @sInstPwrPos : @sInstPwrNeg
#endif

CON { --- L-ladder (the analysis's L2) --- }

#ifdef SINGLE_PART_LADDER
PRI bRunLadder() : bCompleted | eSign, rungIdx, bGoOn, bEnded
' L-ladder: plan the row's rungs (ladderPlan()); under the row's ladder test limit (DAT rowLadderA), each sign NEG then
' POS: every rung from rest on the built-in ramp; then the rungs again, each by a step from the one below (the first from
' rest), the climb ending with a stop. A rung that faults, is refused or does not arrive ends its entry's climb (the rest
' SKIPPED). Then, at rest: each sign's duty line, reserve ceiling and misdial check, and every record.
'
' @returns bCompleted - T/F where T means no guard ended the run

' Local Variables:
' @local eSign - SIGN_NEG or SIGN_POS
' @local rungIdx - a rung
' @local bGoOn - T/F where T means nothing has ended the run
' @local bEnded - T/F where T means this entry's climb has ended (the motor rests)

    ladderPlan()
    clearLadder()
    bGoOn := bSetTestLimit(rowLadderA[rowIdx])
    repeat eSign from SIGN_NEG to SIGN_POS
        bEnded := FALSE
        repeat rungIdx from 0 to ladRungs - 1
            if bGoOn and (bEnded == FALSE)
                bGoOn, bEnded := bLadderRung(eSign, ENTRY_REST, rungIdx)
            elseif bGoOn
                rgOutcome[ladSlot(eSign, ENTRY_REST, rungIdx)] := RO_SKIPPED
        bEnded := FALSE
        repeat rungIdx from 0 to ladRungs - 1
            if bGoOn and (bEnded == FALSE)
                bGoOn, bEnded := bLadderRung(eSign, ENTRY_STEP, rungIdx)
            elseif bGoOn
                rgOutcome[ladSlot(eSign, ENTRY_STEP, rungIdx)] := RO_SKIPPED
        if bGoOn and (bEnded == FALSE)
            bGoOn, _ := bStopAndRest(TRUE)                  ' the step climb ends at its top
    if bGoOn
        bGoOn := bSetTestLimit(TEST_PEAK_A)
    ladderFinish()
    bCompleted := bGoOn

PRI ladderPlan() | idx, nIncr
' The row's rungs: DAT ladderPcts % of the shipped ceiling, each capped at the row's top; then, at a row from
' PK1_CAP_FROM_MV up, each DAT ladderExtIncr rung above the ceiling and not past PK1_CAP_INCR.

' Local Variables:
' @local idx - a table entry
' @local nIncr - an extension rung's increment

    ladRungs := 0
    repeat idx from 0 to LADDER_PCT_COUNT - 1
        ladRungIncr[ladRungs] := (rowCeil / 100 * ladderPcts[idx]) <# rowTop
        ladRungPct[ladRungs] := ladderPcts[idx]
        ladRungs++
    if TOLD_MV >= PK1_CAP_FROM_MV
        repeat idx from 0 to LADDER_EXT_COUNT - 1
            nIncr := ladderExtIncr[idx]
            if (nIncr > rowCeil) and (nIncr <= PK1_CAP_INCR)
                ladRungIncr[ladRungs] := nIncr
                ladRungPct[ladRungs] := 0
                ladRungs++

PRI clearLadder() | slotIdx, eSign
' Clear every rung's record and every fit before the leg.

' Local Variables:
' @local slotIdx - a rung's record slot
' @local eSign - a sign

    repeat slotIdx from 0 to LADDER_SLOTS - 1
        rgOutcome[slotIdx] := RO_NOT_RUN
        rgArrMs[slotIdx] := -1
        rgWchk[slotIdx] := -1
        bRgClean[slotIdx] := FALSE
    repeat eSign from SIGN_NEG to SIGN_POS
        fitOk[eSign] := FALSE
        fitPts[eSign] := 0
        bSfMisMeas[eSign] := FALSE

PRI ladSlot(eSign, eEntry, rungIdx) : slotIdx
' A rung's record slot.
'
' @param eSign - SIGN_*
' @param eEntry - ENTRY_*
' @param rungIdx - the rung
' @returns slotIdx - 0 .. LADDER_SLOTS - 1

    slotIdx := (eSign * ENTRY_COUNT + eEntry) * LADDER_MAX_RUNGS + rungIdx

PRI bLadderRung(eSign, eEntry, rungIdx) : bGoOn, bEnded | slotIdx, nIncr, nFrom, nWholeMs, nResync0
' One rung: command it (ENTRY_REST, and the step climb's first rung, from rest; a later step from the rung below), then
' measure it (bLadderMeasure()). A refused command (a protective stop latched: cleared) ends its entry's climb, stopped.
'
' @param eSign - SIGN_*
' @param eEntry - ENTRY_*
' @param rungIdx - the rung
' @returns bGoOn - T/F where T means nothing ended the run
' @returns bEnded - T/F where T means the climb has ended here and the motor rests

' Local Variables:
' @local slotIdx - the rung's record slot
' @local nIncr - its increment, signed
' @local nFrom - the field's increment before the command (0 from rest)
' @local nWholeMs - the generator's time for the change
' @local nResync0 - re-synced faults before the command

    bGoOn := TRUE
    bEnded := FALSE
    slotIdx := ladSlot(eSign, eEntry, rungIdx)
    nIncr := ladRungIncr[rungIdx]
    nFrom := 0
    if (eEntry == ENTRY_STEP) and (rungIdx > 0)
        nFrom := ladRungIncr[rungIdx - 1]
    if eSign == SIGN_NEG
        nIncr := -nIncr
        nFrom := -nFrom
    rgIncr[slotIdx] := nIncr
    _, nWholeMs := scurveMs(abs(nIncr - nFrom) #> 1, rampAccelUp, rampJerkUp, 0)
    _, _, nResync0 := wheel.testGetFaultResponse()
    if nFrom == 0
        sampleBegin()                                       ' from rest: a fresh cadence (a step keeps the climb's)
    if wheel.testDriveAtMotorIncrement(nIncr) == wheel.NO_ERROR
        bGoOn, bEnded := bLadderMeasure(eEntry, slotIdx, nIncr, nWholeMs, nResync0)
    else
        rgOutcome[slotIdx] := RO_REFUSED
        clearProtect()
        bEnded := TRUE
        if nFrom <> 0
            bGoOn, _ := bStopAndRest(TRUE)

PRI bLadderMeasure(eEntry, slotIdx, nIncr, nWholeMs, nResync0) : bGoOn, bEnded | eRo, eRo2, nArrMs, nResync1, bOk, nDev
' A commanded rung: wait until the drive reads AT_SPEED at it (bounded by twice the generator's time plus
' ARRIVE_MARGIN_MS); settle LADDER_SETTLE_MS; measure LADDER_WINDOW_MS; an ENTRY_REST rung then stops to rest. A rung
' that faults is cleared (a finding); one not arrived is measured as far as it got and stopped: each ends its entry's
' climb.
'
' @param eEntry - ENTRY_*
' @param slotIdx - the rung's record slot
' @param nIncr - its increment, signed
' @param nWholeMs - the generator's time for the change, ms
' @param nResync0 - re-synced faults before the command
' @returns bGoOn - T/F where T means nothing ended the run
' @returns bEnded - T/F where T means the climb has ended here and the motor rests

' Local Variables:
' @local eRo - the arrival's outcome
' @local eRo2 - the settle's and the window's
' @local nArrMs - ms to arrive
' @local nResync1 - re-synced faults after the window
' @local bOk - the window's encoder check
' @local nDev - its deviation

    bGoOn := TRUE
    bEnded := FALSE
    eRo, nArrMs := waitPhase(UNTIL_ARRIVED, nIncr, 2 * nWholeMs + ARRIVE_MARGIN_MS, FALSE)
    eRo2 := eRo
    if eRo == RO_DONE
        rgArrMs[slotIdx] := nArrMs
    if (eRo == RO_DONE) or (eRo == RO_TIMEOUT)              ' not arrived: measured anyway, following says how far short
        eRo2, _ := waitPhase(UNTIL_ELAPSED, 0, LADDER_SETTLE_MS, FALSE)
        if eRo2 == RO_DONE
            windowBegin()
            eRo2, _ := waitPhase(UNTIL_ELAPSED, 0, LADDER_WINDOW_MS, TRUE)
            windowEnd()
    _, _, nResync1 := wheel.testGetFaultResponse()
    rgResyncs[slotIdx] := nResync1 - nResync0
    if eRo2 == RO_DONE
        rgOutcome[slotIdx] := (eRo == RO_DONE) ? RO_DONE : RO_TIMEOUT
        storeRung(slotIdx, nIncr)
        bOk, nDev := bWindowEncOk()
        rgWchk[slotIdx] := nDev
        if bOk == FALSE
            bGoOn := FALSE
            bEnded := TRUE
        elseif (eEntry == ENTRY_REST) or (eRo <> RO_DONE)
            bEnded := (eRo <> RO_DONE)                      ' a rung that did not arrive ends its entry's climb
            bGoOn, _ := bStopAndRest(TRUE)
    elseif eRo2 == RO_FAULT
        rgOutcome[slotIdx] := RO_FAULT
        bEnded := TRUE
        bGoOn := bFaultRecover()
    else
        rgOutcome[slotIdx] := RO_ABORTED
        bEnded := TRUE
        bGoOn := FALSE

PRI storeRung(slotIdx, nIncr)
' Keep the window just closed as the rung's readings.
'
' @param slotIdx - the rung's record slot
' @param nIncr - its increment, signed

    rgWinMs[slotIdx] := winMs
    rgEnc[slotIdx] := winEncSpan
    rgCpsX10[slotIdx] := winCpsX10
    rgCmdCpsX10[slotIdx] := cmdCpsX1000(nIncr) / X100
    rgFolPm[slotIdx] := followPm(winCpsX10, nIncr)
    rgDuty[slotIdx] := divRound(winDutySum, winN #> 1)
    rgDutyLo[slotIdx] := (winN > 0) ? winDutyMin : 0
    rgDutyHi[slotIdx] := (winN > 0) ? winDutyMax : 0
    rgErrX10[slotIdx] := divRound(winAbsErrSum * X10, winN #> 1)
    rgErrPk[slotIdx] := winErrPeak
    rgHeld[slotIdx] := winLagD
    rgCapped[slotIdx] := winCapD
    rgFolds[slotIdx] := winFoldD
    rgDrvIncr[slotIdx] := smpDrvIncr
    rgDcMa[slotIdx] := winDcMa
    rgN[slotIdx] := winN
    bRgClean[slotIdx] := (rgOutcome[slotIdx] == RO_DONE) and (winLagD == 0) and (winCapD == 0) and (winFoldD == 0) and (rgResyncs[slotIdx] == 0) and (abs(rgFolPm[slotIdx] - PM) <= FOLLOW_TOL_PM)

PRI ladderFinish() | eSign, eEntry, rungIdx, slotIdx, bUsable, bUsableKnown, nDev
' At rest after the ladder: each sign's duty line (fitSign()) and misdial check (misdialSign()); the run's rows usable
' unless a measured misdial check missed; R23-SGL-FOLLOW's and R23-SGL-SMOOTH's readings; then every record.

' Local Variables:
' @local eSign - a sign
' @local eEntry - an entry
' @local rungIdx - a rung
' @local slotIdx - its record slot
' @local bUsable - T/F where T means no measured misdial check missed
' @local bUsableKnown - T/F where T means some misdial check was measured
' @local nDev - one rung's following deviation, per mille

    repeat eSign from SIGN_NEG to SIGN_POS
        fitSign(eSign)
        misdialSign(eSign)
    bUsableKnown := bSfMisMeas[SIGN_NEG] or bSfMisMeas[SIGN_POS]
    bUsable := TRUE
    repeat eSign from SIGN_NEG to SIGN_POS
        if bSfMisMeas[eSign] and (abs(sfMisPm[eSign]) > MISDIAL_TOL_PM)
            bUsable := FALSE
    repeat eSign from SIGN_NEG to SIGN_POS
        repeat eEntry from ENTRY_REST to ENTRY_STEP
            repeat rungIdx from 0 to ladRungs - 1
                slotIdx := ladSlot(eSign, eEntry, rungIdx)
                if ladRungPct[rungIdx] <> 0                 ' FOLLOW: the table's rungs only
                    if (rgOutcome[slotIdx] == RO_DONE) or (rgOutcome[slotIdx] == RO_TIMEOUT)
                        nDev := abs(rgFolPm[slotIdx] - PM)
                        sfFolWorst[eSign] #>= nDev
                        sfFolN[eSign]++
                    elseif rgOutcome[slotIdx] == RO_FAULT
                        sfFolWorst[eSign] #>= PM            ' it did not hold its speed
                        sfFolN[eSign]++
                if rungIdx == LADDER_CEIL_RUNG              ' SMOOTH and TOPSPD: the ceiling, from rest and by a step
                    if (rgOutcome[slotIdx] == RO_DONE) or (rgOutcome[slotIdx] == RO_TIMEOUT) or (rgOutcome[slotIdx] == RO_FAULT)
                        noteSmooth(eSign, (rgOutcome[slotIdx] == RO_FAULT) or (rgResyncs[slotIdx] > 0))
                    if (rgOutcome[slotIdx] == RO_DONE) or (rgOutcome[slotIdx] == RO_TIMEOUT)
                        noteTopSpd(eSign, abs(rgFolPm[slotIdx] - PM))
                    elseif rgOutcome[slotIdx] == RO_FAULT
                        noteTopSpd(eSign, PM)               ' it did not hold the law
                if rgOutcome[slotIdx] <> RO_NOT_RUN
                    emitLadderRung(eSign, eEntry, rungIdx, slotIdx, bUsable, bUsableKnown)
    repeat eSign from SIGN_NEG to SIGN_POS
        emitFfLine(eSign)
        emitMisdial(eSign, bUsable, bUsableKnown)

PRI fitSign(eSign) | eEntry, rungIdx, slotIdx, nPts, nLo, nHi, fSx, fSy, fMx, fMy, fSxx, fSxy, fSrr, fX, fY, fB, fA, fCpsRes, fIncrRes
' The sign's duty line: least squares of the mean duty against the encoder's speed (counts/s x10) over its clean rungs,
' both entries (in float, about the means); its rms residual; and the reserve ceiling -- the increment where the line
' reaches DUTY_RESERVE_PM of the drive's duty ceiling (the 6.5in's reserve, ADDING_MOTOR.md step 6), flagged when it lies
' past the fastest clean rung (an extrapolation).
'
' @param eSign - SIGN_*

' Local Variables:
' @local eEntry - an entry
' @local rungIdx - a rung
' @local slotIdx - its record slot
' @local nPts - clean rungs
' @local nLo - the slowest clean rung's speed, counts/s x10
' @local nHi - the fastest's
' @local fSx - float sum of the speeds
' @local fSy - float sum of the duties
' @local fMx - their mean speed
' @local fMy - their mean duty
' @local fSxx - float sum of squared speed deviations
' @local fSxy - float sum of speed x duty deviations
' @local fSrr - float sum of squared residuals
' @local fX - one rung's speed
' @local fY - its duty
' @local fB - the slope, duty per (counts/s x10)
' @local fA - the intercept, duty
' @local fCpsRes - the reserve ceiling's speed, counts/s x10
' @local fIncrRes - its increment

    nPts := 0
    nLo := posx
    nHi := 0
    fSx := 0.0
    fSy := 0.0
    repeat eEntry from ENTRY_REST to ENTRY_STEP
        repeat rungIdx from 0 to ladRungs - 1
            slotIdx := ladSlot(eSign, eEntry, rungIdx)
            if bRgClean[slotIdx]
                nPts++
                fSx := fSx +. float(abs(rgCpsX10[slotIdx]))
                fSy := fSy +. float(rgDuty[slotIdx])
                nLo <#= abs(rgCpsX10[slotIdx])
                nHi #>= abs(rgCpsX10[slotIdx])
    fitPts[eSign] := nPts
    fitLoCps[eSign] := (nPts > 0) ? nLo : 0
    fitHiCps[eSign] := nHi
    fitOk[eSign] := FALSE
    if nPts >= 2
        fMx := fSx /. float(nPts)
        fMy := fSy /. float(nPts)
        fSxx := 0.0
        fSxy := 0.0
        repeat eEntry from ENTRY_REST to ENTRY_STEP
            repeat rungIdx from 0 to ladRungs - 1
                slotIdx := ladSlot(eSign, eEntry, rungIdx)
                if bRgClean[slotIdx]
                    fX := float(abs(rgCpsX10[slotIdx])) -. fMx
                    fY := float(rgDuty[slotIdx]) -. fMy
                    fSxx := fSxx +. fX *. fX
                    fSxy := fSxy +. fX *. fY
        if fSxx >. 0.0
            fB := fSxy /. fSxx
            fA := fMy -. fB *. fMx
            fSrr := 0.0
            repeat eEntry from ENTRY_REST to ENTRY_STEP
                repeat rungIdx from 0 to ladRungs - 1
                    slotIdx := ladSlot(eSign, eEntry, rungIdx)
                    if bRgClean[slotIdx]
                        fY := float(rgDuty[slotIdx]) -. (fA +. fB *. float(abs(rgCpsX10[slotIdx])))
                        fSrr := fSrr +. fY *. fY
            fitA[eSign] := fA
            fitB[eSign] := fB
            fitRms[eSign] := fsqrt(fSrr /. float(nPts))
            fitOk[eSign] := (fB >. 0.0)
    fitResIncr[eSign] := 0
    bFitResExtrap[eSign] := FALSE
    if fitOk[eSign]
        fCpsRes := (float(dutyMax) *. float(DUTY_RESERVE_PM) /. float(PM) -. fitA[eSign]) /. fitB[eSign]
        ' increment = (counts/s x10 / 10) x 1000 x 2^31 / cpsLawK; held under the increment's limit, 2^30 (ADDING_MOTOR.md)
        fIncrRes := fCpsRes *. float(X100) *. F_2POW31 /. float(cpsLawK)
        if fIncrRes >. 1073741823.0
            fIncrRes := 1073741823.0
        if fIncrRes <. 0.0
            fIncrRes := 0.0
        fitResIncr[eSign] := round(fIncrRes)
        bFitResExtrap[eSign] := (fCpsRes >. float(nHi))

PRI misdialSign(eSign) | fV
' The sign's misdial check (R23-SGL-MISDIAL): from the duty line's slope, the supply that would give it --
' Vbus = Ke x 60 x DUTY_VOLT_DIV x frame_cnt / (sqrt 3 x ENC_COUNTS_PER_REV x 1000 x (duty per count/s)), mV, Ke being
' KE_USED_MV_PER_KRPM (the sheet's, or task 3686's fitted one in a SINGLE_QUALIFY build)
' (the phase peak per rad/s is Ke / sqrt 3; the phase voltage is Vbus x duty / (DUTY_VOLT_DIV x frame_cnt)) -- against
' TOLD_MV, per mille. Measured only with MISDIAL_MIN_POINTS clean rungs spanning MISDIAL_MIN_SPAN_PM of the fastest.
'
' @param eSign - SIGN_*

' Local Variables:
' @local fV - the predicted supply, mV (float)

    bSfMisMeas[eSign] := FALSE
    fitVpredMv[eSign] := 0
    if fitOk[eSign] and (fitPts[eSign] >= MISDIAL_MIN_POINTS) and ((fitHiCps[eSign] - fitLoCps[eSign]) * PM >= MISDIAL_MIN_SPAN_PM * fitHiCps[eSign])
        fV := float(KE_USED_MV_PER_KRPM) *. 60.0 *. float(DUTY_VOLT_DIV * frameCnt) /. (F_SQRT3 *. float(ENC_COUNTS_PER_REV) *. 1000.0 *. (fitB[eSign] *. float(X10)))
        if fV >. 999999.0
            fV := 999999.0
        fitVpredMv[eSign] := round(fV)
        sfMisPm[eSign] := divRound((fitVpredMv[eSign] - TOLD_MV) * PM, TOLD_MV)
        fitRatioPpm[eSign] := clampedRound((fV /. float(TOLD_MV) -. 1.0) *. float(wheel.PPM), LIM_BIG)   ' phase 2b: the raw ratio, unrounded mV
        bSfMisMeas[eSign] := TRUE

PRI emitLadderRung(eSign, eEntry, rungIdx, slotIdx, bUsable, bUsableKnown)
' Emit B1-RUNG (the speed) and B1-RUNGD (the drive) for one rung.
'
' @param eSign - SIGN_*
' @param eEntry - ENTRY_*
' @param rungIdx - the rung
' @param slotIdx - its record slot
' @param bUsable - T/F where T means no measured misdial check of this run missed
' @param bUsableKnown - T/F where T means some misdial check was measured (else usable is NA)

    benchLog.begin(@"B1-RUNG")
    benchLog.tokenField(@"sign", (eSign == SIGN_NEG) ? @sSignNeg : @sSignPos, TOKMAX_SIGN)
    benchLog.tokenField(@"entry", (eEntry == ENTRY_REST) ? @sEntryRest : @sEntryStep, TOKMAX_ENTRY)
    benchLog.numField(@"rung", rungIdx, LIM_TINY)
    benchLog.numField(@"pct", ladRungPct[rungIdx], LIM_TINY)
    benchLog.numField(@"incr", rgIncr[slotIdx], LIM_BIG)
    benchLog.tokenField(@"outcome", roToken(rgOutcome[slotIdx]), TOKMAX_RO)
    benchLog.naNumField(@"arr_ms", rgArrMs[slotIdx], LIM_SMALL, rgArrMs[slotIdx] >= 0)
    benchLog.numField(@"win_ms", rgWinMs[slotIdx], LIM_SMALL)
    benchLog.numField(@"enc", rgEnc[slotIdx], LIM_MID)
    benchLog.numField(@"cps_x10", rgCpsX10[slotIdx], LIM_MID)
    benchLog.numField(@"cmd_x10", rgCmdCpsX10[slotIdx], LIM_MID)
    benchLog.numField(@"fol_pm", rgFolPm[slotIdx], LIM_SMALL)
    benchLog.naNumField(@"wchk", rgWchk[slotIdx], LIM_SMALL, rgWchk[slotIdx] >= 0)
    benchLog.boolField(@"clean", bRgClean[slotIdx])
    if bUsableKnown
        benchLog.boolField(@"usable", bUsable)
    else
        benchLog.textField(@"usable", @sNa)
    lineEmit()
    benchLog.begin(@"B1-RUNGD")
    benchLog.tokenField(@"sign", (eSign == SIGN_NEG) ? @sSignNeg : @sSignPos, TOKMAX_SIGN)
    benchLog.tokenField(@"entry", (eEntry == ENTRY_REST) ? @sEntryRest : @sEntryStep, TOKMAX_ENTRY)
    benchLog.numField(@"rung", rungIdx, LIM_TINY)
    benchLog.numField(@"duty", rgDuty[slotIdx], LIM_MID)
    benchLog.numField(@"duty_lo", rgDutyLo[slotIdx], LIM_MID)
    benchLog.numField(@"duty_hi", rgDutyHi[slotIdx], LIM_MID)
    benchLog.numField(@"err_x10", rgErrX10[slotIdx], LIM_SMALL)
    benchLog.numField(@"err_pk", rgErrPk[slotIdx], LIM_SMALL)
    benchLog.numField(@"held", rgHeld[slotIdx], LIM_MID)
    benchLog.numField(@"capped", rgCapped[slotIdx], LIM_MID)
    benchLog.numField(@"folds", rgFolds[slotIdx], LIM_SMALL)
    benchLog.numField(@"resyncs", rgResyncs[slotIdx], LIM_SMALL)
    benchLog.numField(@"drv_incr", rgDrvIncr[slotIdx], LIM_BIG)
    benchLog.numField(@"dc_ma", rgDcMa[slotIdx], LIM_MID)
    benchLog.numField(@"n", rgN[slotIdx], LIM_SMALL)
    lineEmit()

PRI emitFfLine(eSign)
' Emit B1-FFLINE: the sign's duty line -- duty at rest (d0) and per 10^8 of increment (the feedforward line sec 6 needs, by
' the drive law), its rms residual x10, the clean rungs' speed span, and the reserve ceiling's increment (thousands).
'
' @param eSign - SIGN_*

    benchLog.begin(@"B1-FFLINE")
    benchLog.tokenField(@"sign", (eSign == SIGN_NEG) ? @sSignNeg : @sSignPos, TOKMAX_SIGN)
    benchLog.boolField(@"ok", fitOk[eSign])
    benchLog.numField(@"pts", fitPts[eSign], LIM_TINY)
    benchLog.naNumField(@"d0", round(fitA[eSign]), LIM_MID, fitOk[eSign])
    benchLog.naNumField(@"d_per_e8", round(fitB[eSign] *. float(cmdCpsX1000(100_000_000) / X100)), LIM_MID, fitOk[eSign])
    benchLog.naNumField(@"rms_x10", round(fitRms[eSign] *. 10.0), LIM_MID, fitOk[eSign])
    benchLog.numField(@"lo_x10", fitLoCps[eSign], LIM_MID)
    benchLog.numField(@"hi_x10", fitHiCps[eSign], LIM_MID)
    benchLog.naNumField(@"res_incr_k", fitResIncr[eSign] / PM, LIM_MID, fitOk[eSign])
    benchLog.boolField(@"res_extrap", bFitResExtrap[eSign])
    benchLog.numField(@"duty_max", dutyMax, LIM_MID)
    benchLog.numField(@"reserve_pm", DUTY_RESERVE_PM, LIM_SMALL)
    lineEmit()

PRI emitMisdial(eSign, bUsable, bUsableKnown)
' Emit B1-MISDIAL: the sign's predicted supply against the told one, the tolerance in force and the run's rows' verdict;
' phase 2b (arbiter decision D5): the raw ratio unrounded (ratio_ppm) and the duty line's slope (slope_e9: duty per
' counts/s x10, x 10^9), so D1's evaluation can refit Ke across the rows and judge each row's ratio at +-30 offline.
'
' @param eSign - SIGN_*
' @param bUsable - T/F where T means no measured misdial check of this run missed
' @param bUsableKnown - T/F where T means some misdial check was measured

    benchLog.begin(@"B1-MISDIAL")
    benchLog.tokenField(@"sign", (eSign == SIGN_NEG) ? @sSignNeg : @sSignPos, TOKMAX_SIGN)
    benchLog.boolField(@"meas", bSfMisMeas[eSign])
    benchLog.naNumField(@"vpred_mv", fitVpredMv[eSign], LIM_MID, bSfMisMeas[eSign])
    benchLog.numField(@"told_mv", TOLD_MV, LIM_MID)
    benchLog.naNumField(@"dev_pm", sfMisPm[eSign], LIM_MID, bSfMisMeas[eSign])
    benchLog.naNumField(@"ratio_ppm", fitRatioPpm[eSign], LIM_BIG, bSfMisMeas[eSign])
    benchLog.naNumField(@"slope_e9", clampedRound(fitB[eSign] *. 1.0e9, LIM_BIG), LIM_BIG, fitOk[eSign])
    benchLog.numField(@"tol_pm", MISDIAL_TOL_PM, LIM_SMALL)
    benchLog.numField(@"ke_mv_krpm", KE_USED_MV_PER_KRPM, LIM_SMALL)   ' the Ke predicted from (task 3686: the fitted one when fitted)
    benchLog.boolField(@"ke_fitted", KE_IS_FITTED)
    benchLog.numField(@"frame_cnt", frameCnt, LIM_MID)
    if bUsableKnown
        benchLog.boolField(@"rows_usable", bUsable)
    else
        benchLog.textField(@"rows_usable", @sNa)
    lineEmit()
#endif

CON { --- L-ramp (the analysis's L7) and the reversal --- }

#ifdef SINGLE_PART_RAMP
PRI bRunRampLeg() : bCompleted | nPowIdx, bGoOn
' L-ramp: from rest to the row's top on the built-in ramp, held RAMP_HOLD_MS, then stopMotor() -- at +top power, then
' at -top power -- and the reversal (bReverseRun()).
'
' @returns bCompleted - T/F where T means no guard ended the run

' Local Variables:
' @local nPowIdx - 0: +power, 1: -power
' @local bGoOn - T/F where T means nothing has ended the run

    bGoOn := TRUE
    repeat nPowIdx from 0 to 1
        if bGoOn
            bGoOn := bRampOnce(1 - 2 * nPowIdx)
    if bGoOn
        bGoOn := bReverseRun()
    bCompleted := bGoOn

PRI bRampOnce(nPowSign) : bGoOn | nPower, nCmd, nCmdMs, nResync0
' One ramp from rest to the row's top at {nPowSign} x rowTopPower, by driveAtPower() -- the public path, as a user's --
' then its measurement (bRampMeasure()). A refused command (a protective stop latched: cleared) prints B1-RAMP refused; an
' increment past the row's top ends the run (bCheckTop()).
'
' @param nPowSign - +1 or -1
' @returns bGoOn - T/F where T means nothing ended the run

' Local Variables:
' @local nPower - the power commanded
' @local nCmd - the increment the library wrote for it
' @local nCmdMs - getms() at the command
' @local nResync0 - re-synced faults before it

    bGoOn := TRUE
    nPower := rowTopPower * nPowSign
    _, _, nResync0 := wheel.testGetFaultResponse()
    sampleBegin()
    nCmdMs := getms()
    if wheel.driveAtPower(nPower) == wheel.NO_ERROR
        nCmd, _, _, _, _, _ := wheel.testGetDriveFollow()
        if bCheckTop(nCmd)
            bGoOn := bRampMeasure(nPower, nCmd, nCmdMs, nResync0)
        else
            bGoOn := FALSE
    else
        clearProtect()
        emitRampRefused(nPower)

PRI bRampMeasure(nPower, nCmd, nCmdMs, nResync0) : bGoOn | eSign, nCmdX1000, nUpBandMs, nUpWholeMs, nArrEncMs, nArrStateMs, eOutcome, bFaulted, bHolding, nHoldMs, nCps, nUpSum, nUpN, nResync1, nHoldFol, bWok, nWdev, nV, nStartCps, nEncAtStop, nDnBandMs, nDnWholeMs, nStopMs, nDnEncMs, nDnStateMs, nDnSum, nDnN, nFinal, nRestMs, bRingShort, nPredTravel, bWinDone, instUp, instDn, bUpEnded, bDnEnded, nReadMs
' A commanded ramp to the top: held RAMP_HOLD_MS once the drive reads AT_SPEED there, then stopMotor() and the shaft's
' rest. Times from the command: the encoder within ARRIVE_BAND_PM of the top (at_enc_ms) against the generator's
' prediction to the same band (p_band_ms), and the drive's own AT_SPEED (at_state_ms); from the stop: the encoder under
' ARRIVE_BAND_PM of the start speed against the prediction, the drive's DCS_STOPPED, the shaft's travel against the
' S-curve's, and the DC link through the stop. Feeds R23-SGL-RAMPARR, R23-SGL-SMOOTH and (task 3686) R23-SGL-TOPSPD.
' Task 3686: a change the encoder never reads arriving before its bound is judged at that bound (RAMPARR's CON). Emits
' B1-RAMP and B1-RAMPDN.
'
' @param nPower - the power commanded
' @param nCmd - the increment the library wrote for it
' @param nCmdMs - getms() at the command
' @param nResync0 - re-synced faults before it
' @returns bGoOn - T/F where T means nothing ended the run

' Local Variables:
' @local eSign - the increment's sign's SIGN_*
' @local nCmdX1000 - the top's speed, counts/s x 1000
' @local nUpBandMs - the prediction to the band, ms
' @local nUpWholeMs - the generator's whole time, ms
' @local nArrEncMs - ms to the encoder's arrival (-1 none)
' @local nArrStateMs - ms to the drive's AT_SPEED (-1 none)
' @local eOutcome - a reading's outcome
' @local bFaulted - T/F where T means the drive faulted
' @local bHolding - T/F where T means the hold has begun
' @local nHoldMs - getms() when the hold began
' @local nCps - the encoder's speed, counts/s
' @local nUpSum - current-sense sum over the climb and hold, mV
' @local nUpN - its readings
' @local nResync1 - re-synced faults after the hold
' @local nHoldFol - the hold's following, per mille
' @local bWok - the hold window's encoder check
' @local nWdev - its deviation
' @local nV - the field's increment at the stop
' @local nStartCps - the encoder's speed at the stop
' @local nEncAtStop - the count at the stop
' @local nDnBandMs - the stop's prediction to the band, ms
' @local nDnWholeMs - the stop's whole time, ms
' @local nStopMs - getms() at the stop
' @local nDnEncMs - ms to the encoder under the band (-1 none)
' @local nDnStateMs - ms to DCS_STOPPED (-1 none)
' @local nDnSum - current-sense sum through the stop, mV
' @local nDnN - its readings
' @local nFinal - the count at rest
' @local nRestMs - the rest instant
' @local bRingShort - restQuiet()'s flag
' @local nPredTravel - the S-curve's travel through the stop, counts
' @local bWinDone - T/F where T means the hold's window was closed (its fields are this ramp's)
' @local instUp - RAMPARR's UP instance
' @local instDn - its DN instance
' @local bUpEnded - T/F where T means the climb ended by its hold or its bound (no fault, no guard)
' @local bDnEnded - T/F where T means the stop ended at DCS_STOPPED or its bound (no fault, no guard)
' @local nReadMs - RAMPARR's reading: the encoder's arrival, or the change's bound when it never came (task 3686)

    bGoOn := TRUE
    bFaulted := FALSE
    bUpEnded := FALSE
    bDnEnded := FALSE
    nArrEncMs := -1
    nArrStateMs := -1
    nDnEncMs := -1
    nDnStateMs := -1
    nHoldFol := 0
    nWdev := -1
    nUpSum := 0
    nUpN := 0
    nDnSum := 0
    nDnN := 0
    nV := 0
    nEncAtStop := 0
    nFinal := 0
    nPredTravel := 0
    nDnBandMs := 0
    nDnWholeMs := 0
    bRingShort := FALSE
    nStartCps := 0
    eSign := signOfIncr(nCmd)
    nCmdX1000 := cmdCpsX1000(nCmd)
    nUpBandMs, nUpWholeMs := scurveMs(abs(nCmd) #> 1, rampAccelUp, rampJerkUp, ARRIVE_BAND_PM)
    bHolding := FALSE
    repeat
        eOutcome := sampleNext()
        if bHolding
            windowAdd()
        nUpSum += smpSenseMv
        nUpN++
        if eOutcome == BO_FAULT
            bFaulted := TRUE
            quit
        if bGuardStops(eOutcome)
            bGoOn := FALSE
            quit
        nCps := ringSpeedCps()
        if (nArrEncMs < 0) and (abs(nCps) * PM >= muldiv64(nCmdX1000, PM - ARRIVE_BAND_PM, PM))
            nArrEncMs := smpMs - nCmdMs
        if (nArrStateMs < 0) and (smpState == wheel.DCS_AT_SPEED) and (smpDrvIncr == nCmd)
            nArrStateMs := smpMs - nCmdMs
            bHolding := TRUE
            nHoldMs := smpMs
            windowBegin()
        if bHolding and (smpMs - nHoldMs >= RAMP_HOLD_MS)
            bUpEnded := TRUE
            quit
        if smpMs - nCmdMs > 2 * nUpWholeMs + ARRIVE_MARGIN_MS
            bUpEnded := TRUE
            quit                                            ' not at the top in its bound: stopped from where it is
    _, _, nResync1 := wheel.testGetFaultResponse()
    bWinDone := FALSE
    if bHolding and bGoOn and (bFaulted == FALSE)
        windowEnd()
        bWinDone := TRUE
        nHoldFol := followPm(winCpsX10, nCmd)
        bWok, nWdev := bWindowEncOk()
        bGoOn := bWok
    if bGoOn
        noteSmooth(eSign, bFaulted or (nResync1 <> nResync0))
        if bWinDone                                         ' task 3686, R23-SGL-TOPSPD: the hold's window at the top
            noteTopSpd(eSign, abs(nHoldFol - PM))
        else
            noteTopSpd(eSign, PM)                           ' a fault, or a climb that never arrived in its bound
    if bGoOn and bFaulted
        bGoOn := bFaultRecover()
    elseif bGoOn
        ' the stop, from the top (or from where the climb reached)
        nV := abs(smpDrvIncr)
        nStartCps := abs(ringSpeedCps())
        nEncAtStop := smpEnc
        nDnBandMs, nDnWholeMs := scurveMs(nV #> 1, rampAccelDn, rampJerkDn, ARRIVE_BAND_PM)
        nStopMs := getms()
        wheel.stopMotor()
        repeat
            eOutcome := sampleNext()
            nDnSum += smpSenseMv
            nDnN++
            if eOutcome == BO_FAULT
                bFaulted := TRUE
                quit
            if bGuardStops(eOutcome)
                bGoOn := FALSE
                quit
            nCps := ringSpeedCps()
            if (nDnEncMs < 0) and (abs(nCps) * PM <= ARRIVE_BAND_PM * nStartCps)
                nDnEncMs := smpMs - nStopMs
            if smpState == wheel.DCS_STOPPED
                nDnStateMs := smpMs - nStopMs
                bDnEnded := TRUE
                quit
            if smpMs - nStopMs > 2 * nDnWholeMs + ARRIVE_MARGIN_MS
                bDnEnded := TRUE
                quit
        if bGoOn and bFaulted
            bGoOn := bFaultRecover()
        elseif bGoOn
            bGoOn, nFinal, nRestMs, bRingShort := restQuiet()
            nPredTravel := muldiv64(cmdCpsX1000(nV), nDnWholeMs, 2 * US_PER_S)
            waitms(LEG_REST_MS)
    ' R23-SGL-RAMPARR: each change judged when it ran clean to its reading -- task 3686: or to its bound, when the
    '  encoder never read it arrive, and then it reads that bound (a FAIL, never a NOMEAS: the exclusion check)
    instUp := eSign * CHG_COUNT + CHG_UP
    instDn := eSign * CHG_COUNT + CHG_DN
    if ((nArrEncMs >= 0) or bUpEnded) and (bFaulted == FALSE) and (nResync1 == nResync0) and (nUpBandMs > 0)
        nReadMs := 2 * nUpWholeMs + ARRIVE_MARGIN_MS
        if nArrEncMs >= 0
            nReadMs := nArrEncMs
        sfArrPm[instUp] := divRound((nReadMs - nUpBandMs) * PM, nUpBandMs)
        sfArrN[instUp]++
    if ((nDnEncMs >= 0) or bDnEnded) and (nArrStateMs >= 0) and (bFaulted == FALSE) and (nDnBandMs > 0)
        nReadMs := 2 * nDnWholeMs + ARRIVE_MARGIN_MS
        if nDnEncMs >= 0
            nReadMs := nDnEncMs
        sfArrPm[instDn] := divRound((nReadMs - nDnBandMs) * PM, nDnBandMs)
        sfArrN[instDn]++
    benchLog.begin(@"B1-RAMP")
    benchLog.tokenField(@"sign", (eSign == SIGN_NEG) ? @sSignNeg : @sSignPos, TOKMAX_SIGN)
    benchLog.numField(@"power", nPower, LIM_TINY)
    benchLog.numField(@"lib_incr", nCmd, LIM_BIG)
    benchLog.numField(@"top_incr", rowTop, LIM_BIG)
    benchLog.boolField(@"faulted", bFaulted)
    benchLog.numField(@"resyncs", nResync1 - nResync0, LIM_SMALL)
    benchLog.numField(@"p_band_ms", nUpBandMs, LIM_SMALL)
    benchLog.numField(@"p_whole_ms", nUpWholeMs, LIM_SMALL)
    benchLog.naNumField(@"at_enc_ms", nArrEncMs, LIM_SMALL, nArrEncMs >= 0)
    benchLog.naNumField(@"at_state_ms", nArrStateMs, LIM_SMALL, nArrStateMs >= 0)
    benchLog.naNumField(@"hold_fol_pm", nHoldFol, LIM_SMALL, bWinDone)
    benchLog.naNumField(@"held", winLagD, LIM_MID, bWinDone)
    benchLog.naNumField(@"folds", winFoldD, LIM_SMALL, bWinDone)
    benchLog.numField(@"up_dc_ma", meanDcMa(nUpSum, nUpN), LIM_MID)
    benchLog.naNumField(@"wchk", nWdev, LIM_SMALL, nWdev >= 0)
    lineEmit()
    benchLog.begin(@"B1-RAMPDN")
    benchLog.tokenField(@"sign", (eSign == SIGN_NEG) ? @sSignNeg : @sSignPos, TOKMAX_SIGN)
    benchLog.numField(@"start_incr", nV, LIM_BIG)
    benchLog.numField(@"start_cps", nStartCps, LIM_MID)
    benchLog.numField(@"p_band_ms", nDnBandMs, LIM_SMALL)
    benchLog.numField(@"p_whole_ms", nDnWholeMs, LIM_SMALL)
    benchLog.naNumField(@"dn_enc_ms", nDnEncMs, LIM_SMALL, nDnEncMs >= 0)
    benchLog.naNumField(@"dn_state_ms", nDnStateMs, LIM_SMALL, nDnStateMs >= 0)
    benchLog.numField(@"travel", abs(nFinal - nEncAtStop), LIM_MID)
    benchLog.numField(@"p_travel", nPredTravel, LIM_MID)
    benchLog.numField(@"dn_dc_ma", meanDcMa(nDnSum, nDnN), LIM_MID)
    benchLog.numField(@"dn_n", nDnN, LIM_SMALL)
    benchLog.boolField(@"ring_short", bRingShort)
    lineEmit()

PRI emitRampRefused(nPower)
' Emit B1-RAMP for a ramp the library refused (nothing moved; a latched protective stop has been cleared).
'
' @param nPower - the power refused

    benchLog.begin(@"B1-RAMP")
    benchLog.textField(@"sign", @sNa)
    benchLog.numField(@"power", nPower, LIM_TINY)
    benchLog.textField(@"refused", @sSfFail)
    lineEmit()

PRI bReverseRun() : bGoOn | nPhase, nPower, nCmd, nUpMs, nDnMs, eRo, nMs, nResync0, nResync1, bFaulted, bWok, nWdev, nArr0, nArr1, nArr2, nFol0, nFol1, nFol2, nRan
' L-ramp's reversal: from rest to the top at +power, then straight to -power, then straight back to +power (through zero
' each time, on the built-in ramp), each held REV_HOLD_MS after the drive reads AT_SPEED there; then stopMotor() and rest.
' Feeds R23-SGL-SMOOTH's REVERSAL (one run: did it fault or re-sync) and (task 3686) R23-SGL-TOPSPD's (the worst of its
' three tops' following). Emits B1-REVERSE at rest.
'
' @returns bGoOn - T/F where T means nothing ended the run

' Local Variables:
' @local nPhase - 0: +top from rest, 1: to -top, 2: back to +top
' @local nPower - the phase's power
' @local nCmd - the increment the library wrote
' @local nUpMs - the generator's time for a top from rest, ms
' @local nDnMs - its time to stop from a top, ms
' @local eRo - a phase's outcome
' @local nMs - ms to arrive
' @local nResync0 - re-synced faults before
' @local nResync1 - after
' @local bFaulted - T/F where T means it faulted
' @local bWok - a hold window's encoder check
' @local nWdev - its deviation
' @local nArr0 - phase 0's arrival, ms (-1 none)
' @local nArr1 - phase 1's
' @local nArr2 - phase 2's
' @local nFol0 - phase 0's hold following, per mille
' @local nFol1 - phase 1's
' @local nFol2 - phase 2's
' @local nRan - phases the library accepted

    bGoOn := TRUE
    bFaulted := FALSE
    nRan := 0
    nArr0 := -1
    nArr1 := -1
    nArr2 := -1
    nFol0 := 0
    nFol1 := 0
    nFol2 := 0
    _, nUpMs := scurveMs(rowTop, rampAccelUp, rampJerkUp, 0)
    _, nDnMs := scurveMs(rowTop, rampAccelDn, rampJerkDn, 0)
    _, _, nResync0 := wheel.testGetFaultResponse()
    sampleBegin()
    repeat nPhase from 0 to 2
        nPower := (nPhase == 1) ? -rowTopPower : rowTopPower
        if wheel.driveAtPower(nPower) <> wheel.NO_ERROR
            clearProtect()
            quit
        nCmd, _, _, _, _, _ := wheel.testGetDriveFollow()
        if bCheckTop(nCmd) == FALSE
            bGoOn := FALSE
            quit
        nRan++
        eRo, nMs := waitPhase(UNTIL_ARRIVED, nCmd, 2 * (nUpMs + nDnMs) + ARRIVE_MARGIN_MS, FALSE)
        if eRo == RO_DONE
            case nPhase
                0: nArr0 := nMs
                1: nArr1 := nMs
                2: nArr2 := nMs
        if (eRo == RO_DONE) or (eRo == RO_TIMEOUT)
            windowBegin()
            eRo, _ := waitPhase(UNTIL_ELAPSED, 0, REV_HOLD_MS, TRUE)
            if eRo == RO_DONE
                windowEnd()
                case nPhase
                    0: nFol0 := followPm(winCpsX10, nCmd)
                    1: nFol1 := followPm(winCpsX10, nCmd)
                    2: nFol2 := followPm(winCpsX10, nCmd)
                bWok, nWdev := bWindowEncOk()
                if bWok == FALSE
                    bGoOn := FALSE
                    quit
        if eRo == RO_FAULT
            bFaulted := TRUE
            quit
        if eRo == RO_ABORTED
            bGoOn := FALSE
            quit
    _, _, nResync1 := wheel.testGetFaultResponse()
    if bGoOn
        if nRan > 0
            noteSmooth(SMOOTH_REVERSAL, bFaulted or (nResync1 <> nResync0))
            ' task 3686, R23-SGL-TOPSPD: the worst of the three tops; a top whose window never ran reads 0, so PM
            noteTopSpd(SMOOTH_REVERSAL, abs(nFol0 - PM) #> abs(nFol1 - PM) #> abs(nFol2 - PM))
        if bFaulted
            bGoOn := bFaultRecover()
        else
            bGoOn, _ := bStopAndRest(FALSE)
    benchLog.begin(@"B1-REVERSE")
    benchLog.numField(@"power", rowTopPower, LIM_TINY)
    benchLog.numField(@"ran", nRan, LIM_TINY)
    benchLog.boolField(@"faulted", bFaulted)
    benchLog.numField(@"resyncs", nResync1 - nResync0, LIM_SMALL)
    benchLog.naNumField(@"arr0_ms", nArr0, LIM_SMALL, nArr0 >= 0)
    benchLog.naNumField(@"arr1_ms", nArr1, LIM_SMALL, nArr1 >= 0)
    benchLog.naNumField(@"arr2_ms", nArr2, LIM_SMALL, nArr2 >= 0)
    benchLog.numField(@"fol0_pm", nFol0, LIM_SMALL)
    benchLog.numField(@"fol1_pm", nFol1, LIM_SMALL)
    benchLog.numField(@"fol2_pm", nFol2, LIM_SMALL)
    benchLog.numField(@"p_up_ms", nUpMs, LIM_SMALL)
    benchLog.numField(@"p_dn_ms", nDnMs, LIM_SMALL)
    lineEmit()
#endif

CON { --- L-stops (the analysis's L8) --- }

#ifdef SINGLE_PART_STOPS
PRI bRunStopsLeg() : bCompleted | nPowIdx, eKind, rotIdx, bGoOn
' L-stops: at +power then -power, at the top then at the crawl, each DAT stopTopTicks / stopCrawlTicks N by
' stopAfterRotation() and one stopAfterTime() (STOPS_TOP_MS / STOPS_CRAWL_MS), each armed at rest before its drive.
'
' @returns bCompleted - T/F where T means no guard ended the run

' Local Variables:
' @local nPowIdx - 0: +power, 1: -power
' @local eKind - KIND_TOP or KIND_CRAWL
' @local rotIdx - an N
' @local bGoOn - T/F where T means nothing has ended the run

    bGoOn := TRUE
    repeat nPowIdx from 0 to 1
        repeat eKind from KIND_TOP to KIND_CRAWL
            repeat rotIdx from 0 to STOPS_ROT_COUNT - 1
                if bGoOn
                    bGoOn := bStopRun(1 - 2 * nPowIdx, eKind, rotIdx, FALSE)
            if bGoOn
                bGoOn := bStopRun(1 - 2 * nPowIdx, eKind, 0, TRUE)
    bCompleted := bGoOn

PRI bStopRun(nPowSign, eKind, rotIdx, bByTime) : bGoOn | nPower, nTicks, nTimeMs, nEnc0, nPos0, nDeadline, eErr, nCmd, eSign, eRo, nFinal, nRestMs, bRingShort, eReason, nTravel, nDev, bJudged, instIdx, eOutcome, nZeroMs
' One limited drive, armed at rest: stopAfterRotation(N, DRU_HALL_TICKS) or stopAfterTime(T, DTU_MILLISEC), then
' driveAtPower() at the top or the crawl; wait, guarded, until isMoveDone(); the shaft's rest (restQuiet()); the stop
' reason. ROTATION: the encoder's travel from the arming less N x 60 counts. TIME: the shaft's rest instant less the
' deadline the library armed (testGetStopMs()), and the field's zero instant (the drive's own) less it. Judged when the
' drive ended SR_AT_LIMIT -- and, task 3686, when the limit never fired in STOPS_DRIVE_MAX_MS: then at the stop the
' harness makes, its DCS_STOPPED reading's count and time (a FAIL, never a NOMEAS). Emits B1-STOP at rest.
'
' @param nPowSign - +1 or -1
' @param eKind - KIND_TOP or KIND_CRAWL
' @param rotIdx - which N (rotation)
' @param bByTime - T/F where T means the time stop
' @returns bGoOn - T/F where T means nothing ended the run

' Local Variables:
' @local nPower - the power
' @local nTicks - N, hall ticks (rotation)
' @local nTimeMs - T, ms (time)
' @local nEnc0 - the count at the arming
' @local nPos0 - the driver's hall position then
' @local nDeadline - the time limit's deadline, getms()
' @local eErr - the library's answer
' @local nCmd - the increment it wrote
' @local eSign - its SIGN_*
' @local eRo - the drive's outcome
' @local nFinal - the count at rest
' @local nRestMs - the rest instant
' @local bRingShort - restQuiet()'s flag
' @local eReason - getStopReason()
' @local nTravel - the encoder's travel, counts, signed
' @local nDev - ROTATION: |travel| - N x 60; TIME: rest - deadline, ms
' @local bJudged - T/F where T means it ended SR_AT_LIMIT and rested
' @local instIdx - the cell's instance
' @local eOutcome - a reading's outcome
' @local nZeroMs - the field's zero instant, getms() (0 none)

    bGoOn := TRUE
    nPower := ((eKind == KIND_TOP) ? rowTopPower : STOPS_CRAWL_POWER) * nPowSign
    nTicks := (eKind == KIND_TOP) ? stopTopTicks[rotIdx] : stopCrawlTicks[rotIdx]
    nTimeMs := (eKind == KIND_TOP) ? STOPS_TOP_MS : STOPS_CRAWL_MS
    nDeadline := 0
    nCmd := 0
    nFinal := 0
    nRestMs := 0
    bRingShort := FALSE
    bJudged := FALSE
    nZeroMs := 0
    eErr := wheel.NO_ERROR
    eRo := RO_REFUSED
    sampleBegin()
    eOutcome := sampleNext()                                ' a reading at rest: the base
    bGoOn := (bGuardStops(eOutcome) == FALSE)
    nEnc0 := smpEnc
    nPos0 := smpPos
    if bGoOn
        if bByTime
            eErr := wheel.stopAfterTime(nTimeMs, wheel.DTU_MILLISEC)
            nDeadline := wheel.testGetStopMs()
        else
            eErr := wheel.stopAfterRotation(nTicks, wheel.DRU_HALL_TICKS)
        if eErr == wheel.NO_ERROR
            eErr := wheel.driveAtPower(nPower)
        if eErr == wheel.NO_ERROR
            nCmd, _, _, _, _, _ := wheel.testGetDriveFollow()
            bGoOn := bCheckTop(nCmd)                        ' past the row's top: the run ends, coasting
        else
            clearProtect()
    if bGoOn and (eErr == wheel.NO_ERROR)
        eRo, _ := waitPhase(UNTIL_MOVE_DONE, 0, STOPS_DRIVE_MAX_MS, FALSE)
        nZeroMs := smpZeroMs
        if eRo == RO_FAULT
            bGoOn := bFaultRecover()
        elseif eRo == RO_ABORTED
            bGoOn := FALSE
        elseif eRo == RO_TIMEOUT
            bGoOn, _ := bStopAndRest(FALSE)                 ' the limit never fired in its bound: recorded, stopped
            nFinal := smpEnc                                ' task 3686: judged at this stop's DCS_STOPPED reading
            nRestMs := smpMs
        else
            bGoOn, nFinal, nRestMs, bRingShort := restQuiet()
            if bGoOn
                waitms(LEG_REST_MS)
    eSign := signOfIncr((nCmd <> 0) ? nCmd : -nPowSign)    ' (a refused drive names no sign: power + is NEG on this motor)
    eReason := wheel.getStopReason()
    nTravel := nFinal - nEnc0
    bJudged := (eRo == RO_DONE) and (eReason == wheel.SR_AT_LIMIT)
    bJudged |= (eRo == RO_TIMEOUT) and bGoOn                ' task 3686: a limit that never fired is the cells' own negative
    instIdx := eSign * KIND_COUNT + eKind
    if bByTime
        nDev := nRestMs - nDeadline
        if bJudged
            if (sfTimeN[instIdx] == 0) or (abs(nDev) > abs(sfTimeDev[instIdx]))
                sfTimeDev[instIdx] := nDev
            sfTimeN[instIdx]++
    else
        nDev := abs(nTravel) - nTicks * ENC_COUNTS_PER_TICK
        if bJudged
            if (sfRotN[instIdx] == 0) or (abs(nDev) > abs(sfRotDev[instIdx]))
                sfRotDev[instIdx] := nDev
            sfRotN[instIdx]++
    benchLog.begin(@"B1-STOP")
    benchLog.tokenField(@"sign", (eSign == SIGN_NEG) ? @sSignNeg : @sSignPos, TOKMAX_SIGN)
    benchLog.tokenField(@"kind", (eKind == KIND_TOP) ? @sKindTop : @sKindCrawl, TOKMAX_SET)
    benchLog.tokenField(@"by", bByTime ? @sSfUnitsMs : @sSfUnitsCounts, TOKMAX_UNITS)
    benchLog.numField(@"limit", bByTime ? nTimeMs : nTicks, LIM_MID)
    benchLog.numField(@"power", nPower, LIM_TINY)
    benchLog.numField(@"lib_incr", nCmd, LIM_BIG)
    benchLog.numField(@"err", eErr, LIM_SMALL)
    benchLog.tokenField(@"outcome", roToken(eRo), TOKMAX_RO)
    benchLog.tokenField(@"reason", srToken(eReason), TOKMAX_SR)
    benchLog.numField(@"travel", nTravel, LIM_MID)
    benchLog.numField(@"pos_ticks", smpPos - nPos0, LIM_MID)
    benchLog.numField(@"dev", nDev, LIM_MID)
    benchLog.naNumField(@"field_dev_ms", nZeroMs - nDeadline, LIM_MID, bByTime and (nZeroMs <> 0) and (eRo == RO_DONE))
    benchLog.boolField(@"judged", bJudged)
    benchLog.boolField(@"ring_short", bRingShort)
    lineEmit()
#endif

CON { --- L-coast (the analysis's L1): the coast-down --- }

#ifdef SINGLE_PART_COAST
PRI bRunCoastLeg() : bCompleted | eMode0, nBrake0, eErr, eSign, pctIdx, bGoOn, bRestored
' L-coast: at a DAT rowL13 row, the fault response set to FR_SHIPPED with the bridge floated at rest (holdAtStop(FALSE)),
' so the guarded testForceFault() (STEPHEN 2026-09-28, "fp1: A") floats the bridge; each sign NEG then POS, each DAT
' speedPcts speed: steady, the fault, the coast at 2 kHz to rest (bCoastOnce()). The fault response in force before the
' leg is restored on its one exit, whatever ended it, and read back (bRestoreFaultResponse()). At another row nothing
' drives (B1-LEGSKIP).
'
' @returns bCompleted - T/F where T means no guard ended the run and the fault response was restored

' Local Variables:
' @local eMode0 - the fault response in force before the leg
' @local nBrake0 - its brake share, %
' @local eErr - setFaultResponse()'s result
' @local eSign - SIGN_NEG or SIGN_POS
' @local pctIdx - a speed of DAT speedPcts
' @local bGoOn - T/F where T means nothing has ended the run
' @local bRestored - T/F where T means the fault response read back as it was

    bGoOn := TRUE
    if rowL13[rowIdx] == FALSE
        emitLegSkip(@sLegCoast)
    else
        repeat eSign from SIGN_NEG to SIGN_POS
            bSfCoastMeas[eSign] := FALSE
        eMode0, nBrake0 := wheel.getFaultResponse()
        wheel.holdAtStop(FALSE)                             ' FR_SHIPPED coasts only with the hold off (a hold would short the phases)
        eErr := wheel.setFaultResponse(wheel.FR_SHIPPED, 0)
        if eErr <> wheel.NO_ERROR
            bGoOn := FALSE
            setAbort(AR_SETTING, eErr)
        repeat eSign from SIGN_NEG to SIGN_POS
            repeat pctIdx from 0 to SPEED_PCT_COUNT - 1
                if bGoOn
                    bGoOn := bCoastOnce(eSign, pctIdx)
        bRestored := bRestoreFaultResponse(eMode0, nBrake0) ' the leg's one exit: whatever ended it
        bGoOn := bGoOn and bRestored
    bCompleted := bGoOn

PRI bRestoreFaultResponse(eMode0, nBrake0) : bRestored | eErr, eMode, nBrake
' Put back the fault response L-coast found, read it back, and emit B1-FLTREST. A restore that does not take ends the
' run (AR_SETTING): every later leg recovers faults on the default response. After a guard stopped the motor the
' request is refused (the next start() restores the default); that is recorded and the run has already ended.
'
' @param eMode0 - the fault response to restore
' @param nBrake0 - its brake share, %
' @returns bRestored - T/F where T means it reads back as it was

' Local Variables:
' @local eErr - setFaultResponse()'s result
' @local eMode - the response read back
' @local nBrake - its brake share read back

    eErr := wheel.setFaultResponse(eMode0, nBrake0)
    eMode, nBrake := wheel.getFaultResponse()
    bRestored := (eErr == wheel.NO_ERROR) and (eMode == eMode0) and (nBrake == nBrake0)
    benchLog.begin(@"B1-FLTREST")
    benchLog.numField(@"mode", eMode, LIM_TINY)
    benchLog.numField(@"brake_pct", nBrake, LIM_TINY)
    benchLog.numField(@"want_mode", eMode0, LIM_TINY)
    benchLog.numField(@"want_brake", nBrake0, LIM_TINY)
    benchLog.numField(@"err", eErr, LIM_SMALL)
    benchLog.boolField(@"restored", bRestored)
    lineEmit()
    if bRestored == FALSE
        setAbort(AR_SETTING, (eErr <> wheel.NO_ERROR) ? eErr : -1)

PRI bCoastOnce(eSign, pctIdx) : bGoOn | nIncr, nEmfMv, nWholeMs, eRo, eRo2, nArrMs, bWok, nWdev, bSteady, nFolPm, eOutcome
' One coast: from rest to the speed by the test path, arrived, LADDER_SETTLE_MS, the COAST_STEADY_MS window (the speed it
' coasts from, the DC link, duty), then the fault and the coast (bCoastMeasure()). A speed whose back-EMF reaches
' COAST_EMF_MAX_PM of the told supply is SKIPPED (the regen guard). Emits B1-COAST at rest; bCoastMeasure() its own.
'
' @param eSign - SIGN_NEG or SIGN_POS
' @param pctIdx - the speed, of DAT speedPcts
' @returns bGoOn - T/F where T means nothing ended the run

' Local Variables:
' @local nIncr - the speed's increment, signed
' @local nEmfMv - the motor's back-EMF at it, line-to-line peak, mV (the sheet's Ke)
' @local nWholeMs - the generator's time to it from rest
' @local eRo - the arrival's outcome (RO_SKIPPED / RO_REFUSED before any drive)
' @local eRo2 - the settle's and the steady window's
' @local nArrMs - ms to arrive (-1 none)
' @local bWok - the steady window's encoder check
' @local nWdev - its deviation (-1 not judged)
' @local bSteady - T/F where T means the steady window ran, encoder-checked
' @local nFolPm - its following, per mille
' @local eOutcome - a reading's outcome

    bGoOn := TRUE
    bSteady := FALSE
    nArrMs := -1
    nWdev := -1
    nFolPm := 0
    eRo2 := RO_NOT_RUN
    winCpsX10 := 0
    winDcMa := 0
    winDutySum := 0
    winN := 0
    winPosSpan := 0
    nIncr := speedIncr(pctIdx, eSign)
    nEmfMv := muldiv64(cmdCpsX1000(nIncr), KE_MV_PER_KRPM * 60, ENC_COUNTS_PER_REV * US_PER_S)
    _, nWholeMs := scurveMs(abs(nIncr), rampAccelUp, rampJerkUp, 0)
    if nEmfMv * PM >= COAST_EMF_MAX_PM * TOLD_MV
        eRo := RO_SKIPPED                                   ' the regen guard: never floated at this speed
    else
        sampleBegin()
        eOutcome := sampleNext()                            ' a reading at rest: the sampler's base
        if bGuardStops(eOutcome)
            eRo := RO_ABORTED
        elseif wheel.testDriveAtMotorIncrement(nIncr) <> wheel.NO_ERROR
            eRo := RO_REFUSED
            clearProtect()
        else
            eRo, nArrMs := waitPhase(UNTIL_ARRIVED, nIncr, 2 * nWholeMs + ARRIVE_MARGIN_MS, FALSE)
            if eRo <> RO_DONE
                nArrMs := -1
            eRo2 := eRo
            if (eRo == RO_DONE) or (eRo == RO_TIMEOUT)
                eRo2, _ := waitPhase(UNTIL_ELAPSED, 0, LADDER_SETTLE_MS, FALSE)
                if eRo2 == RO_DONE
                    windowBegin()
                    eRo2, _ := waitPhase(UNTIL_ELAPSED, 0, COAST_STEADY_MS, TRUE)
                    windowEnd()
            if eRo2 == RO_DONE
                bWok, nWdev := bWindowEncOk()
                nFolPm := followPm(winCpsX10, nIncr)
                bSteady := bWok
                if bWok
                    bGoOn := bCoastMeasure(eSign, pctIdx, (eRo == RO_DONE) and (abs(nFolPm - PM) <= FOLLOW_TOL_PM))
                else
                    bGoOn := FALSE                          ' the encoder disagreed: bWindowEncOk() coasted the motor, ended the run
            elseif eRo2 == RO_FAULT
                bGoOn := bFaultRecover()                    ' a fault of the drive's own on the way: a finding
            else
                bGoOn := FALSE
    if eRo == RO_ABORTED                                    ' a guard ended the run before the drive (it coasted the motor)
        bGoOn := FALSE
    benchLog.begin(@"B1-COAST")
    benchLog.tokenField(@"sign", signToken(eSign), TOKMAX_SIGN)
    benchLog.numField(@"pct", speedPcts[pctIdx], LIM_TINY)
    benchLog.numField(@"incr", nIncr, LIM_BIG)
    benchLog.numField(@"emf_mv", nEmfMv, LIM_MID)
    benchLog.tokenField(@"outcome", roToken(eRo2 <> RO_NOT_RUN ? eRo2 : eRo), TOKMAX_RO)
    benchLog.naNumField(@"arr_ms", nArrMs, LIM_SMALL, nArrMs >= 0)
    benchLog.naNumField(@"cps_x10", winCpsX10, LIM_MID, bSteady)
    benchLog.naNumField(@"fol_pm", nFolPm, LIM_SMALL, bSteady)
    benchLog.naNumField(@"duty", divRound(winDutySum, winN #> 1), LIM_MID, bSteady)
    benchLog.naNumField(@"dc_ma", winDcMa, LIM_MID, bSteady)
    benchLog.tokenField(@"dir", directionToken(winPosSpan), TOKMAX_DIR)
    benchLog.naNumField(@"wchk", nWdev, LIM_SMALL, nWdev >= 0)
    lineEmit()

PRI bCoastMeasure(eSign, pctIdx, bAtSpeed) : bGoOn | nStepCt, nCt0, nNextCt, nDct, nCnt, eState, idx, nFaultIdx, nFaultDct, nFaultCnt, nRefCnt, nQuietIdx, nQuietDct, bStateOk, bAtRest, bCleared, bHold, eErr, eOutcome, nQuietCt, nWaitCt, nFaultWaitCt
' The fault and the coast, from the steady speed: the guarded testForceFault(), then a reading every COAST_SAMPLE_US of
' the encoder's count and the driver's state, stored, until the shaft has stayed within REST_JITTER_COUNTS for
' REST_QUIET_MS (bounded by COAST_WAIT_MAX_MS, and by COAST_FAULT_WAIT_MS for the fault to be read); the run's guards
' every SAMPLE_MS between readings. Then the recovery (bFaultRecover(): testResetFault(), a protective stop cleared), and
' at rest B1-COASTF and the readings (emitCoastPoints()). Feeds R23-SGL-COAST from the 100 % speed.
'
' @param eSign - SIGN_NEG or SIGN_POS
' @param pctIdx - the speed, of DAT speedPcts
' @param bAtSpeed - T/F where T means the steady window arrived and followed the command (the cell's bound is for it)
' @returns bGoOn - T/F where T means nothing ended the run

' Local Variables:
' @local nStepCt - COAST_SAMPLE_US in system ticks
' @local nCt0 - getct() before testForceFault(): every reading's time is counted from it
' @local nNextCt - getct() of the next reading
' @local nDct - this reading's getct() less nCt0
' @local nCnt - this reading's encoder count
' @local eState - this reading's driver state
' @local idx - this reading's index
' @local nFaultIdx - the first reading of DCS_FAULTED (-1 none yet)
' @local nFaultDct - its time, clocks from the request
' @local nFaultCnt - its count
' @local nRefCnt - the count the quiet is measured against
' @local nQuietIdx - the reading at which the count last moved past REST_JITTER_COUNTS: the rest instant
' @local nQuietDct - its time, clocks from the request (kept apart from the store, which may have filled)
' @local bStateOk - T/F where T means every reading from the fault on read DCS_FAULTED
' @local bAtRest - T/F where T means the shaft rested in its bound
' @local bCleared - T/F where T means the recovery cleared the fault
' @local bHold - T/F where T means the hold at rest was on at the fault (it must be off: FR_SHIPPED would short the phases)
' @local eErr - testForceFault()'s result
' @local eOutcome - a guard reading's outcome
' @local nQuietCt - REST_QUIET_MS in system ticks
' @local nWaitCt - COAST_WAIT_MAX_MS in system ticks
' @local nFaultWaitCt - COAST_FAULT_WAIT_MS in system ticks

    bGoOn := TRUE
    bAtRest := FALSE
    bCleared := FALSE
    bStateOk := TRUE
    nFaultIdx := -1
    nFaultDct := 0
    nFaultCnt := 0
    nQuietIdx := 0
    nQuietDct := 0
    coastN := 0
    nStepCt := muldiv64(clkfreq, COAST_SAMPLE_US, US_PER_S)
    nQuietCt := muldiv64(clkfreq, REST_QUIET_MS, wheel.MS_PER_SEC)
    nWaitCt := muldiv64(clkfreq, COAST_WAIT_MAX_MS, wheel.MS_PER_SEC)    ' 1.05e9 at 350 MHz: under 2^31
    nFaultWaitCt := muldiv64(clkfreq, COAST_FAULT_WAIT_MS, wheel.MS_PER_SEC)
    bHold := wheel.isHoldAtStop()
    nRefCnt := enc.readCount()
    nCt0 := getct()
    eErr := wheel.testForceFault()
    nNextCt := nCt0
    repeat
        repeat until getct() - nNextCt >= 0
        if getct() - nNextCt >= nStepCt                     ' late (a guard reading ran long): taken now, re-anchored
            nNextCt := getct()
        nNextCt += nStepCt
        nCnt := enc.readCount()
        nDct := getct() - nCt0
        eState := wheel.getDriverState()
        idx := coastN
        if idx < COAST_MAX_SAMPLES
            coastEnc[idx] := nCnt
            coastDct[idx] := nDct
        coastN++
        if abs(nCnt - nRefCnt) > REST_JITTER_COUNTS
            nRefCnt := nCnt
            nQuietIdx := idx
            nQuietDct := nDct
        if nFaultIdx < 0
            if eState == wheel.DCS_FAULTED
                nFaultIdx := idx
                nFaultDct := nDct
                nFaultCnt := nCnt
                nRefCnt := nCnt                             ' the quiet is judged from the fault on
                nQuietIdx := idx
                nQuietDct := nDct
            elseif nDct >= nFaultWaitCt
                quit                                        ' the fault never came: the motor is still driven
        elseif eState <> wheel.DCS_FAULTED
            bStateOk := FALSE                               ' something drove or re-synced the bridge
        if (nFaultIdx >= 0) and (nDct - nQuietDct >= nQuietCt)
            bAtRest := TRUE
            quit
        if nDct >= nWaitCt
            quit
        if getct() - smpNextCt >= 0                         ' the run's guards, between readings (never waiting)
            eOutcome := sampleNext()
            if bGuardStops(eOutcome)
                bGoOn := FALSE
                quit
    if bGoOn
        if nFaultIdx >= 0
            bGoOn := bFaultRecover()                        ' testResetFault(), a protective stop cleared, LEG_REST_MS
            bCleared := bGoOn and (wheel.isFaultSignal() == FALSE) and wheel.isStopped()
        else
            bGoOn, _ := bStopAndRest(TRUE)                  ' the request was dropped: stopped on the ramp
    if (pctIdx == SPEED_TOP_IDX) and bAtSpeed and (nFaultIdx >= 0) and bStateOk and bCleared and (eErr == wheel.NO_ERROR) and (bHold == FALSE)
        bSfCoastMeas[eSign] := TRUE
        sfCoastMs[eSign] := COAST_WAIT_MAX_MS               ' still turning at the bound: at least this long (a FAIL, not a NOMEAS)
        if bAtRest
            sfCoastMs[eSign] := divRound(muldiv64(nQuietDct - nFaultDct, US_PER_S, clkfreq), wheel.MS_PER_SEC)
    benchLog.begin(@"B1-COASTF")
    benchLog.tokenField(@"sign", signToken(eSign), TOKMAX_SIGN)
    benchLog.numField(@"pct", speedPcts[pctIdx], LIM_TINY)
    benchLog.numField(@"err", eErr, LIM_SMALL)
    benchLog.boolField(@"hold", bHold)
    benchLog.boolField(@"faulted", nFaultIdx >= 0)
    benchLog.naNumField(@"fault_us", muldiv64(nFaultDct, US_PER_S, clkfreq), LIM_BIG, nFaultIdx >= 0)
    benchLog.naNumField(@"coast_us", muldiv64(nQuietDct - nFaultDct, US_PER_S, clkfreq), LIM_BIG, (nFaultIdx >= 0) and bAtRest)
    benchLog.naNumField(@"travel", nRefCnt - nFaultCnt, LIM_MID, (nFaultIdx >= 0) and bAtRest)
    benchLog.boolField(@"state_ok", bStateOk)
    benchLog.boolField(@"at_rest", bAtRest)
    benchLog.boolField(@"cleared", bCleared)
    benchLog.numField(@"n", coastN, LIM_SMALL)
    benchLog.boolField(@"trunc", coastN > COAST_MAX_SAMPLES)
    benchLog.numField(@"step_us", COAST_SAMPLE_US, LIM_SMALL)
    lineEmit()
    if nFaultIdx >= 0
        emitCoastPoints(eSign, pctIdx, nFaultIdx, (bAtRest) ? nQuietIdx : (coastN - 1))

PRI coastDctAt(idx) : nDct
' A stored coast reading's time, clocks from the fault request; past the store, the last one stored.
'
' @param idx - the reading
' @returns nDct - its getct() less the one before testForceFault()

    nDct := coastDct[(idx #> 0) <# (COAST_MAX_SAMPLES - 1)]

PRI coastEncAt(idx) : nCnt
' A stored coast reading's encoder count; past the store, the last one stored.
'
' @param idx - the reading
' @returns nCnt - its count

    nCnt := coastEnc[(idx #> 0) <# (COAST_MAX_SAMPLES - 1)]

PRI emitCoastPoints(eSign, pctIdx, nFirstIdx, nLastIdx) | idx, nEnd, nStepCnt, nLastCnt, nLastDct, nGapCt
' Emit B1-COASTPT for the coast's readings from the fault to rest: the first and the last, and between them each one
' the shaft has moved 1 / COAST_PTS_MAX of the coast's travel past the last printed, or COAST_EMIT_GAP_MS after it --
' the position against time the offline fit of Tc / J and Bv / J reads (dw/dt = -(Tc + Bv w) / J). At rest.
'
' @param eSign - SIGN_NEG or SIGN_POS
' @param pctIdx - the speed, of DAT speedPcts
' @param nFirstIdx - the fault's reading
' @param nLastIdx - the rest's reading (or the last taken, when the shaft did not rest)

' Local Variables:
' @local idx - a reading
' @local nEnd - the last stored reading to print
' @local nStepCnt - the travel between printed readings, counts
' @local nLastCnt - the last printed reading's count
' @local nLastDct - its time, clocks
' @local nGapCt - COAST_EMIT_GAP_MS in system ticks

    nEnd := nLastIdx <# (COAST_MAX_SAMPLES - 1)
    nStepCnt := (abs(coastEncAt(nEnd) - coastEncAt(nFirstIdx)) / COAST_PTS_MAX) #> 1
    nGapCt := muldiv64(clkfreq, COAST_EMIT_GAP_MS, wheel.MS_PER_SEC)
    nLastCnt := coastEncAt(nFirstIdx)
    nLastDct := coastDctAt(nFirstIdx)
    idx := nFirstIdx
    repeat while idx <= nEnd
        if (idx == nFirstIdx) or (idx == nEnd) or (abs(coastEnc[idx] - nLastCnt) >= nStepCnt) or (coastDct[idx] - nLastDct >= nGapCt)
            benchLog.begin(@"B1-COASTPT")
            benchLog.tokenField(@"sign", signToken(eSign), TOKMAX_SIGN)
            benchLog.numField(@"pct", speedPcts[pctIdx], LIM_TINY)
            benchLog.numField(@"i", idx - nFirstIdx, LIM_SMALL)
            benchLog.numField(@"t_us", muldiv64(coastDct[idx] - coastDctAt(nFirstIdx), US_PER_S, clkfreq), LIM_BIG)
            benchLog.numField(@"enc", coastEnc[idx] - coastEncAt(nFirstIdx), LIM_MID)
            lineEmit()
            nLastCnt := coastEnc[idx]
            nLastDct := coastDct[idx]
        idx++
#endif

CON { --- L-offscan (the analysis's L3): the offset scan, the lead check, the hall zero at speed --- }

#ifdef SINGLE_PART_OFFSCAN
PRI bRunOffScan() : bCompleted | eSign, pctIdx, bGoOn, bRestored
' L-offscan: at a DAT rowL13 row, the shipped pair read first; each sign NEG then POS, each DAT speedPcts speed: the
' offset that sign uses stepped over +-OFS_SPAN_DEG of the shipped one, a side at a time (bOfsSpeed()). The shipped pair
' is restored on the leg's one exit, whatever ended it, and read back (bRestoreOffsets()); then the pairs per speed and
' the lead check (ofsFinish()). At another row nothing drives (B1-LEGSKIP).
'
' @returns bCompleted - T/F where T means no guard ended the run and the shipped pair was restored

' Local Variables:
' @local eSign - SIGN_NEG or SIGN_POS
' @local pctIdx - a speed of DAT speedPcts
' @local bGoOn - T/F where T means nothing has ended the run
' @local bRestored - T/F where T means the shipped pair read back

    bGoOn := TRUE
    if rowL13[rowIdx] == FALSE
        emitLegSkip(@sLegOffscan)
    else
        ofsShipFwd, ofsShipRev := wheel.testGetFwdRevIndep()
        repeat pctIdx from 0 to OFS_SPEED_SLOTS - 1
            bOfRes[pctIdx] := FALSE
            ofVertX10[pctIdx] := 0
            bOfDuRes[pctIdx] := FALSE
            ofDuVertX10[pctIdx] := 0
            ofZCnt[pctIdx] := 0
            ofZx10[pctIdx] := 0
            ofZTicks[pctIdx] := 0
        repeat eSign from SIGN_NEG to SIGN_POS
            repeat pctIdx from 0 to SPEED_PCT_COUNT - 1
                if bGoOn
                    bGoOn := bOfsSpeed(eSign, pctIdx)
        bRestored := bRestoreOffsets()                      ' the leg's one exit: whatever ended it
        bGoOn := bGoOn and bRestored
        ofsFinish()
    bCompleted := bGoOn

PRI bRestoreOffsets() : bRestored | nFwd, nRev
' Put back the shipped pair (testSetFwdRevIndep() writes it whether or not the motor runs), read it back, and emit
' B1-OFSREST. A pair that does not read back ends the run (AR_SETTING): every later leg runs on the shipped tables.
'
' @returns bRestored - T/F where T means it reads back as shipped

' Local Variables:
' @local nFwd - the offset read back for negative increments, degrees
' @local nRev - the offset read back for positive increments, degrees

    wheel.testSetFwdRevIndep(ofsShipFwd, ofsShipRev)
    nFwd, nRev := wheel.testGetFwdRevIndep()
    bRestored := (nFwd == ofsShipFwd) and (nRev == ofsShipRev)
    benchLog.begin(@"B1-OFSREST")
    benchLog.numField(@"fwd", nFwd, LIM_SMALL)
    benchLog.numField(@"rev", nRev, LIM_SMALL)
    benchLog.numField(@"ship_fwd", ofsShipFwd, LIM_SMALL)
    benchLog.numField(@"ship_rev", ofsShipRev, LIM_SMALL)
    benchLog.boolField(@"restored", bRestored)
    lineEmit()
    if bRestored == FALSE
        setAbort(AR_SETTING, -1)

PRI applyOffset(eSign, nD) : nApplied | nFwd, nRev
' Set the offset {eSign} uses to the shipped one plus {nD} degrees, the other sign's left shipped (offset_fwd serves
' negative increments, offset_rev positive: testSetFwdRevIndep()), and read back what the driver applies.
'
' @param eSign - SIGN_NEG or SIGN_POS
' @param nD - degrees from the shipped offset
' @returns nApplied - the offset that sign now uses, degrees (0..359)

' Local Variables:
' @local nFwd - the pair read back: negative increments
' @local nRev - positive increments

    if eSign == SIGN_NEG
        wheel.testSetFwdRevIndep(ofsShipFwd + nD, ofsShipRev)
    else
        wheel.testSetFwdRevIndep(ofsShipFwd, ofsShipRev + nD)
    nFwd, nRev := wheel.testGetFwdRevIndep()
    nApplied := (eSign == SIGN_NEG) ? nFwd : nRev

PRI bOfsSpeed(eSign, pctIdx) : bGoOn | slotIdx, eSide, nRefMa, nRefDrift, bDcOk, nDcVx10, nDcVse, nDcTx10, nDcPts, nDcRms, bDuOk, nDuVx10, nDuVse, nDuTx10, nDuPts, nDuRms, spIdx
' One sign at one speed: both sides (bOfsSide()), the hall zero at speed over every window, then at rest every point's
' records, the two fits (ofsFit(): the DC link, the duty) and B1-OFSFIT / B1-OFSZ.
'
' @param eSign - SIGN_NEG or SIGN_POS
' @param pctIdx - the speed, of DAT speedPcts
' @returns bGoOn - T/F where T means nothing ended the run

' Local Variables:
' @local slotIdx - a point's slot
' @local eSide - SIDE_PLUS or SIDE_MINUS
' @local nRefMa - the PLUS side's reference DC link (its shipped point), mA (-1 none)
' @local nRefDrift - the MINUS side's reference less the PLUS side's, mA
' @local bDcOk - the DC-link fit resolved
' @local nDcVx10 - its vertex, degrees x10 from the shipped offset
' @local nDcVse - the vertex's standard error, degrees x10
' @local nDcTx10 - its curvature's significance, standard errors x10
' @local nDcPts - its points
' @local nDcRms - its rms residual, x10
' @local bDuOk - the duty fit resolved
' @local nDuVx10 - its vertex
' @local nDuVse - the vertex's standard error
' @local nDuTx10 - its significance
' @local nDuPts - its points
' @local nDuRms - its rms residual, x10
' @local spIdx - the sign and speed's fit slot

    bGoOn := TRUE
    spIdx := eSign * SPEED_PCT_COUNT + pctIdx
    repeat slotIdx from 0 to OFS_POINTS - 1
        opOutcome[slotIdx] := RO_NOT_RUN
        opD[slotIdx] := 0
        opDeg[slotIdx] := 0
        bOpClean[slotIdx] := FALSE
        opWchk[slotIdx] := -1
    zBegin()
    repeat eSide from SIDE_PLUS to SIDE_MINUS
        if bGoOn
            bGoOn := bOfsSide(eSign, pctIdx, eSide)
    ofZx10[spIdx] := zNowX10()
    ofZCnt[spIdx] := zCntS
    ofZTicks[spIdx] := zTicksS
    repeat slotIdx from 0 to OFS_POINTS - 1
        if opOutcome[slotIdx] <> RO_NOT_RUN
            emitOfsPoint(eSign, pctIdx, slotIdx)
    bDcOk, nDcVx10, nDcVse, nDcTx10, nDcPts, nDcRms := ofsFit(FITQ_DC)
    bDuOk, nDuVx10, nDuVse, nDuTx10, nDuPts, nDuRms := ofsFit(FITQ_DUTY)
    bOfRes[spIdx] := bDcOk
    ofVertX10[spIdx] := nDcVx10
    bOfDuRes[spIdx] := bDuOk                                ' phase 2c: kept beside it (arbiter decision D9)
    ofDuVertX10[spIdx] := nDuVx10
    nRefMa := -1
    nRefDrift := 0
    if (opOutcome[0] == RO_DONE) and (opOutcome[OFS_SIDE_POINTS] == RO_DONE)
        nRefMa := opDcMa[0]
        nRefDrift := opDcMa[OFS_SIDE_POINTS] - opDcMa[0]
    emitOfsFit(eSign, pctIdx, FITQ_DC, bDcOk, nDcVx10, nDcVse, nDcTx10, nDcPts, nDcRms, nRefMa, nRefDrift)
    emitOfsFit(eSign, pctIdx, FITQ_DUTY, bDuOk, nDuVx10, nDuVse, nDuTx10, nDuPts, nDuRms, nRefMa, nRefDrift)
    benchLog.begin(@"B1-OFSZ")
    benchLog.tokenField(@"sign", signToken(eSign), TOKMAX_SIGN)
    benchLog.numField(@"pct", speedPcts[pctIdx], LIM_TINY)
    benchLog.tokenField(@"dir", directionToken(zTicksS), TOKMAX_DIR)
    benchLog.naNumField(@"z_x10", ofZx10[spIdx], LIM_SMALL, zCntS > 0)
    benchLog.numField(@"edges", zCntS, LIM_MID)
    benchLog.numField(@"bad", zBadS, LIM_SMALL)
    benchLog.numField(@"lost", zLostS, LIM_MID)
    lineEmit()

PRI bOfsSide(eSign, pctIdx, eSide) : bGoOn | nIncr, nWholeMs, eUp, ptIdx, slotIdx, nD, nLimitMa, bEnded, bResting, bNamed, bWok, nWdev, eOutcome
' One side of the shipped offset at one speed: at rest the shipped pair, from rest to the speed by the test path, then
' each point outward (the shipped one first: the side's reference) -- the offset applied while driven, a step of
' OFS_STEP_DEG -- measured by ofsPoint(); a point that faults or meets the current wall ends the side (the points past
' it SKIPPED), as the scan's walk ends at its wall. Then stopped on the ramp and, at rest, the shipped pair again.
'
' @param eSign - SIGN_NEG or SIGN_POS
' @param pctIdx - the speed, of DAT speedPcts
' @param eSide - SIDE_PLUS or SIDE_MINUS
' @returns bGoOn - T/F where T means nothing ended the run

' Local Variables:
' @local nIncr - the speed's increment, signed
' @local nWholeMs - the generator's time to it from rest
' @local eUp - the way up's outcome: RO_DONE (arrived, or not in its bound: the points say how far it follows),
'              RO_REFUSED, RO_FAULT or RO_ABORTED
' @local ptIdx - the point within the side, 0 = shipped
' @local slotIdx - its slot
' @local nD - its degrees from the shipped offset
' @local nLimitMa - the point abort's relative threshold, mA (0 until the reference is measured)
' @local bEnded - T/F where T means the side has ended (a wall, a fault)
' @local bResting - T/F where T means the motor already rests (a refusal, or a fault's recovery, left it there)
' @local bNamed - T/F where T means a failed way up has been named on the side's first point
' @local bWok - a window's encoder check
' @local nWdev - its deviation
' @local eOutcome - a reading's outcome

    bGoOn := TRUE
    bEnded := FALSE
    bResting := FALSE
    bNamed := FALSE
    nLimitMa := 0
    nIncr := speedIncr(pctIdx, eSign)
    _, nWholeMs := scurveMs(abs(nIncr), rampAccelUp, rampJerkUp, 0)
    applyOffset(eSign, 0)                                   ' at rest: the shipped pair
    sampleBegin()
    eOutcome := sampleNext()
    eUp := RO_DONE
    if bGuardStops(eOutcome)
        eUp := RO_ABORTED
    elseif wheel.testDriveAtMotorIncrement(nIncr) <> wheel.NO_ERROR
        eUp := RO_REFUSED
        clearProtect()
        bResting := TRUE
    else
        eUp, _ := waitPhase(UNTIL_ARRIVED, nIncr, 2 * nWholeMs + ARRIVE_MARGIN_MS, FALSE)
        if eUp == RO_TIMEOUT
            eUp := RO_DONE                                  ' not AT_SPEED in its bound: the points say how far it follows
    if eUp == RO_FAULT
        bGoOn := bFaultRecover()                            ' a fault on the way up: a finding
        bResting := TRUE
    elseif eUp == RO_ABORTED
        bGoOn := FALSE                                      ' a guard ended the run (it coasted the motor)
    repeat ptIdx from 0 to OFS_SIDE_POINTS - 1
        slotIdx := eSide * OFS_SIDE_POINTS + ptIdx
        nD := ptIdx * OFS_STEP_DEG
        if eSide == SIDE_MINUS
            nD := -nD
        opD[slotIdx] := nD
        if bGoOn and (bEnded == FALSE) and (eUp == RO_DONE)
            opDeg[slotIdx] := applyOffset(eSign, nD)
            opOutcome[slotIdx] := ofsPoint(slotIdx, nIncr, nLimitMa)
            case opOutcome[slotIdx]
                RO_DONE:
                    bWok, nWdev := bWindowEncOk()
                    opWchk[slotIdx] := nWdev
                    if bWok == FALSE
                        bGoOn := FALSE                      ' bWindowEncOk() coasted the motor and ended the run
                    elseif ptIdx == 0                       ' the side's reference: the relative abort from here on
                        nLimitMa := ((opDcMa[slotIdx] #> 0) * OFS_POINT_X100 / X100 #> OFS_POINT_FLOOR_MA) <# OFS_CEIL_MA
                RO_WALL:
                    bEnded := TRUE
                RO_FAULT:
                    bEnded := TRUE
                    bGoOn := bFaultRecover()
                    bResting := TRUE
                other:
                    bGoOn := FALSE                          ' a guard ended the run (it coasted the motor)
        elseif bGoOn
            if (eUp == RO_DONE) or bNamed
                opOutcome[slotIdx] := RO_SKIPPED
            else
                opOutcome[slotIdx] := eUp                   ' the side never reached its speed: why, on its first point
                bNamed := TRUE
    if bGoOn and (bResting == FALSE)
        bGoOn, _ := bStopAndRest(TRUE)
    applyOffset(eSign, 0)                                   ' at rest (or stopped): the shipped pair again

PRI ofsPoint(slotIdx, nIncr, nLimitMa) : eRo | nResync0, nResync1, nOver, nCeil, nNetMa, nStartMs, eOutcome, bWinRan, nLost0
' One point, its offset just applied: OFS_SETTLE_MS, then OFS_WINDOW_MS with every reading in the window and every
' captured edge in the hall zero at speed; the point abort (the scan's, in mA through the detected board) watched at each
' reading. Keeps the window as the point's readings (as far as it ran, for a wall or a fault inside it); a point that
' ended in its settle keeps none (zeros, and not clean).
'
' @param slotIdx - the point's slot
' @param nIncr - the speed's increment, signed
' @param nLimitMa - the relative threshold, mA (0: not yet, the reference point itself)
' @returns eRo - RO_DONE, RO_WALL, RO_FAULT or RO_ABORTED

' Local Variables:
' @local nResync0 - re-synced faults before the point
' @local nResync1 - after it
' @local nOver - consecutive readings over the relative threshold
' @local nCeil - consecutive readings over OFS_CEIL_MA
' @local nNetMa - a reading's DC link, mA
' @local nStartMs - the window's start, getms()
' @local eOutcome - a reading's outcome
' @local bWinRan - T/F where T means the window was opened (its readings are this point's)
' @local nLost0 - the encoder object's lost edges when the window opened

    _, _, nResync0 := wheel.testGetFaultResponse()
    nOver := 0
    nCeil := 0
    bWinRan := FALSE
    eRo, _ := waitPhase(UNTIL_ELAPSED, 0, OFS_SETTLE_MS, FALSE)
    if eRo == RO_DONE
        bWinRan := TRUE
        drainEdges()                                        ' only the window's edges go into the zero
        nLost0 := enc.edgesLost()                           ' (the drain counts the settle's overwritten edges: not the window's)
        bSmpZ := TRUE
        windowBegin()
        nStartMs := smpMs
        repeat
            eOutcome := sampleNext()
            windowAdd()
            if eOutcome == BO_FAULT
                eRo := RO_FAULT
                quit
            if bGuardStops(eOutcome)
                eRo := RO_ABORTED
                quit
            nNetMa := netMilliamps(smpSenseMv)
            nCeil := (nNetMa >= OFS_CEIL_MA) ? nCeil + 1 : 0
            nOver := ((nLimitMa > 0) and (nNetMa > nLimitMa)) ? nOver + 1 : 0
            if (nCeil >= ABS_ABORT_SAMPLES) or (nOver >= OFS_POINT_SAMPLES)
                eRo := RO_WALL
                quit
            if smpMs - nStartMs >= OFS_WINDOW_MS
                quit
        bSmpZ := FALSE
        zLostS += enc.edgesLost() - nLost0
        windowEnd()
    else
        winMs := winCpsX10 := winDutySum := winN := winAbsErrSum := winErrPeak := 0
        winLagD := winCapD := winFoldD := winDcMa := 0
    _, _, nResync1 := wheel.testGetFaultResponse()
    opWinMs[slotIdx] := winMs
    opCpsX10[slotIdx] := winCpsX10
    opFolPm[slotIdx] := followPm(winCpsX10, nIncr)
    opDuty[slotIdx] := divRound(winDutySum, winN #> 1)
    opDutyLo[slotIdx] := (winN > 0) ? winDutyMin : 0
    opDutyHi[slotIdx] := (winN > 0) ? winDutyMax : 0
    opErrX10[slotIdx] := divRound(winAbsErrSum * X10, winN #> 1)
    opErrPk[slotIdx] := winErrPeak
    opHeld[slotIdx] := winLagD
    opCapped[slotIdx] := winCapD
    opFolds[slotIdx] := winFoldD
    opResyncs[slotIdx] := nResync1 - nResync0
    opDcMa[slotIdx] := winDcMa
    opN[slotIdx] := winN
    bOpClean[slotIdx] := bWinRan and (eRo == RO_DONE) and (opResyncs[slotIdx] == 0) and (abs(opFolPm[slotIdx] - PM) <= FOLLOW_TOL_PM)

PRI ofsFit(eQuantity) : bResolved, nVertX10, nVseX10, nTx10, nPts, nRmsX10 | slotIdx, fU, fY, fS0, fS1, fS2, fS3, fS4, fT0, fT1, fT2, fDet, fA, fB, fC, fSsr, fResVar, fCaa, fCbb, fCab, fSeA, fVert, fVse
' The parabola y = a u^2 + b u + c through the speed's clean points, u = degrees from the shipped offset / 10, y the DC
' link (mA) or the duty: least squares by its normal equations (Cramer's rule, in float); its vertex v = -b / 2a; the
' vertex's standard error, s^2 / 4a^2 x (Cbb + (b/a)^2 Caa - 2 (b/a) Cab) by the delta method, s^2 the residual
' variance and C the inverse normal matrix; and the curvature's significance a / se(a), printed beside it. RESOLVED with
' OFS_FIT_MIN_PTS points, a > 0, the vertex inside +-OFS_SPAN_DEG and its standard error at most OFS_VERT_SE_MAX_X10.
'
' @param eQuantity - FITQ_DC or FITQ_DUTY
' @returns bResolved - T/F where T means the minimum is resolved
' @returns nVertX10 - the vertex, degrees x10 from the shipped offset (0 when the fit could not be made)
' @returns nVseX10 - its standard error, degrees x10 (LIM_SMALL when it could not be made)
' @returns nTx10 - the curvature's significance, standard errors x10 (LIM_SMALL when the residual is 0)
' @returns nPts - the points fitted
' @returns nRmsX10 - the rms residual, x10

' Local Variables:
' @local slotIdx - a point's slot
' @local fU - its u
' @local fY - its y
' @local fS0 - float sum of u^0 (the count)
' @local fS1 - sum of u
' @local fS2 - sum of u^2
' @local fS3 - sum of u^3
' @local fS4 - sum of u^4
' @local fT0 - sum of y
' @local fT1 - sum of y u
' @local fT2 - sum of y u^2
' @local fDet - the normal matrix's determinant
' @local fA - the curvature, y per u^2
' @local fB - the slope at the shipped offset, y per u
' @local fC - the level there
' @local fSsr - the sum of squared residuals
' @local fResVar - the residual variance, s^2 = fSsr / (points - 3)
' @local fCaa - the inverse matrix's (a, a) element
' @local fCbb - its (b, b) element
' @local fCab - its (a, b) element
' @local fSeA - a's standard error
' @local fVert - the vertex, u
' @local fVse - its standard error, u

    bResolved := FALSE
    nVertX10 := 0
    nVseX10 := LIM_SMALL
    nTx10 := 0
    nRmsX10 := 0
    nPts := 0
    fS0 := fS1 := fS2 := fS3 := fS4 := fT0 := fT1 := fT2 := 0.0
    repeat slotIdx from 0 to OFS_POINTS - 1
        if bOpClean[slotIdx]
            nPts++
            fU := float(opD[slotIdx]) /. 10.0
            fY := float((eQuantity == FITQ_DC) ? opDcMa[slotIdx] : opDuty[slotIdx])
            fS0 := fS0 +. 1.0
            fS1 := fS1 +. fU
            fS2 := fS2 +. fU *. fU
            fS3 := fS3 +. fU *. fU *. fU
            fS4 := fS4 +. fU *. fU *. fU *. fU
            fT0 := fT0 +. fY
            fT1 := fT1 +. fY *. fU
            fT2 := fT2 +. fY *. fU *. fU
    if nPts >= OFS_FIT_MIN_PTS
        ' | S4 S3 S2 | | a |   | T2 |
        ' | S3 S2 S1 | | b | = | T1 |
        ' | S2 S1 S0 | | c |   | T0 |
        fDet := fS4 *. (fS2 *. fS0 -. fS1 *. fS1) -. fS3 *. (fS3 *. fS0 -. fS1 *. fS2) +. fS2 *. (fS3 *. fS1 -. fS2 *. fS2)
        if fabs(fDet) >. 0.000001
            fA := (fT2 *. (fS2 *. fS0 -. fS1 *. fS1) -. fS3 *. (fT1 *. fS0 -. fS1 *. fT0) +. fS2 *. (fT1 *. fS1 -. fS2 *. fT0)) /. fDet
            fB := (fS4 *. (fT1 *. fS0 -. fT0 *. fS1) -. fT2 *. (fS3 *. fS0 -. fS1 *. fS2) +. fS2 *. (fS3 *. fT0 -. fT1 *. fS2)) /. fDet
            fC := (fS4 *. (fS2 *. fT0 -. fS1 *. fT1) -. fS3 *. (fS3 *. fT0 -. fT1 *. fS2) +. fT2 *. (fS3 *. fS1 -. fS2 *. fS2)) /. fDet
            fSsr := 0.0
            repeat slotIdx from 0 to OFS_POINTS - 1
                if bOpClean[slotIdx]
                    fU := float(opD[slotIdx]) /. 10.0
                    fY := float((eQuantity == FITQ_DC) ? opDcMa[slotIdx] : opDuty[slotIdx]) -. (fA *. fU *. fU +. fB *. fU +. fC)
                    fSsr := fSsr +. fY *. fY
            nRmsX10 := clampedRound(fsqrt(fSsr /. float(nPts)) *. 10.0, LIM_MID)
            fResVar := fSsr /. float(nPts - 3)
            fCaa := (fS2 *. fS0 -. fS1 *. fS1) /. fDet
            fCbb := (fS4 *. fS0 -. fS2 *. fS2) /. fDet
            fCab := -.(fS3 *. fS0 -. fS1 *. fS2) /. fDet
            fSeA := fsqrt(fResVar *. fCaa)
            if fSeA >. 0.0
                nTx10 := clampedRound((fA /. fSeA) *. 10.0, LIM_SMALL)
            elseif fA >. 0.0
                nTx10 := LIM_SMALL                          ' a perfect fit: no residual to judge against
            else
                nTx10 := -LIM_SMALL
            if fA >. 0.0
                fVert := -.fB /. (2.0 *. fA)
                nVertX10 := clampedRound(fVert *. 100.0, LIM_SMALL)
                ' the delta method through v = -b / 2a: dv/db = -1 / 2a, dv/da = b / 2a^2
                fVse := fResVar /. (4.0 *. fA *. fA) *. (fCbb +. (fB /. fA) *. (fB /. fA) *. fCaa -. 2.0 *. (fB /. fA) *. fCab)
                if fVse <. 0.0
                    fVse := 0.0                             ' (a rounding below zero: no spread)
                nVseX10 := clampedRound(fsqrt(fVse) *. 100.0, LIM_SMALL)
                bResolved := (nVseX10 <= OFS_VERT_SE_MAX_X10) and (abs(nVertX10) <= OFS_SPAN_DEG * X10)

PRI emitOfsPoint(eSign, pctIdx, slotIdx)
' Emit B1-OFSPT (the point: offset, outcome, speed) and B1-OFSPTD (the drive and the DC link) for one point. At rest.
'
' @param eSign - SIGN_NEG or SIGN_POS
' @param pctIdx - the speed, of DAT speedPcts
' @param slotIdx - the point's slot

    benchLog.begin(@"B1-OFSPT")
    benchLog.tokenField(@"sign", signToken(eSign), TOKMAX_SIGN)
    benchLog.numField(@"pct", speedPcts[pctIdx], LIM_TINY)
    benchLog.tokenField(@"side", (slotIdx < OFS_SIDE_POINTS) ? @sSidePlus : @sSideMinus, TOKMAX_SIDE)
    benchLog.numField(@"d", opD[slotIdx], LIM_TINY)
    benchLog.naNumField(@"ofs", opDeg[slotIdx], LIM_TINY, (opOutcome[slotIdx] == RO_DONE) or (opOutcome[slotIdx] == RO_WALL) or (opOutcome[slotIdx] == RO_FAULT))
    benchLog.tokenField(@"outcome", roToken(opOutcome[slotIdx]), TOKMAX_RO)
    benchLog.numField(@"win_ms", opWinMs[slotIdx], LIM_SMALL)
    benchLog.numField(@"cps_x10", opCpsX10[slotIdx], LIM_MID)
    benchLog.numField(@"fol_pm", opFolPm[slotIdx], LIM_SMALL)
    benchLog.naNumField(@"wchk", opWchk[slotIdx], LIM_SMALL, opWchk[slotIdx] >= 0)
    benchLog.boolField(@"clean", bOpClean[slotIdx])
    lineEmit()
    benchLog.begin(@"B1-OFSPTD")
    benchLog.tokenField(@"sign", signToken(eSign), TOKMAX_SIGN)
    benchLog.numField(@"pct", speedPcts[pctIdx], LIM_TINY)
    benchLog.numField(@"d", opD[slotIdx], LIM_TINY)
    benchLog.numField(@"dc_ma", opDcMa[slotIdx], LIM_MID)
    benchLog.numField(@"duty", opDuty[slotIdx], LIM_MID)
    benchLog.numField(@"duty_lo", opDutyLo[slotIdx], LIM_MID)
    benchLog.numField(@"duty_hi", opDutyHi[slotIdx], LIM_MID)
    benchLog.numField(@"err_x10", opErrX10[slotIdx], LIM_SMALL)
    benchLog.numField(@"err_pk", opErrPk[slotIdx], LIM_SMALL)
    benchLog.numField(@"held", opHeld[slotIdx], LIM_MID)
    benchLog.numField(@"capped", opCapped[slotIdx], LIM_MID)
    benchLog.numField(@"folds", opFolds[slotIdx], LIM_SMALL)
    benchLog.numField(@"resyncs", opResyncs[slotIdx], LIM_SMALL)
    benchLog.numField(@"n", opN[slotIdx], LIM_SMALL)
    lineEmit()

PRI emitOfsFit(eSign, pctIdx, eQuantity, bResolved, nVertX10, nVseX10, nTx10, nPts, nRmsX10, nRefMa, nRefDrift)
' Emit B1-OFSFIT: one quantity's parabola at one sign and speed -- resolved or not, the vertex (degrees x10 from the
' shipped offset, and absolute) and its standard error, the curvature's significance, points, rms, and the two
' references' DC link and drift.
'
' @param eSign - SIGN_NEG or SIGN_POS
' @param pctIdx - the speed, of DAT speedPcts
' @param eQuantity - FITQ_DC or FITQ_DUTY
' @param bResolved - the fit resolved
' @param nVertX10 - its vertex, degrees x10 from shipped
' @param nVseX10 - the vertex's standard error, degrees x10
' @param nTx10 - its significance, x10
' @param nPts - its points
' @param nRmsX10 - its rms residual, x10
' @param nRefMa - the PLUS side's reference DC link, mA (-1: not both references ran)
' @param nRefDrift - the MINUS side's reference less it, mA

    benchLog.begin(@"B1-OFSFIT")
    benchLog.tokenField(@"sign", signToken(eSign), TOKMAX_SIGN)
    benchLog.numField(@"pct", speedPcts[pctIdx], LIM_TINY)
    benchLog.tokenField(@"q", (eQuantity == FITQ_DC) ? @sFitqDc : @sFitqDuty, TOKMAX_FITQ)
    benchLog.boolField(@"resolved", bResolved)
    benchLog.numField(@"pts", nPts, LIM_TINY)
    benchLog.numField(@"vert_x10", nVertX10, LIM_SMALL)
    benchLog.numField(@"vert_abs_x10", wrapPositive(((eSign == SIGN_NEG) ? ofsShipFwd : ofsShipRev) * X10 + nVertX10, 3_600), LIM_SMALL)
    benchLog.numField(@"vse_x10", nVseX10, LIM_SMALL)
    benchLog.numField(@"t_x10", nTx10, LIM_SMALL)
    benchLog.numField(@"rms_x10", nRmsX10, LIM_MID)
    benchLog.naNumField(@"ref_ma", nRefMa, LIM_MID, nRefMa >= 0)
    benchLog.naNumField(@"ref_drift_ma", nRefDrift, LIM_MID, nRefMa >= 0)
    lineEmit()

PRI ofsFinish() | pctIdx, eSign, spNeg, spPos, nFwdX10, nRevX10, bNegRes, bPosRes, bPair, nDcFwd, nDcRev, bDcPair, nLo, nHi, nRes, bRes, nVert
' At the leg's end: per speed, B1-OFSPAIR -- both signs' minima in the driver's degrees, their mid (the hall pattern's zero
' against the magnets, as the driver places the field: the Z reference, arbiter decision D2) and half their difference
' (the lead), and the hall zero at speed each way, when both resolved; then R23-SGL-LEADMOVE's spread per sign over the
' resolved speeds. Phase 2c (arbiter decision D9): the pair, the mid, the lead and the spread are LEADMOVE_FITQ's fit
' (the duty's, q names it), and the DC-link fit's pair and mid print beside them (dc_*), the secondary, so the
' evaluation reads both (the cell's rival: the duty's minimum leads the current's by atan(X/R)).

' Local Variables:
' @local pctIdx - a speed
' @local eSign - a sign
' @local spNeg - the NEG sign's fit slot at the speed
' @local spPos - the POS sign's
' @local nFwdX10 - the NEG minimum of LEADMOVE_FITQ's fit, driver degrees x10, signed -1_800..1_800
' @local nRevX10 - the POS minimum, likewise
' @local bNegRes - T/F where T means the NEG fit resolved
' @local bPosRes - the POS fit
' @local bPair - T/F where T means both resolved
' @local nDcFwd - the DC-link fit's NEG minimum, driver degrees x10
' @local nDcRev - its POS minimum
' @local bDcPair - T/F where T means both DC-link fits resolved
' @local nLo - the smallest resolved vertex of a sign
' @local nHi - the largest
' @local nRes - the resolved speeds of a sign
' @local bRes - one fit's resolution (ofsVertex())
' @local nVert - its vertex, degrees x10 from the shipped offset

    repeat pctIdx from 0 to SPEED_PCT_COUNT - 1
        spNeg := SIGN_NEG * SPEED_PCT_COUNT + pctIdx
        spPos := SIGN_POS * SPEED_PCT_COUNT + pctIdx
        bNegRes, nVert := ofsVertex(LEADMOVE_FITQ, spNeg)
        nFwdX10 := wrapSigned(ofsShipFwd * X10 + nVert, 3_600)
        bPosRes, nVert := ofsVertex(LEADMOVE_FITQ, spPos)
        nRevX10 := wrapSigned(ofsShipRev * X10 + nVert, 3_600)
        bPair := bNegRes and bPosRes
        bDcPair := bOfRes[spNeg] and bOfRes[spPos]
        nDcFwd := wrapSigned(ofsShipFwd * X10 + ofVertX10[spNeg], 3_600)
        nDcRev := wrapSigned(ofsShipRev * X10 + ofVertX10[spPos], 3_600)
        benchLog.begin(@"B1-OFSPAIR")
        benchLog.numField(@"pct", speedPcts[pctIdx], LIM_TINY)
        benchLog.tokenField(@"q", (LEADMOVE_FITQ == FITQ_DC) ? @sFitqDc : @sFitqDuty, TOKMAX_FITQ)
        benchLog.boolField(@"pair", bPair)
        benchLog.naNumField(@"neg_x10", nFwdX10, LIM_SMALL, bNegRes)
        benchLog.naNumField(@"pos_x10", nRevX10, LIM_SMALL, bPosRes)
        benchLog.naNumField(@"mid_x10", (nFwdX10 + nRevX10) / 2, LIM_SMALL, bPair)
        benchLog.naNumField(@"lead_x10", (nFwdX10 - nRevX10) / 2, LIM_SMALL, bPair)
        benchLog.boolField(@"dc_pair", bDcPair)
        benchLog.naNumField(@"dc_mid_x10", (nDcFwd + nDcRev) / 2, LIM_SMALL, bDcPair)
        benchLog.naNumField(@"dc_lead_x10", (nDcFwd - nDcRev) / 2, LIM_SMALL, bDcPair)
        benchLog.naNumField(@"z_neg_x10", ofZx10[spNeg], LIM_SMALL, ofZCnt[spNeg] > 0)
        benchLog.tokenField(@"neg_dir", directionToken(ofZTicks[spNeg]), TOKMAX_DIR)
        benchLog.naNumField(@"z_pos_x10", ofZx10[spPos], LIM_SMALL, ofZCnt[spPos] > 0)
        benchLog.tokenField(@"pos_dir", directionToken(ofZTicks[spPos]), TOKMAX_DIR)
        lineEmit()
    repeat eSign from SIGN_NEG to SIGN_POS
        nLo := posx
        nHi := negx
        nRes := 0
        repeat pctIdx from 0 to SPEED_PCT_COUNT - 1
            bRes, nVert := ofsVertex(LEADMOVE_FITQ, eSign * SPEED_PCT_COUNT + pctIdx)
            if bRes
                nRes++
                nLo <#= nVert
                nHi #>= nVert
        sfLeadN[eSign] := nRes
        sfLeadSpread[eSign] := (nRes >= 2) ? nHi - nLo : 0

PRI ofsVertex(eQuantity, spIdx) : bResolved, nVertX10
' One sign and speed's fit of {eQuantity}: whether it resolved, and its vertex.
'
' @param eQuantity - FITQ_DC or FITQ_DUTY
' @param spIdx - the sign and speed's fit slot
' @returns bResolved - T/F where T means the fit resolved
' @returns nVertX10 - its vertex, degrees x10 from the shipped offset

    if eQuantity == FITQ_DC
        bResolved := bOfRes[spIdx]
        nVertX10 := ofVertX10[spIdx]
    else
        bResolved := bOfDuRes[spIdx]
        nVertX10 := ofDuVertX10[spIdx]
#endif

CON { --- L-passprb (plan sec 1.4): the drive pass's period on the encoder --- }

#ifdef SINGLE_PART_PASSPROBE
PRI bRunPassProbe() : bCompleted | eSign, bGoOn
' L-passprb: each sign NEG then POS, a constant command for PASSPRB_WIN_MS (bPassProbeOnce()).
'
' @returns bCompleted - T/F where T means no guard ended the run

' Local Variables:
' @local eSign - SIGN_NEG or SIGN_POS
' @local bGoOn - T/F where T means nothing has ended the run

    bGoOn := TRUE
    repeat eSign from SIGN_NEG to SIGN_POS
        bSfPassMeas[eSign] := FALSE
        if bGoOn
            bGoOn := bPassProbeOnce(eSign)
    bCompleted := bGoOn

PRI bPassProbeOnce(eSign) : bGoOn | nIncr, nWholeMs, eRo, eRo2, nArrMs, nResync0, nResync1, nSec, nRem, nPrevCt, nStartMs, eOutcome, bWok, nWdev, bWin, nPassHzX1000, fTclk, fExp, nPpm, nPpmNom, bJudged
' One sign: from rest to PASSPRB_PCT of the row's ceiling (capped) by the test path, arrived, LADDER_SETTLE_MS, then a
' window of PASSPRB_WIN_MS by getms() whose time is summed exactly from each reading's getct() step (whole seconds and a
' remainder of clocks); the encoder's travel against the field's at the ACTUAL frame's pass rate, and at the nominal
' 44 kHz beside it. Then stopped on the ramp; B1-PASSPRB at rest. Feeds R23-SGL-PASSPRD.
'
' @param eSign - SIGN_NEG or SIGN_POS
' @returns bGoOn - T/F where T means nothing ended the run

' Local Variables:
' @local nIncr - the increment, signed
' @local nWholeMs - the generator's time to it from rest
' @local eRo - the arrival's outcome
' @local eRo2 - the settle's and the window's
' @local nArrMs - ms to arrive (-1 none)
' @local nResync0 - re-synced faults before the drive
' @local nResync1 - after the window
' @local nSec - the window's whole seconds
' @local nRem - its remainder, clocks (0 .. clkfreq - 1)
' @local nPrevCt - the previous reading's getct()
' @local nStartMs - the window's start, getms()
' @local eOutcome - a reading's outcome
' @local bWok - the window's encoder check
' @local nWdev - its deviation
' @local bWin - T/F where T means the window ran its length
' @local nPassHzX1000 - the actual pass rate, Hz x1000
' @local fTclk - the window's time, clocks (float)
' @local fExp - the field's travel over it at the actual pass rate, counts (float)
' @local nPpm - the encoder's travel against it, ppm
' @local nPpmNom - against the nominal 44 kHz / DRIVE_PASS_FRAMES, ppm
' @local bJudged - T/F where T means the cell's precondition holds

    bGoOn := TRUE
    bWin := FALSE
    bJudged := FALSE
    nArrMs := -1
    nWdev := -1
    nSec := 0
    nRem := 0
    nPpm := 0
    nPpmNom := 0
    eRo2 := RO_NOT_RUN
    winEncSpan := 0
    winLagD := 0
    winResyncD := 0
    winMs := 0
    nIncr := (rowCeil / 100 * PASSPRB_PCT) <# rowTop
    if eSign == SIGN_NEG
        nIncr := -nIncr
    nPassHzX1000 := muldiv64(clkfreq, PM, frameCnt * wheel.DRIVE_PASS_FRAMES)
    _, nWholeMs := scurveMs(abs(nIncr), rampAccelUp, rampJerkUp, 0)
    _, _, nResync0 := wheel.testGetFaultResponse()
    sampleBegin()
    eOutcome := sampleNext()
    eRo := RO_DONE
    if bGuardStops(eOutcome)
        eRo := RO_ABORTED
    elseif wheel.testDriveAtMotorIncrement(nIncr) <> wheel.NO_ERROR
        eRo := RO_REFUSED
        clearProtect()
    else
        eRo, nArrMs := waitPhase(UNTIL_ARRIVED, nIncr, 2 * nWholeMs + ARRIVE_MARGIN_MS, FALSE)
        if eRo <> RO_DONE
            nArrMs := -1
        if (eRo == RO_DONE) or (eRo == RO_TIMEOUT)
            eRo2, _ := waitPhase(UNTIL_ELAPSED, 0, LADDER_SETTLE_MS, FALSE)
            if eRo2 == RO_DONE
                windowBegin()
                nPrevCt := smpCt
                nStartMs := smpMs
                repeat
                    eOutcome := sampleNext()
                    windowAdd()
                    nRem += smpCt - nPrevCt                 ' one reading's step: a few ms of clocks, never a wrap
                    nPrevCt := smpCt
                    repeat while nRem >= clkfreq
                        nRem -= clkfreq
                        nSec++
                    if eOutcome == BO_FAULT
                        eRo2 := RO_FAULT
                        quit
                    if bGuardStops(eOutcome)
                        eRo2 := RO_ABORTED
                        quit
                    if smpMs - nStartMs >= PASSPRB_WIN_MS
                        bWin := TRUE
                        quit
                windowEnd()                                 ' (its winCpsX10 is not used: one getct() difference)
        else
            eRo2 := eRo
    _, _, nResync1 := wheel.testGetFaultResponse()
    if bWin
        bWok, nWdev := bWindowEncOk()
        fTclk := float(nSec) *. float(clkfreq) +. float(nRem)
        ' the field's travel: |incr| x 360 counts a cycle x clkfreq / (frame_cnt x 23) passes a second x T / 2^32
        fExp := float(abs(nIncr)) *. float(ENC_COUNTS_PER_ECYCLE) *. fTclk /. (float(frameCnt * wheel.DRIVE_PASS_FRAMES) *. F_2POW32)
        nPpm := clampedRound((float(abs(winEncSpan)) /. fExp -. 1.0) *. float(wheel.PPM), LIM_BIG)
        ' beside it, the nominal 44 kHz: the same travel over T / clkfreq seconds at PWM_RATE_IN_HZ / 23 passes a second
        fExp := float(abs(nIncr)) *. float(ENC_COUNTS_PER_ECYCLE) *. (fTclk /. float(clkfreq)) *. float(wheel.PWM_RATE_IN_HZ) /. (float(wheel.DRIVE_PASS_FRAMES) *. F_2POW32)
        nPpmNom := clampedRound((float(abs(winEncSpan)) /. fExp -. 1.0) *. float(wheel.PPM), LIM_BIG)
        bJudged := bWok and (eRo == RO_DONE) and (winLagD == 0) and (winResyncD == 0) and (nResync1 == nResync0)
        if bWok == FALSE
            bGoOn := FALSE                                  ' bWindowEncOk() coasted the motor and ended the run
    if bGoOn
        if eRo2 == RO_FAULT
            bGoOn := bFaultRecover()
        elseif (eRo2 == RO_ABORTED) or (eRo == RO_ABORTED)
            bGoOn := FALSE
        elseif eRo <> RO_REFUSED
            bGoOn, _ := bStopAndRest(TRUE)
    if bJudged
        bSfPassMeas[eSign] := TRUE
        sfPassPpm[eSign] := nPpm
    benchLog.begin(@"B1-PASSPRB")
    benchLog.tokenField(@"sign", signToken(eSign), TOKMAX_SIGN)
    benchLog.numField(@"incr", nIncr, LIM_BIG)
    benchLog.tokenField(@"outcome", roToken(eRo2 <> RO_NOT_RUN ? eRo2 : eRo), TOKMAX_RO)
    benchLog.naNumField(@"arr_ms", nArrMs, LIM_SMALL, nArrMs >= 0)
    benchLog.numField(@"clkfreq", clkfreq, LIM_BIG)
    benchLog.numField(@"frame_cnt", frameCnt, LIM_MID)
    benchLog.numField(@"pass_hz_x1000", nPassHzX1000, LIM_BIG)
    benchLog.numField(@"win_ms", winMs, LIM_SMALL)
    benchLog.numField(@"win_s", nSec, LIM_TINY)
    benchLog.numField(@"win_rem_ct", nRem, LIM_BIG)
    benchLog.numField(@"travel", winEncSpan, LIM_BIG)
    benchLog.naNumField(@"ppm", nPpm, LIM_BIG, bWin)
    benchLog.naNumField(@"ppm_nom", nPpmNom, LIM_BIG, bWin)
    lineEmit()
    benchLog.begin(@"B1-PASSPRBD")
    benchLog.tokenField(@"sign", signToken(eSign), TOKMAX_SIGN)
    benchLog.tokenField(@"dir", directionToken(winPosSpan), TOKMAX_DIR)
    benchLog.numField(@"pos_ticks", winPosSpan, LIM_MID)
    benchLog.numField(@"held", winLagD, LIM_MID)
    benchLog.numField(@"capped", winCapD, LIM_MID)
    benchLog.numField(@"resyncs", nResync1 - nResync0, LIM_SMALL)
    benchLog.naNumField(@"wchk", nWdev, LIM_SMALL, nWdev >= 0)
    benchLog.boolField(@"judged", bJudged)
    lineEmit()
#endif

CON { --- phase 2c: the attended legs' panel (cog 0) and their measure cog --- }

#ifdef SINGLE_ATTENDED
DAT { the attended legs' steps, in the order each runs them (SG_STEP_*) }

  ' L-handload: the default-limit step last, and only at a DAT rowHandDef row (12 V): HL_COUNT there, HL_DEF elsewhere
handSteps       BYTE    SG_STEP_HL_4A, SG_STEP_HL_2A, SG_STEP_HL_DEF
  ' L-heldpush: one way, then the other
heldSteps       BYTE    SG_STEP_HP_ONE, SG_STEP_HP_OTHER
  ' L-sag: the fault-first case at a DAT sagExpectFault row (22.2 V), the slip-first case elsewhere (18.5 V)
sagFaultSteps   BYTE    SG_STEP_SAG_FAULT
sagSlipSteps    BYTE    SG_STEP_SAG_SLIP
  ' L-pinch
pinchSteps      BYTE    SG_STEP_PINCH

PRI sgSetupPanel()
' Create the attended legs' window and load its eight layers -- the supplied crop-and-overlay technique
' (DOCs/REF-NO-COMMIT/dbg-display-theory/ DISPLAY-PATTERNS-builders-guide.md sec 2, 3 and 6), in the form of
' test_bench_t0.spin2 t0sSetupPanel(), the panel that ran on this rig (PL-127): PLOT with HIDEXY UPDATE, one LAYER per
' BMP, CROP 1, UPDATE. Geometry and ids are the SG_* CON block and sgScreenTab, both printed by
' tools/gen_single_assets.py, which writes the sg_*.bmp layers beside this file (bench-run.sh runs from src/, a pack
' from its own folder; make-bench-pack.sh reads the names from the binary and packs them beside it).
' THE WINDOW IS INPUT AND DISPLAY, the only window: sgDraw() draws every frame, and sgReadInput() polls PC_MOUSE (its
' only input: NO KEY IS READ) on every pass of a screen's wait. CARTESIAN 1 is declared right after it opens
' (PLOT-DISPLAY-RULES.md rule 7) so PC_MOUSE reports y down from the top-left, the basis every CROP destination and the
' hit-test use. The title is single-quoted, with no apostrophe and NO PARENTHESIS (rule 6, PL-128). Shows STARTING:
' nothing has been started yet.

    sgPrevLbtn := 0
    sgIgnoreUntilMs := getms()
    sgInputN := 0
    bSgNoSteps := FALSE
    sgLegToken := @sNa
    debug(`PLOT sgpanel TITLE 'Doco hand tests -- one motor, P16 board' SIZE 560 470 POS 60 60 HIDEXY UPDATE)
    debug(`sgpanel cartesian 1)
    debug(`sgpanel LAYER 1 'sg_bg.bmp')
    debug(`sgpanel LAYER 2 'sg_names.bmp')
    debug(`sgpanel LAYER 3 'sg_banners.bmp')
    debug(`sgpanel LAYER 4 'sg_cards.bmp')
    debug(`sgpanel LAYER 5 'sg_digits.bmp')
    debug(`sgpanel LAYER 6 'sg_status.bmp')
    debug(`sgpanel LAYER 7 'sg_labels.bmp')
    debug(`sgpanel LAYER 8 'sg_buttons.bmp')
    debug(`sgpanel crop 1)
    debug(`sgpanel update)
    sgDrawSpecial(SG_SP_STARTING, SG_ST_STARTING, SG_BT_NONE)
    sgEmitScreen(0, 0, @sPhStarting, @sPhStarting, SG_ST_STARTING, SG_ST_STARTING, 0)    ' up until the first step's INTRO

PRI sgFinalScreen() | eSpecial, statusIdx
' The last screen, after the motor and the encoder are stopped and every record is out: ALL STEPS DONE, or RUN STOPPED
' with why (sgStoppedStatus()), until FINISH, bounded by SG_FINAL_WAIT_MS (its card says so); then the session ends
' either way (B1-SCREEN says which ended it: presses 0 and ms at the bound).

' Local Variables:
' @local eSpecial - SG_SP_ALLDONE or SG_SP_STOPPED
' @local statusIdx - the SEEN NOW phrase

    eSpecial := SG_SP_ALLDONE
    statusIdx := SG_ST_ALL_DONE
    if bSgNoSteps
        eSpecial := SG_SP_STOPPED
        statusIdx := SG_ST_NO_STEPS
    elseif eAbortReason <> AR_NONE
        eSpecial := SG_SP_STOPPED
        statusIdx := sgStoppedStatus()
    sgWaitSpecial(eSpecial, statusIdx)

PRI sgStoppedStatus() : statusIdx
' The RUN STOPPED screen's phrase for the run's first cause (eAbortReason, abortDetail).
'
' @returns statusIdx - an SG_ST_RS_* phrase

    case eAbortReason
        AR_BOARD:                   statusIdx := SG_ST_RS_BOARD
        AR_START:                   statusIdx := SG_ST_RS_START
        AR_ENC_START:               statusIdx := SG_ST_RS_ENCODER
        AR_ZERO:                    statusIdx := SG_ST_RS_ZERO
        AR_LIMITS:                  statusIdx := SG_ST_RS_LIMIT
        AR_SETTING:                 statusIdx := SG_ST_RS_SETTING
        AR_ENC_WIN, AR_ENC_CHECK:   statusIdx := SG_ST_RS_ENCWIN
        AR_GUARD:
            case abortDetail
                BO_OVER_CURRENT:    statusIdx := SG_ST_RS_OVERCURRENT
                BO_CHARGE_CAP:      statusIdx := SG_ST_RS_CHARGE
                BO_LEG_CAP:         statusIdx := SG_ST_RS_LEGCAP
                BO_TIME_CAP:        statusIdx := SG_ST_RS_TIME
                other:              statusIdx := SG_ST_RS_OTHER
        other:                      statusIdx := SG_ST_RS_OTHER

PRI sgWaitSpecial(eSpecial, statusIdx) : btn | pSpec, nStartMs, pPhase
' Show a whole-run screen (SG_SP_*) and wait for its right button, bounded by SG_FINAL_WAIT_MS; log it (B1-SCREEN,
' B1-UI). Only the motor at rest reaches here.
'
' @param eSpecial - SG_SP_STOPPED or SG_SP_ALLDONE
' @param statusIdx - the SEEN NOW phrase
' @returns btn - the button chosen, SG_BT_NONE when the bound ended the wait

' Local Variables:
' @local pSpec - the screen's sgSpecialTab entry
' @local nStartMs - getms() when it was drawn
' @local pPhase - the screen's token for the log (STOPPED, ALLDONE)

    pSpec := @sgSpecialTab + (eSpecial * SG_SPECIAL_BYTES)
    pPhase := (eSpecial == SG_SP_ALLDONE) ? @sPhAllDone : @sPhStopped
    sgDrawSpecial(eSpecial, statusIdx, SG_BT_NONE)
    nStartMs := getms()
    sgIgnoreUntilMs := nStartMs + SG_UI_DEBOUNCE_MS
    sgInputN := 0
    btn := SG_BT_NONE
    repeat while (btn == SG_BT_NONE) and (getms() - nStartMs < SG_FINAL_WAIT_MS)
        btn := sgReadInput(byte[pSpec][SG_SPC_BTN_L], byte[pSpec][SG_SPC_BTN_R], nStartMs)
        if btn == SG_BT_NONE
            waitms(SG_UI_WAIT_MS)
    if btn <> SG_BT_NONE
        sgDrawSpecial(eSpecial, statusIdx, btn)             ' the click, lit
    sgEmitScreen(0, 0, pPhase, pPhase, statusIdx, statusIdx, getms() - nStartMs)

PRI sgDrawSpecial(eSpecial, statusIdx, litBtn) | pSpec
' Draw a whole-run screen from its sgSpecialTab entry: its name, banner, card and buttons, no step number, no readings.
'
' @param eSpecial - SG_SP_*
' @param statusIdx - the SEEN NOW phrase
' @param litBtn - the button drawn lit, SG_BT_NONE for none

' Local Variables:
' @local pSpec - the screen's sgSpecialTab entry

    pSpec := @sgSpecialTab + (eSpecial * SG_SPECIAL_BYTES)
    sgDraw(byte[pSpec][SG_SPC_NAME], 0, 0, byte[pSpec][SG_SPC_BANNER], byte[pSpec][SG_SPC_CARD], statusIdx, SG_L_BLANK, ...
           SG_L_BLANK, -1, -1, byte[pSpec][SG_SPC_BTN_L], byte[pSpec][SG_SPC_BTN_R], litBtn, TRUE)

PRI sgDraw(nameRow, seqNum, nSteps, bannerIdx, cardIdx, statusIdx, lbl1, lbl2, r1, r2, btnL, btnR, litBtn, bFull)
' Compose one frame, then one UPDATE (DISPLAY-PATTERNS-builders-guide.md sec 2: batch every crop, then one update), as
' test_bench_t0.spin2 t0sDraw() does. Within one screen only the phrase and the readings change, so a partial frame
' (bFull FALSE) sends just those. Cog 0 only.
'
' @param nameRow - the names-layer row: a step's name, or a whole-run screen's
' @param seqNum - the step's number, 1-based (0 blanks it)
' @param nSteps - the leg's steps (0 blanks it)
' @param bannerIdx - SG_B_*
' @param cardIdx - the card row
' @param statusIdx - SG_ST_*
' @param lbl1 - the two reading labels, SG_L_*
' @param lbl2 - (the second)
' @param r1 - the two readings, -1 for none
' @param r2 - (the second)
' @param btnL - the left and right buttons, SG_BT_NONE for an empty slot
' @param btnR - (the right)
' @param litBtn - the button drawn lit, SG_BT_NONE for none
' @param bFull - T/F where T means every element; F only the phrase and the readings

    if bFull
        sgBlitDigit(SG_SNUM_X, SG_STEP_LINE_Y, seqNum)
        sgBlitDigit(SG_SCOUNT_X, SG_STEP_LINE_Y, nSteps)
        debug(`sgpanel crop 2 `(0, nameRow * SG_NAME_H, SG_NAME_W, SG_NAME_H, SG_NAME_X, SG_STEP_LINE_Y))
        sgBlitSupply()
        debug(`sgpanel crop 3 `(0, bannerIdx * SG_BAN_H, SG_BAN_W, SG_BAN_H, SG_BAN_X, SG_BAN_Y))
        debug(`sgpanel crop 4 `(0, cardIdx * SG_CARD_H, SG_CARD_W, SG_CARD_H, SG_CARD_X, SG_CARD_Y))
        debug(`sgpanel crop 7 `(0, lbl1 * SG_LBL_H, SG_LBL_W, SG_LBL_H, SG_LBL_X, SG_READ1_Y))
        debug(`sgpanel crop 7 `(0, lbl2 * SG_LBL_H, SG_LBL_W, SG_LBL_H, SG_LBL_X, SG_READ2_Y))
        sgBlitButton(SG_BTN_L_X, btnL, litBtn)
        sgBlitButton(SG_BTN_R_X, btnR, litBtn)
    debug(`sgpanel crop 6 `(0, statusIdx * SG_STAT_H, SG_STAT_W, SG_STAT_H, SG_STAT_X, SG_STAT_Y))
    sgBlitReading(SG_READ1_Y, r1)
    sgBlitReading(SG_READ2_Y, r2)
    debug(`sgpanel update)

PRI sgBlitSupply() | idx, nRow
' Blit the told supply into its slot on the step line (a names-layer row, SG_SUP_W wide): the panel repeats what the
' runner's banner says, since this bench senses no voltage. A told voltage with no row leaves the slot empty.

' Local Variables:
' @local idx - a row of DAT rowMv
' @local nRow - the told voltage's row, -1 none

    nRow := -1
    repeat idx from 0 to ROW_COUNT - 1
        if rowMv[idx] == TOLD_MV
            nRow := idx
    if nRow >= 0
        debug(`sgpanel crop 2 `(0, (SG_SUPPLY_ROW0 + nRow) * SG_NAME_H, SG_SUP_W, SG_NAME_H, SG_SUP_X, SG_STEP_LINE_Y))
    else
        debug(`sgpanel crop 1 `(SG_SUP_X, SG_STEP_LINE_Y, SG_SUP_W, SG_NAME_H))

PRI sgBlitDigit(destX, destY, nCell)
' Blit one digit cell (0..9), or the blank cell for anything else.
'
' @param destX - the cell's left edge on the canvas
' @param destY - its top edge
' @param nCell - the digit, 0..9; any other value blanks the cell

    if (nCell < 0) or (nCell > 9)
        nCell := SG_DGT_BLANK
    debug(`sgpanel crop 5 `(nCell * SG_DGT_W, 0, SG_DGT_W, SG_DGT_H, destX, destY))

PRI sgBlitReading(destY, numValue) | divisor, colIdx, nCell
' Blit one reading's SG_READ_COUNT digits, most significant first, leading zeros suppressed; a negative value blanks
' every digit (no reading).
'
' @param destY - the reading's row on the canvas
' @param numValue - the value, 0..99_999 shown; -1 for none

' Local Variables:
' @local divisor - the place value of the column being drawn
' @local colIdx - the column, most significant first
' @local nCell - its digit, or the blank cell

    numValue <#= 99_999
    divisor := 10_000
    repeat colIdx from 0 to SG_READ_COUNT - 1
        nCell := SG_DGT_BLANK
        if (numValue >= 0) and ((divisor == 1) or (numValue >= divisor))
            nCell := (numValue / divisor) +// 10
        sgBlitDigit(SG_READ_X + (colIdx * SG_READ_PITCH), destY, nCell)
        divisor /= 10

PRI sgBlitButton(destX, btnIdx, litBtn) | colX
' Blit one button slot: the button's cell, lit when it was just clicked, or the bare panel (SG_BT_NONE's cell) for an
' empty slot, so a slot never shows a button that cannot be chosen.
'
' @param destX - the slot's left edge
' @param btnIdx - SG_BT_*
' @param litBtn - the button drawn lit, SG_BT_NONE for none

' Local Variables:
' @local colX - the cell's column in layer 8: 0 normal, SG_BTN_W lit

    colX := 0
    if (btnIdx == litBtn) and (btnIdx <> SG_BT_NONE)
        colX := SG_BTN_W
    debug(`sgpanel crop 8 `(colX, btnIdx * SG_BTN_H, SG_BTN_W, SG_BTN_H, destX, SG_BTN_Y))

PRI sgReadInput(btnL, btnR, nScreenMs) : btn | nX, nY, nCand, nHit
' THE PANEL'S ONLY INPUT READ: PC_MOUSE once (p2kbSpin2DbgPcMouse: its own backtick, last in its debug(), seven longs);
' no PC_KEY. A press is the left button's 0 -> -1 edge (a live state, builder's guide sec 7), taken on the button slot
' it lands on: the live left or right button, or none. Every press is kept for the screen's log (sgNoteInput()): the
' button it chose, MISS for none, IGNORED inside the debounce after a screen change -- so a click that did nothing can
' be told from one that never arrived (PLOT-DISPLAY-RULES.md rule 10).
'
' @param btnL - the live left button, SG_BT_* (SG_BT_NONE: an empty slot)
' @param btnR - the live right button
' @param nScreenMs - getms() when the screen was drawn (the press's time in the log is from it)
' @returns btn - the button chosen, SG_BT_NONE when none

' Local Variables:
' @local nX - the press's position, window pixels
' @local nY - (y, down from the top-left: cartesian 1)
' @local nCand - the live button under it, SG_BT_NONE for none
' @local nHit - what the log says it hit: an SG_BT_*, SG_HIT_MISS or SG_HIT_IGNORED

    btn := SG_BT_NONE
    debug(`sgpanel `pc_mouse(@sgMouse))
    if (sgMouse[SG_MOUSE_LBTN] <> 0) and (sgPrevLbtn == 0)
        nX := sgMouse[SG_MOUSE_XPOS]
        nY := sgMouse[SG_MOUSE_YPOS]
        nCand := SG_BT_NONE
        if (nY >= SG_BTN_Y) and (nY < SG_BTN_Y + SG_BTN_H)
            if (nX >= SG_BTN_L_X) and (nX < SG_BTN_L_X + SG_BTN_W)
                nCand := btnL
            elseif (nX >= SG_BTN_R_X) and (nX < SG_BTN_R_X + SG_BTN_W)
                nCand := btnR
        if getms() < sgIgnoreUntilMs
            nHit := SG_HIT_IGNORED
        elseif nCand <> SG_BT_NONE
            btn := nCand
            nHit := nCand
        else
            nHit := SG_HIT_MISS
        sgNoteInput(nX, nY, nHit, getms() - nScreenMs)
    sgPrevLbtn := sgMouse[SG_MOUSE_LBTN]

PRI sgNoteInput(nX, nY, nHit, nAtMs) | pIn
' Keep one press for the screen's log (B1-UI, emitted when the screen ends, at rest): its place, what it hit, when.
'
' @param nX - the press's x, window pixels
' @param nY - its y
' @param nHit - an SG_BT_*, SG_HIT_MISS or SG_HIT_IGNORED
' @param nAtMs - ms into the screen

' Local Variables:
' @local pIn - its slot in sgInputs

    if sgInputN < SG_INPUT_MAX
        pIn := @sgInputs[sgInputN * SG_INPUT_LONGS]
        long[pIn][0] := nX
        long[pIn][1] := nY
        long[pIn][2] := nHit
        long[pIn][3] := nAtMs
    sgInputN++

PRI sgEmitScreen(seqNum, runNum, pPhase0, pPhase1, nSt0, nSt1, nMs) | idx, pIn
' Emit B1-SCREEN for the screen just left -- the leg, the step and its run, the phase it opened in and the phase it ended
' in (a step's job moves SETUP to ACT itself), its first and last SEEN NOW phrase (SG_ST_*), how long it was up, its
' presses -- then one B1-UI per press kept. Cog 0, at rest.
'
' @param seqNum - the step's number, 1-based (0: a whole-run screen)
' @param runNum - its run, 1-based (0: none)
' @param pPhase0 - the phase's token it opened in
' @param pPhase1 - the phase's token it ended in
' @param nSt0 - the first phrase shown
' @param nSt1 - the last
' @param nMs - ms it was up

' Local Variables:
' @local idx - a kept press
' @local pIn - its slot in sgInputs

    benchLog.begin(@"B1-SCREEN")
    benchLog.tokenField(@"leg", sgLegToken, TOKMAX_LEG)
    benchLog.numField(@"step", seqNum, LIM_TINY)
    benchLog.numField(@"run", runNum, LIM_TINY)
    benchLog.tokenField(@"phase", pPhase0, TOKMAX_PH)
    benchLog.tokenField(@"phase_end", pPhase1, TOKMAX_PH)
    benchLog.numField(@"st", nSt0, LIM_TINY)
    benchLog.numField(@"st_end", nSt1, LIM_TINY)
    benchLog.numField(@"ms", nMs, LIM_BIG)
    benchLog.numField(@"presses", sgInputN, LIM_SMALL)
    lineEmit()
    repeat idx from 0 to (sgInputN <# SG_INPUT_MAX) - 1
        pIn := @sgInputs[idx * SG_INPUT_LONGS]
        benchLog.begin(@"B1-UI")
        benchLog.tokenField(@"leg", sgLegToken, TOKMAX_LEG)
        benchLog.numField(@"step", seqNum, LIM_TINY)
        benchLog.numField(@"run", runNum, LIM_TINY)
        benchLog.tokenField(@"phase", pPhase1, TOKMAX_PH)
        benchLog.numField(@"press", idx + 1, LIM_TINY)
        benchLog.numField(@"x", long[pIn][0], LIM_SMALL)
        benchLog.numField(@"y", long[pIn][1], LIM_SMALL)
        benchLog.tokenField(@"hit", hitToken(long[pIn][2]), TOKMAX_BT)
        benchLog.numField(@"at_ms", long[pIn][3], LIM_BIG)
        lineEmit()
    sgInputN := 0

PRI sgScreenPtr(stepId, ePhase) : pScreen
' A step's screen entry for one phase in sgScreenTab: the one place the table is indexed.
'
' @param stepId - SG_STEP_*
' @param ePhase - SG_PH_*
' @returns pScreen - the entry's first byte; read it with SG_SCR_* offsets

    pScreen := @sgScreenTab + (((stepId * SG_PHASE_COUNT) + ePhase) * SG_SCREEN_BYTES)

PRI sgUiWait(stepId, seqNum, nSteps, runNum, ePhase, statusIdx, r1, r2, bJob, bLast) : btn | pScreen, btnL, btnR, litBtn, nShownSt, nShownR1, nShownR2, nLastDrawMs, nStartMs, bEnded, bDraw, bLitNow, nPh0, nSt0
' THE PANEL LOOP (test_bench_t0.spin2 t0sUiWait()'s form, without keys): one screen of a step, from its first draw until
' it is left, reading the mouse on every pass so no click falls between reads. Without a job it returns the button he
' chose: only the buttons that can be chosen are drawn, and a RESULT's forward button is FINISH on the leg's last step.
' With a job it runs until the measure cog answers: the screen follows the job's phase (SETUP, then ACT), its live phrase
' and readings are redrawn as they change (readings at most every SG_UI_REDRAW_MS), and STOP MOTOR or DONE is passed to
' the measure cog as a request while the clicked button stays lit. A wait with no job is the operator's time, not the
' motor's: it is added to runIdleMs. The screen's B1-SCREEN and B1-UI are emitted when it ends -- for a job, after the
' measure cog has stopped the motor, so no record is emitted while it turns.
'
' @param stepId - SG_STEP_*
' @param seqNum - the step's number in the leg, 1-based: the panel's, the log's and the runner's numbering
' @param nSteps - the leg's steps
' @param runNum - the step's run, 1-based (a REDO is the next)
' @param ePhase - SG_PH_*: the screen (with a job, the phase it opens in)
' @param statusIdx - the SEEN NOW phrase (with a job, the measure cog's is shown)
' @param r1 - the readings, -1 for none (with a job, the measure cog's)
' @param r2 - (the second)
' @param bJob - T/F where T means a posted job runs while this screen is up
' @param bLast - T/F where T means the leg's last step: a RESULT's forward button is FINISH
' @returns btn - the button chosen, SG_BT_*; SG_BT_NONE when the job ended the screen

' Local Variables:
' @local pScreen - the screen's sgScreenTab entry
' @local btnL - its live left button
' @local btnR - its live right button
' @local litBtn - the button drawn lit (clicked), SG_BT_NONE for none
' @local nShownSt - the phrase last drawn
' @local nShownR1 - the readings last drawn
' @local nShownR2 - (the second)
' @local nLastDrawMs - getms() at the last draw
' @local nStartMs - getms() when the screen was first drawn
' @local bEnded - T/F where T means the screen is left
' @local bDraw - T/F where T means this pass redraws
' @local bLitNow - T/F where T means a button lit this pass (the redraw includes the buttons)
' @local nPh0 - the phase the screen opened in
' @local nSt0 - the phrase it opened with

    if bJob
        ePhase := wkPhase
        statusIdx := wkStatus
        r1 := wkRead1
        r2 := wkRead2
    pScreen := sgScreenPtr(stepId, ePhase)
    btnL := byte[pScreen][SG_SCR_BTN_L]
    btnR := byte[pScreen][SG_SCR_BTN_R]
    if bLast and (btnR == SG_BT_NEXT)
        btnR := SG_BT_FINISH
    litBtn := SG_BT_NONE
    btn := SG_BT_NONE
    sgDrawStep(pScreen, stepId, seqNum, nSteps, statusIdx, r1, r2, btnL, btnR, litBtn, TRUE)
    nPh0 := ePhase
    nSt0 := statusIdx
    nShownSt := statusIdx
    nShownR1 := r1
    nShownR2 := r2
    nStartMs := getms()
    nLastDrawMs := nStartMs
    sgIgnoreUntilMs := nStartMs + SG_UI_DEBOUNCE_MS
    sgInputN := 0
    bEnded := FALSE
    repeat while bEnded == FALSE
        bDraw := FALSE
        bLitNow := FALSE
        if bJob
            bEnded := (wkDoneSeq == wkJobSeq)
            statusIdx := wkStatus
            r1 := wkRead1
            r2 := wkRead2
            if (bEnded == FALSE) and (wkPhase <> ePhase)        ' the job moved on (SETUP -> ACT): a new screen
                ePhase := wkPhase
                pScreen := sgScreenPtr(stepId, ePhase)
                btnL := byte[pScreen][SG_SCR_BTN_L]
                btnR := byte[pScreen][SG_SCR_BTN_R]
                litBtn := SG_BT_NONE
                sgDrawStep(pScreen, stepId, seqNum, nSteps, statusIdx, r1, r2, btnL, btnR, litBtn, TRUE)
                nShownSt := statusIdx
                nShownR1 := r1
                nShownR2 := r2
                nLastDrawMs := getms()
                sgIgnoreUntilMs := nLastDrawMs + SG_UI_DEBOUNCE_MS
        if bEnded == FALSE
            btn := sgReadInput(btnL, btnR, nStartMs)
            if btn <> SG_BT_NONE
                litBtn := btn
                bLitNow := TRUE
                bDraw := TRUE
                if bJob                                     ' a request to the measure cog; the screen stays
                    if btn == SG_BT_STOP
                        bWkStopReq := TRUE
                    elseif btn == SG_BT_DONE
                        bWkDoneReq := TRUE
                    btn := SG_BT_NONE
                else
                    bEnded := TRUE
            if statusIdx <> nShownSt
                bDraw := TRUE
            elseif ((r1 <> nShownR1) or (r2 <> nShownR2)) and ((getms() - nLastDrawMs) >= SG_UI_REDRAW_MS)
                bDraw := TRUE
            if bDraw
                sgDrawStep(pScreen, stepId, seqNum, nSteps, statusIdx, r1, r2, btnL, btnR, litBtn, bLitNow)
                nShownSt := statusIdx
                nShownR1 := r1
                nShownR2 := r2
                nLastDrawMs := getms()
            if bEnded == FALSE
                waitms(SG_UI_WAIT_MS)
    if bJob == FALSE
        runIdleMs += getms() - nStartMs                     ' his time on the screen, not the motor's
    sgEmitScreen(seqNum, runNum, phaseToken(nPh0), phaseToken(ePhase), nSt0, statusIdx, getms() - nStartMs)

PRI sgDrawStep(pScreen, stepId, seqNum, nSteps, statusIdx, r1, r2, btnL, btnR, litBtn, bFull)
' Draw a step's screen from its sgScreenTab entry, with these buttons (the RESULT's forward one may be FINISH).
'
' @param pScreen - the screen's sgScreenTab entry
' @param stepId - SG_STEP_*: its name row
' @param seqNum - the step's number, 1-based
' @param nSteps - the leg's steps
' @param statusIdx - SG_ST_*
' @param r1 - the readings, -1 for none
' @param r2 - (the second)
' @param btnL - the left button
' @param btnR - the right button
' @param litBtn - the button drawn lit, SG_BT_NONE for none
' @param bFull - T/F where T means every element

    sgDraw(stepId, seqNum, nSteps, byte[pScreen][SG_SCR_BANNER], byte[pScreen][SG_SCR_CARD], statusIdx, ...
           byte[pScreen][SG_SCR_LBL1], byte[pScreen][SG_SCR_LBL2], r1, r2, btnL, btnR, litBtn, bFull)

PRI sgPost(stepId, runNum)
' Post one step's job to the measure cog and wait until it has taken it (its first phrase is then in place). Cog 0 is
' the only writer of the requests and the job; the sequence number is written last.
'
' @param stepId - SG_STEP_*
' @param runNum - the step's run, 1-based

    bWkStopReq := FALSE
    bWkDoneReq := FALSE
    wkStep := stepId
    wkRun := runNum
    wkJobSeq++
    repeat while wkTakenSeq <> wkJobSeq
        waitus(WK_JOB_POLL_US)

PRI bRunAttended(pLegToken, pSteps, nSteps) : bCompleted | nCog, idx, bGoOn
' Run one attended leg: start the measure cog (in a cog-event quiet window), run each step of {pSteps} in order
' (bSgRunStep()), stop the measure cog. Cog 0.
'
' @param pLegToken - the leg's token (B1-SCREEN, B1-UI)
' @param pSteps - its steps, bytes of SG_STEP_*
' @param nSteps - how many
' @returns bCompleted - T/F where T means nothing ended the run

' Local Variables:
' @local nCog - cogspin()'s result: the measure cog's id, or -1
' @local idx - a step of the leg
' @local bGoOn - T/F where T means nothing has ended the run

    sgLegToken := pLegToken
    wkJobSeq := 0
    wkTakenSeq := 0
    wkDoneSeq := 0
    benchLog.cogEventBegin()
    nCog := cogspin(NEWCOG, sgWorker(), @wkStack)
    benchLog.cogEventEnd()
    bGoOn := (nCog >= 0)
    if bGoOn
        wkCog := nCog + 1
        repeat idx from 0 to nSteps - 1
            if bGoOn
                bGoOn := bSgRunStep(byte[pSteps][idx], idx + 1, nSteps)
        benchLog.cogEventBegin()
        cogstop(wkCog - 1)
        wkCog := 0
    else
        setAbort(AR_WORKER, nCog)
    bCompleted := bGoOn

PRI bSgRunStep(stepId, seqNum, nSteps) : bGoOn | bLast, runNum, btn, bAgain
' One step, as a lesson (T0-24's row, PL-127): INTRO previews it and waits for START STEP; then its job (SETUP, ACT) and,
' for the sag, RESTORE; then RESULT, which waits for NEXT STEP (FINISH on the last) or REDO STEP. The step's records are
' emitted after its job, at rest. The default-limit hand-load step runs only while the leg's charge cap allows it
' (bHandDefAllowed()); otherwise its SKIP screen says why. Cog 0.
'
' @param stepId - SG_STEP_*
' @param seqNum - its number in the leg, 1-based
' @param nSteps - the leg's steps
' @returns bGoOn - T/F where T means nothing ended the run

' Local Variables:
' @local bLast - T/F where T means the leg's last step
' @local runNum - the run, 1-based
' @local btn - the RESULT screen's answer
' @local bAgain - T/F where T means run the step again

    bGoOn := TRUE
    bLast := (seqNum == nSteps)
    if bStepRuns(stepId)
        sgUiWait(stepId, seqNum, nSteps, 0, SG_PH_INTRO, SG_ST_WAIT_START, -1, -1, FALSE, bLast)
        runNum := 0
        bAgain := TRUE
        repeat while bAgain
            runNum++
            sgPost(stepId, runNum)
            sgUiWait(stepId, seqNum, nSteps, runNum, SG_PH_SETUP, SG_ST_BLANK, -1, -1, TRUE, bLast)
            sgEmitStep(stepId, seqNum, runNum)
            bAgain := FALSE
            if eAbortReason <> AR_NONE
                bGoOn := FALSE                              ' the run ended in the step: the last screen says why
            else
                if (stepId == SG_STEP_SAG_FAULT) or (stepId == SG_STEP_SAG_SLIP)
                    sgUiWait(stepId, seqNum, nSteps, runNum, SG_PH_RESTORE, SG_ST_RESTORE, -1, -1, FALSE, bLast)
                btn := sgUiWait(stepId, seqNum, nSteps, runNum, SG_PH_RESULT, wkWhy, wkRes1, wkRes2, FALSE, bLast)
                if btn == SG_BT_REDO
                    bAgain := bStepRuns(stepId)
                    if bAgain == FALSE
                        sgSkipStep(stepId, seqNum, nSteps, bLast)
    else
        sgSkipStep(stepId, seqNum, nSteps, bLast)

PRI bStepRuns(stepId) : bRuns
' Whether a step may run now: every step but the default-limit hand-load step, which runs only at a DAT rowHandDef row
' and while a whole step's cap is left in the leg (the dispatch: "only if the leg charge cap allows").
'
' @param stepId - SG_STEP_*
' @returns bRuns - T/F where T means the step runs

    bRuns := TRUE
    if stepId == SG_STEP_HL_DEF
        bRuns := bRowAllowsHandDef() and (HAND_LEG_CAP_MAS * wheel.MS_PER_SEC - legStallMaMs >= HAND_DEF_NEED_MAS * wheel.MS_PER_SEC)

PRI bRowAllowsHandDef() : bAllows
' Report whether this run's row allows the hand load at the default limits; FALSE when no row was found.
' Guarded by construction (an if, not an AND): rowHandDef[] is never indexed with rowIdx -1.
'
' @returns bAllows - T/F where T means the row's rowHandDef[] entry allows the default-limit step

    bAllows := FALSE
    if rowIdx >= 0
        bAllows := rowHandDef[rowIdx]

PRI sgSkipStep(stepId, seqNum, nSteps, bLast)
' A step the program does not run: B1-STEPSKIP, then its SKIP screen until NEXT STEP (FINISH on the last). Cog 0.
'
' @param stepId - SG_STEP_* (the default-limit hand-load step is the only one)
' @param seqNum - its number in the leg, 1-based
' @param nSteps - the leg's steps
' @param bLast - T/F where T means the leg's last step

    benchLog.begin(@"B1-STEPSKIP")
    benchLog.tokenField(@"leg", sgLegToken, TOKMAX_LEG)
    benchLog.numField(@"step", seqNum, LIM_TINY)
    benchLog.numField(@"step_id", stepId, LIM_TINY)
    benchLog.numField(@"leg_stall_mas", legStallMaMs / wheel.MS_PER_SEC, LIM_MID)
    benchLog.numField(@"leg_cap_mas", HAND_LEG_CAP_MAS, LIM_MID)
    benchLog.numField(@"need_mas", HAND_DEF_NEED_MAS, LIM_MID)
    benchLog.boolField(@"row_allows", rowHandDef[rowIdx])
    lineEmit()
    sgUiWait(stepId, seqNum, nSteps, 0, SG_PH_SKIP, SG_ST_DEF_SKIPPED, -1, -1, FALSE, bLast)

PRI sgEmitStep(stepId, seqNum, runNum)
' Emit a step's records, from what the measure cog stored: at rest, after its job. Cog 0.
'
' @param stepId - SG_STEP_*
' @param seqNum - its number in the leg, 1-based
' @param runNum - its run, 1-based

    case stepId
#ifdef SINGLE_PART_HANDLOAD
        SG_STEP_HL_4A, SG_STEP_HL_2A, SG_STEP_HL_DEF:
            emitHandStep(stepId - SG_STEP_HL_4A, seqNum, runNum)
#endif
#ifdef SINGLE_PART_HELDPUSH
        SG_STEP_HP_ONE, SG_STEP_HP_OTHER:
            emitHeldStep(stepId - SG_STEP_HP_ONE, seqNum, runNum)
#endif
#ifdef SINGLE_PART_SAG
        SG_STEP_SAG_FAULT, SG_STEP_SAG_SLIP:
            emitSagStep(seqNum, runNum)
#endif
#ifdef SINGLE_PART_PINCH
        SG_STEP_PINCH:
            emitPinchStep(seqNum, runNum)
#endif
        other:
            benchLog.begin(@"B1-STEPSKIP")                  ' (no leg of this image owns the step: never reached)
            benchLog.numField(@"step_id", stepId, LIM_TINY)
            lineEmit()

PRI sgWorker() | jobSeq
' THE MEASURE COG (T0-24's t0sWorker(), PL-127): it waits for a job, runs the step's SETUP and ACT, and answers by
' setting wkDoneSeq. It owns every drive, every sample and every guard of an attended step, publishes the live phrase
' and readings (wkStatus, wkRead1, wkRead2) and the phase (wkPhase) for the panel, and PRINTS NOTHING: DEBUG output is
' serialised on LOCK[15] (P2-HAZARD-REGISTER DBG-10), so a print here could wait out the panel's mouse read and stall
' the 5 ms sampler. It stores what it measured in hub; cog 0 prints it after the step. It starts no cog; a guard that
' ends the run stops the driver from here (coastNow(), in its quiet window), as every leg's guard does.

' Local Variables:
' @local jobSeq - the job's sequence number, answered in wkDoneSeq

    repeat
        repeat while wkDoneSeq == wkJobSeq
            waitus(WK_JOB_POLL_US)
        jobSeq := wkJobSeq
        wkPhase := SG_PH_SETUP
        wkStatus := SG_ST_BLANK
        wkRead1 := -1
        wkRead2 := -1
        wkWhy := SG_ST_NM_SETUP
        wkRes1 := -1
        wkRes2 := -1
        wkTakenSeq := jobSeq                                ' the panel draws its first frame only now: never a stale phrase
        case wkStep
#ifdef SINGLE_PART_HANDLOAD
            SG_STEP_HL_4A, SG_STEP_HL_2A, SG_STEP_HL_DEF:
                wkHandStep(wkStep - SG_STEP_HL_4A)
#endif
#ifdef SINGLE_PART_HELDPUSH
            SG_STEP_HP_ONE, SG_STEP_HP_OTHER:
                wkHeldStep(wkStep - SG_STEP_HP_ONE)
#endif
#ifdef SINGLE_PART_SAG
            SG_STEP_SAG_FAULT, SG_STEP_SAG_SLIP:
                wkSagStep()
#endif
#ifdef SINGLE_PART_PINCH
            SG_STEP_PINCH:
                wkPinchStep()
#endif
        wheel.getError()                                    ' this cog's own error slot, drained after every job
        wkDoneSeq := jobSeq                                 ' written last: every result long is in place

PRI wkDrainEvents() | eKind
' Read this cog's unread events from the motor's soft-event log until none is left (bounded), so the next read sees only
' what happens from here.

' Local Variables:
' @local eKind - an event's EV_* kind

    repeat WK_EV_READ_MAX
        eKind, _, _ := wheel.getEvent()
        if eKind == wheel.EV_NONE
            quit

PRI wkLatchEventMs(nDefaultMs) : nMs, bFound | idx, eKind, nEvMs, nEvVal
' The blocked stop's own time: the getms() of this cog's next EV_STOP event whose value is SR_BLOCKED (the front cog
' queues it right after it writes the stop: exact to the ms), or {nDefaultMs} when none is read within the bound.
'
' @param nDefaultMs - the reading that saw the latch, getms()
' @returns nMs - the event's getms(), or nDefaultMs
' @returns bFound - T/F where T means the event was read

' Local Variables:
' @local idx - an event read
' @local eKind - its EV_* kind
' @local nEvMs - its getms()
' @local nEvVal - its value

    nMs := nDefaultMs
    bFound := FALSE
    repeat idx from 1 to WK_EV_READ_MAX
        eKind, nEvMs, nEvVal := wheel.getEvent()
        if eKind == wheel.EV_NONE
            quit
        if (eKind == wheel.EV_STOP) and (nEvVal == wheel.SR_BLOCKED)
            nMs := nEvMs
            bFound := TRUE
            quit

PRI wkWaitAtSpeed(nTarget, nBoundMs) : eRo, bStopped | nStartMs, eOutcome
' Take readings until the drive reads DCS_AT_SPEED (with its increment at {nTarget}, unless {nTarget} is 0), the driver
' faults, a guard ends the run, he clicks STOP MOTOR, or {nBoundMs} passes. The measure cog's arrival.
'
' @param nTarget - the commanded increment (0: any AT_SPEED, a power command's)
' @param nBoundMs - the bound, ms
' @returns eRo - RO_DONE, RO_TIMEOUT, RO_FAULT or RO_ABORTED
' @returns bStopped - T/F where T means STOP MOTOR ended it (eRo RO_TIMEOUT then)

' Local Variables:
' @local nStartMs - getms() at the call
' @local eOutcome - a reading's outcome

    nStartMs := getms()
    eRo := RO_TIMEOUT
    bStopped := FALSE
    repeat
        eOutcome := sampleNext()
        if eOutcome == BO_FAULT
            eRo := RO_FAULT
            quit
        if bGuardStops(eOutcome)
            eRo := RO_ABORTED
            quit
        if (smpState == wheel.DCS_AT_SPEED) and ((nTarget == 0) or (smpDrvIncr == nTarget))
            eRo := RO_DONE
            quit
        if bWkStopReq
            bStopped := TRUE
            quit
        if smpMs - nStartMs >= nBoundMs
            quit

PRI wkRpm(nCps) : nRpm
' Encoder counts per second as shaft rpm, magnitude.
'
' @param nCps - counts per second, either sign
' @returns nRpm - rpm

    nRpm := abs(nCps) * 60 / ENC_COUNTS_PER_REV

PRI phaseToken(ePhase) : pToken
' A panel phase's token for the log.
'
' @param ePhase - SG_PH_*
' @returns pToken - pointer to its name

    case ePhase
        SG_PH_INTRO:    pToken := @sPhIntro
        SG_PH_SETUP:    pToken := @sPhSetup
        SG_PH_ACT:      pToken := @sPhAct
        SG_PH_RESTORE:  pToken := @sPhRestore
        SG_PH_RESULT:   pToken := @sPhResult
        SG_PH_SKIP:     pToken := @sPhSkip
        other:          pToken := @sNa

PRI hitToken(nHit) : pToken
' What a press hit, for the log.
'
' @param nHit - an SG_BT_*, SG_HIT_MISS or SG_HIT_IGNORED
' @returns pToken - pointer to its name

    case nHit
        SG_BT_START:    pToken := @sBtStart
        SG_BT_DONE:     pToken := @sBtDone
        SG_BT_NEXT:     pToken := @sBtNext
        SG_BT_FINISH:   pToken := @sBtFinish
        SG_BT_STOP:     pToken := @sBtStop
        SG_BT_REDO:     pToken := @sBtRedo
        SG_HIT_IGNORED: pToken := @sBtIgnored
        other:          pToken := @sBtMiss
#endif

CON { --- L-handload (the analysis's L5): the hand load at low speed, attended --- }

#ifdef SINGLE_PART_HANDLOAD
PRI bRunHandLoad() : bCompleted | hl
' L-handload: at a DAT rowL56 row, the leg's stall-charge cap armed and its charge zeroed, its steps on the panel --
' the 4 A and 2 A test limits, then, at a DAT rowHandDef row (12 V) and while the cap allows, the default limits
' (bRunAttended()). At another row nothing drives (B1-LEGSKIP, and the panel says so). Cog 0.
'
' @returns bCompleted - T/F where T means nothing ended the run

' Local Variables:
' @local hl - a step (HL_*)

    bCompleted := TRUE
    repeat hl from HL_4A to HL_DEF
        hlEnd[hl] := HE_NONE
        hlRun[hl] := 0
    if rowL56[rowIdx] == FALSE
        emitLegSkip(@sLegHandload)
        bSgNoSteps := TRUE
    else
        legStallMaMs := 0
        legStallCapMas := HAND_LEG_CAP_MAS
        bCompleted := bRunAttended(@sLegHandload, @handSteps, rowHandDef[rowIdx] ? HL_COUNT : HL_DEF)
        legStallCapMas := 0

PRI wkHandStep(hl) | nAmps, eLimErr, bSet, nFold0, nIlim0, nResync0, nLag0, nCap0, nResync1, nLag1, nCap1, eOutcome, eEnd
' A hand-load step (the measure cog): its limit set and read back, the drive at HAND_POWER from rest to AT_SPEED
' (wkHandArrive()), his grip to its end (wkHandAct()), the motor brought to rest whatever ended it, the run's 2 A test
' limit and abort put back and read back (a limit that does not read back ends the run, AR_LIMITS), and the step's
' RESULT phrase and readings set. Prints nothing.
'
' @param hl - HL_4A, HL_2A or HL_DEF

' Local Variables:
' @local nAmps - DAT handLimitA's limit, A (0: the default limits)
' @local eLimErr - testSetCurrentLimits()'s result
' @local bSet - T/F where T means the limit read back as asked
' @local nFold0 - EV_FOLDBACK's total before the drive
' @local nIlim0 - EV_CURRENT_LIMIT's
' @local nResync0 - the re-synced faults before the drive
' @local nLag0 - the held passes before the drive
' @local nCap0 - the capped passes
' @local nResync1 - the re-synced faults after it
' @local nLag1 - the held passes after it
' @local nCap1 - the capped passes after it
' @local eOutcome - a reading's outcome
' @local eEnd - HE_*: how the step ended

    hlRun[hl] := wkRun
    hlEnd[hl] := HE_SETUP
    bHlContact[hl] := FALSE
    bHlLatched[hl] := FALSE
    bHlStood[hl] := FALSE
    bHlRestored[hl] := FALSE
    hlLatchFromTick[hl] := -1
    hlLatchFromContact[hl] := -1
    hlContactMs[hl] := -1
    hlArrMs[hl] := -1
    hlFolds[hl] := 0
    hlFaults[hl] := 0
    hlIlim[hl] := 0
    hlResyncs[hl] := 0
    hlHeld[hl] := 0
    hlCapped[hl] := 0
    hlStallMas[hl] := 0
    hlProt[hl] := wheel.NO_ERROR
    hlStopReason[hl] := wheel.SR_NONE
    bHlLatchByEvent[hl] := FALSE
    hlCmdIncr[hl] := 0
    hlLastTickMs[hl] := 0
    hlStandMs[hl] := 0
    hlStandSpan[hl] := 0
    hlCreep[hl] := 0
    hlDcPeak[hl] := 0
    hlDcMean[hl] := 0
    hlDutyPeak[hl] := 0
    hlDutyMean[hl] := 0
    hlErrPeak[hl] := 0
    hlRestEnc[hl] := enc.readCount()
    nAmps := handLimitA[hl]
    wkStatus := (nAmps > 0) ? SG_ST_SET_LIMIT : SG_ST_SET_DEFAULT
    if nAmps > 0
        hlLimA[hl] := nAmps
        eLimErr := wheel.testSetCurrentLimits(nAmps, nAmps)
    else
        hlLimA[hl] := wheel.I_PEAK_A
        eLimErr := wheel.testSetCurrentLimits(wheel.I_PEAK_A, wheel.I_CONT_A)
    hlPeakRead[hl], hlContRead[hl], _, _, _ := wheel.testGetCurrentLimitState()
    hlLimErr[hl] := eLimErr
    bSet := (eLimErr == wheel.NO_ERROR) and (hlPeakRead[hl] == hlLimA[hl])
    eEnd := HE_SETUP
    if bSet
        if nAmps == 0
            abortMa := HAND_DEF_ABORT_MA                    ' the default step's own drive only (CON { the Doco's numbers })
        stepStallMaMs := 0
        stepStallCapMas := HAND_STEP_CAP_MAS
        wkDrainEvents()
        nFold0 := wheel.getEventTotal(wheel.EV_FOLDBACK)
        nIlim0 := wheel.getEventTotal(wheel.EV_CURRENT_LIMIT)
        _, _, nResync0 := wheel.testGetFaultResponse()
        nLag0, nCap0, _, _ := wheel.testGetDriveHealth()
        sampleBegin()
        eOutcome := sampleNext()                            ' a reading at rest: the sampler's base
        if bGuardStops(eOutcome)
            eEnd := HE_ABORTED
        elseif wheel.driveAtPower(HAND_POWER) <> wheel.NO_ERROR
            eEnd := HE_REFUSED
            clearProtect()
        else
            wkStatus := SG_ST_SPEEDING
            eEnd := wkHandArrive(hl)
            if eEnd == HE_NONE
                wkPhase := SG_PH_ACT
                wkStatus := SG_ST_GRIP_NOW
                eEnd := wkHandAct(hl)
        wkHandRest(hl, eEnd)
        _, _, nResync1 := wheel.testGetFaultResponse()
        nLag1, nCap1, _, _ := wheel.testGetDriveHealth()
        hlFolds[hl] := wheel.getEventTotal(wheel.EV_FOLDBACK) - nFold0
        hlIlim[hl] := wheel.getEventTotal(wheel.EV_CURRENT_LIMIT) - nIlim0
        hlResyncs[hl] := nResync1 - nResync0
        hlHeld[hl] := nLag1 - nLag0
        hlCapped[hl] := nCap1 - nCap0
        hlStallMas[hl] := stepStallMaMs / wheel.MS_PER_SEC
    abortMa := ABS_ABORT_MA
    stepStallCapMas := 0
    hlEnd[hl] := eEnd
    wkHandRestoreLimit(hl)
    wkHandResult(hl)

PRI wkHandArrive(hl) : eEnd | eRo, bStopped, nStartMs, nWholeMs
' The drive from rest to AT_SPEED at HAND_POWER, bounded by twice the generator's time to the command plus
' ARRIVE_MARGIN_MS; the increment the library wrote is the step's command (hlCmdIncr).
'
' @param hl - the step
' @returns eEnd - HE_NONE when it arrived, else HE_NO_SPEED, HE_FAULT, HE_ABORTED or HE_STOPPED

' Local Variables:
' @local eRo - the wait's outcome
' @local bStopped - T/F where T means STOP MOTOR ended the wait
' @local nStartMs - getms() at the command
' @local nWholeMs - the generator's time to the command from rest

    nStartMs := getms()
    hlCmdIncr[hl], _, _, _, _, _ := wheel.testGetDriveFollow()
    _, nWholeMs := scurveMs(abs(hlCmdIncr[hl]) #> 1, rampAccelUp, rampJerkUp, 0)
    eRo, bStopped := wkWaitAtSpeed(0, 2 * nWholeMs + ARRIVE_MARGIN_MS)
    eEnd := HE_NONE
    if bStopped
        eEnd := HE_STOPPED
    elseif eRo == RO_FAULT
        eEnd := HE_FAULT
    elseif eRo == RO_ABORTED
        eEnd := HE_ABORTED
    elseif eRo == RO_TIMEOUT
        eEnd := HE_NO_SPEED
    else
        hlArrMs[hl] := getms() - nStartMs
        hlCmdIncr[hl], _, _, _, _, _ := wheel.testGetDriveFollow()

PRI wkHandAct(hl) : eEnd | nActMs, nCmdCps, nCps, nLastPos, nLastTickMs, nContactMs, nStandMin, nStandMax, nNetMa, nResync0c, nResyncNow, nDcSum, nDcN, nDutySum, eOutcome, eProt, nLatchMs, ringMa[HAND_RING_MA_N], nRingIdx, nRingSum
' His grip, from AT_SPEED to the step's end: every reading takes the encoder's speed (the 35 ms ring), the driver's hall
' position (a change is a hall tick: its time is the reading's), the DC link and the duty; the grip is the speed under
' HAND_CONTACT_PM of the command. It ends on the first of: the blocked stop's latch (getProtectiveStop(); its time then
' read from its EV_STOP event, wkLatchEventMs()), the shaft standing HAND_NOLATCH_MS with no latch, the step's stall
' charge cap, a fault or re-sync, a guard, STOP MOTOR, no grip within HAND_GRIP_WAIT_MS, or HAND_ACT_MAX_MS.
'
' @param hl - the step
' @returns eEnd - HE_LATCHED, HE_NO_LATCH, HE_STEP_CAP, HE_FAULT, HE_ABORTED, HE_STOPPED, HE_NO_GRIP or HE_TIMEOUT

' Local Variables:
' @local nActMs - getms() when the ACT began (AT_SPEED)
' @local nCmdCps - the command's speed, encoder counts/s
' @local nCps - the encoder's speed now, counts/s
' @local nLastPos - the driver's hall position at the last tick
' @local nLastTickMs - getms() of the reading that showed the last tick (AT_SPEED's, before any)
' @local nContactMs - getms() of the grip's first reading, 0 before it
' @local nStandMin - the encoder's lowest count since the last tick
' @local nStandMax - its highest
' @local nNetMa - a reading's DC link, mA
' @local nResync0c - the re-synced faults at the grip
' @local nResyncNow - the re-synced faults now
' @local nDcSum - the DC link summed from the grip, mA
' @local nDcN - readings in it
' @local nDutySum - the duty summed from the grip
' @local eOutcome - a reading's outcome
' @local eProt - the protective stop latched, NO_ERROR none
' @local nLatchMs - getms() of the latch
' @local ringMa - the last HAND_RING_MA_N readings' DC link, mA: the live current
' @local nRingIdx - the ring's next slot
' @local nRingSum - its sum

    nActMs := getms()
    nCmdCps := cmdCpsX1000(hlCmdIncr[hl]) / PM
    nLastPos := smpPos
    nLastTickMs := nActMs
    nContactMs := 0
    nStandMin := smpEnc
    nStandMax := smpEnc
    nDcSum := 0
    nDcN := 0
    nDutySum := 0
    nResync0c := 0
    hlDcPeak[hl] := 0
    hlDutyPeak[hl] := 0
    hlErrPeak[hl] := 0
    nRingSum := 0
    nRingIdx := 0
    longfill(@ringMa, 0, HAND_RING_MA_N)
    eEnd := HE_NONE
    repeat while eEnd == HE_NONE
        eOutcome := sampleNext()
        nNetMa := netMilliamps(smpSenseMv)
        nRingSum += nNetMa - ringMa[nRingIdx]
        ringMa[nRingIdx] := nNetMa
        nRingIdx := (nRingIdx + 1) // HAND_RING_MA_N
        nCps := ringSpeedCps()
        if smpPos <> nLastPos                               ' a hall tick: the stand restarts
            nLastPos := smpPos
            nLastTickMs := smpMs
            nStandMin := smpEnc
            nStandMax := smpEnc
        else
            nStandMin <#= smpEnc
            nStandMax #>= smpEnc
        if (nContactMs == 0) and (abs(nCps) * PM < nCmdCps * HAND_CONTACT_PM)
            nContactMs := smpMs                             ' his grip: the shaft under half its command
            hlContactEnc[hl] := smpEnc
            _, _, nResync0c := wheel.testGetFaultResponse()
            bHlContact[hl] := TRUE
        if nContactMs <> 0
            nDcSum += nNetMa
            nDcN++
            nDutySum += smpDuty
            hlDcPeak[hl] #>= nNetMa
            hlDutyPeak[hl] #>= smpDuty
            hlErrPeak[hl] #>= abs(smpErr)
        wkRead1 := wkRpm(nCps)
        wkRead2 := (nRingSum / HAND_RING_MA_N) #> 0
        eProt := wheel.getProtectiveStop()
        _, _, nResyncNow := wheel.testGetFaultResponse()
        if bGuardStops(eOutcome)
            eEnd := HE_ABORTED
        elseif eProt <> wheel.NO_ERROR
            eEnd := HE_LATCHED
            hlProt[hl] := eProt
            nLatchMs, bHlLatchByEvent[hl] := wkLatchEventMs(smpMs)
            bHlLatched[hl] := TRUE
            wkStatus := SG_ST_LATCHED
        elseif (eOutcome == BO_FAULT) or (nResyncNow <> nResync0c and nContactMs <> 0)
            eEnd := HE_FAULT
            wkStatus := SG_ST_NM_FAULT
        elseif eOutcome == BO_STEP_CAP
            eEnd := HE_STEP_CAP
            wkStatus := SG_ST_STEPCAP
        elseif bWkStopReq
            eEnd := HE_STOPPED
        elseif (nContactMs <> 0) and (smpMs - nLastTickMs >= HAND_NOLATCH_MS)
            eEnd := HE_NO_LATCH
            bHlStood[hl] := TRUE
            wkStatus := SG_ST_NOLATCH
        elseif (nContactMs == 0) and (smpMs - nActMs >= HAND_GRIP_WAIT_MS)
            eEnd := HE_NO_GRIP
        elseif smpMs - nActMs >= HAND_ACT_MAX_MS
            eEnd := HE_TIMEOUT
        elseif nContactMs == 0
            wkStatus := SG_ST_GRIP_NOW
        elseif smpMs - nLastTickMs >= HAND_STAND_SHOW_MS
            wkStatus := SG_ST_STANDING
        else
            wkStatus := SG_ST_SLOWING
    hlLastTickMs[hl] := nLastTickMs - nActMs
    hlStandMs[hl] := smpMs - nLastTickMs
    hlStandSpan[hl] := nStandMax - nStandMin
    hlDcMean[hl] := divRound(nDcSum, nDcN #> 1)
    hlDutyMean[hl] := divRound(nDutySum, nDcN #> 1)
    if nContactMs <> 0
        hlContactMs[hl] := nContactMs - nActMs
        hlCreep[hl] := smpEnc - hlContactEnc[hl]
        hlFaults[hl] := nResyncNow - nResync0c
        if (eEnd == HE_FAULT) and (hlFaults[hl] == 0)
            hlFaults[hl] := 1                               ' a fault the driver held, not re-synced
    if eEnd == HE_LATCHED
        hlLatchFromTick[hl] := nLatchMs - nLastTickMs
        hlStandMs[hl] := nLatchMs - nLastTickMs
        if nContactMs <> 0
            hlLatchFromContact[hl] := nLatchMs - nContactMs
        hlStopReason[hl] := wheel.getStopReason()

PRI wkHandRest(hl, eEnd) | bGoOn, nFinal
' Bring the motor to rest whatever ended the step: a latch has stopped it (its protective stop is cleared, the front
' cog writing a zero command first); a fault is recovered (bFaultRecover()); a guard has already coasted it; anything
' else is stopped on the built-in ramp (bStopAndRest()). Then the shaft's rest from the encoder (his hand may hold it).
'
' @param hl - the step
' @param eEnd - HE_*

' Local Variables:
' @local bGoOn - T/F where T means no guard ended the run
' @local nFinal - the encoder's count at rest

    bGoOn := TRUE
    case eEnd
        HE_ABORTED, HE_SETUP, HE_REFUSED:
            bGoOn := FALSE                                  ' nothing to stop: a guard coasted it, or it never drove
        HE_LATCHED:
            clearProtect()
        HE_FAULT:
            bGoOn := bFaultRecover()
        other:
            bGoOn, _ := bStopAndRest(FALSE)
    nFinal := smpEnc
    if bGoOn
        bGoOn, nFinal, _, _ := restQuiet()
    hlRestEnc[hl] := nFinal

PRI wkHandRestoreLimit(hl) | eErr, nPeakA, nContA
' Put back the run's test limit (TEST_PEAK_A / TEST_CONT_A) and read it back; one that does not take ends the run
' (AR_LIMITS) -- every later step would drive at this step's limit. After a guard ended the run the driver is stopped
' and nothing is put back (the run is over).
'
' @param hl - the step

' Local Variables:
' @local eErr - testSetCurrentLimits()'s result
' @local nPeakA - the peak limit read back, A
' @local nContA - the continuous limit read back, A

    bHlRestored[hl] := FALSE
    if eAbortReason == AR_NONE
        eErr := wheel.testSetCurrentLimits(TEST_PEAK_A, TEST_CONT_A)
        nPeakA, nContA, _, _, _ := wheel.testGetCurrentLimitState()
        bHlRestored[hl] := (eErr == wheel.NO_ERROR) and (nPeakA == TEST_PEAK_A) and (nContA == TEST_CONT_A)
        if bHlRestored[hl] == FALSE
            coastNow()
            setAbort(AR_LIMITS, (eErr <> wheel.NO_ERROR) ? eErr : nPeakA)

PRI wkHandResult(hl)
' The step's RESULT phrase and readings (wkWhy, wkRes1, wkRes2) from how it ended.
'
' @param hl - the step

    wkRes1 := -1
    wkRes2 := hlDcPeak[hl]
    case hlEnd[hl]
        HE_LATCHED:
            wkWhy := SG_ST_MEASURED
            wkRes1 := hlLatchFromTick[hl]
        HE_NO_LATCH:
            wkWhy := SG_ST_MEASURED                         ' measured: it stood HAND_NOLATCH_MS with no stop (a FAIL)
            wkRes1 := HAND_NOLATCH_MS
        HE_STEP_CAP:    wkWhy := SG_ST_NM_STEPCAP
        HE_STOPPED:     wkWhy := SG_ST_NM_STOPPED
        HE_NO_GRIP:     wkWhy := SG_ST_NM_NO_GRIP
        HE_TIMEOUT:     wkWhy := SG_ST_NM_NO_STAND
        HE_FAULT:       wkWhy := SG_ST_NM_FAULT
        HE_NO_SPEED:    wkWhy := SG_ST_NM_NO_SPEED
        other:          wkWhy := SG_ST_NM_SETUP
    wkRead1 := -1
    wkRead2 := -1

PRI emitHandStep(hl, seqNum, runNum)
' Emit B1-HAND (the step: its limit, how it ended, the grip and the last tick), B1-HANDL (the latch, the stand, the
' shaft's creep, the stall charge) and B1-HANDD (the drive under the hand: current, duty, the limiters' counts) -- three
' records, each under the 280-byte bound at its fields' widest. Cog 0, at rest.
'
' @param hl - the step
' @param seqNum - its number in the leg, 1-based
' @param runNum - its run, 1-based

    benchLog.begin(@"B1-HAND")
    benchLog.numField(@"step", seqNum, LIM_TINY)
    benchLog.numField(@"run", runNum, LIM_TINY)
    benchLog.numField(@"limit_a", hlLimA[hl], LIM_TINY)
    benchLog.numField(@"peak_a", hlPeakRead[hl], LIM_TINY)
    benchLog.numField(@"cont_a", hlContRead[hl], LIM_TINY)
    benchLog.numField(@"lim_err", hlLimErr[hl], LIM_SMALL)
    benchLog.tokenField(@"end", heToken(hlEnd[hl]), TOKMAX_HE)
    benchLog.numField(@"incr", hlCmdIncr[hl], LIM_BIG)
    benchLog.naNumField(@"arr_ms", hlArrMs[hl], LIM_SMALL, hlArrMs[hl] >= 0)
    benchLog.naNumField(@"contact_ms", hlContactMs[hl], LIM_SMALL, bHlContact[hl])
    benchLog.numField(@"last_tick_ms", hlLastTickMs[hl], LIM_SMALL)
    benchLog.boolField(@"restored", bHlRestored[hl])
    lineEmit()
    benchLog.begin(@"B1-HANDL")
    benchLog.numField(@"step", seqNum, LIM_TINY)
    benchLog.numField(@"run", runNum, LIM_TINY)
    benchLog.naNumField(@"latch_tick_ms", hlLatchFromTick[hl], LIM_SMALL, bHlLatched[hl])
    benchLog.naNumField(@"latch_grip_ms", hlLatchFromContact[hl], LIM_SMALL, bHlLatched[hl] and bHlContact[hl])
    benchLog.boolField(@"by_event", bHlLatchByEvent[hl])
    benchLog.numField(@"stand_ms", hlStandMs[hl], LIM_SMALL)
    benchLog.numField(@"stand_span_cnt", hlStandSpan[hl], LIM_SMALL)
    benchLog.naNumField(@"creep_cnt", hlCreep[hl], LIM_MID, bHlContact[hl])
    benchLog.numField(@"prot", hlProt[hl], LIM_SMALL)
    benchLog.tokenField(@"sr", srToken(hlStopReason[hl]), TOKMAX_SR)
    benchLog.numField(@"stall_mas", hlStallMas[hl], LIM_MID)
    benchLog.numField(@"leg_stall_mas", legStallMaMs / wheel.MS_PER_SEC, LIM_MID)
    benchLog.numField(@"rest_enc", hlRestEnc[hl], LIM_BIG)
    lineEmit()
    benchLog.begin(@"B1-HANDD")
    benchLog.numField(@"step", seqNum, LIM_TINY)
    benchLog.numField(@"run", runNum, LIM_TINY)
    benchLog.numField(@"dc_peak_ma", hlDcPeak[hl], LIM_MID)
    benchLog.numField(@"dc_mean_ma", hlDcMean[hl], LIM_MID)
    benchLog.numField(@"duty_peak", hlDutyPeak[hl], LIM_MID)
    benchLog.numField(@"duty_mean", hlDutyMean[hl], LIM_MID)
    benchLog.numField(@"err_pk", hlErrPeak[hl], LIM_SMALL)
    benchLog.numField(@"folds", hlFolds[hl], LIM_SMALL)
    benchLog.numField(@"ilim", hlIlim[hl], LIM_SMALL)
    benchLog.numField(@"held", hlHeld[hl], LIM_MID)
    benchLog.numField(@"capped", hlCapped[hl], LIM_MID)
    benchLog.numField(@"resyncs", hlResyncs[hl], LIM_SMALL)
    benchLog.numField(@"faults", hlFaults[hl], LIM_SMALL)
    lineEmit()

PRI bLimHoldMeasured(hl) : bMeasured
' R23-SGL-LIMHOLD's precondition for a step: run, his grip seen, and the fold-back engaged -- or, task 3686 (the
' exclusion check), a fault after his grip, which is judged with or without a fold.
'
' @param hl - HL_4A or HL_2A
' @returns bMeasured - T/F where T means judged

    bMeasured := (hlRun[hl] > 0) and bHlContact[hl] and ((hlFolds[hl] >= 1) or (hlFaults[hl] > 0))

PRI bBlkStopMeasured(hl) : bMeasured
' R23-SGL-BLKSTOP's precondition for a step: run, and the latch, or the shaft standing HAND_NOLATCH_MS.
'
' @param hl - the step
' @returns bMeasured - T/F where T means judged

    bMeasured := (hlRun[hl] > 0) and (bHlLatched[hl] or (hlEnd[hl] == HE_NO_LATCH))

PRI blkStopValue(hl) : nMs
' R23-SGL-BLKSTOP's reading for a step: the latch from the last tick, or HAND_NOLATCH_MS for a stand with none.
'
' @param hl - the step
' @returns nMs - ms

    nMs := bHlLatched[hl] ? hlLatchFromTick[hl] : HAND_NOLATCH_MS

PRI hlInst(hl) : pToken
' A hand-load step's instance token.
'
' @param hl - HL_*
' @returns pToken - pointer to LIM-4A, LIM-2A or LIM-DEF

    case hl
        HL_4A:  pToken := @sInstLim4a
        HL_2A:  pToken := @sInstLim2a
        other:  pToken := @sInstLimDef

PRI heToken(eEnd) : pToken
' A hand-load step's end, for the log.
'
' @param eEnd - HE_*
' @returns pToken - pointer to its name

    case eEnd
        HE_NONE:        pToken := @sHeNone
        HE_LATCHED:     pToken := @sHeLatched
        HE_NO_LATCH:    pToken := @sHeNoLatch
        HE_STEP_CAP:    pToken := @sHeStepCap
        HE_STOPPED:     pToken := @sHeStopped
        HE_NO_GRIP:     pToken := @sHeNoGrip
        HE_TIMEOUT:     pToken := @sHeTimeout
        HE_FAULT:       pToken := @sHeFault
        HE_NO_SPEED:    pToken := @sHeNoSpeed
        HE_REFUSED:     pToken := @sHeRefused
        HE_ABORTED:     pToken := @sHeAborted
        HE_SETUP:       pToken := @sHeSetup
        other:          pToken := @sNa
#endif

CON { --- L-heldpush (the analysis's L6): the held stop pushed by hand, attended --- }

#ifdef SINGLE_PART_HELDPUSH
PRI bRunHeldPush() : bCompleted | eDir
' L-heldpush: at a DAT rowL56 row, its two steps on the panel (bRunAttended()). At another row nothing drives
' (B1-LEGSKIP). Cog 0.
'
' @returns bCompleted - T/F where T means nothing ended the run

' Local Variables:
' @local eDir - a measured direction

    bCompleted := TRUE
    hpRun[0] := 0
    hpRun[1] := 0
    repeat eDir from DIR_RISE to DIR_FALL
        bSfRiseMeas[eDir] := FALSE
        bSfSlipMeas[eDir] := FALSE
    if rowL56[rowIdx] == FALSE
        emitLegSkip(@sLegHeldpush)
        bSgNoSteps := TRUE
    else
        bCompleted := bRunAttended(@sLegHeldpush, @heldSteps, 2)

PRI wkHeldStep(hp) | eErr, nCeilPct, nRiseMs, nLimitMs, bFresh, nSlips0, nLimits0, nSlips1, nLimits1, eDir
' A held-stop step (the measure cog): the hold at the library's defaults, armed fresh as T0-24 arms it (the stop mode
' floated HELD_REARM_MS so the front cog reads HS_OFF, then SM_BRAKE again: a new hold where the shaft now is), its
' freshness read (HS_HOLDING at displacement 0, no fault signal); then his turn (wkHeldAct()); then the run's coast at
' rest put back (holdAtStop(FALSE)) and read back -- a hold left on ends the run (AR_SETTING); then the cells' readings
' for the direction he turned, and the RESULT phrase. Prints nothing.
'
' @param hp - 0 (HP_ONE) or 1 (HP_OTHER)

' Local Variables:
' @local eErr - setHoldLimits()'s result
' @local nCeilPct - the hold limits read back: ceiling, %
' @local nRiseMs - rise, ms
' @local nLimitMs - time limit, ms
' @local bFresh - T/F where T means a fresh hold at the library's defaults
' @local nSlips0 - testGetHold()'s slip count before
' @local nLimits0 - its limit count before
' @local nSlips1 - after
' @local nLimits1 - after
' @local eDir - the measured direction, DIR_*

    hpRun[hp] := wkRun
    bHpTurned[hp] := FALSE
    bHpSlipped[hp] := FALSE
    hpRiseMs[hp] := RISE_NOT_SEEN
    hpSlipMs[hp] := -1
    hpLimitMs[hp] := -1
    hpLimitTicks[hp] := -1
    hpCeilMs[hp] := -1
    hpFirstEdgeMs[hp] := -1
    hpSlipCnt[hp] := 0
    hpSlipTicks[hp] := 0
    hpSlipDps[hp] := 0
    hpNetTicks[hp] := 0
    hpEdges[hp] := 0
    hpBad[hp] := 0
    hpLost[hp] := 0
    hpFirstEdgeCnt[hp] := 0
    hpRiseSpan[hp] := 0
    hpRiseGain[hp] := 0
    hpPeakDuty[hp] := 0
    hpPreDispMax[hp] := 0
    hpDcCeil[hp] := 0
    hpMaxTurn[hp] := 0
    hpRestEnc[hp] := enc.readCount()
    wkStatus := SG_ST_ARM_HOLD
    eErr := wheel.setHoldLimits(wheel.HOLD_CEILING_PCT, wheel.HOLD_RISE_MS, wheel.HOLD_LIMIT_MS)
    nCeilPct, nRiseMs, nLimitMs := wheel.getHoldLimits()
    wheel.clearFaultSignal()
    wheel.holdAtStop(FALSE)
    wheel.stopMotor()
    waitms(HELD_REARM_MS)
    hpOffHs[hp], _ := wheel.getHoldStatus()
    wheel.holdAtStop(TRUE)
    wheel.stopMotor()
    waitms(HELD_SETTLE_MS)
    hpStartHs[hp], hpStartDisp[hp] := wheel.getHoldStatus()
    bFresh := (eErr == wheel.NO_ERROR) and (nCeilPct == wheel.HOLD_CEILING_PCT) and (nRiseMs == wheel.HOLD_RISE_MS)
    bFresh &= (nLimitMs == wheel.HOLD_LIMIT_MS) and (hpOffHs[hp] == wheel.HS_OFF) and (hpStartHs[hp] == wheel.HS_HOLDING)
    bFresh &= (hpStartDisp[hp] == 0) and (wheel.isFaultSignal() == FALSE)
    bHpFresh[hp] := bFresh
    _, _, hpDutyMin[hp], _, _, _ := wheel.testGetDriveConstants()
    _, hpCeil[hp], _, nSlips0, nLimits0 := wheel.testGetHold()
    if bFresh
        wkPhase := SG_PH_ACT
        wkStatus := SG_ST_TURN_NOW
        wkHeldAct(hp)
    _, _, _, nSlips1, nLimits1 := wheel.testGetHold()
    hpSlipsD[hp] := nSlips1 - nSlips0
    hpLimitsD[hp] := nLimits1 - nLimits0
    wheel.holdAtStop(FALSE)                                 ' the run's coast at rest, as bStartMotor() left it
    wheel.stopMotor()
    bHpRestored[hp] := (wheel.isHoldAtStop() == FALSE)
    if (bHpRestored[hp] == FALSE) and (eAbortReason == AR_NONE)
        coastNow()
        setAbort(AR_SETTING, -1)
    eDir := (hpNetTicks[hp] >= 0) ? DIR_RISE : DIR_FALL
    if bFresh and bHpTurned[hp] and (hpFirstEdgeMs[hp] >= 0)
        sfRiseMs[eDir] := hpRiseMs[hp]
        bSfRiseMeas[eDir] := (hpRiseMs[hp] <> RISE_NOT_SEEN)
    if bFresh and bHpSlipped[hp] and (hpLost[hp] == 0)
        sfSlipTicks[eDir] := hpSlipTicks[hp]
        bSfSlipMeas[eDir] := TRUE
    elseif bFresh and (hpLimitTicks[hp] > wheel.HOLD_SLIP_TICKS) and (hpLost[hp] == 0)
        sfSlipTicks[eDir] := hpLimitTicks[hp]               ' task 3686: it let go at its time limit, past its slip: a FAIL
        bSfSlipMeas[eDir] := TRUE
    wkHeldResult(hp)

PRI wkHeldAct(hp) | nActMs, eOutcome, nDuty, nCeil, eHs, nDisp, nTurn, bDisplaced, bPriorRising, bRising, nPriorMs, nPriorDuty, nQuietRef, nLastMoveMs, bTaken, nEnc, nCode, nPrev, nTick, nLost0, nDcSum, nDcN, bEnded
' His turn of the held shaft (the measure cog): every reading takes testGetHold() and getHoldStatus(), the encoder, and
' every hall edge the encoder object captured (its count latched AT the edge, classified by this harness's own order
' table): the net ticks of the push, the first edge's count and reading. The hold's rise by its RATE (T0-24's rule,
' PL-130): the duty gained over the reading pairs displaced, under the ceiling and HS_HOLDING at both ends; the duty's
' highest before any displacement (P-H4: duty_min until the first edge). It ends when the hold has given way (or let go
' at its limit) and the encoder has been still HELD_RELEASE_MS (he has let go: the sensor sees him finish), on DONE, on
' no turn within HELD_WAIT_MS, or at HELD_ACT_MAX_MS.
'
' @param hp - the step

' Local Variables:
' @local nActMs - getms() when the ACT began
' @local eOutcome - a reading's outcome
' @local nDuty - testGetHold()'s duty now
' @local nCeil - its ceiling
' @local eHs - getHoldStatus()'s state, HS_*
' @local nDisp - its displacement, hall ticks
' @local nTurn - the encoder's count from where the shaft rested
' @local bDisplaced - T/F where T means the halls have read a displacement
' @local bPriorRising - T/F where T means the previous reading was rising (displaced, under the ceiling, holding)
' @local bRising - this reading's
' @local nPriorMs - the previous reading's getms()
' @local nPriorDuty - its duty
' @local nQuietRef - the count the stillness is measured against
' @local nLastMoveMs - getms() the encoder last moved past REST_JITTER_COUNTS
' @local bTaken - T/F where T means takeEdge() returned an edge
' @local nEnc - its latched count
' @local nCode - its new hall code
' @local nPrev - its previous code
' @local nTick - TICK_RISE, TICK_FALL or TICK_BAD
' @local nLost0 - the encoder object's lost edges at the start
' @local nDcSum - the DC link summed while at the ceiling and holding, mA
' @local nDcN - readings in it
' @local bEnded - T/F where T means the ACT is over

    drainEdges()                                            ' only this turn's edges
    nLost0 := enc.edgesLost()
    hpRestEnc[hp] := enc.readCount()
    hpPreDispMax[hp] := hpDutyMin[hp]
    hpPeakDuty[hp] := 0
    hpEdges[hp] := 0
    hpBad[hp] := 0
    hpRiseSpan[hp] := 0
    hpRiseGain[hp] := 0
    hpMaxTurn[hp] := 0
    nDcSum := 0
    nDcN := 0
    bDisplaced := FALSE
    bPriorRising := FALSE
    nPriorMs := 0
    nPriorDuty := 0
    sampleBegin()
    nActMs := getms()
    nQuietRef := hpRestEnc[hp]
    nLastMoveMs := nActMs
    bEnded := FALSE
    repeat while bEnded == FALSE
        eOutcome := sampleNext()
        nDuty, nCeil, _, _, _ := wheel.testGetHold()
        eHs, nDisp := wheel.getHoldStatus()
        repeat
            bTaken, nEnc, nCode, nPrev, _ := enc.takeEdge()
            if bTaken == FALSE
                quit
            nTick, _ := classifyEdge((nCode & CODE_MASK) | ((nPrev & CODE_MASK) << CODE_PREV_SHIFT))
            if nTick == TICK_BAD
                hpBad[hp]++
            else
                hpNetTicks[hp] += nTick
                hpEdges[hp]++
                if hpFirstEdgeMs[hp] < 0
                    hpFirstEdgeMs[hp] := smpMs - nActMs
                    hpFirstEdgeCnt[hp] := nEnc - hpRestEnc[hp]
        nTurn := smpEnc - hpRestEnc[hp]
        hpMaxTurn[hp] #>= abs(nTurn)
        if abs(nTurn) > HELD_TURN_COUNTS
            bHpTurned[hp] := TRUE
        if abs(smpEnc - nQuietRef) > REST_JITTER_COUNTS
            nQuietRef := smpEnc
            nLastMoveMs := smpMs
        if bDisplaced == FALSE
            if nDisp <> 0
                bDisplaced := TRUE
            else
                hpPreDispMax[hp] #>= nDuty                  ' P-H4: duty_min until the halls see the push
        bRising := (nDisp <> 0) and (nDuty < nCeil) and (eHs == wheel.HS_HOLDING)
        if bPriorRising and bRising                         ' PL-130: rising at both ends
            hpRiseSpan[hp] += smpMs - nPriorMs
            hpRiseGain[hp] += nDuty - nPriorDuty
        bPriorRising := bRising
        nPriorMs := smpMs
        nPriorDuty := nDuty
        hpPeakDuty[hp] #>= nDuty
        if (eHs == wheel.HS_HOLDING) and (nDuty >= nCeil)
            nDcSum += netMilliamps(smpSenseMv)
            nDcN++
            if hpCeilMs[hp] < 0
                hpCeilMs[hp] := smpMs - nActMs
        if (eHs == wheel.HS_SLIPPED) and (hpSlipMs[hp] < 0)
            hpSlipMs[hp] := smpMs - nActMs
            hpSlipCnt[hp] := abs(nTurn)
            hpSlipTicks[hp] := abs(hpNetTicks[hp])
            hpSlipDps[hp] := abs(ringSpeedCps()) * 360 / ENC_COUNTS_PER_REV
            bHpSlipped[hp] := TRUE
        if (eHs == wheel.HS_LIMITED) and (hpLimitMs[hp] < 0)
            hpLimitMs[hp] := smpMs - nActMs
            hpLimitTicks[hp] := abs(hpNetTicks[hp])         ' task 3686: past HOLD_SLIP_TICKS here, it never slipped where it should
        wkRead1 := abs(nTurn) * 360 / ENC_COUNTS_PER_REV
        wkRead2 := (nCeil > 0) ? (nDuty * 100 / nCeil) : 0
        if bGuardStops(eOutcome)
            bEnded := TRUE
        elseif ((hpSlipMs[hp] >= 0) or (hpLimitMs[hp] >= 0)) and (smpMs - nLastMoveMs >= HELD_RELEASE_MS)
            bEnded := TRUE                                  ' it gave way and he let go: the sensor saw him finish
        elseif bWkDoneReq
            bEnded := TRUE
        elseif (bHpTurned[hp] == FALSE) and (smpMs - nActMs >= HELD_WAIT_MS)
            bEnded := TRUE
        elseif smpMs - nActMs >= HELD_ACT_MAX_MS
            bEnded := TRUE
        if hpSlipMs[hp] >= 0
            wkStatus := SG_ST_GAVE_WAY
        elseif hpLimitMs[hp] >= 0
            wkStatus := SG_ST_HOLD_LIMITED
        elseif bHpTurned[hp] == FALSE
            wkStatus := SG_ST_TURN_NOW
        elseif bDisplaced == FALSE
            wkStatus := SG_ST_TURNED_FREE
        elseif nDuty >= nCeil
            wkStatus := SG_ST_AT_CEIL
        else
            wkStatus := SG_ST_PUSHING
    hpLost[hp] := enc.edgesLost() - nLost0
    hpDcCeil[hp] := divRound(nDcSum, nDcN #> 1)
    if hpPreDispMax[hp] > hpDutyMin[hp]
        hpRiseMs[hp] := -1                                  ' the duty rose before any displacement: P-H4's negative
    elseif (hpRiseSpan[hp] >= RISE_MIN_SPAN_MS) and (hpRiseGain[hp] > 0)
        hpRiseMs[hp] := muldiv64(hpCeil[hp] - hpDutyMin[hp], hpRiseSpan[hp], hpRiseGain[hp])
    elseif hpRiseSpan[hp] >= RISE_MIN_SPAN_MS
        hpRiseMs[hp] := HOLDRISE_NONE_MS                    ' task 3686: displaced that long and no rise -- a hold that does not push back
    else
        hpRiseMs[hp] := RISE_NOT_SEEN                       ' too little rising time to rate it (a flick)

PRI wkHeldResult(hp)
' A held-stop step's RESULT phrase and readings: the angle it gave way at (degrees from where it rested) and the rise.
'
' @param hp - the step

    wkRes1 := bHpSlipped[hp] ? (hpSlipCnt[hp] * 360 / ENC_COUNTS_PER_REV) : -1
    wkRes2 := (hpRiseMs[hp] >= 0) ? hpRiseMs[hp] : -1
    if bHpFresh[hp] == FALSE
        wkWhy := SG_ST_NM_NOT_FRESH
    elseif bHpTurned[hp] == FALSE
        wkWhy := SG_ST_NM_NO_TURN
    elseif bHpSlipped[hp] == FALSE
        wkWhy := (hpLimitMs[hp] >= 0) ? SG_ST_HOLD_LIMITED : SG_ST_NM_NO_SLIP
    elseif hpRiseMs[hp] == RISE_NOT_SEEN
        wkWhy := SG_ST_RISE_TOO_FAST
    elseif (hp == 1) and (hpRun[0] > 0) and ((hpNetTicks[0] >= 0) == (hpNetTicks[1] >= 0))
        wkWhy := SG_ST_SAME_WAY
    else
        wkWhy := SG_ST_MEASURED
    wkRead1 := -1
    wkRead2 := -1

PRI emitHeldStep(hp, seqNum, runNum)
' Emit B1-HPUSH (the hold: armed fresh, the push's direction, its edges), B1-HPUSHR (the rise and the slip) and
' B1-HPUSHD (the duty and the current at the ceiling) -- each under the 280-byte bound at its fields' widest. Cog 0, at
' rest.
'
' @param hp - the step
' @param seqNum - its number in the leg, 1-based
' @param runNum - its run, 1-based

    benchLog.begin(@"B1-HPUSH")
    benchLog.numField(@"step", seqNum, LIM_TINY)
    benchLog.numField(@"run", runNum, LIM_TINY)
    benchLog.boolField(@"fresh", bHpFresh[hp])
    benchLog.numField(@"off_hs", hpOffHs[hp], LIM_TINY)
    benchLog.numField(@"start_hs", hpStartHs[hp], LIM_TINY)
    benchLog.numField(@"start_disp", hpStartDisp[hp], LIM_SMALL)
    benchLog.tokenField(@"dir", directionToken(hpNetTicks[hp]), TOKMAX_DIR)
    benchLog.numField(@"net_ticks", hpNetTicks[hp], LIM_SMALL)
    benchLog.numField(@"edges", hpEdges[hp], LIM_SMALL)
    benchLog.numField(@"bad", hpBad[hp], LIM_SMALL)
    benchLog.numField(@"lost", hpLost[hp], LIM_SMALL)
    benchLog.naNumField(@"first_edge_cnt", hpFirstEdgeCnt[hp], LIM_SMALL, hpFirstEdgeMs[hp] >= 0)
    benchLog.naNumField(@"first_edge_ms", hpFirstEdgeMs[hp], LIM_MID, hpFirstEdgeMs[hp] >= 0)
    lineEmit()
    benchLog.begin(@"B1-HPUSHR")
    benchLog.numField(@"step", seqNum, LIM_TINY)
    benchLog.numField(@"run", runNum, LIM_TINY)
    benchLog.naNumField(@"rise_ms", hpRiseMs[hp], LIM_SMALL, hpRiseMs[hp] <> RISE_NOT_SEEN)
    benchLog.numField(@"rise_span_ms", hpRiseSpan[hp], LIM_MID)
    benchLog.naNumField(@"ceil_ms", hpCeilMs[hp], LIM_MID, hpCeilMs[hp] >= 0)
    benchLog.naNumField(@"slip_ms", hpSlipMs[hp], LIM_MID, hpSlipMs[hp] >= 0)
    benchLog.naNumField(@"slip_cnt", hpSlipCnt[hp], LIM_SMALL, bHpSlipped[hp])
    benchLog.naNumField(@"slip_ticks", hpSlipTicks[hp], LIM_SMALL, bHpSlipped[hp])
    benchLog.naNumField(@"slip_dps", hpSlipDps[hp], LIM_SMALL, bHpSlipped[hp])
    benchLog.naNumField(@"limit_ms", hpLimitMs[hp], LIM_MID, hpLimitMs[hp] >= 0)
    benchLog.naNumField(@"limit_ticks", hpLimitTicks[hp], LIM_SMALL, hpLimitTicks[hp] >= 0)
    lineEmit()
    benchLog.begin(@"B1-HPUSHD")
    benchLog.numField(@"step", seqNum, LIM_TINY)
    benchLog.numField(@"run", runNum, LIM_TINY)
    benchLog.numField(@"duty_min", hpDutyMin[hp], LIM_MID)
    benchLog.numField(@"ceil_duty", hpCeil[hp], LIM_MID)
    benchLog.numField(@"pre_disp_max", hpPreDispMax[hp], LIM_MID)
    benchLog.numField(@"peak_duty", hpPeakDuty[hp], LIM_MID)
    benchLog.numField(@"rise_gain", hpRiseGain[hp], LIM_MID)
    benchLog.numField(@"dc_ceil_ma", hpDcCeil[hp], LIM_MID)
    benchLog.numField(@"max_turn_cnt", hpMaxTurn[hp], LIM_MID)
    benchLog.numField(@"rest_enc", hpRestEnc[hp], LIM_BIG)
    benchLog.numField(@"slips_d", hpSlipsD[hp], LIM_SMALL)
    benchLog.numField(@"limits_d", hpLimitsD[hp], LIM_SMALL)
    benchLog.boolField(@"restored", bHpRestored[hp])
    lineEmit()

PRI dirToken(eDir) : pToken
' A measured direction's instance token.
'
' @param eDir - DIR_RISE or DIR_FALL
' @returns pToken - pointer to RISE or FALL

    pToken := (eDir == DIR_RISE) ? @sDirRise : @sDirFall
#endif

CON { --- L-sag (the analysis's L4, OPTIONAL): the supply dialled down at the top, attended --- }

#ifdef SINGLE_PART_SAG
PRI bRunSag() : bCompleted
' L-sag: at a DAT sagIncr row, its one step on the panel (bRunAttended()): the fault-first case at a sagExpectFault row,
' the slip-first case at another. At another row nothing drives (B1-LEGSKIP). Cog 0.
'
' @returns bCompleted - T/F where T means nothing ended the run

    bCompleted := TRUE
    sgSagRun := 0
    bSfSagMeas := FALSE
    if sagIncr[rowIdx] == 0
        emitLegSkip(@sLegSag)
        bSgNoSteps := TRUE
    elseif sagExpectFault[rowIdx]
        bCompleted := bRunAttended(@sLegSag, @sagFaultSteps, 1)
    else
        bCompleted := bRunAttended(@sLegSag, @sagSlipSteps, 1)

PRI wkSagStep() | nWholeMs, eRo, bStopped, nResync0, nResync1, nLag0, nLag1, eOutcome, bGoOn, nCmdMs
' A sag step (the measure cog): from rest to the row's DAT sagIncr by the test path (NEGATIVE increments: the Doco's
' forward, ADDING_MOTOR.md step 6), AT_SPEED and SAG_SETTLE_MS, then his dial-down (wkSagAct()), then the motor to rest
' (a fault recovered, else stopped on the built-in ramp). Prints nothing.

' Local Variables:
' @local nWholeMs - the generator's time to the command from rest
' @local eRo - the arrival's outcome
' @local bStopped - T/F where T means STOP MOTOR ended the arrival
' @local nResync0 - the re-synced faults before the drive
' @local nResync1 - after it
' @local nLag0 - the held passes before
' @local nLag1 - after
' @local eOutcome - a reading's outcome
' @local bGoOn - T/F where T means no guard ended the run
' @local nCmdMs - getms() at the command

    sgSagRun := wkRun
    sgSagEnd := SO_NONE
    sgSagArrMs := -1
    sgSagAtMs := -1
    sgSagLossCps := 0
    sgSagLossDuty := 0
    bSgSagFault := FALSE
    sagTrN := 0
    sgSagIncr := -sagIncr[rowIdx]
    wkStatus := SG_ST_SPEEDING
    _, _, nResync0 := wheel.testGetFaultResponse()
    nLag0, _, _, _ := wheel.testGetDriveHealth()
    _, nWholeMs := scurveMs(abs(sgSagIncr), rampAccelUp, rampJerkUp, 0)
    sampleBegin()
    eOutcome := sampleNext()
    if bGuardStops(eOutcome)
        sgSagEnd := SO_ABORTED
    elseif wheel.testDriveAtMotorIncrement(sgSagIncr) <> wheel.NO_ERROR
        sgSagEnd := SO_REFUSED
        clearProtect()
    else
        nCmdMs := getms()
        eRo, bStopped := wkWaitAtSpeed(sgSagIncr, 2 * nWholeMs + ARRIVE_MARGIN_MS)
        if (eRo == RO_DONE) and (bStopped == FALSE)
            sgSagArrMs := smpMs - nCmdMs
            eRo, _ := waitPhase(UNTIL_ELAPSED, 0, SAG_SETTLE_MS, FALSE)
        if bStopped
            sgSagEnd := SO_STOPPED
        elseif eRo == RO_ABORTED
            sgSagEnd := SO_ABORTED
        elseif eRo <> RO_DONE
            sgSagEnd := SO_NO_SPEED
            bSgSagFault := (eRo == RO_FAULT)
        else
            wkPhase := SG_PH_ACT
            wkStatus := SG_ST_DIAL_DOWN
            sgSagDuty0 := smpDuty
            sgSagEnd := wkSagAct()
    bGoOn := (sgSagEnd <> SO_ABORTED) and (sgSagEnd <> SO_REFUSED)
    if bGoOn
        if bSgSagFault
            bGoOn := bFaultRecover()
        else
            bGoOn, _ := bStopAndRest(TRUE)
    _, _, nResync1 := wheel.testGetFaultResponse()
    nLag1, _, _, _ := wheel.testGetDriveHealth()
    sgSagResyncs := nResync1 - nResync0
    sgSagHeld := nLag1 - nLag0
    sgSagStopReason := wheel.getStopReason()
    sgSagFaultCause := wheel.getFaultCause()
    bSfSagMeas := (sgSagEnd == SO_FAULT_FIRST) or (sgSagEnd == SO_SLIP_FIRST)
    sfSagFirst := (sgSagEnd == SO_FAULT_FIRST) ? 1 : 0
    wkRes1 := -1
    wkRes2 := -1
    if bSfSagMeas                                           ' if/else, never `? :` with a call -- PL-29
        wkRes1 := wkRpm(sgSagLossCps)
        wkRes2 := sgSagLossDuty * 100 / (dutyMax #> 1)
    case sgSagEnd
        SO_FAULT_FIRST, SO_SLIP_FIRST:  wkWhy := SG_ST_MEASURED
        SO_STOPPED:                     wkWhy := SG_ST_NM_STOPPED
        SO_NO_LOSS:                     wkWhy := SG_ST_NM_NO_LOSS
        SO_NO_SPEED:                    wkWhy := SG_ST_NM_NO_SPEED
        other:                          wkWhy := SG_ST_NM_SETUP
    wkRead1 := -1
    wkRead2 := -1

PRI wkSagAct() : eEnd | nActMs, nCmdCps, nCps, nLostMs, nNextTrMs, nResync0, nResyncNow, eOutcome, idx
' His dial-down at the top (the measure cog): every reading the encoder's speed (the 35 ms ring) against the command, the
' fault flag and the re-sync count read FIRST; a trace reading every SAG_TRACE_MS into the ring. It ends on the first of:
' a fault (SO_FAULT_FIRST), the speed under SAG_LOST_PM of the command for SAG_LOST_MS (SO_SLIP_FIRST), STOP MOTOR, a
' guard, or SAG_WAIT_MS (SO_NO_LOSS).
'
' @returns eEnd - SO_FAULT_FIRST, SO_SLIP_FIRST, SO_STOPPED, SO_ABORTED or SO_NO_LOSS

' Local Variables:
' @local nActMs - getms() when the ACT began
' @local nCmdCps - the command's speed, encoder counts/s
' @local nCps - the encoder's speed now
' @local nLostMs - getms() the speed first read under SAG_LOST_PM in the current run of such readings, 0 none
' @local nNextTrMs - getms() of the next trace reading
' @local nResync0 - the re-synced faults at the ACT's start
' @local nResyncNow - now
' @local eOutcome - a reading's outcome
' @local idx - the trace ring's slot

    nActMs := getms()
    sgSagAtMs := nActMs
    nCmdCps := cmdCpsX1000(sgSagIncr) / PM
    nLostMs := 0
    nNextTrMs := nActMs
    _, _, nResync0 := wheel.testGetFaultResponse()
    eEnd := SO_NONE
    repeat while eEnd == SO_NONE
        eOutcome := sampleNext()
        _, _, nResyncNow := wheel.testGetFaultResponse()
        nCps := ringSpeedCps()
        if smpMs - nNextTrMs >= 0
            nNextTrMs += SAG_TRACE_MS
            idx := sagTrN // SAG_TRACE_MAX
            sagTrMs[idx] := smpMs - nActMs
            sagTrCps[idx] := nCps
            sagTrDuty[idx] := smpDuty
            sagTrHeld[idx] := smpLagHeld
            sagTrState[idx] := smpState
            sagTrN++
        wkRead1 := wkRpm(nCps)
        wkRead2 := smpDuty * 100 / (dutyMax #> 1)
        if abs(nCps) * PM < nCmdCps * SAG_LOST_PM
            if nLostMs == 0
                nLostMs := smpMs
        else
            nLostMs := 0
        if bGuardStops(eOutcome)
            eEnd := SO_ABORTED
        elseif (eOutcome == BO_FAULT) or (nResyncNow <> nResync0)
            eEnd := SO_FAULT_FIRST                          ' the driver's own record, read before the encoder
            bSgSagFault := TRUE
            wkStatus := SG_ST_FAULT_FIRST
        elseif (nLostMs <> 0) and (smpMs - nLostMs >= SAG_LOST_MS)
            eEnd := SO_SLIP_FIRST
            wkStatus := SG_ST_SLIP_FIRST
        elseif bWkStopReq
            eEnd := SO_STOPPED
        elseif smpMs - nActMs >= SAG_WAIT_MS
            eEnd := SO_NO_LOSS
        elseif smpMs - nActMs >= SAG_SETTLE_MS
            wkStatus := SG_ST_SAG_HELD
    sgSagLossCps := nCps
    sgSagLossDuty := smpDuty

PRI emitSagStep(seqNum, runNum) | idx, nFirst, nKept
' Emit B1-SAG (the step: its command, how it ended, the speed and duty at the loss, the fault's cause and the stop's
' reason) and one B1-SAGPT per trace reading kept (the last SAG_TRACE_MAX). Cog 0, at rest.
'
' @param seqNum - its number in the leg, 1-based
' @param runNum - its run, 1-based

' Local Variables:
' @local idx - a trace reading
' @local nFirst - the oldest kept
' @local nKept - how many are kept

    benchLog.begin(@"B1-SAG")
    benchLog.numField(@"step", seqNum, LIM_TINY)
    benchLog.numField(@"run", runNum, LIM_TINY)
    benchLog.numField(@"incr", sgSagIncr, LIM_BIG)
    benchLog.tokenField(@"end", soToken(sgSagEnd), TOKMAX_SO)
    benchLog.naNumField(@"arr_ms", sgSagArrMs, LIM_SMALL, sgSagArrMs >= 0)
    benchLog.boolField(@"expect_fault", sagExpectFault[rowIdx])
    benchLog.numField(@"duty0", sgSagDuty0, LIM_MID)
    benchLog.numField(@"loss_cps", sgSagLossCps, LIM_MID)
    benchLog.numField(@"loss_duty", sgSagLossDuty, LIM_MID)
    benchLog.numField(@"held", sgSagHeld, LIM_MID)
    benchLog.numField(@"resyncs", sgSagResyncs, LIM_SMALL)
    benchLog.numField(@"fault_cause", sgSagFaultCause, LIM_SMALL)
    benchLog.tokenField(@"sr", srToken(sgSagStopReason), TOKMAX_SR)
    benchLog.numField(@"trace_n", sagTrN, LIM_MID)
    lineEmit()
    nKept := sagTrN <# SAG_TRACE_MAX
    nFirst := sagTrN - nKept
    repeat idx from nFirst to sagTrN - 1
        benchLog.begin(@"B1-SAGPT")
        benchLog.numField(@"ms", sagTrMs[idx // SAG_TRACE_MAX], LIM_BIG)
        benchLog.numField(@"cps", sagTrCps[idx // SAG_TRACE_MAX], LIM_MID)
        benchLog.numField(@"duty", sagTrDuty[idx // SAG_TRACE_MAX], LIM_MID)
        benchLog.numField(@"held", sagTrHeld[idx // SAG_TRACE_MAX], LIM_BIG)
        benchLog.numField(@"state", sagTrState[idx // SAG_TRACE_MAX], LIM_TINY)
        lineEmit()

PRI soToken(eEnd) : pToken
' A sag step's end, for the log.
'
' @param eEnd - SO_*
' @returns pToken - pointer to its name

    case eEnd
        SO_FAULT_FIRST: pToken := @sSoFaultFirst
        SO_SLIP_FIRST:  pToken := @sSoSlipFirst
        SO_STOPPED:     pToken := @sHeStopped
        SO_NO_LOSS:     pToken := @sSoNoLoss
        SO_NO_SPEED:    pToken := @sHeNoSpeed
        SO_REFUSED:     pToken := @sHeRefused
        SO_ABORTED:     pToken := @sHeAborted
        other:          pToken := @sHeNone
#endif

CON { --- L-pinch (the analysis's L2b, OPTIONAL): a cloth pinch at the top, attended --- }

#ifdef SINGLE_PART_PINCH
PRI bRunPinch() : bCompleted
' L-pinch: at a DAT pinchIncr row, its one step on the panel (bRunAttended()). At another row nothing drives
' (B1-LEGSKIP). Cog 0.
'
' @returns bCompleted - T/F where T means nothing ended the run

    bCompleted := TRUE
    pnRun := 0
    if pinchIncr[rowIdx] == 0
        emitLegSkip(@sLegPinch)
        bSgNoSteps := TRUE
    else
        bCompleted := bRunAttended(@sLegPinch, @pinchSteps, 1)

PRI wkPinchStep() | nWholeMs, eRo, bStopped, eOutcome, bGoOn
' A pinch step (the measure cog): from rest to the row's DAT pinchIncr by the test path (negative increments), AT_SPEED,
' SAG_SETTLE_MS, the unloaded reference over PINCH_IDLE_MS (a window: the DC link's and duty's means), then his pinch
' (wkPinchAct()), then the motor stopped on the built-in ramp. Prints nothing.

' Local Variables:
' @local nWholeMs - the generator's time to the command
' @local eRo - a wait's outcome
' @local bStopped - T/F where T means STOP MOTOR ended the arrival
' @local eOutcome - a reading's outcome
' @local bGoOn - T/F where T means no guard ended the run

    pnRun := wkRun
    pnEnd := RO_NOT_RUN
    bPnSeen := FALSE
    pnIdleMa := 0
    pnIdleDuty := 0
    pnPeakMa := 0
    pnPeakDuty := 0
    pnSeenMs := -1
    pnGoneMs := -1
    pnLoadedMa := 0
    pnTrN := 0
    pnIncr := -pinchIncr[rowIdx]
    wkStatus := SG_ST_SPEEDING
    _, nWholeMs := scurveMs(abs(pnIncr), rampAccelUp, rampJerkUp, 0)
    sampleBegin()
    eOutcome := sampleNext()
    if bGuardStops(eOutcome)
        pnEnd := RO_ABORTED
    elseif wheel.testDriveAtMotorIncrement(pnIncr) <> wheel.NO_ERROR
        pnEnd := RO_REFUSED
        clearProtect()
    else
        eRo, bStopped := wkWaitAtSpeed(pnIncr, 2 * nWholeMs + ARRIVE_MARGIN_MS)
        if (eRo == RO_DONE) and (bStopped == FALSE)
            eRo, _ := waitPhase(UNTIL_ELAPSED, 0, SAG_SETTLE_MS, FALSE)
            if eRo == RO_DONE
                windowBegin()
                eRo, _ := waitPhase(UNTIL_ELAPSED, 0, PINCH_IDLE_MS, TRUE)
                windowEnd()
                pnIdleMa := winDcMa
                pnIdleDuty := divRound(winDutySum, winN #> 1)
        if bStopped
            pnEnd := RO_STOPPED                             ' (he stopped it before the pinch)
        elseif eRo <> RO_DONE
            pnEnd := eRo
        else
            wkPhase := SG_PH_ACT
            wkStatus := SG_ST_PINCH_NOW
            pnEnd := wkPinchAct()
    bGoOn := (pnEnd <> RO_ABORTED) and (pnEnd <> RO_REFUSED)
    if bGoOn
        if pnEnd == RO_FAULT
            bGoOn := bFaultRecover()
        else
            bGoOn, _ := bStopAndRest(TRUE)
    wkRes1 := pnIdleMa
    wkRes2 := bPnSeen ? pnPeakMa : -1
    if bPnSeen and (pnEnd == RO_DONE)
        wkWhy := SG_ST_MEASURED
    elseif pnEnd == RO_STOPPED
        wkWhy := SG_ST_NM_STOPPED
    elseif pnEnd == RO_FAULT
        wkWhy := SG_ST_NM_FAULT
    elseif pnEnd == RO_DONE
        wkWhy := SG_ST_NM_NO_LOAD
    else
        wkWhy := SG_ST_NM_NO_SPEED
    wkRead1 := -1
    wkRead2 := -1

PRI wkPinchAct() : eEnd | nActMs, nNetMa, ringMa[PINCH_MEAN_N], nRingIdx, nRingSum, nMeanMa, nBelowMs, nNextTrMs, nTrSum, nTrDuty, nTrErr, nTrN, idx, nLoadSum, nLoadN, eOutcome
' His pinch at the top (the measure cog): every reading's DC link into a PINCH_MEAN_N-reading mean; LOAD SEEN when that
' mean passes the unloaded reference by PINCH_SEEN_MA, LOAD GONE when it stays under half that for PINCH_GONE_MS; a
' trace of PINCH_TRACE_MS means into the ring. It ends on DONE (his: he has let go), STOP MOTOR, a fault, a guard, or
' PINCH_WAIT_MS.
'
' @returns eEnd - RO_DONE (DONE, or the bound), RO_STOPPED (STOP MOTOR), RO_FAULT or RO_ABORTED

' Local Variables:
' @local nActMs - getms() when the ACT began
' @local nNetMa - a reading's DC link, mA
' @local ringMa - the last PINCH_MEAN_N readings, mA
' @local nRingIdx - the ring's next slot
' @local nRingSum - its sum
' @local nMeanMa - its mean
' @local nBelowMs - getms() the mean first fell under half the threshold after the load was seen, 0 none
' @local nNextTrMs - getms() of the next trace mean
' @local nTrSum - the trace interval's DC link sum
' @local nTrDuty - its duty sum
' @local nTrErr - its |err| peak
' @local nTrN - its readings
' @local idx - the trace ring's slot
' @local nLoadSum - the DC link summed while the load was seen
' @local nLoadN - readings in it
' @local eOutcome - a reading's outcome

    nActMs := getms()
    longfill(@ringMa, pnIdleMa, PINCH_MEAN_N)
    nRingSum := pnIdleMa * PINCH_MEAN_N
    nRingIdx := 0
    nBelowMs := 0
    nNextTrMs := nActMs + PINCH_TRACE_MS
    nTrSum := 0
    nTrDuty := 0
    nTrErr := 0
    nTrN := 0
    nLoadSum := 0
    nLoadN := 0
    eEnd := RO_NOT_RUN
    repeat while eEnd == RO_NOT_RUN
        eOutcome := sampleNext()
        nNetMa := netMilliamps(smpSenseMv)
        nRingSum += nNetMa - ringMa[nRingIdx]
        ringMa[nRingIdx] := nNetMa
        nRingIdx := (nRingIdx + 1) // PINCH_MEAN_N
        nMeanMa := nRingSum / PINCH_MEAN_N
        nTrSum += nNetMa
        nTrDuty += smpDuty
        nTrErr #>= abs(smpErr)
        nTrN++
        if smpMs - nNextTrMs >= 0
            nNextTrMs += PINCH_TRACE_MS
            idx := pnTrN // PINCH_TRACE_MAX
            pnTrMs[idx] := smpMs - nActMs
            pnTrMa[idx] := nTrSum / nTrN
            pnTrDuty[idx] := nTrDuty / nTrN
            pnTrErrPk[idx] := nTrErr
            pnTrN++
            nTrSum := 0
            nTrDuty := 0
            nTrErr := 0
            nTrN := 0
        if nMeanMa >= pnIdleMa + PINCH_SEEN_MA
            if bPnSeen == FALSE
                bPnSeen := TRUE
                pnSeenMs := smpMs - nActMs
            nBelowMs := 0
        if bPnSeen
            pnPeakMa #>= nMeanMa
            pnPeakDuty #>= smpDuty
            if pnGoneMs < 0
                nLoadSum += nNetMa
                nLoadN++
                if nMeanMa < pnIdleMa + PINCH_SEEN_MA / 2
                    if nBelowMs == 0
                        nBelowMs := smpMs
                    elseif smpMs - nBelowMs >= PINCH_GONE_MS
                        pnGoneMs := smpMs - nActMs
        wkRead1 := wkRpm(ringSpeedCps())
        wkRead2 := nMeanMa #> 0
        if bGuardStops(eOutcome)
            eEnd := RO_ABORTED
        elseif eOutcome == BO_FAULT
            eEnd := RO_FAULT
        elseif bWkDoneReq or (smpMs - nActMs >= PINCH_WAIT_MS)
            eEnd := RO_DONE
        elseif bWkStopReq
            eEnd := RO_STOPPED
        elseif pnGoneMs >= 0
            wkStatus := SG_ST_LOAD_GONE
        elseif bPnSeen
            wkStatus := SG_ST_LOAD_SEEN
    pnLoadedMa := divRound(nLoadSum, nLoadN #> 1)

PRI emitPinchStep(seqNum, runNum) | idx, nFirst, nKept
' Emit B1-PINCH (the step: its command, the unloaded reference, the load seen and gone, the loaded current) and one
' B1-PINCHPT per trace mean kept (the last PINCH_TRACE_MAX). Cog 0, at rest.
'
' @param seqNum - its number in the leg, 1-based
' @param runNum - its run, 1-based

' Local Variables:
' @local idx - a trace mean
' @local nFirst - the oldest kept
' @local nKept - how many are kept

    benchLog.begin(@"B1-PINCH")
    benchLog.numField(@"step", seqNum, LIM_TINY)
    benchLog.numField(@"run", runNum, LIM_TINY)
    benchLog.numField(@"incr", pnIncr, LIM_BIG)
    benchLog.tokenField(@"end", roToken(pnEnd), TOKMAX_RO)
    benchLog.numField(@"idle_ma", pnIdleMa, LIM_MID)
    benchLog.numField(@"idle_duty", pnIdleDuty, LIM_MID)
    benchLog.boolField(@"seen", bPnSeen)
    benchLog.naNumField(@"seen_ms", pnSeenMs, LIM_MID, bPnSeen)
    benchLog.naNumField(@"gone_ms", pnGoneMs, LIM_MID, pnGoneMs >= 0)
    benchLog.naNumField(@"loaded_ma", pnLoadedMa, LIM_MID, bPnSeen)
    benchLog.naNumField(@"peak_ma", pnPeakMa, LIM_MID, bPnSeen)
    benchLog.naNumField(@"peak_duty", pnPeakDuty, LIM_MID, bPnSeen)
    benchLog.numField(@"trace_n", pnTrN, LIM_MID)
    lineEmit()
    nKept := pnTrN <# PINCH_TRACE_MAX
    nFirst := pnTrN - nKept
    repeat idx from nFirst to pnTrN - 1
        benchLog.begin(@"B1-PINCHPT")
        benchLog.numField(@"ms", pnTrMs[idx // PINCH_TRACE_MAX], LIM_BIG)
        benchLog.numField(@"dc_ma", pnTrMa[idx // PINCH_TRACE_MAX], LIM_MID)
        benchLog.numField(@"duty", pnTrDuty[idx // PINCH_TRACE_MAX], LIM_MID)
        benchLog.numField(@"err_pk", pnTrErrPk[idx // PINCH_TRACE_MAX], LIM_SMALL)
        lineEmit()
#endif

CON { --- shared arithmetic --- }

PRI classifyEdge(nCodes) : nTick, nBoundary | iPrev, iNew, nStep
' Classify one captured transition by the instrument's own order table: a step up the order 1-5-4-6-2-3 rises a tick and
' crosses the boundary below the new code; a step down falls a tick and crosses the boundary below the old code; anything
' else (a skipped code, or %000 / %111 at either end) is TICK_BAD with no boundary.
'
' @param nCodes - the new hall code | the previous one << CODE_PREV_SHIFT
' @returns nTick - TICK_RISE, TICK_FALL or TICK_BAD
' @returns nBoundary - the boundary crossed, 0..5 (boundary k lies between order[k - 1] and order[k]); NO_BOUNDARY when bad

' Local Variables:
' @local iPrev - the previous code's place in the order
' @local iNew - the new code's place
' @local nStep - iNew - iPrev, 0..5

    nTick := TICK_BAD
    nBoundary := NO_BOUNDARY
    iNew := orderIdxOfCode[nCodes & CODE_MASK]
    iPrev := orderIdxOfCode[(nCodes >> CODE_PREV_SHIFT) & CODE_MASK]
    if (iNew <> NOT_IN_ORDER) and (iPrev <> NOT_IN_ORDER)
        nStep := wrapPositive(iNew - iPrev, HALL_ORDER_LEN)
        if nStep == 1
            nTick := TICK_RISE
            nBoundary := iNew
        elseif nStep == HALL_ORDER_LEN - 1
            nTick := TICK_FALL
            nBoundary := iPrev

PRI wrapPositive(nValue, nModulus) : nWrapped
' Return {nValue} modulo {nModulus} in 0 .. nModulus - 1 ("//" keeps the dividend's sign).
'
' @param nValue - any value
' @param nModulus - the modulus, above 0
' @returns nWrapped - the value in 0 .. nModulus - 1

    nWrapped := nValue // nModulus
    if nWrapped < 0
        nWrapped += nModulus

PRI wrapSigned(nValue, nModulus) : nWrapped
' Return {nValue} modulo {nModulus} in -nModulus / 2 .. nModulus / 2.
'
' @param nValue - any value
' @param nModulus - the modulus, above 0
' @returns nWrapped - the value in -nModulus / 2 .. nModulus / 2

    nWrapped := wrapPositive(nValue, nModulus)
    if nWrapped > nModulus / 2
        nWrapped -= nModulus

PRI divRound(nNumerator, nDenominator) : nQuotient
' Return {nNumerator} / {nDenominator} rounded half away from zero ("/" truncates toward zero).
'
' @param nNumerator - any value
' @param nDenominator - above 0
' @returns nQuotient - the rounded quotient

    if nNumerator >= 0
        nQuotient := (nNumerator + nDenominator / 2) / nDenominator
    else
        nQuotient := (nNumerator - nDenominator / 2) / nDenominator

PRI netMilliamps(nSenseMv) : nNetMa
' Return a current-sense reading net of the rest zero, in mA of DC link, through the detected board's scale: the stop
' conditions are amps, and the same millivolts are 30 x more current on Rev A (5 mV/A) than on Rev B (150).
'
' @param nSenseMv - the reading, mV
' @returns nNetMa - the net current, mA

    nNetMa := divRound((nSenseMv * X10 - zeroMvX10) * (UA_PER_MA / X10), senseMvPerA #> 1)

PRI senseMvPerAmp(eRevision) : nMvPerA
' Return a board revision's current-sense scale, mV per A: the library's own constants.
'
' @param eRevision - REV_A or REV_B
' @returns nMvPerA - F_REV_A_RSENSE (5) for Rev A, else F_REV_B_RSENSE (150)

    if eRevision == wheel.REV_A
        nMvPerA := wheel.F_REV_A_RSENSE
    else
        nMvPerA := wheel.F_REV_B_RSENSE

PRI expectedRevision() : eRevision
' Return the REV_* the bench's EXPECTED_BOARD names (REV_Unknown when it names neither).
'
' @returns eRevision - REV_A, REV_B or REV_Unknown

    eRevision := wheel.REV_Unknown
    if EXPECTED_BOARD == user.BRD_REV_A
        eRevision := wheel.REV_A
    elseif EXPECTED_BOARD == user.BRD_REV_B
        eRevision := wheel.REV_B

PRI setAbort(eReason, nDetail)
' Record why the run ended early: the first cause is kept, never overwritten.
'
' @param eReason - AR_*
' @param nDetail - its detail (see AR_*)

    if eAbortReason == AR_NONE
        eAbortReason := eReason
        abortDetail := nDetail

CON { --- records --- }

PRI emitBanner()
' Emit B1-BANNER: what was built, from which commit, for which bench, at which clock and voltage.

    benchLog.begin(@"B1-BANNER")
    benchLog.numField(@"src_rev", SRC_REV, LIM_SMALL)
    benchLog.textField(@"commit", commit.commitText())      ' the short SHA in a bench pack, NOT_A_PACK from the tree
    benchLog.numField(@"fmt", FMT_VERSION, LIM_SMALL)
    benchLog.numField(@"driver_rev", wheel.DRIVER_REV, LIM_SMALL)
    benchLog.tokenField(@"cfg", BUILT_FOR_DOCO ? @sCfgDoco : @sCfgNotDoco, TOKMAX_CFG)
    benchLog.numField(@"clkfreq", clkfreq, LIM_BIG)
    benchLog.numField(@"told_mv", TOLD_MV, LIM_MID)         ' the TOLD voltage: this bench senses none
    benchLog.numField(@"voltage_enum", user.DRIVE_VOLTAGE, LIM_TINY)
    benchLog.numField(@"motor_type", user.MOTOR_TYPE, LIM_TINY)
    benchLog.numField(@"base", MOTOR_BASE, LIM_TINY)
    benchLog.numField(@"det_mode", MOTOR_DET_MODE, LIM_TINY)
    benchLog.tokenField(@"expected_board", revisionToken(expectedRevision()), TOKMAX_BOARD)
    benchLog.numField(@"enc_a", ENC_PIN_A, LIM_TINY)
    benchLog.numField(@"enc_b", ENC_PIN_B, LIM_TINY)
    lineEmit()

PRI emitBuild()
' Emit B1-BUILD: which legs this image carries, the run's time cap and the sign-off format.

    benchLog.begin(@"B1-BUILD")
    benchLog.boolField(@"hallmap", PART_HALLMAP_BUILT)
    benchLog.boolField(@"mininc", PART_MININC_BUILT)
    benchLog.boolField(@"ladder", PART_LADDER_BUILT)
    benchLog.boolField(@"ramp", PART_RAMP_BUILT)
    benchLog.boolField(@"stops", PART_STOPS_BUILT)
    benchLog.boolField(@"coast", PART_COAST_BUILT)
    benchLog.boolField(@"offscan", PART_OFFSCAN_BUILT)
    benchLog.boolField(@"passprb", PART_PASSPRB_BUILT)
    benchLog.boolField(@"handload", PART_HANDLOAD_BUILT)    ' phase 2c, the attended legs
    benchLog.boolField(@"heldpush", PART_HELDPUSH_BUILT)
    benchLog.boolField(@"sag", PART_SAG_BUILT)
    benchLog.boolField(@"pinch", PART_PINCH_BUILT)
    benchLog.boolField(@"coldz", FALSE)                     ' the cold back-EMF Z is not built (CON { the Doco's numbers }, COLD Z)
    benchLog.boolField(@"wiring", PART_WIRING_BUILT)        ' task 3686, the D2 qualification
    benchLog.boolField(@"power", PART_POWER_BUILT)
    benchLog.boolField(@"qualify", QUALIFY_BUILT)
    benchLog.numField(@"time_cap_s", RUN_TIME_CAP_S, LIM_SMALL)
    benchLog.numField(@"charge_cap_mas", RUN_CHARGE_CAP_MAS, LIM_MID)
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    lineEmit()

PRI emitMotor()
' Emit B1-MOTOR: the per-motor numbers this image runs with, so the log carries them (the plan's sec 4 list names each).

    benchLog.begin(@"B1-MOTOR")
    benchLog.numField(@"pole_pairs", MOTOR_POLE_PAIRS, LIM_TINY)
    benchLog.numField(@"ticks_rev", HALL_TICKS_PER_REV, LIM_SMALL)
    benchLog.numField(@"cpr", ENC_COUNTS_PER_REV, LIM_SMALL)
    benchLog.numField(@"counts_tick", ENC_COUNTS_PER_TICK, LIM_SMALL)
    benchLog.numField(@"ke_mv_krpm", KE_MV_PER_KRPM, LIM_SMALL)
    benchLog.numField(@"rated_ma", RATED_MA, LIM_SMALL)
    benchLog.numField(@"no_load_ma", NO_LOAD_MA_MAX, LIM_SMALL)
    benchLog.numField(@"test_peak_a", TEST_PEAK_A, LIM_TINY)
    benchLog.numField(@"test_cont_a", TEST_CONT_A, LIM_TINY)
    benchLog.numField(@"abort_ma", ABS_ABORT_MA, LIM_SMALL)
