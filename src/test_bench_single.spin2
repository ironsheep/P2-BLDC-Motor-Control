    benchLog.numField(@"pwr_rungs", POWER_RUNG_COUNT, LIM_TINY)    ' task 3686: L-power, R23-SGL-POWER and -TOPSPD
    benchLog.numField(@"pwr_tol_pm", POWER_TOL_PM, LIM_SMALL)
    benchLog.numField(@"top_tol_pm", TOPSPD_TOL_PM, LIM_SMALL)
    benchLog.numField(@"ke_fit_mv", KE_FITTED_MV_PER_KRPM, LIM_SMALL)
    lineEmit()
    benchLog.begin(@"B1-MOTOR4")                            ' (L-offscan's, apart: one record would pass 260 bytes)
    benchLog.numField(@"ofs_step", OFS_STEP_DEG, LIM_TINY)
