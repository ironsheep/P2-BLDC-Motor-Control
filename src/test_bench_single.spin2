OBJ { objects under test }

#ifdef BENCH_CFG
    user     : "isp_bldc_motor_userconfig_bench"            ' the bench's fixed statement (-D BENCH_CFG; -D BENCH_DOCO: the Doco bench)
#else
    user     : "isp_bldc_motor_userconfig"                  ' the end-user configuration: this harness refuses it
#endif
    wheel    : "isp_bldc_motor"                             ' the one motor
    enc      : "isp_bench_encoder"                          ' the shaft encoder and its hall-edge capture
    benchLog : "isp_bench_log"                              ' the record builder (PL-53) and the cog-event quiet window (PL-41)
    commit   : "isp_bench_commit"                           ' the commit this binary was built from, in B1-BANNER (PL-68)

DAT { hall order -- the instrument's own classification of an edge }

  ' the index of each hall code in the rising order 1-5-4-6-2-3; NOT_IN_ORDER for %000 and %111
orderIdxOfCode  LONG    NOT_IN_ORDER, 0, 4, 5, 2, 1, 3, NOT_IN_ORDER

DAT { the Doco's rows and leg tables -- PER-MOTOR, part of the one block (CON { the Doco's numbers } says why each) }

  ' the rows, in the library's order (PWR_7p4V .. PWR_24p0V), ROW_COUNT of them: the told voltage in mV ...
rowMv           LONG    7_400, 11_100, 12_000, 14_800, 18_500, 22_200, 24_000
  ' ... the shipped Rev A ceiling, the increment power 100 commands (MIRRORED: isp_bldc_motor.spin2 :5418-5419) ...
rowCeilIncr     LONG    282_000_000, 545_000_000, 335_000_000, 376_000_000, 398_000_000, 470_000_000, 391_000_000
  ' ... and the ladder's test current limit, whole amps: 2 A as every leg, but 3 A at 11.1 V, whose 75 % rung needs 2.57 A
  '  of phase current (MODELED, analysis 2.1: 2,731 rpm, lead 12, held passes) -- the least whole amp over it. Every other
  '  row's unloaded rungs draw 0.12-0.25 A of phase (analysis 2.1) and its climbs peak at 0.68 A (24 V, analysis 2.3).
rowLadderA      LONG    2, 3, 2, 2, 2, 2, 2

  ' L-ladder: the table rungs, % of the row's ceiling (LADDER_PCT_COUNT), and the extension rungs (LADDER_EXT_COUNT)
ladderPcts      LONG    25, 50, 75, 100
ladderExtIncr   LONG    360_000_000, 400_000_000

  ' L-mininc: the sweep, hall ticks/s x 100, fastest first (MININC_RUNGS); MININC_SHIPPED_RUNG is SHIPPED_MIN_INCR itself
minincTpsX100   LONG    2_400, 1_200, 600, 400, 300, 200, MININC_SHIPPED_RUNG, 100, 75, 60

  ' L-stops: stopAfterRotation()'s N, hall ticks (STOPS_ROT_COUNT each): at the top (300 and 400 revolutions), at the crawl
stopTopTicks    LONG    7_200, 9_600
stopCrawlTicks  LONG    24, 120

  ' PHASE 2b, per row in the library's order (ROW_COUNT): the rows L-coast and L-offscan run at (the analysis's 12 V and
  '  24 V) ...
rowL13          LONG    FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, TRUE
  ' ... and R23-SGL-COAST's bound there, ms: the coast from the row's 100 % speed at the bracket's two corners (0: no cell)
coastLoMs       LONG    0, 0, 62, 0, 0, 0, 71
coastHiMs       LONG    0, 0, 738, 0, 0, 0, 834
  ' L-coast and L-offscan: the speeds, % of the row's ceiling (SPEED_PCT_COUNT), the 100 % last (SPEED_TOP_IDX)
speedPcts       LONG    25, 50, 100

  ' PHASE 2c, per row in the library's order (ROW_COUNT): the rows L-handload and L-heldpush run at (12 V, 24 V) ...
rowL56          LONG    FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, TRUE
  ' ... the row the default-limit hand-load step runs at (12 V ONLY: never 24 V, CON { the Doco's numbers }) ...
rowHandDef      LONG    FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
  ' ... L-sag's command, increment magnitude (0: no sag at this row): 22.2 V's shipped top 470e6 (past PK1_CAP_INCR on
  '  purpose: P-S7's fault-first case), 18.5 V's 398e6 (its shipped top, under the margin) ...
sagIncr         LONG    0, 0, 0, 0, 398_000_000, 470_000_000, 0
  ' ... and R23-SGL-SAGTYPE's bound there: TRUE where a fault comes first (P-S7) ...
sagExpectFault  LONG    FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE
  ' ... L-pinch's command (0: none): the 18.5 V row's top, 398e6 (analysis L2b: under the PK-1 margin)
pinchIncr       LONG    0, 0, 0, 0, 398_000_000, 0, 0

  ' L-handload's steps (HL_COUNT): each step's test limit, whole amps; 0 is the library's default (I_PEAK_A / I_CONT_A)
handLimitA      LONG    4, 2, 0

  ' TASK 3686, L-power's rungs (POWER_RUNG_COUNT): the power commanded, each capped at the row's top power (rowTopPower)
powerPcts       LONG    25, 50, 75, 100

#ifdef SINGLE_ATTENDED
