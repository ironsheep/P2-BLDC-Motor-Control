    benchLog.numField(@"blk_hi_ms", BLKSTOP_HI_MS, LIM_SMALL)
    benchLog.numField(@"nolatch_ms", HAND_NOLATCH_MS, LIM_SMALL)
    benchLog.numField(@"rise_lo_ms", HOLDRISE_LO_MS, LIM_SMALL)
    benchLog.numField(@"rise_hi_ms", HOLDRISE_HI_MS, LIM_SMALL)
    benchLog.numField(@"slip_ticks", wheel.HOLD_SLIP_TICKS, LIM_TINY)
    benchLog.numField(@"sag_lost_pm", SAG_LOST_PM, LIM_SMALL)
    benchLog.numField(@"pinch_seen_ma", PINCH_SEEN_MA, LIM_SMALL)
    lineEmit()

PRI emitEnd()
' Emit B1-REFUSE (when nothing was started) and B1-END: how the run ended, its time, its charge and its peak current.

    if (eAbortReason == AR_NOT_DOCO) or (eAbortReason == AR_NO_PART)
        benchLog.begin(@"B1-REFUSE")
        benchLog.tokenField(@"reason", abortToken(eAbortReason), TOKMAX_REASON)
        lineEmit()
    benchLog.begin(@"B1-END")
    benchLog.tokenField(@"abort", abortToken(eAbortReason), TOKMAX_REASON)
    benchLog.numField(@"detail", abortDetail, LIM_BIG)
    if eAbortReason == AR_ENC_CHECK
        benchLog.tokenField(@"detail_name", enc.reasonName(abortDetail), TOKMAX_OUTCOME)
    elseif (eAbortReason == AR_BURST) or (eAbortReason == AR_GUARD)
        benchLog.tokenField(@"detail_name", outcomeToken(abortDetail), TOKMAX_OUTCOME)
    else
        benchLog.textField(@"detail_name", @sNa)
    benchLog.numField(@"run_ms", getms() - runStartMs, LIM_BIG)
    benchLog.numField(@"idle_ms", runIdleMs, LIM_BIG)       ' phase 2c: the screens' waits on the operator, not in the time cap
    benchLog.numField(@"charge_mas", chargeMaMs / wheel.MS_PER_SEC, LIM_MID)
    benchLog.numField(@"peak_ma", peakMa, LIM_MID)
    benchLog.numField(@"wchk_worst", winChkWorst, LIM_SMALL)
    lineEmit()

PRI emitSignoffDecls()
' Emit one SIGNOFF-DECL per cell this image judges, before anything moves.

#ifdef SINGLE_PART_WIRING
    emitSignoffDecl(@sSfCellStart)
#endif
#ifdef SINGLE_PART_POWER
    emitSignoffDecl(@sSfCellPower)
#endif
#ifdef SINGLE_PART_HALLMAP
    emitSignoffDecl(@sSfCellEncChk)
    emitSignoffDecl(@sSfCellSector)
#endif
#ifdef SINGLE_PART_MININC
    emitSignoffDecl(@sSfCellMinInc)
#endif
#ifdef SINGLE_PART_LADDER
    emitSignoffDecl(@sSfCellFollow)
    emitSignoffDecl(@sSfCellMisdial)
#endif
    if PART_LADDER_BUILT or PART_RAMP_BUILT
        emitSignoffDecl(@sSfCellSmooth)
        emitSignoffDecl(@sSfCellTopSpd)                     ' task 3686: the same runs' rate on the speed law
#ifdef SINGLE_PART_RAMP
    emitSignoffDecl(@sSfCellRampArr)
#endif
#ifdef SINGLE_PART_STOPS
    emitSignoffDecl(@sSfCellStopRot)
    emitSignoffDecl(@sSfCellStopTime)
#endif
#ifdef SINGLE_PART_COAST
    emitSignoffDecl(@sSfCellCoast)
#endif
#ifdef SINGLE_PART_OFFSCAN
    emitSignoffDecl(@sSfCellLeadMove)
#endif
#ifdef SINGLE_PART_PASSPROBE
    emitSignoffDecl(@sSfCellPassPrd)
#endif
#ifdef SINGLE_PART_HANDLOAD
    emitSignoffDecl(@sSfCellLimHold)
    emitSignoffDecl(@sSfCellBlkStop)
#endif
#ifdef SINGLE_PART_HELDPUSH
    emitSignoffDecl(@sSfCellHoldRise)
    emitSignoffDecl(@sSfCellHoldSlip)
#endif
#ifdef SINGLE_PART_SAG
    emitSignoffDecl(@sSfCellSagType)
#endif

PRI emitSignoffDecl(pCell)
' Emit SIGNOFF-DECL for one cell.
'
' @param pCell - pointer to the cell id token

    benchLog.begin(@"SIGNOFF-DECL")
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.tokenField(@"bin", @sSfBin, TOKMAX_BIN)
    benchLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    benchLog.tokenField(@"task", cellTask(pCell), TOKMAX_TASK)
    lineEmit()

PRI cellTask(pCell) : pTask
' The task a cell belongs to, for its SIGNOFF-DECL and SIGNOFF records: task 3686's three qualification cells, else 3679.
'
' @param pCell - pointer to the cell id token
' @returns pTask - pointer to the task token

    pTask := @sSfTask
    if (pCell == @sSfCellStart) or (pCell == @sSfCellPower) or (pCell == @sSfCellTopSpd)
        pTask := @sSfTaskQual

PRI emitSignoffs()
' Emit every declared cell's SIGNOFF instances: on every path that declared them (a refused build declared none), after
' the motor stopped.

    if (eAbortReason <> AR_NOT_DOCO) and (eAbortReason <> AR_NO_PART)
        emitDeclaredSignoffs()

PRI emitDeclaredSignoffs() | setIdx, eSign, eIdx, hl, eDir, nExpect, nPowIdx
' Emit the SIGNOFF instances of every cell emitSignoffDecls() declared, one per set, sign, sign-change or sign-kind;
' phase 2c's per hand-load limit (LIM-DEF only where that step belongs: a DAT rowHandDef row), per measured direction,
' and the sag's one; task 3686's START (one), POWER (per power sign) and TOPSPD (as SMOOTH's).

' Local Variables:
' @local setIdx - SET_*
' @local eSign - SIGN_*
' @local eIdx - a 2a cell's instance
' @local hl - a hand-load step, HL_*
' @local eDir - a measured direction, DIR_*
' @local nExpect - R23-SGL-SAGTYPE's bound at the row: 1 fault first, 0 slip first
' @local nPowIdx - a power sign (R23-SGL-POWER)

#ifdef SINGLE_PART_WIRING
    emitSignoff(@sSfCellStart, @sInstMotor, @sSfCritStartOk, bStartMeasured(), startWireValue(), ...
                START_OK, START_OK, @sSfUnitsBool01, 1)
#endif
#ifdef SINGLE_PART_POWER
    repeat nPowIdx from 0 to POWER_SIGNS - 1
        emitSignoff(@sSfCellPower, powToken(nPowIdx), @sSfCritPwrDev, sfPowN[nPowIdx] > 0, sfPowDev[nPowIdx], ...
                    0, POWER_TOL_PM, @sSfUnitsPm, sfPowN[nPowIdx])
#endif
#ifdef SINGLE_PART_HALLMAP
    repeat setIdx from 0 to SET_COUNT - 1
        emitSignoff(@sSfCellEncChk, setToken(setIdx), @sSfCritEncDev, setBurstsChecked[setIdx] > 0, setEncDevWorst[setIdx], ...
                    ENCCHK_LO_COUNTS, enc.CHECK_TOL_COUNTS, @sSfUnitsCounts, setBurstsChecked[setIdx])
    repeat setIdx from 0 to SET_COUNT - 1
        emitSignoff(@sSfCellSector, setToken(setIdx), @sSfCritSectDev, bSetFinished[setIdx] and (setBurstsMapped[setIdx] == BURSTS_PER_SET), ...
                    setSectDevX10[setIdx], SECTOR_LO_X10, SECTOR_TOL_X10, @sSfUnitsCntX10, setBurstsMapped[setIdx] * BURST_REVS)
#endif
#ifdef SINGLE_PART_MININC
    repeat eSign from SIGN_NEG to SIGN_POS
        emitSignoff(@sSfCellMinInc, signToken(eSign), @sSfCritMinTps, bSfMinMeas[eSign], sfMinTps[eSign], ...
                    MININC_LO_TPS_X100, MININC_HI_TPS_X100, @sSfUnitsTps, 1)
#endif
#ifdef SINGLE_PART_LADDER
    repeat eSign from SIGN_NEG to SIGN_POS
        emitSignoff(@sSfCellFollow, signToken(eSign), @sSfCritFolDev, sfFolN[eSign] > 0, sfFolWorst[eSign], ...
                    FOLLOW_LO_PM, FOLLOW_TOL_PM, @sSfUnitsPm, sfFolN[eSign])
    repeat eSign from SIGN_NEG to SIGN_POS
        emitSignoff(@sSfCellMisdial, signToken(eSign), @sSfCritVpred, bSfMisMeas[eSign], sfMisPm[eSign], ...
                    -MISDIAL_TOL_PM, MISDIAL_TOL_PM, @sSfUnitsPm, fitPts[eSign])
#endif
    if PART_LADDER_BUILT or PART_RAMP_BUILT
        repeat eSign from SIGN_NEG to SIGN_POS
            emitSignoff(@sSfCellSmooth, signToken(eSign), @sSfCritFaultRun, sfSmoothN[eSign] > 0, sfSmooth[eSign], ...
                        SMOOTH_LO, SMOOTH_HI, @sSfUnitsCount, sfSmoothN[eSign])
        if PART_RAMP_BUILT                                  ' the reversal is L-ramp's alone
            emitSignoff(@sSfCellSmooth, @sInstReversal, @sSfCritFaultRun, sfSmoothN[SMOOTH_REVERSAL] > 0, sfSmooth[SMOOTH_REVERSAL], ...
                        SMOOTH_LO, SMOOTH_HI, @sSfUnitsCount, sfSmoothN[SMOOTH_REVERSAL])
        repeat eSign from SIGN_NEG to SIGN_POS              ' task 3686: R23-SGL-TOPSPD, SMOOTH's instances and feeds
            emitSignoff(@sSfCellTopSpd, signToken(eSign), @sSfCritTopDev, sfTopN[eSign] > 0, sfTopDev[eSign], ...
                        0, TOPSPD_TOL_PM, @sSfUnitsPm, sfTopN[eSign])
        if PART_RAMP_BUILT
            emitSignoff(@sSfCellTopSpd, @sInstReversal, @sSfCritTopDev, sfTopN[SMOOTH_REVERSAL] > 0, sfTopDev[SMOOTH_REVERSAL], ...
                        0, TOPSPD_TOL_PM, @sSfUnitsPm, sfTopN[SMOOTH_REVERSAL])
#ifdef SINGLE_PART_RAMP
    repeat eIdx from 0 to SIGN_COUNT * CHG_COUNT - 1
        emitSignoff(@sSfCellRampArr, chgToken(eIdx), @sSfCritArrDev, sfArrN[eIdx] > 0, sfArrPm[eIdx], ...
                    -RAMPARR_TOL_PM, RAMPARR_TOL_PM, @sSfUnitsPm, sfArrN[eIdx])
#endif
#ifdef SINGLE_PART_STOPS
    repeat eIdx from 0 to SIGN_COUNT * KIND_COUNT - 1
        emitSignoff(@sSfCellStopRot, kindToken(eIdx), @sSfCritRestCnt, sfRotN[eIdx] > 0, sfRotDev[eIdx], ...
                    -STOPROT_EARLY_COUNTS, STOPROT_LATE_COUNTS, @sSfUnitsCounts, sfRotN[eIdx])
    repeat eIdx from 0 to SIGN_COUNT * KIND_COUNT - 1
        emitSignoff(@sSfCellStopTime, kindToken(eIdx), @sSfCritRestMs, sfTimeN[eIdx] > 0, sfTimeDev[eIdx], ...
                    -STOPTIME_TOL_MS, STOPTIME_TOL_MS, @sSfUnitsMs, sfTimeN[eIdx])
#endif
#ifdef SINGLE_PART_COAST
    repeat eSign from SIGN_NEG to SIGN_POS                  ' (a row with no bound, or a skipped leg, is NOMEAS: never measured there)
        emitSignoff(@sSfCellCoast, signToken(eSign), @sSfCritCoastMs, bSfCoastMeas[eSign] and (rowIdx >= 0), sfCoastMs[eSign], ...
                    coastBound(FALSE), coastBound(TRUE), @sSfUnitsMs, 1)
#endif
#ifdef SINGLE_PART_OFFSCAN
    repeat eSign from SIGN_NEG to SIGN_POS
        emitSignoff(@sSfCellLeadMove, signToken(eSign), @sSfCritLeadSprd, sfLeadN[eSign] >= 2, sfLeadSpread[eSign], ...
                    0, LEADMOVE_TOL_X10, @sSfUnitsDegX10, sfLeadN[eSign])
#endif
#ifdef SINGLE_PART_PASSPROBE
    repeat eSign from SIGN_NEG to SIGN_POS
        emitSignoff(@sSfCellPassPrd, signToken(eSign), @sSfCritPassDev, bSfPassMeas[eSign], sfPassPpm[eSign], ...
                    -PASSPRD_TOL_PPM, PASSPRD_TOL_PPM, @sSfUnitsPpm, 1)
#endif
#ifdef SINGLE_PART_HANDLOAD
    repeat hl from HL_4A to HL_2A                           ' the test limits only: the default step folds nothing (P-H1)
        emitSignoff(@sSfCellLimHold, hlInst(hl), @sSfCritFaultRun, bLimHoldMeasured(hl), hlFaults[hl], ...
                    LIMHOLD_LO, LIMHOLD_HI, @sSfUnitsCount, hlRun[hl])
    repeat hl from HL_4A to HL_DEF
        if (hl <> HL_DEF) or bRowAllowsHandDef()
            emitSignoff(@sSfCellBlkStop, hlInst(hl), @sSfCritLatchMs, bBlkStopMeasured(hl), blkStopValue(hl), ...
                        BLKSTOP_LO_MS, BLKSTOP_HI_MS, @sSfUnitsMs, hlRun[hl])
#endif
#ifdef SINGLE_PART_HELDPUSH
    repeat eDir from DIR_RISE to DIR_FALL
        emitSignoff(@sSfCellHoldRise, dirToken(eDir), @sSfCritRiseMs, bSfRiseMeas[eDir], sfRiseMs[eDir], ...
                    HOLDRISE_LO_MS, HOLDRISE_HI_MS, @sSfUnitsMs, 1)
    repeat eDir from DIR_RISE to DIR_FALL
        emitSignoff(@sSfCellHoldSlip, dirToken(eDir), @sSfCritSlipTk, bSfSlipMeas[eDir], sfSlipTicks[eDir], ...
                    wheel.HOLD_SLIP_TICKS, wheel.HOLD_SLIP_TICKS, @sSfUnitsTicks, 1)
#endif
#ifdef SINGLE_PART_SAG
    nExpect := 0
    if rowIdx >= 0
        nExpect := sagExpectFault[rowIdx] ? 1 : 0
    emitSignoff(@sSfCellSagType, @sInstTop, @sSfCritFltFirst, bSfSagMeas and (rowIdx >= 0), sfSagFirst, ...
                nExpect, nExpect, @sSfUnitsBool01, sgSagRun)
#endif

PRI coastBound(bHigh) : nMs
' R23-SGL-COAST's bound at the told row (DAT coastLoMs / coastHiMs): 0 with no row.
'
' @param bHigh - T/F where T means the upper bound
' @returns nMs - the bound, ms

    nMs := 0
    if rowIdx >= 0
        if bHigh
            nMs := coastHiMs[rowIdx]
        else
            nMs := coastLoMs[rowIdx]

PRI emitSignoff(pCell, pInst, pCrit, bMeasured, measuredVal, loLimit, hiLimit, pUnits, instCount) | boundedVal, pVerdict
' Emit one SIGNOFF verdict (sf 1): PASS only when measured AND in loLimit..hiLimit, judged on the printed (clamped)
' value; FAIL when measured and outside; NOMEAS, with measured NA and n 0, when not measured.
'
' @param pCell - pointer to the cell id token
' @param pInst - pointer to the instance's token (a set, a sign, a sign-change, a sign-kind, REVERSAL)
' @param pCrit - pointer to the criterion token
' @param bMeasured - TRUE when the instance was measured
' @param measuredVal - the instance's measured value
' @param loLimit - lowest passing value, compiled in
' @param hiLimit - highest passing value, compiled in
' @param pUnits - pointer to the units token
' @param instCount - bursts or revolutions behind measuredVal

' Local Variables:
' @local boundedVal - measuredVal clamped to +/-LIM_BIG
' @local pVerdict - PASS, FAIL or NOMEAS token

    boundedVal := (measuredVal #> (0 - LIM_BIG)) <# LIM_BIG
    if bMeasured == FALSE
        pVerdict := @sSfNomeas
    elseif (boundedVal >= loLimit) and (boundedVal <= hiLimit)
        pVerdict := @sSfPass
    else
        pVerdict := @sSfFail
    benchLog.begin(@"SIGNOFF")
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.tokenField(@"bin", @sSfBin, TOKMAX_BIN)
    benchLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    benchLog.tokenField(@"task", cellTask(pCell), TOKMAX_TASK)
    benchLog.tokenField(@"motor", pInst, TOKMAX_INST)
    benchLog.tokenField(@"crit", pCrit, TOKMAX_CRIT)
    benchLog.naNumField(@"measured", boundedVal, LIM_BIG, bMeasured)
    benchLog.numField(@"lo", loLimit, LIM_BIG)
    benchLog.numField(@"hi", hiLimit, LIM_BIG)
    benchLog.tokenField(@"units", pUnits, TOKMAX_UNITS)
    benchLog.numField(@"n", bMeasured ? instCount : 0, LIM_SMALL)
    benchLog.tokenField(@"verdict", pVerdict, TOKMAX_SFVERDICT)
    lineEmit()

PRI lineEmit()
' Emit the assembled record: the one debug() statement every record goes through.

    debug(zstr_(benchLog.pLine()))

CON { --- tokens --- }

PRI setToken(setIdx) : pToken
' Return a set's token.
'
' @param setIdx - SET_*
' @returns pToken - pointer to NEG-SLOW, POS-SLOW, NEG-FAST or POS-FAST ("NA" outside the enum)

    case setIdx
        SET_NEG_SLOW:   pToken := @sSetNegSlow
        SET_POS_SLOW:   pToken := @sSetPosSlow
        SET_NEG_FAST:   pToken := @sSetNegFast
        SET_POS_FAST:   pToken := @sSetPosFast
        other:          pToken := @sNa

PRI rungToken(eRung) : pToken
' Return a rung's token.
'
' @param eRung - RUNG_SLOW or RUNG_FAST
' @returns pToken - pointer to SLOW or FAST

    pToken := (eRung == RUNG_SLOW) ? @sRungSlow : @sRungFast

PRI directionToken(nTicks) : pToken
' Return the direction a signed tick count measured.
'
' @param nTicks - signed hall ticks
' @returns pToken - pointer to RISE (the order 1-5-4-6-2-3 rose), FALL, or NONE

    if nTicks > 0
        pToken := @sDirRise
    elseif nTicks < 0
        pToken := @sDirFall
    else
        pToken := @sDirNone

PRI revisionToken(eRevision) : pToken
' Return a board revision's token.
'
' @param eRevision - REV_*
' @returns pToken - pointer to REV_A, REV_B or NONE

    case eRevision
        wheel.REV_A:    pToken := @sRevA
        wheel.REV_B:    pToken := @sRevB
        other:          pToken := @sRevUnknown

PRI outcomeToken(eOutcome) : pToken
' Return a burst outcome's token.
'
' @param eOutcome - BO_*
' @returns pToken - pointer to its name ("NA" outside the enum)

    case eOutcome
        BO_RUNNING:      pToken := @sBoRunning
        BO_DONE:         pToken := @sBoDone
        BO_FAULT:        pToken := @sBoFault
        BO_OVER_CURRENT: pToken := @sBoOverCurrent
        BO_CHARGE_CAP:   pToken := @sBoChargeCap
        BO_STALL:        pToken := @sBoStall
        BO_TIMEOUT:      pToken := @sBoTimeout
        BO_TIME_CAP:     pToken := @sBoTimeCap
        BO_REFUSED:      pToken := @sBoRefused
        BO_STEP_CAP:     pToken := @sBoStepCap
        BO_LEG_CAP:      pToken := @sBoLegCap
        other:           pToken := @sNa

PRI abortToken(eReason) : pToken
' Return an abort reason's token.
'
' @param eReason - AR_*
' @returns pToken - pointer to its name ("NA" outside the enum)

    case eReason
        AR_NONE:        pToken := @sArNone
        AR_NOT_DOCO:    pToken := @sArNotDoco
        AR_NO_PART:     pToken := @sArNoPart
        AR_BOARD:       pToken := @sArBoard
        AR_START:       pToken := @sArStart
        AR_LIMITS:      pToken := @sArLimits
        AR_ENC_START:   pToken := @sArEncStart
        AR_ZERO:        pToken := @sArZero
        AR_BURST:       pToken := @sArBurst
        AR_ENC_CHECK:   pToken := @sArEncCheck
        AR_ROW:         pToken := @sArRow
        AR_GUARD:       pToken := @sArGuard
        AR_ENC_WIN:     pToken := @sArEncWin
        AR_CAP:         pToken := @sArCap
        AR_SETTING:     pToken := @sArSetting
        AR_WORKER:      pToken := @sArWorker
        AR_WIRING:      pToken := @sArWiring
        other:          pToken := @sNa

PRI signToken(eSign) : pToken
' Return an increment sign's token.
'
' @param eSign - SIGN_NEG or SIGN_POS
' @returns pToken - pointer to NEG or POS

    pToken := (eSign == SIGN_NEG) ? @sSignNeg : @sSignPos

PRI chgToken(eIdx) : pToken
' Return R23-SGL-RAMPARR's instance token: sign x CHG_COUNT + change.
'
' @param eIdx - 0 .. SIGN_COUNT x CHG_COUNT - 1
' @returns pToken - pointer to NEG-UP, NEG-DN, POS-UP or POS-DN

    case eIdx
        0:      pToken := @sInstNegUp
        1:      pToken := @sInstNegDn
        2:      pToken := @sInstPosUp
        3:      pToken := @sInstPosDn
        other:  pToken := @sNa

PRI kindToken(eIdx) : pToken
' Return R23-SGL-STOPROT's and -STOPTIME's instance token: sign x KIND_COUNT + kind.
'
' @param eIdx - 0 .. SIGN_COUNT x KIND_COUNT - 1
' @returns pToken - pointer to NEG-TOP, NEG-CRWL, POS-TOP or POS-CRWL

    case eIdx
        0:      pToken := @sInstNegTop
        1:      pToken := @sInstNegCrawl
        2:      pToken := @sInstPosTop
        3:      pToken := @sInstPosCrawl
        other:  pToken := @sNa

PRI roToken(eRo) : pToken
' Return a 2a run outcome's token.
'
' @param eRo - RO_*
' @returns pToken - pointer to its name ("NA" outside the enum)

    case eRo
        RO_NOT_RUN:     pToken := @sRoNotRun
        RO_DONE:        pToken := @sRoDone
        RO_FAULT:       pToken := @sRoFault
        RO_REFUSED:     pToken := @sRoRefused
        RO_SKIPPED:     pToken := @sRoSkipped
        RO_TIMEOUT:     pToken := @sRoTimeout
        RO_ABORTED:     pToken := @sRoAborted
        RO_WALL:        pToken := @sRoWall
        RO_STOPPED:     pToken := @sHeStopped
        other:          pToken := @sNa

PRI srToken(eReason) : pToken
' Return the library's stop reason's token.
'
' @param eReason - wheel.SR_*
' @returns pToken - pointer to its name ("NA" outside the enum)

    case eReason
        wheel.SR_NONE:              pToken := @sSrNone
        wheel.SR_COMMANDED:         pToken := @sSrCommanded
        wheel.SR_AT_LIMIT:          pToken := @sSrAtLimit
        wheel.SR_FAULT_CONTROLLED:  pToken := @sSrFaultCtl
        wheel.SR_FAULT_LOST:        pToken := @sSrFaultLost
        wheel.SR_BLOCKED:           pToken := @sSrBlocked
        wheel.SR_LINK_LOST:         pToken := @sSrLinkLost
        wheel.SR_EMERGENCY:         pToken := @sSrEmergency
        wheel.SR_PARTNER:           pToken := @sSrPartner
        other:                      pToken := @sNa

