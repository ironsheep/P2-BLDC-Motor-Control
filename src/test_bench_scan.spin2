wdCheckpoint    LONG    CP_INIT                             ' beat()'s last checkpoint id
wdDeclaring     LONG    FALSE                                ' set TRUE as declareStall()'s first
                                                             ' statement, before it touches
                                                             ' anything else: main() checks this
                                                             ' before cogstop-ping the watchdog,
                                                             ' so it never interrupts a
                                                             ' stall-declaration in progress

