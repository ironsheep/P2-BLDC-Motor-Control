    LONG    ptResult
    LONG    bPtCommanded
    LONG    ptSteadyMs
    LONG    bPtWinRan
    LONG    ptTicks
    LONG    ptWinMs
    LONG    ptRateX10
    LONG    bPtRateOk
    LONG    ptSamples
    LONG    ptMeanX10
    LONG    ptSeX10
    LONG    bPtSeValid
    LONG    ptHalfAX10
    LONG    ptHalfBX10
    LONG    bPtHalvesValid
    LONG    bPtUnsettled
    LONG    ptMinMv
    LONG    ptMaxMv
    LONG    ptDutyMean
    LONG    ptErrMean
    LONG    ptMissedD
    LONG    ptIllegalD
    LONG    bPtIntegValid
    LONG    ptChargeMvS
    LONG    ptNegDeg
    LONG    ptPosDeg
    LONG    batchMeanF[MAX_BATCHES]
    LONG    ptZeroX10                                       ' scan v4 CHANGE 1: this point's own
                                                             ' zero (measureZero()'s reading, taken
                                                             ' immediately before it), x10 mV
    LONG    bPtZeroValid                                     ' scan v4 CHANGE 1: TRUE when that zero
                                                             ' call took at least one sample
    LONG    ptNetX10                                         ' scan v4 CHANGE 1: ptMeanX10 - ptZeroX10

    ' The drive span's readings, kept per point (task 3595). THESE ARE PRESENT ON EVERY COMMANDED
    '  POINT, whatever its result -- that is their whole reason for existing.
    LONG    bPtSpanValid                                    ' TRUE when the span ran long enough to divide by
    LONG    ptSpanRateX10                                   ' ticks/s x10 over the whole commanded span
    LONG    ptSpanDutyMean                                  ' mean duty the servo demanded over it
    LONG    ptSpanDutyMax                                   ' the largest duty it demanded
    LONG    ptFollowPct                                     ' achieved rate as a percent of commanded: 100 = following

VAR { the leg in progress }

    LONG    legCount
    LONG    legDeg[MAX_LEG_POINTS]
    LONG    legMeanX10[MAX_LEG_POINTS]
    LONG    legZeroX10[MAX_LEG_POINTS]                       ' scan v4 CHANGE 1: this point's own zero
    LONG    legNetX10[MAX_LEG_POINTS]                         ' scan v4 CHANGE 1: legMeanX10 - legZeroX10
    LONG    bLegZeroValid[MAX_LEG_POINTS]                     ' task 3537 R9: that point's bPtZeroValid
    LONG    legSeX10[MAX_LEG_POINTS]
    LONG    bLegSeValid[MAX_LEG_POINTS]
    LONG    legResult[MAX_LEG_POINTS]
    LONG    legPhase[MAX_LEG_POINTS]
    LONG    bLegRateOk[MAX_LEG_POINTS]
    LONG    bLegSpanValid[MAX_LEG_POINTS]                    ' task 3595: this point's drive span was long enough to judge
    LONG    legFollowPct[MAX_LEG_POINTS]                     ' task 3595: achieved rate as a percent of commanded
    LONG    legBoundUp                                       ' task 3595: BT_* that stopped the up side of this leg's arc
    LONG    legBoundDown                                     ' task 3595: BT_* that stopped the down side
    LONG    legArcLoDeg                                      ' task 3595: lowest swept offset this leg reached cleanly
    LONG    legArcHiDeg                                      ' task 3595: highest, so the report names the ARC, not a pass
    LONG    bLegArcValid                                     ' TRUE once at least one valid point set the arc
    LONG    legLowIdx
    LONG    legConsecFaults
    LONG    legFaults
    LONG    legAbortsI
    LONG    seScratch[MAX_LEG_POINTS]
    LONG    legCliffFound
    LONG    legCliffGoodDeg
    LONG    legCliffFaultDeg
    LONG    legLimitUpDeg                                    ' CHANGE 1: fault-bounded window, up side
    LONG    legLimitDownDeg                                  ' CHANGE 1: fault-bounded window, down side
    LONG    bLegLimitUpFault                                 ' TRUE when legLimitUpDeg came from a fault, not the hard limit
    LONG    bLegLimitDownFault                               ' TRUE when legLimitDownDeg came from a fault, not the hard limit

VAR { the fit just computed }

    LONG    fitStatus
    LONG    fitN
    LONG    fitCentre
    LONG    fitSpanLo
    LONG    fitSpanHi
    LONG    bFitExtended
    LONG    bFitSolved
    LONG    fitMinF
    LONG    fitSeF
    LONG    bFitSeValid
    LONG    fitMinMvF
    LONG    fitRmsF
    LONG    fitMedSeX10
    LONG    fitCurvF

VAR { results, index = resultSlot(side, sign, speed) }

    LONG    resStatus[RESULT_SLOTS]
    LONG    resMinF[RESULT_SLOTS]
    LONG    resSeF[RESULT_SLOTS]
    LONG    bResSeValid[RESULT_SLOTS]
    LONG    resIminF[RESULT_SLOTS]
    LONG    resRmsF[RESULT_SLOTS]
    LONG    resIdefX10[RESULT_SLOTS]
    LONG    bResIdefValid[RESULT_SLOTS]
    LONG    bResDrift[RESULT_SLOTS]
    LONG    bResPinned[RESULT_SLOTS]                          ' task 3540 D2: bFitPinnedNearLimit() at this slot's fit
    LONG    bResBracketed[RESULT_SLOTS]                       ' task 3540 D2: rise-on-both-sides held (real test, both speeds)
    LONG    resFloorX10[RESULT_SLOTS]                          ' task 3540 D3: legMeasuredFloor()'s lowest measured net point
    LONG    resFloorDeg[RESULT_SLOTS]                          ' that point's swept offset, degrees
    LONG    bResFloorValid[RESULT_SLOTS]                       ' TRUE when this leg measured at least one valid point
    LONG    selfMeanX10[SIDE_SLOTS * SIGN_SLOTS]
    LONG    zeroMeanX10[SIDE_SLOTS]
    LONG    bZeroOk[SIDE_SLOTS]

VAR { sign-off accumulators, task 3537 -- index sideSlot(side); cog 0 only, the watchdog reads none }

    LONG    sfStarts[SIDE_SLOTS]                            ' bStartSide() calls
    LONG    sfCogBad[SIDE_SLOTS]                            ' starts whose start() return was outside 0..MAX_COG_ID or not testGetMotorCog() - 1
    LONG    sfRevbBad[SIDE_SLOTS]                           ' starts not detected as Rev B
    LONG    sfReadbacks[SIDE_SLOTS]                         ' offset read-backs checked: every start + every applyOffsets()
    LONG    sfOffsetsBad[SIDE_SLOTS]                        ' offset read-backs that did not match
    LONG    sfStartIllegal[SIDE_SLOTS]                      ' starts whose start-time illegal hall count was non-zero
    LONG    sfIntegSum[SIDE_SLOTS]                          ' missed + illegal over starts and integrity-valid points, saturated at LIM_BIG
    LONG    sfIntegN[SIDE_SLOTS]                            ' integrity-valid points summed into sfIntegSum
    LONG    sfAliveJudged[SIDE_SLOTS]                       ' starts judged alive or not (R12-SCAN-ALIVE's n)
    LONG    sfNotAlive[SIDE_SLOTS]                          ' judged starts that were not alive
    LONG    bSfLifetimeFresh[SIDE_SLOTS]                    ' TRUE from a ready start until its lifetime's first zero is judged
    LONG    bSfSelfIRan[SIDE_SLOTS]                         ' TRUE when the self-check's net-current result is a measurement
    LONG    bSfSelfIOk[SIDE_SLOTS]                          ' TRUE when both self-check net current bands held
    LONG    bSfSelfRateRan[SIDE_SLOTS]                      ' TRUE when the self-check's rate result is a measurement
    LONG    bSfSelfRateOk[SIDE_SLOTS]                       ' TRUE when the self-check's rate check held
    ' task 3537 phase 2b2 -- R8 (index (sideSlot * ZXS_CHANNELS) + ZXS_CH_*) and R9
    LONG    zxsMin[SIDE_SLOTS * ZXS_CHANNELS]               ' smallest PH_XSTART lifetime-first full zero mean, mV x10
    LONG    zxsMax[SIDE_SLOTS * ZXS_CHANNELS]               ' largest PH_XSTART lifetime-first full zero mean, mV x10
    LONG    zxsN[SIDE_SLOTS]                                ' PH_XSTART zeros folded into zxsMin/zxsMax
    LONG    zxsAllMin[SIDE_SLOTS * ZXS_CHANNELS]            ' smallest lifetime-first full zero mean, any phase, mV x10
    LONG    zxsAllMax[SIDE_SLOTS * ZXS_CHANNELS]            ' largest lifetime-first full zero mean, any phase, mV x10
    LONG    zxsAllN[SIDE_SLOTS]                             ' zeros folded into zxsAllMin/zxsAllMax
    LONG    bResLegRan[RESULT_SLOTS]                        ' TRUE when runLeg() ended this slot's leg other than LX_SKIPPED
    LONG    resZeroMissing[RESULT_SLOTS]                    ' that leg's valid points without a valid own zero
    LONG    resZeroChecked[RESULT_SLOTS]                    ' that leg's valid points (R9-SCAN-OWNZERO's n)
    LONG    bSfPair2Complete[SIDE_SLOTS]                    ' emitPair2()'s bComplete for this motor
    LONG    bSfPair2NetOk[SIDE_SLOTS]                       ' emitPair2()'s bRatio for this motor
    ' task 3537 phase 2b3 -- R10-SCAN-RSTALONE, one testResetFault()-alone attempt per motor
    LONG    bSfRstAloneDone[SIDE_SLOTS]                     ' TRUE once this motor's one attempt was taken
    LONG    rstAloneMs[SIDE_SLOTS]                          ' ms testResetFault() took, via sideResetFault()
    LONG    bRstAloneStopped[SIDE_SLOTS]                    ' isSideStopped() right after it
    LONG    bRstAloneFault[SIDE_SLOTS]                      ' isSideFault() right after it
    LONG    bRstAloneCleared[SIDE_SLOTS]                    ' stopped and not faulted: the R10 measured value
    LONG    rstAloneIncre[SIDE_SLOTS]                       ' the faulted point's increment, still commanded
    LONG    rstAloneSwept[SIDE_SLOTS]                       ' the faulted point's swept offset, degrees
    ' task 3537 phase 2c -- WD_SELFTEST outcome as cog 0 saw it (the watchdog's own verdicts need none)
    LONG    bWdtBackstopHit                                 ' TRUE when the stall reached WD_SELFTEST_BACKSTOP_MS
    LONG    wdtBackstopMs                                   ' elapsed stall ms when it did

VAR { watchdog cog, task 3534 }

    LONG    wdStack[WD_STACK_LONGS]
    LONG    wdStackSentinel                                 ' MUST abut wdStack in this SAME
                                                             ' block (p2kbAppNoteP2an006): filled
                                                             ' with WD_STACK_SENTINEL before
                                                             ' cogspin, checked intact at the end
                                                             ' of the stall path -- cogspin does
                                                             ' not detect an overflow itself
    LONG    wdCogId                                         ' cogspin()'s return; <0 if it failed

VAR { watchdog stall snapshot, task 3537 phase 2c -- written only by the watchdog cog, in wdSnapshotStall(),
      before declareStall() stops the wheels; read by emitWatchdog() and declareStall() afterwards }

    LONG    wdSnapCheckpoint                                ' wdCheckpoint at the declaration
    LONG    wdSnapLeftCog                                   ' wheelL.testGetMotorCog() before the stops
    LONG    wdSnapLeftState                                 ' wheelL.getDriverState()
    LONG    wdSnapLeftFault                                 ' wheelL.isFaultSignal()
    LONG    wdSnapLeftDuty                                  ' wheelL.testGetTelemetry() duty
    LONG    wdSnapLeftErr                                   ' wheelL.testGetTelemetry() err
    LONG    wdSnapLeftSense                                 ' wheelL.testGetTelemetry() sense_i_mV
    LONG    wdSnapLeftTicks                                 ' wheelL.getRawHallTicks()
    LONG    wdSnapRightCog                                  ' wheelR.testGetMotorCog() before the stops
    LONG    wdSnapRightState                                ' wheelR.getDriverState()
    LONG    wdSnapRightFault                                ' wheelR.isFaultSignal()
    LONG    wdSnapRightDuty                                 ' wheelR.testGetTelemetry() duty
    LONG    wdSnapRightErr                                  ' wheelR.testGetTelemetry() err
    LONG    wdSnapRightSense                                ' wheelR.testGetTelemetry() sense_i_mV
    LONG    wdSnapRightTicks                                ' wheelR.getRawHallTicks()

PUB main() | trapCode
'' Run the unattended commutation-offset scan, then stop both wheels and end the session.
''

' Local Variables:
' @local trapCode - value delivered by the abort trap around bRunScan()

    wdStackSentinel := WD_STACK_SENTINEL                    ' fill BEFORE cogspin (p2kb: sentinel
                                                             ' must be in place before the cog that
                                                             ' can overrun it starts)
    benchLog.cogEventBegin()
    wdCogId := cogspin(NEWCOG, watchdog(), @wdStack)        ' task 3534: watch cog 0 from the start
    benchLog.cogEventEnd()
    emitWatchdogStart(wdCogId >= 0, wdCogId)                ' if it failed, say so and run unwatched
    initRunState()
    emitHeaderRecords()
    bRunReturned := FALSE
    trapCode := \bRunScan()                                  ' a library abort lands here, not past the stop()s
    runTrapCode := trapCode                                 ' task 3540 TOP-LEVEL TRAP: printed by emitEnd() every run
    if bRunReturned == FALSE
        setRunAbort(AR_LIB_ABORT, trapCode)
    shutdownMotors()                                        ' every cog-0 path: both wheels stop() (on the watchdog
                                                             ' path beat() parks cog 0 before this; the watchdog
                                                             ' has already stopped both wheels)
    ' Stop the watchdog cog (if it started) BEFORE emitEnd()/the marker, or a silent cog 0 -- now
    ' true, since main() is about to fall off the end -- would leave it counting toward its own
    ' WD_STALL_MS and firing a bogus second BS-WATCHDOG/BS-END/marker 4 s later (found in review).
    ' wdDeclaring closes the race against that same watchdog cog already being mid-declaration
    ' (set as declareStall()'s first statement, before it touches anything else): if cog 0 ever
    ' reaches this point while wdDeclaring is FALSE, the watchdog's own last-beat timestamp is
    ' necessarily fresh (shutdownMotors() just beat moments ago), so it cannot cross WD_STALL_MS
    ' and flip wdDeclaring TRUE before the cogstop below reaches it; if wdDeclaring is already
    ' TRUE, that stall-declaration is now the session's real end record, and cog 0 must not stop
    ' that cog mid-record or also emit a second BS-END/marker of its own.
    if wdDeclaring == FALSE
        if wdCogId >= 0
            benchLog.cogEventBegin()
            cogstop(wdCogId)
        emitSignoffs()                                      ' task 3537: every declared cell, watchdog stopped, wheels stopped
        emitEnd()
        ' QUOTED, not backticked -- a backtick makes it a display command and the marker is missed.
        debug("DEBUG_END_SESSION")
    else
        ' A repeat of WD_IDLE_MS, not one waitms(60_000): 60_000 ms is 16.2e9 clocks at 270 MHz,
        ' over WAITMS_MAX_MS's ~7_953 ms bound (p2kbSpin2Waitms) -- it would silently overflow
        ' and wait a wrong, arbitrary time instead of idling (found in review).
        repeat
            waitms(WD_IDLE_MS)

PRI initRunState() | slotIdx
' Reset every run-wide counter and result slot.
'
' @local slotIdx - result or self-check slot index

    beat(CP_INIT)
    currentSide := SIDE_NONE
    runStartMs := getms()
    abortReason := AR_NONE
    bRunReturned := FALSE
    pointSeq := 0
    runFaults := 0
    runAbortsI := 0
    runChargeMvS := 0
    lastIncre := 0
    bLastStartOk := FALSE
    bLeftDone := FALSE
    bRightDone := FALSE
    sampPrevMs := runStartMs
    sampChargeMvMs := 0
    bWdtBackstopHit := FALSE                                ' task 3537 phase 2c: no backstop is NOMEAS
    wdtBackstopMs := 0
    repeat slotIdx from 0 to RESULT_SLOTS - 1
        resStatus[slotIdx] := FS_SKIPPED
        bResSeValid[slotIdx] := FALSE
        bResIdefValid[slotIdx] := FALSE
        bResDrift[slotIdx] := FALSE
        bResPinned[slotIdx] := FALSE                        ' task 3540 D2
        bResBracketed[slotIdx] := FALSE
        resFloorX10[slotIdx] := 0                           ' task 3540 D3
        resFloorDeg[slotIdx] := 0
        bResFloorValid[slotIdx] := FALSE
        bResLegRan[slotIdx] := FALSE                        ' task 3537 R9: never reached is NOMEAS
        resZeroMissing[slotIdx] := 0
        resZeroChecked[slotIdx] := 0
    repeat slotIdx from 0 to (SIDE_SLOTS * ZXS_CHANNELS) - 1
        zxsMin[slotIdx] := POSX                             ' task 3537 R8: max < min reads as nothing folded
        zxsMax[slotIdx] := NEGX
        zxsAllMin[slotIdx] := POSX
        zxsAllMax[slotIdx] := NEGX
    repeat slotIdx from 0 to (SIDE_SLOTS * SIGN_SLOTS) - 1
        selfMeanX10[slotIdx] := 0
    repeat slotIdx from 0 to SIDE_SLOTS - 1
        zeroMeanX10[slotIdx] := 0
        bZeroOk[slotIdx] := FALSE
        sfStarts[slotIdx] := 0                              ' task 3537 sign-off accumulators
        sfCogBad[slotIdx] := 0
        sfRevbBad[slotIdx] := 0
        sfReadbacks[slotIdx] := 0
        sfOffsetsBad[slotIdx] := 0
        sfStartIllegal[slotIdx] := 0
        sfIntegSum[slotIdx] := 0
        sfIntegN[slotIdx] := 0
        sfAliveJudged[slotIdx] := 0
        sfNotAlive[slotIdx] := 0
        bSfLifetimeFresh[slotIdx] := FALSE
        bSfSelfIRan[slotIdx] := FALSE
        bSfSelfIOk[slotIdx] := FALSE
        bSfSelfRateRan[slotIdx] := FALSE
        bSfSelfRateOk[slotIdx] := FALSE
        zxsN[slotIdx] := 0
        zxsAllN[slotIdx] := 0
        bSfPair2Complete[slotIdx] := FALSE
        bSfPair2NetOk[slotIdx] := FALSE
        bSfRstAloneDone[slotIdx] := FALSE                   ' task 3537 R10: no attempt is NOMEAS
        rstAloneMs[slotIdx] := 0
        bRstAloneStopped[slotIdx] := FALSE
        bRstAloneFault[slotIdx] := FALSE
        bRstAloneCleared[slotIdx] := FALSE
        rstAloneIncre[slotIdx] := 0
        rstAloneSwept[slotIdx] := 0

PRI bRunScan() : bCompleted
' Preflight, then the LEFT and RIGHT motor blocks. Every stage is skipped once the run aborts.
' Under -D WD_SELFTEST (task 3537 phase 2c, design sec G.3) preflight is followed by the watchdog
' self-test instead: no motor block is ever on that path.
'
' @returns bCompleted - TRUE when no run abort occurred

    bCompleted := FALSE
    if bPreflightWheels() == FALSE
        setRunAbort(AR_PREFLIGHT, 0)                        ' kept only if no earlier cause was recorded
#ifdef WD_SELFTEST
    runWatchdogSelfTest()                                   ' parks forever once the watchdog declares
#else
    if abortReason == AR_NONE
        runMotorBlock(SIDE_LEFT, SIGN_NEG)
    if abortReason == AR_NONE
        bLeftDone := TRUE
        runMotorBlock(SIDE_RIGHT, SIGN_POS)
    if abortReason == AR_NONE
        bRightDone := TRUE
#endif
    bCompleted := (abortReason == AR_NONE)
    bRunReturned := TRUE                                    ' set on the way out, or main() reads it as a library abort

PRI runWatchdogSelfTest() | stallStartMs
' The watchdog self-test (task 3537 phase 2c, design sec G.3; called only by the WD_SELFTEST build). With
' the wheels at rest after preflight (the RIGHT driver cog still running at zero command), print
' BS-WDTEST-ARM, beat CP_SELFTEST as the LAST beat, then stall on purpose: a beat-free loop that only
' polls wdDeclaring. Once the watchdog declares, cog 0 parks forever without emitting or beating (the
' watchdog cog owns the session's end and emits the four R11-WDT-* verdicts itself), mirroring beat()'s
' PARK. If WD_SELFTEST_BACKSTOP_MS passes first, the watchdog is dead: record the elapsed stall and
' return, so main() stops both wheels and emitSignoffs() prints R11-WDT-FIRES FAIL.
' No watchdog cog, or an aborted preflight: nothing to test -- return at once, and emitSignoffs() prints
' all four as NOMEAS, n 0. The only waitms() here is WD_POLL_MS, the one deliberate beat-free wait
' (design sec F.4), far under WD_STALL_MS and WAITMS_MAX_MS.
'
' @local stallStartMs - getms() when the deliberate stall began

    if (abortReason == AR_NONE) and (wdCogId >= 0)
        emitWdTestArm()
        beat(CP_SELFTEST)                                   ' the LAST beat: the watchdog must declare at this checkpoint
        stallStartMs := getms()
        repeat                                              ' deliberate stall: NO beat() from here
            waitms(WD_POLL_MS)
            if wdDeclaring
                repeat                                      ' park, never emit, never beat (see beat()'s PARK)
                    waitms(WD_IDLE_MS)
            if (getms() - stallStartMs) >= WD_SELFTEST_BACKSTOP_MS
                quit
        wdtBackstopMs := getms() - stallStartMs
        bWdtBackstopHit := TRUE

PRI emitWdTestArm()
' Emit BS-WDTEST-ARM (task 3537 phase 2c, fmt 9, WD_SELFTEST build): the state the deliberate stall starts
' from -- both wheels' raw testGetMotorCog() values (as BS-WATCHDOG2's l_cog/r_cog print them), the
' checkpoint the watchdog must report, and the compiled stall, poll and backstop bounds.
' Worst case: tag(13) + l_cog(1+5+1+4=11) + r_cog(11) + checkpoint(1+10+1+4=16) +
' checkpoint_tok(1+14+1+10=26) + stall_ms(1+8+1+7=17) + poll_ms(1+7+1+7=16) + backstop_ms(1+11+1+7=20)
' = 130 bytes.

    benchLog.begin(@"BS-WDTEST-ARM")
    benchLog.numField(@"l_cog", sideMotorCog(SIDE_LEFT), LIM_TINY)
    benchLog.numField(@"r_cog", sideMotorCog(SIDE_RIGHT), LIM_TINY)
    benchLog.numField(@"checkpoint", CP_SELFTEST, LIM_TINY)
    benchLog.tokenField(@"checkpoint_tok", checkpointToken(CP_SELFTEST), TOKMAX_CP)
    benchLog.numField(@"stall_ms", WD_STALL_MS, LIM_SMALL)
    benchLog.numField(@"poll_ms", WD_POLL_MS, LIM_SMALL)
    benchLog.numField(@"backstop_ms", WD_SELFTEST_BACKSTOP_MS, LIM_SMALL)
    lineEmit()

PRI setRunAbort(reason, detailValue)
' Record the first run-abort cause and emit its BS-ABORT; later causes are ignored.
'
' @param reason - AR_* cause
' @param detailValue - the reading or code that triggered it

    if abortReason == AR_NONE
        abortReason := reason
        emitAbort(SCOPE_RUN, reason, currentSide, lastIncre, detailValue)

PRI runGuard() | elapsedS
' Check the run-wide caps between points.
'
' @local elapsedS - seconds since run start

    if abortReason == AR_NONE
        elapsedS := (getms() - runStartMs) / MS_PER_SEC
        if elapsedS >= RUN_TIME_CAP_S
            setRunAbort(AR_TIME_CAP, elapsedS)
        elseif runChargeMvS >= RUN_CHARGE_CAP_MVS
            setRunAbort(AR_CHARGE_CAP, runChargeMvS)
        elseif runFaults >= RUN_FAULT_CAP
            setRunAbort(AR_FAULT_CAP, runFaults)
        elseif runAbortsI >= RUN_ABORT_I_CAP
            setRunAbort(AR_ABORT_I_CAP, runAbortsI)

PRI shutdownMotors()
' Stop both wheels unconditionally. stop() on a never-started instance touches no pin.

    beat(CP_LIB_SHUTDOWN)
    benchLog.cogEventBegin()
    wheelL.stop()
    wheelR.stop()
    currentSide := SIDE_NONE
    beat(CP_LIB_SHUTDOWN)

PRI bPreflightWheels() : bAllMoved | side, ticksBefore, ticksAfter, ticksMoved, bNudgeFault
' Prove each declared wheel turns before committing the session to the scan.
'
' @returns bAllMoved - TRUE when both wheels moved and the run has not aborted
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local ticksBefore - hall ticks before the nudge
' @local ticksAfter - hall ticks after the nudge
' @local ticksMoved - signed tick delta across the nudge
' @local bNudgeFault - TRUE when the nudge faulted

    bAllMoved := TRUE
    repeat side from SIDE_LEFT to SIDE_RIGHT
        if abortReason == AR_NONE
            bRestartSide(side)
        if abortReason == AR_NONE
            ticksBefore := sideTicks(side)
            bNudgeFault := bDriveForMs(side, PREFLIGHT_INCRE, PREFLIGHT_MS)
            ticksAfter := sideTicks(side)
            if bSideCogRunning(side)
                commandMotor(side, 0)
                bWaitStopped(side)
            ticksMoved := ticksAfter - ticksBefore
            emitPreflight(side, ticksMoved)
            if ticksMoved == 0
                bAllMoved := FALSE
            if bNudgeFault and (abortReason == AR_NONE)
                runFaults += 1
                bRecoverFromFault(side, PREFLIGHT_INCRE, DEF_NEG_DEG)
    bAllMoved := bAllMoved and (abortReason == AR_NONE)

PRI runMotorBlock(side, firstSign) | secondSign, bSelfPassed
' Run one motor's deliberate cross-start zeros, start checks, zero reading, self-check, both
' quarter-speed legs, both half-speed legs, and its RESULT records.
' Task 3537 phase 2b2 (design sec F.3): first, ZXS_STARTS cycles of bRestartSide() -> a PH_XSTART zero
' -> a REST_MS rest, each skipped once the run has aborted. The wheel is floated throughout (init()
' sets SM_FLOAT, nothing is commanded). bRestartSide()'s start checks still apply: a failed check
' aborts the run inside bStartSide(), the loop quits on its next pass, and -- new guard -- the block's
' own bRestartSide() below is then skipped too, so no wheel is started after an abort.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param firstSign - SIGN_NEG or SIGN_POS, the sign whose legs run first
'
' @local secondSign - the other sign
' @local bSelfPassed - TRUE when the self-check passed

    secondSign := SIGN_POS - firstSign
    bSelfPassed := FALSE
    repeat ZXS_STARTS
        beat(CP_LOOP_XSTART)
        if abortReason <> AR_NONE
            quit
        bRestartSide(side)
        if abortReason == AR_NONE
            measureZero(side, PH_XSTART)
        if abortReason == AR_NONE
            restLoop()
    if abortReason == AR_NONE
        bRestartSide(side)
    if abortReason == AR_NONE
        measureZero(side, PH_ZERO_INIT)
    if abortReason == AR_NONE
        bSelfPassed := bRunSelfCheck(side)
    ' task 3595: the WALKING rung first -- every confirm rung centres on the minimum it finds, so it
    '  has to have run. Slowest first is also widest-arc first, which is the whole reason it walks.
    if abortReason == AR_NONE
        runLeg(side, SPEED_WALK, firstSign)
    if abortReason == AR_NONE
        runLeg(side, SPEED_WALK, secondSign)
    if abortReason == AR_NONE
        runLeg(side, SPEED_QTR, firstSign)
    if abortReason == AR_NONE
        runLeg(side, SPEED_QTR, secondSign)
    if abortReason == AR_NONE
        runLeg(side, SPEED_HALF, firstSign)
    if abortReason == AR_NONE
        runLeg(side, SPEED_HALF, secondSign)
    if bSelfPassed
        emitResults(side, firstSign)

PRI bRestartSide(side) : bStartOk
' Stop whichever wheel is running and this wheel, then start this wheel with start checks.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bStartOk - TRUE when every start check passed

    if (currentSide <> SIDE_NONE) and (currentSide <> side)
        sideStop(currentSide)
    sideStop(side)
    currentSide := SIDE_NONE
    bStartOk := bStartSide(side)

PRI bStartSide(side) : bStartOk | startedCog, initNeg, initPos, eBoardRev, nMissed, nIllegal, ...
    readNeg, readPos, bCogOk, bRevB, bOffsetsOk, bIntegOk, bReady, startSlot, bCogMatch
' Start one wheel and run the start checks: cog id, Rev B, integrity counts, and the offsets
' read back AFTER 43/317 are set explicitly. init()'s own offsets are logged, not required.
' Task 3537: also accumulates this start's sign-off facts (R1, R2, R3, R6, R7, R12) for its motor.
' A start whose driver did not report ready is judged not alive here; a ready start is judged at
' its lifetime's first zero (measureZero()).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bStartOk - TRUE when every start check passed
'
' @local bReady - TRUE when bWaitReady() saw the driver report ready within READY_TIMEOUT_MS
' @local startSlot - sideSlot(side), the sign-off accumulator index
' @local startedCog - start()'s return
' @local initNeg - offset_fwd degrees init() applied
' @local initPos - offset_rev degrees init() applied
' @local eBoardRev - REV_* recorded at start
' @local nMissed - missed hall transitions since start
' @local nIllegal - illegal hall codes since start
' @local readNeg - offset_fwd degrees read back after setting 43
' @local readPos - offset_rev degrees read back after setting 317
' @local bCogOk - TRUE when start() returned 0..MAX_COG_ID
' @local bCogMatch - TRUE when bCogOk AND the return equals testGetMotorCog() - 1 (R1-SCAN-COGOK
'   only; the run's own start check still uses bCogOk)
' @local bRevB - TRUE when the board is Rev B
' @local bOffsetsOk - TRUE when the read-back is exactly 43/317
' @local bIntegOk - TRUE when no illegal hall code was seen at start

    startedCog := sideStart(side)
    currentSide := side
    bReady := bWaitReady(side)
    initNeg, initPos := sideGetOffsets(side)
    eBoardRev := sideBoardType(side)
    nMissed, nIllegal := sideIntegrity(side)
    sideSetOffsets(side, DEF_NEG_DEG, DEF_POS_DEG)
    readNeg, readPos := sideGetOffsets(side)
    bCogOk := (startedCog >= 0) and (startedCog <= MAX_COG_ID)
    ' R1-SCAN-COGOK (arbiter review, task 3537): a return in 0..7 is not enough -- PL-22's pre-3499
    '  start() returned 0 while its driver ran in cog 1, which is inside 0..7. The return must also
    '  name the cog the driver actually runs in, as R1-T0-START checks.
    bCogMatch := bCogOk and (startedCog == sideMotorCog(side) - 1)
    bRevB := (eBoardRev == wheelL.REV_B)
    bOffsetsOk := (readNeg == DEF_NEG_DEG) and (readPos == DEF_POS_DEG)
    bIntegOk := (nIllegal == 0)
    bStartOk := bCogOk and bRevB and bOffsetsOk and bIntegOk
    bLastStartOk := bStartOk
    emitStart(side, startedCog, bCogOk, eBoardRev, bRevB, initNeg, initPos, readNeg, readPos, ...
        bOffsetsOk, nMissed, nIllegal, bIntegOk, bStartOk)
    ' task 3537 sign-off accumulators -- every value below was computed in this call, above
    startSlot := sideSlot(side)
    sfStarts[startSlot] += 1
    if bCogMatch == FALSE
        sfCogBad[startSlot] += 1
    if bRevB == FALSE
        sfRevbBad[startSlot] += 1
    sfReadbacks[startSlot] += 1
    if bOffsetsOk == FALSE
        sfOffsetsBad[startSlot] += 1
    if nIllegal <> 0
        sfStartIllegal[startSlot] += 1
    addIntegritySum(startSlot, nMissed, nIllegal)
    if bReady
        bSfLifetimeFresh[startSlot] := TRUE                 ' judged at this lifetime's first zero
    else
        sfAliveJudged[startSlot] += 1                       ' never ready: not alive, no zero needed
        sfNotAlive[startSlot] += 1
        bSfLifetimeFresh[startSlot] := FALSE
    if bCogOk == FALSE
        setRunAbort(AR_START_FAIL, startedCog)
    elseif bStartOk == FALSE
        setRunAbort(AR_START_CHECK, eBoardRev)

PRI addIntegritySum(slotIdx, nMissed, nIllegal)
' Add one start's or one point's hall integrity counts to its motor's R3-SCAN-INTEG sum (task 3537).
' Each count is clamped to +/-LIM_MID before abs(), so a negative (corrupt) count still adds and
' abs() never sees NEGX; the sum saturates at LIM_BIG: LIM_BIG + 2 x LIM_MID < POSX.
'
' @param slotIdx - sideSlot() of the motor
' @param nMissed - missed hall transitions
' @param nIllegal - illegal hall codes

    sfIntegSum[slotIdx] := (sfIntegSum[slotIdx] + abs((nMissed #> (0 - LIM_MID)) <# LIM_MID) + abs((nIllegal #> (0 - LIM_MID)) <# LIM_MID)) <# LIM_BIG

PRI foldZeroSpread(slotIdx, bIntoControlled, iMeanX10, uMeanX10, vMeanX10, wMeanX10) | baseIdx
' Fold one driver lifetime's first full zero into its motor's R8 spread accumulators (task 3537):
' always into zxsAll* (BS-ZXSALL), and into the controlled zxs* (R8-SCAN-ZXS) when it is a PH_XSTART
' zero.
'
' @param slotIdx - sideSlot() of the motor
' @param bIntoControlled - TRUE for a PH_XSTART zero
' @param iMeanX10 - the zero's sense_i mean x10, mV
' @param uMeanX10 - the zero's sense_u mean x10, mV
' @param vMeanX10 - the zero's sense_v mean x10, mV
' @param wMeanX10 - the zero's sense_w mean x10, mV
'
' @local baseIdx - index of this motor's ZXS_CH_I entry

    baseIdx := slotIdx * ZXS_CHANNELS
    foldZxsChannel(baseIdx + ZXS_CH_I, iMeanX10, bIntoControlled)
    foldZxsChannel(baseIdx + ZXS_CH_U, uMeanX10, bIntoControlled)
    foldZxsChannel(baseIdx + ZXS_CH_V, vMeanX10, bIntoControlled)
    foldZxsChannel(baseIdx + ZXS_CH_W, wMeanX10, bIntoControlled)
    zxsAllN[slotIdx] += 1
    if bIntoControlled
        zxsN[slotIdx] += 1

PRI foldZxsChannel(arrIdx, chMeanX10, bIntoControlled)
' Widen one motor-channel's min/max by one zero mean (task 3537 R8).
'
' @param arrIdx - (sideSlot * ZXS_CHANNELS) + ZXS_CH_*
' @param chMeanX10 - the channel's zero mean x10, mV
' @param bIntoControlled - TRUE for a PH_XSTART zero

    zxsAllMin[arrIdx] := zxsAllMin[arrIdx] <# chMeanX10
    zxsAllMax[arrIdx] := zxsAllMax[arrIdx] #> chMeanX10
    if bIntoControlled
        zxsMin[arrIdx] := zxsMin[arrIdx] <# chMeanX10
        zxsMax[arrIdx] := zxsMax[arrIdx] #> chMeanX10

PRI zxsSpreadX10(arrIdx, bControlled) : spreadX10
' Spread (max - min) of one motor-channel's folded zero means; 0 when nothing was folded (max < min).
'
' @param arrIdx - (sideSlot * ZXS_CHANNELS) + ZXS_CH_*
' @param bControlled - TRUE for the PH_XSTART spread, FALSE for every lifetime's
' @returns spreadX10 - spread x10, mV

    spreadX10 := 0
    if bControlled
        if zxsMax[arrIdx] >= zxsMin[arrIdx]
            spreadX10 := zxsMax[arrIdx] - zxsMin[arrIdx]
    else
        if zxsAllMax[arrIdx] >= zxsAllMin[arrIdx]
            spreadX10 := zxsAllMax[arrIdx] - zxsAllMin[arrIdx]

PRI bWaitReady(side) : bReady | startMs
' Wait, bounded, for the just-started driver cog to report ready. Same poll as before task 3537;
' it now returns the readiness its own bound test last saw, so the caller need not re-read it.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bReady - TRUE when the driver reported ready within READY_TIMEOUT_MS
'
' @local startMs - getms() when the wait began

    bReady := FALSE
    startMs := getms()
    repeat
        bReady := isSideReady(side)
        if bReady or ((getms() - startMs) >= READY_TIMEOUT_MS)
            quit
        beat(CP_LOOP_WAITREADY)
        waitms(SAMPLE_MS)

PRI measureZero(side, phaseTag) : zeroOutX10, bZeroOutValid | sampleIdx, senseMv, senseSum, sampleCnt, minMv, maxMv, meanX10, ...
    slotIdx, bValid, bInBand, bHealthOk, meanAbsX10, spreadMv, senseUmv, senseVmv, senseWmv, ...
    senseUsum, senseVsum, senseWsum, senseUmean, senseVmean, senseWmean
' Read the current-sense zero with the cog running and the motor stopped (never a stopped cog:
' PL-21), tagged by phase. Only PH_ZERO_INIT -- the motor-block's own check -- sets the zero
' health verdict and the zero BS-PAIR2 reports; every other call only logs its reading, so a
' point's net current is computed at evaluation from the BS-ZERO record before it. CHANGE 2
' (scan v3): measurePoint() calls this at the start of every point, tagged with that point's own
' phase (PH_SELF, PH_REF_START, PH_COARSE, PH_FINE, PH_EXTEND, PH_REF_END, PH_CLIFF), so every
' BS-POINT now has a BS-ZERO immediately before it, including right after a driver restart; the
' motor-block's PH_ZERO_INIT and the deliberate cross-start PH_XSTART zeros (task 3537, fmt 8) are
' the only calls not made from inside measurePoint().
' Every zero is read with the drive floated: isp_bldc_motor's init() sets stop_mode to SM_FLOAT,
' this scan never changes it, and the driver's .checkstop disables PWM at zero command in that
' mode. So no bridge current can flow during a zero read. An out-of-band zero is the driver's
' per-start ADC calibration offset: the driver calibrates once, at cog start, from a single
' settling sample, so each channel's zero is re-drawn at every driver start (PL-32, which
' replaces PL-30's board-offset reading). A zero is valid only within its own driver lifetime.
' CHANGE 3 (scan v3.1): bZeroOk is now the health verdict -- replaces the zero band check.
' Passes when samples were taken, reading not frozen (min != max), spread <= ZERO_SPREAD_MAX_MV,
' and |mean| <= ZERO_ABS_MAX_MV. Also accumulates phase-voltage readings (sense_u/v/w_mV) to
' help locate the offset source.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param phaseTag - PH_* of the point this zero precedes, or PH_ZERO_INIT or PH_XSTART
'
' @local sampleIdx - sample counter
' @local senseMv - clamped sample
' @local senseSum - sum of samples
' @local sampleCnt - samples taken
' @local minMv - smallest sample
' @local maxMv - largest sample
' @local meanX10 - mean sense x10
' @local slotIdx - per-side slot
' @local bValid - TRUE when at least one sample was taken
' @local bInBand - TRUE when the mean is inside ZERO_LO_MV..ZERO_HI_MV (informational)
' @local bHealthOk - TRUE when the health checks pass (samples, not frozen, spread, absolute)
' @local meanAbsX10 - absolute value of mean x10
' @local spreadMv - max - min sample spread
' @local senseUmv - phase U voltage sample, mV
' @local senseVmv - phase V voltage sample, mV
' @local senseWmv - phase W voltage sample, mV
' @local senseUsum - sum of phase U voltage samples
' @local senseVsum - sum of phase V voltage samples
' @local senseWsum - sum of phase W voltage samples
' @local senseUmean - mean phase U voltage x10, mV
' @local senseVmean - mean phase V voltage x10, mV
' @local senseWmean - mean phase W voltage x10, mV
' @returns zeroOutX10 - this call's own current-sense mean x10, mV (scan v4 CHANGE 1: every
'   caller, not just PH_ZERO_INIT, needs its own reading back, so measurePoint() can carry it
'   beside the point it precedes -- see legZeroX10/legNetX10)
' @returns bZeroOutValid - TRUE when at least one sample was taken this call (same as bValid);
'   BS-POINT3's zero_mV_x10 prints NA when this is FALSE

    beginSampling(0)
    senseSum := 0
    senseUsum := 0
    senseVsum := 0
    senseWsum := 0
    sampleCnt := 0
    minMv := POSX
    maxMv := NEGX
    repeat sampleIdx from 1 to ZERO_SAMPLES
        beat(CP_LOOP_ZERO)
        waitms(SAMPLE_MS)
        pollSample(side)
        if bSampNoCog or (abortReason <> AR_NONE)
            quit
        senseMv := clampSense(sampSense)
        senseSum += senseMv
        sampleCnt += 1
        minMv := minMv <# senseMv
        maxMv := maxMv #> senseMv
        ' Also accumulate phase voltages for offset source detection (PL-30)
        senseUmv, senseVmv, senseWmv := sidePhaseVoltages(side)
        senseUsum += senseUmv
        senseVsum += senseVmv
        senseWsum += senseWmv
    flushCharge()
    bValid := (sampleCnt > 0)
    meanX10 := 0
    senseUmean := 0
    senseVmean := 0
    senseWmean := 0
    if bValid
        meanX10 := (senseSum * X10) / sampleCnt
        senseUmean := (senseUsum * X10) / sampleCnt
        senseVmean := (senseVsum * X10) / sampleCnt
        senseWmean := (senseWsum * X10) / sampleCnt
    slotIdx := sideSlot(side)
    ' Task 3537 R8 (phase 2b2): fold this zero into the cross-lifetime spreads when it is the FIRST
    ' zero of a ready start's lifetime (bSfLifetimeFresh, read here BEFORE the R12 block below clears
    ' it) and took all ZERO_SAMPLES -- a zero cut short by a run abort or a lost cog is not a full
    ' reading. PH_XSTART zeros also feed R8-SCAN-ZXS; every such zero feeds BS-ZXSALL.
    if bSfLifetimeFresh[slotIdx] and (sampleCnt == ZERO_SAMPLES)
        foldZeroSpread(slotIdx, (phaseTag == PH_XSTART), meanX10, senseUmean, senseVmean, senseWmean)
    ' Task 3537 R12-SCAN-ALIVE: the FIRST zero of a ready start's driver lifetime judges it. A zero
    ' with samples is alive unless frozen (min = max); a zero that lost its cog is not alive; a zero
    ' that took no sample for any other reason (a run abort) is not a measurement and leaves the
    ' lifetime to be judged by its next zero. bSampNoCog was reset by beginSampling() above.
    if bSfLifetimeFresh[slotIdx]
        if bValid
            sfAliveJudged[slotIdx] += 1
            if minMv == maxMv
                sfNotAlive[slotIdx] += 1
            bSfLifetimeFresh[slotIdx] := FALSE
        elseif bSampNoCog
            sfAliveJudged[slotIdx] += 1
            sfNotAlive[slotIdx] += 1
            bSfLifetimeFresh[slotIdx] := FALSE
    ' in_band: this reading against the nominal zero band -- informational, never judged
    bInBand := bValid and (meanX10 >= ZERO_LO_MV * X10) and (meanX10 <= ZERO_HI_MV * X10)
    bHealthOk := FALSE                                      ' fmt 7: a verdict only for PH_ZERO_INIT (PL-34)
    if phaseTag == PH_ZERO_INIT
        ' Health check: samples taken, not frozen, spread ok, absolute value ok
        if bValid
            spreadMv := maxMv - minMv
            meanAbsX10 := abs(meanX10)
            bHealthOk := (minMv <> maxMv) and (spreadMv <= ZERO_SPREAD_MAX_MV) and (meanAbsX10 <= ZERO_ABS_MAX_MV * X10)
        bZeroOk[slotIdx] := bHealthOk
        zeroMeanX10[slotIdx] := meanX10
    emitZero(side, phaseTag, sampleCnt, meanX10, minMv, maxMv, (minMv == maxMv), bInBand, bValid, bHealthOk, ...
        senseUmean, senseVmean, senseWmean)
    zeroOutX10 := meanX10
    bZeroOutValid := bValid

PRI bRunSelfCheck(side) : bPassed | orderPos, signIdx, loMv, hiMv, posMeanX10, negMeanX10, bPosIOk, ...
    bNegIOk, bRateOk, bIntegOk, bFaultOk, bThisFaultOk, bThisIOk, bThisRateOk, bThisIntegOk, ...
    ratioX1000, bRatioOk, bStartOk, bZeroPass, missCode, zeroBase, posNetMeanX10, negNetMeanX10, ...
    netLoMv, netHiMv, netThisIOk, nSelfPts, bAnyIMiss, bAnyRateMiss, checkSlot
' Self-check at 43/317: +1/4 then -1/4 speed, against the net-of-zero bands (CHANGE 3). A miss ends
' the run. Net means are raw means minus the ZERO_INIT reading (the motor-block's initial zero).
' Task 3537: records the R5-SCAN-SELF and R12-SCAN-RATE facts for this motor. Each result is a
' measurement only when both points were measured, or when a measured point already missed (a
' definite FALSE); a point skipped by a run abort never turns an unmeasured result into a FAIL.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bPassed - TRUE when every check passed
'
' @local orderPos - 0 for the positive point, 1 for the negative point
' @local signIdx - SIGN_* of the point
' @local loMv - raw band low for this sign
' @local hiMv - raw band high for this sign
' @local posMeanX10 - +1/4 raw mean sense x10
' @local negMeanX10 - -1/4 raw mean sense x10
' @local bPosIOk - +1/4 net current in band
' @local bNegIOk - -1/4 net current in band
' @local bRateOk - both rates in band
' @local bIntegOk - both points free of hall integrity events
' @local bFaultOk - both points completed without fault
' @local bThisFaultOk - this point completed without fault
' @local bThisIOk - this point's net current in band
' @local bThisRateOk - this point's rate in band
' @local bThisIntegOk - this point free of hall integrity events
' @local ratioX1000 - negative/positive net mean ratio x1000
' @local bRatioOk - ratio in band
' @local bStartOk - the start checks passed
' @local bZeroPass - the zero reading was healthy
' @local missCode - MISS_* first miss
' @local zeroBase - ZERO_INIT reading x10, the net reference
' @local posNetMeanX10 - +1/4 net mean sense x10
' @local negNetMeanX10 - -1/4 net mean sense x10
' @local netLoMv - net band low for this sign
' @local netHiMv - net band high for this sign
' @local netThisIOk - this point's net mean x10, mV (raw mean minus zeroBase)
' @local nSelfPts - self-check points measured (task 3537)
' @local bAnyIMiss - TRUE when a measured point's net current was out of band (task 3537)
' @local bAnyRateMiss - TRUE when a measured point's rate was out of band (task 3537)
' @local checkSlot - sideSlot(side), the sign-off accumulator index (task 3537)

    nSelfPts := 0
    bAnyIMiss := FALSE
    bAnyRateMiss := FALSE
    posMeanX10 := 0
    negMeanX10 := 0
    posNetMeanX10 := 0
    negNetMeanX10 := 0
    bPosIOk := FALSE
    bNegIOk := FALSE
    bRateOk := TRUE
    bIntegOk := TRUE
    bFaultOk := TRUE
    zeroBase := zeroMeanX10[sideSlot(side)]
    repeat orderPos from 0 to SIGN_SLOTS - 1
        signIdx := (orderPos == 0) ? SIGN_POS : SIGN_NEG
        if abortReason <> AR_NONE
            bFaultOk := FALSE
            quit
        loMv := (signIdx == SIGN_POS) ? POS_QTR_LO_MV : NEG_QTR_LO_MV
        hiMv := (signIdx == SIGN_POS) ? POS_QTR_HI_MV : NEG_QTR_HI_MV
        netLoMv := (signIdx == SIGN_POS) ? POS_QTR_NET_LO_MV : NEG_QTR_NET_LO_MV
        netHiMv := (signIdx == SIGN_POS) ? POS_QTR_NET_HI_MV : NEG_QTR_NET_HI_MV
        measurePoint(side, SPEED_QTR, signIdx, PH_SELF, defaultSwept(signIdx), WIN_TICKS_SELF, ...
            (hiMv * POINT_ABORT_X100) / X100)
        bThisFaultOk := (ptResult == PR_OK)
        ' Check net current: raw mean minus the ZERO_INIT reference
        netThisIOk := ptMeanX10 - zeroBase
        bThisIOk := bThisFaultOk and (netThisIOk >= netLoMv * X10) and (netThisIOk <= netHiMv * X10)
        bThisRateOk := bThisFaultOk and bPtRateOk
        bThisIntegOk := bPtIntegValid and (ptMissedD == 0) and (ptIllegalD == 0)
        nSelfPts += 1                                       ' task 3537: this point was measured
        if bThisIOk == FALSE
            bAnyIMiss := TRUE
        if bThisRateOk == FALSE
            bAnyRateMiss := TRUE
        emitCheck(side, signedIncre(SPEED_QTR, signIdx), loMv, hiMv, bThisIOk, bThisRateOk, ...
            bThisIntegOk, bThisFaultOk, netLoMv, netHiMv, netThisIOk)
        if signIdx == SIGN_POS
            posMeanX10 := ptMeanX10
            posNetMeanX10 := netThisIOk
            bPosIOk := bThisIOk
        else
            negMeanX10 := ptMeanX10
            negNetMeanX10 := netThisIOk
            bNegIOk := bThisIOk
        bRateOk := bRateOk and bThisRateOk
        bIntegOk := bIntegOk and bThisIntegOk
        bFaultOk := bFaultOk and bThisFaultOk
        selfMeanX10[selfSlot(side, signIdx)] := bThisIOk ? ptMeanX10 : 0

    ' Ratio check uses net means
    ratioX1000 := 0
    if (posNetMeanX10 > 0) and bPosIOk and bNegIOk
        ratioX1000 := (negNetMeanX10 * X1000) / posNetMeanX10
    bRatioOk := (ratioX1000 >= RATIO_LO_X1000) and (ratioX1000 <= RATIO_HI_X1000)
    bStartOk := bLastStartOk
    bZeroPass := bZeroOk[sideSlot(side)]
    missCode := MISS_NONE
    if bStartOk == FALSE
        missCode := MISS_START
    elseif bZeroPass == FALSE
        missCode := MISS_ZERO
    elseif bPosIOk == FALSE
        missCode := MISS_I_POS
    elseif bNegIOk == FALSE
        missCode := MISS_I_NEG
    elseif bRatioOk == FALSE
        missCode := MISS_RATIO
    elseif bRateOk == FALSE
        missCode := MISS_RATE
    elseif bIntegOk == FALSE
        missCode := MISS_INTEG
    elseif bFaultOk == FALSE
        missCode := MISS_FAULT
    bPassed := (missCode == MISS_NONE)
    ' task 3537 sign-off facts: the same bPosIOk/bNegIOk/bRateOk BS-CHECKSUM prints below
    checkSlot := sideSlot(side)
    bSfSelfIRan[checkSlot] := (nSelfPts == SIGN_SLOTS) or bAnyIMiss
    bSfSelfIOk[checkSlot] := bPosIOk and bNegIOk
    bSfSelfRateRan[checkSlot] := (nSelfPts == SIGN_SLOTS) or bAnyRateMiss
    bSfSelfRateOk[checkSlot] := bRateOk and (bAnyRateMiss == FALSE)
    emitChecksum(side, bStartOk, bZeroPass, bPosIOk, bNegIOk, ratioX1000, bRatioOk, bRateOk, ...
        bIntegOk, bFaultOk, bPassed, missCode)
    if bPassed == FALSE
        setRunAbort(AR_SELF_CHECK_MISS, missCode)

PRI measurePoint(side, speedIdx, signIdx, ptPhase, sweptDeg, winTicks, limitMv) : ptRes | motorIncre, ...
    missedBefore, illegalBefore, missedAfter, illegalAfter, cmdMs, bAtSpeed, bWinDone, bSettleOk, ...
    zeroX10, zeroValid, ptSlot, rstSlot, rstStartMs, bRstAloneNow
' Measure one point: re-measure the zero tagged with this point's own phase (CHANGE 2, scan v3 --
' PL-31's drift finding was a sense-zero shift, so every point needs its own BS-ZERO, not just
' the references), set and read back offsets, command, wait AT_SPEED, settle, take the
' tick-gated window, command zero, wait stopped, emit BS-POINT/BS-POINT2/BS-POINT3, then recover.
' Task 3537 phase 2b3: at a motor's first eligible fault, testResetFault() alone runs before the zero
' command (R10-SCAN-RSTALONE), and BS-RSTALONE follows BS-POINT3.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - SPEED_QTR or SPEED_HALF
' @param signIdx - SIGN_NEG or SIGN_POS
' @param ptPhase - PH_* of this point
' @param sweptDeg - signed swept offset, degrees
' @param winTicks - window length in hall ticks
' @param limitMv - per-point relative abort threshold, mV (0 disables it)
' @returns ptRes - PR_* result
'
' @local motorIncre - signed increment commanded
' @local missedBefore - missed transitions before the point
' @local illegalBefore - illegal codes before the point
' @local missedAfter - missed transitions after the point
' @local illegalAfter - illegal codes after the point
' @local cmdMs - getms() at the command
' @local bAtSpeed - TRUE once DCS_AT_SPEED was seen
' @local bWinDone - TRUE when the window reached winTicks
' @local bSettleOk - TRUE when the settle rate was in band
' @local zeroX10 - scan v4 CHANGE 1: this point's own zero, captured before clearPointRecord()
'   resets ptZeroX10/ptNetX10 to their not-measured state
' @local zeroValid - TRUE when that zero call took at least one sample
' @local ptSlot - sideSlot(side), the sign-off accumulator index (task 3537)
' @local rstSlot - sideSlot(side), for the R10-SCAN-RSTALONE facts (task 3537 phase 2b3)
' @local rstStartMs - getms() immediately before the testResetFault()-alone attempt
' @local bRstAloneNow - TRUE when this point took its motor's testResetFault()-alone attempt

    pointSeq += 1
    zeroX10, zeroValid := measureZero(side, ptPhase)
    clearPointRecord()
    ptZeroX10 := zeroX10
    bPtZeroValid := zeroValid
    motorIncre := signedIncre(speedIdx, signIdx)
    applyOffsets(side, signIdx, sweptDeg)
    missedBefore, illegalBefore := sideIntegrity(side)
    beginSampling(limitMv)
    bAtSpeed := FALSE
    bWinDone := FALSE
    bRstAloneNow := FALSE
    if abortReason == AR_NONE
        bPtCommanded := TRUE
        commandMotor(side, motorIncre)
        openDriveSpan(side)                                 ' task 3595: the following observables start HERE, not at AT_SPEED
        cmdMs := getms()
        repeat
            beat(CP_LOOP_STEADY)
            waitms(SAMPLE_MS)
            pollSample(side)
            if bPointInterrupted()
                quit
            if sampState == wheelL.DCS_AT_SPEED
                bAtSpeed := TRUE
                quit
            if (getms() - cmdMs) >= STEADY_TIMEOUT_MS
                quit
        ptSteadyMs := getms() - cmdMs
        if bAtSpeed
            bSettleOk := bSettlePoint(side, speedIdx)
            if bPointInterrupted() == FALSE
                bPtWinRan := TRUE
                bWinDone := bWindowPoint(side, speedIdx, winTicks)
                bPtRateOk := bSettleOk and bRateInBand(speedIdx, ptRateX10)
        ' task 3595: close the span BEFORE anything below can command zero or reset the driver, so the
        '  rate it reports is the rate under the DRIVE command and nothing else. Every exit path from
        '  the block above reaches here -- AT_SPEED or not, faulted or not -- which is the point.
        closeDriveSpan(side, speedIdx)
        if bSideCogRunning(side)
            ' R10-SCAN-RSTALONE (task 3537 phase 2b3, design sec J.1 ruled b): at this motor's FIRST
            ' eligible fault, testResetFault() ALONE, BEFORE the zero command below -- that zero command
            ' is exactly what hides the PL-28 defect. Eligible: a fault was seen, no per-point current
            ' abort stopped the wheel, the run has not aborted, the hub fault flag is still set, and
            ' this motor has not had its attempt; only an eligible fault consumes it. The wait sits in
            ' sideResetFault()'s CP_LIB_RESETFAULT bracket, <= 2_030 ms, inside WD_STALL_MS (sec F.4).
            ' Safe with the command still non-zero: the driver's fault branch runs .driveoff before it
            ' marks DCS_FAULTED. The zero command, bWaitStopped() and bRecoverFromFault() run unchanged.
            rstSlot := sideSlot(side)
            if bSampFaultSeen and (bSampPointAbort == FALSE) and (abortReason == AR_NONE) and (bSfRstAloneDone[rstSlot] == FALSE)
                if isSideFault(side)
                    bSfRstAloneDone[rstSlot] := TRUE
                    bRstAloneNow := TRUE
                    rstStartMs := getms()
                    sideResetFault(side)
                    rstAloneMs[rstSlot] := getms() - rstStartMs
                    bRstAloneStopped[rstSlot] := isSideStopped(side)
                    bRstAloneFault[rstSlot] := isSideFault(side)
                    bRstAloneCleared[rstSlot] := bRstAloneStopped[rstSlot] and (bRstAloneFault[rstSlot] == FALSE)
                    rstAloneIncre[rstSlot] := motorIncre
                    rstAloneSwept[rstSlot] := sweptDeg
            commandMotor(side, 0)
            bWaitStopped(side)

    if bSampPointAbort
        ptRes := PR_ABORT_I
    elseif bSampFaultSeen
        ptRes := PR_FAULT
    elseif bSampNoCog
        ptRes := PR_NO_COG
    elseif bAtSpeed == FALSE
        ptRes := PR_STEADY_TIMEOUT
    elseif bWinDone == FALSE
        ptRes := PR_WINDOW_TIMEOUT
    else
        ptRes := PR_OK
    ptResult := ptRes

    if bSideCogRunning(side) and (bSampPointAbort == FALSE)
        missedAfter, illegalAfter := sideIntegrity(side)
        ptMissedD := missedAfter - missedBefore
        ptIllegalD := illegalAfter - illegalBefore
        bPtIntegValid := TRUE
        ptSlot := sideSlot(side)                            ' task 3537 R3-SCAN-INTEG: every integrity-valid point
        addIntegritySum(ptSlot, ptMissedD, ptIllegalD)
        sfIntegN[ptSlot] += 1
    ptChargeMvS := flushCharge()
    ptNetX10 := ptMeanX10 - ptZeroX10                       ' scan v4 CHANGE 1: net of this point's own zero
    emitPoint(side, speedIdx, motorIncre, ptPhase, sweptDeg)
    emitPoint2(side, motorIncre)
    emitPoint3(side)
    if bRstAloneNow
        emitRstAlone(side)                                  ' task 3537 R10: after the point records, outside the timed part

    if ptRes == PR_ABORT_I
        runAbortsI += 1
        emitAbort(SCOPE_POINT, AR_ABORT_I, side, motorIncre, sampSense)
        if abortReason == AR_NONE
            bRestartSide(side)
    elseif (ptRes <> PR_OK) and (abortReason == AR_NONE)
        runFaults += 1
        bRecoverFromFault(side, motorIncre, sweptDeg)
    if abortReason == AR_NONE
        restLoop()
    runGuard()

PRI restLoop() | restStartMs
' Rest REST_MS, stopped, beat-polled every SAMPLE_MS -- never one blind waitms(REST_MS): scan run 5's
' evaluation named that a candidate long gap between beats (SCAN-RUN-5-EVALUATION.md section 7).
' Factored out of measurePoint() unchanged (task 3537 phase 2b2) so the cross-start zeros share it.
'
' @local restStartMs - getms() at the start of the rest

    restStartMs := getms()
    repeat
        beat(CP_LOOP_REST)
        waitms(SAMPLE_MS)
        if (getms() - restStartMs) >= REST_MS
            quit

PRI clearPointRecord()
' Reset every field of the point record to its not-measured state.

    ptResult := PR_NO_COG
    bPtCommanded := FALSE
    ptSteadyMs := 0
    bPtWinRan := FALSE
    ptTicks := 0
    ptWinMs := 0
    ptRateX10 := 0
    bPtRateOk := FALSE
    ptSamples := 0
    ptMeanX10 := 0
    ptSeX10 := 0
    bPtSeValid := FALSE
    ptHalfAX10 := 0
    ptHalfBX10 := 0
    bPtHalvesValid := FALSE
    bPtUnsettled := FALSE
    ptMinMv := 0
    ptMaxMv := 0
    ptDutyMean := 0
    ptErrMean := 0
    ptMissedD := 0
    ptIllegalD := 0
    bPtIntegValid := FALSE
    ptChargeMvS := 0
    ptZeroX10 := 0
    bPtZeroValid := FALSE
    ptNetX10 := 0
    bPtSpanValid := FALSE
    ptSpanRateX10 := 0
    ptSpanDutyMean := 0
    ptSpanDutyMax := 0
    ptFollowPct := 0

PRI bSettlePoint(side, speedIdx) : bSettleOk | startMs, startTicks, spanMs, spanTicks, settleRateX10
' Hold SETTLE_MS after AT_SPEED, polling the abort checks, and test the settle rate.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - SPEED_QTR or SPEED_HALF
' @returns bSettleOk - TRUE when the settle rate was in band
'
' @local startMs - getms() at settle start
' @local startTicks - hall ticks at settle start
' @local spanMs - settle duration
' @local spanTicks - ticks during the settle
' @local settleRateX10 - ticks per second x10 during the settle

    startMs := getms()
    startTicks := sideTicks(side)
    repeat
        beat(CP_LOOP_SETTLE)
        waitms(SAMPLE_MS)
        pollSample(side)
        if bPointInterrupted()
            quit
        if (getms() - startMs) >= SETTLE_MS
            quit
    spanMs := getms() - startMs
    spanTicks := abs(sideTicks(side) - startTicks)
    settleRateX10 := 0
    if spanMs > 0
        settleRateX10 := (spanTicks * RATE_X10_SCALE) / spanMs
    bSettleOk := bRateInBand(speedIdx, settleRateX10)

PRI bWindowPoint(side, speedIdx, winTicks) : bWinDone | startMs, startTicks, ticksNow, senseMv, senseSum, ...
    sampleCnt, minMv, maxMv, dutySum, errSum, halfTicks, halfASum, halfACnt, halfBSum, halfBCnt, ...
    batchSum, batchCnt, nBatches, timeoutMs, expectedRate, thresholdX10
' Sample every SAMPLE_MS until winTicks hall ticks have passed, then fill the point record.
' No debug() inside this loop.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - SPEED_QTR or SPEED_HALF
' @param winTicks - window length in hall ticks
' @returns bWinDone - TRUE when winTicks was reached
'
' @local startMs - getms() at window start
' @local startTicks - hall ticks at window start
' @local ticksNow - ticks since window start
' @local senseMv - clamped sample
' @local senseSum - sum of samples
' @local sampleCnt - samples taken
' @local minMv - smallest sample
' @local maxMv - largest sample
' @local dutySum - sum of duty samples
' @local errSum - sum of err samples
' @local halfTicks - tick position of the half split
' @local halfASum - first-half sum
' @local halfACnt - first-half samples
' @local halfBSum - second-half sum
' @local halfBCnt - second-half samples
' @local batchSum - current batch sum
' @local batchCnt - current batch samples
' @local nBatches - completed batches
' @local timeoutMs - window time bound
' @local expectedRate - expected ticks per second
' @local thresholdX10 - unsettled threshold x10

    bWinDone := FALSE
    expectedRate := expectedRateX10(speedIdx) / X10         ' task 3595: one place owns each rung's expected rate
    timeoutMs := ((winTicks * MS_PER_SEC * 2) / expectedRate) + WINDOW_TIMEOUT_MARGIN_MS
    halfTicks := winTicks / 2
    senseSum := 0
    sampleCnt := 0
    minMv := POSX
    maxMv := NEGX
    dutySum := 0
    errSum := 0
    halfASum := 0
    halfACnt := 0
    halfBSum := 0
    halfBCnt := 0
    batchSum := 0
    batchCnt := 0
    nBatches := 0
    ticksNow := 0
    startMs := getms()
    startTicks := sideTicks(side)
    repeat
        beat(CP_LOOP_WINDOW)
        waitms(SAMPLE_MS)
        pollSample(side)
        if bPointInterrupted()
            quit
        ticksNow := abs(sideTicks(side) - startTicks)
        senseMv := clampSense(sampSense)
        senseSum += senseMv
        sampleCnt += 1
        minMv := minMv <# senseMv
        maxMv := maxMv #> senseMv
        dutySum += sampDuty
        errSum += sampErr
        if ticksNow < halfTicks
            halfASum += senseMv
            halfACnt += 1
        else
            halfBSum += senseMv
            halfBCnt += 1
        batchSum += senseMv
        batchCnt += 1
        if (ticksNow >= (nBatches + 1) * BATCH_TICKS) and (nBatches < MAX_BATCHES)
            batchMeanF[nBatches] := float(batchSum) /. float(batchCnt)
            nBatches += 1
            batchSum := 0
            batchCnt := 0
        if ticksNow >= winTicks
            bWinDone := TRUE
            quit
        if sampleCnt >= SAMPLE_CAP
            quit
        if (getms() - startMs) >= timeoutMs
            quit

    ptWinMs := getms() - startMs
    ptTicks := ticksNow
    ptSamples := sampleCnt
    if ptWinMs > 0
        ptRateX10 := (ptTicks * RATE_X10_SCALE) / ptWinMs
    if sampleCnt > 0
        ptMeanX10 := (senseSum * X10) / sampleCnt
        ptMinMv := minMv
        ptMaxMv := maxMv
        ptDutyMean := dutySum / sampleCnt
        ptErrMean := errSum / sampleCnt
    ptSeX10, bPtSeValid := batchStandardError(nBatches)
    if (halfACnt > 0) and (halfBCnt > 0)
        ptHalfAX10 := (halfASum * X10) / halfACnt
        ptHalfBX10 := (halfBSum * X10) / halfBCnt
        bPtHalvesValid := TRUE
        thresholdX10 := (ptMeanX10 * UNSETTLED_PCT) / X100
        if bPtSeValid
            thresholdX10 := thresholdX10 #> (2 * ptSeX10)
        bPtUnsettled := (abs(ptHalfAX10 - ptHalfBX10) > thresholdX10)

PRI batchStandardError(nBatches) : seX10, bSeValid | batchIdx, meanF, devF, sumSqF, varF, seF
' Standard error of the window mean from its batch means, in float.
'
' @param nBatches - completed batch means in batchMeanF[]
' @returns seX10 - standard error x10, mV
' @returns bSeValid - TRUE when at least MIN_BATCHES_FOR_SE batches existed and the root is a number
'
' @local batchIdx - batch index
' @local meanF - mean of batch means
' @local devF - one batch's deviation
' @local sumSqF - sum of squared deviations
' @local varF - variance of the mean
' @local seF - standard error

    seX10 := 0
    bSeValid := FALSE
    if nBatches >= MIN_BATCHES_FOR_SE
        meanF := 0.0
        repeat batchIdx from 0 to nBatches - 1
            meanF := meanF +. batchMeanF[batchIdx]
        meanF := meanF /. float(nBatches)
        sumSqF := 0.0
        repeat batchIdx from 0 to nBatches - 1
            devF := batchMeanF[batchIdx] -. meanF
            sumSqF := sumSqF +. (devF *. devF)
        varF := sumSqF /. (float(nBatches - 1) *. float(nBatches))
        seF := fsqrt(varF)
        if nan(seF) == FALSE
            seX10 := floatToBoundedInt(seF *. 10.0, LIM_SMALL)
            bSeValid := TRUE

PRI beginSampling(limitMv)
' Start a sampling span: bank earlier charge and reset the abort counters.
'
' @param limitMv - per-point relative abort threshold, mV (0 disables it)

    flushCharge()
    sampAbsCount := 0
    sampOverCount := 0
    sampLimitMv := limitMv
    bSampPointAbort := FALSE
    bSampFaultSeen := FALSE
    bSampNoCog := FALSE
    sampPrevMs := getms()
    bSpanOpen := FALSE                                      ' task 3595: openDriveSpan() opens it at the command
    spanDriveMs := 0
    spanDriveTicks := 0
    spanDutySum := 0
    spanDutyMax := 0
    spanSamples := 0

PRI openDriveSpan(side)
' Open the drive span at the moment the drive command is given (task 3595).
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    spanStartMs := getms()
    spanStartTicks := sideTicks(side)
    bSpanOpen := TRUE

PRI closeDriveSpan(side, speedIdx)
' Close the drive span before the zero command and reduce it to this point's following readings
' (task 3595). Called on EVERY commanded point, whatever its result -- a point that faulted during
' spin-up still says how fast it was turning and how much duty the servo was demanding to get there.
'
' ptFollowPct IS THE UNBOUNDED OBSERVABLE THE STOP CONDITION NEEDS. err cannot serve: the lag
' limiter holds it near LAG_HOLD and its stored field saturates at +/-127, so a drive falling
' further behind reports the same number as one just barely behind. Rate has no such ceiling --
' a motor at half the commanded rate reads 50, one that stalled reads 0, one driven backwards
' reads negative -- so "is the drive following?" is answered by a number that keeps moving.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - SPEED_QTR or SPEED_HALF, naming the commanded rate this is judged against

    if bSpanOpen
        spanDriveMs := getms() - spanStartMs
        spanDriveTicks := abs(sideTicks(side) - spanStartTicks)
        bSpanOpen := FALSE
    bPtSpanValid := (spanDriveMs >= SPAN_MIN_MS) and (spanSamples > 0)
    if bPtSpanValid
        ptSpanRateX10 := (spanDriveTicks * RATE_X10_SCALE) / spanDriveMs
        ptSpanDutyMean := spanDutySum / spanSamples
        ptSpanDutyMax := spanDutyMax
        ptFollowPct := (ptSpanRateX10 * X100) / (expectedRateX10(speedIdx))

PRI expectedRateX10(speedIdx) : rateX10
' The commanded tick rate for a speed rung, x10 -- the denominator ptFollowPct is measured against.
'
' @param speedIdx - SPEED_LOW, SPEED_QTR or SPEED_HALF
' @returns rateX10 - expected ticks per second x10

    case speedIdx
        SPEED_HALF:
            rateX10 := RATE_HALF_EXPECTED * X10
        SPEED_LOW:
            rateX10 := RATE_LOW_EXPECTED * X10
        other:
            rateX10 := RATE_QTR_EXPECTED * X10

PRI flushCharge() : chargeMvS
' Move whole mV-seconds of integrated sense into the run total.
'
' @returns chargeMvS - mV-seconds moved

    chargeMvS := sampChargeMvMs / MS_PER_SEC
    runChargeMvS += chargeMvS
    sampChargeMvMs -= chargeMvS * MS_PER_SEC

PRI pollSample(side) | nowMs, stepMs, senseMv, bCogUp, bFaultNow
' Take one telemetry sample: integrate charge, run the absolute and per-point current aborts
' (both stop the wheel HERE, inside the loop), and latch a fault.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
'
' @local nowMs - getms() now
' @local stepMs - ms since the previous sample, capped
' @local senseMv - clamped sample
' @local bCogUp - TRUE when the driver cog is running
' @local bFaultNow - this sample's fault flag

    sampDuty, sampErr, sampSense, sampState, bFaultNow, bCogUp := sideTelemetry(side)
    nowMs := getms()
    stepMs := (nowMs - sampPrevMs) <# SAMPLE_DT_MAX_MS
    sampPrevMs := nowMs
    if bSpanOpen and bCogUp                                 ' task 3595: the following observables, on EVERY path
        spanDutySum += sampDuty
        spanDutyMax #>= sampDuty
        spanSamples += 1
    if bCogUp == FALSE
        bSampNoCog := TRUE
    else
        if bFaultNow
            bSampFaultSeen := TRUE
        senseMv := clampSense(sampSense)
        if senseMv > 0
            sampChargeMvMs += senseMv * stepMs
        if sampSense >= ABS_ABORT_MV
            sampAbsCount += 1
        else
            sampAbsCount := 0
        if sampAbsCount >= ABS_ABORT_SAMPLES
            sideStop(side)                                  ' P6: disable the bridge first
            setRunAbort(AR_ABS_CURRENT, sampSense)
        elseif (sampLimitMv > 0) and (sampSense > sampLimitMv)
            sampOverCount += 1
            if (sampOverCount >= POINT_ABORT_SAMPLES) and (bSampPointAbort == FALSE)
                sideStop(side)
                bSampPointAbort := TRUE
        else
            sampOverCount := 0

PRI bPointInterrupted() : bInterrupted
' Report whether the sampling span must end now.
'
' @returns bInterrupted - TRUE on a fault, a point abort, a stopped cog or a run abort

    bInterrupted := bSampFaultSeen or bSampPointAbort or bSampNoCog or (abortReason <> AR_NONE)

PRI bWaitStopped(side) : bStopped | startMs
' Wait, bounded, for the wheel to report STOPPED, polling the abort checks.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bStopped - TRUE when STOPPED was seen
'
' @local startMs - getms() when the wait began

    bStopped := FALSE
    startMs := getms()
    repeat
        beat(CP_LOOP_WAITSTOPPED)
        if bSideCogRunning(side) == FALSE
            quit
        if isSideStopped(side)
            bStopped := TRUE
            quit
        if (getms() - startMs) >= STOP_TIMEOUT_MS
            quit
        waitms(SAMPLE_MS)
        pollSample(side)

PRI bDriveForMs(side, motorIncre, durationMs) : bFaulted | startMs
' Command an increment and hold it for durationMs, polling the abort checks. The caller stops it.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param durationMs - hold time
' @returns bFaulted - TRUE when a fault was seen
'
' @local startMs - getms() at the command

    beginSampling(0)
    commandMotor(side, motorIncre)
    startMs := getms()
    repeat
        beat(CP_LOOP_DRIVEFORMS)
        waitms(SAMPLE_MS)
        pollSample(side)
        if bSampFaultSeen or bSampNoCog or (abortReason <> AR_NONE)
            quit
        if (getms() - startMs) >= durationMs
            quit
    bFaulted := bSampFaultSeen
    flushCharge()

PRI bRecoverFromFault(side, motorIncre, sweptDeg) : bCleared | jogIncre, coolStartMs
' Clear a fault the util_char_motor way, zero command first: ZERO_CMD, RESET, JOG, RESTART.
' A fault that survives all four ends the run (P11). Cools FAULT_COOL_MS afterwards.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - increment of the faulted point
' @param sweptDeg - swept offset of the faulted point
' @returns bCleared - TRUE when the wheel is stopped with no fault
'
' @local jogIncre - jog increment, same sign as the faulted point
' @local coolStartMs - getms() at the start of the post-recovery cooldown

    bCleared := FALSE
    beat(CP_RECOVERY_ZERO)
    if bSideCogRunning(side)
        commandMotor(side, 0)                               ' a CHANGED command: the driver leaves DCS_FAULTED
        bWaitStopped(side)
        bCleared := isSideStopped(side) and (isSideFault(side) == FALSE)
    emitFault(side, motorIncre, sweptDeg, FX_ZERO_CMD, bCleared)
    if (bCleared == FALSE) and bSideCogRunning(side) and (abortReason == AR_NONE)
        beat(CP_RECOVERY_RESET)
        sideResetFault(side)
        bCleared := isSideStopped(side) and (isSideFault(side) == FALSE)
        emitFault(side, motorIncre, sweptDeg, FX_RESET, bCleared)
    if (bCleared == FALSE) and bSideCogRunning(side) and (abortReason == AR_NONE)
        beat(CP_RECOVERY_JOG)
        jogIncre := (motorIncre < 0) ? (0 - JOG_INCRE) : JOG_INCRE
        sideSetOffsets(side, DEF_NEG_DEG, DEF_POS_DEG)
        bDriveForMs(side, jogIncre, JOG_MS)
        if bSideCogRunning(side)
            commandMotor(side, 0)
            bWaitStopped(side)
            sideResetFault(side)
        bCleared := isSideStopped(side) and (isSideFault(side) == FALSE)
        emitFault(side, motorIncre, sweptDeg, FX_JOG, bCleared)
    if (bCleared == FALSE) and (abortReason == AR_NONE)
        beat(CP_RECOVERY_RESTART)
        bCleared := bRestartSide(side)
        emitFault(side, motorIncre, sweptDeg, FX_RESTART, bCleared)
    if (bCleared == FALSE) and (abortReason == AR_NONE)
        setRunAbort(AR_RECOVERY_FAIL, sweptDeg)
    if abortReason == AR_NONE
        ' Beat-polled, not one blind waitms(FAULT_COOL_MS): 5 s was the largest candidate gap
        ' named in scan run 5's evaluation (SCAN-RUN-5-EVALUATION.md section 7); this keeps every
        ' remaining un-beaten gap inside a library call (see WD_STALL_MS's CON comment).
        coolStartMs := getms()
        repeat
            beat(CP_LOOP_COOL)
            waitms(SAMPLE_MS)
            if (getms() - coolStartMs) >= FAULT_COOL_MS
                quit

PRI runLeg(side, speedIdx, signIdx) | slotIdx, walkSlot, defSwept, refWinTicks, refLimitMv, pointLimitMv, ...
    refStartIdx, refEndIdx, centreDeg, legExit, stopUp, stopDown, bBracketed, driftPctX10, bDriftValid
' Run one leg. THE WALKING RUNG (task 3595, an eighth): REF_START, coarse walk both ways, bracket,
' fine, fit (one extension), REF_END. A CONFIRM RUNG (a quarter, a half): REF_START, confirm points
' around the WALKING rung's minimum, fit, REF_END. Which rung walks is asked by bWalkRung(), never by
' naming a speed -- adding the low rung is precisely the change that would otherwise have left every
' `speedIdx == SPEED_QTR` still compiling while quietly meaning the wrong leg.
' CHANGE 1 (scan v3): legLimitUpDeg/legLimitDownDeg bound the sweep window at whichever side's
' last good point precedes a fault edge (refreshLegLimits(), fed by every legMeasure() in this
' leg); runFinePoints()/runExtension() never command an offset past that limit, and bEvaluateBracket()
' accepts a smaller rise (FAULT_RISE_PCT) from a point inside a fault-bounded window.
' CHANGE 2 (scan v3): every legMeasure()/measurePoint() now re-measures the zero for itself
' (tagged with its own phase), so no separate REF_START/REF_END zero call is needed here.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - SPEED_QTR or SPEED_HALF
' @param signIdx - SIGN_NEG or SIGN_POS
'
' @local slotIdx - this leg's result slot
' @local walkSlot - the same motor and sign's WALKING-rung result slot, which every confirm rung centres on
' @local defSwept - default offset in signed swept degrees
' @local refWinTicks - reference window ticks
' @local refLimitMv - REF_START relative abort threshold
' @local pointLimitMv - relative abort threshold for every later point
' @local refStartIdx - leg index of REF_START
' @local refEndIdx - leg index of REF_END
' @local centreDeg - fine/confirm centre, swept degrees
' @local legExit - LX_* exit
' @local stopUp - walk stop of the up side
' @local stopDown - walk stop of the down side
' @local bBracketed - TRUE when the minimum is bracketed: bEvaluateBracket() on the walking rung, and
'   (task 3540 D2) bEvaluateConfirmBracket() on a confirm rung, run for real once runFinePoints() has
'   measured the confirm/cliff-probe points it judges -- no longer marked bracketed by assignment
' @local driftPctX10 - REF_END vs REF_START drift, percent x10, net means (scan v4 CHANGE 2)
' @local bDriftValid - TRUE when both references were valid

    slotIdx := resultSlot(side, signIdx, speedIdx)
    walkSlot := resultSlot(side, signIdx, SPEED_WALK)        ' task 3595: the walking rung's slot, which every confirm rung centres on
    defSwept := defaultSwept(signIdx)
    legReset()
    clearFit()
    legLimitUpDeg := defSwept + HARD_LIMIT_DEG              ' CHANGE 1: unrestricted until a fault tightens it
    legLimitDownDeg := defSwept - HARD_LIMIT_DEG
    legExit := LX_DONE
    refEndIdx := -1
    ' Every refLimitMv goes through pointAbortLimit() too, for the reason it documents: a REF_START
    '  point is measured at the LEGACY offset, which at half speed is itself a high-current place
    '  (MEASURED 952.9 mV, debug_260921-192618.log seq 67), so its guard needs the same ordering.
    refWinTicks := winTicksFor(speedIdx)
    if bWalkRung(speedIdx) or (speedIdx == SPEED_QTR)
        refLimitMv := pointAbortLimit(selfMeanX10[selfSlot(side, signIdx)])
    else
        refLimitMv := pointAbortLimit(selfMeanX10[selfSlot(side, signIdx)] * SPEED_CURRENT_RATIO)

    ' task 3595: a CONFIRM rung centres on the WALKING rung's fit, so it is the walk slot that must
    '  have produced a usable one -- not quarter speed, which is now itself a confirm rung.
    if (bWalkRung(speedIdx) == FALSE) and (resStatus[walkSlot] <> FS_OK) and (resStatus[walkSlot] <> FS_POOR)
        legExit := LX_SKIPPED
    else
        refStartIdx := legMeasure(side, speedIdx, signIdx, PH_REF_START, defSwept, refWinTicks, refLimitMv)
        if isValidIdx(refStartIdx) == FALSE
            legExit := LX_SKIPPED
        else
            ' pointLimitMv stays RAW (legMeanX10, not legNetX10): pollSample()'s abort test
            ' compares sampSense, a raw live sample, against sampLimitMv directly (no zero is
            ' subtracted inside that tight polling loop). A net-derived threshold compared
            ' against a raw live sample would be off by the zero every time -- scan v4 CHANGE 2
            ' moves every JUDGEMENT of an already-measured mean onto net means, but this
            ' threshold feeds a raw-sample comparison, so it must stay in the same, raw, units.
            pointLimitMv := pointAbortLimit(legMeanX10[refStartIdx])
            ' EVERY RUNG WALKS AND FINDS ITS OWN MINIMUM (task 3595 follow-up, 2026-09-22).
            '
            ' A confirm rung used to inherit the walking rung's minimum as its centre. That assumed
            ' the minimum is in the same place at every speed, and the 2026-09-21 shakedown measured
            ' that it is not: the RIGHT motor's lowest MEASURED point sits at swept 15 at quarter
            ' speed and swept 28 at an eighth -- 13 degrees apart, from raw points with nothing
            ' fitted (DOCs/analyses/bench/2026-09-22/SHAKEDOWN-EVALUATION.md sec 4).
            '
            ' What that cost was the whole half-speed rung. Its confirm span was 10..40, centred on
            ' the walk; if the trend holds, its own optimum sits near 6 -- OUTSIDE the span. It only
            ' ever measured the rising side, which is why all four half legs came back POOR and why
            ' no half-speed minimum has ever been demonstrated, in this run or in run 7.
            '
            ' The fix is NOT to shift the centre by the measured trend. Two points do not define a
            ' law, and baking one dataset's slope into the instrument would make it agree with
            ' itself forever. Each rung walks instead, and finds where its own minimum actually is.
            ' That needs no assumption, and it yields the third and fourth points the speed law
            ' needs as a by-product of measuring properly.
            stopUp := walkSide(side, speedIdx, signIdx, 1, defSwept, pointLimitMv)
            stopDown := walkSide(side, speedIdx, signIdx, -1, defSwept, pointLimitMv)
            refreshLegLimits(defSwept)                      ' CHANGE 1: bound the window at the fault edge
            bBracketed := bEvaluateBracket(side, speedIdx, signIdx, stopUp, stopDown)
            centreDeg := defSwept
            if bBracketed
                centreDeg := legDeg[legLowIdx]
            else
                fitStatus := FS_NOT_BRACKETED
            if bBracketed and (abortReason == AR_NONE)
                legExit := runFinePoints(side, speedIdx, signIdx, centreDeg, defSwept, pointLimitMv)
                fitLeg(centreDeg, fitMinPtsFor(speedIdx), speedIdx)
                if (fitStatus == FS_EDGE) and (legExit == LX_DONE) and (abortReason == AR_NONE)
                    legExit := runExtension(side, speedIdx, signIdx, defSwept, pointLimitMv)
                    fitLeg(centreDeg, fitMinPtsFor(speedIdx), speedIdx)
                    bFitExtended := TRUE
                ' task 3540 D2: the real rise-on-both-sides test, over the points fitLeg() ACTUALLY
                '  fits, now that they exist. Applied to every rung since 2026-09-22: the walk's own
                '  verdict above is taken from COARSE points while the fit is built from FINE ones,
                '  and a bracket verdict should judge the data the fit used, not its neighbours.
                bBracketed := bEvaluateConfirmBracket()
            if abortReason == AR_NONE
                refEndIdx := legMeasure(side, speedIdx, signIdx, PH_REF_END, defSwept, refWinTicks, pointLimitMv)
    if (abortReason <> AR_NONE) and (legExit == LX_DONE)
        legExit := LX_RUN_ABORT
    computeLegCliff(defSwept, signIdx)

    ' store results
    resStatus[slotIdx] := fitStatus
    resMinF[slotIdx] := fitMinF
    resSeF[slotIdx] := fitSeF
    bResSeValid[slotIdx] := bFitSeValid
    resIminF[slotIdx] := fitMinMvF
    resRmsF[slotIdx] := fitRmsF
    bResPinned[slotIdx] := bFitPinnedNearLimit()             ' task 3540 D2: read while legLimitUp/DownDeg
                                                             ' still describe THIS leg's window
    bResBracketed[slotIdx] := bBracketed                    ' task 3540 D2: real test, both speeds
    resFloorX10[slotIdx], resFloorDeg[slotIdx], bResFloorValid[slotIdx] := legMeasuredFloor()
    bResIdefValid[slotIdx] := FALSE
    resIdefX10[slotIdx] := 0
    driftPctX10 := 0
    bDriftValid := FALSE
    ' scan v4 CHANGE 2: the default-current reference (i_def) and the REF drift percent/flag are
    ' computed on NET means (legNetX10), not raw. Run 5's LEFT positive leg raised drift_flag TRUE
    ' on raw 89.6 -> 102.8 mV while net was 82.5 -> 82.2 mV: the raw rise was a zero shift between
    ' the two references, not a current change (SCAN-RUN-5-EVALUATION.md section 2).
    if (legCount > 0) and isValidIdx(0) and (legPhase[0] == PH_REF_START)
        resIdefX10[slotIdx] := legNetX10[0]
        bResIdefValid[slotIdx] := TRUE
        if isValidIdx(refEndIdx)
            resIdefX10[slotIdx] := (legNetX10[0] + legNetX10[refEndIdx]) / 2
            if legNetX10[0] > 0
                driftPctX10 := ((legNetX10[refEndIdx] - legNetX10[0]) * X1000) / legNetX10[0]
                bDriftValid := TRUE
    bResDrift[slotIdx] := bDriftValid and (abs(driftPctX10) > DRIFT_FLAG_PCT * X10)
    ' task 3537 R9-SCAN-OWNZERO facts, from this leg's own exit and store -- the store is reused by the
    ' next runLeg()'s legReset(), so they are taken here. "Ran" = legExit <> LX_SKIPPED: a half leg whose
    ' quarter-speed prerequisite failed, or whose REF_START was invalid, exits LX_SKIPPED; a leg never
    ' reached keeps initRunState()'s FALSE. R9-SCAN-HALFLEG's facts are taken in runFinePoints().
    bResLegRan[slotIdx] := (legExit <> LX_SKIPPED)
    storeLegOwnZero(slotIdx)
    emitFit(side, speedIdx, signIdx)
    emitFit2(side, speedIdx, signIdx)
    emitCliff(side, speedIdx, signIdx)
    emitLeg(side, speedIdx, signIdx, legExit, refEndIdx, driftPctX10, bDriftValid, bResDrift[slotIdx])

PRI storeLegOwnZero(slotIdx) | ptIdx, nMissing, nValid
' Count, over the leg store as it stands, the valid points and the valid points without a valid own
' zero, into the result slot (task 3537 R9-SCAN-OWNZERO).
'
' @param slotIdx - this leg's result slot
'
' @local ptIdx - leg index
' @local nMissing - valid points whose own zero took no sample
' @local nValid - valid points

    nMissing := 0
    nValid := 0
    if legCount > 0
        repeat ptIdx from 0 to legCount - 1
            beat(CP_LOOP_OWNZERO)
            if isValidIdx(ptIdx)
                nValid += 1
                if bLegZeroValid[ptIdx] == FALSE
                    nMissing += 1
    resZeroMissing[slotIdx] := nMissing
    resZeroChecked[slotIdx] := nValid

PRI legReset()
' Empty the leg point store.

    legCount := 0
    legLowIdx := -1
    legConsecFaults := 0
    legFaults := 0
    legAbortsI := 0
    legCliffFound := FALSE
    legCliffGoodDeg := 0
    legCliffFaultDeg := 0
    legLimitUpDeg := 0                                      ' set for real by runLeg once defSwept is known
    legLimitDownDeg := 0
    bLegLimitUpFault := FALSE
    bLegLimitDownFault := FALSE
    legBoundUp := BT_NONE                                   ' task 3595: the arc and its two boundary types
    legBoundDown := BT_NONE
    legArcLoDeg := 0
    legArcHiDeg := 0
    bLegArcValid := FALSE

PRI clearFit()
' Reset the fit record to not attempted.

    fitStatus := FS_SKIPPED
    fitN := 0
    fitCentre := 0
    fitSpanLo := 0
    fitSpanHi := 0
    bFitExtended := FALSE
    bFitSolved := FALSE
    fitMinF := 0.0
    fitSeF := 0.0
    bFitSeValid := FALSE
    fitMinMvF := 0.0
    fitRmsF := 0.0
    fitMedSeX10 := 0
    fitCurvF := 0.0

PRI legMeasure(side, speedIdx, signIdx, ptPhase, sweptDeg, winTicks, limitMv) : ptIdx
' Measure one point and store it in the leg.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - SPEED_QTR or SPEED_HALF
' @param signIdx - SIGN_NEG or SIGN_POS
' @param ptPhase - PH_* of this point
' @param sweptDeg - signed swept offset, degrees
' @param winTicks - window length in hall ticks
' @param limitMv - per-point relative abort threshold, mV
' @returns ptIdx - leg index of the stored point, -1 when the store is full

    ptIdx := -1
    if legCount < MAX_LEG_POINTS
        measurePoint(side, speedIdx, signIdx, ptPhase, sweptDeg, winTicks, limitMv)
        ptIdx := legCount
        legDeg[ptIdx] := sweptDeg
        legMeanX10[ptIdx] := ptMeanX10
        legZeroX10[ptIdx] := ptZeroX10                       ' scan v4 CHANGE 1
        legNetX10[ptIdx] := ptNetX10                          ' scan v4 CHANGE 1
        bLegZeroValid[ptIdx] := bPtZeroValid                  ' task 3537 R9: set by measurePoint() above
        legSeX10[ptIdx] := ptSeX10
        bLegSeValid[ptIdx] := bPtSeValid
        legResult[ptIdx] := ptResult
        legPhase[ptIdx] := ptPhase
        bLegRateOk[ptIdx] := bPtRateOk
        bLegSpanValid[ptIdx] := bPtSpanValid                  ' task 3595: the drive span, present on every commanded point
        legFollowPct[ptIdx] := ptFollowPct
        legCount += 1
        if isValidIdx(ptIdx)                                  ' task 3595: the arc is what was reached CLEANLY, nothing else
            if bLegArcValid
                legArcLoDeg <#= sweptDeg
                legArcHiDeg #>= sweptDeg
            else
                legArcLoDeg := sweptDeg
                legArcHiDeg := sweptDeg
                bLegArcValid := TRUE
        if ptResult == PR_OK
            legConsecFaults := 0
        elseif ptResult == PR_ABORT_I
            legAbortsI += 1
        else
            legConsecFaults += 1
            legFaults += 1

PRI isValidIdx(ptIdx) : bValid
' Report whether a leg point is usable data: completed at the right rate.
'
' @param ptIdx - leg index, may be -1
' @returns bValid - TRUE when the point is OK with rate in band

    bValid := FALSE
    if (ptIdx >= 0) and (ptIdx < legCount)
        bValid := (legResult[ptIdx] == PR_OK) and (bLegRateOk[ptIdx] <> FALSE)

PRI isFaultLikeIdx(ptIdx) : bFaultLike
' Report whether a leg point ended in a fault, a timeout or a lost cog.
'
' @param ptIdx - leg index, may be -1
' @returns bFaultLike - TRUE for FAULT, STEADY_TIMEOUT, WINDOW_TIMEOUT, NO_COG or a missing point

    bFaultLike := TRUE
    if (ptIdx >= 0) and (ptIdx < legCount)
        bFaultLike := (legResult[ptIdx] <> PR_OK) and (legResult[ptIdx] <> PR_ABORT_I)

PRI isDroopIdx(ptIdx) : bDrooped
' Task 3595: report whether a leg point DROVE BUT DID NOT FOLLOW -- the motor turned, but slower than
' commanded by more than FOLLOW_DROOP_PCT.
'
' NOTE -- THIS PREDICATE EXISTS BECAUSE A DROOPING POINT FELL INTO A HOLE BETWEEN THE OTHER THREE, and the
' hole is why the sweep could walk past a motor that had already given up:
'   isValidIdx()    = PR_OK and rate in band -> a drooping point is NOT valid, so it is correctly kept
'                     out of the fit and out of the low. That half always worked.
'   isFaultLikeIdx() = result <> PR_OK and <> PR_ABORT_I -> a drooping point that still reached
'                     AT_SPEED and completed its window returns PR_OK, so it is NOT fault-like.
'                     WS_FAULTS could never fire on it.
'   isHighIdxFor()  = requires isValidIdx() -> a drooping point is NOT high either. WS_RISE could
'                     never fire on it.
' So walkSide() saw nothing at all and walked on to the hard limit, burning points and current on a
' motor that was no longer tracking its command. The lag limiter made droop the COMMON failure where
' a fault used to be, and the walk had no name for it.
'
' It is judged on ptFollowPct, which comes from the drive span and therefore exists on EVERY commanded
' point -- including one that never reached AT_SPEED, where the old window-based rate did not.
'
' @param ptIdx - leg index, may be -1
' @returns bDrooped - TRUE when the point drove, its span is valid, and it fell short of following

    bDrooped := FALSE
    if (ptIdx >= 0) and (ptIdx < legCount)
        if bLegSpanValid[ptIdx]
            bDrooped := (legFollowPct[ptIdx] < FOLLOW_DROOP_PCT)

PRI isHighIdx(ptIdx) : bHigh
' Report whether a coarse point is RISE_PCT above the current low (a current abort always is).
'
' @param ptIdx - leg index, may be -1
' @returns bHigh - TRUE when the point rises above the low

    bHigh := isHighIdxFor(ptIdx, RISE_PCT)

PRI isHighIdxFor(ptIdx, risePct) : bHigh
' Report whether a point is risePct above the current low (a current abort always is). CHANGE 1
' (scan v3): lets bEvaluateBracket() use a smaller threshold (FAULT_RISE_PCT) inside a
' fault-bounded window without touching the coarse walk's own RISE_PCT stop test, which still
' calls isHighIdx(). CHANGE 2 (scan v4): the rise test compares net means (legNetX10). Run 5's
' RIGHT positive leg failed to bracket on this exact test: -18deg read raw 91.7 vs a raw low of
' 88.5 (+3.6%, under FAULT_RISE_PCT 4 on a ~75 mV zero) but net 16.3 vs 13.0 (+25%) -- a large
' zero compresses every raw relative rise (SCAN-RUN-5-EVALUATION.md section 4, section 6.2).
'
' @param ptIdx - leg index, may be -1
' @param risePct - rise threshold, percent of the low
' @returns bHigh - TRUE when the point rises above the low by at least risePct

    bHigh := FALSE
    if (legLowIdx >= 0) and (ptIdx >= 0) and (ptIdx < legCount) and (ptIdx <> legLowIdx)
        if legResult[ptIdx] == PR_ABORT_I
            bHigh := TRUE
        elseif isValidIdx(ptIdx)
            bHigh := (legNetX10[ptIdx] * X100) >= (legNetX10[legLowIdx] * (X100 + risePct))

PRI updateLegLow() | ptIdx
' Recompute the lowest valid REF_START/COARSE point. Scan v4 CHANGE 2: compares net means
' (legNetX10), not raw (legMeanX10) -- a zero shift between points otherwise misplaces the low
' point (SCAN-RUN-5-EVALUATION.md section 6).
'
' @local ptIdx - leg index

    legLowIdx := -1
    if legCount > 0
        repeat ptIdx from 0 to legCount - 1
            if ((legPhase[ptIdx] == PH_REF_START) or (legPhase[ptIdx] == PH_COARSE)) and isValidIdx(ptIdx)
                if legLowIdx < 0
                    legLowIdx := ptIdx
                elseif legNetX10[ptIdx] < legNetX10[legLowIdx]
                    legLowIdx := ptIdx

PRI updateLegLowConfirm() | ptIdx
' Task 3540 D2: like updateLegLow(), but over a CONFIRM leg's own admitted phases
' (PH_FINE/PH_CLIFF/PH_EXTEND -- the same set fitLeg() admits on a confirm rung), not
' PH_REF_START/PH_COARSE, which only the WALKING rung measures.
'
' Task 3595 renamed this from updateLegLowHalf(). It was named for half speed when half speed was the
' only confirm rung; there are now two, and a name that promises one rung while serving both is the
' kind of drift a reader trusts and should not.
'
' @local ptIdx - leg index

    legLowIdx := -1
    if legCount > 0
        repeat ptIdx from 0 to legCount - 1
            if ((legPhase[ptIdx] == PH_FINE) or (legPhase[ptIdx] == PH_CLIFF) or (legPhase[ptIdx] == PH_EXTEND)) and isValidIdx(ptIdx)
                if legLowIdx < 0
                    legLowIdx := ptIdx
                elseif legNetX10[ptIdx] < legNetX10[legLowIdx]
                    legLowIdx := ptIdx

PRI bEvaluateConfirmBracket() : bBracketed | ptIdx, bBelowOk, bAboveOk, risePctUp, risePctDown
' Task 3540 D2: the CONFIRM-rung counterpart to bEvaluateBracket() -- the rise-on-both-sides negative
' case, applied for real to the confirm/cliff-probe points fitLeg() itself fits, instead of a confirm
' leg being marked bracketed by assignment. A side whose window is fault-bounded
' (bLegLimitUpFault/Down, kept current by refreshLegLimits() as runFinePoints()/probeConfirmCliff()
' measured) is judged at the relaxed FAULT_RISE_PCT, exactly mirroring bEvaluateBracket()'s own
' test on the walking rung. FAILs (bBracketed FALSE) precisely when the low sits at that fault-bounded
' edge with nothing measured beyond it -- the failure mode scan run 7 could not get past
' (SCAN-RUN-7-EVALUATION.md sec 2 table, sec 5 item 1).
'
' Task 3595 renamed this from bEvaluateHalfBracket(), for the reason updateLegLowConfirm() gives: it
' runs for BOTH confirm rungs now, and a name promising half speed would misdescribe half its work.
'
' It reads the current leg's staging (legNetX10, legLowIdx, bLegLimit*Fault), which names its motor and
' sign, so it takes no parameters (style guide 5.0).
'
' @returns bBracketed - TRUE when a high point exists on both sides of the low
'
' @local ptIdx - leg index
' @local bBelowOk - a high point below the low exists
' @local bAboveOk - a high point above the low exists
' @local risePctUp - rise threshold for the up side: FAULT_RISE_PCT when it is fault-bounded
' @local risePctDown - rise threshold for the down side: FAULT_RISE_PCT when it is fault-bounded

    updateLegLowConfirm()
    bBelowOk := FALSE
    bAboveOk := FALSE
    risePctUp := bLegLimitUpFault ? FAULT_RISE_PCT : RISE_PCT
    risePctDown := bLegLimitDownFault ? FAULT_RISE_PCT : RISE_PCT
    if (legLowIdx >= 0) and (legCount > 0)
        repeat ptIdx from 0 to legCount - 1
            if (legPhase[ptIdx] == PH_FINE) or (legPhase[ptIdx] == PH_CLIFF) or (legPhase[ptIdx] == PH_EXTEND)
                if legDeg[ptIdx] < legDeg[legLowIdx]
                    if isHighIdxFor(ptIdx, risePctDown)
                        bBelowOk := TRUE
                elseif legDeg[ptIdx] > legDeg[legLowIdx]
                    if isHighIdxFor(ptIdx, risePctUp)
                        bAboveOk := TRUE
    bBracketed := bBelowOk and bAboveOk

PRI legMeasuredFloor() : floorX10, floorDeg, bFound | ptIdx
' Task 3540 D3: the leg's own lowest measured NET point (any phase, valid only), the "floor" the
' evaluation documents describe -- e.g. run 7's L NEG floor of 13.05 mV at 13 deg (SCAN-RUN-7-
' EVALUATION.md sec 2), as opposed to the fitted quadratic vertex (resIminF), which can sit below
' every point actually measured. BS-RESULT/BS-RESULT-HALF/BS-PAIR2 judge on this; the fitted value
' moves to an extra field at the end of each of those records.
'
' @returns floorX10 - lowest valid legNetX10 in the leg, 0 when none
' @returns floorDeg - that point's swept offset, 0 when none
' @returns bFound - TRUE when at least one valid point was measured
'
' @local ptIdx - leg index

    floorX10 := 0
    floorDeg := 0
    bFound := FALSE
    if legCount > 0
        repeat ptIdx from 0 to legCount - 1
            if isValidIdx(ptIdx)
                if (bFound == FALSE) or (legNetX10[ptIdx] < floorX10)
                    floorX10 := legNetX10[ptIdx]
                    floorDeg := legDeg[ptIdx]
                    bFound := TRUE

PRI beyondLowCount(walkDir, defSwept) : nBeyond | ptIdx
' Count coarse points on this side beyond the low that are valid or current-aborted.
'
' @param walkDir - +1 up, -1 down
' @param defSwept - default offset, swept degrees
' @returns nBeyond - qualifying point count
'
' @local ptIdx - leg index

    nBeyond := 0
    if (legLowIdx >= 0) and (legCount > 0)
        repeat ptIdx from 0 to legCount - 1
            if legPhase[ptIdx] == PH_COARSE
                if ((walkDir * (legDeg[ptIdx] - defSwept)) > 0) and ((walkDir * (legDeg[ptIdx] - legDeg[legLowIdx])) > 0)
                    if isValidIdx(ptIdx) or (legResult[ptIdx] == PR_ABORT_I)
                        nBeyond += 1

PRI walkSide(side, speedIdx, signIdx, walkDir, defSwept, pointLimitMv) : walkStop | stepIdx, sweptDeg, ptIdx, ...
    sideConsec, nPts, lastSwept, droopConsec
' Walk coarse points out from the default until RISE, FAULTS, HARD_LIMIT or a run abort.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - the rung this walk runs at; every rung walks and locates its own minimum
' @param signIdx - SIGN_NEG or SIGN_POS
' @param walkDir - +1 up, -1 down
' @param defSwept - default offset, swept degrees
' @param pointLimitMv - per-point relative abort threshold, mV
' @returns walkStop - WS_* stop reason
'
' @local stepIdx - coarse step number
' @local sweptDeg - this point's swept offset
' @local ptIdx - leg index of this point
' @local sideConsec - consecutive fault-like points on this side
' @local nPts - points measured on this side
' @local lastSwept - last swept offset measured
' @local droopConsec - task 3595: consecutive points where the drive stopped following

    walkStop := WS_HARD_LIMIT
    sideConsec := 0
    droopConsec := 0
    nPts := 0
    lastSwept := defSwept
    legConsecFaults := 0
    updateLegLow()
    repeat stepIdx from 1 to COARSE_MAX_STEPS
        if abortReason <> AR_NONE
            walkStop := WS_RUN_ABORT
            quit
        sweptDeg := defSwept + (walkDir * stepIdx * COARSE_STEP_DEG)
        ptIdx := legMeasure(side, speedIdx, signIdx, PH_COARSE, sweptDeg, coarseTicksFor(speedIdx), pointLimitMv)
        nPts += 1
        lastSwept := sweptDeg
        updateLegLow()
        if isFaultLikeIdx(ptIdx)
            sideConsec += 1
        else
            sideConsec := 0
        ' task 3595: a point that drove but did not FOLLOW. Counted separately from a fault, because
        '  the lag limiter turned what used to be a fault into a droop, and a droop is invisible to
        '  every other test here (isDroopIdx() carries the argument). A fault-like point does not also
        '  count as a droop -- it has already stopped this side by its own route.
        if isFaultLikeIdx(ptIdx) == FALSE and isDroopIdx(ptIdx)
            droopConsec += 1
        else
            droopConsec := 0
        if abortReason <> AR_NONE
            walkStop := WS_RUN_ABORT
            quit
        if sideConsec >= SIDE_FAULT_STOP
            walkStop := WS_FAULTS
            quit
        if droopConsec >= SIDE_DROOP_STOP
            walkStop := WS_DROOP
            quit
        if isHighIdx(ptIdx) and (beyondLowCount(walkDir, defSwept) >= MIN_PAST)
            walkStop := WS_RISE
            quit
    if walkStop == WS_FAULTS
        refineCliffEdge(side, speedIdx, signIdx, walkDir, defSwept, stepIdx, sideConsec, pointLimitMv)
    noteBoundary(walkDir, walkStop, ptIdx)
    emitWalk(side, speedIdx, signIdx, walkDir, nPts, lastSwept, walkStop)

PRI noteBoundary(walkDir, walkStop, lastIdx)
' Task 3595: record WHAT stopped this side of the arc, so the leg reports a boundary TYPE at each end
' rather than a bare pass. The two ends are bounded by different physics and the difference is the
' result: too much lead explodes the current, too little cannot make the torque.
'
' Run 7 measured both walls on every leg (debug_260914-114703.log): ABORT_I at swept +/-63 on every
' leg of both motors -- the CURRENT wall -- and FAULT from +7 down to -11 on the LEFT positive leg --
' the TORQUE wall. Between them the LEFT negative leg ran cleanly from +8 to +53: 45 electrical
' degrees of a 360-degree circle, which is the arc this instrument can honestly sweep.
'
' @param walkDir - +1 the up side, -1 the down side
' @param walkStop - WS_* that ended it
' @param lastIdx - leg index of the last point measured, may be -1

    if walkDir > 0
        legBoundUp := boundTypeFor(walkStop, lastIdx)
    else
        legBoundDown := boundTypeFor(walkStop, lastIdx)

PRI boundTypeFor(walkStop, lastIdx) : boundType
' Task 3595: classify one side's stop into the physics that caused it.
'
' A fault or a droop is the torque wall: the motor could not make the torque the commanded rate needed
' at that lead. The hard limit is the INSTRUMENT's edge, not the motor's, and is named as such so it
' can never be read as a measured boundary of the motor.
'
' NOTE -- A CURRENT ABORT ARRIVES AS WS_RISE, NOT WS_FAULTS, and the distinction has to be made here.
' isFaultLikeIdx() deliberately excludes PR_ABORT_I, so a current abort never accumulates sideConsec;
' but isHighIdxFor() deliberately counts PR_ABORT_I as high, so the abort ends the side through the
' RISE test instead. Both of those are right on their own terms -- an abort IS a high-current point,
' and it IS a bracket -- but "the current rose past its minimum" and "the current hit the safety
' abort" are not the same result, and a report that called both RISE would hide the wall. So the last
' point's own result decides, and a rise that ended on an abort is named CURRENT.
'
' @param walkStop - WS_* that ended the side
' @param lastIdx - leg index of the last point measured, may be -1
' @returns boundType - BT_* naming the physics

    boundType := BT_NONE
    case walkStop
        WS_RISE:
            boundType := BT_RISE
            if (lastIdx >= 0) and (lastIdx < legCount)
                if legResult[lastIdx] == PR_ABORT_I
                    boundType := BT_CURRENT
        WS_HARD_LIMIT:
            boundType := BT_LIMIT
        WS_DROOP:
            boundType := BT_TORQUE
        WS_FAULTS:
            boundType := BT_TORQUE
        other:
            boundType := BT_NONE

PRI refineCliffEdge(side, speedIdx, signIdx, walkDir, defSwept, curStep, curConsec, pointLimitMv) | goodStep, ...
    goodDeg, faultDeg
' Fine-walk into the fault edge the coarse walk just found (PL-31 / BS-CLIFF): reset this
' phase's consecutive-fault counter (mirrors runFinePoints/runExtension), then hand off to
' probeTowardFault() (task 3540 D1), which steps 2 deg at a time toward the fault -- clamped to
' 1 deg (CLIFF_LAST_STEP_DEG) short of it on the last step, so even the standard 10-deg coarse gap
' gets a final probe at fault-1 deg (coordinator review). computeLegCliff() later picks the
' tightest good/fault pair from every point in the leg.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - the rung whose walk stopped on faults
' @param signIdx - SIGN_NEG or SIGN_POS
' @param walkDir - +1 up, -1 down -- the direction that just stopped on faults
' @param defSwept - default offset, swept degrees
' @param curStep - the coarse step number at which the walk stopped
' @param curConsec - consecutive fault-like coarse points that stopped the walk
' @param pointLimitMv - per-point relative abort threshold, mV
'
' @local goodStep - coarse step number of the last good point before the fault run
' @local goodDeg - that point's swept offset
' @local faultDeg - the first fault-like coarse point beyond it, swept degrees

    legConsecFaults := 0
    goodStep := curStep - curConsec
    goodDeg := defSwept + (walkDir * goodStep * COARSE_STEP_DEG)
    faultDeg := goodDeg + (walkDir * COARSE_STEP_DEG)
    probeTowardFault(side, speedIdx, signIdx, walkDir, goodDeg, faultDeg, coarseTicksFor(speedIdx), pointLimitMv)

PRI probeTowardFault(side, speedIdx, signIdx, dir, goodDeg, faultDeg, winTicks, pointLimitMv) | probeDeg, nextDeg, ptIdx
' Task 3540 D1 (coordinator review): after a clean cliff probe, keep probing CLIFF_HALF_STEP_DEG
' (2 deg) closer to the fault instead of stopping at the first one -- at both speeds
' (refineCliffEdge()'s quarter-speed coarse-walk edge and probeConfirmCliff()'s half-speed confirm
' edge share this loop). The ordinary 2 deg step is clamped to CLIFF_LAST_STEP_DEG (1 deg, the
' finest the integer offset grid allows) when it would otherwise reach or pass the known fault, so
' a good/fault gap of exactly CLIFF_HALF_STEP_DEG (the common case: confirm points sit
' FINE_STEP_DEG=5 apart, and a coarse-walk edge is COARSE_STEP_DEG=10 apart, both leaving a
' 2-deg-or-wider remainder somewhere) still gets one last probe 1 deg from the fault, instead of
' none -- run 7's LEFT POS (good -11, fault -9, gap exactly 2 deg) got no probe at all under the
' plain 2-deg-only version (SCAN-RUN-7-EVALUATION.md sec 2; found in coordinator review). Every
' probe is tagged PH_CLIFF, strictly between goodDeg and faultDeg: nothing is ever commanded at or
' beyond a point that faulted in this leg (faultDeg was already measured and faulted). Stops on the
' first fault-like probe, on LEG_FAULT_CAP consecutive faults, on a run abort, or when the clamped
' step makes no forward progress (the previous probe was already the closest the grid allows).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - SPEED_QTR or SPEED_HALF
' @param signIdx - SIGN_NEG or SIGN_POS
' @param dir - +1 the fault lies above goodDeg, -1 below
' @param goodDeg - the last known-good point before the fault
' @param faultDeg - the known fault-like point beyond it, swept degrees
' @param winTicks - window length in hall ticks for this speed
' @param pointLimitMv - per-point relative abort threshold, mV
'
' @local probeDeg - the last probed (or starting good) offset
' @local nextDeg - the next candidate offset, clamped
' @local ptIdx - leg index of the probe just measured

    probeDeg := goodDeg
    repeat
        if (legConsecFaults >= LEG_FAULT_CAP) or (abortReason <> AR_NONE)
            quit
        nextDeg := probeDeg + (dir * CLIFF_HALF_STEP_DEG)
        if (dir * (faultDeg - nextDeg)) <= 0
            nextDeg := faultDeg - (dir * CLIFF_LAST_STEP_DEG) ' clamp to 1 deg short of the known fault
        if (dir * (nextDeg - probeDeg)) <= 0
            quit                                             ' no forward progress left on the integer grid
        ptIdx := legMeasure(side, speedIdx, signIdx, PH_CLIFF, nextDeg, winTicks, pointLimitMv)
        probeDeg := nextDeg
        if isFaultLikeIdx(ptIdx)
            quit

PRI computeLegCliff(defSwept, signIdx) | dir, ptIdx, dist, goodDist, faultDist
' Find the tightest last-good/first-fault transition, among every point stored in this leg, on
' the side of defSwept that trends toward the hall electrical zero (swept offset 0). Works from
' whatever phases are present -- coarse, the PH_CLIFF fine-walk probes, fine/confirm points and
' the REF_START/REF_END references -- so it needs no separate up/down bookkeeping of its own.
'
' @param defSwept - default offset, swept degrees
' @param signIdx - SIGN_NEG or SIGN_POS
'
' @local dir - +1 (SIGN_POS) or -1 (SIGN_NEG), the direction from defSwept toward zero
' @local ptIdx - leg index
' @local dist - (point's offset - defSwept) * dir; toward-zero distance, may be negative
' @local goodDist - largest valid toward-zero distance found (>= 0)
' @local faultDist - smallest fault-like toward-zero distance beyond goodDist, -1 when none

    legCliffFound := FALSE
    legCliffGoodDeg := 0
    legCliffFaultDeg := 0
    dir := (signIdx == SIGN_NEG) ? -1 : 1
    goodDist := 0
    faultDist := -1
    if legCount > 0
        repeat ptIdx from 0 to legCount - 1
            dist := (legDeg[ptIdx] - defSwept) * dir
            if (dist >= 0) and isValidIdx(ptIdx)
                goodDist := goodDist #> dist
        repeat ptIdx from 0 to legCount - 1
            dist := (legDeg[ptIdx] - defSwept) * dir
            if (dist > goodDist) and isFaultLikeIdx(ptIdx)
                if (faultDist < 0) or (dist < faultDist)
                    faultDist := dist
    if faultDist >= 0
        legCliffFound := TRUE
        legCliffGoodDeg := defSwept + (dir * goodDist)
        legCliffFaultDeg := defSwept + (dir * faultDist)

PRI bEvaluateBracket(side, speedIdx, signIdx, stopUp, stopDown) : bBracketed | ptIdx, bBelowOk, bAboveOk, reason, ...
    missingStop, risePctUp, risePctDown
' Decide whether a high point exists on both sides of the low; emit BS-BRACKET. CHANGE 1: a side
' whose walk stopped WS_FAULTS is judged inside its fault-bounded window (legLimitUpDeg/Down,
' set by refreshLegLimits() before this call) at the relaxed FAULT_RISE_PCT, and PH_CLIFF points
' (the fine-walk probes toward that edge) are eligible, not just REF_START/COARSE -- the limit
' point itself is one of them, so it qualifies on its own reading like any other point.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - the rung whose walk this judges, carried through to BS-BRACKET
' @param signIdx - SIGN_NEG or SIGN_POS
' @param stopUp - walk stop of the up side
' @param stopDown - walk stop of the down side
' @returns bBracketed - TRUE when bracketed
'
' @local ptIdx - leg index
' @local bBelowOk - a high point below the low exists
' @local bAboveOk - a high point above the low exists
' @local reason - BR_* verdict
' @local missingStop - walk stop of the side that did not bracket
' @local risePctUp - rise threshold for the up side: FAULT_RISE_PCT when it stopped on faults
' @local risePctDown - rise threshold for the down side: FAULT_RISE_PCT when it stopped on faults

    bBelowOk := FALSE
    bAboveOk := FALSE
    risePctUp := (stopUp == WS_FAULTS) ? FAULT_RISE_PCT : RISE_PCT
    risePctDown := (stopDown == WS_FAULTS) ? FAULT_RISE_PCT : RISE_PCT
    updateLegLow()
    if (legLowIdx >= 0) and (legCount > 0)
        repeat ptIdx from 0 to legCount - 1
            if (legPhase[ptIdx] == PH_REF_START) or (legPhase[ptIdx] == PH_COARSE) or (legPhase[ptIdx] == PH_CLIFF)
                if legDeg[ptIdx] < legDeg[legLowIdx]
                    if isHighIdxFor(ptIdx, risePctDown)
                        bBelowOk := TRUE
                elseif legDeg[ptIdx] > legDeg[legLowIdx]
                    if isHighIdxFor(ptIdx, risePctUp)
                        bAboveOk := TRUE
    bBracketed := bBelowOk and bAboveOk
    if legLowIdx < 0
        reason := (abortReason <> AR_NONE) ? BR_RUN_ABORT : BR_NO_VALID
    elseif bBracketed
        reason := BR_OK
    else
        missingStop := (bBelowOk == FALSE) ? stopDown : stopUp
        if missingStop == WS_FAULTS
            reason := BR_EDGE_FAULT
        elseif missingStop == WS_RUN_ABORT
            reason := BR_RUN_ABORT
        else
            reason := BR_EDGE_HARD_LIMIT
    emitBracket(side, speedIdx, signIdx, bBelowOk, bAboveOk, bBracketed, reason)

PRI bWithinHardLimit(sweptDeg, defSwept) : bWithin
' Report whether an offset lies within default +/- HARD_LIMIT_DEG.
'
' @param sweptDeg - candidate swept offset
' @param defSwept - default offset, swept degrees
' @returns bWithin - TRUE when inside the hard limit

    bWithin := (abs(sweptDeg - defSwept) <= HARD_LIMIT_DEG)

PRI bWithinWindowLimit(sweptDeg) : bWithin
' CHANGE 1: report whether an offset lies within this leg's current fault-bounded window (both
' sides). Unrestricted (defSwept +/- HARD_LIMIT_DEG, already checked by bWithinHardLimit()) until
' refreshLegLimits() tightens one side toward a fault edge.
'
' @param sweptDeg - candidate swept offset
' @returns bWithin - TRUE when inside the window

    bWithin := (sweptDeg <= legLimitUpDeg) and (sweptDeg >= legLimitDownDeg)

PRI legLimitForDir(defSwept, dir) : limitDeg, bFromFault | ptIdx, dist, faultDist, goodDist
' CHANGE 1: the fault-bounded window limit in one direction from defSwept -- the farthest valid
' point (any phase) before the nearest fault-like point beyond it, mirroring computeLegCliff()'s
' good/fault scan but kept per-side instead of only the toward-zero side. Unrestricted
' (defSwept +/- HARD_LIMIT_DEG) when this leg has no fault-like point in this direction.
'
' @param defSwept - default offset, swept degrees
' @param dir - +1 up, -1 down
' @returns limitDeg - swept degrees, the window's edge in this direction
' @returns bFromFault - TRUE when limitDeg came from a fault, not the hard limit
'
' @local ptIdx - leg index
' @local dist - (point's offset - defSwept) * dir; distance in dir, may be negative
' @local faultDist - smallest fault-like distance in dir beyond a good point, -1 when none
' @local goodDist - largest valid distance in dir strictly less than faultDist

    faultDist := -1
    if legCount > 0
        repeat ptIdx from 0 to legCount - 1
            dist := (legDeg[ptIdx] - defSwept) * dir
            if (dist > 0) and isFaultLikeIdx(ptIdx)
                if (faultDist < 0) or (dist < faultDist)
                    faultDist := dist
    bFromFault := (faultDist >= 0)
    if bFromFault
        goodDist := 0
        repeat ptIdx from 0 to legCount - 1
            dist := (legDeg[ptIdx] - defSwept) * dir
            if (dist >= 0) and (dist < faultDist) and isValidIdx(ptIdx)
                goodDist := goodDist #> dist
    else
        goodDist := HARD_LIMIT_DEG
    limitDeg := defSwept + (dir * goodDist)

PRI refreshLegLimits(defSwept)
' CHANGE 1: recompute legLimitUpDeg/legLimitDownDeg from every point stored in this leg so far
' (any phase, any speed). Safe to call repeatedly -- runLeg() calls it once after the coarse walk,
' and runFinePoints()/runExtension() call it again after every point they measure, so a fault
' discovered mid-fine-walk (either speed) tightens the window for the very next candidate.
'
' @param defSwept - default offset, swept degrees

    legLimitUpDeg, bLegLimitUpFault := legLimitForDir(defSwept, 1)
    legLimitDownDeg, bLegLimitDownFault := legLimitForDir(defSwept, -1)

PRI bFitPinnedNearLimit() : bPinned
' CHANGE 1: report whether the just-solved fit's vertex lies within one FINE_STEP_DEG of a
' fault-derived window limit -- a minimum pinned against a fault edge must never read as a free
' minimum. Only a fault-derived limit counts; the unrestricted default (+/- HARD_LIMIT_DEG) never
' triggers this (FS_EDGE, from the measured span, already covers that case).
'
' @returns bPinned - TRUE when the fit solved and its vertex sits against a fault-bounded edge

    bPinned := FALSE
    if bFitSolved
        if bLegLimitUpFault and (fabs(fitMinF -. float(legLimitUpDeg)) <. float(FINE_STEP_DEG))
            bPinned := TRUE
        elseif bLegLimitDownFault and (fabs(fitMinF -. float(legLimitDownDeg)) <. float(FINE_STEP_DEG))
            bPinned := TRUE

PRI runFinePoints(side, speedIdx, signIdx, centreDeg, defSwept, pointLimitMv) : legExit | orderIdx, ...
    orderCount, pOrder, sweptDeg, winTicks, ptIdx
' Measure the interleaved fine (1/4) or confirm (1/2) points around centreDeg. CHANGE 4 (scan
' v4): at SPEED_HALF, a confirm point that faults is immediately followed by probeConfirmCliff(),
' which now (task 3540 D1) keeps probing 2 deg closer to the fault, clamped to a final 1-deg step
' (CLIFF_LAST_STEP_DEG) so even a narrow gap gets one probe -- exactly what refineCliffEdge() does
' for the quarter-speed coarse walk -- so the gap a fault-bounded window
' would otherwise leave unmeasured (run 5's LEFT half-speed legs, both TOO_FEW: SCAN-RUN-5-
' EVALUATION.md section 3; run 7's evaluation section 5, the same gap one step narrower) is filled
' before refreshLegLimits() locks the window down to it. Whether the negative case actually held is
' judged afterward, over the whole leg, by bEvaluateConfirmBracket() (D2) -- not accounted point-by-
' point here.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - SPEED_QTR or SPEED_HALF
' @param signIdx - SIGN_NEG or SIGN_POS
' @param centreDeg - centre, swept degrees
' @param defSwept - default offset, swept degrees
' @param pointLimitMv - per-point relative abort threshold, mV
' @returns legExit - LX_DONE or LX_FAULT_CAP
'
' @local orderIdx - index into the order table
' @local orderCount - entries in the order table
' @local pOrder - pointer to the order table
' @local sweptDeg - this point's swept offset
' @local winTicks - window ticks for this speed
' @local ptIdx - leg index of the just-measured confirm/fine point
'
' CHANGE 1 (scan v3): a candidate outside the current fault-bounded window (bWithinWindowLimit())
' is skipped -- never measured -- and refreshLegLimits() re-runs after every point measured, so a
' fault at this speed (e.g. a half-speed confirm point) tightens the window for the rest of this
' leg, quarter or half speed alike.

    legExit := LX_DONE
    legConsecFaults := 0
    ' task 3595: the WALKING rung sweeps the full fine set around the minimum it just bracketed; a
    '  CONFIRM rung measures the shorter confirm set around the centre the walk handed it.
    if bWalkRung(speedIdx)
        pOrder := @fineOrder
        orderCount := FINE_ORDER_COUNT
    else
        pOrder := @confirmOrder
        orderCount := CONFIRM_ORDER_COUNT
    winTicks := winTicksFor(speedIdx)
    repeat orderIdx from 0 to orderCount - 1
        if abortReason <> AR_NONE
            quit
        if legConsecFaults >= LEG_FAULT_CAP
            quit
        sweptDeg := centreDeg + (LONG[pOrder][orderIdx] * FINE_STEP_DEG)
        if bWithinHardLimit(sweptDeg, defSwept) and bWithinWindowLimit(sweptDeg)
            ptIdx := legMeasure(side, speedIdx, signIdx, PH_FINE, sweptDeg, winTicks, pointLimitMv)
            if (bWalkRung(speedIdx) == FALSE) and isFaultLikeIdx(ptIdx) and (legConsecFaults < LEG_FAULT_CAP) and (abortReason == AR_NONE)
                probeConfirmCliff(side, speedIdx, signIdx, defSwept, sweptDeg, pointLimitMv)
            refreshLegLimits(defSwept)
    if legConsecFaults >= LEG_FAULT_CAP
        legExit := LX_FAULT_CAP
        emitAbort(SCOPE_LEG, AR_FAULT_CAP, side, signedIncre(speedIdx, signIdx), legConsecFaults)

PRI probeConfirmCliff(side, speedIdx, signIdx, defSwept, faultDeg, pointLimitMv) | dir, goodDeg, bFromFault
' CHANGE 4 (scan v4); rewritten task 3540 D1 onto the shared probeTowardFault() loop. The CONFIRM-rung
' counterpart to refineCliffEdge(). A confirm point that just faulted leaves a gap between the
' leg's last good point and this fault -- run 5's evaluation section 3 found exactly this gap (9deg
' and -16deg never measured), and run 7's evaluation section 5 found the SAME gap surviving one
' step narrower after the old single fine/half-step probe found its own probe clean and stopped
' (D1). probeTowardFault() now keeps stepping CLIFF_HALF_STEP_DEG toward the fault from the last
' good point (found by legLimitForDir(), the same good/fault scan the window limit itself uses),
' clamped to CLIFF_LAST_STEP_DEG (1 deg) short of it on the last step -- so even the common
' one-fine-step (5 deg) confirm gap still gets a probe 1 deg from the fault, and the exactly
' CLIFF_HALF_STEP_DEG (2 deg) gap run 7's LEFT POS leg had (good -11, fault -9) now gets one probe
' at -10 instead of none (coordinator review) -- until it hits a fault, runs out of room, or the
' fault cap trips. runFinePoints() calls
' refreshLegLimits() again right after this returns, so these probes are counted before the window
' limit is (re)applied to any later confirm point. fitLeg() admits PH_CLIFF points into the fit only
' on a CONFIRM rung (bFitAdmitsCliff()), so the WALKING rung's own PH_CLIFF probes -- which come from
' the coarse walk's fault edge, far from the minimum being fitted -- are unaffected.
'
' TASK 3595: this runs for EVERY confirm rung, a quarter as well as a half. The doc used to say half
' speed was the only caller, which was true when half speed was the only confirm rung and is not now.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - the CONFIRM rung this probe belongs to, SPEED_QTR or SPEED_HALF
' @param signIdx - SIGN_NEG or SIGN_POS
' @param defSwept - default offset, swept degrees (this leg's window-limit anchor)
' @param faultDeg - the confirm point that just faulted, swept degrees
' @param pointLimitMv - per-point relative abort threshold, mV
'
' @local dir - +1 the fault lies above defSwept, -1 below
' @local goodDeg - the last good point before this fault, from legLimitForDir()
' @local bFromFault - legLimitForDir()'s own flag; skip probing when FALSE (no fault found yet)

    dir := (faultDeg > defSwept) ? 1 : -1
    goodDeg, bFromFault := legLimitForDir(defSwept, dir)
    if bFromFault
        probeTowardFault(side, speedIdx, signIdx, dir, goodDeg, faultDeg, winTicksFor(speedIdx), pointLimitMv)

PRI runExtension(side, speedIdx, signIdx, defSwept, pointLimitMv) : legExit | extDir, edgeDeg, extIdx, ...
    extCount, sweptDeg, winTicks
' Add points beyond the span edge nearest the fitted vertex (once per leg).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - SPEED_QTR or SPEED_HALF
' @param signIdx - SIGN_NEG or SIGN_POS
' @param defSwept - default offset, swept degrees
' @param pointLimitMv - per-point relative abort threshold, mV
' @returns legExit - LX_DONE or LX_FAULT_CAP
'
' @local extDir - +1 beyond the high edge, -1 beyond the low edge
' @local edgeDeg - the edge being extended
' @local extIdx - extension point number
' @local extCount - extension points for this speed
' @local sweptDeg - this point's swept offset
' @local winTicks - window ticks for this speed
'
' CHANGE 1 (scan v3): same window gating as runFinePoints() -- never past legLimitUpDeg/Down.

    legExit := LX_DONE
    legConsecFaults := 0
    if bWalkRung(speedIdx)                                  ' task 3595: role, not speed -- PL-29, never a ternary here
        extCount := EXTEND_PTS
    else
        extCount := CONFIRM_EXTEND_PTS
    winTicks := winTicksFor(speedIdx)
    if fitMinF >. float(fitCentre)
        extDir := 1
        edgeDeg := fitSpanHi
    else
        extDir := -1
        edgeDeg := fitSpanLo
    repeat extIdx from 1 to extCount
        if abortReason <> AR_NONE
            quit
        if legConsecFaults >= LEG_FAULT_CAP
            quit
        sweptDeg := edgeDeg + (extDir * extIdx * FINE_STEP_DEG)
        if bWithinHardLimit(sweptDeg, defSwept) and bWithinWindowLimit(sweptDeg)
            legMeasure(side, speedIdx, signIdx, PH_EXTEND, sweptDeg, winTicks, pointLimitMv)
            refreshLegLimits(defSwept)
    if legConsecFaults >= LEG_FAULT_CAP
        legExit := LX_FAULT_CAP
        emitAbort(SCOPE_LEG, AR_FAULT_CAP, side, signedIncre(speedIdx, signIdx), legConsecFaults)

PRI fitLeg(centreDeg, minPts, speedIdx) | ptIdx, nPts, seCnt, uF, yF, u2F, sumOneF, sumUF, sumU2F, sumU3F, sumU4F, ...
    sumYF, sumUYF, sumU2YF, cof00F, cof01F, cof02F, cof11F, cof12F, cof22F, detF, curvF, slopeF, levelF, ...
    predF, residF, rssF, resVarF, varCurvF, varSlopeF, covF, uStarF, varUF, poorF, seLimitF, bPtEligible
' Least-squares quadratic y = curv*u^2 + slope*u + level over the leg's valid FINE/EXTEND
' points (plus, at SPEED_HALF only, the CHANGE 4 PH_CLIFF probes -- see runFinePoints()'s
' probeConfirmCliff()), u = (offset - centre) / 10 degrees, solved by cofactors of the normal
' matrix. Fills the fit record and its status (TOO_FEW, NOT_CONVEX, EDGE, POOR, OK). Scan v4
' CHANGE 2: y is the point's NET mean (legNetX10), not raw (legMeanX10) -- so resMinMvF, and
' everything derived from it (BS-RESULT's i_min, BS-PAIR2's minima), comes out already net of
' each point's own zero.
'
' @param centreDeg - centre, swept degrees
' @param minPts - fewest valid points the fit accepts
' @param speedIdx - SPEED_QTR or SPEED_HALF; only SPEED_HALF admits PH_CLIFF points
'
' @local ptIdx - leg index
' @local nPts - points in the fit
' @local seCnt - points with a valid standard error
' @local uF - scaled offset
' @local yF - mean sense, mV
' @local u2F - uF squared
' @local sumOneF - point count as float
' @local sumUF - sum u
' @local sumU2F - sum u^2
' @local sumU3F - sum u^3
' @local sumU4F - sum u^4
' @local sumYF - sum y
' @local sumUYF - sum u*y
' @local sumU2YF - sum u^2*y
' @local cof00F - cofactor 0,0
' @local cof01F - cofactor 0,1
' @local cof02F - cofactor 0,2
' @local cof11F - cofactor 1,1
' @local cof12F - cofactor 1,2
' @local cof22F - cofactor 2,2
' @local detF - determinant
' @local curvF - fitted curvature, mV per u^2
' @local slopeF - fitted slope, mV per u
' @local levelF - fitted level at the centre, mV
' @local predF - fitted value at a point
' @local residF - residual at a point
' @local rssF - residual sum of squares
' @local resVarF - residual variance
' @local varCurvF - variance of the curvature
' @local varSlopeF - variance of the slope
' @local covF - curvature/slope covariance
' @local uStarF - vertex, u units
' @local varUF - vertex variance, u units
' @local poorF - POOR threshold, mV
' @local seLimitF - SE-based POOR threshold, mV
' @local bPtEligible - TRUE when this leg index belongs in the fit (PH_FINE/PH_EXTEND always,
'   PH_CLIFF only at SPEED_HALF)

    fitCentre := centreDeg
    fitStatus := FS_TOO_FEW
    bFitSolved := FALSE
    bFitSeValid := FALSE
    nPts := 0
    seCnt := 0
    sumOneF := 0.0
    sumUF := 0.0
    sumU2F := 0.0
    sumU3F := 0.0
    sumU4F := 0.0
    sumYF := 0.0
    sumUYF := 0.0
    sumU2YF := 0.0
    fitSpanLo := POSX
    fitSpanHi := NEGX
    if legCount > 0
        repeat ptIdx from 0 to legCount - 1
            bPtEligible := (legPhase[ptIdx] == PH_FINE) or (legPhase[ptIdx] == PH_EXTEND) or ...
                (bFitAdmitsCliff(speedIdx) and (legPhase[ptIdx] == PH_CLIFF))
            if bPtEligible and isValidIdx(ptIdx)
                uF := float(legDeg[ptIdx] - centreDeg) /. FIT_DEG_SCALE
                yF := float(legNetX10[ptIdx]) /. 10.0
                u2F := uF *. uF
                sumOneF := sumOneF +. 1.0
                sumUF := sumUF +. uF
                sumU2F := sumU2F +. u2F
                sumU3F := sumU3F +. (u2F *. uF)
                sumU4F := sumU4F +. (u2F *. u2F)
                sumYF := sumYF +. yF
                sumUYF := sumUYF +. (uF *. yF)
                sumU2YF := sumU2YF +. (u2F *. yF)
                fitSpanLo := fitSpanLo <# legDeg[ptIdx]
                fitSpanHi := fitSpanHi #> legDeg[ptIdx]
                if bLegSeValid[ptIdx]
                    seScratch[seCnt] := legSeX10[ptIdx]
                    seCnt += 1
                nPts += 1
    fitN := nPts
    fitMedSeX10 := medianSeX10(seCnt)
    if (nPts >= minPts) and (nPts > FIT_PARAMS)
        cof00F := (sumU2F *. sumOneF) -. (sumUF *. sumUF)
        cof01F := (sumUF *. sumU2F) -. (sumU3F *. sumOneF)
        cof02F := (sumU3F *. sumUF) -. (sumU2F *. sumU2F)
        cof11F := (sumU4F *. sumOneF) -. (sumU2F *. sumU2F)
        cof12F := (sumU2F *. sumU3F) -. (sumU4F *. sumUF)
        cof22F := (sumU4F *. sumU2F) -. (sumU3F *. sumU3F)
        detF := ((sumU4F *. cof00F) +. (sumU3F *. cof01F)) +. (sumU2F *. cof02F)
        if fabs(detF) >. FIT_DET_MIN
            curvF := (((cof00F *. sumU2YF) +. (cof01F *. sumUYF)) +. (cof02F *. sumYF)) /. detF
            slopeF := (((cof01F *. sumU2YF) +. (cof11F *. sumUYF)) +. (cof12F *. sumYF)) /. detF
            levelF := (((cof02F *. sumU2YF) +. (cof12F *. sumUYF)) +. (cof22F *. sumYF)) /. detF
            fitCurvF := curvF
            if curvF <=. 0.0
                fitStatus := FS_NOT_CONVEX
            else
                bFitSolved := TRUE
                uStarF := (0.0 -. slopeF) /. (2.0 *. curvF)
                fitMinF := float(centreDeg) +. (uStarF *. FIT_DEG_SCALE)
                fitMinMvF := levelF -. ((slopeF *. slopeF) /. (4.0 *. curvF))
                rssF := 0.0
                repeat ptIdx from 0 to legCount - 1
                    bPtEligible := (legPhase[ptIdx] == PH_FINE) or (legPhase[ptIdx] == PH_EXTEND) or ...
                        (bFitAdmitsCliff(speedIdx) and (legPhase[ptIdx] == PH_CLIFF))
                    if bPtEligible and isValidIdx(ptIdx)
                        uF := float(legDeg[ptIdx] - centreDeg) /. FIT_DEG_SCALE
                        yF := float(legNetX10[ptIdx]) /. 10.0
                        predF := ((curvF *. (uF *. uF)) +. (slopeF *. uF)) +. levelF
                        residF := yF -. predF
                        rssF := rssF +. (residF *. residF)
                resVarF := rssF /. float(nPts - FIT_PARAMS)
                fitRmsF := fsqrt(resVarF)
                varCurvF := (resVarF *. cof00F) /. detF
                varSlopeF := (resVarF *. cof11F) /. detF
                covF := (resVarF *. cof01F) /. detF
                varUF := (((varSlopeF /. 4.0) +. ((uStarF *. uStarF) *. varCurvF)) +. (uStarF *. covF)) /. (curvF *. curvF)
                if varUF >=. 0.0
                    fitSeF := FIT_DEG_SCALE *. fsqrt(varUF)
                    bFitSeValid := (nan(fitSeF) == FALSE)
                poorF := FIT_POOR_MIN_MV
                seLimitF := FIT_POOR_SE_FACTOR *. (float(fitMedSeX10) /. 10.0)
                if seLimitF >. poorF
                    poorF := seLimitF
                if (fitMinF <. (float(fitSpanLo) +. FIT_EDGE_MARGIN_DEG)) or (fitMinF >. (float(fitSpanHi) -. FIT_EDGE_MARGIN_DEG))
                    fitStatus := FS_EDGE
                elseif fitRmsF >. poorF
                    fitStatus := FS_POOR
                else
                    fitStatus := FS_OK
    if nPts == 0
        fitSpanLo := 0
        fitSpanHi := 0

PRI medianSeX10(seCnt) : medX10 | outerIdx, innerIdx, heldX10
' Median of the first seCnt entries of seScratch[] (sorted in place).
'
' @param seCnt - entries to consider
' @returns medX10 - median standard error x10, 0 when there are none
'
' @local outerIdx - insertion-sort outer index
' @local innerIdx - insertion-sort inner index
' @local heldX10 - entry being inserted

    medX10 := 0
    if seCnt > 1
        repeat outerIdx from 1 to seCnt - 1
            heldX10 := seScratch[outerIdx]
            innerIdx := outerIdx - 1
            repeat while innerIdx >= 0
                if seScratch[innerIdx] <= heldX10
                    quit
                seScratch[innerIdx + 1] := seScratch[innerIdx]
                innerIdx -= 1
            seScratch[innerIdx + 1] := heldX10
    if seCnt > 0
        if (seCnt // 2) == 1
            medX10 := seScratch[seCnt / 2]
        else
            medX10 := (seScratch[(seCnt / 2) - 1] + seScratch[seCnt / 2]) / 2

PRI floatToBoundedInt(valueF, limitAbs) : intValue
' Round a float to the nearest integer, clamped to +/- limitAbs; NaN becomes 0.
'
' @param valueF - float to convert
' @param limitAbs - clamp magnitude
' @returns intValue - rounded, clamped integer

    intValue := 0
    if nan(valueF) == FALSE
        if valueF >. float(limitAbs)
            intValue := limitAbs
        elseif valueF <. float(0 - limitAbs)
            intValue := 0 - limitAbs
        else
            intValue := round(valueF)

PRI normDegrees(inDegrees) : outDegrees | stepCount
' Bring a swept offset into 0..359 with bounded add/subtract-360 steps (never FRAC or //).
'
' @param inDegrees - degrees, any sign
' @returns outDegrees - degrees in 0..359
'
' @local stepCount - steps taken

    outDegrees := inDegrees
    stepCount := 0
    repeat while (outDegrees < 0) and (stepCount < NORM_MAX_STEPS)
        outDegrees += DEGREES_PER_TURN
        stepCount += 1
    repeat while (outDegrees >= DEGREES_PER_TURN) and (stepCount < NORM_MAX_STEPS)
        outDegrees -= DEGREES_PER_TURN
        stepCount += 1
    outDegrees := (outDegrees #> 0) <# (DEGREES_PER_TURN - 1)

PRI defaultSwept(signIdx) : sweptDeg
' Default offset for a sign in signed swept degrees: 43 for NEG, -43 (317) for POS.
'
' @param signIdx - SIGN_NEG or SIGN_POS
' @returns sweptDeg - default, swept degrees

    sweptDeg := (signIdx == SIGN_NEG) ? DEF_NEG_DEG : (DEF_POS_DEG - DEGREES_PER_TURN)

PRI signedIncre(speedIdx, signIdx) : motorIncre
' Signed motor increment for a speed and sign.
'
' @param speedIdx - SPEED_LOW, SPEED_QTR or SPEED_HALF
' @param signIdx - SIGN_NEG or SIGN_POS
' @returns motorIncre - signed increment

    case speedIdx
        SPEED_HALF:
            motorIncre := HALF_SPEED_INCRE
        SPEED_LOW:
            motorIncre := LOW_SPEED_INCRE
        other:
            motorIncre := QTR_SPEED_INCRE
    if signIdx == SIGN_NEG
        motorIncre := 0 - motorIncre

PRI applyOffsets(side, signIdx, sweptDeg) | wantNeg, wantPos, ofsSlot
' Set the swept sign's offset and hold the other at its default; read both back into the point
' record. A read-back mismatch ends the run. Task 3537: counts every read-back, and every mismatch,
' for R6-SCAN-OFFSETS.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signIdx - SIGN_NEG or SIGN_POS
' @param sweptDeg - signed swept offset, degrees
'
' @local wantNeg - offset_fwd degrees to apply
' @local wantPos - offset_rev degrees to apply
' @local ofsSlot - sideSlot(side), the sign-off accumulator index

    if signIdx == SIGN_NEG
        wantNeg := normDegrees(sweptDeg)
        wantPos := DEF_POS_DEG
    else
        wantNeg := DEF_NEG_DEG
        wantPos := normDegrees(sweptDeg)
    sideSetOffsets(side, wantNeg, wantPos)
    ptNegDeg, ptPosDeg := sideGetOffsets(side)
    ofsSlot := sideSlot(side)
    sfReadbacks[ofsSlot] += 1
    if (ptNegDeg <> wantNeg) or (ptPosDeg <> wantPos)
        sfOffsetsBad[ofsSlot] += 1
        setRunAbort(AR_OFFSET_READBACK, ptNegDeg)

PRI sideSlot(side) : slotIdx
' Per-side array index: LEFT 0, RIGHT 1.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns slotIdx - 0 or 1

    slotIdx := (side == SIDE_RIGHT) ? 1 : 0

PRI selfSlot(side, signIdx) : slotIdx
' Self-check mean index for a side and sign.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signIdx - SIGN_NEG or SIGN_POS
' @returns slotIdx - index into selfMeanX10[]

    slotIdx := (sideSlot(side) * SIGN_SLOTS) + signIdx

PRI resultSlot(side, signIdx, speedIdx) : slotIdx
' Result index for a side, sign and speed.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signIdx - SIGN_NEG or SIGN_POS
' @param speedIdx - SPEED_QTR or SPEED_HALF
' @returns slotIdx - index into the res*[] arrays

    slotIdx := (((sideSlot(side) * SIGN_SLOTS) + signIdx) * SPEED_SLOTS) + speedIdx

PRI bFitAdmitsCliff(speedIdx) : bAdmits
' Task 3595: whether this rung's fit admits its PH_CLIFF probes.
'
' A CONFIRM rung does. Its confirm points are few and sit close to a centre the walk already found, so
' the cliff probes -- taken right at the fault edge, between the last good point and the first faulted
' one -- are the only extra data near that edge and they earn their place in the fit.
'
' The WALKING rung does not. Its own cliff probes come from the coarse walk's fault edge, far from the
' minimum it is fitting, and admitting them would pull the quadratic toward a wall rather than through
' the basin. That was already the rule when quarter speed walked; it is stated as a role here so it
' stays true now that an eighth does.
'
' @param speedIdx - SPEED_* rung
' @returns bAdmits - TRUE for a confirm rung

    bAdmits := (bWalkRung(speedIdx) == FALSE)

PRI pointAbortLimit(refMeanX10) : limitMv
' The per-point relative current abort, in raw mV, CLAMPED BELOW THE ABSOLUTE ABORT (2026-09-22).
'
' NOTE -- THE TWO GUARDS WERE IN THE WRONG ORDER, AND IT COST A WHOLE RUN. The point-scope abort is
' POINT_ABORT_X100 (2.5x) of the leg's own reference and ends ONE point; the absolute abort is
' ABS_ABORT_MV and ends the RUN. At the half-speed rung the leg reference measured 952.9 mV
' (debug_260921-192618.log seq 67), so the point-scope limit computed to 2_382 mV -- 59 % ABOVE the
' 1_500 mV that kills the run. The graduated guard could not fire first, so the first genuinely
' high-current point took the entire run with it: 68 points in, the RIGHT motor never started, and no
' half-speed minimum was obtained. The arithmetic makes it structural rather than unlucky -- ANY rung
' whose reference exceeds ABS_ABORT_MV / 2.5 = 600 mV has its relative guard disarmed.
'
' NOTE -- THE ABSOLUTE ABORT IS NOT TOUCHED. It is the unattended-safety backstop, and lowering a safety
' limit so a test can pass is the retreat D1 forbids. What is corrected is the ORDER: the survivable
' guard is brought back below the fatal one, which is where the design always intended it.
'
' The headroom below the absolute abort is deliberate rather than exact. It only has to be enough that
' a rising point trips the point guard on a sample or two before it would trip the absolute one, and
' ABS_ABORT_SAMPLES consecutive reads are required for the absolute abort, so a modest margin
' suffices. The clamp is reported in BS-LIMITS beside both limits, so a reader sees which one bound.
'
' @param refMeanX10 - the leg's reference current, raw mean x10 mV
' @returns limitMv - the per-point abort threshold in raw mV, never at or above the absolute abort

    limitMv := (refMeanX10 * POINT_ABORT_X100) / (X100 * X10)
    limitMv := limitMv <# POINT_ABORT_CEIL_MV

PRI coarseTicksFor(speedIdx) : winTicks
' The COARSE walk's window for a rung, in hall ticks (task 3595 follow-up). Same principle as
' winTicksFor(): halving the rate halves the ticks, so every rung's coarse point lasts about the same
' wall-clock time and their currents are comparable.
'
' @param speedIdx - SPEED_* rung
' @returns winTicks - coarse window length in hall ticks

    if bWalkRung(speedIdx)
        winTicks := WIN_TICKS_COARSE_LOW
    else
        winTicks := WIN_TICKS_COARSE

PRI winTicksFor(speedIdx) : winTicks
' Task 3595: the measurement window, in hall ticks, for a rung's fine/confirm points. Each rung's
' tick count is chosen so the window lasts about the same WALL-CLOCK time at that rung's rate --
' halving the rate halves the ticks. One place owns this, because a window whose duration varied by
' rung would make the rungs' standard errors incomparable, and the whole point of a confirm rung is
' to be compared against the walk.
'
' @param speedIdx - SPEED_* rung
' @returns winTicks - window length in hall ticks

    case speedIdx
        SPEED_HALF:
            winTicks := WIN_TICKS_HALF
        SPEED_LOW:
            winTicks := WIN_TICKS_LOW
        other:
            winTicks := WIN_TICKS_FINE

PRI fitMinPtsFor(speedIdx) : minPts
' Task 3595: the fit's minimum point count for a rung -- the walking rung sweeps a full fine set and
' is held to FIT_MIN_PTS; a confirm rung measures fewer points around an already-found centre and is
' held to CONFIRM_MIN_PTS.
'
' @param speedIdx - SPEED_* rung
' @returns minPts - the fewest points fitLeg() will accept for that rung

    if bWalkRung(speedIdx)
        minPts := FIT_MIN_PTS
    else
        minPts := CONFIRM_MIN_PTS

PRI bWalkRung(speedIdx) : bWalks
' Task 3595: report whether this rung is the EXPLORATORY one -- the leg that walks out from the
' default looking for the minimum, as opposed to a rung that confirms an already-found centre.
'
' The distinction used to be spelled `speedIdx == SPEED_QTR`, which made one value carry two meanings:
' a speed AND a role. Adding a third rung is exactly the change that would have broken every one of
' those sites silently, since they would all still have compiled and still have named quarter speed
' while meaning "the walking leg". Asking the role by name is what makes the third rung safe.
'
' @param speedIdx - SPEED_* rung
' @returns bWalks - TRUE for the rung that performs the coarse walk

    bWalks := (speedIdx == SPEED_WALK)

PRI bRateInBand(speedIdx, rateX10) : bInBand
' Report whether a tick rate is inside the band for its speed.
'
' @param speedIdx - SPEED_LOW, SPEED_QTR or SPEED_HALF
' @param rateX10 - ticks per second x10
' @returns bInBand - TRUE when inside the band

    case speedIdx
        SPEED_HALF:
            bInBand := (rateX10 >= RATE_HALF_LO * X10) and (rateX10 <= RATE_HALF_HI * X10)
        SPEED_LOW:
            bInBand := (rateX10 >= RATE_LOW_LO * X10) and (rateX10 <= RATE_LOW_HI * X10)
        other:
            bInBand := (rateX10 >= RATE_QTR_LO * X10) and (rateX10 <= RATE_QTR_HI * X10)

PRI clampSense(rawMv) : clampedMv
' Clamp a sense sample so the accumulators cannot overflow (PL-20).
'
' @param rawMv - sense_i_mV sample
' @returns clampedMv - sample clamped to SAMPLE_CLAMP_LO_MV..SAMPLE_CLAMP_HI_MV

    clampedMv := (rawMv #> SAMPLE_CLAMP_LO_MV) <# SAMPLE_CLAMP_HI_MV

PRI commandMotor(side, motorIncre) | safeIncre
' Command a signed motor increment -- the ONLY place an increment reaches the library. Anything
' above DRIVE_CEILING_INCRE is refused, commanded as zero, and ends the run (P13).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment requested
'
' @local safeIncre - increment actually commanded

    safeIncre := motorIncre
    if abs(motorIncre) > DRIVE_CEILING_INCRE
        safeIncre := 0
        setRunAbort(AR_INCRE_GUARD, motorIncre)
    lastIncre := safeIncre
    beat(CP_LIB_COMMAND)
    if side == SIDE_RIGHT
        wheelR.testDriveAtMotorIncrement(safeIncre)
    elseif side == SIDE_LEFT
        wheelL.testDriveAtMotorIncrement(safeIncre)
    beat(CP_LIB_COMMAND)

PRI sideStart(side) : startedCog
' start() the named wheel on its fixed bench base.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns startedCog - start()'s return: cog id 0..7, or -1

    startedCog := -1
    beat(CP_LIB_START)
    if side == SIDE_RIGHT
        benchLog.cogEventBegin()
        startedCog := wheelR.start(RIGHT_TEST_BASE, TEST_VOLTAGE, TEST_DET_MODE)
        benchLog.cogEventEnd()
    elseif side == SIDE_LEFT
        benchLog.cogEventBegin()
        startedCog := wheelL.start(LEFT_TEST_BASE, TEST_VOLTAGE, TEST_DET_MODE)
        benchLog.cogEventEnd()
    beat(CP_LIB_START)

PRI sideStop(side)
' stop() the named wheel.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    beat(CP_LIB_STOP)
    if side == SIDE_RIGHT
        benchLog.cogEventBegin()
        wheelR.stop()
    elseif side == SIDE_LEFT
        benchLog.cogEventBegin()
        wheelL.stop()
    beat(CP_LIB_STOP)

PRI bSideCogRunning(side) : bRunning
' Report whether the named wheel has a running driver cog (stop() zeroes motorCog).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bRunning - TRUE when the driver cog is running

    bRunning := FALSE
    beat(CP_LIB_COGRUN)
    if side == SIDE_RIGHT
        bRunning := (wheelR.testGetMotorCog() <> 0)
    elseif side == SIDE_LEFT
        bRunning := (wheelL.testGetMotorCog() <> 0)
    beat(CP_LIB_COGRUN)

PRI sideMotorCog(side) : cogValue
' testGetMotorCog() of the named wheel: the driver's cog id + 1, or 0 when no driver cog runs.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns cogValue - the wheel's raw motorCog value

    cogValue := 0
    beat(CP_LIB_COGRUN)
    if side == SIDE_RIGHT
        cogValue := wheelR.testGetMotorCog()
    elseif side == SIDE_LEFT
        cogValue := wheelL.testGetMotorCog()
    beat(CP_LIB_COGRUN)

PRI isSideReady(side) : bReady
' Report whether the named wheel's running driver cog reports ready. The bSideCogRunning() guard is
' redundant but harmless since commit 67d11f6 (task 3533, PL-28): stop() now leaves drv_state at
' DCS_Unknown, so isReady() already answers FALSE on a stopped instance. It is kept.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bReady - TRUE when running and ready

    bReady := FALSE
    beat(CP_LIB_ISREADY)
    if bSideCogRunning(side)
        if side == SIDE_RIGHT                               ' if/else, never `? :` -- PL-29
            bReady := wheelR.isReady()
        else
            bReady := wheelL.isReady()
    beat(CP_LIB_ISREADY)

PRI isSideStopped(side) : bStopped
' Report whether the named wheel's running driver reports STOPPED (never a stale stopped cog). The
' bSideCogRunning() guard is redundant but harmless since commit 67d11f6 (task 3533, PL-28): stop()
' now leaves drv_state at DCS_Unknown, so isStopped() already answers FALSE on a stopped instance.
' It is kept.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bStopped - TRUE when running and STOPPED

    bStopped := FALSE
    beat(CP_LIB_ISSTOPPED)
    if bSideCogRunning(side)
        if side == SIDE_RIGHT                               ' if/else, never `? :` -- PL-29
            bStopped := wheelR.isStopped()
        else
            bStopped := wheelL.isStopped()
    beat(CP_LIB_ISSTOPPED)

PRI isSideFault(side) : bFaulted
' Report the named wheel's hub fault flag.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bFaulted - TRUE when the fault flag is set

    beat(CP_LIB_ISFAULT)
    if side == SIDE_RIGHT                                   ' if/else, never `? :` -- PL-29
        bFaulted := wheelR.isFaultSignal()
    else
        bFaulted := wheelL.isFaultSignal()
    beat(CP_LIB_ISFAULT)

PRI sideResetFault(side)
' testResetFault() the named wheel when its fault flag is set.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    beat(CP_LIB_RESETFAULT)
    if isSideFault(side)
        if side == SIDE_RIGHT
            wheelR.testResetFault()
        else
            wheelL.testResetFault()
    beat(CP_LIB_RESETFAULT)

PRI sideDriverState(side) : eDrvrState
' Driver state of the named wheel, DCS_Unknown when no cog is running.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns eDrvrState - DCS_* state

    eDrvrState := wheelL.DCS_Unknown
    beat(CP_LIB_DRVSTATE)
    if bSideCogRunning(side)
        if side == SIDE_RIGHT                               ' if/else, never `? :` -- PL-29
            eDrvrState := wheelR.getDriverState()
        else
            eDrvrState := wheelL.getDriverState()
    beat(CP_LIB_DRVSTATE)

PRI sideTelemetry(side) : nDuty, nErr, nSenseI, eDrvrState, bDidFault, bCogUp
' Snapshot telemetry, only from a running cog (PL-21).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns nDuty - duty
' @returns nErr - position error
' @returns nSenseI - sense_i_mV, true millivolts
' @returns eDrvrState - DCS_* state
' @returns bDidFault - fault flag
' @returns bCogUp - TRUE when the driver cog is running

    nDuty := 0
    nErr := 0
    nSenseI := 0
    eDrvrState := wheelL.DCS_Unknown
    bDidFault := FALSE
    bCogUp := bSideCogRunning(side)
    beat(CP_LIB_TELEMETRY)
    if bCogUp
        if side == SIDE_RIGHT
            nDuty, nErr, nSenseI, _, _, _, eDrvrState, bDidFault := wheelR.testGetTelemetry()
        else
            nDuty, nErr, nSenseI, _, _, _, eDrvrState, bDidFault := wheelL.testGetTelemetry()
    beat(CP_LIB_TELEMETRY)

PRI sidePhaseVoltages(side) : nSenseU, nSenseV, nSenseW
' Snapshot phase-voltage readings from the named wheel's driver (PL-30: offset source detection).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns nSenseU - phase-U sense_u_mV
' @returns nSenseV - phase-V sense_v_mV
' @returns nSenseW - phase-W sense_w_mV

    nSenseU := 0
    nSenseV := 0
    nSenseW := 0
    beat(CP_LIB_PHASEV)
    if bSideCogRunning(side)
        if side == SIDE_RIGHT
            _, _, _, nSenseU, nSenseV, nSenseW, _, _ := wheelR.testGetTelemetry()
        else
            _, _, _, nSenseU, nSenseV, nSenseW, _, _ := wheelL.testGetTelemetry()
    beat(CP_LIB_PHASEV)

PRI sideTicks(side) : nTicks
' Raw hall ticks of the named wheel.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns nTicks - hall-tick position

    beat(CP_LIB_TICKS)
    if side == SIDE_RIGHT                                   ' if/else, never `? :` -- PL-29
        nTicks := wheelR.getRawHallTicks()
    else
        nTicks := wheelL.getRawHallTicks()
    beat(CP_LIB_TICKS)

PRI sideIntegrity(side) : nMissed, nIllegal
' Hall integrity counts of the named wheel since its last start.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns nMissed - missed transitions
' @returns nIllegal - illegal hall codes

    beat(CP_LIB_INTEGRITY)
    if side == SIDE_RIGHT
        nMissed, nIllegal := wheelR.getHallIntegrityCounts()
    else
        nMissed, nIllegal := wheelL.getHallIntegrityCounts()
    beat(CP_LIB_INTEGRITY)

PRI sideSetOffsets(side, negDeg, posDeg)
' Apply both commutation offsets through the TEST-USE ONLY independent setter.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param negDeg - offset_fwd degrees (negative increments)
' @param posDeg - offset_rev degrees (positive increments)

    beat(CP_LIB_SETOFFSETS)
    if side == SIDE_RIGHT
        wheelR.testSetFwdRevIndep(negDeg, posDeg)
    else
        wheelL.testSetFwdRevIndep(negDeg, posDeg)
    beat(CP_LIB_SETOFFSETS)

PRI sideGetOffsets(side) : negDeg, posDeg
' Read both applied commutation offsets back.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns negDeg - offset_fwd degrees
' @returns posDeg - offset_rev degrees

    beat(CP_LIB_GETOFFSETS)
    if side == SIDE_RIGHT
        negDeg, posDeg := wheelR.testGetFwdRevIndep()
    else
        negDeg, posDeg := wheelL.testGetFwdRevIndep()
    beat(CP_LIB_GETOFFSETS)

PRI sideBoardType(side) : eBoardRev
' Board revision recorded at start.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns eBoardRev - REV_* value

    beat(CP_LIB_BOARDTYPE)
    if side == SIDE_RIGHT                                   ' if/else, never `? :` -- PL-29
        eBoardRev := wheelR.getBoardType()
    else
        eBoardRev := wheelL.getBoardType()
    beat(CP_LIB_BOARDTYPE)

PRI emitWatchdogStart(bStarted, cogIdRead)
' Emit BS-WDSTART: whether the watchdog cog (task 3534) started. A failure does not abort the
' run -- the scan's own current aborts, fault caps and time cap, plus the driver's own angle-lag
' fault, are still in force; only the watchdog's own stall detection is unavailable.
'
' @param bStarted - TRUE when cogspin() returned a valid cog id
' @param cogIdRead - cogspin()'s raw return value

    benchLog.begin(@"BS-WDSTART")
    benchLog.boolField(@"started", bStarted)
    benchLog.numField(@"cog", cogIdRead, LIM_TINY)
    lineEmit()

PRI emitHeaderRecords()
' Emit the run's identity, limits, plan and bands before anything moves.

    emitBanner()
    emitBuild()                                             ' task 3537: build variant, right after the banner
    emitSignoffDecls()                                      ' task 3537: every judged cell, before anything moves
    emitDrive()
    emitLimits()
    emitLimits2()
    emitPlanT()
    emitPlanS()
    emitBands()
    debug("* PANIC PROCEDURE IS PHYSICAL BATTERY DISCONNECT ONLY -- emergencyCutoff() is a software stop and is NOT a panic button")

PRI emitBanner()
' Emit BS-BANNER. cfg_id is sourced from its own #ifdef, never a runtime test: pnut-ts silently
' ignores an unknown -D, so a mistyped flag must land on the honest #else token.

    benchLog.begin(@"BS-BANNER")
    benchLog.numField(@"src_rev", SRC_REV, LIM_SMALL)
    benchLog.numField(@"fmt", FMT_VERSION, LIM_SMALL)
#ifdef BENCH_CFG
    benchLog.tokenField(@"cfg_id", @sCfgBench, TOKMAX_CFG)
#else
    benchLog.tokenField(@"cfg_id", @sCfgUser, TOKMAX_CFG)
#endif
    benchLog.tokenField(@"frame", @sFrameMotor, TOKMAX_FRAME)
    benchLog.numField(@"clkfreq", CLKFREQ, LIM_BIG)
    benchLog.numField(@"left_base", LEFT_TEST_BASE, LIM_SMALL)
    benchLog.numField(@"right_base", RIGHT_TEST_BASE, LIM_SMALL)
    benchLog.numField(@"voltage_enum", TEST_VOLTAGE, LIM_SMALL)
    benchLog.numField(@"det_mode", TEST_DET_MODE, LIM_SMALL)
    benchLog.numField(@"motor_type", user.MOTOR_TYPE, LIM_SMALL)
    benchLog.numField(@"def_neg_deg", DEF_NEG_DEG, LIM_SMALL)
    benchLog.numField(@"def_pos_deg", DEF_POS_DEG, LIM_SMALL)
    lineEmit()

PRI emitDrive()
' Emit BS-DRIVE: every increment this binary can command.

    benchLog.begin(@"BS-DRIVE")
    benchLog.numField(@"ceiling_incre", DRIVE_CEILING_INCRE, LIM_BIG)
    benchLog.numField(@"qtr_incre", QTR_SPEED_INCRE, LIM_BIG)
    benchLog.numField(@"half_incre", HALF_SPEED_INCRE, LIM_BIG)
    benchLog.numField(@"preflight_incre", PREFLIGHT_INCRE, LIM_BIG)
    benchLog.numField(@"jog_incre", JOG_INCRE, LIM_BIG)
    lineEmit()

PRI emitLimits()
' Emit BS-LIMITS: current and run caps.
'
' TASK 3595 ADDS THE DRIVER'S OWN FOLD-BACK LIMIT BESIDE THE HARNESS'S ABORT, because a fit can be
' ruined by a reading that was CAPPED rather than measured: if the driver folded current back on a
' high-lead point, that point reads lower than the motor actually drew, which flattens the arm of the
' parabola and drags the fitted minimum toward the cap.
'
' IT CANNOT HAPPEN HERE, AND THE FIELD IS WHAT SHOWS IT RATHER THAN ASSERTING IT. The driver folds
' back at I_PEAK_A amps; the harness aborts the point at ABS_ABORT_MV, which at the 150 mV/A this rig
' calibrates against is 10 A -- a quarter of the fold-back. The harness's own abort always fires
' first, by a factor of four, so no swept point can reach the cap. The limit is printed rather than
' converted here because the driver's own mV-to-amp scale is the board's sense resistor
' (rSenseForBoard) and is revision-dependent, so a flat factor written into this file would be a
' second, staler copy of a number that already has an owner. The reader compares the fold-back against
' the run's own worst i_max_mV.

    benchLog.begin(@"BS-LIMITS")
    benchLog.numField(@"abs_abort_mV", ABS_ABORT_MV, LIM_SMALL)
    benchLog.numField(@"fold_back_a", wheelL.I_PEAK_A, LIM_SMALL)
    benchLog.numField(@"abs_abort_samples", ABS_ABORT_SAMPLES, LIM_SMALL)
    benchLog.numField(@"point_abort_x100", POINT_ABORT_X100, LIM_SMALL)
    benchLog.numField(@"point_abort_ceil_mV", POINT_ABORT_CEIL_MV, LIM_SMALL)   ' 2026-09-22: the guard ordering, visible per run
    benchLog.numField(@"point_abort_samples", POINT_ABORT_SAMPLES, LIM_SMALL)
    benchLog.numField(@"run_time_cap_s", RUN_TIME_CAP_S, LIM_SMALL)
    benchLog.numField(@"run_charge_cap_mVs", RUN_CHARGE_CAP_MVS, LIM_MID)
    benchLog.numField(@"run_fault_cap", RUN_FAULT_CAP, LIM_SMALL)
    benchLog.numField(@"run_abort_i_cap", RUN_ABORT_I_CAP, LIM_SMALL)
    lineEmit()

PRI emitLimits2()
' Emit BS-LIMITS2: leg caps, hard limit, flag thresholds, and zero health checks.

    benchLog.begin(@"BS-LIMITS2")
    benchLog.numField(@"leg_fault_cap", LEG_FAULT_CAP, LIM_SMALL)
    benchLog.numField(@"side_fault_stop", SIDE_FAULT_STOP, LIM_SMALL)
    benchLog.numField(@"hard_limit_deg", HARD_LIMIT_DEG, LIM_SMALL)
    benchLog.numField(@"drift_flag_pct", DRIFT_FLAG_PCT, LIM_SMALL)
    benchLog.numField(@"imbalance_pct", IMBALANCE_PCT, LIM_SMALL)
    benchLog.numField(@"fault_rise_pct", FAULT_RISE_PCT, LIM_SMALL)
    benchLog.numField(@"zero_spread_max_mV", ZERO_SPREAD_MAX_MV, LIM_SMALL)
    benchLog.numField(@"zero_abs_max_mV", ZERO_ABS_MAX_MV, LIM_SMALL)
    lineEmit()

PRI emitPlanT()
' Emit BS-PLAN-T: timing and window sizes.

    benchLog.begin(@"BS-PLAN-T")
    benchLog.numField(@"sample_ms", SAMPLE_MS, LIM_SMALL)
    benchLog.numField(@"settle_ms", SETTLE_MS, LIM_SMALL)
    benchLog.numField(@"steady_timeout_ms", STEADY_TIMEOUT_MS, LIM_SMALL)
    benchLog.numField(@"stop_timeout_ms", STOP_TIMEOUT_MS, LIM_SMALL)
    benchLog.numField(@"rest_ms", REST_MS, LIM_SMALL)
    benchLog.numField(@"fault_cool_ms", FAULT_COOL_MS, LIM_SMALL)
    benchLog.numField(@"jog_ms", JOG_MS, LIM_SMALL)
    benchLog.numField(@"batch_ticks", BATCH_TICKS, LIM_SMALL)
    benchLog.numField(@"win_ticks_coarse", WIN_TICKS_COARSE, LIM_SMALL)
    benchLog.numField(@"win_ticks_fine", WIN_TICKS_FINE, LIM_SMALL)
    benchLog.numField(@"win_ticks_self", WIN_TICKS_SELF, LIM_SMALL)
    benchLog.numField(@"win_ticks_half", WIN_TICKS_HALF, LIM_SMALL)
    lineEmit()

PRI emitPlanS()
' Emit BS-PLAN-S: sweep geometry.

    benchLog.begin(@"BS-PLAN-S")
    benchLog.numField(@"coarse_step_deg", COARSE_STEP_DEG, LIM_SMALL)
    benchLog.numField(@"fine_step_deg", FINE_STEP_DEG, LIM_SMALL)
    benchLog.numField(@"cliff_half_step_deg", CLIFF_HALF_STEP_DEG, LIM_SMALL)
    benchLog.numField(@"fine_half_deg", FINE_HALF_DEG, LIM_SMALL)
    benchLog.numField(@"extend_pts", EXTEND_PTS, LIM_SMALL)
    benchLog.numField(@"confirm_half_deg", CONFIRM_HALF_DEG, LIM_SMALL)
    benchLog.numField(@"confirm_extend_pts", CONFIRM_EXTEND_PTS, LIM_SMALL)
    benchLog.numField(@"rise_pct", RISE_PCT, LIM_SMALL)
    benchLog.numField(@"min_past", MIN_PAST, LIM_SMALL)
    benchLog.numField(@"fit_min_pts", FIT_MIN_PTS, LIM_SMALL)
    benchLog.numField(@"confirm_min_pts", CONFIRM_MIN_PTS, LIM_SMALL)
    lineEmit()

PRI emitBands()
' Emit BS-BANDS: the self-check tolerance bands (raw and net-of-zero).

    benchLog.begin(@"BS-BANDS")
    benchLog.numField(@"pos_qtr_lo_mV", POS_QTR_LO_MV, LIM_SMALL)
    benchLog.numField(@"pos_qtr_hi_mV", POS_QTR_HI_MV, LIM_SMALL)
    benchLog.numField(@"neg_qtr_lo_mV", NEG_QTR_LO_MV, LIM_SMALL)
    benchLog.numField(@"neg_qtr_hi_mV", NEG_QTR_HI_MV, LIM_SMALL)
    benchLog.numField(@"ratio_lo_x1000", RATIO_LO_X1000, LIM_SMALL)
    benchLog.numField(@"ratio_hi_x1000", RATIO_HI_X1000, LIM_SMALL)
    benchLog.numField(@"zero_lo_mV", ZERO_LO_MV, LIM_SMALL)
    benchLog.numField(@"zero_hi_mV", ZERO_HI_MV, LIM_SMALL)
    benchLog.numField(@"rate_qtr_lo", RATE_QTR_LO, LIM_SMALL)
    benchLog.numField(@"rate_qtr_hi", RATE_QTR_HI, LIM_SMALL)
    benchLog.numField(@"rate_half_lo", RATE_HALF_LO, LIM_SMALL)
    benchLog.numField(@"rate_half_hi", RATE_HALF_HI, LIM_SMALL)
    ' Net-of-zero bands for self-check (scan v3.1): raw bands minus Pass 1's 9 mV intercept
    benchLog.numField(@"pos_qtr_net_lo_mV", POS_QTR_NET_LO_MV, LIM_SMALL)
    benchLog.numField(@"pos_qtr_net_hi_mV", POS_QTR_NET_HI_MV, LIM_SMALL)
    benchLog.numField(@"neg_qtr_net_lo_mV", NEG_QTR_NET_LO_MV, LIM_SMALL)
    benchLog.numField(@"neg_qtr_net_hi_mV", NEG_QTR_NET_HI_MV, LIM_SMALL)
    lineEmit()

PRI emitPreflight(side, ticksMoved)
' Emit BS-PREFLIGHT.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param ticksMoved - signed tick delta across the nudge

    benchLog.begin(@"BS-PREFLIGHT")
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"base", (side == SIDE_RIGHT) ? RIGHT_TEST_BASE : LEFT_TEST_BASE, LIM_SMALL)
    benchLog.numField(@"ticks", ticksMoved, LIM_SMALL)
    benchLog.boolField(@"moved", (ticksMoved <> 0))
    lineEmit()

PRI emitStart(side, startedCog, bCogOk, eBoardRev, bRevB, initNeg, initPos, readNeg, readPos, ...
    bOffsetsOk, nMissed, nIllegal, bIntegOk, bStartOk)
' Emit BS-START.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param startedCog - start()'s return
' @param bCogOk - cog id in 0..7
' @param eBoardRev - REV_* recorded at start
' @param bRevB - board is Rev B
' @param initNeg - offset_fwd degrees init() applied
' @param initPos - offset_rev degrees init() applied
' @param readNeg - offset_fwd read back after setting 43
' @param readPos - offset_rev read back after setting 317
' @param bOffsetsOk - read-back is exactly 43/317
' @param nMissed - missed transitions since start
' @param nIllegal - illegal hall codes since start
' @param bIntegOk - no illegal code at start
' @param bStartOk - every start check passed

    benchLog.begin(@"BS-START")
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"base", (side == SIDE_RIGHT) ? RIGHT_TEST_BASE : LEFT_TEST_BASE, LIM_TINY)
    benchLog.numField(@"cog", startedCog, LIM_TINY)
    benchLog.boolField(@"cog_ok", bCogOk)
    benchLog.numField(@"board_rev", eBoardRev, LIM_TINY)
    benchLog.boolField(@"rev_b", bRevB)
    benchLog.tokenField(@"board_id", boardToken(eBoardRev), TOKMAX_BOARD)
    benchLog.numField(@"init_neg_deg", initNeg, LIM_TINY)
    benchLog.numField(@"init_pos_deg", initPos, LIM_TINY)
    benchLog.numField(@"neg_deg", readNeg, LIM_TINY)
    benchLog.numField(@"pos_deg", readPos, LIM_TINY)
    benchLog.boolField(@"offsets_ok", bOffsetsOk)
    benchLog.numField(@"missed", nMissed, LIM_SMALL)
    benchLog.numField(@"illegal", nIllegal, LIM_SMALL)
    benchLog.boolField(@"integ_ok", bIntegOk)
    benchLog.tokenField(@"result", bStartOk ? @sOk : @sFail, TOKMAX_OKFAIL)
    lineEmit()

PRI emitZero(side, phaseTag, sampleCnt, meanX10, minMv, maxMv, bFrozen, bInBand, bValid, bHealthOk, ...
    senseUmeanX10, senseVmeanX10, senseWmeanX10)
' Emit BS-ZERO.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param phaseTag - PH_* of the point this zero precedes (any phase, scan v3), or PH_ZERO_INIT
'   for the motor-block's own check
' @param sampleCnt - samples taken
' @param meanX10 - mean sense x10
' @param minMv - smallest sample
' @param maxMv - largest sample
' @param bFrozen - min equals max
' @param bInBand - mean inside the zero band (informational, backward compatibility)
' @param bValid - at least one sample
' @param bHealthOk - this zero's own health verdict (not frozen, spread ok, absolute ok); printed
'   only for PH_ZERO_INIT, the one phase that computes it -- every other phase prints NA (fmt 7,
'   PL-34). Worst case unchanged: NA is shorter than FALSE.
' @param senseUmeanX10 - mean phase-U voltage x10, mV
' @param senseVmeanX10 - mean phase-V voltage x10, mV
' @param senseWmeanX10 - mean phase-W voltage x10, mV

    benchLog.begin(@"BS-ZERO")
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"phase", phaseToken(phaseTag), TOKMAX_PHASE)
    benchLog.numField(@"samples", sampleCnt, LIM_SMALL)
    benchLog.naNumField(@"i_mean_mV_x10", meanX10, LIM_SMALL, bValid)
    benchLog.naNumField(@"i_min_mV", minMv, LIM_SMALL, bValid)
    benchLog.naNumField(@"i_max_mV", maxMv, LIM_SMALL, bValid)
    benchLog.boolField(@"frozen", bFrozen and bValid)
    benchLog.boolField(@"in_band", bInBand)
    if phaseTag == PH_ZERO_INIT
        benchLog.boolField(@"health_ok", bHealthOk)
    else
        benchLog.textField(@"health_ok", @sNa)
    ' Phase voltages to help locate the offset source (PL-30)
    benchLog.naNumField(@"u_mV_x10", senseUmeanX10, LIM_SMALL, bValid)
    benchLog.naNumField(@"v_mV_x10", senseVmeanX10, LIM_SMALL, bValid)
    benchLog.naNumField(@"w_mV_x10", senseWmeanX10, LIM_SMALL, bValid)
    lineEmit()

PRI emitPoint(side, speedIdx, motorIncre, ptPhase, sweptDeg)
' Emit BS-POINT from the point record.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - SPEED_QTR or SPEED_HALF
' @param motorIncre - signed increment
' @param ptPhase - PH_* of the point
' @param sweptDeg - signed swept offset

    benchLog.begin(@"BS-POINT")
    benchLog.numField(@"seq", pointSeq, LIM_TINY)
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"speed", speedToken(speedIdx), TOKMAX_SPEED)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.tokenField(@"phase", phaseToken(ptPhase), TOKMAX_PHASE)
    benchLog.numField(@"neg_deg", ptNegDeg, LIM_TINY)
    benchLog.numField(@"pos_deg", ptPosDeg, LIM_TINY)
    benchLog.numField(@"swept_deg", sweptDeg, LIM_TINY)
    benchLog.tokenField(@"result", resultToken(ptResult), TOKMAX_RESULT)
    benchLog.naNumField(@"steady_ms", ptSteadyMs, LIM_SMALL, bPtCommanded)
    benchLog.naNumField(@"ticks", ptTicks, LIM_SMALL, bPtWinRan)
    benchLog.naNumField(@"win_ms", ptWinMs, LIM_SMALL, bPtWinRan)
    benchLog.naNumField(@"rate_x10", ptRateX10, LIM_SMALL, bPtWinRan)
    benchLog.boolField(@"rate_ok", bPtRateOk)
    benchLog.naNumField(@"samples", ptSamples, LIM_SMALL, bPtWinRan)
    benchLog.naNumField(@"i_mean_mV_x10", ptMeanX10, LIM_SMALL, bPtWinRan and (ptSamples > 0))
    benchLog.naNumField(@"i_se_mV_x10", ptSeX10, LIM_SMALL, bPtSeValid)
    lineEmit()

PRI emitPoint2(side, motorIncre)
' Emit BS-POINT2 from the point record. Restored to its exact v3.1 field list: scan v4 first
' appended zero_mV_x10/net_mV_x10 here, but that pushed this record's own worst case (every
' clamp at its documented maximum simultaneously) to ~314 bytes, past the 280-byte bound the
' header comment states -- 280 is the longest record measured intact through one debug(zstr_())
' line, a hard limit, not a style note. Those two fields now live in the new BS-POINT3 record
' (emitPoint3(), emitted immediately after this one -- see measurePoint()) instead.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment

    benchLog.begin(@"BS-POINT2")
    benchLog.numField(@"seq", pointSeq, LIM_TINY)
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.naNumField(@"i_halfA_mV_x10", ptHalfAX10, LIM_SMALL, bPtHalvesValid)
    benchLog.naNumField(@"i_halfB_mV_x10", ptHalfBX10, LIM_SMALL, bPtHalvesValid)
    benchLog.boolField(@"unsettled", bPtUnsettled)
    benchLog.naNumField(@"i_min_mV", ptMinMv, LIM_SMALL, ptSamples > 0)
    benchLog.naNumField(@"i_max_mV", ptMaxMv, LIM_SMALL, ptSamples > 0)
    benchLog.naNumField(@"duty_mean", ptDutyMean, LIM_SMALL, ptSamples > 0)
    benchLog.naNumField(@"err_mean", ptErrMean, LIM_TINY, ptSamples > 0)
    benchLog.naNumField(@"missed_d", ptMissedD, LIM_SMALL, bPtIntegValid)
    benchLog.naNumField(@"illegal_d", ptIllegalD, LIM_SMALL, bPtIntegValid)
    benchLog.boolField(@"fault", bSampFaultSeen)
    benchLog.boolField(@"abort_i", bSampPointAbort)
    benchLog.numField(@"charge_mVs", ptChargeMvS, LIM_MID)
    benchLog.numField(@"drv_state", sampState, LIM_TINY)
    lineEmit()

PRI emitPoint3(side)
' Emit BS-POINT3, new in scan v4 (fmt 6): this point's own zero and net mean, split out of
' BS-POINT2 to keep that record under the 280-byte bound (see emitPoint2()). Emitted immediately
' after BS-POINT2 for the same point (measurePoint() calls both back to back), so the two are
' always adjacent in the log for a given seq/motor. Worst case (every clamp at its documented
' maximum): tag(9) + seq(1+3+1+4=9) + motor(1+5+1+5=12) + zero_mV_x10(1+11+1+7=20) +
' net_mV_x10(1+10+1+7=19) = 69 bytes, well under the 280-byte bound.
'
' TASK 3595 APPENDS THE DRIVE-SPAN READINGS HERE, and here rather than in a sixth record because
' this one had the room: + span_ms(1+7+1+7=16) + span_rate_x10(1+13+1+7=22) + follow_pct(1+10+1+7=19)
' + duty_mean(1+9+1+7=18) + duty_max(1+8+1+7=17) = 92, for 161 bytes. Still well under 280.
'
' NOTE -- THESE FIVE ARE PRESENT ON EVERY COMMANDED POINT, WHATEVER ITS RESULT. That is the whole reason
' they exist: BS-POINT's ticks / win_ms / rate_x10 / samples all gate on bPtWinRan, and the window
' only runs once a point has reached AT_SPEED -- so run 7's log carries rate_x10,NA at all 19 of its
' 19 non-OK points (MEASURED, debug_260914-114703.log). The boundary points, the only ones that say
' where the drive gave up, were the exact points the instrument measured nothing about.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    benchLog.begin(@"BS-POINT3")
    benchLog.numField(@"seq", pointSeq, LIM_TINY)
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.naNumField(@"zero_mV_x10", ptZeroX10, LIM_SMALL, bPtZeroValid)
    benchLog.naNumField(@"net_mV_x10", ptNetX10, LIM_SMALL, (ptSamples > 0) and bPtZeroValid)   ' no zero, no net: never print a raw mean under a net label
    benchLog.naNumField(@"span_ms", spanDriveMs, LIM_SMALL, bPtSpanValid)
    benchLog.naNumField(@"span_rate_x10", ptSpanRateX10, LIM_SMALL, bPtSpanValid)
    benchLog.naNumField(@"follow_pct", ptFollowPct, LIM_SMALL, bPtSpanValid)
    benchLog.naNumField(@"span_duty_mean", ptSpanDutyMean, LIM_SMALL, bPtSpanValid)
    benchLog.naNumField(@"span_duty_max", ptSpanDutyMax, LIM_SMALL, bPtSpanValid)
    lineEmit()

PRI emitRstAlone(side) | slotIdx
' Emit BS-RSTALONE (task 3537 phase 2b3, fmt 9): this motor's one testResetFault()-alone attempt, from
' the per-motor facts measurePoint() kept. Emitted right after BS-POINT3 of the faulted point, never
' inside its timed part.
' Worst case: tag(11) + motor(1+5+1+5=12) + swept_deg(1+9+1+4=15) + incre(1+5+1+12=19) +
' ms(1+2+1+7=11) + stopped(1+7+1+5=14) + fault(1+5+1+5=12) + cleared(1+7+1+5=14) = 108 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
'
' @local slotIdx - sideSlot(side)

    slotIdx := sideSlot(side)
    benchLog.begin(@"BS-RSTALONE")
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"swept_deg", rstAloneSwept[slotIdx], LIM_TINY)
    benchLog.numField(@"incre", rstAloneIncre[slotIdx], LIM_BIG)
    benchLog.numField(@"ms", rstAloneMs[slotIdx], LIM_SMALL)
    benchLog.boolField(@"stopped", bRstAloneStopped[slotIdx])
    benchLog.boolField(@"fault", bRstAloneFault[slotIdx])
    benchLog.boolField(@"cleared", bRstAloneCleared[slotIdx])
    lineEmit()

PRI emitCheck(side, motorIncre, loMv, hiMv, bIOk, bRateOk, bIntegOk, bFaultOk, ...
    netLoMv, netHiMv, netMeanX10)
' Emit BS-CHECK for one self-check point (scan v3.1: adds net-of-zero band and mean).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param loMv - raw band low (informational)
' @param hiMv - raw band high (informational)
' @param bIOk - net current in band (verdict)
' @param bRateOk - rate in band
' @param bIntegOk - no hall integrity events
' @param bFaultOk - completed without fault
' @param netLoMv - net band low
' @param netHiMv - net band high
' @param netMeanX10 - net mean x10, mV (raw mean minus ZERO_INIT)

    benchLog.begin(@"BS-CHECK")
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"lo_mV", loMv, LIM_SMALL)
    benchLog.numField(@"hi_mV", hiMv, LIM_SMALL)
    benchLog.boolField(@"i_ok", bIOk)
    benchLog.boolField(@"rate_ok", bRateOk)
    benchLog.boolField(@"integ_ok", bIntegOk)
    benchLog.boolField(@"fault_ok", bFaultOk)
    ' Net-of-zero bands and mean (scan v3.1)
    benchLog.numField(@"net_lo_mV", netLoMv, LIM_SMALL)
    benchLog.numField(@"net_hi_mV", netHiMv, LIM_SMALL)
    benchLog.numField(@"net_mean_mV_x10", netMeanX10, LIM_SMALL)
    lineEmit()

PRI emitChecksum(side, bStartOk, bZeroPass, bPosIOk, bNegIOk, ratioX1000, bRatioOk, bRateOk, bIntegOk, ...
    bFaultOk, bPassed, missCode)
' Emit BS-CHECKSUM, the self-check verdict.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param bStartOk - start checks passed
' @param bZeroPass - zero in band
' @param bPosIOk - +1/4 current in band
' @param bNegIOk - -1/4 current in band
' @param ratioX1000 - negative/positive ratio x1000
' @param bRatioOk - ratio in band
' @param bRateOk - both rates in band
' @param bIntegOk - no hall integrity events
' @param bFaultOk - no fault
' @param bPassed - every check passed
' @param missCode - MISS_* first miss

    benchLog.begin(@"BS-CHECKSUM")
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.boolField(@"start_ok", bStartOk)
    benchLog.boolField(@"zero_ok", bZeroPass)
    benchLog.boolField(@"pos_i_ok", bPosIOk)
    benchLog.boolField(@"neg_i_ok", bNegIOk)
    benchLog.numField(@"ratio_x1000", ratioX1000, LIM_SMALL)
    benchLog.boolField(@"ratio_ok", bRatioOk)
    benchLog.boolField(@"rate_ok", bRateOk)
    benchLog.boolField(@"integ_ok", bIntegOk)
    benchLog.boolField(@"fault_ok", bFaultOk)
    benchLog.tokenField(@"verdict", bPassed ? @sVerdictPass : @sVerdictFail, TOKMAX_VERDICT)
    benchLog.tokenField(@"first_miss", missToken(missCode), TOKMAX_MISS)
    lineEmit()

PRI emitWalk(side, speedIdx, signIdx, walkDir, nPts, lastSwept, walkStop)
' Emit BS-WALK for one coarse side.
'
' The rung is a PARAMETER, not a constant. It was briefly hardcoded to the walking rung, from when
' that was the only rung that walked -- and the 2026-09-21 19:26 run shows what that cost: all ten
' BS-WALK rows read `speed,LOW` though four of them were quarter-rung walks. A record that names the
' wrong rung is worse than one that names none, because it will be believed.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - the rung that performed this walk
' @param signIdx - SIGN_NEG or SIGN_POS
' @param walkDir - +1 up, -1 down
' @param nPts - points measured on this side
' @param lastSwept - last swept offset measured
' @param walkStop - WS_* stop reason

    benchLog.begin(@"BS-WALK")
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"speed", speedToken(speedIdx), TOKMAX_SPEED)
    benchLog.tokenField(@"sign", signToken(signIdx), TOKMAX_SIGN)
    benchLog.tokenField(@"side", (walkDir > 0) ? @sSideUp : @sSideDown, TOKMAX_WALK_SIDE)
    benchLog.numField(@"pts", nPts, LIM_TINY)
    benchLog.numField(@"last_swept_deg", lastSwept, LIM_TINY)
    benchLog.tokenField(@"stop", walkStopToken(walkStop), TOKMAX_WALK_STOP)
    benchLog.naNumField(@"low_swept_deg", lowDegOrZero(), LIM_TINY, legLowIdx >= 0)
    benchLog.naNumField(@"low_mV_x10", lowMeanOrZero(), LIM_SMALL, legLowIdx >= 0)
    benchLog.naNumField(@"low_net_mV_x10", lowNetOrZero(), LIM_SMALL, legLowIdx >= 0)  ' task 3540 D5
    lineEmit()

PRI emitBracket(side, speedIdx, signIdx, bBelowOk, bAboveOk, bBracketed, reason)
' Emit BS-BRACKET.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - the rung whose walk this bracket judges
' @param signIdx - SIGN_NEG or SIGN_POS
' @param bBelowOk - high point below the low exists
' @param bAboveOk - high point above the low exists
' @param bBracketed - both exist
' @param reason - BR_* verdict

    benchLog.begin(@"BS-BRACKET")
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"speed", speedToken(speedIdx), TOKMAX_SPEED)   ' every rung walks; name the one that did
    benchLog.tokenField(@"sign", signToken(signIdx), TOKMAX_SIGN)
    benchLog.naNumField(@"low_swept_deg", lowDegOrZero(), LIM_TINY, legLowIdx >= 0)
    benchLog.naNumField(@"low_mV_x10", lowMeanOrZero(), LIM_SMALL, legLowIdx >= 0)
    benchLog.boolField(@"below_ok", bBelowOk)
    benchLog.boolField(@"above_ok", bAboveOk)
    benchLog.boolField(@"bracketed", bBracketed)
    benchLog.tokenField(@"reason", bracketToken(reason), TOKMAX_BRACKET)
    benchLog.naNumField(@"low_net_mV_x10", lowNetOrZero(), LIM_SMALL, legLowIdx >= 0)  ' task 3540 D5
    lineEmit()

PRI lowDegOrZero() : lowDeg
' Swept offset of the leg's low point, 0 when there is none.
'
' @returns lowDeg - swept degrees

    lowDeg := 0
    if legLowIdx >= 0
        lowDeg := legDeg[legLowIdx]

PRI lowMeanOrZero() : lowMeanX10
' Mean sense of the leg's low point x10, 0 when there is none.
'
' @returns lowMeanX10 - mean sense x10

    lowMeanX10 := 0
    if legLowIdx >= 0
        lowMeanX10 := legMeanX10[legLowIdx]

PRI lowNetOrZero() : lowNetX10
' Task 3540 D5: net sense of the leg's low point x10 (the figure lowMeanOrZero()'s raw mean is
' printed under a neutral name beside), 0 when there is none.
'
' @returns lowNetX10 - net sense x10

    lowNetX10 := 0
    if legLowIdx >= 0
        lowNetX10 := legNetX10[legLowIdx]

PRI emitFit(side, speedIdx, signIdx)
' Emit BS-FIT: status and span of the fit record. CHANGE 1 (scan v3): pinned, appended at the end,
' is TRUE when the vertex sits within one FINE_STEP_DEG of a fault-derived window limit -- a
' minimum pinned against a fault edge, which bFitPinnedNearLimit() must never report as free.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - SPEED_QTR or SPEED_HALF
' @param signIdx - SIGN_NEG or SIGN_POS

    benchLog.begin(@"BS-FIT")
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"speed", speedToken(speedIdx), TOKMAX_SPEED)
    benchLog.tokenField(@"sign", signToken(signIdx), TOKMAX_SIGN)
    benchLog.tokenField(@"status", fitToken(fitStatus), TOKMAX_FIT)
    benchLog.numField(@"n", fitN, LIM_TINY)
    benchLog.naNumField(@"centre_deg", fitCentre, LIM_TINY, fitStatus <> FS_SKIPPED and fitStatus <> FS_NOT_BRACKETED)
    benchLog.naNumField(@"span_lo_deg", fitSpanLo, LIM_TINY, fitN > 0)
    benchLog.naNumField(@"span_hi_deg", fitSpanHi, LIM_TINY, fitN > 0)
    benchLog.boolField(@"extended", bFitExtended)
    benchLog.boolField(@"pinned", bFitPinnedNearLimit())
    lineEmit()

PRI emitFit2(side, speedIdx, signIdx) | bSolved
' Emit BS-FIT2: the fitted numbers. Scan v4 CHANGE 2: min_mV_x10 and rms_mV_x10 are now fitted
' from NET means (fitLeg() fits legNetX10), so they read net of each point's own zero -- same
' field names, same position, different (corrected) units basis.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - SPEED_QTR or SPEED_HALF
' @param signIdx - SIGN_NEG or SIGN_POS
'
' @local bSolved - TRUE when a convex vertex was solved

    bSolved := bFitSolved
    benchLog.begin(@"BS-FIT2")
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"speed", speedToken(speedIdx), TOKMAX_SPEED)
    benchLog.tokenField(@"sign", signToken(signIdx), TOKMAX_SIGN)
    benchLog.naNumField(@"min_deg_x10", floatToBoundedInt(fitMinF *. 10.0, LIM_SMALL), LIM_SMALL, bSolved)
    benchLog.naNumField(@"min_se_deg_x10", floatToBoundedInt(fitSeF *. 10.0, LIM_SMALL), LIM_SMALL, bSolved and bFitSeValid)
    benchLog.naNumField(@"min_mV_x10", floatToBoundedInt(fitMinMvF *. 10.0, LIM_SMALL), LIM_SMALL, bSolved)
    benchLog.naNumField(@"rms_mV_x10", floatToBoundedInt(fitRmsF *. 10.0, LIM_SMALL), LIM_SMALL, bSolved)
    benchLog.naNumField(@"med_se_mV_x10", fitMedSeX10, LIM_SMALL, fitN > 0)
    benchLog.naNumField(@"curv_x100", floatToBoundedInt(fitCurvF *. 100.0, LIM_MID), LIM_MID, fitN > FIT_PARAMS)
    benchLog.naNumField(@"curv_model_pct", curvModelPct(), LIM_SMALL, bSolved and (fitMinMvF >. 0.0))
    benchLog.naNumField(@"flat2_deg_x10", flatHalfWidthX10(), LIM_SMALL, bSolved and (fitMinMvF >. 0.0))
    lineEmit()

PRI curvModelPct() : modelPct
' Fitted curvature as a percentage of the 1/cos law's curvature at the fitted minimum.
'
' @returns modelPct - percent, 0 when undefined

    modelPct := 0
    if bFitSolved and (fitMinMvF >. 0.0)
        modelPct := floatToBoundedInt((fitCurvF /. (fitMinMvF *. FIT_MODEL_CURV)) *. 100.0, LIM_SMALL)

PRI flatHalfWidthX10() : halfWidthX10
' Half-width, degrees x10, over which the fit stays within FIT_FLAT_FRACTION of its minimum.
'
' @returns halfWidthX10 - degrees x10, 0 when undefined

    halfWidthX10 := 0
    if bFitSolved and (fitMinMvF >. 0.0) and (fitCurvF >. 0.0)
        halfWidthX10 := floatToBoundedInt(fsqrt((FIT_FLAT_FRACTION *. fitMinMvF) /. fitCurvF) *. FIT_DEG_SCALE *. 10.0, LIM_SMALL)

PRI emitCliff(side, speedIdx, signIdx) | bFromFit, edgeF, refF, marginF, edgeX10, marginX10, bMarginValid, edgeResX10
' Emit BS-CLIFF: the fault edge nearest the hall electrical zero for this leg (PL-31), and its
' margin to the fitted minimum, or, when there is no fit, to the lowest measured point.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - SPEED_QTR or SPEED_HALF
' @param signIdx - SIGN_NEG or SIGN_POS
'
' @local bFromFit - TRUE when the margin is measured from the fitted minimum
' @local edgeF - edge estimate, degrees (midpoint of last-good and first-fault)
' @local refF - reference offset for the margin, degrees
' @local marginF - |edge - reference|, degrees
' @local edgeX10 - edge estimate x10
' @local marginX10 - margin x10
' @local bMarginValid - TRUE when a reference offset exists to measure the margin from
' @local edgeResX10 - task 3540 D4: the edge estimate's own +/- resolution x10 (half the good/fault
'   gap it was resolved from), reported beside margin_deg_x10 -- an EDGE verdict at quarter speed
'   used to turn on 0.05 deg unstated (SCAN-RUN-7-EVALUATION.md sec 5 item 4)

    bFromFit := legCliffFound and bFitSolved
    edgeF := 0.0
    marginF := 0.0
    bMarginValid := FALSE
    if legCliffFound
        edgeF := float(legCliffGoodDeg + legCliffFaultDeg) /. 2.0
        if bFitSolved
            refF := fitMinF
            bMarginValid := TRUE
        elseif legLowIdx >= 0
            refF := float(legDeg[legLowIdx])
            bMarginValid := TRUE
        if bMarginValid
            marginF := fabs(edgeF -. refF)
    edgeX10 := floatToBoundedInt(edgeF *. 10.0, LIM_SMALL)
    marginX10 := floatToBoundedInt(marginF *. 10.0, LIM_SMALL)
    edgeResX10 := 0
    if legCliffFound
        edgeResX10 := floatToBoundedInt((float(legCliffFaultDeg - legCliffGoodDeg) /. 2.0) *. 10.0, LIM_SMALL)
    benchLog.begin(@"BS-CLIFF")
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"speed", speedToken(speedIdx), TOKMAX_SPEED)
    benchLog.tokenField(@"sign", signToken(signIdx), TOKMAX_SIGN)
    benchLog.boolField(@"found", legCliffFound)
    benchLog.naNumField(@"last_good_deg", legCliffGoodDeg, LIM_TINY, legCliffFound)
    benchLog.naNumField(@"first_fault_deg", legCliffFaultDeg, LIM_TINY, legCliffFound)
    benchLog.naNumField(@"edge_deg_x10", edgeX10, LIM_SMALL, legCliffFound)
    benchLog.naNumField(@"margin_deg_x10", marginX10, LIM_SMALL, legCliffFound and bMarginValid)
    benchLog.boolField(@"margin_from_fit", bFromFit)
    benchLog.naNumField(@"edge_res_deg_x10", edgeResX10, LIM_SMALL, legCliffFound)  ' task 3540 D4, new field at the end
    lineEmit()

PRI emitFault(side, motorIncre, sweptDeg, fxStep, bCleared)
' Emit BS-FAULT for one recovery step.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - increment of the faulted point
' @param sweptDeg - swept offset of the faulted point
' @param fxStep - FX_* step
' @param bCleared - TRUE when the wheel is stopped with no fault after this step

    benchLog.begin(@"BS-FAULT")
    benchLog.numField(@"seq", pointSeq, LIM_TINY)
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"swept_deg", sweptDeg, LIM_TINY)
    benchLog.numField(@"drv_state", sideDriverState(side), LIM_TINY)
    benchLog.tokenField(@"step", stepToken(fxStep), TOKMAX_STEP)
    benchLog.boolField(@"cleared", bCleared)
    benchLog.numField(@"consec", legConsecFaults, LIM_TINY)
    benchLog.numField(@"run_faults", runFaults, LIM_TINY)
    lineEmit()

PRI emitLeg(side, speedIdx, signIdx, legExit, refEndIdx, driftPctX10, bDriftValid, bDrift)
' Emit BS-LEG.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - SPEED_QTR or SPEED_HALF
' @param signIdx - SIGN_NEG or SIGN_POS
' @param legExit - LX_* exit
' @param refEndIdx - leg index of REF_END, -1 when not measured
' @param driftPctX10 - drift percent x10
' @param bDriftValid - both references valid
' @param bDrift - drift beyond DRIFT_FLAG_PCT

    benchLog.begin(@"BS-LEG")
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"speed", speedToken(speedIdx), TOKMAX_SPEED)
    benchLog.tokenField(@"sign", signToken(signIdx), TOKMAX_SIGN)
    benchLog.tokenField(@"served_by", servedToken(signIdx), TOKMAX_SERVED)
    benchLog.numField(@"pts", legCount, LIM_TINY)
    benchLog.numField(@"faults", legFaults, LIM_TINY)
    benchLog.numField(@"aborts_i", legAbortsI, LIM_TINY)
    benchLog.naNumField(@"ref_start_mV_x10", refStartMeanOrZero(), LIM_SMALL, isValidIdx(0) and (legPhase[0] == PH_REF_START))
    benchLog.naNumField(@"ref_end_mV_x10", refEndMeanOrZero(refEndIdx), LIM_SMALL, isValidIdx(refEndIdx))
    benchLog.naNumField(@"drift_pct_x10", driftPctX10, LIM_SMALL, bDriftValid)
    benchLog.boolField(@"drift_flag", bDrift)
    benchLog.tokenField(@"exit", legExitToken(legExit), TOKMAX_LEG_EXIT)
    benchLog.naNumField(@"ref_start_net_mV_x10", refStartNetOrZero(), LIM_SMALL, isValidIdx(0) and (legPhase[0] == PH_REF_START))  ' task 3540 D5
    benchLog.naNumField(@"ref_end_net_mV_x10", refEndNetOrZero(refEndIdx), LIM_SMALL, isValidIdx(refEndIdx))                       ' task 3540 D5
    lineEmit()
    emitArc(side, speedIdx, signIdx)                        ' task 3595: the arc reached, and what bounded each end

PRI emitArc(side, speedIdx, signIdx) | arcDeg
' Emit BS-ARC (task 3595): the arc this leg actually reached, and the boundary TYPE at each end.
'
' THE POINT OF THE RECORD IS THAT A SWEEP REPORTS AN ARC, NOT A PASS. The reachable arc is bounded by
' the motor and not by the instrument, and its two ends are bounded by different physics: too much
' lead explodes the current, too little cannot make the torque. Run 7 measured both on every leg
' (debug_260914-114703.log) -- ABORT_I at swept +/-63 on both motors in both directions, and FAULT
' from +7 down to -11 on the LEFT positive leg -- leaving the LEFT negative leg a clean run from +8 to
' +53. That is 45 electrical degrees of 360, and a report that did not say so let a reader believe the
' sweep had covered the circle.
'
' arc_deg is 0 rather than NA when no valid point was reached: the leg ran and reached nothing, which
' is a measurement of zero arc, not an absence of measurement. bounded_by tells them apart -- an arc
' of 0 with both ends NONE is a leg that never got going.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param speedIdx - SPEED_QTR or SPEED_HALF
' @param signIdx - SIGN_NEG or SIGN_POS
'
' @local arcDeg - the reached span in electrical degrees

    arcDeg := 0
    if bLegArcValid
        arcDeg := legArcHiDeg - legArcLoDeg
    benchLog.begin(@"BS-ARC")
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"speed", speedToken(speedIdx), TOKMAX_SPEED)
    benchLog.tokenField(@"sign", signToken(signIdx), TOKMAX_SIGN)
    benchLog.naNumField(@"arc_lo_deg", legArcLoDeg, LIM_TINY, bLegArcValid)
    benchLog.naNumField(@"arc_hi_deg", legArcHiDeg, LIM_TINY, bLegArcValid)
    benchLog.numField(@"arc_deg", arcDeg, LIM_TINY)
    benchLog.tokenField(@"bound_lo", boundTypeToken(legBoundDown), TOKMAX_BOUND)
    benchLog.tokenField(@"bound_hi", boundTypeToken(legBoundUp), TOKMAX_BOUND)
    benchLog.numField(@"circle_deg", DEGREES_PER_TURN, LIM_SMALL)
    lineEmit()

PRI refStartMeanOrZero() : meanX10
' REF_START mean x10 of the leg, 0 when absent.
'
' @returns meanX10 - mean sense x10

    meanX10 := 0
    if legCount > 0
        meanX10 := legMeanX10[0]

PRI refStartNetOrZero() : netX10
' Task 3540 D5: REF_START NET x10 of the leg (the figure ref_start_mV_x10's raw mean is printed
' under a neutral name beside), 0 when absent.
'
' @returns netX10 - net sense x10

    netX10 := 0
    if legCount > 0
        netX10 := legNetX10[0]

PRI refEndMeanOrZero(refEndIdx) : meanX10
' REF_END mean x10 of the leg, 0 when absent.
'
' @param refEndIdx - leg index of REF_END, -1 when not measured
' @returns meanX10 - mean sense x10

    meanX10 := 0
    if (refEndIdx >= 0) and (refEndIdx < legCount)
        meanX10 := legMeanX10[refEndIdx]

PRI refEndNetOrZero(refEndIdx) : netX10
' Task 3540 D5: REF_END NET x10 of the leg, 0 when absent.
'
' @param refEndIdx - leg index of REF_END, -1 when not measured
' @returns netX10 - net sense x10

    netX10 := 0
    if (refEndIdx >= 0) and (refEndIdx < legCount)
        netX10 := legNetX10[refEndIdx]

PRI emitResults(side, firstSign) | orderPos, signIdx
' Emit one motor's RESULT, RESULT-HALF and PAIR records.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param firstSign - the sign whose legs ran first
'
' @local orderPos - 0 then 1
' @local signIdx - SIGN_* for this position

    repeat orderPos from 0 to SIGN_SLOTS - 1
        signIdx := (orderPos == 0) ? firstSign : (SIGN_POS - firstSign)
        emitResult(side, signIdx)                           ' the WALKING rung: the primary result
        emitResultHalf(side, signIdx, SPEED_QTR)            ' task 3595: one line per CONFIRM rung, each naming its speed
        emitResultHalf(side, signIdx, SPEED_HALF)
    emitPair(side, firstSign)
    emitPair2(side)

PRI hasMinimum(slotIdx) : bHasMin
' Report whether a result slot carries a usable fitted minimum. Task 3540 D2: FS_POOR is no
' longer usable (a fit whose residual already exceeds the POOR threshold must not be counted as a
' free minimum), and neither is a fit bFitPinnedNearLimit() found pinned against a fault-derived
' window edge, nor one whose leg failed the rise-on-both-sides negative case
' (bEvaluateBracket()/bEvaluateConfirmBracket()). Run 7's L POS printed exactly this: a POOR, pinned fit
' with shift +5.4, shift_sig TRUE, from data lowest at the window edge with nothing above it
' (SCAN-RUN-7-EVALUATION.md sec 2 item "L POS reports a shift that is not a measured minimum").
'
' @param slotIdx - result slot
' @returns bHasMin - TRUE when the status is FS_OK, not pinned, and the leg was bracketed

    bHasMin := (resStatus[slotIdx] == FS_OK) and (bResPinned[slotIdx] == FALSE) and (bResBracketed[slotIdx] <> FALSE)

PRI emitResult(side, signIdx) | slotIdx, bHasMin, bFloorOk, iminX10, savingX10
' Emit BS-RESULT for one sign at the WALKING rung -- the leg that swept out from the default and
' bracketed the minimum, which as of task 3595 is an eighth rather than a quarter. This is the
' primary result because it is the one with the widest reachable arc and therefore the only one whose
' minimum can be bracketed rather than pinned against a wall.
'
' Task 3540 D3: i_min_mV_x10 and saving_pct_x10 are now
' judged on the leg's measured floor (resFloorX10, from legMeasuredFloor()), not the fitted vertex
' -- run 7's fits read 11.3/9.8/13.2/13.5 mV against measured floors of 13.0/11.4/12.0/15.9 mV
' (SCAN-RUN-7-EVALUATION.md sec 3). i_def_mV_x10 (resIdefX10, the averaged REF_START/REF_END) is
' still a net mean, so saving_pct_x10 compares like with like. i_min_fit_mV_x10, a new field at the
' end, keeps the old fitted vertex for comparison.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signIdx - SIGN_NEG or SIGN_POS
'
' @local slotIdx - the WALKING rung's result slot
' @local bHasMin - a usable minimum exists
' @local bFloorOk - the leg measured at least one valid point
' @local iminX10 - minimum current x10, net, measured floor
' @local savingX10 - saving at the minimum vs default, percent x10

    slotIdx := resultSlot(side, signIdx, SPEED_WALK)
    bHasMin := hasMinimum(slotIdx)
    bFloorOk := bHasMin and (bResFloorValid[slotIdx] <> FALSE)
    iminX10 := resFloorX10[slotIdx]
    savingX10 := 0
    if bFloorOk and bResIdefValid[slotIdx] and (resIdefX10[slotIdx] > 0)
        savingX10 := ((resIdefX10[slotIdx] - iminX10) * X1000) / resIdefX10[slotIdx]
    benchLog.begin(@"BS-RESULT")
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"sign", signToken(signIdx), TOKMAX_SIGN)
    benchLog.tokenField(@"served_by", servedToken(signIdx), TOKMAX_SERVED)
    benchLog.numField(@"def_deg", defaultSwept(signIdx), LIM_TINY)
    benchLog.tokenField(@"status", fitToken(resStatus[slotIdx]), TOKMAX_FIT)
    benchLog.naNumField(@"min_deg_x10", floatToBoundedInt(resMinF[slotIdx] *. 10.0, LIM_SMALL), LIM_SMALL, bHasMin)
    benchLog.naNumField(@"applied_deg", normDegrees(floatToBoundedInt(resMinF[slotIdx], LIM_TINY)), LIM_TINY, bHasMin)
    benchLog.naNumField(@"min_se_deg_x10", floatToBoundedInt(resSeF[slotIdx] *. 10.0, LIM_SMALL), LIM_SMALL, bHasMin and bResSeValid[slotIdx])
    benchLog.naNumField(@"i_min_mV_x10", iminX10, LIM_SMALL, bFloorOk)
    benchLog.naNumField(@"i_def_mV_x10", resIdefX10[slotIdx], LIM_SMALL, bResIdefValid[slotIdx])
    benchLog.naNumField(@"saving_pct_x10", savingX10, LIM_SMALL, bFloorOk and bResIdefValid[slotIdx])
    benchLog.naNumField(@"fit_rms_mV_x10", floatToBoundedInt(resRmsF[slotIdx] *. 10.0, LIM_SMALL), LIM_SMALL, bHasMin)
    benchLog.boolField(@"drift_flag", bResDrift[slotIdx])
    benchLog.naNumField(@"i_min_fit_mV_x10", floatToBoundedInt(resIminF[slotIdx] *. 10.0, LIM_SMALL), LIM_SMALL, bHasMin)  ' task 3540 D3, new field at the end
    lineEmit()

PRI emitResultHalf(side, signIdx, confirmSpeed) | halfSlot, walkSlot, bHalfMin, bHalfFloorOk, bShift, bShiftSe, shiftDegF, shiftSeF, bSig
' Emit BS-RESULT-HALF for one sign at ONE confirm rung: that rung's minimum and its shift from the
' WALKING rung's.
'
' TASK 3595 MADE THIS RECORD PER-RUNG AND GAVE IT A speed FIELD, and the field is not decoration.
' There are now two confirm rungs (a quarter and a half) against one walking rung, so this record is
' emitted twice per sign. Without a speed field those two lines would be byte-identical wherever their
' numbers happened to agree, and a reader could not tell which rung either described -- which is
' precisely run 7's D7 defect, where two R9-SCAN-HALFLEG lines per motor were identical and the sheet
' read "4 of 2" (SCAN-RUN-7-EVALUATION.md sec 5 item 7).
'
' Task 3540
' D2: hasMinimum() now rejects a POOR or pinned fit and a leg that failed the rise-on-both-sides
' negative case, so a leg like run 7's L POS -- POOR, pinned, shift +5.4, shift_sig TRUE, printed
' from data lowest at the window edge (SCAN-RUN-7-EVALUATION.md sec 2) -- emits no shift or
' shift_sig at all: bHalfMin is FALSE, so bShift is FALSE. D3: i_min_mV_x10 is now the leg's
' measured floor, with the old fitted vertex kept at i_min_fit_mV_x10, a new field at the end.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signIdx - SIGN_NEG or SIGN_POS
' @param confirmSpeed - the confirm rung this line reports, SPEED_QTR or SPEED_HALF
'
' @local halfSlot - the confirm rung's result slot
' @local walkSlot - the WALKING rung's result slot, which the shift is measured against
' @local bHalfMin - a usable confirm-rung minimum exists
' @local bHalfFloorOk - bHalfMin AND this leg measured at least one valid point
' @local bShift - both minima exist
' @local bShiftSe - both minima carry a standard error
' @local shiftDegF - shift, degrees
' @local shiftSeF - shift standard error, degrees
' @local bSig - |shift| > SHIFT_SIG_FACTOR * shift SE

    halfSlot := resultSlot(side, signIdx, confirmSpeed)
    walkSlot := resultSlot(side, signIdx, SPEED_WALK)
    bHalfMin := hasMinimum(halfSlot)
    bHalfFloorOk := bHalfMin and (bResFloorValid[halfSlot] <> FALSE)
    bShift := bHalfMin and hasMinimum(walkSlot)
    bShiftSe := bShift and bResSeValid[halfSlot] and bResSeValid[walkSlot]
    shiftDegF := resMinF[halfSlot] -. resMinF[walkSlot]
    shiftSeF := fsqrt((resSeF[halfSlot] *. resSeF[halfSlot]) +. (resSeF[walkSlot] *. resSeF[walkSlot]))
    bSig := bShiftSe and (fabs(shiftDegF) >. (SHIFT_SIG_FACTOR *. shiftSeF))
    benchLog.begin(@"BS-RESULT-HALF")
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"sign", signToken(signIdx), TOKMAX_SIGN)
    benchLog.tokenField(@"speed", speedToken(confirmSpeed), TOKMAX_SPEED)   ' task 3595: WHICH confirm rung this line is
    benchLog.tokenField(@"status", fitToken(resStatus[halfSlot]), TOKMAX_FIT)
    benchLog.naNumField(@"min_deg_x10", floatToBoundedInt(resMinF[halfSlot] *. 10.0, LIM_SMALL), LIM_SMALL, bHalfMin)
    benchLog.naNumField(@"min_se_deg_x10", floatToBoundedInt(resSeF[halfSlot] *. 10.0, LIM_SMALL), LIM_SMALL, bHalfMin and bResSeValid[halfSlot])
    benchLog.naNumField(@"i_min_mV_x10", resFloorX10[halfSlot], LIM_SMALL, bHalfFloorOk)
    benchLog.naNumField(@"i_def_mV_x10", resIdefX10[halfSlot], LIM_SMALL, bResIdefValid[halfSlot])
    benchLog.naNumField(@"shift_deg_x10", floatToBoundedInt(shiftDegF *. 10.0, LIM_SMALL), LIM_SMALL, bShift)
    benchLog.naNumField(@"shift_se_deg_x10", floatToBoundedInt(shiftSeF *. 10.0, LIM_SMALL), LIM_SMALL, bShiftSe)
    benchLog.boolField(@"shift_sig", bSig)
    benchLog.naNumField(@"i_min_fit_mV_x10", floatToBoundedInt(resIminF[halfSlot] *. 10.0, LIM_SMALL), LIM_SMALL, bHalfMin)  ' task 3540 D3, new field at the end
    lineEmit()

PRI emitPair(side, firstSign) | negSlot, posSlot, bComplete, bPairSe, midF, midSeF, leadF
' Emit BS-PAIR: the two 1/4-speed minima, their midpoint (hall-zero estimate) and half-difference (lead).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param firstSign - the sign whose legs ran first
'
' @local negSlot - NEG slot at the WALKING rung
' @local posSlot - POS slot at the WALKING rung
' @local bComplete - both minima exist
' @local bPairSe - both minima carry a standard error
' @local midF - midpoint, degrees
' @local midSeF - midpoint standard error, degrees
' @local leadF - half-difference, degrees

    ' task 3595: the pair comes from the WALKING rung, because that is the rung with the widest
    '  reachable arc and therefore the only one whose two minima can both be bracketed rather than
    '  pinned against a wall. Run 7 took its pair from quarter speed because quarter speed was then
    '  the walk; taking it from a confirm rung would read a minimum the walk had already placed.
    negSlot := resultSlot(side, SIGN_NEG, SPEED_WALK)
    posSlot := resultSlot(side, SIGN_POS, SPEED_WALK)
    bComplete := hasMinimum(negSlot) and hasMinimum(posSlot)
    bPairSe := bComplete and bResSeValid[negSlot] and bResSeValid[posSlot]
    midF := (resMinF[negSlot] +. resMinF[posSlot]) /. 2.0
    leadF := (resMinF[negSlot] -. resMinF[posSlot]) /. 2.0
    midSeF := 0.5 *. fsqrt((resSeF[negSlot] *. resSeF[negSlot]) +. (resSeF[posSlot] *. resSeF[posSlot]))
    benchLog.begin(@"BS-PAIR")
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.boolField(@"complete", bComplete)
    benchLog.naNumField(@"neg_min_deg_x10", floatToBoundedInt(resMinF[negSlot] *. 10.0, LIM_SMALL), LIM_SMALL, hasMinimum(negSlot))
    benchLog.naNumField(@"pos_min_deg_x10", floatToBoundedInt(resMinF[posSlot] *. 10.0, LIM_SMALL), LIM_SMALL, hasMinimum(posSlot))
    benchLog.naNumField(@"mid_deg_x10", floatToBoundedInt(midF *. 10.0, LIM_SMALL), LIM_SMALL, bComplete)
    benchLog.naNumField(@"mid_se_deg_x10", floatToBoundedInt(midSeF *. 10.0, LIM_SMALL), LIM_SMALL, bPairSe)
    benchLog.naNumField(@"lead_deg_x10", floatToBoundedInt(leadF *. 10.0, LIM_SMALL), LIM_SMALL, bComplete)
    benchLog.tokenField(@"sign_order", (firstSign == SIGN_NEG) ? @sOrderNegFirst : @sOrderPosFirst, TOKMAX_ORDER)
    lineEmit()

PRI emitPair2(side) | negSlot, posSlot, bComplete, negX10, posX10, ratioX1000, bRatio, pairSlot
' Emit BS-PAIR2: currents at the two minima, the measured zero, and their ratio. Task 3540 D3:
' negX10/posX10 (and so ratio_net_x1000/imbalance) now read each leg's measured floor
' (resFloorX10), not the fitted vertex -- run 7's right motor's imbalance FALSE rested on fits
' reading 1.026; its measured floors ratio 1.29 (SCAN-RUN-7-EVALUATION.md sec 3). The fitted
' minima move to i_neg_min_fit_mV_x10/i_pos_min_fit_mV_x10, new fields at the end.
' Scan v4 CHANGE 3 (superseded by D3 above, kept for the ratio_raw_x1000 history): resIminF was
' the fit's NET-of-its-own-zero minimum (scan v4 CHANGE 2 -- fitLeg() fits legNetX10, netted
' point-by-point against the zero measured immediately before each point). The old ratio_net_x1000
' re-subtracted zeroMeanX10 (ZERO_INIT, the motor-block's FIRST zero) from both minima -- that was
' the bug (PL-32 / SCAN-RUN-5-EVALUATION.md section 6). ratio_raw_x1000 still prints NA
' unconditionally (fmt 6): neither the fit nor the measured floor computes a separate "raw"
' minimum, so printing the same number under two names would misrepresent it as an independent
' check.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
'
' @local negSlot - NEG slot at the WALKING rung
' @local posSlot - POS slot at the WALKING rung
' @local bComplete - both minima exist, each with a valid measured floor
' @local negX10 - NEG minimum current x10, net, measured floor
' @local posX10 - POS minimum current x10, net, measured floor
' @local ratioX1000 - negX10/posX10 x1000, the net ratio (ratio_net_x1000)
' @local bRatio - the denominator is positive
' @local pairSlot - sideSlot(side), the sign-off accumulator index (task 3537)

    negSlot := resultSlot(side, SIGN_NEG, SPEED_WALK)       ' task 3595: the walking rung, as BS-PAIR
    posSlot := resultSlot(side, SIGN_POS, SPEED_WALK)
    bComplete := hasMinimum(negSlot) and hasMinimum(posSlot) and (bResFloorValid[negSlot] <> FALSE) and (bResFloorValid[posSlot] <> FALSE)
    negX10 := resFloorX10[negSlot]
    posX10 := resFloorX10[posSlot]
    ratioX1000 := 0
    bRatio := FALSE
    if bComplete and (posX10 > 0)
        ratioX1000 := (negX10 * X1000) / posX10
        bRatio := TRUE
    ' task 3537 R9-SCAN-PAIR2: the very bComplete/bRatio this record prints below, not a re-derivation
    pairSlot := sideSlot(side)
    bSfPair2Complete[pairSlot] := bComplete
    bSfPair2NetOk[pairSlot] := bRatio
    benchLog.begin(@"BS-PAIR2")
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.naNumField(@"i_neg_min_mV_x10", negX10, LIM_SMALL, bComplete)
    benchLog.naNumField(@"i_pos_min_mV_x10", posX10, LIM_SMALL, bComplete)
    benchLog.numField(@"zero_mV_x10", zeroMeanX10[sideSlot(side)], LIM_SMALL)
    benchLog.naNumField(@"ratio_raw_x1000", ratioX1000, LIM_SMALL, FALSE)   ' fmt 6: raw minima no longer computed -- always NA
    benchLog.naNumField(@"ratio_net_x1000", ratioX1000, LIM_SMALL, bRatio)
    benchLog.boolField(@"imbalance", bRatio and (abs(ratioX1000 - X1000) > IMBALANCE_PCT * X10))
    benchLog.naNumField(@"i_neg_min_fit_mV_x10", floatToBoundedInt(resIminF[negSlot] *. 10.0, LIM_SMALL), LIM_SMALL, hasMinimum(negSlot))  ' task 3540 D3, new field at the end
    benchLog.naNumField(@"i_pos_min_fit_mV_x10", floatToBoundedInt(resIminF[posSlot] *. 10.0, LIM_SMALL), LIM_SMALL, hasMinimum(posSlot))
    lineEmit()

PRI emitAbort(scope, reason, side, motorIncre, detailValue)
' Emit BS-ABORT.
'
' @param scope - SCOPE_* scope
' @param reason - AR_* reason
' @param side - SIDE_* context
' @param motorIncre - last increment
' @param detailValue - the reading or code that triggered it

    benchLog.begin(@"BS-ABORT")
    benchLog.tokenField(@"scope", scopeToken(scope), TOKMAX_SCOPE)
    benchLog.tokenField(@"reason", reasonToken(reason), TOKMAX_REASON)
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"seq", pointSeq, LIM_TINY)
    benchLog.numField(@"value", detailValue, LIM_MID)
    benchLog.numField(@"elapsed_s", (getms() - runStartMs) / MS_PER_SEC, LIM_SMALL)
    lineEmit()

PRI emitEnd()
' Emit BS-END, the last record before the end marker.

    flushCharge()
    benchLog.begin(@"BS-END")
    benchLog.tokenField(@"exit", (abortReason == AR_NONE) ? @sExitComplete : @sExitAborted, TOKMAX_EXIT)
    benchLog.tokenField(@"reason", reasonToken(abortReason), TOKMAX_REASON)
    benchLog.numField(@"elapsed_s", (getms() - runStartMs) / MS_PER_SEC, LIM_SMALL)
    benchLog.numField(@"points", pointSeq, LIM_TINY)
    benchLog.numField(@"faults", runFaults, LIM_TINY)
    benchLog.numField(@"aborts_i", runAbortsI, LIM_TINY)
    benchLog.numField(@"charge_mVs", runChargeMvS, LIM_MID)
    benchLog.boolField(@"left_done", bLeftDone)
    benchLog.boolField(@"right_done", bRightDone)
    benchLog.boolField(@"lib_abort", (abortReason == AR_LIB_ABORT))
    benchLog.numField(@"trap_value", runTrapCode, LIM_MID)       ' task 3540 TOP-LEVEL TRAP: every run, not only an abort
    lineEmit()

PRI emitBuild()
' Emit BS-BUILD (task 3537, design sec F.5), right after BS-BANNER: the build variant and the
' sign-off format. wd_selftest is sourced from its own #ifdef, never a runtime test, following
' emitBanner()'s cfg_id pattern: pnut-ts silently ignores an unknown -D, so a mistyped flag lands on
' the honest FALSE. Every build today prints FALSE. zxs_starts and zxs_max_mV_x10 (fmt 8) print the
' R8 limits compiled in.
' Worst case: tag(8) + wd_selftest(1+11+1+5=18) + sf(1+2+1+4=8) + zxs_starts(1+10+1+4=16) +
' zxs_max_mV_x10(1+14+1+4=20) = 70 bytes.

    benchLog.begin(@"BS-BUILD")
#ifdef WD_SELFTEST
    benchLog.boolField(@"wd_selftest", TRUE)
#else
    benchLog.boolField(@"wd_selftest", FALSE)
#endif
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.numField(@"zxs_starts", ZXS_STARTS, LIM_TINY)
    benchLog.numField(@"zxs_max_mV_x10", ZXS_MAX_MV_X10, LIM_TINY)
    lineEmit()

PRI emitSignoffDecls()
' Emit one SIGNOFF-DECL per cell this build judges, right after BS-BUILD (task 3537). The WD_SELFTEST
' build judges only the four R11-WDT-* cells (design sec F.5, task 3537 phase 2c): a normal-scan cell
' declared there could never get a verdict. The normal build declares none of them.

#ifdef WD_SELFTEST
    emitSignoffDecl(@sSfCellWdtFires, @sSfTaskNoStall)
    emitSignoffDecl(@sSfCellWdtCkpt, @sSfTaskNoStall)
    emitSignoffDecl(@sSfCellWdtStop, @sSfTaskNoStall)
    emitSignoffDecl(@sSfCellWdtStack, @sSfTaskNoStall)
#else
    emitSignoffDecl(@sSfCellCogOk, @sSfTaskCogOk)
    emitSignoffDecl(@sSfCellRevB, @sSfTaskRevB)
    emitSignoffDecl(@sSfCellInteg, @sSfTaskInteg)
    emitSignoffDecl(@sSfCellSelf, @sSfTaskSelf)
    emitSignoffDecl(@sSfCellOffsets, @sSfTaskOffsets)
    emitSignoffDecl(@sSfCellStartIll, @sSfTaskStartIll)
    emitSignoffDecl(@sSfCellNoStall, @sSfTaskNoStall)
    emitSignoffDecl(@sSfCellAlive, @sSfTaskLut)
    emitSignoffDecl(@sSfCellRate, @sSfTaskLut)
    emitSignoffDecl(@sSfCellZxs, @sSfTaskZxs)
    emitSignoffDecl(@sSfCellLegBr, @sSfTaskScanV4)          ' task 3595: replaces R9-SCAN-HALFLEG, now every leg
    emitSignoffDecl(@sSfCellOwnZero, @sSfTaskScanV4)
    emitSignoffDecl(@sSfCellPair2, @sSfTaskScanV4)
    emitSignoffDecl(@sSfCellRstAlone, @sSfTaskRstAlone)
#endif

PRI emitSignoffDecl(pCell, pTask)
' Emit SIGNOFF-DECL for one cell.
' Worst case, by clamp widths: tag(12) + sf(8) + bin(11) + cell(26) + task(11) = 68 bytes.
'
' @param pCell - pointer to the cell id token
' @param pTask - pointer to the owning todo-mcp task id, as plain text

    benchLog.begin(@"SIGNOFF-DECL")
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.tokenField(@"bin", @sSfBinScan, TOKMAX_BIN)
    benchLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    benchLog.tokenField(@"task", pTask, TOKMAX_TASK)
    lineEmit()

PRI emitSignoffs() | side, slotIdx, bStarted
' Emit every declared cell's SIGNOFF instances once, from the per-motor accumulators (task 3537).
' Runs on cog 0's normal end path only: after the watchdog is stopped and both wheels are shut
' down, before BS-END -- on every such path, including after a run abort. No library call, no wait.
' A motor with no start (its block and its preflight never ran) prints NOMEAS with n 0.
'  R1/R2/R7  measured = bad starts,           n = starts;               NOMEAS when starts = 0
'  R3        measured = missed + illegal sum, n = starts + points;      NOMEAS when starts = 0
'  R6        measured = bad read-backs,       n = read-backs;           NOMEAS when read-backs = 0
'  R12-ALIVE measured = starts not alive,     n = starts judged;        NOMEAS when none judged
'  R5, R12-RATE BOOL from the self-check;                                NOMEAS when not measured
'  R11       BOOL TRUE, motor NONE: reaching this path is the evidence
'  R8-ZXS    per channel, measured = PH_XSTART spread, n = zxsN;          NOMEAS when zxsN < ZXS_STARTS
'  R9-HALFLEG per half slot, BOOL every probeable confirm fault probed;    NOMEAS when there was none
'  R9-OWNZERO per slot that ran and bracketed, measured = points without own zero, n = valid points;
'            one NOMEAS instance when the motor has no such slot
'  R9-PAIR2  BOOL emitPair2()'s bRatio;                                    NOMEAS when the pair was incomplete
'  R10-RSTALONE BOOL stopped and not faulted after testResetFault() alone; NOMEAS when no eligible fault
'  then BS-ZXSALL, the informational every-lifetime spread (a BS- record, never a SIGNOFF)
' The WD_SELFTEST build emits none of these (it declares none of them): only emitWdtSignoffs().
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local slotIdx - sideSlot(side)
' @local bStarted - TRUE when the motor had at least one start

#ifdef WD_SELFTEST
    emitWdtSignoffs()
#else
    repeat side from SIDE_LEFT to SIDE_RIGHT
        beat(CP_EMIT)
        slotIdx := sideSlot(side)
        bStarted := (sfStarts[slotIdx] > 0)
        emitSignoff(@sSfCellCogOk, @sSfTaskCogOk, side, @sSfCritCogBad, bStarted, sfCogBad[slotIdx], COG_BAD_LO, COG_BAD_HI, @sSfUnitsCount, sfStarts[slotIdx])
        emitSignoff(@sSfCellRevB, @sSfTaskRevB, side, @sSfCritNotRevB, bStarted, sfRevbBad[slotIdx], NOT_REVB_LO, NOT_REVB_HI, @sSfUnitsCount, sfStarts[slotIdx])
        emitSignoff(@sSfCellInteg, @sSfTaskInteg, side, @sSfCritInteg, bStarted, sfIntegSum[slotIdx], INTEG_SUM_LO, INTEG_SUM_HI, @sSfUnitsCount, sfStarts[slotIdx] + sfIntegN[slotIdx])
        emitSignoffBool(@sSfCellSelf, @sSfTaskSelf, side, @sSfCritNetI, bSfSelfIRan[slotIdx], bSfSelfIOk[slotIdx], SIGNOFF_ONE_INSTANCE)
        emitSignoff(@sSfCellOffsets, @sSfTaskOffsets, side, @sSfCritReadback, sfReadbacks[slotIdx] > 0, sfOffsetsBad[slotIdx], READBACK_BAD_LO, READBACK_BAD_HI, @sSfUnitsCount, sfReadbacks[slotIdx])
        emitSignoff(@sSfCellStartIll, @sSfTaskStartIll, side, @sSfCritStartIll, bStarted, sfStartIllegal[slotIdx], START_ILLEGAL_LO, START_ILLEGAL_HI, @sSfUnitsCount, sfStarts[slotIdx])
        emitSignoff(@sSfCellAlive, @sSfTaskLut, side, @sSfCritNotAlive, sfAliveJudged[slotIdx] > 0, sfNotAlive[slotIdx], NOT_ALIVE_LO, NOT_ALIVE_HI, @sSfUnitsCount, sfAliveJudged[slotIdx])
        emitSignoffBool(@sSfCellRate, @sSfTaskLut, side, @sSfCritRate, bSfSelfRateRan[slotIdx], bSfSelfRateOk[slotIdx], SIGNOFF_ONE_INSTANCE)
        emitZxsSignoffs(side, slotIdx)
        emitLegBracketSignoffs(side)
        emitOwnZeroSignoffs(side)
        ' R9-SCAN-PAIR2 is COVERAGE: it proves the fmt 6 net-ratio path of emitPair2() ran to a valid
        ' ratio, not that the number is correct. bRatio implies bComplete, so it is the criterion.
        emitSignoffBool(@sSfCellPair2, @sSfTaskScanV4, side, @sSfCritNetRatio, bSfPair2Complete[slotIdx], bSfPair2NetOk[slotIdx], SIGNOFF_ONE_INSTANCE)
        ' R10-SCAN-RSTALONE (task 3537 phase 2b3): unfixed, testResetFault() alone left the wheel
        ' FAULTED and not stopped, so cleared is FALSE -> FAIL. Worst case: emitSignoffBool(), 173 bytes.
        emitSignoffBool(@sSfCellRstAlone, @sSfTaskRstAlone, side, @sSfCritRstAlone, bSfRstAloneDone[slotIdx], bRstAloneCleared[slotIdx], SIGNOFF_ONE_INSTANCE)
        emitZxsAll(side, slotIdx)
    beat(CP_EMIT)
    emitSignoffBool(@sSfCellNoStall, @sSfTaskNoStall, SIDE_NONE, @sSfCritCog0End, TRUE, TRUE, SIGNOFF_ONE_INSTANCE)
#endif

PRI emitWdtSignoffs()
' Emit the four R11-WDT-* SIGNOFF instances from cog 0 (task 3537 phase 2c, WD_SELFTEST build, design
' sec G.3). Reached only when the watchdog did NOT declare -- a declaration parks cog 0 for good, and the
' watchdog cog then emits these four itself from declareStall(). So from here:
'  R11-WDT-FIRES   measured = the elapsed stall when the backstop was hit (>= WD_SELFTEST_BACKSTOP_MS,
'                  outside WDT_FIRES_LO_MS..WDT_FIRES_HI_MS -> FAIL with its own number, never NA with
'                  FAIL); NOMEAS when the stall never ran (no watchdog cog, preflight aborted, or a
'                  library abort trapped in main() before it).
'  R11-WDT-CKPT, R11-WDT-STOPPED, R11-WDT-STACK  always NOMEAS: only the declaring watchdog can observe them.
' Every instance is motor NONE. One place for every cog-0 exit path, after the watchdog cog is stopped.
' Worst case: emitSignoff(), 196 bytes.

    beat(CP_EMIT)
    emitSignoff(@sSfCellWdtFires, @sSfTaskNoStall, SIDE_NONE, @sSfCritStallMs, bWdtBackstopHit, wdtBackstopMs, ...
        WDT_FIRES_LO_MS, WDT_FIRES_HI_MS, @sSfUnitsMs, SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellWdtCkpt, @sSfTaskNoStall, SIDE_NONE, @sSfCritCkptSelf, FALSE, FALSE, SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellWdtStop, @sSfTaskNoStall, SIDE_NONE, @sSfCritWheelsSt, FALSE, FALSE, SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellWdtStack, @sSfTaskNoStall, SIDE_NONE, @sSfCritStackOk, FALSE, FALSE, SIGNOFF_ONE_INSTANCE)

PRI emitZxsSignoffs(side, slotIdx) | chIdx
' Emit R8-SCAN-ZXS for one motor: one SIGNOFF per channel, measured = the PH_XSTART spread (task 3537).
' Falsifiable on the unfixed calibration (PL-32): i and v on both motors, u on RIGHT; the rest are
' coverage (see ZXS_MAX_MV_X10). Worst case: emitSignoff(), 196 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param slotIdx - sideSlot(side)
'
' @local chIdx - ZXS_CH_I .. ZXS_CH_W

    repeat chIdx from ZXS_CH_I to ZXS_CH_W
        beat(CP_EMIT)
        emitSignoff(@sSfCellZxs, @sSfTaskZxs, side, zxsCritToken(chIdx), zxsN[slotIdx] >= ZXS_STARTS, ...
            zxsSpreadX10((slotIdx * ZXS_CHANNELS) + chIdx, TRUE), ZXS_LO_MV_X10, ZXS_MAX_MV_X10, @sSfUnitsMvX10, zxsN[slotIdx])

PRI zxsCritToken(chIdx) : pTok
' R8 criterion token for a zero channel.
'
' @param chIdx - ZXS_CH_* value
' @returns pTok - ZXS_I, ZXS_U, ZXS_V or ZXS_W

    case chIdx
        ZXS_CH_I:
            pTok := @sSfCritZxsI
        ZXS_CH_U:
            pTok := @sSfCritZxsU
        ZXS_CH_V:
            pTok := @sSfCritZxsV
        other:
            pTok := @sSfCritZxsW

PRI emitLegBracketSignoffs(side) | signIdx, resIdx, pCrit, speedIdx
' Emit R18-SCAN-LEGBRACKET for one motor: one BOOL SIGNOFF per result slot -- EVERY sign at EVERY
' rung, six per motor. measured TRUE when the leg's low was bracketed by a rise on both sides
' (bResBracketed); FAILs exactly when the low sits at a fault-bounded window edge with nothing
' measured beyond it toward the fault -- run 7's failure mode (SCAN-RUN-7-EVALUATION.md sec 2, sec 5
' item 1). NOMEAS when the leg never ran (bResLegRan FALSE).
'
' TASK 3595 WIDENED THIS FROM THE HALF-SPEED LEG TO EVERY LEG, and replaced the cell id
' R9-SCAN-HALFLEG, which named a rung that is no longer the only one judged. The criterion is the one
' the rebuild exists to enforce: a leg either brackets its minimum or says that it did not. Run 7's
' four half-speed legs all put their lowest current at the last clean point before a fault and every
' fit came back EDGE or POOR and pinned, while the sheet still read as though minima had been
' demonstrated. Judging the walking rung too is what makes that impossible to repeat, because the
' walking rung is the one now expected to bracket.
'
' Worst case: emitSignoffBool(), 173 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
'
' @local signIdx - SIGN_NEG then SIGN_POS
' @local resIdx - that sign and rung's result slot
' @local pCrit - this sign and rung's crit token
' @local speedIdx - every rung, SPEED_LOW through SPEED_HALF

    repeat signIdx from SIGN_NEG to SIGN_POS
        repeat speedIdx from SPEED_LOW to SPEED_HALF
            beat(CP_EMIT)
            resIdx := resultSlot(side, signIdx, speedIdx)
            pCrit := legBracketCrit(signIdx, speedIdx)
            emitSignoffBool(@sSfCellLegBr, @sSfTaskScanV4, side, pCrit, bResLegRan[resIdx] <> FALSE, ...
                bResBracketed[resIdx] <> FALSE, SIGNOFF_ONE_INSTANCE)

PRI legBracketCrit(signIdx, speedIdx) : pCrit
' Task 3595: the crit token naming ONE leg -- its sign and its rung -- for R18-SCAN-LEGBRACKET.
'
' Every instance must be distinguishable from every other, because there are now six per motor and a
' reader has to be able to say WHICH leg failed to bracket its minimum. That is the whole content of
' run 7's D7 finding, where two identical lines made a sheet read "4 of 2".
'
' @param signIdx - SIGN_NEG or SIGN_POS
' @param speedIdx - SPEED_* rung
' @returns pCrit - pointer to this leg's crit token

    case speedIdx
        SPEED_LOW:
            pCrit := (signIdx == SIGN_NEG) ? @sSfCritBrNegLow : @sSfCritBrPosLow
        SPEED_HALF:
            pCrit := (signIdx == SIGN_NEG) ? @sSfCritBrNegHlf : @sSfCritBrPosHlf
        other:
            pCrit := (signIdx == SIGN_NEG) ? @sSfCritBrNegQtr : @sSfCritBrPosQtr

PRI emitOwnZeroSignoffs(side) | signIdx, speedIdx, resIdx, nInst
' Emit R9-SCAN-OWNZERO for one motor (task 3537): one COUNT SIGNOFF per result slot whose leg ran and
' was not FS_NOT_BRACKETED, measured = its valid points without a valid own zero, n = its valid
' points; a single NOMEAS instance when no slot of this motor qualifies. Worst case: emitSignoff(),
' 196 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
'
' @local signIdx - SIGN_NEG then SIGN_POS
' @local speedIdx - every rung, SPEED_LOW through SPEED_HALF
' @local resIdx - the result slot
' @local nInst - instances emitted for this motor

    nInst := 0
    repeat signIdx from SIGN_NEG to SIGN_POS
        repeat speedIdx from SPEED_LOW to SPEED_HALF        ' task 3595: every rung, walking rung included
            beat(CP_EMIT)
            resIdx := resultSlot(side, signIdx, speedIdx)
            if (bResLegRan[resIdx] <> FALSE) and (resStatus[resIdx] <> FS_NOT_BRACKETED)
                ' TASK 3595, run 7's D6: bMeasured was hardcoded TRUE, so a slot that checked NOTHING
                '  printed PASS with measured 0 of n 0. That is a vacuous pass, and it is the exact
                '  shape the evaluation named -- the cell could not distinguish "every point had its
                '  own zero" from "no point was ever examined", which is what the unfixed path does.
                '  A check that cannot fail on the path it polices has been disarmed, not satisfied.
                '  Gating on the examined count makes an unexamined slot print NOMEAS instead.
                emitSignoff(@sSfCellOwnZero, @sSfTaskScanV4, side, @sSfCritOwnZero, resZeroChecked[resIdx] > 0, resZeroMissing[resIdx], ...
                    OWN_ZERO_MISSING_LO, OWN_ZERO_MISSING_HI, @sSfUnitsCount, resZeroChecked[resIdx])
                nInst += 1
    if nInst == 0
        emitSignoff(@sSfCellOwnZero, @sSfTaskScanV4, side, @sSfCritOwnZero, FALSE, 0, ...
            OWN_ZERO_MISSING_LO, OWN_ZERO_MISSING_HI, @sSfUnitsCount, 0)

PRI emitZxsAll(side, slotIdx) | baseIdx, bAny
' Emit BS-ZXSALL for one motor (task 3537, fmt 8): the spread of EVERY driver lifetime's first full
' zero (any phase: XSTART, ZERO_INIT, restarts after an abort), per channel, and their count. A plain
' BS- record, never a SIGNOFF: it is informational (design sec A.5-e), and a SIGNOFF with an
' unmanifested crit would read host-side as a crit mismatch. Spreads print NA when n is 0.
' Worst case: tag(9) + motor(1+5+1+5=12) + n(1+1+1+7=10) + four spreads each
' (1+15+1+10=27) = 139 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param slotIdx - sideSlot(side)
'
' @local baseIdx - index of this motor's ZXS_CH_I entry
' @local bAny - TRUE when at least one zero was folded

    baseIdx := slotIdx * ZXS_CHANNELS
    bAny := (zxsAllN[slotIdx] > 0)
    benchLog.begin(@"BS-ZXSALL")
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"n", zxsAllN[slotIdx], LIM_SMALL)
    benchLog.naNumField(@"i_spread_mV_x10", zxsSpreadX10(baseIdx + ZXS_CH_I, FALSE), LIM_MID, bAny)
    benchLog.naNumField(@"u_spread_mV_x10", zxsSpreadX10(baseIdx + ZXS_CH_U, FALSE), LIM_MID, bAny)
    benchLog.naNumField(@"v_spread_mV_x10", zxsSpreadX10(baseIdx + ZXS_CH_V, FALSE), LIM_MID, bAny)
    benchLog.naNumField(@"w_spread_mV_x10", zxsSpreadX10(baseIdx + ZXS_CH_W, FALSE), LIM_MID, bAny)
    lineEmit()

PRI emitSignoff(pCell, pTask, side, pCrit, bMeasured, measuredVal, loLimit, hiLimit, pUnits, instCount) | boundedVal, pVerdict
' Emit one SIGNOFF verdict (design sec B.1, sf 1) from the existing line builder. measured is
' clamped to LIM_BIG first and the verdict is judged on that printed value, so a record always
' agrees with its own numbers (every limit here is far inside LIM_BIG). PASS only when measured
' AND in loLimit..hiLimit; FAIL when measured and outside; NOMEAS, with measured NA and n 0, when
' not measured.
' Worst case, by clamp widths: tag(7) + sf(8) + bin(11) + cell(26) + task(11) + motor(12) +
' crit(24) + measured(22) + lo(16) + hi(16) + units(15) + n(10) + verdict(18) = 196 bytes.
'
' @param pCell - pointer to the cell id token
' @param pTask - pointer to the owning todo-mcp task id, as plain text
' @param side - SIDE_* the instance belongs to
' @param pCrit - pointer to the criterion token
' @param bMeasured - TRUE when the instance was measured
' @param measuredVal - the instance's measured value
' @param loLimit - lowest passing value, compiled in
' @param hiLimit - highest passing value, compiled in
' @param pUnits - pointer to the units token
' @param instCount - starts, points or read-backs behind measuredVal
'
' @local boundedVal - measuredVal clamped to +/-LIM_BIG
' @local pVerdict - PASS, FAIL or NOMEAS token

    boundedVal := (measuredVal #> (0 - LIM_BIG)) <# LIM_BIG
    if bMeasured == FALSE
        pVerdict := @sSfNomeas
    elseif (boundedVal >= loLimit) and (boundedVal <= hiLimit)
        pVerdict := @sSfPass
    else
        pVerdict := @sSfFail
    benchLog.begin(@"SIGNOFF")
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.tokenField(@"bin", @sSfBinScan, TOKMAX_BIN)
    benchLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    benchLog.tokenField(@"task", pTask, TOKMAX_TASK)
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"crit", pCrit, TOKMAX_CRIT)
    benchLog.naNumField(@"measured", boundedVal, LIM_BIG, bMeasured)
    benchLog.numField(@"lo", loLimit, LIM_BIG)
    benchLog.numField(@"hi", hiLimit, LIM_BIG)
    benchLog.tokenField(@"units", pUnits, TOKMAX_UNITS)
    if bMeasured
        benchLog.numField(@"n", instCount, LIM_SMALL)
    else
        benchLog.numField(@"n", 0, LIM_SMALL)
    benchLog.tokenField(@"verdict", pVerdict, TOKMAX_SFVERDICT)
    lineEmit()

PRI emitSignoffEx(pCell, pTask, side, pCrit, bMeasured, measuredVal, loLimit, bHasLo, hiLimit, bHasHi, bConditionsOk, pUnits, instCount) | boundedVal, pVerdict
' Emit one SIGNOFF verdict (design sec B.1, sf 1) whose limits may be NA and whose PASS may need a
' condition beyond lo..hi. Same fields, order and clamps as emitSignoff(), which can do neither.
' PASS only when measured AND bConditionsOk AND every present limit holds; FAIL when measured
' otherwise; NOMEAS, with measured NA and n 0, when not measured. Judged on the clamped value.
' No caller yet: phase 2b2's R8/R9 cells need neither NA limits nor extra conditions, and the
' every-lifetime spread became the plain BS-ZXSALL record instead of ZXSALL_* SIGNOFFs. Kept for a
' later task 3537 phase.
' Worst case, by clamp widths: identical to emitSignoff(), 196 bytes (an NA limit is shorter).
'
' @param pCell - pointer to the cell id token
' @param pTask - pointer to the owning todo-mcp task id, as plain text
' @param side - SIDE_* the instance belongs to
' @param pCrit - pointer to the criterion token
' @param bMeasured - TRUE when the instance was measured
' @param measuredVal - the instance's measured value
' @param loLimit - lowest passing value, compiled in (ignored when bHasLo is FALSE)
' @param bHasLo - TRUE when the cell has a low limit; FALSE prints lo NA
' @param hiLimit - highest passing value, compiled in (ignored when bHasHi is FALSE)
' @param bHasHi - TRUE when the cell has a high limit; FALSE prints hi NA
' @param bConditionsOk - TRUE when every non-range condition of the criterion holds
' @param pUnits - pointer to the units token
' @param instCount - starts, points or read-backs behind measuredVal
'
' @local boundedVal - measuredVal clamped to +/-LIM_BIG
' @local pVerdict - PASS, FAIL or NOMEAS token

    boundedVal := (measuredVal #> (0 - LIM_BIG)) <# LIM_BIG
    if bMeasured == FALSE
        pVerdict := @sSfNomeas
    elseif (bConditionsOk == TRUE) and ((bHasLo == FALSE) or (boundedVal >= loLimit)) and ((bHasHi == FALSE) or (boundedVal <= hiLimit))
        pVerdict := @sSfPass
    else
        pVerdict := @sSfFail
    benchLog.begin(@"SIGNOFF")
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.tokenField(@"bin", @sSfBinScan, TOKMAX_BIN)
    benchLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    benchLog.tokenField(@"task", pTask, TOKMAX_TASK)
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"crit", pCrit, TOKMAX_CRIT)
    benchLog.naNumField(@"measured", boundedVal, LIM_BIG, bMeasured)
    benchLog.naNumField(@"lo", loLimit, LIM_BIG, bHasLo)
    benchLog.naNumField(@"hi", hiLimit, LIM_BIG, bHasHi)
    benchLog.tokenField(@"units", pUnits, TOKMAX_UNITS)
    if bMeasured
        benchLog.numField(@"n", instCount, LIM_SMALL)
    else
        benchLog.numField(@"n", 0, LIM_SMALL)
    benchLog.tokenField(@"verdict", pVerdict, TOKMAX_SFVERDICT)
    lineEmit()

PRI emitSignoffBool(pCell, pTask, side, pCrit, bMeasured, bCriterionMet, instCount) | pVerdict
' Emit one boolean SIGNOFF verdict (design sec B.1, sf 1): measured TRUE/FALSE (NA when not
' measured), lo TRUE, hi TRUE, units BOOL. PASS only when measured AND TRUE, so the verdict always
' agrees with its own measured field.
' Worst case: tag(7) + sf(8) + bin(11) + cell(26) + task(11) + motor(12) + crit(24) + measured(15)
' + lo(8) + hi(8) + units(15) + n(10) + verdict(18) = 173 bytes.
'
' @param pCell - pointer to the cell id token
' @param pTask - pointer to the owning todo-mcp task id, as plain text
' @param side - SIDE_* the instance belongs to
' @param pCrit - pointer to the criterion token
' @param bMeasured - TRUE when the instance was measured
' @param bCriterionMet - TRUE when the whole criterion held
' @param instCount - self-checks or end paths behind the result
'
' @local pVerdict - PASS, FAIL or NOMEAS token

    if bMeasured == FALSE
        pVerdict := @sSfNomeas
    elseif bCriterionMet == TRUE
        pVerdict := @sSfPass
    else
        pVerdict := @sSfFail
    benchLog.begin(@"SIGNOFF")
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.tokenField(@"bin", @sSfBinScan, TOKMAX_BIN)
    benchLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    benchLog.tokenField(@"task", pTask, TOKMAX_TASK)
    benchLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"crit", pCrit, TOKMAX_CRIT)
    if bMeasured
        benchLog.boolField(@"measured", bCriterionMet)
    else
        benchLog.textField(@"measured", @sNa)
    benchLog.textField(@"lo", @sTrue)
    benchLog.textField(@"hi", @sTrue)
    benchLog.tokenField(@"units", @sSfUnitsBool, TOKMAX_UNITS)
    if bMeasured
        benchLog.numField(@"n", instCount, LIM_SMALL)
    else
        benchLog.numField(@"n", 0, LIM_SMALL)
    benchLog.tokenField(@"verdict", pVerdict, TOKMAX_SFVERDICT)
    lineEmit()

PRI motorToken(side) : pTok
' Motor token for a side.
'
' @param side - SIDE_* value
' @returns pTok - LEFT, RIGHT or NONE

    case side
        SIDE_LEFT:
            pTok := @sMotLeft
        SIDE_RIGHT:
            pTok := @sMotRight
        other:
            pTok := @sMotNone

PRI speedToken(speedIdx) : pTok
' Speed token.
'
' @param speedIdx - SPEED_* value
' @returns pTok - QTR or HALF

    ' task 3595: a case with a real default, never a ternary. This file's token helpers fall through to
    '  a WRONG token rather than to "?", so a rung with no case of its own would silently print another
    '  rung's name -- which is how WS_DROOP first printed RUN_ABORT.
    case speedIdx
        SPEED_HALF:
            pTok := @sSpeedHalf
        SPEED_LOW:
            pTok := @sSpeedLow
        other:
            pTok := @sSpeedQtr

PRI signToken(signIdx) : pTok
' Increment-sign token.
'
' @param signIdx - SIGN_* value
' @returns pTok - NEG or POS

    pTok := (signIdx == SIGN_NEG) ? @sSignNeg : @sSignPos

PRI servedToken(signIdx) : pTok
' Name of the offset that serves a sign.
'
' @param signIdx - SIGN_* value
' @returns pTok - OFFSET_FWD for NEG, OFFSET_REV for POS

    pTok := (signIdx == SIGN_NEG) ? @sServedFwd : @sServedRev

PRI phaseToken(ptPhase) : pTok
' Point-phase token.
'
' @param ptPhase - PH_* value
' @returns pTok - phase token

    case ptPhase
        PH_SELF:
            pTok := @sPhSelf
        PH_REF_START:
            pTok := @sPhRefStart
        PH_COARSE:
            pTok := @sPhCoarse
        PH_FINE:
            pTok := @sPhFine
        PH_EXTEND:
            pTok := @sPhExtend
        PH_REF_END:
            pTok := @sPhRefEnd
        PH_CLIFF:
            pTok := @sPhCliff
        PH_ZERO_INIT:
            pTok := @sPhZeroInit
        PH_XSTART:
            pTok := @sPhXstart
        other:
            pTok := @sPhUnknown                             ' never mislabel an unlisted phase as ZERO_INIT

PRI resultToken(ptRes) : pTok
' Point-result token.
'
' @param ptRes - PR_* value
' @returns pTok - result token

    case ptRes
        PR_OK:
            pTok := @sPrOk
        PR_FAULT:
            pTok := @sPrFault
        PR_ABORT_I:
            pTok := @sPrAbortI
        PR_STEADY_TIMEOUT:
            pTok := @sPrSteadyTo
        PR_WINDOW_TIMEOUT:
            pTok := @sPrWindowTo
        other:
            pTok := @sPrNoCog

PRI walkStopToken(walkStop) : pTok
' Walk-stop token.
'
' @param walkStop - WS_* value
' @returns pTok - walk-stop token

    case walkStop
        WS_RISE:
            pTok := @sWsRise
        WS_FAULTS:
            pTok := @sWsFaults
        WS_HARD_LIMIT:
            pTok := @sWsHardLimit
        WS_DROOP:                                           ' task 3595: without this case the new stop prints RUN_ABORT
            pTok := @sWsDroop
        other:
            pTok := @sWsRunAbort

PRI boundTypeToken(boundType) : pTok
' Boundary-type token (task 3595): what STOPPED this side of the arc.
'
' @param boundType - BT_* value
' @returns pTok - boundary-type token

    case boundType
        BT_CURRENT:
            pTok := @sBtCurrent
        BT_TORQUE:
            pTok := @sBtTorque
        BT_RISE:
            pTok := @sBtRise
        BT_LIMIT:
            pTok := @sBtLimit
        other:
            pTok := @sBtNone

PRI bracketToken(reason) : pTok
' Bracket-verdict token.
'
' @param reason - BR_* value
' @returns pTok - bracket token

    case reason
        BR_OK:
            pTok := @sBrOk
        BR_EDGE_HARD_LIMIT:
            pTok := @sBrEdgeLimit
        BR_EDGE_FAULT:
            pTok := @sBrEdgeFault
        BR_NO_VALID:
            pTok := @sBrNoValid
        other:
            pTok := @sBrRunAbort

PRI fitToken(fitCode) : pTok
' Fit-status token.
'
' @param fitCode - FS_* value
' @returns pTok - fit token

    case fitCode
        FS_OK:
            pTok := @sFsOk
        FS_NOT_BRACKETED:
            pTok := @sFsNotBracket
        FS_NOT_CONVEX:
            pTok := @sFsNotConvex
        FS_TOO_FEW:
            pTok := @sFsTooFew
        FS_EDGE:
            pTok := @sFsEdge
        FS_POOR:
            pTok := @sFsPoor
        other:
            pTok := @sFsSkipped

PRI legExitToken(legExit) : pTok
' Leg-exit token.
'
' @param legExit - LX_* value
' @returns pTok - leg-exit token

    case legExit
        LX_DONE:
            pTok := @sLxDone
        LX_FAULT_CAP:
            pTok := @sLxFaultCap
        LX_RUN_ABORT:
            pTok := @sLxRunAbort
        other:
            pTok := @sLxSkipped

PRI reasonToken(reason) : pTok
' Abort-reason token.
'
' @param reason - AR_* value
' @returns pTok - reason token

    case reason
        AR_NONE:
            pTok := @sArNone
        AR_PREFLIGHT:
            pTok := @sArPreflight
        AR_START_FAIL:
            pTok := @sArStartFail
        AR_START_CHECK:
            pTok := @sArStartCheck
        AR_SELF_CHECK_MISS:
            pTok := @sArSelfMiss
        AR_ABS_CURRENT:
            pTok := @sArAbsCurrent
        AR_ABORT_I_CAP:
            pTok := @sArAbortICap
        AR_FAULT_CAP:
            pTok := @sArFaultCap
        AR_CHARGE_CAP:
            pTok := @sArChargeCap
        AR_TIME_CAP:
            pTok := @sArTimeCap
        AR_RECOVERY_FAIL:
            pTok := @sArRecovFail
        AR_LIB_ABORT:
            pTok := @sArLibAbort
        AR_INCRE_GUARD:
            pTok := @sArIncreGuard
        AR_OFFSET_READBACK:
            pTok := @sArOfsReadback
        AR_ABORT_I:
            pTok := @sArAbortI
        AR_WATCHDOG:
            pTok := @sArWatchdog
        other:
            pTok := @sArUnknown                             ' never mislabel an unlisted reason as ABORT_I

PRI scopeToken(scope) : pTok
' Abort-scope token.
'
' @param scope - SCOPE_* value
' @returns pTok - RUN, POINT or LEG

    case scope
        SCOPE_RUN:
            pTok := @sScopeRun
        SCOPE_POINT:
            pTok := @sScopePoint
        other:
            pTok := @sScopeLeg

PRI stepToken(fxStep) : pTok
' Fault-recovery step token.
'
' @param fxStep - FX_* value
' @returns pTok - step token

    case fxStep
        FX_ZERO_CMD:
            pTok := @sFxZeroCmd
        FX_RESET:
            pTok := @sFxReset
        FX_JOG:
            pTok := @sFxJog
        other:
            pTok := @sFxRestart

PRI missToken(missCode) : pTok
' Self-check first-miss token.
'
' @param missCode - MISS_* value
' @returns pTok - miss token

    case missCode
        MISS_NONE:
            pTok := @sMissNone
        MISS_START:
            pTok := @sMissStart
        MISS_ZERO:
            pTok := @sMissZero
        MISS_I_POS:
            pTok := @sMissIPos
        MISS_I_NEG:
            pTok := @sMissINeg
        MISS_RATIO:
            pTok := @sMissRatio
        MISS_RATE:
            pTok := @sMissRate
        MISS_INTEG:
            pTok := @sMissInteg
        other:
            pTok := @sMissFault

PRI boardToken(eBoardRev) : pTok
' Board-revision token.
'
' @param eBoardRev - REV_* value
' @returns pTok - REV_A, REV_B or UNKNOWN

    if eBoardRev == wheelL.REV_A
        pTok := @sBoardRevA
    elseif eBoardRev == wheelL.REV_B
        pTok := @sBoardRevB
    else
        pTok := @sBoardUnknown

PRI lineEmit()
' Emit the assembled record as exactly one debug line. One debug() statement carries at most
' 255 bytes of debug data; the whole record travels as a single zero-terminated string
' instead so wider records are never silently truncated by that limit. Brackets every BS-
' record's debug() with CP_EMIT (once, here, covering every emitter's call site).

    beat(CP_EMIT)
    debug(zstr_(benchLog.pLine()))
    beat(CP_EMIT)

PRI beat(checkpointId)
' Advance cog 0's heartbeat and record where it is. Called once per pass of every timed loop in
' this file, and immediately before AND after every direct wheelL./wheelR. call and every
' lineEmit(), so a watchdog-declared stall's last checkpoint pins it to one statement group
' (task 3534). Cog 0 only -- the watchdog cog must never call this, directly or through a
' function that does, or it would corrupt the very heartbeat it is watching.
' PARK (task 3537): once wdDeclaring is TRUE, beat() never returns. A cog 0 that was slow rather
' than dead (blocked past WD_STALL_MS, then resuming) would otherwise carry on after the watchdog
' stopped both wheels and ended the session, and could restart or command a wheel unwatched. Every
' motor command path (commandMotor, sideStart, sideStop, shutdownMotors, every sideXxx wrapper)
' passes through beat() before it reaches the library, so a parked cog 0 cannot command a motor.
' Mirrors test_bench_char.spin2's beat().
'
' @param checkpointId - CP_* naming the statement group cog 0 is now inside

    if wdDeclaring
        ' The watchdog has declared a stall, stopped both wheels and ended the session: park here
        ' forever. A repeat of WD_IDLE_MS, never one long waitms(): see WAITMS_MAX_MS.
        repeat
            waitms(WD_IDLE_MS)
    wdCheckpoint := checkpointId
    wdHeartbeat += 1

PRI checkpointToken(checkpointId) : pTok
' Checkpoint-id token, for the watchdog's own BS-WATCHDOG record.
'
' @param checkpointId - CP_* value
' @returns pTok - checkpoint token

    case checkpointId
        CP_INIT:
            pTok := @sCpInit
        CP_LOOP_WAITREADY:
            pTok := @sCpWaitReady
        CP_LOOP_ZERO:
            pTok := @sCpZero
        CP_LOOP_STEADY:
            pTok := @sCpSteady
        CP_LOOP_SETTLE:
            pTok := @sCpSettle
        CP_LOOP_WINDOW:
            pTok := @sCpWindow
        CP_LOOP_WAITSTOPPED:
            pTok := @sCpWaitStopped
        CP_LOOP_DRIVEFORMS:
            pTok := @sCpDriveForMs
        CP_LOOP_REST:
            pTok := @sCpRest
        CP_LOOP_COOL:
            pTok := @sCpCool
        CP_RECOVERY_ZERO:
            pTok := @sCpRcvZero
        CP_RECOVERY_RESET:
            pTok := @sCpRcvReset
        CP_RECOVERY_JOG:
            pTok := @sCpRcvJog
        CP_RECOVERY_RESTART:
            pTok := @sCpRcvRestart
        CP_LIB_COMMAND:
            pTok := @sCpLibCommand
        CP_LIB_START:
            pTok := @sCpLibStart
        CP_LIB_STOP:
            pTok := @sCpLibStop
        CP_LIB_COGRUN:
            pTok := @sCpLibCogRun
        CP_LIB_ISREADY:
            pTok := @sCpLibIsReady
        CP_LIB_ISSTOPPED:
            pTok := @sCpLibIsStopped
        CP_LIB_ISFAULT:
            pTok := @sCpLibIsFault
        CP_LIB_RESETFAULT:
            pTok := @sCpLibResetFlt
        CP_LIB_DRVSTATE:
            pTok := @sCpLibDrvState
        CP_LIB_TELEMETRY:
            pTok := @sCpLibTelemetry
        CP_LIB_PHASEV:
            pTok := @sCpLibPhaseV
        CP_LIB_TICKS:
            pTok := @sCpLibTicks
        CP_LIB_INTEGRITY:
            pTok := @sCpLibIntegrity
        CP_LIB_SETOFFSETS:
            pTok := @sCpLibSetOffs
        CP_LIB_GETOFFSETS:
            pTok := @sCpLibGetOffs
        CP_LIB_BOARDTYPE:
            pTok := @sCpLibBoardType
        CP_LIB_SHUTDOWN:
            pTok := @sCpLibShutdown
        CP_EMIT:
            pTok := @sCpEmit
        CP_LOOP_XSTART:
            pTok := @sCpXstart
        CP_LOOP_OWNZERO:
            pTok := @sCpOwnZero
        CP_SELFTEST:
            pTok := @sCpSelftest
        other:
            pTok := @sCpUnknown

PRI watchdog() | lastSeenBeat, lastChangeMs, msSinceBeat
' Watch cog 0's heartbeat from a second cog, task 3534. Sampled every WD_POLL_MS; declares a stall
' once wdHeartbeat has not advanced for WD_STALL_MS (see WD_STALL_MS's CON comment for the desk
' trace). Runs forever: after a stall is declared, declareStall() itself never returns.
'
' @local lastSeenBeat - wdHeartbeat at the previous sample
' @local lastChangeMs - getms() when wdHeartbeat last changed
' @local msSinceBeat - ms since wdHeartbeat last changed

    lastSeenBeat := wdHeartbeat
    lastChangeMs := getms()
    repeat
        waitms(WD_POLL_MS)
        if wdHeartbeat <> lastSeenBeat
            lastSeenBeat := wdHeartbeat
            lastChangeMs := getms()
        else
            msSinceBeat := getms() - lastChangeMs
            if msSinceBeat >= WD_STALL_MS
                declareStall(msSinceBeat)                   ' never returns

PRI declareStall(msSinceBeat) | bRunningBefore, bStoppedAfter
' Cog 0 has not advanced for at least WD_STALL_MS: snapshot its last checkpoint and both wheels'
' state, stop both wheels, THEN report, end the session, and idle forever. Runs in the watchdog cog.
' Touches a motor only from here on -- never before a stall is declared -- and calls wheelL.stop()/
' wheelR.stop() directly, never sideStop()/shutdownMotors(), which call beat() and would
' misattribute this cog's activity to cog 0's heartbeat. Sets wdDeclaring TRUE as its very first
' act, before touching anything else, so main() (which checks wdDeclaring right before it would
' otherwise cogstop this cog) can never observe this cog mid-record.
' fmt 9 (task 3537 phase 2c, both builds): the wheels are stopped BEFORE any record is emitted, the
' order test_bench_char.spin2 uses -- before fmt 9, BS-WATCHDOG/BS-WATCHDOG2 went out while both
' drivers still ran. Those two records still carry the pre-stop values, from wdSnapshotStall().
'
' @param msSinceBeat - ms since wdHeartbeat last changed
'
' @local bRunningBefore - TRUE when either wheel had a driver cog before the stops (R11-WDT-STOPPED)
' @local bStoppedAfter - TRUE when neither wheel has a driver cog after the stops (R11-WDT-STOPPED)

    wdDeclaring := TRUE
    wdSnapshotStall()                                       ' checkpoint and both wheels' state, BEFORE the stops
    bRunningBefore := (wdSnapLeftCog <> 0) or (wdSnapRightCog <> 0)
    wdLog.cogEventBegin()
    wheelL.stop()
    wheelR.stop()
    bStoppedAfter := (wheelL.testGetMotorCog() == 0) and (wheelR.testGetMotorCog() == 0)
    emitWatchdog(msSinceBeat)                               ' from the snapshot: pre-stop cog ids and telemetry
#ifdef WD_SELFTEST
    ' Task 3537 phase 2c (design sec G.4): the self-test's four verdicts, from this non-zero cog, through
    ' the watchdog's own builder, wdLog. STACK is last, so its sentinel read follows the deepest chain (43 longs, see
    ' WD_STACK_LONGS), which wdEmitSignoff()'s measured field has just run.
    wdEmitSignoff(@sSfCellWdtFires, @sSfTaskNoStall, SIDE_NONE, @sSfCritStallMs, TRUE, msSinceBeat, ...
        WDT_FIRES_LO_MS, WDT_FIRES_HI_MS, @sSfUnitsMs, SIGNOFF_ONE_INSTANCE)
    wdEmitSignoffBool(@sSfCellWdtCkpt, @sSfTaskNoStall, SIDE_NONE, @sSfCritCkptSelf, TRUE, (wdSnapCheckpoint == CP_SELFTEST), SIGNOFF_ONE_INSTANCE)
    wdEmitSignoffBool(@sSfCellWdtStop, @sSfTaskNoStall, SIDE_NONE, @sSfCritWheelsSt, TRUE, bRunningBefore and bStoppedAfter, SIGNOFF_ONE_INSTANCE)
    wdEmitSignoffBool(@sSfCellWdtStack, @sSfTaskNoStall, SIDE_NONE, @sSfCritStackOk, TRUE, (wdStackSentinel == WD_STACK_SENTINEL), SIGNOFF_ONE_INSTANCE)
#else
    ' Task 3537 (design sec G.4, normal build): a real stall is a recorded failure of task 3534's
    ' certification. Emitted from this cog through its own builder, wdLog, never cog 0's benchLog.
    wdEmitSignoffBool(@sSfCellNoStall, @sSfTaskNoStall, SIDE_NONE, @sSfCritCog0End, TRUE, FALSE, SIGNOFF_ONE_INSTANCE)
#endif
    wdEmitEnd()
    ' QUOTED, not backticked -- matches main()'s own marker exactly (a backtick makes it a
    ' display command and the marker is missed).
    debug("DEBUG_END_SESSION")
    ' A repeat of WD_IDLE_MS, not one waitms(60_000): see main()'s matching comment -- 60_000 ms
    ' overflows WAITMS_MAX_MS's ~7_953 ms bound at 270 MHz (p2kbSpin2Waitms).
    repeat
        waitms(WD_IDLE_MS)

PRI wdSnapshotStall()
' Snapshot, from the watchdog cog, every value BS-WATCHDOG/BS-WATCHDOG2 report that the stops would
' change (task 3537 phase 2c): cog 0's checkpoint, and each wheel's cog id, driver state, fault flag,
' duty, err, sense and ticks. stop() zeroes testGetMotorCog() and sets drv_state to DCS_Unknown, so a
' read after the stops would change what those records say. Direct wheelL/wheelR getters, in
' emitWatchdog()'s pre-fmt-9 read order -- never a sideXxx() wrapper, which calls beat().

    wdSnapCheckpoint := wdCheckpoint
    wdSnapLeftDuty, wdSnapLeftErr, wdSnapLeftSense, _, _, _, _, _ := wheelL.testGetTelemetry()
    wdSnapRightDuty, wdSnapRightErr, wdSnapRightSense, _, _, _, _, _ := wheelR.testGetTelemetry()
    wdSnapLeftCog := wheelL.testGetMotorCog()
    wdSnapLeftState := wheelL.getDriverState()
    wdSnapLeftFault := wheelL.isFaultSignal()
    wdSnapLeftTicks := wheelL.getRawHallTicks()
    wdSnapRightCog := wheelR.testGetMotorCog()
    wdSnapRightState := wheelR.getDriverState()
    wdSnapRightFault := wheelR.isFaultSignal()
    wdSnapRightTicks := wheelR.getRawHallTicks()

PRI emitWatchdog(msSinceBeat)
' Emit BS-WATCHDOG and BS-WATCHDOG2 from the watchdog cog: cog 0's last checkpoint and its own
' sampling-loop state, then both wheels' raw driver telemetry. fmt 9: the checkpoint and every wheel
' field come from wdSnapshotStall()'s pre-stop snapshot (declareStall() now stops the wheels first), so
' the fields, order and meaning are unchanged. Never through the sideXxx()/commandMotor() wrappers,
' which call beat() and would corrupt the heartbeat being reported on. Uses the watchdog's own
' builder, wdLog, never benchLog (cog 0 may be mid-record). Two records, not one: the
' combined fields would exceed the 280-byte bound. BS-WATCHDOG2's LAST field, stack_ok, reports
' whether wdStackSentinel (filled before cogspin, WD_STACK_SENTINEL's CON comment) is still
' intact -- cogspin does not detect a stack overflow itself, and this stall path is the one call
' chain that cannot be exercised off the bench (p2kbAppNoteP2an006SizingCogTaskStacks).
'
' @param msSinceBeat - ms since wdHeartbeat last changed

    wdLog.begin(@"BS-WATCHDOG")
    wdLog.numField(@"checkpoint", wdSnapCheckpoint, LIM_TINY)
    wdLog.tokenField(@"checkpoint_tok", checkpointToken(wdSnapCheckpoint), TOKMAX_CP)
    wdLog.numField(@"since_ms", msSinceBeat, LIM_MID)
    wdLog.numField(@"heartbeat", wdHeartbeat, LIM_MID)
    wdLog.numField(@"seq", pointSeq, LIM_TINY)
    wdLog.tokenField(@"side", motorToken(currentSide), TOKMAX_MOTOR)
    wdLog.tokenField(@"pt_result", resultToken(ptResult), TOKMAX_RESULT)
    wdLog.numField(@"samp_state", sampState, LIM_TINY)
    wdLog.boolField(@"fault_seen", bSampFaultSeen)
    wdLog.boolField(@"pt_abort", bSampPointAbort)
    wdLog.boolField(@"no_cog", bSampNoCog)
    wdLog.tokenField(@"reason", reasonToken(abortReason), TOKMAX_REASON)
    wdLineEmit()

    wdLog.begin(@"BS-WATCHDOG2")
    wdLog.numField(@"l_cog", wdSnapLeftCog, LIM_TINY)
    wdLog.numField(@"l_state", wdSnapLeftState, LIM_TINY)
    wdLog.boolField(@"l_fault", wdSnapLeftFault)
    wdLog.numField(@"l_duty", wdSnapLeftDuty, LIM_SMALL)
    wdLog.numField(@"l_err", wdSnapLeftErr, LIM_TINY)
    wdLog.numField(@"l_sense_mV", wdSnapLeftSense, LIM_SMALL)
    wdLog.numField(@"l_ticks", wdSnapLeftTicks, LIM_MID)
    wdLog.numField(@"r_cog", wdSnapRightCog, LIM_TINY)
    wdLog.numField(@"r_state", wdSnapRightState, LIM_TINY)
    wdLog.boolField(@"r_fault", wdSnapRightFault)
    wdLog.numField(@"r_duty", wdSnapRightDuty, LIM_SMALL)
    wdLog.numField(@"r_err", wdSnapRightErr, LIM_TINY)
    wdLog.numField(@"r_sense_mV", wdSnapRightSense, LIM_SMALL)
    wdLog.numField(@"r_ticks", wdSnapRightTicks, LIM_MID)
    wdLog.boolField(@"stack_ok", (wdStackSentinel == WD_STACK_SENTINEL))
    wdLineEmit()

PRI wdEmitEnd()
' Emit BS-END from the watchdog cog, forced to exit ABORTED, reason WATCHDOG. Mirrors emitEnd()'s
' fields and order exactly (an existing record's fields never change) but assembles them with
' the watchdog's own builder, and never calls flushCharge() -- that mutates cog 0's
' sampChargeMvMs, which is unsafe to touch from this cog. charge_mVs may therefore lag cog 0's
' own emitEnd() by at most one unflushed sample; immaterial on a fault record.

    wdLog.begin(@"BS-END")
    wdLog.tokenField(@"exit", @sExitAborted, TOKMAX_EXIT)
    wdLog.tokenField(@"reason", @sArWatchdog, TOKMAX_REASON)
    wdLog.numField(@"elapsed_s", (getms() - runStartMs) / MS_PER_SEC, LIM_SMALL)
    wdLog.numField(@"points", pointSeq, LIM_TINY)
    wdLog.numField(@"faults", runFaults, LIM_TINY)
    wdLog.numField(@"aborts_i", runAbortsI, LIM_TINY)
    wdLog.numField(@"charge_mVs", runChargeMvS, LIM_MID)
    wdLog.boolField(@"left_done", bLeftDone)
    wdLog.boolField(@"right_done", bRightDone)
    wdLog.boolField(@"lib_abort", FALSE)
    wdLineEmit()

PRI wdEmitSignoffBool(pCell, pTask, side, pCrit, bMeasured, bCriterionMet, instCount) | pVerdict
' Emit one boolean SIGNOFF verdict from the watchdog cog (task 3537). Mirrors emitSignoffBool()
' field for field against the watchdog's own builder, wdLog, never benchLog (cog 0 may be
' stalled mid-record). Calls nothing that beats: motorToken() and the builder only return or read
' DAT text. Worst case: identical to emitSignoffBool(), 173 bytes.
'
' @param pCell - pointer to the cell id token
' @param pTask - pointer to the owning todo-mcp task id, as plain text
' @param side - SIDE_* the instance belongs to
' @param pCrit - pointer to the criterion token
' @param bMeasured - TRUE when the instance was measured
' @param bCriterionMet - TRUE when the whole criterion held
' @param instCount - self-checks or end paths behind the result
'
' @local pVerdict - PASS, FAIL or NOMEAS token

    if bMeasured == FALSE
        pVerdict := @sSfNomeas
    elseif bCriterionMet == TRUE
        pVerdict := @sSfPass
    else
        pVerdict := @sSfFail
    wdLog.begin(@"SIGNOFF")
    wdLog.numField(@"sf", SF_VERSION, LIM_TINY)
    wdLog.tokenField(@"bin", @sSfBinScan, TOKMAX_BIN)
    wdLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    wdLog.tokenField(@"task", pTask, TOKMAX_TASK)
    wdLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    wdLog.tokenField(@"crit", pCrit, TOKMAX_CRIT)
    if bMeasured
        wdLog.boolField(@"measured", bCriterionMet)
    else
        wdLog.textField(@"measured", @sNa)
    wdLog.textField(@"lo", @sTrue)
    wdLog.textField(@"hi", @sTrue)
    wdLog.tokenField(@"units", @sSfUnitsBool, TOKMAX_UNITS)
    if bMeasured
        wdLog.numField(@"n", instCount, LIM_SMALL)
    else
        wdLog.numField(@"n", 0, LIM_SMALL)
    wdLog.tokenField(@"verdict", pVerdict, TOKMAX_SFVERDICT)
    wdLineEmit()

PRI wdEmitSignoff(pCell, pTask, side, pCrit, bMeasured, measuredVal, loLimit, hiLimit, pUnits, instCount) | boundedVal, pVerdict
' Emit one numeric SIGNOFF verdict from the watchdog cog (task 3537 phase 2c, design sec B.3). Mirrors
' emitSignoff() field for field against the watchdog's own builder, wdLog, never benchLog (cog 0 may
' be stalled mid-record). Calls nothing that beats: motorToken() and the builder only return or read DAT
' text. Worst case: identical to emitSignoff(), 196 bytes.
'
' @param pCell - pointer to the cell id token
' @param pTask - pointer to the owning todo-mcp task id, as plain text
' @param side - SIDE_* the instance belongs to
' @param pCrit - pointer to the criterion token
' @param bMeasured - TRUE when the instance was measured
' @param measuredVal - the instance's measured value
' @param loLimit - lowest passing value, compiled in
' @param hiLimit - highest passing value, compiled in
' @param pUnits - pointer to the units token
' @param instCount - declarations behind measuredVal
'
' @local boundedVal - measuredVal clamped to +/-LIM_BIG
' @local pVerdict - PASS, FAIL or NOMEAS token

    boundedVal := (measuredVal #> (0 - LIM_BIG)) <# LIM_BIG
    if bMeasured == FALSE
        pVerdict := @sSfNomeas
    elseif (boundedVal >= loLimit) and (boundedVal <= hiLimit)
        pVerdict := @sSfPass
    else
        pVerdict := @sSfFail
    wdLog.begin(@"SIGNOFF")
    wdLog.numField(@"sf", SF_VERSION, LIM_TINY)
    wdLog.tokenField(@"bin", @sSfBinScan, TOKMAX_BIN)
    wdLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    wdLog.tokenField(@"task", pTask, TOKMAX_TASK)
    wdLog.tokenField(@"motor", motorToken(side), TOKMAX_MOTOR)
    wdLog.tokenField(@"crit", pCrit, TOKMAX_CRIT)
    wdLog.naNumField(@"measured", boundedVal, LIM_BIG, bMeasured)
    wdLog.numField(@"lo", loLimit, LIM_BIG)
    wdLog.numField(@"hi", hiLimit, LIM_BIG)
    wdLog.tokenField(@"units", pUnits, TOKMAX_UNITS)
    if bMeasured
        wdLog.numField(@"n", instCount, LIM_SMALL)
    else
        wdLog.numField(@"n", 0, LIM_SMALL)
    wdLog.tokenField(@"verdict", pVerdict, TOKMAX_SFVERDICT)
    wdLineEmit()

PRI wdLineEmit()
' Emit the assembled watchdog record as one debug line. Mirrors lineEmit(), against the watchdog's own wdLog.

    debug(zstr_(wdLog.pLine()))

