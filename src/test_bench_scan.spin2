sPhSelf         BYTE    "SELF", 0
sPhRefStart     BYTE    "REF_START", 0
sPhCoarse       BYTE    "COARSE", 0
sPhFine         BYTE    "FINE", 0
sPhExtend       BYTE    "EXTEND", 0
