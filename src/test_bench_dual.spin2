CON { operator panel -- hand-written companions to the generated geometry (design sec 8) }

    PNL_BTN_NONE     = -1                                   ' no button chosen, or none drawn highlighted
    PNL_NO_COUNTDOWN = -1                                   ' the countdown digits are blank
    PNL_DEC_RADIX    = 10
    ' live-button masks: bit BM_BTN_* set when that button may be chosen
    PNL_LIVE_NONE    = 0
    PNL_LIVE_START   = DECOD BM_BTN_START
    PNL_LIVE_SKIP    = DECOD BM_BTN_SKIP
    PNL_LIVE_STOP    = DECOD BM_BTN_STOP
    PNL_LIVE_ANSWERS = DECOD BM_BTN_LEFT | DECOD BM_BTN_RIGHT | DECOD BM_BTN_STRAIGHT | DECOD BM_BTN_NOMOVE

  ' PC_MOUSE fills seven consecutive longs, in this order (p2kbSpin2DbgPcMouse):
  '  MOUSE_XPOS  - pointer x in window pixels (DOTSIZE 1), < 0 outside the window
  '  MOUSE_YPOS  - pointer y in window pixels, < 0 outside the window
  '  MOUSE_WHEEL - wheel delta
  '  MOUSE_LBTN  - left button: 0 up, -1 pressed
  '  MOUSE_MBTN  - middle button
  '  MOUSE_RBTN  - right button
  '  MOUSE_PIXEL - colour under the pointer
    #0, MOUSE_XPOS, MOUSE_YPOS, MOUSE_WHEEL, MOUSE_LBTN, MOUSE_MBTN, MOUSE_RBTN, MOUSE_PIXEL
    MOUSE_LONGS = 7

  ' BM-OPER queue row. A BM-OPER noted while the instrument stores samples is emitted by operFlush() once
  ' it is not (design sec 2.6):
  '  OQ_PROMPT - PROMPT_* value
  '  OQ_EVENT  - OPEV_* value
  '  OQ_ANSWER - ANS_* value
  '  OQ_INPUT  - INPUT_* value
  '  OQ_WAIT   - ms since the prompt was shown
  '  OQ_WHY    - WHY_* value
    #0, OQ_PROMPT, OQ_EVENT, OQ_ANSWER, OQ_INPUT, OQ_WAIT, OQ_WHY
    OQ_LONGS       = 6
    OPER_QUEUE_MAX = 8                                      ' at most 3 notes fall between two flushes

