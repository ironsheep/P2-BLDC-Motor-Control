    LONG    trIdleMove                                      ' IDLEMOVE: largest hwPos travel of the other motor over the trace
    LONG    trStopTicks                                     ' STPDECEL: |pos(rest) - pos(mark)| of the primary motor
    LONG    bTrStopValid                                    ' the trace found both a mark and a rest

VAR { sign-off accumulators (design sec 5.2) -- cog 0 only; index = motor slot }

    LONG    sfStarts[INST_MOTORS]                           ' REVB/INTEG: wheel starts
    LONG    sfNotRevb[INST_MOTORS]
    LONG    sfIntegSum[INST_MOTORS]                         ' saturates at LIM_BIG
