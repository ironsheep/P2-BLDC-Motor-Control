' BM-PLAN finds, per segment (finding ids joined by "_"), indexed by SEG_*
tokFinds        BYTE    "NONE", 0, "NONE", 0, "C-4_S-9a", 0, "W", 0, "C-1_C-5_S-3_C-6", 0, "S-3", 0
                BYTE    "C-5_Z_S-1", 0, "C-3_AB", 0, "M_AF_S-5_Z", 0, "FIELD_Q", 0, "S-9a", 0, "AC", 0
                BYTE    "UI", 0, "S-4_FRONTCOG_S-8_PL138", 0, "S-2_C-5", 0
                ' PL-97: these last two close a table that was SHORT of SEG_COUNT. tokenAt() bounds on
                '  the ENUM count, not the table length, so SEG_LOWSPD already indexed past the end and
                '  returned whatever DAT followed -- masked only because BM-PLAN never emitted a LOWSPD
                '  row (the earlier study's F1). Adding SEG_ALIGN would have made it two rows, not one.
                BYTE    "LOWSPD_F12", 0, "HALL_ZERO_Z", 0
                ' PL-97's third instance: LEAD and TAKE joined the enum without rows here, so a LEAD build's
                '  BM-PLAN printed finds "?" and est 0 (debug_260922-164207.log). Filled with the rows below.
                BYTE    "LEAD_TABLE", 0, "A-6_A-8", 0
                BYTE    "E1_E2_TOP", 0, "E3_RAMPS", 0, "E4_FLOOR", 0
                ' task 3613: FLTRESP carries X-2, X-3, X-4 and prints X-6 and the startup study's B-4 as NOT_BUILT
                BYTE    "X-2_X-3_X-4_X-6_B-4", 0, "X-5_PL-117", 0
                ' task 3613: SKCHECK carries B-2 and B-5; B-1 and B-3's and B-5's negatives are attended loads of the same part
                BYTE    "B-1_B-2_B-3_B-5", 0
                ' task 3591: SPIN carries the offsets under load and A-1 A-2 A-3 A-4 and A-8 loaded (SRC_REV 62: X-5 and PL-93
                '  moved to FAULTRUN); INCLINE (was CREEP) sizes task 3608's hold ceiling (SRC_REV 63: the hold on a slope
                '  only; GRAB alone proves the overload hold)
                BYTE    "OFFS_A1-4_A8", 0, "HOLD_CEIL_3608", 0
                ' task 3611: PACK carries R20.4 -- the pack sensor's meter pairs, its absent reading and R20-PACK-EV
                BYTE    "R20.4_PACK_SENSOR", 0
                ' SRC_REV 54: REGRESS carries PL-151's part-B half (AB's turn, S-7's cause) and PL-66's retry; KICK carries
                '  the speed-change kick at the top of the range (PL-78, PL-87)
                BYTE    "PL-151_AB_S-7_PL-66", 0, "PL-78_PL-87_KICK", 0
                ' SRC_REV 58: BLOCK carries the protective stop on a chocked wheel (PL-106), its clear through the API (PL-111's
                '  precondition), the bridge it leaves (PL-132) and AT_SPEED at a held field (PL-95); LOAD the path limiter and
                '  the overload hold under a drag (PL-150) and PL-95 again. SRC_REV 62: BLOCK is OBSTACLE (both wheels driven
                '  into an obstacle), LOAD is GRAB (one side held back; PL-144's hunting too; SRC_REV 63: the overload
                '  hold's only proof), and FAULTRUN carries PL-93 and
                '  X-5 (PL-117) on a straight run
                BYTE    "PL-106_111_132_95", 0, "PL-150_144_95", 0, "PL-93_X-5_PL-117", 0
                ' SRC_REV 70: RAMP -- the floor session's ramp legs: what the jerk-limited ramp achieves on the floor at three
                '  acceleration and three deceleration settings (PL-160, Plan A R16)
                BYTE    "PL-160_RAMPS", 0, TOK_END

' BM-PLAN's planned seconds (est_s, design sec 4.4) and worst-case log KB (est_kb, sec 12.4), one row per SEG_* in enum
'  order, read by emitPlan() (SRC_REV 71: two lookupz() lists there, which no pass could count; the rows are the same
'  numbers). A row is its two words; the row after the last is EST_END twice, and the self-check counts rows to it. The reasons
'  behind the figures are in emitPlan()'s notes.
estPlan         WORD    0, 0                                    ' SEG_NONE
                WORD    5, 2                                    ' SEG_PREFLT
                WORD    540, 4_700                              ' SEG_STOPMODE
                WORD    60, 3                                   ' SEG_LIVE
                WORD    420, 190                                ' SEG_LADDER
                WORD    60, 8                                   ' SEG_CLOCK
                WORD    420, 1_960                              ' SEG_FAULTB
                WORD    150, 420                                ' SEG_OVERSHT
                WORD    120, 130                                ' SEG_OUTSIDE
                WORD    120, 16                                 ' SEG_BASELINE
                WORD    120, 790                                ' SEG_POSTFLT
                WORD    180, 1_180                              ' SEG_FLOOR
                WORD    120, 100                                ' SEG_UICHECK
                WORD    240, 6                                  ' SEG_STEERSEG
                WORD    180, 6                                  ' SEG_LIMIT
                WORD    160, 30                                 ' SEG_LOWSPD
                WORD    240, 25                                 ' SEG_ALIGN
                WORD    270, 135                                ' SEG_LEAD
                WORD    20, 1                                   ' SEG_TAKE
                WORD    380, 1_080                              ' SEG_LIMTOP (SRC_REV 79: was 360, 90; the eight study traces are 990 of it)
                WORD    300, 1_950                              ' SEG_LIMRAMP
                WORD    360, 45                                 ' SEG_LIMLOW
                WORD    320, 2_330                              ' SEG_FLTRESP
                WORD    30, 200                                 ' SEG_FLTPLAT
                WORD    60, 25                                  ' SEG_SKCHECK
                WORD    200, 120                                ' SEG_SPIN
                WORD    120, 10                                 ' SEG_INCLINE
                WORD    150, 5                                  ' SEG_PACK
                WORD    40, 230                                 ' SEG_REGRESS
                WORD    90, 45                                  ' SEG_KICK
                WORD    90, 230                                 ' SEG_OBSTACLE
                WORD    180, 330                                ' SEG_GRAB
                WORD    60, 120                                 ' SEG_FAULTRUN
                WORD    30, 10                                  ' SEG_RAMP
                WORD    EST_END, EST_END

