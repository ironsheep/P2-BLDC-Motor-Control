    LONG    bSfStopCurOk[INST_MOTORS]
    LONG    bSfDroopRan[INST_MOTORS]                        ' RMPDROOP: the three steep-ramp trials
    LONG    bSfDroopOk[INST_MOTORS]
    LONG    sfStopLimMax                                    ' STOPLIM: largest |rest - target| over every trial
    LONG    sfStopLimN
    LONG    sfTurnMax                                       ' TURNDIST: largest |rest - own target| over the turn trials
    LONG    sfTurnN
    LONG    bSfDistMRan                                     ' DISTM: getDistance(DDU_M) against the ticks
    LONG    bSfDistMOk
    LONG    bSfRetryRan                                     ' FLTRETRY: PL-66's same-power retry
    LONG    bSfRetryOk
    LONG    sfDecelTicks[INST_MOTORS]                       ' STPDECEL: half-speed stop, mark to rest
    LONG    bSfDecelRan[INST_MOTORS]
    LONG    bSfDStepRan[DST_COUNT]                          ' part D: one (ran, ok) per BM-DSTEP step
    LONG    bSfDStepOk[DST_COUNT]
    LONG    bSfWDStepRan[DST_COUNT]                         ' the same steps repeated on the single wheel
    LONG    bSfWDStepOk[DST_COUNT]
    LONG    bSfLimRan[INST_MOTORS]                          ' FOLDBACK and DERATE, per motor
    LONG    bSfLimOk[INST_MOTORS]
    LONG    bSfDerateRan[INST_MOTORS]
    LONG    bSfDerateOk[INST_MOTORS]
    LONG    bSfFrontRan[INST_MOTORS]                        ' FRONTST: slot 0 the steering front cog, slot 1 the wheel's
    LONG    bSfFrontOk[INST_MOTORS]
    LONG    sfIdleMoveMax[INST_MOTORS]                      ' IDLEMOVE (task 3572): the other wheel's largest travel, per primary motor
    LONG    sfIdleMoveN[INST_MOTORS]                        ' motor-frame traces folded
    LONG    sfFltStopTicks[INST_MOTORS * MODE_COUNT]        ' FLTSTOP (task 3572): [slot * MODE_COUNT + mode] provocation-to-rest ticks
    LONG    bSfFltStopRan[INST_MOTORS * MODE_COUNT]
    LONG    sfHallIllegal[INST_MOTORS]                      ' HALL (task 3571): %000 + %111 entries over this clock's lifetimes
    LONG    sfHallLives[INST_MOTORS]                        ' lifetimes folded into sfHallIllegal

VAR { operator panel and attended-segment staging -- cog 0 only }

    LONG    panelKey                                        ' PC_KEY's reading, 0 when no key is latched
    LONG    panelMouse[MOUSE_LONGS]                         ' PC_MOUSE's seven longs: one array, so adjacent by construction
    LONG    bPanelKeyArmed                                  ' a 0 key reading was seen since the last key taken
    LONG    bPanelMouseArmed                                ' a released left button was seen since the last click taken
    LONG    uiPressX                                        ' x of the last left-button press, as PC_MOUSE reported it
    LONG    uiPressY                                        ' y of the last left-button press, as PC_MOUSE reported it
    LONG    bUiPressSeen                                    ' a press was seen since uiPressReset()
    LONG    bPanelUp                                        ' panelSetup() ran: the panel is drawn, polled and beating
    LONG    pnlScreen                                       ' BM_SCR_* on screen; its prompt cell has the same index
    LONG    pnlState                                        ' BM_STATE_* on screen
    LONG    pnlDrawn                                        ' mask of the buttons drawn (a preview draws a screen's own buttons dead)
    LONG    pnlLive                                         ' mask of the buttons that may be chosen
    LONG    pnlPressed                                      ' BM_BTN_* drawn highlighted, PNL_BTN_NONE when none
    LONG    pnlStrip                                        ' BM_STRIP_* row drawn in the verdict strip
    LONG    pnlSeconds                                      ' countdown on screen, PNL_NO_COUNTDOWN when blank
    LONG    bPnlCountdownLive                               ' the countdown runs (FALSE on a preview, which shows its start)
    LONG    pnlHeart                                        ' heartbeat cell on screen, 0 or 1
    LONG    pnlBeatMs                                       ' getms() of the last heartbeat change
    LONG    pnlInputMs                                      ' getms() of the last STOP poll during motion
    LONG    operPromptCode                                  ' PROMPT_* of the sequence on screen, for a BM-OPER STOP note
    LONG    operShownMs                                     ' getms() when the prompt now on screen was shown
    LONG    operQueue[OPER_QUEUE_MAX * OQ_LONGS]            ' BM-OPER records noted and not yet emitted
    LONG    operQueueCount
    LONG    bOutMarked                                      ' OUTSIDE: the fault mark was written, so the trace has a mark
    LONG    flRunMs                                         ' BM-FLOOR
    LONG    flAnswer
    LONG    flInput
    LONG    flLeftRateX10
    LONG    flRightRateX10
    LONG    bFlRates
    LONG    flSlower
    LONG    flStopBy
    LONG    flLeftPwr                                       ' BM-STRACE: getPower() read back after driveDirection()
    LONG    flRightPwr
    LONG    bFlDrove                                        ' driveDirection() was called

VAR { part D: the ordered-stop helper cog (task 3560) }

' The ORDERED step needs a SECOND cog commanding the platform while cog 0 stops it, because the property
'  under test -- that a stop ordered during another cog's drive leaves both wheels in one state -- cannot
'  arise from a single cog's calls. The helper only drives; every stop, every reading and every record
'  stays on cog 0.
    LONG    odStack[D_ORDERED_STACK_LONGS]
    LONG    odCogId                                         ' cogspin()'s return; < 0 when it failed
    LONG    bOdRun                                          ' cog 0 raises this to start driving, lowers it to end
    LONG    odDrives                                        ' drive calls the helper has made
    LONG    odLastErr                                       ' the last drive call's return, read after the step
    LONG    bOdDone                                         ' the helper has left its loop

VAR { watchdog cog }

    LONG    wdStack[WD_STACK_LONGS]
    LONG    wdStackSentinel                                 ' MUST abut wdStack (P2AN006); checked on the stall path
    LONG    wdCogId
    LONG    wdSeq                                           ' the watchdog's record seq, from logSeq at declaration
    LONG    wdSnapCheckpoint
    LONG    wdSnapLeftCog
    LONG    wdSnapRightCog
    LONG    wdSnapSteerUp
    LONG    wdSnapInstState
    LONG    wdSnapDuty[INST_MOTORS]
    LONG    wdSnapErr[INST_MOTORS]
    LONG    wdSnapSenseI[INST_MOTORS]
    LONG    wdSnapState[INST_MOTORS]
    LONG    wdSnapFault[INST_MOTORS]
    LONG    wdSnapPos[INST_MOTORS]

PUB main() | trapCode
'' Run this build's part of the motion harness, then stop every cog it started and end the session.
''

' Local Variables:
' @local trapCode - value delivered by the one top-level trap around runPart() (I9)

    initRunState()
    wdStackSentinel := WD_STACK_SENTINEL                    ' in place before the cog that could overrun it
    benchLog.cogEventBegin()
    wdCogId := cogspin(NEWCOG, watchdog(), @wdStack)
    benchLog.cogEventEnd()
    emitWdStart(wdCogId >= 0, wdCogId)
    emitHeaderRecords()
    instStart()
    bRunReturned := FALSE
    trapCode := \runPart()                                  ' the ONLY trap in this file (I9)
    runTrapCode := trapCode
    instIdleForShutdown()                                   ' I10: no wheel is stopped under a reading instrument
    shutdownAll()
    instStop()
    ' The watchdog is stopped only when it is not declaring (test_bench_scan.spin2 main()); if it is,
    '  its records are the session's end and cog 0 parks without emitting.
    if wdDeclaring == FALSE
        if wdCogId >= 0
            benchLog.cogEventBegin()
            cogstop(wdCogId)
        emitLagAll()                                        ' one BM-LAG per motor, covering every capture this part took
        emitSignoffs()
        emitTrap(trapCode, bRunReturned)
        emitEnd(bRunAborted ? EXIT_ABORTED : EXIT_COMPLETE)
        ' QUOTED, not backticked: a backtick makes it a display command and the marker is missed
        debug("DEBUG_END_SESSION")
    else
        repeat
            waitms(WD_IDLE_MS)

PRI initRunState() | slotIdx
' Reset every run-wide counter, lifetime slot and sign-off accumulator before anything is emitted.
'
' @local slotIdx - motor slot

    beat(CP_INIT)
    logSeq := 0
    runStartMs := getms()
    bRunAborted := FALSE
    bRunReturned := FALSE
    runTrapCode := 0
    runFaults := 0
    unrecovTotal := 0
    segsRun := 0
    lastSeg := SEG_NONE
    curSeg := SEG_NONE
    curTid := 0
    curIncre := 0
    lastStartMs := runStartMs
    bAnyStart := FALSE
    lifeSeq := 0
    traceSeq := 0
    rungSeq := 0
    steerSeq := 0
    steerLife := 0
    bSteerUp := FALSE
    instBusyRefusals := 0
    instCogId := -1
    instCmdSeq := 0
    instAckSeq := 0
    instState := INST_ST_IDLE
    instSrc := INST_SRC_NONE
    instDecimate := 1
    sfTraces := 0
    sfTraceLost := 0
    bSfFltApiRan := FALSE
    bSfFltApiOk := FALSE
    fltLeftInc := 0
    fltRightInc := 0
    fltFaultMs := 0
    fltLatchMs := 0
    bSfBrakeRan := FALSE
    bSfBrakeSeen := FALSE
    bSfFloorRan := FALSE
    bSfFloorAnswered := FALSE
    bSfUiRan := FALSE
    bSfUiOk := FALSE
    uiStepCount := 0
    sfStopLimMax := 0
    sfStopLimN := 0
    sfTurnMax := 0
    sfTurnN := 0
    bSfDistMRan := FALSE
    bSfDistMOk := TRUE                                      ' ANDed over the trials that run; NOMEAS until one does
    bSfRetryRan := FALSE
    bSfRetryOk := FALSE
    fltRetryErr := 0
    fltRetryMs := 0
    bFltRetryOk := FALSE
    bInstLagExempt := FALSE
    odCogId := -1
    bOdRun := FALSE
    bOdDone := FALSE
    odDrives := 0
    odLastErr := 0
    repeat slotIdx from 0 to DST_COUNT - 1
        bSfDStepRan[slotIdx] := FALSE
        bSfDStepOk[slotIdx] := FALSE
        bSfWDStepRan[slotIdx] := FALSE
        bSfWDStepOk[slotIdx] := FALSE
    uiPressReset()
    outCount := 0
    operQueueCount := 0
    bPanelUp := FALSE
    pnlPressed := PNL_BTN_NONE
    pnlSeconds := PNL_NO_COUNTDOWN
    operPromptCode := PROMPT_BRAKE_L
    bOutMarked := FALSE
    bFlDrove := FALSE
    bQuietMasks := (user.MOTOR_DBG_MASK == QUIET_DBG_MASK) and (user.STEER_DBG_MASK == QUIET_DBG_MASK)
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        slotLife[slotIdx] := 0
        bSlotRetired[slotIdx] := FALSE
        lifeZeroX10[slotIdx] := 0
        lifePhX10[slotIdx] := 0
        bLifeZeroValid[slotIdx] := FALSE
        bBrakeRequested[slotIdx] := FALSE
        safeAbsCount[slotIdx] := 0
        sfStarts[slotIdx] := 0
        sfNotRevb[slotIdx] := 0
        sfIntegSum[slotIdx] := 0
        sfIntegN[slotIdx] := 0
        bSfLiveRan[slotIdx] := FALSE
        bSfLiveOk[slotIdx] := FALSE
        sfFrameCaps[slotIdx] := 0
        sfIdleUp[slotIdx] := 0
        bSfClkRan[slotIdx] := FALSE
        bSfClkOk[slotIdx] := FALSE
        sfFaults[slotIdx] := 0
        sfResetUncleared[slotIdx] := 0
        bSfRampRan[slotIdx] := FALSE
        bSfRampOk[slotIdx] := FALSE
        bSfOffRan[slotIdx] := FALSE
        bSfOffOk[slotIdx] := TRUE                           ' ANDed over every restore; NOMEAS until one ran
        instLagMax[slotIdx] := 0
        instLagN[slotIdx] := 0
        bSfNoFoldRan[slotIdx] := FALSE
        bSfNoFoldOk[slotIdx] := TRUE                        ' ANDed over the base rungs
        bSfRateLawRan[slotIdx] := FALSE
        bSfRateLawOk[slotIdx] := TRUE                       ' ANDed over the base rungs with a valid window
        bSfStopCurRan[slotIdx] := FALSE
        bSfStopCurOk[slotIdx] := TRUE                       ' ANDed over the trials that reached speed
        bSfDroopRan[slotIdx] := FALSE
        bSfDroopOk[slotIdx] := TRUE                         ' ANDed over the steep-ramp trials
        sfDecelTicks[slotIdx] := 0
        bSfDecelRan[slotIdx] := FALSE
        bSfLimRan[slotIdx] := FALSE
        bSfLimOk[slotIdx] := FALSE
        bSfDerateRan[slotIdx] := FALSE
        bSfDerateOk[slotIdx] := FALSE
        bSfFrontRan[slotIdx] := FALSE
        bSfFrontOk[slotIdx] := FALSE
        scHoldIX10[slotIdx] := 0
        scHoldPk[slotIdx] := 0
        scStopPk[slotIdx] := 0
        scSamples[slotIdx] := 0
        bScValid[slotIdx] := FALSE
        sfTrN[slotIdx] := 0                                 ' TRKICK's two accumulators and the from_incre state
        sfTrKicks[slotIdx] := 0
        slotLastIncre[slotIdx] := 0

PRI runPart()
' Run this build's segments in the design's sec 4.1 order. Every segment after a run abort is emitted
' as BM-SEG SKIP ABORTED and not run. No part flag: nothing runs.
'
' Returns no value, so the top-level trap in main() carries only an abort code (0 when none), and
' bRunReturned alone says whether runPart() reached its end (I9: one value, one meaning).

    case PART_ID
        PART_A:
            runSegment(SEG_PREFLT)
            runSegment(SEG_STOPMODE)
            runSegment(SEG_LIVE)
            runSegment(SEG_LADDER)
        PART_CLOCK:
            runSegment(SEG_PREFLT)
            runSegment(SEG_CLOCK)
        PART_B:
            runSegment(SEG_PREFLT)
            runSegment(SEG_FAULTB)
            runSegment(SEG_OVERSHT)
        PART_BRAKE:
            runSegment(SEG_OUTSIDE)
        PART_C:
            runSegment(SEG_PREFLT)
            runSegment(SEG_BASELINE)
            runSegment(SEG_POSTFLT)
        PART_D:
            runSegment(SEG_PREFLT)
            runSegment(SEG_STEERSEG)
            runSegment(SEG_LIMIT)
        PART_FLOOR:
            runSegment(SEG_FLOOR)
        PART_UICHECK:
            runSegment(SEG_UICHECK)
    bRunReturned := TRUE                                    ' before the return, or main() reads a library abort

PRI runSegment(seg)
' Run one segment when the run caps allow it; otherwise record that it was skipped.
'
' @param seg - SEG_* to run

    if bRunContinue(seg)
        case seg
            SEG_PREFLT:
                if bSegPreflight() == FALSE
                    bRunAborted := TRUE
            SEG_STOPMODE:
                segStopMode()
            SEG_LIVE:
                segLive()
            SEG_LADDER:
                segLadder()
            SEG_CLOCK:
                segClock()
            SEG_FAULTB:
                segFaultBoundary()
            SEG_OVERSHT:
                segOvershoot()
            SEG_OUTSIDE:
                segOutside()
            SEG_BASELINE:
                segBaseline()
            SEG_POSTFLT:
                segPostFault()
            SEG_STEERSEG:
                segSteerContract()
            SEG_LIMIT:
                segCurrentLimits()
            SEG_FLOOR:
                segFloor()
            SEG_UICHECK:
                segUiCheck()
    else
        emitSeg(seg, SEGEV_SKIP, bSegAttended(seg), 0, 0, 0, 0, WHY_ABORTED)

PRI bRunContinue(seg) : bContinue | elapsedS
' Check the run caps (design sec 4.2 item 6) before a segment or trial; the first cap hit records a
' run-scope BM-ABORT once.
'
' @param seg - SEG_* about to run, for the abort record
' @returns bContinue - TRUE when the run has not aborted
'
' @local elapsedS - seconds since run start

    if bRunAborted == FALSE
        elapsedS := (getms() - runStartMs) / MS_PER_SEC
        if elapsedS >= RUN_TIME_CAP_S
            emitAbort(seg, curTid, SIDE_NONE, curIncre, ABR_TIME_CAP, elapsedS, SCOPE_RUN)
            bRunAborted := TRUE
        elseif runFaults >= RUN_FAULT_CAP
            emitAbort(seg, curTid, SIDE_NONE, curIncre, ABR_FAULT_CAP, runFaults, SCOPE_RUN)
            bRunAborted := TRUE
    bContinue := (bRunAborted == FALSE)

PRI bSegAttended(seg) : bAttended
' Report whether a segment needs a person at the rig (OUTSIDE, FLOOR and UICHECK).
'
' @param seg - SEG_* value
' @returns bAttended - TRUE for an attended segment

    bAttended := (seg == SEG_OUTSIDE) or (seg == SEG_FLOOR) or (seg == SEG_UICHECK)

PRI segBegin(seg)
' Open a segment: reset its counters and emit BM-SEG BEGIN.
'
' @param seg - SEG_* value

    curSeg := seg
    lastSeg := seg
    segsRun := (segsRun + 1) <# LIM_TINY
    segStartMs := getms()
    segItems := 0
    segFaults := 0
    segUnrecov := 0
    emitSeg(seg, SEGEV_BEGIN, bSegAttended(seg), 0, 0, 0, 0, WHY_NONE)

PRI segEnd(whyCode)
' Close the segment in progress with BM-SEG END and its counts.
'
' @param whyCode - WHY_* naming why the segment ended short, or WHY_NONE

    emitSeg(curSeg, SEGEV_END, bSegAttended(curSeg), segItems, segFaults, segUnrecov, getms() - segStartMs, whyCode)
    curSeg := SEG_NONE
    curTid := 0

PRI segStopMode() | side, speedIdx, signMul
' STOPMODE (part A, T1-1): C-4 deceleration data and the S-9a FLOAT / BRAKE / pins-cleared baselines.
' Per motor x speed (QTR, HALF) x sign (NEG, POS) x STOPMODE_REPS: one driver lifetime, three traces.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local speedIdx - 0 QTR, 1 HALF
' @local signMul - SIGN_NEG then SIGN_POS

    segBegin(SEG_STOPMODE)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat speedIdx from 0 to STOPMODE_SPEEDS - 1
            repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
                repeat STOPMODE_REPS
                    beat(CP_LOOP_POLL)
                    stopModeLifetime(SEG_STOPMODE, side, lookupz(speedIdx: QTR_SPEED_INCRE, HALF_SPEED_INCRE) * signMul, TRUE)
    segEnd(segWhy())

PRI segLive() | side, rungNum, whyCode
' LIVE (part A, T1-2, W): telemetry liveness beside testGetRpm(). Per motor one lifetime with
' startSenseCog() (its debug compiled out, I5); positive rungs QTR, HALF, LIVE_TOP_INCRE.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local rungNum - 0 QTR, 1 HALF, 2 LIVE_TOP_INCRE
' @local whyCode - why the remaining rungs are skipped, WHY_NONE while they run

    segBegin(SEG_LIVE)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        whyCode := WHY_NONE
        if bRunContinue(SEG_LIVE) == FALSE
            whyCode := WHY_ABORTED
        elseif bWheelStart(SEG_LIVE, side) == FALSE
            whyCode := stWhy
        else
            wheelStartSense(side)
        repeat rungNum from 0 to LIVE_RUNGS - 1
            beat(CP_LOOP_POLL)
            whyCode := trialSkipWhy(SEG_LIVE, side, whyCode)
            whyCode := liveRung(side, nextRungId(), rungNum, lookupz(rungNum: QTR_SPEED_INCRE, HALF_SPEED_INCRE, LIVE_TOP_INCRE), whyCode)
        bZeroAndWaitStopped(side)
        bInstIdle()
        wheelStop(side)
    segEnd(segWhy())

PRI segLadder() | side, signMul
' LADDER (part A, T1-3): C-1 speed law, C-5 duty question, S-3 linearity, C-6 data. Per motor x sign
' (NEG then POS) one lifetime over the whole ladderAllIdx walk -- climb, descent, then the delta cells;
' the BM-LADDER table of the twelve SPEEDS is in the header records.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS

    segBegin(SEG_LADDER)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            beat(CP_LOOP_POLL)
            ladderSign(SEG_LADDER, side, signMul, @ladderAllIdx, LADDER_WALK_STEPS)
    segEnd(segWhy())

PRI segClock() | side, signMul
' CLOCK (the three clock loads, T1-4): frame count and net current at 75_000_000, per motor x sign.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS

    segBegin(SEG_CLOCK)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            beat(CP_LOOP_POLL)
            clockLifetime(side, signMul)
    segEnd(segWhy())

PRI segFaultBoundary() | side, signMul, trialIdx, whyCode
' FAULTB (part B, T1-7): the ramp_inc fault-boundary sweep (C-5, Z; S-1 not measured). Per motor x sign
' one lifetime and FB_TRIALS trials, ramp_inc ascending.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS
' @local trialIdx - 0-based trial
' @local whyCode - why the lifetime did not start, WHY_NONE when it did

    segBegin(SEG_FAULTB)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            whyCode := WHY_NONE
            if bRunContinue(SEG_FAULTB) == FALSE
                whyCode := WHY_ABORTED
            elseif bWheelStart(SEG_FAULTB, side) == FALSE
                whyCode := stWhy
            repeat trialIdx from 0 to FB_TRIALS - 1
                beat(CP_LOOP_POLL)
                faultbTrial(side, signMul, trialIdx, whyCode)
            bZeroAndWaitStopped(side)
            bInstIdle()
            wheelStop(side)
    segEnd(segWhy())

PRI segOvershoot() | distIdx, whyCode, sid
' OVERSHT (part B, T1-8): C-3 distance overshoot through the steering object. Both wheel objects are
' stopped first (shared pin claims, PL-18); bSteerStart() sets holdAtStop(FALSE); the distance power is
' set once to OVERSHT_POWER, the value every trial prints (sec 12.8: never read back through the
' steering getter, PL-51); 2 ft and 10 ft x OVERSHT_REPS; then the two turn trials (task 3577); then the
' fault-API trial (task 3552); steering.stop() at the end.
'
' THE FAULT-API TRIAL RUNS LAST, and the order is the construction, not a preference: a provoked fault
' resets the driver's tracking, so running it first or between reps would contaminate C-3, this
' segment's primary job. It is here at all because it is the only UNATTENDED segment that runs the
' steering object, and the steering object's isFaulted() / isEmergency() cannot be read without it.
'
' @local distIdx - 0 short, 1 long; then the turn index, 0 the left wheel long, 1 the right wheel long
' @local whyCode - why the remaining trials are skipped, WHY_NONE while they run
' @local sid - the steering start's life, 0 when it did not start

    segBegin(SEG_OVERSHT)
    wheelStop(SIDE_LEFT)
    wheelStop(SIDE_RIGHT)
    whyCode := WHY_NONE
    sid := 0
    if bRunContinue(SEG_OVERSHT) == FALSE
        whyCode := WHY_ABORTED
    elseif bSteerStart(SEG_OVERSHT) == FALSE
        whyCode := WHY_NO_COG
    else
        sid := steerLife
        beat(CP_LIB_STEER_DRIVE)
        steering.setMaxSpeedForDistance(OVERSHT_POWER)
        beat(CP_LIB_STEER_DRIVE)
    repeat distIdx from 0 to OVERSHT_DISTS - 1
        repeat OVERSHT_REPS
            beat(CP_LOOP_POLL)
            whyCode := overshootTrial(sid, lookupz(distIdx: OVERSHT_FT_SHORT, OVERSHT_FT_LONG), lookupz(distIdx: OVERSHT_FT_SHORT, OVERSHT_FT_LONG), whyCode)
    repeat distIdx from 0 to OVERSHT_TURNS - 1
        beat(CP_LOOP_POLL)
        whyCode := overshootTrial(sid, lookupz(distIdx: OVERSHT_FT_LONG, OVERSHT_FT_SHORT), lookupz(distIdx: OVERSHT_FT_SHORT, OVERSHT_FT_LONG), whyCode)
    faultApiTrial(sid, whyCode)
    bInstIdle()
    steerStop()
    segEnd(segWhy())

PRI segOutside() | whyCode
' OUTSIDE (attended load 6, T1-9): M, AF, S-5, Z. The panel asks for START and nothing moves before it
' (sec 8.3); a START timeout ends the segment with no motion. outsideRun() then drives both wheels at
' STEER_POWER_HALF, asks for the LEFT hand-brake and polls the public API through the fault and both Z
' steps. The end screen shows the outcome and waits for START, so the operator reads it before the session
' ends.
'
' @local whyCode - why the segment ended short, WHY_NONE when it ran through

    segBegin(SEG_OUTSIDE)
    panelSetup()
    whyCode := operStartPrompt(PROMPT_BRAKE_L, BM_SCR_BRAKE_START, BM_SCR_BRAKE_SPINUP)
    if whyCode == WHY_NONE
        whyCode := outsideRun()
    operFlush()
    panelFinish(BM_SCR_END, outcomeState(whyCode))
    ' if/else, never `? :` -- PL-29: a ternary evaluates BOTH branches, so this called segWhy() even
    '  when whyCode already held the answer. segWhy() is a pure read of bRunAborted, so the cost here was
    '  a wasted call and nothing else -- but a counter-example living in the file that states the rule is
    '  how the rule stops being followed (P10: the construction, not a reminder).
    if whyCode <> WHY_NONE
        segEnd(whyCode)
    else
        segEnd(segWhy())

PRI segBaseline() | side, signMul
' BASELINE (part C, before POSTFLT, I7): STOPMODE conditions (1) and (2) at HALF, per motor x sign, one
' lifetime each. Shares stopModeLifetime() with STOPMODE.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS

    segBegin(SEG_BASELINE)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            beat(CP_LOOP_POLL)
            stopModeLifetime(SEG_BASELINE, side, HALF_SPEED_INCRE * signMul, FALSE)
    segEnd(segWhy())

PRI segPostFault() | side, signMul, reqMode, whyCode
' POSTFLT (part C, T1-1 d and e; S-9a): coast after a provoked fault (NEG, HALF, FLOAT then BRAKE) and
' after an e-stop (both signs, HALF, FLOAT then BRAKE), per motor in one lifetime. No outcome is
' labelled (I7): BASELINE's traces in this load are the comparison.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS
' @local reqMode - MODE_FLOAT then MODE_BRAKE
' @local whyCode - why the lifetime did not start, WHY_NONE when it did

    segBegin(SEG_POSTFLT)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        whyCode := WHY_NONE
        if bRunContinue(SEG_POSTFLT) == FALSE
            whyCode := WHY_ABORTED
        elseif bWheelStart(SEG_POSTFLT, side) == FALSE
            whyCode := stWhy
        repeat reqMode from MODE_FLOAT to MODE_BRAKE
            beat(CP_LOOP_POLL)
            eventTrace(SEG_POSTFLT, side, HALF_SPEED_INCRE * SIGN_NEG, CAUSE_FAULT, EVT_OFFSET, reqMode, whyCode)
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            repeat reqMode from MODE_FLOAT to MODE_BRAKE
                beat(CP_LOOP_POLL)
                eventTrace(SEG_POSTFLT, side, HALF_SPEED_INCRE * signMul, CAUSE_ESTOP, EVT_ESTOP, reqMode, whyCode)
        bInstIdle()
        wheelStop(side)
    segEnd(segWhy())

CON { --- part D: the front cog's contract (STEERSEG) and current limiting (LIMIT), task 3560 --- }

PRI segSteerContract() | whyCode
' STEERSEG (part D, plan sec R16.8 b): the front cog's contract, measured first through the steering
' object -- the three-cog form, where one front cog owns both drivers -- and then through one wheel, the
' two-cog form. Both forms are what 6.0.0 ships, so both are certified here (FIXED-COG-SHAPE-DESIGN.md
' sec 6).
'
' THE ORDER IS THE CONSTRUCTION. LOCKSTEP must run first: it watches the platform's very first departure
' from rest, which only exists once per start. COOPSHUT must run last on each object: it is the shutdown.
' Everything between leaves the object running and at rest.
'
' @local whyCode - why the steering half did not run, WHY_NONE when it did

    segBegin(SEG_STEERSEG)
    wheelStop(SIDE_LEFT)                                    ' shared pin claims (PL-18), as OVERSHT does
    wheelStop(SIDE_RIGHT)
    whyCode := WHY_NONE
    if bRunContinue(SEG_STEERSEG) == FALSE
        whyCode := WHY_ABORTED
    elseif bSteerStart(SEG_STEERSEG) == FALSE
        whyCode := WHY_NO_COG
    if whyCode == WHY_NONE
        dStepLockstep()
        dStepTrackReset(SIDE_BOTH)
        dStepEstopSet(SIDE_BOTH)
        dStepOrdered()
        dStepTimeStop(SIDE_BOTH)
        dStepCmdTimeout(SIDE_BOTH)
        dStepDirSign()
        dStepFrontStats(SIDE_BOTH)
        dStepCoopShut(SIDE_BOTH)                            ' stops the steering object
    else
        dStepSkip(DST_LOCKSTEP, SIDE_BOTH, whyCode)
        dStepSkip(DST_TRACKRESET, SIDE_BOTH, whyCode)
        dStepSkip(DST_ESTOP_REFUSE, SIDE_BOTH, whyCode)
        dStepSkip(DST_ESTOP_LATCH, SIDE_BOTH, whyCode)
        dStepSkip(DST_ESTOP_CLEAR, SIDE_BOTH, whyCode)
        dStepSkip(DST_ORDERED, SIDE_BOTH, whyCode)
        dStepSkip(DST_TIMESTOP, SIDE_BOTH, whyCode)
        dStepSkip(DST_CMDTIMEOUT, SIDE_BOTH, whyCode)
        dStepSkip(DST_DIRSIGN, SIDE_BOTH, whyCode)
        dStepSkip(DST_COOPSHUT, SIDE_BOTH, whyCode)
        steerStop()
    segEnd(segWhy())

PRI segCurrentLimits() | whyCode
' LIMIT (part D, plan sec R16.8 d): current limiting as a user meets it, through the steering object.
' testSetCurrentLimits() lowers the limits so a wheels-lifted rig can reach them -- at the MOSFET values
' (40 A peak, 27 A continuous) a lifted 6.5in wheel never comes close, so without this the design's own
' mechanisms could not be provoked at all on this rig (doctrine overlay P1: every run is wheels-lifted).
' The MOSFET values are restored and read back before the segment ends (I11).
'
' THE SINGLE-WHEEL half of part D runs here, after the limits are restored, so a wheel-frame e-stop and
' time stop are measured on a platform whose limits are back at their shipping values.
'
' @local whyCode - why the segment did not run, WHY_NONE when it did

    segBegin(SEG_LIMIT)
    whyCode := WHY_NONE
    if bRunContinue(SEG_LIMIT) == FALSE
        whyCode := WHY_ABORTED
    elseif bSteerStart(SEG_LIMIT) == FALSE
        whyCode := WHY_NO_COG
    if whyCode == WHY_NONE
        dStepFoldBack()
        dStepDerate()
        dStepBlocked()
        dLimitRestore()                                     ' I11: the MOSFET values back, read back, before anything else
        steerStop()
    else
        dStepSkip(DST_FOLDBACK, SIDE_BOTH, whyCode)
        dStepSkip(DST_DERATE, SIDE_BOTH, whyCode)
        dStepSkip(DST_BLOCKED, SIDE_BOTH, whyCode)
        steerStop()
    dWheelHalf(whyCode)
    segEnd(segWhy())

PRI dWheelHalf(segWhyCode) | whyCode
' The two-cog form: one wheel started on its own (start() runs its own front cog), carrying the same
' e-stop, time-stop and loop-health claims the steering object was just measured against. LEFT is the
' wheel under test throughout, as every other wheel-frame segment uses it.
'
' @param segWhyCode - WHY_NONE when the segment ran, else why nothing ran
'
' @local whyCode - why the wheel half did not run, WHY_NONE when it did

    whyCode := segWhyCode
    if whyCode == WHY_NONE
        if bRunContinue(SEG_LIMIT) == FALSE
            whyCode := WHY_ABORTED
        elseif bWheelStart(SEG_LIMIT, SIDE_LEFT) == FALSE
            whyCode := stWhy
    if whyCode == WHY_NONE
        dStepEstopSet(SIDE_LEFT)
        dStepTimeStop(SIDE_LEFT)
        dStepCmdTimeout(SIDE_LEFT)
        dStepFrontStats(SIDE_LEFT)
        dStepCoopShut(SIDE_LEFT)                            ' stops the wheel
    else
        dStepSkip(DST_ESTOP_REFUSE, SIDE_LEFT, whyCode)
        dStepSkip(DST_ESTOP_LATCH, SIDE_LEFT, whyCode)
        dStepSkip(DST_ESTOP_CLEAR, SIDE_LEFT, whyCode)
        dStepSkip(DST_TIMESTOP, SIDE_LEFT, whyCode)
        dStepSkip(DST_CMDTIMEOUT, SIDE_LEFT, whyCode)
        dStepSkip(DST_COOPSHUT, SIDE_LEFT, whyCode)
        bInstIdle()
        wheelStop(SIDE_LEFT)

PRI segFloor() | whyCode
' FLOOR (attended load 9, T2-1; AC). The panel asks for START and nothing moves before it (sec 8.3); a
' START timeout ends the segment with no motion. floorRun() then drives driveDirection(FLOOR_POWER,
' FLOOR_DIRECTION) for FLOOR_RUN_MS with STOP always live, and asks which way the platform turned.
'
' @local whyCode - why the segment ended short, WHY_NONE when it ran through

    segBegin(SEG_FLOOR)
    panelSetup()
    whyCode := operStartPrompt(PROMPT_FLOOR, BM_SCR_FLOOR_START, BM_SCR_FLOOR_STARTING)
    if whyCode == WHY_NONE
        whyCode := floorRun()
    operFlush()
    panelFinish(BM_SCR_END, outcomeState(whyCode))
    ' if/else, never `? :` -- PL-29: a ternary evaluates BOTH branches, so this called segWhy() even
    '  when whyCode already held the answer. segWhy() is a pure read of bRunAborted, so the cost here was
    '  a wasted call and nothing else -- but a counter-example living in the file that states the rule is
    '  how the rule stops being followed (P10: the construction, not a reminder).
    if whyCode <> WHY_NONE
        segEnd(whyCode)
    else
        segEnd(segWhy())

PRI segUiCheck() | stepIdx
' UICHECK (tier dual-ui; STEPHEN 2026-09-15: "a no-motor-control test form of run that takes me thru the
' series of UI controls to make sure they work"): no wheel or steering object is ever started. Every panel
' button, one live at a time, must arrive both as its key and as a mouse click; then every screen dual-brake
' draws (BM_SCR_PREVIEW_FIRST..LAST) is drawn from the same bmScreens row the run uses, its own buttons drawn
' but dead, and judged with the two verdict buttons in their own strip (PL-64: no input both operates a
' screen and judges it). Each step is a BM-UISTEP; R14-DUAL-UICHECK-U is TRUE only when every step was OK.
' The result screen waits for START so the operator reads it before the session ends.
'
' @local stepIdx - button or screen index

    segBegin(SEG_UICHECK)
    panelSetup()
    bSfUiRan := TRUE
    bSfUiOk := TRUE
    repeat stepIdx from 0 to BM_BTN_COUNT - 1
        uiCheckButton(stepIdx)
    panelShow(BM_SCR_UI_INTRO, BM_STATE_UI_CHECK, PNL_BTN_NONE)
    operWait(scrCdMs(BM_SCR_UI_INTRO), SIDE_NONE, FALSE)
    repeat stepIdx from BM_SCR_PREVIEW_FIRST to BM_SCR_PREVIEW_LAST
        uiCheckScreen(stepIdx)
    panelFinish(BM_SCR_UI_END, bSfUiOk ? BM_STATE_UI_PASSED : BM_STATE_UI_FAILED)
    segEnd(segWhy())

PRI uiCheckButton(btnIdx) | startMs, remainMs, buttonIdx, inputCode, bKeyGot, bClickGot, resultCode
' One UICHECK control step: only btnIdx is live, and it must arrive both as its key and as a mouse click, in
' either order. Whichever arrives first is acknowledged on the panel, which then names the input it still
' needs, so no input is ever discarded unseen and a working key cannot pass a broken mouse. A step that got
' both is drawn highlighted for UI_HILITE_MS.
'
' @param btnIdx - BM_BTN_* under test
'
' @local startMs - getms() when the step was shown
' @local remainMs - ms left in the step
' @local buttonIdx - BM_BTN_* received, PNL_BTN_NONE on timeout
' @local inputCode - INPUT_* of the button received
' @local bKeyGot - the button arrived as its key
' @local bClickGot - the button arrived as a mouse click
' @local resultCode - UIR_OK or UIR_TIMEOUT

    uiPressReset()
    bKeyGot := FALSE
    bClickGot := FALSE
    panelCompose(BM_SCR_UI_CONTROL, BM_STATE_UI_CHECK, DECOD btnIdx, DECOD btnIdx, PNL_BTN_NONE, BM_STRIP_BLANK, FALSE)
    startMs := getms()
    repeat
        remainMs := UI_STEP_TIMEOUT_MS - (getms() - startMs)
        if remainMs <= 0
            quit
        buttonIdx, inputCode, _ := operWait(remainMs, SIDE_NONE, FALSE)
        if buttonIdx == PNL_BTN_NONE
            quit
        if inputCode == INPUT_KEY
            bKeyGot := TRUE
        else
            bClickGot := TRUE
        if bKeyGot and bClickGot
            quit
        panelCompose(BM_SCR_UI_CONTROL, bKeyGot ? BM_STATE_UI_NOW_CLICK : BM_STATE_UI_NOW_KEY, DECOD btnIdx, DECOD btnIdx, PNL_BTN_NONE, BM_STRIP_BLANK, FALSE)
    resultCode := (bKeyGot and bClickGot) ? UIR_OK : UIR_TIMEOUT
    if resultCode == UIR_OK
        panelCompose(BM_SCR_UI_CONTROL, BM_STATE_UI_CHECK, PNL_LIVE_NONE, PNL_LIVE_NONE, btnIdx, BM_STRIP_BLANK, FALSE)
        waitBeat(UI_HILITE_MS, CP_LOOP_OPER)
    else
        bSfUiOk := FALSE
    emitUiStep(UIK_CONTROL, btnIdx, PNL_BTN_NONE, bKeyGot, bClickGot, BM_SCR_UI_CONTROL, resultCode, getms() - startMs)

PRI uiPressReset()
' Forget the last left-button press, so a BM-UISTEP reports only presses made during its own step.

    uiPressX := 0
    uiPressY := 0
    bUiPressSeen := FALSE

PRI uiCheckScreen(scr) | startMs, buttonIdx, inputCode, resultCode
' One UICHECK screen: an attended screen drawn from its own bmScreens row exactly as the run draws it --
' prompt, state, countdown label and start, and its own buttons, drawn but dead -- with the judge
' instruction and the two verdict buttons live in the strip below. LOOKS RIGHT means it reads right;
' SOMETHING WRONG means it does not. No input the screen itself offers is accepted here.
'
' @param scr - BM_SCR_* previewed
'
' @local startMs - getms() when the screen was shown
' @local buttonIdx - BM_BTN_LOOKS_RIGHT, BM_BTN_WRONG, or PNL_BTN_NONE on timeout
' @local inputCode - INPUT_* of the button received
' @local resultCode - UIR_* of the step

    uiPressReset()
    panelCompose(scr, scrState(scr), scrLive(scr), PNL_LIVE_VERDICT, PNL_BTN_NONE, BM_STRIP_JUDGE, TRUE)
    startMs := getms()
    buttonIdx, inputCode, _ := operWait(UI_STEP_TIMEOUT_MS, SIDE_NONE, FALSE)
    if buttonIdx == BM_BTN_LOOKS_RIGHT
        resultCode := UIR_OK
    elseif buttonIdx == BM_BTN_WRONG
        resultCode := UIR_WRONG
        bSfUiOk := FALSE
    else
        resultCode := UIR_TIMEOUT
        bSfUiOk := FALSE
    if buttonIdx <> PNL_BTN_NONE
        panelCompose(scr, scrState(scr), scrLive(scr), PNL_LIVE_NONE, buttonIdx, BM_STRIP_JUDGE, TRUE)
        waitBeat(UI_HILITE_MS, CP_LOOP_OPER)
    emitUiStep(UIK_PREVIEW, PNL_BTN_NONE, buttonIdx, inputCode == INPUT_KEY, inputCode == INPUT_MOUSE, scr, resultCode, getms() - startMs)

PRI bSegPreflight() : bAllMoved | side, bMoved
' PREFLT (every motion load, design sec 4.4): prove each wheel turns before anything is measured. A
' wheel that moves 0 ticks ends the run with BM-ABORT scope RUN reason NO_MOTION.
'
' @returns bAllMoved - TRUE when both wheels moved
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local bMoved - this wheel moved

    segBegin(SEG_PREFLT)
    bAllMoved := TRUE
    repeat side from SIDE_LEFT to SIDE_RIGHT
        beat(CP_LOOP_POLL)
        bMoved := bPreflightWheel(side)
        if bMoved == FALSE
            bAllMoved := FALSE
        segItems += 1
    if bAllMoved == FALSE
        emitAbort(SEG_PREFLT, 0, SIDE_NONE, PREFLIGHT_INCRE, ABR_NO_MOTION, 0, SCOPE_RUN)
    segEnd(bAllMoved ? WHY_NONE : WHY_ABORTED)

PRI bPreflightWheel(side) : bMoved | slotIdx, safeEvent, ticksMoved, hwMoved, bMeasured, whyCode, lastJ
' One wheel's preflight: start it alone (I6), arm the instrument on it, PREFLIGHT_INCRE for
' PREFLIGHT_MS, zero, wait stopped, freeze, and measure the driver tick and hwPos deltas from the ring.
' Emits BM-START (inside bWheelStart()) and BM-PREFLT. A fault is recovered per sec 4.2.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bMoved - TRUE when the driver's tick count changed across the nudge
'
' @local slotIdx - motor slot
' @local safeEvent - SAFE_* from the watched waits
' @local ticksMoved - driver pos delta over the capture
' @local hwMoved - hwPos delta over the capture
' @local bMeasured - the deltas are measurements
' @local whyCode - first cause of any NA in BM-PREFLT
' @local lastJ - logical index of the last drained sample

    slotIdx := side - SIDE_LEFT
    bMoved := FALSE
    bMeasured := FALSE
    ticksMoved := 0
    hwMoved := 0
    whyCode := WHY_NONE
    safeEvent := SAFE_NONE
    curTid := 0
    if bWheelStart(SEG_PREFLT, side) == FALSE
        whyCode := stWhy
    elseif bInstArm(INST_SRC_WHEELS, 1) == FALSE
        whyCode := WHY_INST_NOACK
    else
        instMark()
        wheelCommand(side, PREFLIGHT_INCRE)
        safeEvent, _ := waitWatched(side, PREFLIGHT_MS, CP_LOOP_CAPTURE, UNTIL_TIME)
        if safeEvent == SAFE_NONE
            wheelCommand(side, 0)
            safeEvent, _ := waitWatched(side, STOP_TIMEOUT_MS, CP_LOOP_STOPPED, UNTIL_STOPPED)
        else
            wheelCommand(side, 0)
        if bInstFreeze(0)
            drainBegin()
            if drStored > 1
                lastJ := drStored - 1
                ticksMoved := smpPos(lastJ, slotIdx) - smpPos(0, slotIdx)
                hwMoved := smpHw(lastJ, slotIdx) - smpHw(0, slotIdx)
                bMeasured := TRUE
            else
                whyCode := WHY_NO_SAMPLES
        else
            whyCode := WHY_INST_NOACK
        if safeEvent == SAFE_INST_STALL
            emitAbort(SEG_PREFLT, 0, side, PREFLIGHT_INCRE, ABR_INST_STALLED, INST_STALL_MS, SCOPE_SEG)
        if safeEvent == SAFE_FAULT
            bRecoverFault(SEG_PREFLT, 0, side, PREFLIGHT_INCRE, FAULT_COOL_MS)
    bMoved := bMeasured and (ticksMoved <> 0)
    emitPreflt(side, PREFLIGHT_INCRE, ticksMoved, hwMoved, bMeasured, whyCode)
    bInstIdle()
    wheelStop(side)

CON { --- segment routines: traces (STOPMODE, BASELINE, POSTFLT, FAULTB), rungs (LADDER, LIVE, CLOCK), OVERSHT --- }

PRI stopModeLifetime(seg, side, motorIncre, bWithStopCog) | whyCode
' One stop-mode driver lifetime, the routine STOPMODE and BASELINE share: start the wheel under test
' alone (I6; the lifetime zero is read inside bWheelStart()), then condition (1) STOPCMD FLOAT, (2)
' STOPCMD BRAKE and, when asked, (3) STOPCOG FLOAT, which ends the lifetime.
'
' @param seg - SEG_STOPMODE or SEG_BASELINE
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param bWithStopCog - TRUE to trace condition (3)
'
' @local whyCode - why the lifetime did not start, WHY_NONE when it did

    whyCode := WHY_NONE
    if bRunContinue(seg) == FALSE
        whyCode := WHY_ABORTED
    elseif bWheelStart(seg, side) == FALSE
        whyCode := stWhy
    eventTrace(seg, side, motorIncre, CAUSE_STOPCMD, EVT_STOPMOTOR, MODE_FLOAT, whyCode)
    eventTrace(seg, side, motorIncre, CAUSE_STOPCMD, EVT_STOPMOTOR, MODE_BRAKE, whyCode)
    if bWithStopCog
        eventTrace(seg, side, motorIncre, CAUSE_STOPCOG, EVT_STOPCOG, MODE_FLOAT, whyCode)
    bInstIdle()
    wheelStop(side)

PRI eventTrace(seg, side, motorIncre, causeCode, eventCode, reqMode, skipWhy) | tid, whyCode, rampInc
' One wheel trace, the trace routine STOPMODE, BASELINE and POSTFLT share: BRAKE requested before
' spin-up, on the wheel under test only (I6); eventCapture(); every side effect restored and read back,
' then BM-TRACE, BM-TS and BM-TRACE-END (traceEmitCapture()); recovery per sec 4.2, zero and wait
' stopped (traceRecover()). A trial the caps, a retired motor or a stopped driver prevent is emitted as
' its header and an empty end naming the cause.
'
' @param seg - SEG_STOPMODE, SEG_BASELINE or SEG_POSTFLT
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param causeCode - CAUSE_* the header names (what was done, I7)
' @param eventCode - EVT_* the trial issues
' @param reqMode - MODE_FLOAT or MODE_BRAKE (what was requested, I7)
' @param skipWhy - WHY_NONE to run, else why the lifetime could not start
'
' @local tid - trace id
' @local whyCode - why the trial is skipped, WHY_NONE when it runs
' @local rampInc - ramp_inc read back for the header

    tid := nextTraceId()
    cpReset()
    whyCode := trialSkipWhy(seg, side, skipWhy)
    rampInc := wheelRampInc(side)
    if whyCode <> WHY_NONE
        cpWantNeg, cpWantPos := wheelGetOffsets(side)
        traceSkip(tid, seg, side, causeCode, motorIncre, reqMode, rampInc, whyCode)
    else
        if reqMode == MODE_BRAKE
            wheelHold(side, TRUE)
        eventCapture(side, motorIncre, eventCode)
        traceEmitCapture(seg, side, tid, causeCode, motorIncre, reqMode, rampInc)
        ' STPDECEL rides BASELINE's floated stop from half speed -- the one condition Visit 3 measured
        '  74-77 ticks on -- so the no-regression reading costs no trial of its own
        if (seg == SEG_BASELINE) and (causeCode == CAUSE_STOPCMD) and (reqMode == MODE_FLOAT) and bTrStopValid
            sfDecelTicks[side - SIDE_LEFT] := trStopTicks
            bSfDecelRan[side - SIDE_LEFT] := TRUE
        ' FLTSTOP (task 3572, R17.1): POSTFLT's provoked faults, FLOAT then BRAKE -- the travel from the provocation
        '  to rest under each stop mode. The computed provocation faults within a control frame, so this is the
        '  post-fault coast (COAST) or brake (SHORT) the user's holdAtStop() selected
        if (seg == SEG_POSTFLT) and (causeCode == CAUSE_FAULT) and bCpFaultSeen and bTrStopValid
            sfFltStopTicks[((side - SIDE_LEFT) * MODE_COUNT) + reqMode] := trStopTicks
            bSfFltStopRan[((side - SIDE_LEFT) * MODE_COUNT) + reqMode] := TRUE
        traceRecover(seg, side, tid, motorIncre, FAULT_COOL_MS)
    segItems := (segItems + 1) <# LIM_SMALL

PRI eventCapture(side, motorIncre, eventCode) | safeEvent, bReached, bRest, markMs, captureLeftMs, shiftDeg
' Run one wheel trace's motion and capture (design sec 4.4): arm; command; AT_SPEED (<=
' STEADY_TIMEOUT_MS); settle SETTLE_MS; read the offsets; mark; the event; capture until rest or
' traceCaptureMs(1); freeze. EVT_OFFSET first waits POSTFLT_NO_FAULT_MS for the provoked fault and, when
' none comes, restores the offsets and stops the motor at once (why NO_FAULT). EVT_STOPCOG calls stop()
' while the instrument runs, because the cog stop IS the event under capture (condition 3): the one I10
' exception besides the absolute-current abort; a straddled sample is gated by up (I3). Fills the cp*
' staging; the remaining restores are traceEmitCapture()'s.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param eventCode - EVT_* value
'
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - AT_SPEED was reached
' @local bRest - rest was confirmed
' @local markMs - getms() at the mark
' @local captureLeftMs - capture bound still owed after the no-fault wait
' @local shiftDeg - EVT_OFFSET: the computed offset shift that provokes the fault (faultShiftDeg())

    safeEvent := SAFE_NONE
    bReached := FALSE
    cpWantNeg, cpWantPos := wheelGetOffsets(side)
    if bInstArm(INST_SRC_WHEELS, 1) == FALSE
        cpWhy := WHY_INST_NOACK
    else
        wheelCommand(side, motorIncre)
        safeEvent, bReached := waitWatched(side, STEADY_TIMEOUT_MS, CP_LOOP_ATSPEED, UNTIL_AT_SPEED)
        if (safeEvent == SAFE_NONE) and bReached
            safeEvent, _ := waitWatched(side, SETTLE_MS, CP_LOOP_SETTLE, UNTIL_TIME)
        if safeEvent <> SAFE_NONE
            cpWhy := safeWhy(safeEvent)
            cpEnd := safeEnd(safeEvent)
            bCpFaultSeen := (safeEvent == SAFE_FAULT)
        elseif bReached == FALSE
            cpWhy := WHY_STEADY_TIMEOUT
        else
            cpWantNeg, cpWantPos := wheelGetOffsets(side)    ' the pair read immediately before the event
            instMark()
            markMs := getms()
            case eventCode
                EVT_STOPMOTOR:
                    wheelStopMotor(side)
                EVT_STOPCOG:
                    wheelStopRaw(side)
                EVT_ESTOP:
                    wheelEstop(side)
                    bCpEstopSet := TRUE
                EVT_OFFSET:
                    ' task 3572 (PL-59): the computed shift that lands this wheel's error on the fault test, both
                    '  offsets moved by it, so the fault arrives in the next control frame under either sign
                    shiftDeg := faultShiftDeg(side, FALSE)
                    instMark()                              ' re-mark: the shift's error reads took SAMPLE_MS each
                    markMs := getms()
                    wheelSetOffsets(side, cpWantNeg + shiftDeg, cpWantPos + shiftDeg)
                    bCpOffWritten := TRUE
            if eventCode == EVT_OFFSET
                safeEvent, _ := waitWatched(side, POSTFLT_NO_FAULT_MS, CP_LOOP_CAPTURE, UNTIL_TIME)
                if safeEvent == SAFE_FAULT
                    bCpFaultSeen := TRUE
                    safeEvent := SAFE_NONE                  ' the provoked fault is the event, not the capture's end
                elseif safeEvent == SAFE_NONE
                    bRestoreOffsets(side, cpWantNeg, cpWantPos)
                    bCpOffRestored := TRUE
                    wheelStopMotor(side)
                    cpWhy := WHY_NO_FAULT
            if safeEvent == SAFE_NONE
                captureLeftMs := (traceCaptureMs(1) - (getms() - markMs)) #> 0
                safeEvent, bRest := waitRest(side, captureLeftMs, eventCode <> EVT_OFFSET)
                cpEnd := bRest ? TEND_REST : TEND_TIMEOUT
            if safeEvent <> SAFE_NONE
                cpEnd := safeEnd(safeEvent)
                if safeEvent == SAFE_FAULT
                    bCpFaultSeen := TRUE
        bCpFrozen := bInstFreeze(0)
        if (bCpFrozen == FALSE) and (cpWhy == WHY_NONE)
            cpWhy := WHY_INST_NOACK

PRI rungMeasure(side, motorIncre, steadyBoundMs, settleMs, bPollCurrent) : safeEvent | slotIdx, otherIdx, startMs, bReached, missedStart, illegalStart, missedEnd, illegalEnd
' One measured rung, the routine LADDER, LIVE and CLOCK share (design sec 4.4): read the offsets,
' duty_max and integrity counts; arm; mark; command; AT_SPEED (<= steadyBoundMs); settle; a WINDOW_MS
' window delimited by two ring totals (rungWindow(), sec 12.7); freeze; window statistics, the
' transition statistics from the command mark to the window start (PL-87), and the capture's idle-wheel
' check; integrity deltas. Fills the rg* staging and the rs* and tr* statistics; emits nothing.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param steadyBoundMs - the AT_SPEED bound
' @param settleMs - settle after AT_SPEED
' @param bPollCurrent - TRUE to read getCurrent() every CURRENT_POLL_MS in the window
' @returns safeEvent - SAFE_* that ended the rung early, SAFE_NONE otherwise
'
' @local slotIdx - motor slot
' @local otherIdx - the idle motor slot
' @local startMs - getms() at the command
' @local bReached - AT_SPEED was reached
' @local missedStart - missed transitions before the rung
' @local illegalStart - illegal codes before the rung
' @local missedEnd - missed transitions after the rung
' @local illegalEnd - illegal codes after the rung

    slotIdx := side - SIDE_LEFT
    otherIdx := SLOT_RIGHT - slotIdx
    rgResult := RES_OK
    rgWhy := WHY_NONE
    rgSteadyMs := 0
    bRgSteadyValid := FALSE
    bRgWindowValid := FALSE
    rgAmpsX10k := 0
    bRgAmpsValid := FALSE
    bRgHbOk := FALSE
    bRgCaptured := FALSE
    bRgIdleUp := FALSE
    rgWinStart := -1
    rgWinEnd := -1
    rgCmdStart := -1
    rgFromIncre := slotLastIncre[slotIdx]                   ' R18.1: 0 when the wheel is at rest
    rgHlTrLag := 0
    rgHlTrCap := 0
    rgHlWinLag := 0
    rgHlWinCap := 0
    rgHlDrvIncr := 0
    bRgHlCmd := FALSE
    bRgHlTrValid := FALSE
    bRgHlWinValid := FALSE
    safeEvent := SAFE_NONE
    bReached := FALSE
    rsOffNeg, rsOffPos := wheelGetOffsets(side)
    _, rgDutyMax, _, _ := wheelDriveConstants(side)
    missedStart, illegalStart := wheelIntegrity(side)
    if bInstArm(INST_SRC_WHEELS, 1) == FALSE
        windowStats(slotIdx, otherIdx, -1, -1)              ' resets the rs* staging; reads no ring long
        transitionStats(slotIdx, -1, -1)                    ' and the tr* staging, likewise
        rgResult := RES_SKIPPED
        rgWhy := WHY_INST_NOACK
    else
        ' R18.1: the health snapshot is taken BEFORE the mark, so nothing stands between the mark and the
        '  command that the transition's first sample has to account for (sec 12.7).
        if isWheelUp(side)                                  ' I3: a stopped driver's status block is stale, never read
            hlCmdLag, hlCmdCap, _ := wheelDriveHealth(side)
            bRgHlCmd := TRUE
        rgCmdStart := instMarkIndex()                       ' PL-87: the transition's first sample, marked before the command
        startMs := getms()
        wheelCommand(side, motorIncre)
        slotLastIncre[slotIdx] := curIncre                  ' what wheelCommand() actually SENT, which is the next rung's from_incre
        ' from a previous rung the mirror still reads AT_SPEED until the driver takes the new command
        safeEvent, _ := waitWatched(side, COMMAND_SEEN_MS, CP_LOOP_ATSPEED, UNTIL_TIME)
        if safeEvent == SAFE_NONE
            safeEvent, bReached := waitWatched(side, steadyBoundMs, CP_LOOP_ATSPEED, UNTIL_AT_SPEED)
        rgSteadyMs := getms() - startMs
        if (safeEvent == SAFE_NONE) and bReached
            bRgSteadyValid := TRUE
            safeEvent, _ := waitWatched(side, settleMs, CP_LOOP_SETTLE, UNTIL_TIME)
            if safeEvent == SAFE_NONE
                safeEvent := rungWindow(side, bPollCurrent)
        bRgCaptured := bInstFreeze(0)
        if bRgCaptured
            bRgIdleUp := bCaptureIdleUp(otherIdx)
            windowStats(slotIdx, otherIdx, rgWinStart, rgWinEnd)
            transitionStats(slotIdx, rgCmdStart, rgWinStart)
        else
            windowStats(slotIdx, otherIdx, -1, -1)          ' I10: an unfrozen ring is never read
            transitionStats(slotIdx, -1, -1)
        case safeEvent
            SAFE_FAULT:
                rgResult := RES_FAULT
                rgWhy := WHY_FAULTED
            SAFE_ABS_ABORT:
                rgResult := RES_ABORT_I
                rgWhy := WHY_ABORTED
            SAFE_INST_STALL:
                rgResult := RES_WINDOW_TIMEOUT
                rgWhy := WHY_INST_STALLED
            other:
                if bReached == FALSE
                    rgResult := RES_STEADY_TIMEOUT
                    rgWhy := WHY_STEADY_TIMEOUT
                elseif bRgCaptured == FALSE
                    rgResult := RES_WINDOW_TIMEOUT
                    rgWhy := WHY_INST_NOACK
                elseif rsN == 0
                    rgResult := RES_WINDOW_TIMEOUT
                    rgWhy := WHY_NO_SAMPLES
                else
                    bRgWindowValid := TRUE
    missedEnd, illegalEnd := wheelIntegrity(side)
    rgMissedD := (missedEnd - missedStart) #> 0
    rgIllegalD := (illegalEnd - illegalStart) #> 0

PRI transitionStats(slotIdx, cmdTotal, endTotal) | sampleIdx, startJ, endJ, firstJ, lastJ
' PL-87: the rung's TRANSITION statistics -- peak |err| and peak |i| from the command mark to the window
' start, which is the ramp to the new speed and the settle after it. windowStats() reads only the steady
' window, which opens after both, so its err_pk is the duty servo's ripple and cannot see a kick. The ring
' holds these samples already (the instrument is armed before the command); this pass reads them. A
' command sample the ring has overwritten makes the peak partial, so it is NA (WHY_RING_LOST_HEAD) rather
' than a smaller number. Samples whose driver was not up are left out, as in windowStats() (I3). Separate
' tr* staging, so the rs* statistics BM-RUNG2 prints are untouched.
'
' @param slotIdx - motor slot under test
' @param cmdTotal - total index of the first sample at or after the command mark, -1 when not recorded
' @param endTotal - total index at the window start, -1 when the window never opened
'
' @local sampleIdx - logical index
' @local startJ - logical index of the command's sample
' @local endJ - logical index of the last sample before the window
' @local firstJ - first sample walked, -1 when none
' @local lastJ - last sample walked

    drainBegin()
    trN := 0
    trErrPk := 0
    trIPk := 0
    trMs := 0
    firstJ := -1
    lastJ := -1
    if (cmdTotal < 0) or (endTotal <= cmdTotal) or (drStored == 0)
        trWhy := WHY_NO_SAMPLES
    elseif cmdTotal < drLostHead
        trWhy := WHY_RING_LOST_HEAD
    else
        trWhy := WHY_NONE
        startJ := cmdTotal - drLostHead
        endJ := (endTotal - 1 - drLostHead) <# (drStored - 1)
        if endJ >= startJ                                   ' a descending repeat would walk backwards
            repeat sampleIdx from startJ to endJ
                beat(CP_LOOP_DRAIN)
                if firstJ < 0
                    firstJ := sampleIdx
                lastJ := sampleIdx
                if bSmpUp(sampleIdx, slotIdx)
                    trN += 1
                    trErrPk #>= abs(smpErr(sampleIdx, slotIdx))
                    trIPk #>= abs(smpI(sampleIdx, slotIdx))
        if (firstJ >= 0) and (lastJ > firstJ)
            trMs := (smpT(lastJ) - smpT(firstJ)) / TICKS_PER_MS
        if trN == 0
            trWhy := WHY_NO_SAMPLES

PRI foldTransitionKick(slotIdx)
' TRKICK (PL-87, PL-95): a LADDER rung's transition kick, judged on CURRENT. A change of speed from a
' running speed kicks when its transition current peak stands more than TRKICK_EXCESS_MV above what the
' motor then draws holding that same speed -- tr_i_over, the record's own field. Only rungs whose
' transition AND steady window both measured are judged, and a start from rest is not a change of speed
' from a running speed, so it is not one of them -- which is what a zero from_incre says, the same fact
' the record prints as from_rest.
'
' WHAT THIS REPLACES, AND WHY. The cell used to judge tr_over, the same comparison on err, against a
' from-rest control. It PASSED 0 kicks of 22 per wheel at Visit 6a while Stephen felt a kick at every
' increment of the long ramps -- a false pass, and his hand is the control (doctrine D2: when the
' measurement and the system disagree, suspect the measurement). The cause is that err is CLAMPED: the
' lag limiter holds it near LAG_HOLD, so tr_over stayed inside +-5 counts across a ramp on which the
' transition current rose seventy-five-fold. An instrument built on a clamped observable is blind by
' construction, whatever control it is given, which is why the control machinery goes with it.
'
' THE REFERENCE IS THE RUNG'S OWN STEADY PEAK, not a control rung's, because current scales with speed:
' comparing a rung at the knee against a rung at 5x10^6 would measure the ladder, not the transition.
' PL-82's lesson applies to the choice and is respected here -- the reference is a peak against a peak,
' from the same rung, seconds apart, rather than a hold that drifts with motor temperature.
'
' @param slotIdx - motor slot

    if bTrIOverValid() and (rgFromIncre <> 0)               ' non-zero from_incre IS "from a running speed"
        sfTrN[slotIdx] := (sfTrN[slotIdx] + 1) <# LIM_SMALL
        if trIOver() > TRKICK_EXCESS_MV
            sfTrKicks[slotIdx] := (sfTrKicks[slotIdx] + 1) <# LIM_SMALL

VAR { transition statistics (PL-87) -- cog 0 only }

    LONG    rgCmdStart                                      ' total index of the first sample at or after the command mark
    LONG    trN                                             ' up samples in the transition
    LONG    trErrPk                                         ' peak |err| over the transition, err units
    LONG    trIPk                                           ' peak |i| over the transition, as BM-RUNG2's i_min / i_max
    LONG    trMs                                            ' the transition's span, command sample to last sample before the window
    LONG    trWhy                                           ' WHY_NONE when the tr* values are a measurement
    LONG    sfTrN[INST_MOTORS]                              ' TRKICK: running-speed transitions judged, per motor
    LONG    sfTrKicks[INST_MOTORS]                          ' TRKICK: of those, the ones that kicked

PRI rungWindow(side, bPollCurrent) : safeEvent | startMs, lastPollMs, ampsSum, ampsCount, hbStart, bComplete, hlWinLag, hlWinCap, hlEndLag, hlEndCap
' The rung's measurement window: a start mark (ring total), WINDOW_MS of beat-polled safety reads with
' getCurrent() every CURRENT_POLL_MS when asked, and an end mark. The window is delimited by the two
' instrument-recorded totals, never by time (sec 12.7). An interrupted window records no end total.
'
' R18.1: the driver's health counters are read at each mark, which closes the TRANSITION's difference
' and opens and closes the STEADY window's. Both reads are outside the measured interval.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param bPollCurrent - TRUE to read getCurrent()
' @returns safeEvent - SAFE_* that ended the window early, SAFE_NONE otherwise
'
' @local startMs - getms() at the start mark
' @local lastPollMs - getms() of the last getCurrent()
' @local ampsSum - sum of clamped readings, |sum| <= 51 x LIM_MID
' @local ampsCount - readings taken
' @local hbStart - instrument heartbeat at the window start
' @local bComplete - the window ran its full WINDOW_MS
' @local hlWinLag - lag_held at the window start
' @local hlWinCap - duty_capped at the window start
' @local hlEndLag - lag_held at the window end
' @local hlEndCap - duty_capped at the window end

    safetyReset()
    safeEvent := SAFE_NONE
    ampsSum := 0
    ampsCount := 0
    bComplete := FALSE
    hbStart := instHeartbeat
    ' R18.1: close the TRANSITION's health difference and open the WINDOW's, both from one read. It sits
    '  outside the measured interval, before the window's own mark and clock (doctrine D6).
    if bRgHlCmd and isWheelUp(side)
        hlWinLag, hlWinCap, rgHlDrvIncr := wheelDriveHealth(side)
        rgHlTrLag := hlWinLag - hlCmdLag                    ' NOT floored at zero: only a driver restart can
        rgHlTrCap := hlWinCap - hlCmdCap                    '  make it negative, and that must be visible
        bRgHlTrValid := TRUE
    rgWinStart := instMarkIndex()
    startMs := getms()
    lastPollMs := startMs
    repeat
        beat(CP_LOOP_WINDOW)
        if bPollCurrent and ((ampsCount == 0) or ((getms() - lastPollMs) >= CURRENT_POLL_MS))
            lastPollMs := getms()
            ampsSum += (wheelCurrent(side) #> (0 - LIM_MID)) <# LIM_MID
            ampsCount += 1
        waitms(SAMPLE_MS)
        safeEvent := safetyPoll(side)
        if safeEvent <> SAFE_NONE
            quit
        if (getms() - startMs) >= WINDOW_MS
            bComplete := TRUE
            quit
    if bComplete
        rgWinEnd := instMarkIndex()
        if bRgHlTrValid and isWheelUp(side)                 ' R18.1: the steady window's health difference
            hlEndLag, hlEndCap, _ := wheelDriveHealth(side)
            rgHlWinLag := hlEndLag - hlWinLag
            rgHlWinCap := hlEndCap - hlWinCap
            bRgHlWinValid := TRUE
    bRgHbOk := (instHeartbeat <> hbStart)
    if ampsCount > 0
        rgAmpsX10k := ampsSum / ampsCount
        bRgAmpsValid := bComplete

PRI rungEmitAll(seg, rid, rungIdx, side, motorIncre) | slotIdx, rung2Why
' Emit a measured rung's BM-RUNG, BM-RUNG2, BM-RUNGTR, BM-RUNGHL and BM-RUNG3 from the rg* / rs* / tr*
' staging, and fold it into R14-DUAL-INTEG-A (its integrity deltas), R14-DUAL-IDLEFLT-A (one motor-frame
' capture) and, for a LADDER rung, R17-DUAL-TRKICK-A (its transition current above its own steady peak).
'
' @param seg - SEG_* in progress
' @param rid - rung id
' @param rungIdx - index into ladderIncre (or the segment's rung number)
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
'
' @local slotIdx - motor slot
' @local rung2Why - BM-RUNG2's why: the rung's, or NO_SAMPLES when only this lifetime's zero is missing

    slotIdx := side - SIDE_LEFT
    emitRung(seg, rid, rungIdx, side, motorIncre, rgResult, rgSteadyMs, bRgSteadyValid, bRgWindowValid, rgWhy)
    rung2Why := rgWhy
    if (rung2Why == WHY_NONE) and (bLifeZeroValid[slotIdx] == FALSE)
        rung2Why := WHY_NO_SAMPLES
    emitRung2(rid, side, motorIncre, rgDutyMax, bRgWindowValid, rung2Why)
    emitRungTransition(rid, side, motorIncre)
    emitRung3(rid, side, motorIncre, rgMissedD, rgIllegalD, rgAmpsX10k, bRgAmpsValid, bRgWindowValid, rgWhy)
    if seg == SEG_LADDER
        foldTransitionKick(slotIdx)
    foldIntegrity(slotIdx, rgMissedD, rgIllegalD)
    sfIntegN[slotIdx] := (sfIntegN[slotIdx] + 1) <# LIM_BIG
    if bRgCaptured
        foldIdleWheel(slotIdx, bRgIdleUp)
    segItems := (segItems + 1) <# LIM_SMALL

PRI rungSkip(seg, rid, rungIdx, side, motorIncre, whyCode)
' Emit a rung that did not run: BM-RUNG result SKIPPED with the applied offsets and why.
'
' @param seg - SEG_* in progress
' @param rid - rung id
' @param rungIdx - index into ladderIncre (or the segment's rung number)
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param whyCode - WHY_* naming why it did not run

    rsOffNeg, rsOffPos := wheelGetOffsets(side)
    emitRung(seg, rid, rungIdx, side, motorIncre, RES_SKIPPED, 0, FALSE, FALSE, whyCode)
    segItems := (segItems + 1) <# LIM_SMALL

PRI bRungFaultRecover(seg, side, motorIncre, safeEvent) : bFaulted | bFaultSig
' Recover a rung's fault once its records are out (sec 4.2): a fault that ended the rung, or a fault
' flag set now.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - the rung's command
' @param safeEvent - SAFE_* that ended the rung
' @returns bFaulted - TRUE when a fault was found and recovery ran
'
' @local bFaultSig - the fault flag now

    bFaulted := (safeEvent == SAFE_FAULT)
    if (bFaulted == FALSE) and isWheelUp(side)
        _, _, bFaultSig := wheelClearedState(side)
        bFaulted := (bFaultSig <> FALSE)
    if bFaulted
        bRecoverFault(seg, 0, side, motorIncre, FAULT_COOL_MS)

PRI ladderSign(seg, side, signMul, pRungTable, rungCount) | orderIdx, rungIdx, motorIncre, rid, whyCode, consecFaults, safeEvent, bFaulted
' One motor x sign of the ladder, driven by an index table into ladderIncre (LADDER passes
' ladderAllIdx): one lifetime (zero read inside bWheelStart()), then the rungs in table order, each
' BM-RUNG / BM-RUNG2 / BM-RUNGTR / BM-RUNGHL / BM-RUNG3, faults recovered per sec 4.2. LADDER_FAULT_STOP consecutive faulted
' rungs, an absolute-current abort or a stalled instrument end the sign: the rest print SKIPPED why
' LADDER_STOPPED.
'
' @param seg - SEG_LADDER
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signMul - SIGN_NEG or SIGN_POS
' @param pRungTable - address of a LONG table of indices into ladderIncre
' @param rungCount - entries in that table
'
' @local orderIdx - position in the table
' @local rungIdx - index into ladderIncre
' @local motorIncre - signed increment
' @local rid - rung id
' @local whyCode - why the remaining rungs are skipped, WHY_NONE while they run
' @local consecFaults - consecutive faulted rungs
' @local safeEvent - SAFE_* that ended the last rung
' @local bFaulted - the rung just measured faulted and was recovered, so it counts toward LADDER_FAULT_STOP

    consecFaults := 0
    bFaulted := FALSE
    whyCode := WHY_NONE
    if bRunContinue(seg) == FALSE
        whyCode := WHY_ABORTED
    elseif bWheelStart(seg, side) == FALSE
        whyCode := stWhy
    repeat orderIdx from 0 to rungCount - 1
        beat(CP_LOOP_POLL)
        rungIdx := LONG[pRungTable][orderIdx]
        motorIncre := ladderIncre[rungIdx] * signMul
        rid := nextRungId()
        whyCode := trialSkipWhy(seg, side, whyCode)
        if whyCode <> WHY_NONE
            rungSkip(seg, rid, rungIdx, side, motorIncre, whyCode)
        else
            safeEvent := rungMeasure(side, motorIncre, LADDER_STEADY_MS, LADDER_SETTLE_MS, TRUE)
            rungEmitAll(seg, rid, rungIdx, side, motorIncre)
            ladderNoFold(side, rungIdx, motorIncre)
            bFaulted := bRungFaultRecover(seg, side, motorIncre, safeEvent)      ' a recovered fault leaves the wheel at rest, which slotLastIncre records
            if bFaulted
                consecFaults += 1
                if consecFaults >= LADDER_FAULT_STOP
                    whyCode := WHY_LADDER_STOPPED
            else
                consecFaults := 0
            if (safeEvent == SAFE_ABS_ABORT) or (safeEvent == SAFE_INST_STALL)
                whyCode := WHY_LADDER_STOPPED
    bZeroAndWaitStopped(side)
    bInstIdle()
    wheelStop(side)

PRI ladderNoFold(side, rungIdx, motorIncre) | slotIdx, predX10, ratioPct, bandPct, bDeratedNow
' Below the MOSFET limits the new current limiting must not act at all. That is TWO claims, and PL-79
' SPLIT THEM INTO TWO CELLS because one compound verdict could report neither:
'
'  NOFOLD  - the front cog never derated at a base rung. This is the claim the cell is named for, and it
'            is judged alone, so it can now say so.
'  RATELAW - every base rung still turns at the rate the speed law predicts, within a band that includes
'            the rung's OWN tick quantisation (rateBandPct()). C-1's cell judges the law; this one judges
'            whether a limiter moved it.
'
' WHY THEY HAD TO SEPARATE. One ANDed boolean covered both claims over every base rung, and rung 0 failed
' it unconditionally -- +/-3 % is narrower than the ~7.5 % that one tick is worth in a 13-tick count -- so
' the cell read FALSE on a driver tracking the law to 0.1 %, and a REAL fold-back at any rung would have
' been indistinguishable from that (doctrine D2: a gate that cannot fail on the thing it names has not
' passed). Read after the rung's window, from the rung's own statistics.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param rungIdx - index into ladderIncre
' @param motorIncre - the rung's signed increment
'
' @local slotIdx - motor slot
' @local predX10 - the rung's predicted rate x10
' @local ratioPct - measured rate as a percentage of the prediction
' @local bandPct - percent one tick of quantisation is worth at this rung's tick count
' @local bDeratedNow - the fold-back holds the continuous limit right now

    if rungIdx < LADDER_BASE_RUNGS
        slotIdx := side - SIDE_LEFT
        bDeratedNow := bWheelDerated(side)
        predX10 := predictX10(abs(motorIncre))
        ' the fold half: measurable on any base rung whose wheel answered, window or no window
        bSfNoFoldRan[slotIdx] := TRUE
        bSfNoFoldOk[slotIdx] := bSfNoFoldOk[slotIdx] and (bDeratedNow == FALSE)
        ' the rate half: only a valid window with a non-zero count and a prediction can be judged
        if bRgWindowValid and (predX10 > 0) and (rsTicks <> 0)
            ratioPct := (abs(rsRateX10) * 100) / predX10
            bandPct := rateBandPct(rsTicks)
            bSfRateLawRan[slotIdx] := TRUE
            bSfRateLawOk[slotIdx] := bSfRateLawOk[slotIdx] and (ratioPct >= (RATELAW_PCT_LO - bandPct)) and (ratioPct <= (RATELAW_PCT_HI + bandPct))

PRI rateBandPct(nTicks) : nExtraPct
' What one tick of quantisation is worth, in percent, at this rung's own tick count (PL-79). RATELAW's
' band is the criterion PLUS this, so the criterion is never narrower than the resolution the rung had:
' at 14 ticks one tick is about 7 %, at 441 it is under 1 %. Rounded up by one, so the band is never
' short by the division's remainder.
'
' @param nTicks - the rung's measured tick count over the window, signed and non-zero
' @returns nExtraPct - percent to widen each side of the band by

    nExtraPct := ((RATELAW_QUANT_TICKS * 100) / abs(nTicks)) + 1

PRI liveRung(side, rid, rungNum, motorIncre, skipWhy) : whyNext | slotIdx, safeEvent, rpmRead
' One LIVE rung (design sec 4.4, T1-2): AT_SPEED, settle LIVE_SETTLE_MS so the rpm window fills, a
' WINDOW_MS instrument window, then testGetRpm(); BM-LIVE, BM-RUNGTR and BM-RUNGHL. The QTR rung folds
' R14-DUAL-INSTLIVE-A: every sample up, |ticks| >= LIVE_MIN_TICKS, i_min <> i_max, heartbeat advanced,
' |ticks - hw_ticks| <= 2.
'
' R17-DUAL-TRKICK-A is NOT folded here, deliberately. These rungs settle LIVE_SETTLE_MS against the
' ladder's LADDER_SETTLE_MS, so their transition window is a different length and their tr_i_pk is not
' the same measurement; one verdict over two populations can fail on the mixture rather than on the
' drive (doctrine D2). The records are emitted, and Visit 7 reads them beside the ladder's.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param rid - rung id
' @param rungNum - 0 QTR, 1 HALF, 2 LIVE_TOP_INCRE
' @param motorIncre - signed increment
' @param skipWhy - WHY_NONE to run, else why it is skipped
' @returns whyNext - skip cause for the next rung, WHY_NONE while rungs may run
'
' @local slotIdx - motor slot
' @local safeEvent - SAFE_* that ended the rung
' @local rpmRead - testGetRpm() after the window

    slotIdx := side - SIDE_LEFT
    whyNext := skipWhy
    rpmRead := 0
    if skipWhy <> WHY_NONE
        windowStats(slotIdx, SLOT_RIGHT - slotIdx, -1, -1)  ' resets the rs* staging; reads no ring long
        emitLive(rid, side, motorIncre, rpmRead, FALSE, FALSE, skipWhy)
    else
        safeEvent := rungMeasure(side, motorIncre, STEADY_TIMEOUT_MS, LIVE_SETTLE_MS, FALSE)
        if bRgWindowValid
            rpmRead := wheelRpm(side)
        emitLive(rid, side, motorIncre, rpmRead, bRgHbOk, bRgWindowValid, rgWhy)
        ' R18.1 (PL-87): the SHORT ramps are measured too. Stephen felt a kick between rungs 2 and 3 of
        '  these three, and until now the segment emitted no transition record at all -- only LADDER and
        '  CLOCK did. Same shared pair they emit, so the two paths cannot record a transition differently.
        emitRungTransition(rid, side, motorIncre)
        if rungNum == LIVE_INSTLIVE_RUNG
            bSfLiveRan[slotIdx] := bRgSteadyValid
            bSfLiveOk[slotIdx] := bRgWindowValid and bRsAllUp and (abs(rsTicks) >= LIVE_MIN_TICKS) and (rsIMin <> rsIMax) and bRgHbOk and (abs(rsTicks - rsHwTicks) <= LIVE_HW_TOLERANCE)
        if bRungFaultRecover(SEG_LIVE, side, motorIncre, safeEvent)
            whyNext := WHY_FAULTED                          ' a recovery restart ends the sense cog testGetRpm() needs
        elseif (safeEvent == SAFE_ABS_ABORT) or (safeEvent == SAFE_INST_STALL)
            whyNext := safeWhy(safeEvent)
    segItems := (segItems + 1) <# LIM_SMALL

PRI clockHallIntegrity(side) | slotIdx, nMissed, nAllLow, nAllHigh
' PL-90 / PL-69 (task 3571): this wheel's hall integrity over its CLOCK lifetime -- entries into %000, into %111,
' and missed transitions -- printed as BM-HALLINT and folded into this clock's R17-DUAL-HALL-K* cell. The counts
' restart with every driver start, so the lifetime is the window: start, zero window, one rung, settle.
'
' THE BEFORE IS ALREADY ON FILE: Visit 3's 200 MHz load read 3 and 5 illegal codes on the RIGHT motor and none
' at 270 or 300 (PL-69), with the three-TESTP read and no input filter. This load carries the atomic read and
' the filt1 input filter, so the same load at the same clock is the comparison, and the %000/%111 split says
' which way a line was pulled when one still appears.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
'
' @local slotIdx - motor slot
' @local nMissed - missed transitions since this lifetime's start
' @local nAllLow - entries into %000
' @local nAllHigh - entries into %111

    slotIdx := side - SIDE_LEFT
    nMissed, _ := wheelIntegrity(side)
    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT                                   ' if/else, never `? :` -- PL-29, PL-76
        nAllLow, nAllHigh := wheelR.getHallIllegalCodes()
    else
        nAllLow, nAllHigh := wheelL.getHallIllegalCodes()
    beat(CP_LIB_QUERY)
    sfHallIllegal[slotIdx] := (sfHallIllegal[slotIdx] + nAllLow + nAllHigh) <# LIM_BIG
    sfHallLives[slotIdx] := (sfHallLives[slotIdx] + 1) <# LIM_SMALL
    emitHallInt(side, nAllLow, nAllHigh, nMissed)

PRI emitHallInt(side, nAllLow, nAllHigh, nMissed)
' BM-HALLINT (task 3571): one wheel's hall integrity over its CLOCK lifetime. Worst case 113 bytes:
' tag(10) + seq(15) + motor(12) + clk_mhz(13) + all_low(21) + all_high(22) + missed(20).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param nAllLow - entries into %000
' @param nAllHigh - entries into %111
' @param nMissed - missed transitions

    recBegin(@"BM-HALLINT")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"clk_mhz", CLK_FREQ / US_PER_SEC, LIM_TINY)
    benchLog.numField(@"all_low", nAllLow, LIM_BIG)
    benchLog.numField(@"all_high", nAllHigh, LIM_BIG)
    benchLog.numField(@"missed", nMissed, LIM_BIG)
    emitRecord()

PRI clockLifetime(side, signMul) | slotIdx, whyCode, deadGap, adcFrame, frameCnt, bFrameOk, rid, motorIncre, safeEvent
' One CLOCK lifetime (design sec 4.4, T1-4): start; testGetDriveConstants() -> BM-CLOCK, folded into
' this clock's R14-DUAL-CLKFRM-K200 / -K270 / -K300 cell (ANDed over the motor's lifetimes; judged only at a
' swept clock, SF_JUDGES_CELLS); zero (inside bWheelStart()); one rung at
' CLOCK_RUNG_INCRE -> BM-RUNG / BM-RUNG2 / BM-RUNG3.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signMul - SIGN_NEG or SIGN_POS
'
' @local slotIdx - motor slot
' @local whyCode - why the rung is skipped, WHY_NONE when it runs
' @local deadGap - dead_gap
' @local adcFrame - adc_fram
' @local frameCnt - frame_cnt
' @local bFrameOk - adc_fram equals the compiled clock's expected frame count
' @local rid - rung id
' @local motorIncre - signed increment
' @local safeEvent - SAFE_* that ended the rung

    slotIdx := side - SIDE_LEFT
    motorIncre := CLOCK_RUNG_INCRE * signMul
    whyCode := WHY_NONE
    if bRunContinue(SEG_CLOCK) == FALSE
        whyCode := WHY_ABORTED
    elseif bWheelStart(SEG_CLOCK, side) == FALSE
        whyCode := stWhy
    else
        deadGap, _, adcFrame, frameCnt := wheelDriveConstants(side)
        bFrameOk := bEmitClock(side, adcFrame, frameCnt, deadGap)
        if bSfClkRan[slotIdx]
            bSfClkOk[slotIdx] := (bSfClkOk[slotIdx] <> FALSE) and bFrameOk
        else
            bSfClkOk[slotIdx] := bFrameOk
        bSfClkRan[slotIdx] := TRUE
    rid := nextRungId()
    whyCode := trialSkipWhy(SEG_CLOCK, side, whyCode)
    if whyCode <> WHY_NONE
        rungSkip(SEG_CLOCK, rid, CLOCK_RUNG_IDX, side, motorIncre, whyCode)
    else
        safeEvent := rungMeasure(side, motorIncre, LADDER_STEADY_MS, LADDER_SETTLE_MS, TRUE)
        clockHallIntegrity(side)
        rungEmitAll(SEG_CLOCK, rid, CLOCK_RUNG_IDX, side, motorIncre)
        bRungFaultRecover(SEG_CLOCK, side, motorIncre, safeEvent)
    bZeroAndWaitStopped(side)
    bInstIdle()
    wheelStop(side)

PRI faultbTrial(side, signMul, trialIdx, skipWhy) | slotIdx, tid, motorIncre, rampInc, safeEvent, bReached, startMs, bStopped
' One FAULTB trial (design sec 4.4, T1-7): wheel stopped; setRampingValues(1_500, 200_000, inc, 50_000)
' read back; arm; mark; FB_INCRE from standstill; capture until AT_SPEED + FB_AT_SPEED_HOLD_MS, a fault,
' or FB_TIMEOUT_MS; freeze; restore the ramp defaults and read them back (BM-RAMPREST, I11) BEFORE any
' check; BM-TRACE cause RAMP, BM-TS, BM-TRACE-END; peaks and dsat from the trace; recovery (sec 4.2);
' BM-FBTRIAL; zero, wait stopped; cool FAULT_TRIAL_COOL_MS.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signMul - SIGN_NEG or SIGN_POS
' @param trialIdx - 0-based trial, index into fbRampIncs
' @param skipWhy - WHY_NONE to run, else why the lifetime could not start
'
' @local slotIdx - motor slot
' @local tid - trace id
' @local motorIncre - signed increment
' @local rampInc - ramp_inc read back for the header
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - AT_SPEED was reached
' @local startMs - getms() at the command
' @local bStopped - the trial's own stop from speed reached rest inside the capture

    slotIdx := side - SIDE_LEFT
    tid := nextTraceId()
    bStopped := FALSE
    motorIncre := FB_INCRE * signMul
    cpReset()
    fbTrial := trialIdx + 1
    fbRampInc := fbRampIncs[trialIdx]
    fbIncre := motorIncre
    fbResult := RES_OK
    fbTMs := 0
    bFbTValid := FALSE
    fbIPk := 0
    fbDutyPk := 0
    bFbDsat := FALSE
    fbRst := RST_NONE
    fbRstMs := 0
    safeEvent := SAFE_NONE
    bReached := FALSE
    _, fbDutyMax, _, _ := wheelDriveConstants(side)
    cpWantNeg, cpWantPos := wheelGetOffsets(side)
    fbOffNeg := cpWantNeg
    fbOffPos := cpWantPos
    fbWhy := trialSkipWhy(SEG_FAULTB, side, skipWhy)
    if fbWhy <> WHY_NONE
        rampInc := wheelRampInc(side)
        fbResult := RES_SKIPPED
        traceSkip(tid, SEG_FAULTB, side, CAUSE_RAMP, motorIncre, MODE_FLOAT, rampInc, fbWhy)
    else
        rampInc := wheelSetRamp(side, fbRampInc)
        if bInstArm(INST_SRC_WHEELS, 1) == FALSE
            cpWhy := WHY_INST_NOACK
        else
            safeEvent, _ := waitWatched(side, STOP_TIMEOUT_MS, CP_LOOP_STOPPED, UNTIL_STOPPED)
            if safeEvent == SAFE_NONE
                instMark()
                startMs := getms()
                wheelCommand(side, motorIncre)
                safeEvent, bReached := waitWatched(side, FB_TIMEOUT_MS, CP_LOOP_CAPTURE, UNTIL_AT_SPEED)
                fbTMs := getms() - startMs
                bFbTValid := bReached or (safeEvent == SAFE_FAULT)
                if (safeEvent == SAFE_NONE) and bReached
                    safeEvent, _ := waitWatched(side, FB_AT_SPEED_HOLD_MS, CP_LOOP_CAPTURE, UNTIL_TIME)
                    ' task 3558: THE STOP IS NOW PART OF THE TRIAL, inside the same capture. The design
                    '  bounds the current a stop from speed draws, and Visit 2 measured the unbounded one
                    '  tripping this harness's own 10 A abort (PL-55) -- so the stop has to be measured on
                    '  the same instrument, on the same scale, as the hold it is compared against. A trial
                    '  that faulted or aborted on the way up never reaches here and stops nothing.
                    if safeEvent == SAFE_NONE
                        wheelStopMotor(side)
                        safeEvent, bStopped := waitRest(side, STOP_TIMEOUT_MS, TRUE)
            bCpFaultSeen := (safeEvent == SAFE_FAULT)
            if safeEvent <> SAFE_NONE
                cpEnd := safeEnd(safeEvent)
            elseif bStopped
                cpEnd := TEND_REST
            else
                cpEnd := bReached ? TEND_FROZEN : TEND_TIMEOUT
            bCpFrozen := bInstFreeze(0)
            if bCpFrozen == FALSE
                cpWhy := WHY_INST_NOACK
        bRestoreRamp(side)                                   ' I11: before any check, on every path that set the ramp
        case safeEvent
            SAFE_FAULT:
                fbResult := RES_FAULT
                if bFbTValid == FALSE
                    cpWhy := WHY_FAULTED                    ' faulted before the command
            SAFE_ABS_ABORT:
                fbResult := RES_ABORT_I
                cpWhy := WHY_ABORTED
            SAFE_INST_STALL:
                fbResult := RES_WINDOW_TIMEOUT
                cpWhy := WHY_INST_STALLED
            other:
                if cpWhy <> WHY_NONE
                    fbResult := RES_SKIPPED
                elseif bReached == FALSE
                    fbResult := RES_STEADY_TIMEOUT
                    cpWhy := WHY_STEADY_TIMEOUT
        traceEmitCapture(SEG_FAULTB, side, tid, CAUSE_RAMP, motorIncre, MODE_FLOAT, rampInc)
        if bCpFrozen
            traceFaultStats(slotIdx)
            traceStopCurrent(slotIdx)
            emitStopCur(tid, side, slotIdx)
            fbFoldCells(slotIdx, safeEvent, bReached)
        fbRst, fbRstMs := traceRecover(SEG_FAULTB, side, tid, motorIncre, FAULT_TRIAL_COOL_MS)
        if bFbTValid == FALSE
            fbWhy := (cpWhy <> WHY_NONE) ? cpWhy : WHY_NOT_REACHED
        if fbRst == RST_NONE
            waitBeat(FAULT_TRIAL_COOL_MS, CP_LOOP_COOL)
    emitFbTrial(tid, side)
    segItems := (segItems + 1) <# LIM_SMALL

PRI traceStopCurrent(slotIdx) | sampleIdx, iSum, holdCount, eDrvrState, bSawStop
' STOPCUR's numbers, from the frozen FAULTB capture: over the AT_SPEED hold, the mean AND THE PEAK
' sense_i; over the spin-down, the largest sense_i.
'
' PL-82: THE HOLD PEAK IS TAKEN BECAUSE A PEAK MUST BE COMPARED WITH A PEAK. The cell used to compare the
' spin-down peak against the hold MEAN, which the AT_SPEED ripple alone can lose -- the design's own
' unloaded trace swings sense_i over a visible range while the mean sits well under it. The mean is kept
' because it is what the thermal drift is visible in; neither is the criterion any more (see
' STOPCUR_BOUND_MV).
'
' The two windows are told apart by the DRIVER'S OWN STATE, not by a time this cog recorded: a trial
' reaches AT_SPEED once and leaves it once, so the states partition the capture without any index
' bookkeeping, and every reading comes from the same scale. Legal only while FROZEN (I10).
'
' @param slotIdx - motor slot under test
'
' @local sampleIdx - logical index
' @local iSum - sum of sense_i over the hold
' @local holdCount - hold samples
' @local eDrvrState - the sample's driver state
' @local bSawStop - a spin-down sample was seen

    scHoldIX10[slotIdx] := 0
    scHoldPk[slotIdx] := 0
    scStopPk[slotIdx] := 0
    scSamples[slotIdx] := 0
    bScValid[slotIdx] := FALSE
    iSum := 0
    holdCount := 0
    bSawStop := FALSE
    if (drStored > 0) and (drEndJ >= drStartJ)
        repeat sampleIdx from drStartJ to drEndJ
            beat(CP_LOOP_DRAIN)
            if bSmpUp(sampleIdx, slotIdx)
                eDrvrState := smpState(sampleIdx, slotIdx)
                if eDrvrState == DCS_AT_SPEED
                    iSum += smpI(sampleIdx, slotIdx)
                    scHoldPk[slotIdx] #>= smpI(sampleIdx, slotIdx)
                    holdCount += 1
                elseif eDrvrState == DCS_SPIN_DN
                    scStopPk[slotIdx] #>= smpI(sampleIdx, slotIdx)
                    bSawStop := TRUE
    if (holdCount > 0) and bSawStop
        scHoldIX10[slotIdx] := (iSum * X10) / holdCount
        scSamples[slotIdx] := holdCount
        bScValid[slotIdx] := TRUE

PRI fbFoldCells(slotIdx, safeEvent, bReached)
' The two FAULTB cells, folded from the trial that has just been emitted.
'
'  STOPCUR   - the stop's peak current stayed under STOPCUR_BOUND_MV, a FIXED bound, and the harness's
'              10 A abort never fired. MEASURED at Visit 2 on the unbounded stop: 20-50 % above the hold,
'              and two trials aborted outright (PL-55). PL-82: it used to be judged against the hold
'              current measured moments earlier, which drifts about 25 % as the motor warms -- so the cell
'              failed on its reference rather than on the stop. The hold's mean and peak are still
'              recorded in BM-STOPCUR; they are evidence for the reader, not the criterion.
'  RMPDROOP  - a ramp the motor cannot follow now DROOPS instead of faulting. The three steep trials
'              (ramp_inc 500, 2_000 and 10_000) faulted 3 of 3 at Visit 2, in 96-186 ms; with the lag
'              limiter the field waits for the rotor and the trial reaches speed instead.
'
' @param slotIdx - motor slot
' @param safeEvent - SAFE_* that ended the trial
' @param bReached - AT_SPEED was reached

    if bScValid[slotIdx]
        bSfStopCurRan[slotIdx] := TRUE
        bSfStopCurOk[slotIdx] := bSfStopCurOk[slotIdx] and (scStopPk[slotIdx] <= STOPCUR_BOUND_MV) and (safeEvent <> SAFE_ABS_ABORT)
    if fbRampInc >= FB_DROOP_MIN_INC
        bSfDroopRan[slotIdx] := TRUE
        bSfDroopOk[slotIdx] := bSfDroopOk[slotIdx] and bReached and (fbResult <> RES_FAULT) and (bCpFaultSeen == FALSE)

PRI traceFaultStats(slotIdx) | sampleIdx, bFirstFlt
' BM-FBTRIAL's peaks from the drained trace: the largest i and duty over up samples, and dsat, whether
' duty had reached duty_max at the first sample whose fault flag is set. Legal only while FROZEN (I10).
'
' @param slotIdx - motor slot under test
'
' @local sampleIdx - logical index
' @local bFirstFlt - the first faulted sample has been seen

    fbIPk := 0
    fbDutyPk := 0
    bFbDsat := FALSE
    bFirstFlt := FALSE
    if (drStored > 0) and (drEndJ >= drStartJ)
        repeat sampleIdx from drStartJ to drEndJ
            beat(CP_LOOP_DRAIN)
            if bSmpUp(sampleIdx, slotIdx)
                fbIPk #>= smpI(sampleIdx, slotIdx)
                fbDutyPk #>= smpDuty(sampleIdx, slotIdx)
                if (bFirstFlt == FALSE) and bSmpFault(sampleIdx, slotIdx)
                    bFirstFlt := TRUE
                    bFbDsat := (smpDuty(sampleIdx, slotIdx) >= fbDutyMax)

PRI overshootTrial(sid, leftFt, rightFt, skipWhy) : whyNext | tid, safeEvent, bReached, recoverWhy, bStraight
' One OVERSHT trial (design sec 4.4, T1-8): arm on the steering source (OVERSHT_DECIM); the SYNC_PRECOND
' check before the drive call (sec 4.3); mark; driveForDistance(left, right, DDU_FT); wait both wheels
' moving, then both STOPPED + OVERSHT_HOLD_MS (<= OVERSHT_WAIT_MS); freeze; BM-STRACE, BM-TS, BM-TRACE-END,
' BM-OVERSHOOT, and BM-TURN when the two distances differ; stopMotors(); a fault recovered through the
' pass-throughs. power prints OVERSHT_POWER, the value segOvershoot() set (sec 12.8).
'
' @param sid - the steering start's life
' @param leftFt - the left wheel's commanded distance, feet
' @param rightFt - the right wheel's commanded distance, feet
' @param skipWhy - WHY_NONE to run, else why it is skipped
' @returns whyNext - skip cause for the next trial, WHY_NONE while trials may run
'
' @local tid - trace id
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - the awaited state was reached
' @local recoverWhy - steerRecoverFault()'s result
' @local bStraight - both wheels were given one distance (a turn otherwise)

    tid := nextTraceId()
    cpReset()
    whyNext := skipWhy
    safeEvent := SAFE_NONE
    bReached := FALSE
    ovLeftStop := 0
    ovRightStop := 0
    ovLeftRest := 0
    ovRightRest := 0
    ovRightRestPf := 0
    ovLeftTrk := 0
    ovRightTrk := 0
    ovTStopMs := 0
    ovLeftIg := 0
    ovRightIg := 0
    ovWhy := WHY_NONE
    if (whyNext == WHY_NONE) and (bRunContinue(SEG_OVERSHT) == FALSE)
        whyNext := WHY_ABORTED
    if whyNext <> WHY_NONE
        cpWhy := whyNext
    elseif bInstArm(INST_SRC_STEER, OVERSHT_DECIM) == FALSE
        cpWhy := WHY_INST_NOACK
    elseif bSteerDrivePrecondition(SEG_OVERSHT, tid) == FALSE
        cpWhy := WHY_SYNC_PRECOND
    else
        instMark()
        beat(CP_LIB_STEER_DRIVE)
        steering.driveForDistance(leftFt, rightFt, steering.DDU_FT)
        beat(CP_LIB_STEER_DRIVE)
        ' both wheels still read STOPPED at the call's return, so the stop wait follows a moving wait
        safeEvent, bReached := waitWatched(SIDE_BOTH, OVERSHT_MOVE_MS, CP_LOOP_CAPTURE, UNTIL_MOVING)
        if (safeEvent == SAFE_NONE) and bReached
            safeEvent, bReached := waitWatched(SIDE_BOTH, OVERSHT_WAIT_MS, CP_LOOP_CAPTURE, UNTIL_STOPPED)
            if (safeEvent == SAFE_NONE) and bReached
                safeEvent, _ := waitWatched(SIDE_BOTH, OVERSHT_HOLD_MS, CP_LOOP_CAPTURE, UNTIL_TIME)
        if safeEvent <> SAFE_NONE
            cpEnd := safeEnd(safeEvent)
            bCpFaultSeen := (safeEvent == SAFE_FAULT)
        else
            cpEnd := bReached ? TEND_REST : TEND_TIMEOUT
    bCpFrozen := bInstFreeze(0)
    if bSteerUp
        ovLeftTrk, ovRightTrk := steerTrackTicks()
    emitSTrace(tid, SEG_OVERSHT, CAUSE_DISTANCE, OVERSHT_POWER, OVERSHT_POWER, TRUE, 0, MODE_FLOAT, cpWhy)
    if bCpFrozen and (cpWhy == WHY_NONE)
        bTraceDrain(tid, SLOT_LEFT, SLOT_RIGHT, cpEnd)
        overshootStats()
    else
        if cpWhy == WHY_NONE
            cpWhy := WHY_INST_NOACK
        traceEmptyEnd(tid, TEND_ABORT, cpWhy)
        ovWhy := cpWhy
    bStraight := (leftFt == rightFt)
    emitOvershoot(tid, sid, OVERSHT_POWER, leftFt, bStraight)
    if bStraight == FALSE
        emitTurn(tid, leftFt, rightFt)
    overshootFoldCells(tid, sid, overshootTarget(leftFt), overshootTarget(rightFt), bStraight)
    if bSteerUp
        steerStopMotors()
        recoverWhy := steerRecoverFault(tid)
        if recoverWhy <> WHY_NONE
            whyNext := recoverWhy
        if bCpFrozen
            waitWatched(SIDE_BOTH, STOP_TIMEOUT_MS, CP_LOOP_STOPPED, UNTIL_STOPPED)
    elseif whyNext == WHY_NONE
        whyNext := WHY_NO_COG
    segItems := (segItems + 1) <# LIM_SMALL

PRI overshootStats() | sampleIdx, leftStopJ, rightStopJ
' BM-OVERSHOOT's measurements from the drained steering trace, located by ring index (sec 12.7): each
' wheel's pos delta from the mark to its first DCS_SPIN_DN sample and to the last sample, and the time to
' the left wheel's first SPIN_DN as sample count x period (never a getct() difference across the capture).
'
' @local sampleIdx - logical index
' @local leftStopJ - first left SPIN_DN sample, -1 when none
' @local rightStopJ - first right SPIN_DN sample, -1 when none

    ovWhy := WHY_NOT_REACHED
    ovLeftIg := drIgSum
    ovRightIg := drOIgSum
    leftStopJ := -1
    rightStopJ := -1
    if bDrMarkFound and (drEndJ >= drMarkJ)
        repeat sampleIdx from drMarkJ to drEndJ
            beat(CP_LOOP_DRAIN)
            if (leftStopJ < 0) and (smpState(sampleIdx, SLOT_LEFT) == DCS_SPIN_DN)
                leftStopJ := sampleIdx
            if (rightStopJ < 0) and (smpState(sampleIdx, SLOT_RIGHT) == DCS_SPIN_DN)
                rightStopJ := sampleIdx
            if (leftStopJ >= 0) and (rightStopJ >= 0)
                quit
        if (leftStopJ >= 0) and (rightStopJ >= 0)
            ovLeftStop := smpPos(leftStopJ, SLOT_LEFT) - smpPos(drMarkJ, SLOT_LEFT)
            ovRightStop := smpPos(rightStopJ, SLOT_RIGHT) - smpPos(drMarkJ, SLOT_RIGHT)
            ovLeftRest := smpPos(drEndJ, SLOT_LEFT) - smpPos(drMarkJ, SLOT_LEFT)
            ovRightRest := smpPos(drEndJ, SLOT_RIGHT) - smpPos(drMarkJ, SLOT_RIGHT)
            ovRightRestPf := ovRightRest * STEER_RIGHT_RAW_SIGN
            ovTStopMs := ((leftStopJ - drMarkJ) * INST_PERIOD_US * instDecimate) / US_PER_MS
            ovWhy := WHY_NONE

PRI overshootTarget(distFt) : tgtTicks
' The DERIVED target ticks of one of OVERSHT's two commanded distances.
'
' @param distFt - OVERSHT_FT_SHORT or OVERSHT_FT_LONG
' @returns tgtTicks - OVERSHT_TGT_SHORT or OVERSHT_TGT_LONG

    tgtTicks := (distFt == OVERSHT_FT_LONG) ? OVERSHT_TGT_LONG : OVERSHT_TGT_SHORT

PRI overshootFoldCells(tid, sid, leftTgt, rightTgt, bStraight) | tickMmX100, worstOff
' The OVERSHT cells, from the trial's own measurements.
'
'  STOPLIMIT - on a straight trial, EACH wheel comes to rest AT its own limit. Since task 3570 (finding AB)
'              driveForDistance() stops each wheel at its own distance rather than both at the first
'              wheel's, so both are judged: the old shared stop left the slower wheel short, which this now
'              fails. MEASURED before task 3559: about 77 ticks past, which is the whole deceleration.
'  TURNDIST  - task 3577: the same judgement on a TURN trial, where the two limits differ. The unfixed
'              library stopped both wheels at the shorter distance, so the long wheel rested hundreds of
'              ticks short and this fails.
'  Both judge in the PLATFORM frame. The right wheel's raw rest runs negative for forward travel
'  (STEER_RIGHT_RAW_SIGN, applied once in overshootStats() as ovRightRestPf); task 3570's per-wheel check
'  compared it raw against a positive target, which read a correct stop as 2 x the target off (Visit 5's
'  r_rest -529 against 529).
'  DISTM     - getDistance(DDU_M) agrees with the ticks it is derived from. Task 3502 corrected the metre
'              conversion by a factor of ten and no bench reading has compared the two since; Visit 3 left
'              it unqualified. The comparison uses the library's own travel-per-tick, read from the motor
'              object's geometry, so the harness is not carrying a copy of a number that lives there.
'
' @param tid - trace id of the trial
' @param sid - the steering start's life
' @param leftTgt - the left wheel's DERIVED target ticks
' @param rightTgt - the right wheel's DERIVED target ticks
' @param bStraight - TRUE for a straight trial (STOPLIMIT), FALSE for a turn (TURNDIST)
'
' @local tickMmX100 - wheel travel per hall tick, hundredths of a mm
' @local worstOff - the larger wheel's |rest - its own target|, platform frame

    if ovWhy == WHY_NONE
        worstOff := abs(ovLeftRest - leftTgt) #> abs(ovRightRestPf - rightTgt)
        if bStraight
            sfStopLimMax #>= worstOff
            sfStopLimN := (sfStopLimN + 1) <# LIM_SMALL
        else
            sfTurnMax #>= worstOff
            sfTurnN := (sfTurnN + 1) <# LIM_SMALL
    if bSteerUp
        _, tickMmX100 := wheelL.wheelGeometry()
        ' PL-77: ONE READ, and the record carries the tick count the getter actually saw. This used to
        '  take the ticks from ovLeftTrk/ovRightTrk -- a SNAPSHOT the overshoot trial saved earlier --
        '  and compare them against a LIVE getDistance(), while the emitter's comment claimed both sides
        '  came from the same instant. They did not, so the cell could not tell a conversion fault from
        '  two reads taken moments apart, and it printed the prediction's input rather than the
        '  measurement's. Reading the ticks here, adjacent to the metres, is what makes the comparison
        '  be of the conversion alone (doctrine D2: an instrument that cannot show the difference proves
        '  nothing).
        dmLeftTicks, dmRightTicks := steerTrackTicks()
        dmLeftM, dmRightM := steerDistanceM()
        ' PL-84: read back the STEERING object's OWN travel-per-tick, the one every distance it reports
        '  or accepts is scaled by, beside the MOTOR object's. They are two copies and only the motor's
        '  was ever in the record, so a corrupted steering copy printed a healthy 576 and the cell could
        '  not see it. At Visit 4 the steering copy was about -544_643: getDistance(DDU_M) returned
        '  -14_640 for 2_688 ticks and driveForDistance() refused every trial with ERR_LIMIT_UNRESOLVABLE,
        '  and both are exactly what that value produces. One field tells the two apart.
        dmSteerMmX100 := steerTickInMM()
        dmLeftPredM := ticksToMetres(dmLeftTicks, tickMmX100)
        dmRightPredM := ticksToMetres(dmRightTicks, tickMmX100)
        ' ANDed over every trial that ran (initRunState() starts it TRUE; it is NOMEAS until one does)
        ' PL-84: the two travel-per-tick copies must agree. start() sets the steering object's from
        '  ltWheel.wheelGeometry(), so they are equal by construction and a difference is a corrupted
        '  copy -- the cell now FAILS ON THE THING IT CAN SEE rather than only on the distance the
        '  corruption produced.
        bSfDistMOk := bSfDistMOk and (dmSteerMmX100 == tickMmX100)
        bSfDistMOk := bSfDistMOk and (abs(dmLeftM - dmLeftPredM) <= DISTM_TOL_M) and (abs(dmRightM - dmRightPredM) <= DISTM_TOL_M)
        bSfDistMRan := TRUE
        emitDistM(tid, sid, tickMmX100)

PRI ticksToMetres(nTicks, tickMmX100) : nMetres
' Convert hall ticks to whole metres the way the library does: travel per tick in hundredths of a mm,
' rounded to nearest rather than truncated.
'
' PL-77: THE CONVERSION IS SIGNED, because the library's getter is. This took abs(nTicks), so the
' prediction was always positive while getDistance() returned the sign of travel -- and every trial that
' ran in reverse disagreed with its own prediction by construction, whatever the conversion did. The
' rounding term carries the sign with the value so a negative distance rounds away from zero, matching
' the positive case rather than biasing it by one metre.
'
' @param nTicks - tracked hall ticks, signed
' @param tickMmX100 - wheel travel per hall tick, hundredths of a mm
' @returns nMetres - the distance in whole metres, signed

    if nTicks < 0
        nMetres := 0 - (((0 - nTicks) * tickMmX100 + (MM_PER_M_X100 / 2)) / MM_PER_M_X100)
    else
        nMetres := (nTicks * tickMmX100 + (MM_PER_M_X100 / 2)) / MM_PER_M_X100

PRI steerTickInMM() : nMmX100
' The STEERING object's own travel-per-tick, through its TEST-USE pass-through (PL-84).
'
' @returns nMmX100 - the steering object's tickInMM_x100, hundredths of a mm per hall tick

    beat(CP_LIB_STEER_QUERY)
    nMmX100 := steering.testGetTickInMM()
    beat(CP_LIB_STEER_QUERY)

PRI steerDistanceM() : leftM, rightM
' Both wheels' travelled distance in metres, through the public getter.
'
' @returns leftM - the left wheel's distance, metres
' @returns rightM - the right wheel's distance, metres

    beat(CP_LIB_STEER_QUERY)
    leftM, rightM := steering.getDistance(steering.DDU_M)
    beat(CP_LIB_STEER_QUERY)

PRI faultApiTrial(sid, skipWhy) | tid, whyCode, markMs, rowIdx, recoverWhy, safeEvent, bReached
' The OVERSHT fault-API trial (task 3552, extended by task 3560): certify that a user of the STEERING
' object sees a fault through its public API, that the latch task 3547 stopped auto-clearing is still set
' more than FLTAPI_LATCH_MS later, and that the SAME POWER commanded afterwards runs the motor again
' (PL-66).
'
' THE PROVOCATION IS COMPUTED, NOT CHOSEN (task 3572, PL-86). The ramp that faulted 3 of 3 at Visit 2 now
' droops instead (the lag limiter; RMPDROOP says so). A 180-degree offset written AT REST then replaced it,
' and at Visits 4 and 5 it never faulted: the start re-seeds the field from the halls plus the new offset,
' the limiter holds the field, and the wheel drew ~16 A until this harness's own 10 A abort ended it. The
' construction now: drive to speed, read each wheel's own position error, and shift that wheel's offsets by
' exactly what moves its error to +-128 (faultShiftDeg()). The fault test is |err| >= 125, so the error lands
' with 3 units of margin on either side, in the very next control frame -- before the current can build.
' DERIVED, not measured: if it does not fault, the trial prints NO_FAULT and every cell below it is NOMEAS
' rather than passing by silence.
'
' LAGBOUND IS EXEMPT for the provocation window: this step drives the lag to the limit on purpose, and
' folding it into the run's maximum would make the lag limiter look broken in the one part that breaks it
' deliberately.
'
' The offsets are restored and read back BEFORE the retry (I11) -- a retry under a 180-degree offset would
' fault again and measure nothing.
'
' NO CAPTURE IS DRAINED. The rows already show the post-fault coast at API resolution; the coast at
' instrument resolution is S-9a, motor characterisation, which this trial does not measure.
'
' @param sid - the steering start's life, 0 when it did not start
' @param skipWhy - WHY_NONE to run, else why the segment's trials are being skipped
'
' @local tid - trace id
' @local whyCode - why the verdict was not reached, WHY_NONE when it was
' @local markMs - getms() at the command: the t_ms origin of every row
' @local rowIdx - 0-based poll row
' @local recoverWhy - steerRecoverFault()'s result
' @local safeEvent - SAFE_* from the wait for speed
' @local bReached - both wheels reached AT_SPEED before the provocation

    tid := nextTraceId()
    cpReset()
    outCount := 0
    fltLeftShift := 0
    fltRightShift := 0
    fltLeftCause := wheelL.FC_NONE
    fltRightCause := wheelL.FC_NONE
    whyCode := skipWhy
    if (whyCode == WHY_NONE) and (bRunContinue(SEG_OVERSHT) == FALSE)
        whyCode := WHY_ABORTED
    ' one guard around the whole body: a skipped trial commands nothing, so it has no offset to restore
    '  and no fault to recover, and it still prints its record below
    if whyCode == WHY_NONE
        if bSteerUp == FALSE
            whyCode := WHY_NO_COG
        elseif bInstArm(INST_SRC_STEER, OVERSHT_DECIM) == FALSE
            whyCode := WHY_INST_NOACK
        else
            bInstLagExempt := TRUE                          ' the lag below is provoked on purpose
            ' PL-86: drive FIRST and provoke at speed. An offset written at rest is absorbed: the start re-seeds
            '  the field from the halls PLUS the new offset, the lag limiter then holds the field, and the wheel
            '  draws ~16 A without ever faulting (Visits 4 and 5)
            if bSteerDriveBoth(SEG_OVERSHT, tid, FLTAPI_POWER) == FALSE
                whyCode := WHY_SYNC_PRECOND
            else
                safeEvent, bReached := waitWatched(SIDE_BOTH, D_AT_SPEED_MS, CP_LOOP_ATSPEED, UNTIL_AT_SPEED)
                if safeEvent <> SAFE_NONE
                    whyCode := safeWhy(safeEvent)
                elseif bReached == FALSE
                    whyCode := WHY_STEADY_TIMEOUT
            if whyCode == WHY_NONE
                fltLeftShift := faultShiftDeg(SIDE_LEFT, TRUE)
                fltRightShift := faultShiftDeg(SIDE_RIGHT, TRUE)
                fltLeftInc, fltRightInc := steerOffsetProvoke(fltLeftShift, fltRightShift)
                markMs := getms()
                whyCode := safeWhy(steerPollPhase(markMs, markMs, FLTAPI_POLL_MS, FALSE, TRUE))
            bCpFrozen := bInstFreeze(0)
            steerStopMotors()
            steerOffsetRestore()                            ' I11: before any check, on every path that wrote them
            bInstLagExempt := FALSE
            if (bCpFrozen == FALSE) and (whyCode == WHY_NONE)
                whyCode := WHY_INST_NOACK
            if whyCode == WHY_NONE
                whyCode := fltApiVerdict()
            ' S-7: the cause each wheel latched -- read before the retry, which could fault again and replace it
            beat(CP_LIB_STEER_QUERY)
            fltLeftCause, fltRightCause := steering.getFaultCause()
            beat(CP_LIB_STEER_QUERY)
            fltApiRetry()                                   ' PL-66, on the restored offsets
            recoverWhy := steerRecoverFault(tid)
            if (recoverWhy <> WHY_NONE) and (whyCode == WHY_NONE)
                whyCode := recoverWhy
    emitFltApi(tid, sid, whyCode)
    if outCount > 0
        repeat rowIdx from 0 to outCount - 1
            beat(CP_LOOP_DRAIN)
            emitOut(tid, sid, rowIdx)
    segItems := (segItems + 1) <# LIM_SMALL

PRI faultShiftDeg(side, bSteerForm) : shiftDeg | sampleIdx, errSum, errMean, shiftUnits
' The commutation-offset shift that puts this wheel's position error on the driver's fault test (PL-86, PL-59).
'
' The driver's err is one electrical cycle in ERR_UNITS_PER_TURN signed units, so it wraps at +-128, and it
' faults at |err| >= 125. The driver computes err = field angle - (hall angle + offset), and init() maps
' offset degrees positively (degrees frac 360), so raising the offset by D units LOWERS err by D in the next
' control frame, the field angle itself not moving. So D = err + ERR_FAULT_TARGET lands the error on -128, the
' wrap: any landing from 125 to 131 away faults, which is +-3 units (+-4 degrees) of margin against the
' 1-degree offset resolution. The hall angle steps once per hall code, so err sweeps across each step and
' passes the landing point within one hall step. The error is averaged over FAULT_ERR_SAMPLES reads at speed.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param bSteerForm - TRUE to read the wheel through the steering object, FALSE through the wheel object
' @returns shiftDeg - the shift to add to both of the wheel's offsets, degrees [0..359]
'
' @local sampleIdx - read counter
' @local errSum - sum of the reads
' @local errMean - the wheel's mean position error at speed, err units
' @local shiftUnits - the shift, err units [0..255]

    errSum := 0
    repeat sampleIdx from 1 to FAULT_ERR_SAMPLES
        beat(CP_LOOP_POLL)
        errSum += wheelErr(side, bSteerForm)
        waitms(SAMPLE_MS)
    errMean := errSum / FAULT_ERR_SAMPLES
    shiftUnits := (errMean + ERR_FAULT_TARGET) & ERR_UNITS_MASK
    shiftDeg := ((shiftUnits * DEG_PER_TURN) + (ERR_UNITS_PER_TURN / 2)) / ERR_UNITS_PER_TURN

PRI wheelErr(side, bSteerForm) : nErr
' One wheel's latest position error from the driver's status block.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param bSteerForm - TRUE to read it through the steering object's pass-through, FALSE through the wheel object
' @returns nErr - the error, signed err units (ERR_UNITS_PER_TURN per electrical cycle)

    beat(CP_LIB_QUERY)
    if bSteerForm                                           ' if/else, never `? :` -- PL-29, PL-76
        if side == SIDE_RIGHT
            _, nErr, _, _, _, _, _, _ := steering.testRightGetTelemetry()
        else
            _, nErr, _, _, _, _, _, _ := steering.testLeftGetTelemetry()
    elseif side == SIDE_RIGHT
        _, nErr, _, _, _, _, _, _ := wheelR.testGetTelemetry()
    else
        _, nErr, _, _, _, _, _, _ := wheelL.testGetTelemetry()
    beat(CP_LIB_QUERY)

PRI steerOffsetProvoke(leftShiftDeg, rightShiftDeg) : leftNeg, rightNeg | leftPos, rightPos
' Shift each wheel's commutation offsets by its own computed amount (faultShiftDeg()) from the pair it is
' running, and return the negative-increment offset each wheel read back. The pair in force is read first and
' kept in the flt* staging, so the restore puts back what was actually there rather than what this file
' believes is there.
'
' @param leftShiftDeg - the left wheel's shift, degrees
' @param rightShiftDeg - the right wheel's shift, degrees
' @returns leftNeg - the left wheel's offset_fwd after the write, degrees
' @returns rightNeg - the right wheel's offset_fwd after the write, degrees
'
' @local leftPos - the left wheel's offset_rev after the write
' @local rightPos - the right wheel's offset_rev after the write

    beat(CP_LIB_OFFSETS)
    fltOffNeg[SLOT_LEFT], fltOffPos[SLOT_LEFT] := steering.testLeftGetFwdRevIndep()
    fltOffNeg[SLOT_RIGHT], fltOffPos[SLOT_RIGHT] := steering.testRightGetFwdRevIndep()
    steering.testLeftSetFwdRevIndep(fltOffNeg[SLOT_LEFT] + leftShiftDeg, fltOffPos[SLOT_LEFT] + leftShiftDeg)
    steering.testRightSetFwdRevIndep(fltOffNeg[SLOT_RIGHT] + rightShiftDeg, fltOffPos[SLOT_RIGHT] + rightShiftDeg)
    leftNeg, leftPos := steering.testLeftGetFwdRevIndep()
    rightNeg, rightPos := steering.testRightGetFwdRevIndep()
    beat(CP_LIB_OFFSETS)
    bCpOffWritten := TRUE

PRI steerOffsetRestore() | leftNeg, leftPos, rightNeg, rightPos
' I11: put both wheels' commutation offsets back and read them back, folding the result into
' R14-DUAL-OFFREST-C's accumulators so a restore that did not take is visible rather than assumed.
'
' @local leftNeg - the left wheel's offset_fwd read back
' @local leftPos - the left wheel's offset_rev read back
' @local rightNeg - the right wheel's offset_fwd read back
' @local rightPos - the right wheel's offset_rev read back

    if bCpOffWritten
        beat(CP_LIB_OFFSETS)
        steering.testLeftSetFwdRevIndep(fltOffNeg[SLOT_LEFT], fltOffPos[SLOT_LEFT])
        steering.testRightSetFwdRevIndep(fltOffNeg[SLOT_RIGHT], fltOffPos[SLOT_RIGHT])
        leftNeg, leftPos := steering.testLeftGetFwdRevIndep()
        rightNeg, rightPos := steering.testRightGetFwdRevIndep()
        beat(CP_LIB_OFFSETS)
        bCpOffRestored := TRUE
        bSfOffRan[SLOT_LEFT] := TRUE
        bSfOffRan[SLOT_RIGHT] := TRUE
        bSfOffOk[SLOT_LEFT] := bSfOffOk[SLOT_LEFT] and (leftNeg == fltOffNeg[SLOT_LEFT]) and (leftPos == fltOffPos[SLOT_LEFT])
        bSfOffOk[SLOT_RIGHT] := bSfOffOk[SLOT_RIGHT] and (rightNeg == fltOffNeg[SLOT_RIGHT]) and (rightPos == fltOffPos[SLOT_RIGHT])
        emitOffRest(SIDE_LEFT, fltOffNeg[SLOT_LEFT], fltOffPos[SLOT_LEFT], leftNeg, leftPos, (leftNeg == fltOffNeg[SLOT_LEFT]) and (leftPos == fltOffPos[SLOT_LEFT]))
        emitOffRest(SIDE_RIGHT, fltOffNeg[SLOT_RIGHT], fltOffPos[SLOT_RIGHT], rightNeg, rightPos, (rightNeg == fltOffNeg[SLOT_RIGHT]) and (rightPos == fltOffPos[SLOT_RIGHT]))

PRI fltApiRetry() | startMs, safeEvent, bReached
' PL-66: THE SAME POWER, COMMANDED AGAIN after the fault, runs the motor again.
'
' The unfixed library left a faulted driver faulted unless the new command DIFFERED from the standing one,
' because the driver's own compare tests "still standing", not "just arrived" -- so a user who retried at
' the power they were already using stayed stopped with no way to tell why. The front cog now makes that
' edge itself (frontClearFault()), so this retry is the certification: same power, same call, and the
' platform reaches speed.
'
' Runs only when the provocation actually faulted; otherwise there is nothing to retry from and the cell
' stays NOMEAS.
'
' @local startMs - getms() at the retry command
' @local safeEvent - SAFE_* from the watched wait
' @local bReached - both wheels reached AT_SPEED

    fltRetryErr := NO_ERROR
    fltRetryMs := 0
    bFltRetryOk := FALSE
    if bSfFltApiRan and bSteerUp
        bSfRetryRan := TRUE
        startMs := getms()
        fltRetryErr := dDrive(SIDE_BOTH, FLTAPI_POWER)      ' the same power the provocation was driven at
        if fltRetryErr == NO_ERROR
            safeEvent, bReached := waitWatched(SIDE_BOTH, D_AT_SPEED_MS, CP_LOOP_ATSPEED, UNTIL_AT_SPEED)
            if (safeEvent == SAFE_NONE) and bReached
                fltRetryMs := getms() - startMs
                bFltRetryOk := TRUE
        bSfRetryOk := bFltRetryOk
        steerStopMotors()
        waitWatched(SIDE_BOTH, STOP_TIMEOUT_MS, CP_LOOP_STOPPED, UNTIL_STOPPED)

PRI fltApiVerdict() : whyCode | rowIdx, faultIdx, lastIdx, bStatFaulted, bSigHeld
' Read the trial's verdict out of the rows the poll already stored, so BM-FLTAPI, the BM-OUT rows and
' the sign-off cell all have ONE source. The cell is MEASURED once the provocation faulted; it is TRUE
' when the rows carry all three of task 3547's claims: steering.isFaulted() read TRUE, getStatus()
' reported DS_FAULTED, and the last row -- at least FLTAPI_LATCH_MS after the first faulted row -- still
' carried the sticky fault signal. A trial that never faulted is WHY_NO_FAULT and the cell stays NOT
' MEASURED, which prints NOMEAS: the visibility that caught Visit 2's missing cells.
'
' GETSTATUS IS LOOKED FOR FROM THE FAULTED ROW ONWARD, NOT ON THAT ROW ALONE. outPoll() reads
' getStatus() at the top of its bracket and isFaulted() at the bottom, so the status can legitimately
' be one row behind the flag; judging the one row would fail a driver that is behaving.
'
' @returns whyCode - WHY_NONE when a fault was seen in the rows, else WHY_NO_FAULT
'
' @local rowIdx - 0-based poll row
' @local faultIdx - first row reading faulted, -1 when none
' @local lastIdx - last row stored
' @local bStatFaulted - getStatus() read DS_FAULTED on that row or a later one
' @local bSigHeld - the sticky fault signal was still set on the last row

    whyCode := WHY_NO_FAULT
    faultIdx := -1
    bStatFaulted := FALSE
    if outCount > 0
        repeat rowIdx from 0 to outCount - 1
            beat(CP_LOOP_DRAIN)
            if outBuf[(rowIdx * OUT_LONGS) + OUT_FAULTED] <> FALSE
                faultIdx := rowIdx
                quit
    if faultIdx >= 0
        lastIdx := outCount - 1
        repeat rowIdx from faultIdx to lastIdx
            beat(CP_LOOP_DRAIN)
            if (outBuf[(rowIdx * OUT_LONGS) + OUT_L_STAT] == wheelL.DS_FAULTED) or (outBuf[(rowIdx * OUT_LONGS) + OUT_R_STAT] == wheelL.DS_FAULTED)
                bStatFaulted := TRUE
                quit
        fltFaultMs := outBuf[(faultIdx * OUT_LONGS) + OUT_T_MS]
        fltLatchMs := outBuf[(lastIdx * OUT_LONGS) + OUT_T_MS] - fltFaultMs
        bSigHeld := (outBuf[(lastIdx * OUT_LONGS) + OUT_L_SIG] <> FALSE) or (outBuf[(lastIdx * OUT_LONGS) + OUT_R_SIG] <> FALSE)
        bSfFltApiRan := TRUE
        bSfFltApiOk := bStatFaulted and bSigHeld and (fltLatchMs >= FLTAPI_LATCH_MS)
        whyCode := WHY_NONE

CON { --- part D steps: one claim each, measured once, printed as BM-DSTEP (task 3560) --- }

' EVERY STEP HAS THE SAME SHAPE. It provokes the condition, reads one number, judges it against a stated
' bound, and hands dStepDone() a measured/criterion pair. A condition this rig cannot provoke is NOMEAS
' with a why, never a pass by silence (doctrine overlay P1).
'
' SIDE selects the form under test and nothing else: SIDE_BOTH is the steering object (one front cog,
' two drivers) and SIDE_LEFT is one wheel (its own front cog). The dispatch helpers below are the only
' place the two differ, so each step is written once.
'
' NO DISPATCH HELPER MAY SELECT BETWEEN TWO METHOD CALLS WITH `? :` (PL-29, PL-76). PL-29 MEASURED a
' `? :` whose two branches each call a method running BOTH calls for one evaluation, and Visit 4 measured
' it again here: with side SIDE_LEFT, `(side == SIDE_RIGHT) ? wheelR.driveAtPower(p) : wheelL.driveAtPower(p)`
' also commanded the never-started wheelR, which printed "driveAtPowerEx() motor not started" while the
' expression returned wheelL's NO_ERROR. Five such lines in debug_260917-125859.log (L87, L88, L91, L93,
' L94) match, one for one, the five commanding ternaries the single-wheel half reached -- and the
' steering half, which takes the `if` limb and evaluates no ternary, printed none.
' The construction that makes it impossible is if/else, so every helper below uses if/else for a call
' and keeps `? :` for selecting a VALUE. A getter behaves the same way; it merely says nothing about it.

PRI dStepDone(stepCode, side, bMeasured, bCriterionMet, measuredVal, loLimit, hiLimit, whyCode)
' Record one part-D step: fill the BM-DSTEP staging, fold the cell, emit.
'
' @param stepCode - DST_* value
' @param side - SIDE_BOTH (the steering object) or SIDE_LEFT (the single wheel)
' @param bMeasured - TRUE when the step's condition arose and its number is a measurement
' @param bCriterionMet - TRUE when the step's own criterion held
' @param measuredVal - the step's number, meaning per step
' @param loLimit - lowest passing value
' @param hiLimit - highest passing value
' @param whyCode - WHY_* naming what was missing, WHY_NONE when nothing was

    dsStep := stepCode
    dsMeasured := measuredVal
    dsLo := loLimit
    dsHi := hiLimit
    dsWhy := whyCode
    if bMeasured == FALSE
        dsResult := DRES_NOMEAS
    elseif bCriterionMet <> FALSE
        dsResult := DRES_PASS
    else
        dsResult := DRES_FAIL
    if side == SIDE_LEFT
        bSfWDStepRan[stepCode] := (bMeasured <> FALSE)
        bSfWDStepOk[stepCode] := (bMeasured <> FALSE) and (bCriterionMet <> FALSE)
    else
        bSfDStepRan[stepCode] := (bMeasured <> FALSE)
        bSfDStepOk[stepCode] := (bMeasured <> FALSE) and (bCriterionMet <> FALSE)
    emitDStep(side)
    segItems := (segItems + 1) <# LIM_SMALL

PRI dStepSkip(stepCode, side, whyCode)
' Record a part-D step that could not run at all, so every declared cell still prints a row.
'
' @param stepCode - DST_* value
' @param side - SIDE_BOTH or SIDE_LEFT
' @param whyCode - WHY_* naming why nothing ran

    dStepDone(stepCode, side, FALSE, FALSE, 0, 0, 0, whyCode)

PRI bDArm(side) : bArmed
' Arm the instrument on the source this form reads, at the operator-segment decimation.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns bArmed - TRUE when the instrument acknowledged

    bArmed := bInstArm((side == SIDE_BOTH) ? INST_SRC_STEER : INST_SRC_WHEELS, FLOOR_DECIM)

PRI dDrive(side, powerValue) : eError
' Drive this form at a power through the PUBLIC method a user would call, and return what it returned.
'
' THE SYNC_PRECOND GUARD IS DELIBERATELY NOT USED HERE. That guard (design sec 4.3) exists because the
' pre-6.0.0 steering driveAtPower() ended in an unbounded SyncStatus() wait that never returned while a
' driver sat in DCS_ESTOP. Task 3513 moved the ATN and the wait into the front cog, and a caller now waits
' only the bounded request round trip (REQ_ACK_TIMEOUT_MS), so the call returns a refusal instead of
' hanging -- and THAT REFUSAL IS WHAT DST_ESTOP_REFUSE MEASURES. Calling through the guard would refuse
' on this cog and measure the harness instead of the driver.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @param powerValue - power [-100..100] for every wheel of this form
' @returns eError - NO_ERROR or the ERR_* code the library returned

    curIncre := 0
    if side == SIDE_BOTH
        beat(CP_LIB_STEER_DRIVE)
        eError := steering.driveAtPower(powerValue, powerValue)
        beat(CP_LIB_STEER_DRIVE)
    elseif side == SIDE_RIGHT
        beat(CP_LIB_COMMAND)
        eError := wheelR.driveAtPower(powerValue)
        beat(CP_LIB_COMMAND)
    else
        beat(CP_LIB_COMMAND)
        eError := wheelL.driveAtPower(powerValue)
        beat(CP_LIB_COMMAND)

PRI dEstop(side)
' Emergency-stop this form.
'
' @param side - SIDE_BOTH or SIDE_LEFT

    curIncre := 0
    if side == SIDE_BOTH
        beat(CP_LIB_ESTOP)
        steering.emergencyCutoff()
        beat(CP_LIB_ESTOP)
    else
        wheelEstop(side)

PRI dClearEstop(side) : eError
' Release this form's emergency stop.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns eError - NO_ERROR, or the code the library returned

    beat(CP_LIB_ESTOP)
    if side == SIDE_BOTH
        eError := steering.clearEmergency()
    elseif side == SIDE_RIGHT
        eError := wheelR.clearEmergency()
    else
        eError := wheelL.clearEmergency()
    beat(CP_LIB_ESTOP)

PRI dStopMotion(side)
' Stop this form's motion without stopping any cog.
'
' @param side - SIDE_BOTH or SIDE_LEFT

    if side == SIDE_BOTH
        steerStopMotors()
    else
        wheelStopMotor(side)

PRI dStopAfterTime(side, timeMs) : eError
' Arm this form's time stop in milliseconds.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @param timeMs - the limit, in ms
' @returns eError - NO_ERROR, or the code the library returned

    beat(CP_LIB_COMMAND)
    if side == SIDE_BOTH
        eError := steering.stopAfterTime(timeMs, steering.DTU_MILLISEC)
    elseif side == SIDE_RIGHT
        eError := wheelR.stopAfterTime(timeMs, wheelL.DTU_MILLISEC)
    else
        eError := wheelL.stopAfterTime(timeMs, wheelL.DTU_MILLISEC)
    beat(CP_LIB_COMMAND)

PRI isDEstopped(side) : bEstopped | eLeftStatus, eRightStatus
' Report whether every wheel of this form reads emergency-stopped through the PUBLIC status API.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns bEstopped - TRUE when getStatus() reads DS_ESTOP for every wheel and isEmergency() is TRUE
'
' @local eLeftStatus - left getStatus()
' @local eRightStatus - right getStatus()

    beat(CP_LIB_STEER_QUERY)
    if side == SIDE_BOTH
        eLeftStatus, eRightStatus := steering.getStatus()
        bEstopped := (eLeftStatus == wheelL.DS_ESTOP) and (eRightStatus == wheelL.DS_ESTOP) and (steering.isEmergency() <> FALSE)
    elseif side == SIDE_RIGHT
        eLeftStatus := wheelR.getStatus()
        bEstopped := (eLeftStatus == wheelL.DS_ESTOP) and (wheelR.isEmergency() <> FALSE)
    else
        eLeftStatus := wheelL.getStatus()
        bEstopped := (eLeftStatus == wheelL.DS_ESTOP) and (wheelL.isEmergency() <> FALSE)
    beat(CP_LIB_STEER_QUERY)

PRI dPowerSum(side) : nSum | leftPower, rightPower
' Sum of |power| this form reports through getPower(); 0 means every wheel reads stopped (PL-52).
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns nSum - |left power| + |right power|, or |power| for one wheel
'
' @local leftPower - left getPower()
' @local rightPower - right getPower()

    beat(CP_LIB_STEER_QUERY)
    if side == SIDE_BOTH
        leftPower, rightPower := steering.getPower()
        nSum := abs(leftPower) + abs(rightPower)
    elseif side == SIDE_RIGHT
        nSum := abs(wheelR.getPower())
    else
        nSum := abs(wheelL.getPower())
    beat(CP_LIB_STEER_QUERY)

PRI dRawTicks(side) : leftTicks, rightTicks
' Raw driver-maintained tick counts of this form (the reading no tracking reset moves).
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns leftTicks - the left wheel's raw ticks, or this wheel's
' @returns rightTicks - the right wheel's raw ticks, or the same value again for one wheel

    beat(CP_LIB_STEER_QUERY)
    if side == SIDE_BOTH
        leftTicks, rightTicks := steering.testGetRawHallTicks()
    else
        if side == SIDE_RIGHT
            leftTicks := wheelR.getRawHallTicks()
        else
            leftTicks := wheelL.getRawHallTicks()
        rightTicks := leftTicks
    beat(CP_LIB_STEER_QUERY)

PRI dTrackTicks(side) : leftTicks, rightTicks
' Tracked (resettable) tick counts of this form.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns leftTicks - the left wheel's tracked ticks, or this wheel's
' @returns rightTicks - the right wheel's tracked ticks, or the same value again for one wheel

    beat(CP_LIB_STEER_QUERY)
    if side == SIDE_BOTH
        leftTicks, rightTicks := steering.getRotationCount(steering.DRU_HALL_TICKS)
    else
        if side == SIDE_RIGHT
            leftTicks := wheelR.getRotationCount(wheelL.DRU_HALL_TICKS)
        else
            leftTicks := wheelL.getRotationCount(wheelL.DRU_HALL_TICKS)
        rightTicks := leftTicks
    beat(CP_LIB_STEER_QUERY)

PRI dResetTracking(side) : eError
' Reset this form's position tracking.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns eError - NO_ERROR, or the code the library returned

    beat(CP_LIB_COMMAND)
    if side == SIDE_BOTH
        eError := steering.resetTracking()
    elseif side == SIDE_RIGHT
        eError := wheelR.resetTracking()
    else
        eError := wheelL.resetTracking()
    beat(CP_LIB_COMMAND)

PRI dFrontStats(side) : nPasses, nLate, nMaxTicks, nStackHi, nStackOf
' This form's front-cog loop health, and the stack allocation its high-water mark is measured against.
'
' PL-75: THE SIZE COMES FROM THE OBJECT THAT OWNS THE STACK, never from a constant kept here. The
' steering front cog services two wheels and is sized separately from a wheel's own front cog, so
' one number cannot describe both -- and a record that pairs a mark with the wrong size can report a
' saturated stack as a healthy one.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns nPasses - passes since the cog was launched
' @returns nLate - passes that overran their slot
' @returns nMaxTicks - longest pass body, in system ticks
' @returns nStackHi - stack longs ever used
' @returns nStackOf - the allocation that mark is against, from the same object

    beat(CP_LIB_STEER_QUERY)
    if side == SIDE_BOTH
        nPasses, nLate, nMaxTicks, nStackHi := steering.testGetFrontStats()
        nStackOf := steering.STEER_STACK_LONGS
    elseif side == SIDE_RIGHT
        nPasses, nLate, nMaxTicks, nStackHi := wheelR.testGetFrontStats()
        nStackOf := wheelR.STACK_SIZE_LONGS
    else
        nPasses, nLate, nMaxTicks, nStackHi := wheelL.testGetFrontStats()
        nStackOf := wheelL.STACK_SIZE_LONGS
    beat(CP_LIB_STEER_QUERY)

PRI dShutdown(side)
' Stop this form's cogs through the PUBLIC stop(), with the instrument returned to IDLE first (I10).
'
' @param side - SIDE_BOTH or SIDE_LEFT

    bInstIdle()
    if side == SIDE_BOTH
        beat(CP_LIB_STEER_STOP)
        benchLog.cogEventBegin()
        steering.stop()
        beat(CP_LIB_STEER_STOP)
        bSteerUp := FALSE
    else
        wheelStopRaw(side)

PRI bDToSpeed(side) : bAtSpeed
' Bring this form to D_POWER and hold it at speed, so a step acts on a moving platform.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns bAtSpeed - TRUE when every wheel reached DCS_AT_SPEED and the settle passed cleanly

    bAtSpeed := FALSE
    if dDrive(side, D_POWER) == NO_ERROR
        bAtSpeed := bDHoldSpeed(side)

PRI bDHoldSpeed(side) : bAtSpeed | safeEvent
' After a drive command, wait for every wheel of this form to reach DCS_AT_SPEED, then the D_SETTLE_MS settle.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns bAtSpeed - TRUE when every wheel reached DCS_AT_SPEED and the settle passed cleanly
'
' @local safeEvent - SAFE_* from the watched waits

    safeEvent, bAtSpeed := waitWatched(side, D_AT_SPEED_MS, CP_LOOP_ATSPEED, UNTIL_AT_SPEED)
    if (safeEvent == SAFE_NONE) and bAtSpeed
        safeEvent, _ := waitWatched(side, D_SETTLE_MS, CP_LOOP_SETTLE, UNTIL_TIME)
    if safeEvent <> SAFE_NONE
        bAtSpeed := FALSE

PRI bDRest(side) : bRest
' Wait, bounded by D_REST_MS, for this form to be at rest (pos and hwPos still, per waitRest()).
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns bRest - TRUE when rest was confirmed inside D_REST_MS

    bRest := bDRestWithin(side, D_REST_MS)

PRI bDRestWithin(side, boundMs) : bRest | safeEvent
' Wait, bounded by the caller's own number, for this form to be at rest.
'
' A STEP THAT HAS ARMED A DELAYED STOP MUST PASS ITS OWN BOUND. D_REST_MS bounds the time from a stop
' COMMAND to rest; a step that arms stopAfterTime() is waiting for the limit to arrive first, and giving
' it D_REST_MS means the wait expires at the moment the stop begins (PL-83).
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @param boundMs - the caller's bound, in ms
' @returns bRest - TRUE when rest was confirmed inside boundMs
'
' @local safeEvent - SAFE_* from the wait

    safeEvent, bRest := waitRest(side, boundMs, FALSE)

PRI dStepLockstep() | bArmed, safeEvent, bMoving, leftJ, rightJ, sampleIdx, gapSamples
' LOCKSTEP: both drivers leave DCS_STOPPED in the same instrument sample.
'
' A REGRESSION GUARD, AND IT IS STATED AS ONE: the steering object has always released its two parked
' drivers with one COGATN, and Visit 2 and Visit 3 showed no drift. What changed underneath is WHO
' writes the commands -- one front cog now writes both and sends the ATN (task 3513) -- so the guard is
' here to show that the new writer did not cost the lockstep, not because a defect is suspected.
'
' Measured at decimation 1 (2 ms per sample), the finest the instrument offers.
'
' @local bArmed - the instrument acknowledged the ARM
' @local safeEvent - SAFE_* from the watched waits
' @local bMoving - both wheels left rest inside the bound
' @local leftJ - logical index of the left wheel's first sample not DCS_STOPPED, -1 when none
' @local rightJ - the same for the right wheel
' @local sampleIdx - logical index
' @local gapSamples - |leftJ - rightJ|

    leftJ := -1
    rightJ := -1
    gapSamples := 0
    bMoving := FALSE
    bArmed := bInstArm(INST_SRC_STEER, 1)
    if bArmed
        instMark()
        if dDrive(SIDE_BOTH, D_POWER) == NO_ERROR
            safeEvent, bMoving := waitWatched(SIDE_BOTH, OVERSHT_MOVE_MS, CP_LOOP_CAPTURE, UNTIL_MOVING)
            if safeEvent <> SAFE_NONE
                bMoving := FALSE
        bInstFreeze(0)
        drainBegin()
        drainFindMark()
        if bMoving and bDrMarkFound and (drStored > 0)
            repeat sampleIdx from drMarkJ to drStored - 1
                beat(CP_LOOP_DRAIN)
                if (leftJ < 0) and bSmpUp(sampleIdx, SLOT_LEFT) and (smpState(sampleIdx, SLOT_LEFT) <> DCS_STOPPED)
                    leftJ := sampleIdx
                if (rightJ < 0) and bSmpUp(sampleIdx, SLOT_RIGHT) and (smpState(sampleIdx, SLOT_RIGHT) <> DCS_STOPPED)
                    rightJ := sampleIdx
                if (leftJ >= 0) and (rightJ >= 0)
                    quit
    if (leftJ >= 0) and (rightJ >= 0)
        gapSamples := abs(leftJ - rightJ)
        dStepDone(DST_LOCKSTEP, SIDE_BOTH, TRUE, gapSamples <= D_LOCKSTEP_SAMPLES, gapSamples, 0, D_LOCKSTEP_SAMPLES, WHY_NONE)
    else
        dStepDone(DST_LOCKSTEP, SIDE_BOTH, FALSE, FALSE, 0, 0, D_LOCKSTEP_SAMPLES, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
    dStopMotion(SIDE_BOTH)
    bDRest(SIDE_BOTH)
    bInstIdle()

PRI dStepTrackReset(side) | bArmed, bAtSpeed, startMs, elapsedMs, rawLeft1, rawRight1, trkLeft1, trkRight1, rawLeft2, rawRight2, trkLeft2, trkRight2, bAgrees, eError
' TRACKRESET: resetTracking() at speed returns inside D_TRACKRESET_MS, and the tracking it restarts
' agrees with the driver's own raw ticks from that moment on.
'
' THE UNFIXED VALUE: before task 3513 this call waited on the sense task and took 400 ms or more, during
' which the platform kept moving and the caller could not know from where the new count ran. The bound
' below is the front cog's own request round trip.
'
' @param side - SIDE_BOTH or SIDE_LEFT
'
' @local bArmed - the instrument acknowledged the ARM
' @local bAtSpeed - the platform reached speed
' @local startMs - getms() before the reset call
' @local elapsedMs - how long the reset call took
' @local rawLeft1 - raw ticks just after the reset
' @local rawRight1 - the same, right wheel
' @local trkLeft1 - tracked ticks just after the reset
' @local trkRight1 - the same, right wheel
' @local rawLeft2 - raw ticks after the agreement window
' @local rawRight2 - the same, right wheel
' @local trkLeft2 - tracked ticks after the agreement window
' @local trkRight2 - the same, right wheel
' @local bAgrees - both wheels' tracked travel matched their raw travel
' @local eError - the reset call's return

    elapsedMs := 0
    bAgrees := FALSE
    bArmed := bDArm(side)
    bAtSpeed := bArmed and bDToSpeed(side)
    if bAtSpeed
        startMs := getms()
        eError := dResetTracking(side)
        elapsedMs := getms() - startMs
        rawLeft1, rawRight1 := dRawTicks(side)
        trkLeft1, trkRight1 := dTrackTicks(side)
        waitBeat(D_SETTLE_MS, CP_LOOP_SETTLE)
        rawLeft2, rawRight2 := dRawTicks(side)
        trkLeft2, trkRight2 := dTrackTicks(side)
        bAgrees := (eError == NO_ERROR) and (abs((trkLeft2 - trkLeft1) - abs(rawLeft2 - rawLeft1)) <= D_TRACKRESET_TOL)
        bAgrees := bAgrees and (abs((trkRight2 - trkRight1) - abs(rawRight2 - rawRight1)) <= D_TRACKRESET_TOL)
        dStepDone(DST_TRACKRESET, side, TRUE, bAgrees and (elapsedMs <= D_TRACKRESET_MS), elapsedMs, 0, D_TRACKRESET_MS, WHY_NONE)
    else
        dStepDone(DST_TRACKRESET, side, FALSE, FALSE, 0, 0, D_TRACKRESET_MS, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
    dStopMotion(side)
    bDRest(side)
    bInstIdle()

PRI dStepEstopSet(side) | bArmed, bAtSpeed, startMs, refuseMs, eRefusal, rawLeft1, rawRight1, rawLeft2, rawRight2, bLatched, bMoved, eClear, bStill
' The three e-stop claims, from one provocation (they cannot be separated: each is a different instant of
' the same latch).
'
'  REFUSE - a drive issued while emergency-stopped returns ERR_EMERGENCY_STOPPED, and returns it QUICKLY.
'           The unfixed library hung the caller's cog here (an unbounded SyncStatus() wait), so the
'           measured number is the call's own latency.
'  LATCH  - D_ESTOP_HOLD_MS later the stop is still in force and nothing has moved. S-4 recorded the old
'           e-stop self-cancelling in about 125-250 ms, so this hold is the discriminator.
'  CLEAR  - clearEmergency() releases it, the platform stays where it is, and getPower() reads 0 (PL-52).
'
' @param side - SIDE_BOTH or SIDE_LEFT
'
' @local bArmed - the instrument acknowledged the ARM
' @local bAtSpeed - the platform reached speed
' @local startMs - getms() before a timed call
' @local refuseMs - how long the refused drive took to return
' @local eRefusal - what that drive returned
' @local rawLeft1 - raw ticks once the coast ended
' @local rawRight1 - the same, right wheel
' @local rawLeft2 - raw ticks after the hold
' @local rawRight2 - the same, right wheel
' @local bLatched - the stop was still in force after the hold
' @local bMoved - the platform moved during the hold, beyond D_POS_TOL_TICKS
' @local eClear - clearEmergency()'s return
' @local bStill - nothing moved after the clear

    refuseMs := 0
    bArmed := bDArm(side)
    bAtSpeed := bArmed and bDToSpeed(side)
    if bAtSpeed == FALSE
        dStepSkip(DST_ESTOP_REFUSE, side, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
        dStepSkip(DST_ESTOP_LATCH, side, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
        dStepSkip(DST_ESTOP_CLEAR, side, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
    else
        dEstop(side)
        ' 1. REFUSE, measured at once: the strongest moment, while the platform is still coasting down
        startMs := getms()
        eRefusal := dDrive(side, D_POWER)
        refuseMs := getms() - startMs
        dStepDone(DST_ESTOP_REFUSE, side, TRUE, (eRefusal == wheelL.ERR_EMERGENCY_STOPPED) and (refuseMs <= D_ESTOP_REFUSE_MS), refuseMs, 0, D_ESTOP_REFUSE_MS, WHY_NONE)
        ' 2. LATCH, after the coast has ended so a moving platform cannot be read as a released latch
        bDRest(side)
        rawLeft1, rawRight1 := dRawTicks(side)
        waitBeat(D_ESTOP_HOLD_MS, CP_LOOP_POLL)
        bLatched := isDEstopped(side)
        rawLeft2, rawRight2 := dRawTicks(side)
        bMoved := (abs(rawLeft2 - rawLeft1) > D_POS_TOL_TICKS) or (abs(rawRight2 - rawRight1) > D_POS_TOL_TICKS)
        dStepDone(DST_ESTOP_LATCH, side, TRUE, bLatched and (bMoved == FALSE), D_ESTOP_HOLD_MS, D_ESTOP_HOLD_MS, D_ESTOP_HOLD_MS, WHY_NONE)
        ' 3. CLEAR: released, still at rest, and no power left standing
        eClear := dClearEstop(side)
        rawLeft1, rawRight1 := dRawTicks(side)
        waitBeat(D_CLEAR_STILL_MS, CP_LOOP_POLL)
        rawLeft2, rawRight2 := dRawTicks(side)
        bStill := (abs(rawLeft2 - rawLeft1) <= D_POS_TOL_TICKS) and (abs(rawRight2 - rawRight1) <= D_POS_TOL_TICKS)
        dStepDone(DST_ESTOP_CLEAR, side, TRUE, (eClear == NO_ERROR) and bStill and (isDEstopped(side) == FALSE) and (dPowerSum(side) == 0), eClear, NO_ERROR, NO_ERROR, WHY_NONE)
    dStopMotion(side)
    bDRest(side)
    bInstIdle()

PRI dStepOrdered() | bArmed, bAtSpeed, eLeftState, eRightState, bSameState, bStopped, startMs
' ORDERED: a stop ordered from cog 0 while ANOTHER cog drives the platform repeatedly leaves both wheels
' in one state, not one stopped and one still driving.
'
' THE SECOND COG IS THE POINT. The property cannot arise from one cog's calls, so a helper cog drives at
' D_POWER every D_ORDERED_PERIOD_MS while cog 0 stops the platform; the helper's drives keep arriving
' during and after the stop. Both wheels' requests go through the same front cog, which applies stops
' before drives within a pass, so the platform ends in one state whichever order the calls interleave.
'
' A REGRESSION GUARD, STATED: nothing in Visit 1-3 showed the two wheels diverging. It rides this visit
' because the front cog is new code on the path every one of those calls now takes.
'
' @local bArmed - the instrument acknowledged the ARM
' @local bAtSpeed - the platform reached speed
' @local eLeftState - the left driver's state after everything settled
' @local eRightState - the right driver's state
' @local bSameState - both wheels ended in the same state
' @local bStopped - that state is DCS_STOPPED
' @local startMs - getms() when the wait for the helper to finish began

    bArmed := bDArm(SIDE_BOTH)
    bAtSpeed := bArmed and bDToSpeed(SIDE_BOTH)
    if bAtSpeed
        odDrives := 0
        odLastErr := NO_ERROR
        bOdDone := FALSE
        bOdRun := TRUE
        benchLog.cogEventBegin()
        odCogId := cogspin(NEWCOG, orderedHelper(), @odStack)
        benchLog.cogEventEnd()
        if odCogId < 0
            bOdRun := FALSE
            dStepDone(DST_ORDERED, SIDE_BOTH, FALSE, FALSE, 0, 0, 0, WHY_NO_COG)
        else
            waitBeat(D_ORDERED_PERIOD_MS * 4, CP_LOOP_POLL)  ' let the helper's drives be in flight
            dStopMotion(SIDE_BOTH)                           ' the ordered stop, from cog 0
            waitBeat(D_ORDERED_PERIOD_MS * 4, CP_LOOP_POLL)  ' more drives arrive after it
            bOdRun := FALSE
            ' bounded: a helper that never answers is stopped anyway, and the state check below still runs
            startMs := getms()
            repeat while (bOdDone == FALSE) and ((getms() - startMs) < STOP_TIMEOUT_MS)
                beat(CP_LOOP_POLL)
                waitms(D_STEP_POLL_MS)
            benchLog.cogEventBegin()
            cogstop(odCogId)
            odCogId := -1
            dStopMotion(SIDE_BOTH)                           ' the helper's last drive is superseded here
            bDRest(SIDE_BOTH)
            beat(CP_LIB_STEER_QUERY)
            eLeftState, eRightState := steering.testGetDriverState()
            beat(CP_LIB_STEER_QUERY)
            bSameState := (eLeftState == eRightState)
            bStopped := (eLeftState == DCS_STOPPED)
            dStepDone(DST_ORDERED, SIDE_BOTH, TRUE, bSameState and bStopped, odDrives, 1, LIM_SMALL, WHY_NONE)
    else
        dStepDone(DST_ORDERED, SIDE_BOTH, FALSE, FALSE, 0, 0, 0, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
    dStopMotion(SIDE_BOTH)
    bDRest(SIDE_BOTH)
    bInstIdle()

PRI orderedHelper()
' THE ORDERED-STOP HELPER COG: drive the platform at D_POWER until cog 0 lowers bOdRun, then say so.
'
' It commands and counts, nothing else: no record, no reading, no stop. Every drive goes through the
' public method, from a cog that is not cog 0, which is the whole point of the step.

    repeat while bOdRun
        odLastErr := steering.driveAtPower(D_POWER, D_POWER)
        odDrives := (odDrives + 1) <# LIM_SMALL
        waitms(D_ORDERED_PERIOD_MS)
    bOdDone := TRUE

PRI dStepTimeStop(side) | bArmed, bAtSpeed, deadlineMs, eError, restMs, lateMs, bRest
' TIMESTOP: stopAfterTime() leaves the platform AT REST BY its deadline, with no power left standing.
'
' THE UNFIXED VALUE: before task 3559 the stop began AT the limit rather than early enough to finish by
' it, so the platform was still ramping down when the deadline passed. The number below is signed: how
' far past its deadline rest actually arrived.
'
' PL-83 -- TWO REASONS THIS COULD NOT PASS, both fixed here, and neither was the driver. Visit 4 read
' NOMEAS why STOP_TIMEOUT in BOTH forms, the steering object's and the single wheel's.
'  1. THE WAIT WAS THE SAME LENGTH AS THE LIMIT IT WAS WAITING PAST. It called bDRest(), bounded by
'     D_REST_MS, for a stop that is only DUE D_TIMESTOP_MS after the call -- and the two numbers are both
'     2_000 ms, so the wait expired exactly as the stop began. It now waits D_TIMESTOP_MS + D_REST_MS:
'     the limit, then the same bound every other step gives a stop.
'  2. THE CRITERION IGNORED ITS OWN CONFIRMATION DWELL. waitRest() returns when pos and hwPos have been
'     unchanged for REST_CONFIRM_MS, so restMs is at least that far past the instant the platform
'     actually stopped -- against a criterion of lateMs <= D_TIMESTOP_SLACK_MS (20 ms). No stop of any
'     quality could meet it. The bound is now the slack PLUS the dwell, and it is computed from the two
'     constants rather than written as a number (doctrine D2: a criterion a correct system cannot meet
'     has not failed, it has misreported).
'
' @param side - SIDE_BOTH or SIDE_LEFT
'
' @local bArmed - the instrument acknowledged the ARM
' @local bAtSpeed - the platform reached speed
' @local deadlineMs - getms() the limit is due at
' @local eError - stopAfterTime()'s return
' @local restMs - getms() when rest was confirmed
' @local lateMs - restMs - deadlineMs, signed
' @local bRest - rest was confirmed inside the bound

    lateMs := 0
    bArmed := bDArm(side)
    bAtSpeed := bArmed and bDToSpeed(side)
    if bAtSpeed
        eError := dStopAfterTime(side, D_TIMESTOP_MS)
        deadlineMs := getms() + D_TIMESTOP_MS
        bRest := bDRestWithin(side, D_TIMESTOP_MS + D_REST_MS)
        restMs := getms()
        lateMs := restMs - deadlineMs
        dStepDone(DST_TIMESTOP, side, bRest, (eError == NO_ERROR) and (lateMs <= D_TIMESTOP_LATE_HI) and (dPowerSum(side) == 0), lateMs, 0 - D_TIMESTOP_MS, D_TIMESTOP_LATE_HI, bRest ? WHY_NONE : WHY_STOP_TIMEOUT)
    else
        dStepDone(DST_TIMESTOP, side, FALSE, FALSE, 0, 0, D_TIMESTOP_LATE_HI, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
    dStopMotion(side)
    bDRest(side)
    bInstIdle()

PRI dStepCmdTimeout(side) | bArmed, bAtSpeed, startMs, lastDriveMs, bHeld, eError, bRest, stopMs, bOk
' CMDTIMEOUT (task 3570, S-8): with setCommandTimeout() on, a drive that keeps being refreshed keeps running,
' and one left unrefreshed stops by itself, is at rest inside its bound, and is reported by getError().
'
' BOTH LIMBS ARE THE CELL. The refreshed limb is the negative case: a timeout that fired on a live link would
' stop the platform there and fail it. The silent limb is the positive case: the unfixed library has no
' timeout, so the platform drives on through the rest bound and fails it. Rest is judged no EARLIER than the
' timeout itself, so a stop that came from something else cannot pass as the timeout's.
'
' @param side - SIDE_BOTH or SIDE_LEFT
'
' @local bArmed - the instrument acknowledged the ARM
' @local bAtSpeed - the platform reached speed
' @local startMs - getms() when the refreshed limb began
' @local lastDriveMs - getms() of the last drive command, the silent limb's origin
' @local bHeld - the refreshed limb kept driving (power still standing, every refresh accepted)
' @local eError - a refresh's return, then getError()'s report after the stop
' @local bRest - rest was confirmed inside the silent limb's bound
' @local stopMs - ms from the last drive command to confirmed rest, the step's printed number
' @local bOk - every claim of the step held

    stopMs := 0
    bOk := FALSE
    bArmed := bDArm(side)
    bAtSpeed := bArmed and bDToSpeed(side)
    if bAtSpeed
        dCollectError(side)                                     ' drain: the report judged below must be this step's
        bHeld := (dSetTimeout(side, D_CMDTMO_MS) == NO_ERROR)
        ' 1. REFRESHED: the same drive every D_CMDTMO_EVERY_MS for D_CMDTMO_REFRESH_MS -- must keep running
        startMs := getms()
        repeat while bHeld and ((getms() - startMs) < D_CMDTMO_REFRESH_MS)
            waitBeat(D_CMDTMO_EVERY_MS, CP_LOOP_POLL)
            eError := dDrive(side, D_POWER)
            lastDriveMs := getms()
            bHeld := (eError == NO_ERROR) and (dPowerSum(side) <> 0)
        ' 2. SILENT: no command at all -- must stop, no sooner than the timeout and inside the rest bound
        if bHeld
            bRest := bDRestWithin(side, D_CMDTMO_MS + D_REST_MS)
            stopMs := getms() - lastDriveMs
            eError := dCollectError(side)
            bOk := bRest and (stopMs >= D_CMDTMO_MS) and (eError == wheelL.ERR_COMMAND_TIMEOUT) and (dPowerSum(side) == 0)
        dSetTimeout(side, wheelL.CMD_TIMEOUT_OFF)               ' I11: off again before anything else drives
        dStepDone(DST_CMDTIMEOUT, side, TRUE, bHeld and bOk, stopMs, D_CMDTMO_MS, D_CMDTMO_MS + D_REST_MS, WHY_NONE)
    else
        dStepDone(DST_CMDTIMEOUT, side, FALSE, FALSE, 0, D_CMDTMO_MS, D_CMDTMO_MS + D_REST_MS, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
    dStopMotion(side)
    bDRest(side)
    bInstIdle()

PRI dStepDirSign() | bArmed, bRanRight, rightTurnLead, bRanLeft, leftTurnLead, worstLead
' DIRSIGN (task 3577, finding AC): driveDirection() turns toward the sign of its direction by slowing the wheel
' on that side. Wheels lifted, the turn is read as which wheel covers fewer tracked ticks over a window at
' speed: a positive direction must leave the LEFT wheel ahead by D_DIRSIGN_GAP_TICKS, a negative one the RIGHT.
'
' BOTH LIMBS ARE THE CELL, and each is the other's negative case: the unfixed library had the sign inverted,
' so it fails both, and a harness that could not tell the wheels apart could not pass both. The platform
' comes to rest between the limbs so the second starts from rest, not from the first's speed. The steering
' object only: one wheel has no direction.
'
' @local bArmed - the instrument acknowledged the ARM
' @local bRanRight - the right-turn limb reached speed and counted its window
' @local rightTurnLead - the LEFT wheel's lead in the right turn, ticks over the window (expected positive)
' @local bRanLeft - the left-turn limb reached speed and counted its window
' @local leftTurnLead - the RIGHT wheel's lead in the left turn, ticks over the window (expected positive)
' @local worstLead - the smaller of the two leads, the step's printed number

    worstLead := 0
    bRanRight := FALSE
    bRanLeft := FALSE
    bArmed := bDArm(SIDE_BOTH)
    if bArmed
        bRanRight, rightTurnLead := dDirectionLead(D_DIRECTION)
    if bRanRight
        dStopMotion(SIDE_BOTH)                              ' the second limb starts from rest
        bDRest(SIDE_BOTH)
        bRanLeft, leftTurnLead := dDirectionLead(0 - D_DIRECTION)
        leftTurnLead := 0 - leftTurnLead                    ' left-minus-right, negated: the right wheel's lead
        worstLead := rightTurnLead <# leftTurnLead
    if bRanRight and bRanLeft
        dStepDone(DST_DIRSIGN, SIDE_BOTH, TRUE, worstLead >= D_DIRSIGN_GAP_TICKS, worstLead, D_DIRSIGN_GAP_TICKS, LIM_MID, WHY_NONE)
    else
        dStepDone(DST_DIRSIGN, SIDE_BOTH, FALSE, FALSE, 0, D_DIRSIGN_GAP_TICKS, LIM_MID, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
    dStopMotion(SIDE_BOTH)
    bDRest(SIDE_BOTH)
    bInstIdle()

PRI dDirectionLead(direction) : bRan, leftLead | eError, safeEvent, leftStart, rightStart, leftEnd, rightEnd
' Drive the steering object at driveDirection(D_POWER, direction), wait for both wheels at speed and the
' settle, then count each wheel's tracked ticks over D_DIRSIGN_WINDOW_MS. Legal only while armed.
'
' @param direction - driveDirection()'s direction, [-100..100]
' @returns bRan - TRUE when the drive was accepted, both wheels reached speed and the window was counted
' @returns leftLead - left tracked ticks minus right over the window: positive when the RIGHT wheel is slower
'
' @local eError - driveDirection()'s return
' @local safeEvent - SAFE_* from the counting window's wait
' @local leftStart - left tracked ticks at the window's start
' @local rightStart - right tracked ticks at the window's start
' @local leftEnd - left tracked ticks at the window's end
' @local rightEnd - right tracked ticks at the window's end

    bRan := FALSE
    leftLead := 0
    curIncre := 0
    beat(CP_LIB_STEER_DRIVE)
    eError := steering.driveDirection(D_POWER, direction)
    beat(CP_LIB_STEER_DRIVE)
    if (eError == NO_ERROR) and bDHoldSpeed(SIDE_BOTH)
        leftStart, rightStart := dTrackTicks(SIDE_BOTH)
        safeEvent, _ := waitWatched(SIDE_BOTH, D_DIRSIGN_WINDOW_MS, CP_LOOP_POLL, UNTIL_TIME)
        leftEnd, rightEnd := dTrackTicks(SIDE_BOTH)
        bRan := (safeEvent == SAFE_NONE)
        leftLead := (leftEnd - leftStart) - (rightEnd - rightStart)

PRI dSetTimeout(side, timeoutMs) : eError
' Set this form's command timeout (S-8).
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @param timeoutMs - the timeout in ms, or CMD_TIMEOUT_OFF
' @returns eError - NO_ERROR, or the code the library returned

    beat(CP_LIB_COMMAND)
    if side == SIDE_BOTH
        eError := steering.setCommandTimeout(timeoutMs)
    elseif side == SIDE_RIGHT
        eError := wheelR.setCommandTimeout(timeoutMs)
    else
        eError := wheelL.setCommandTimeout(timeoutMs)
    beat(CP_LIB_COMMAND)

PRI dCollectError(side) : eError
' Read and clear this cog's first recorded error for this form: the steering object's own (its first result)
' or the wheel's.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns eError - the code getError() reported, NO_ERROR when none

    beat(CP_LIB_STEER_QUERY)
    if side == SIDE_BOTH
        eError, _, _ := steering.getError()
    elseif side == SIDE_RIGHT
        eError := wheelR.getError()
    else
        eError := wheelL.getError()
    beat(CP_LIB_STEER_QUERY)

PRI dStepFrontStats(side) | nPasses, nLate, nMaxTicks, nStackHi, nStackOf, slotIdx, bHealthy
' FRONTST: the front cog kept its 1 kHz slot, never overran its stack, and never fell behind.
'
' Read with the object still running and the platform at rest, so the numbers cover every step this part
' has just put the cog through. A late pass is counted and never replayed, so ZERO late passes is the
' criterion, not a small number of them.
'
' PL-75: THE STACK CRITERION IS AGAINST THE OWNING OBJECT'S OWN SIZE, not a constant kept in this
' file. It used to judge every cog against D_FRONT_STACK_HI, which no object ever sees; the two
' front cogs are sized differently (the steering's services two wheels), so one number judged both
' wrongly the moment they diverged.
' The comparison stays STRICTLY LESS on purpose: a mark EQUAL to the size is SATURATED -- every
' sentinel long is gone, so "used all of it" and "used more than all of it" are indistinguishable,
' and that must not read as healthy (doctrine D2: a discovery failure must never render as a value).
'
' @param side - SIDE_BOTH (the steering front cog) or SIDE_LEFT (the wheel's own)
'
' @local nPasses - passes since launch
' @local nLate - passes that overran their slot
' @local nMaxTicks - longest pass body, in system ticks
' @local nStackHi - stack longs ever used
' @local nStackOf - the allocation that mark is against, from the owning object
' @local slotIdx - accumulator slot: 0 the steering cog, 1 the wheel's
' @local bHealthy - every criterion held

    nPasses, nLate, nMaxTicks, nStackHi, nStackOf := dFrontStats(side)
    slotIdx := (side == SIDE_BOTH) ? SLOT_LEFT : SLOT_RIGHT
    bHealthy := (nPasses > 0) and (nLate <= D_FRONT_LATE_HI) and (nMaxTicks < D_FRONT_PASS_TICKS_HI) and (nStackHi < nStackOf)
    bSfFrontRan[slotIdx] := (nPasses > 0)
    bSfFrontOk[slotIdx] := bHealthy
    emitFrontSt(side, nPasses, nLate, nMaxTicks, nStackHi, nStackOf)

PRI dStepCoopShut(side) | startMs, elapsedMs
' COOPSHUT: stop() returns inside D_COOPSHUT_MS.
'
' The front cog is asked to EXIT, answers every open request and parks before it is cogstopped (PL-41),
' so the shutdown is cooperative rather than a cut line -- and it is BOUNDED, which is what this measures.
' The bound is the library's own request round trip; anything longer means the EXIT was not answered.
'
' @param side - SIDE_BOTH or SIDE_LEFT
'
' @local startMs - getms() before stop()
' @local elapsedMs - how long stop() took

    startMs := getms()
    dShutdown(side)
    elapsedMs := getms() - startMs
    dStepDone(DST_COOPSHUT, side, TRUE, elapsedMs < D_COOPSHUT_MS, elapsedMs, 0, D_COOPSHUT_MS - 1, WHY_NONE)

PRI dLimitState(slotIdx) : nPeakA, nContA, bDeratedNow, nPhaseMa, nLimitK
' One wheel's current-limit state, read through the steering object's pass-through.
'
' @param slotIdx - motor slot
' @returns nPeakA - the peak phase-current limit in force, amps
' @returns nContA - the continuous limit, amps
' @returns bDeratedNow - T/F where T means the fold-back holds the continuous limit
' @returns nPhaseMa - the front cog's ~1 s average of the phase-current lower bound, mA
' @returns nLimitK - the fold-back factor the driver reads

    beat(CP_LIB_STEER_QUERY)
    if slotIdx == SLOT_RIGHT
        nPeakA, nContA, bDeratedNow, nPhaseMa, nLimitK := steering.testRightGetCurrentLimitState()
    else
        nPeakA, nContA, bDeratedNow, nPhaseMa, nLimitK := steering.testLeftGetCurrentLimitState()
    beat(CP_LIB_STEER_QUERY)

PRI dSetLimits(peakAmps, contAmps) : eError
' Replace both wheels' current limits (TEST-USE; the step that sets them restores them).
'
' @param peakAmps - the peak limit, amps
' @param contAmps - the continuous limit, amps
' @returns eError - NO_ERROR, or the code the library returned

    beat(CP_LIB_COMMAND)
    eError := steering.testSetCurrentLimits(peakAmps, contAmps)
    beat(CP_LIB_COMMAND)

PRI dStepFoldBack() | bArmed, eError, slotIdx, startMs, peakMa[INST_MOTORS], startPos[INST_MOTORS], bFaulted, bTurned, bOk, worstMa
' FOLDBACK: with the peak limit lowered to one a lifted wheel can reach, the driver holds the phase
' current at that limit and KEEPS TURNING instead of faulting.
'
' The peak and continuous limits are set to the same value, so only the driver's own fold-back acts --
' the front cog's derate has nothing left to lower. The judged quantity is the front cog's own phase
' estimate (testGetCurrentLimitState()'s average), the same number the derate decision reads, so the
' cell and the driver judge one source.
'
' @local bArmed - the instrument acknowledged the ARM
' @local eError - the limit write's return
' @local slotIdx - motor slot
' @local startMs - getms() at the start of the hold
' @local peakMa - largest phase average seen, per motor
' @local startPos - each wheel's raw ticks at the start of the hold
' @local bFaulted - either wheel's fault flag was seen during the hold
' @local bTurned - both wheels moved during the hold
' @local bOk - both wheels met the criterion
' @local worstMa - the larger of the two peak averages, the step's printed number

    bFaulted := FALSE
    worstMa := 0
    bArmed := bDArm(SIDE_BOTH)
    eError := dSetLimits(D_FOLD_PEAK_A, D_FOLD_CONT_A)
    if bArmed and (eError == NO_ERROR) and (dDrive(SIDE_BOTH, D_POWER) == NO_ERROR)
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            peakMa[slotIdx] := 0
        startPos[SLOT_LEFT], startPos[SLOT_RIGHT] := dRawTicks(SIDE_BOTH)
        startMs := getms()
        repeat
            beat(CP_LOOP_POLL)
            repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                peakMa[slotIdx] #>= dLimitPhaseMa(slotIdx)
                if instLastFault[slotIdx] <> FALSE
                    bFaulted := TRUE
            waitms(D_LIMIT_POLL_MS)
            if (getms() - startMs) >= D_FOLD_HOLD_MS
                quit
        bTurned := bDBothMoved(startPos[SLOT_LEFT], startPos[SLOT_RIGHT])
        bOk := (bFaulted == FALSE) and bTurned
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            worstMa #>= peakMa[slotIdx]
            bSfLimRan[slotIdx] := TRUE
            bSfLimOk[slotIdx] := (peakMa[slotIdx] <= dFoldBoundMa()) and (bFaulted == FALSE) and bTurned
            bOk := bOk and (peakMa[slotIdx] <= dFoldBoundMa())
            emitLimSt(SIDE_LEFT + slotIdx, slotIdx, DST_FOLDBACK, peakMa[slotIdx])
        dStepDone(DST_FOLDBACK, SIDE_BOTH, TRUE, bOk, worstMa, 0, dFoldBoundMa(), WHY_NONE)
    else
        dStepDone(DST_FOLDBACK, SIDE_BOTH, FALSE, FALSE, 0, 0, dFoldBoundMa(), bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
    dStopMotion(SIDE_BOTH)
    bDRest(SIDE_BOTH)
    bInstIdle()

PRI dFoldBoundMa() : nBoundMa
' The phase-current average the FOLDBACK hold may reach: the lowered peak limit plus its stated tolerance.
'
' @returns nBoundMa - the bound, in mA

    nBoundMa := (D_FOLD_PEAK_A * 1_000 * D_FOLD_TOL_PCT) / 100

PRI dLimitPhaseMa(slotIdx) : nPhaseMa
' One wheel's judged phase-current average.
'
' @param slotIdx - motor slot
' @returns nPhaseMa - the front cog's ~1 s average, mA

    _, _, _, nPhaseMa, _ := dLimitState(slotIdx)

PRI bDLimitDerated(slotIdx) : bDeratedNow
' Whether one wheel's fold-back currently holds the continuous limit.
'
' @param slotIdx - motor slot
' @returns bDeratedNow - T/F where T means the limit is derated

    _, _, bDeratedNow, _, _ := dLimitState(slotIdx)

PRI bDBothMoved(startLeft, startRight) : bMoved | nowLeft, nowRight
' Report whether both wheels' raw tick counts have moved since a pair of readings.
'
' @param startLeft - the left wheel's raw ticks at the start
' @param startRight - the right wheel's raw ticks at the start
' @returns bMoved - TRUE when both counts changed
'
' @local nowLeft - the left wheel's raw ticks now
' @local nowRight - the right wheel's raw ticks now

    nowLeft, nowRight := dRawTicks(SIDE_BOTH)
    bMoved := (nowLeft <> startLeft) and (nowRight <> startRight)

PRI dStepDerate() | bArmed, eError, slotIdx, startMs, derateMs[INST_MOTORS], bRestored[INST_MOTORS], bAnyDerated, bOk, worstMs
' DERATE: the front cog lowers the driver's fold-back to the CONTINUOUS limit once its ~1 s average of
' the phase current crosses it, and returns the peak limit once the average falls away again.
'
' The peak limit is set well above the continuous one, so the two are distinguishable: a derate here is
' the front cog's decision, not the driver's fold-back.
'
' THE CLAIM IS "IT DERATED AND THE PEAK LIMIT CAME BACK", NOT "IT DERATED WITHIN N MILLISECONDS" (PL-80).
' The arrival time is recorded and judged only against D_DERATE_WAIT_MS, the bound on it arriving at all;
' a wheel that does not reach the limit inside that wait is NOMEAS with why NOT_DERATED, which is a
' RESULT about this rig rather than a failure of the driver (doctrine overlay P1: every run is
' wheels-lifted, and a lifted 6.5in wheel only just reaches the continuous limit).
'
' @local bArmed - the instrument acknowledged the ARM
' @local eError - the limit write's return
' @local slotIdx - motor slot
' @local startMs - getms() at the drive
' @local derateMs - ms from the drive to the derate, per motor; 0 when it never came
' @local bRestored - the peak limit came back after the stop, per motor
' @local bAnyDerated - at least one wheel derated, so the step was measurable
' @local bOk - both wheels derated inside the window and restored
' @local worstMs - the later of the two derate times, the step's printed number

    bAnyDerated := FALSE
    worstMs := 0
    bArmed := bDArm(SIDE_BOTH)
    eError := dSetLimits(D_DERATE_PEAK_A, D_DERATE_CONT_A)
    if bArmed and (eError == NO_ERROR) and (dDrive(SIDE_BOTH, D_POWER) == NO_ERROR)
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            derateMs[slotIdx] := 0
            bRestored[slotIdx] := FALSE
        startMs := getms()
        repeat
            beat(CP_LOOP_POLL)
            repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                if (derateMs[slotIdx] == 0) and (bDLimitDerated(slotIdx) <> FALSE)
                    derateMs[slotIdx] := (getms() - startMs) #> 1
                    bAnyDerated := TRUE
            waitms(D_LIMIT_POLL_MS)
            if ((derateMs[SLOT_LEFT] <> 0) and (derateMs[SLOT_RIGHT] <> 0)) or ((getms() - startMs) >= D_DERATE_WAIT_MS)
                quit
        dStopMotion(SIDE_BOTH)
        bDRest(SIDE_BOTH)
        startMs := getms()
        repeat                                              ' the peak limit returns once the average decays
            beat(CP_LOOP_POLL)
            repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                if bDLimitDerated(slotIdx) == FALSE
                    bRestored[slotIdx] := TRUE
            waitms(D_LIMIT_POLL_MS)
            if (bRestored[SLOT_LEFT] and bRestored[SLOT_RIGHT]) or ((getms() - startMs) >= D_DERATE_REST_MS)
                quit
        bOk := bAnyDerated
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            worstMs #>= derateMs[slotIdx]
            ' PL-80: a wheel that never derated is NOT MEASURED, so its own cell prints NOMEAS and it does
            '  not fail the step. A wheel that DID derate is judged on the claim the cell is named for --
            '  the peak limit came back once the average decayed.
            bSfDerateRan[slotIdx] := (derateMs[slotIdx] <> 0)
            bSfDerateOk[slotIdx] := bSfDerateRan[slotIdx] and bRestored[slotIdx]
            if bSfDerateRan[slotIdx]
                bOk := bOk and bSfDerateOk[slotIdx]
            emitLimSt(SIDE_LEFT + slotIdx, slotIdx, DST_DERATE, derateMs[slotIdx])
        dStepDone(DST_DERATE, SIDE_BOTH, bAnyDerated, bOk, worstMs, 1, D_DERATE_WAIT_MS, bAnyDerated ? WHY_NONE : WHY_NOT_DERATED)
    else
        dStepDone(DST_DERATE, SIDE_BOTH, FALSE, FALSE, 0, 1, D_DERATE_WAIT_MS, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
    dStopMotion(SIDE_BOTH)
    bDRest(SIDE_BOTH)
    bInstIdle()

PRI dStepBlocked() | bArmed, eError, startMs, blockMs, eLeftCode, eRightCode, eRefusal, eAfterEstopClear, eRelease, rawLeft1, rawRight1, bStill, bDroveAgain, bOk
' BLOCKED: a commanded motor that cannot move latches a PROTECTIVE STOP, refuses every drive with its own
' code, is NOT released by clearEmergency(), and is released by clearProtectiveStop().
'
' THE PROVOCATION IS THE CONSTRUCTION, not a jammed wheel: the current limits are set to 1 A, which the
' driver's fold-back cannot serve, so the rotor never follows the field and the front cog sees a motor
' commanded to move and standing still -- exactly the blocked-platform condition, reached with nothing
' touching the rig (doctrine overlay P1: every run is wheels-lifted). LAGBOUND is exempt for the whole
' step: the lag here is deliberate.
'
' NOMEAS, not FAIL, when the wheels keep turning at 1 A: that means the condition never arose on this rig,
' which is a fact about the rig, not about the driver.
'
' @local bArmed - the instrument acknowledged the ARM
' @local eError - the limit write's return
' @local startMs - getms() at the drive
' @local blockMs - ms from the drive to the latch
' @local eLeftCode - the left wheel's protective code
' @local eRightCode - the right wheel's protective code
' @local eRefusal - what a drive returned while the stop was latched
' @local eAfterEstopClear - what clearEmergency() returned while it was latched
' @local eRelease - what clearProtectiveStop() returned
' @local rawLeft1 - raw ticks after the release
' @local rawRight1 - the same, right wheel
' @local bStill - the platform stayed at rest through the release
' @local bDroveAgain - the platform reached speed once the limits were restored
' @local bOk - every claim of the step held

    blockMs := 0
    bInstLagExempt := TRUE                                  ' the lag below is provoked on purpose
    bArmed := bDArm(SIDE_BOTH)
    eError := dSetLimits(D_BLOCK_PEAK_A, D_BLOCK_CONT_A)
    if bArmed and (eError == NO_ERROR) and (dDrive(SIDE_BOTH, D_POWER) == NO_ERROR)
        startMs := getms()
        repeat
            beat(CP_LOOP_POLL)
            eLeftCode, eRightCode := dProtectiveStop()
            if (eLeftCode <> NO_ERROR) and (eRightCode <> NO_ERROR)
                blockMs := (getms() - startMs) #> 1
                quit
            waitms(D_LIMIT_POLL_MS)
            if (getms() - startMs) >= D_BLOCK_WAIT_MS
                quit
    if blockMs > 0
        bOk := (eLeftCode == wheelL.ERR_PLATFORM_BLOCKED) and (eRightCode == wheelL.ERR_PLATFORM_BLOCKED)
        eRefusal := dDrive(SIDE_BOTH, D_POWER)              ' refused with the protective code, and nothing moves
        bOk := bOk and (eRefusal == wheelL.ERR_PLATFORM_BLOCKED)
        eAfterEstopClear := dClearEstop(SIDE_BOTH)          ' the e-stop clear does NOT release a protective stop
        eLeftCode, eRightCode := dProtectiveStop()
        bOk := bOk and (eAfterEstopClear <> NO_ERROR) and (eLeftCode <> NO_ERROR) and (eRightCode <> NO_ERROR)
        eRelease := dClearProtective()
        eLeftCode, eRightCode := dProtectiveStop()
        bOk := bOk and (eRelease == NO_ERROR) and (eLeftCode == NO_ERROR) and (eRightCode == NO_ERROR)
        rawLeft1, rawRight1 := dRawTicks(SIDE_BOTH)         ' released, and still stopped until commanded
        waitBeat(D_CLEAR_STILL_MS, CP_LOOP_POLL)
        bStill := (bDBothMoved(rawLeft1, rawRight1) == FALSE)
        bOk := bOk and bStill
        dSetLimits(D_LIMIT_PEAK_DEF, D_LIMIT_CONT_DEF)      ' and the platform drives again once the limits allow it
        bDroveAgain := bDToSpeed(SIDE_BOTH)
        bOk := bOk and bDroveAgain
        dStepDone(DST_BLOCKED, SIDE_BOTH, TRUE, bOk, blockMs, 1, D_BLOCK_WAIT_MS, WHY_NONE)
    else
        dStepDone(DST_BLOCKED, SIDE_BOTH, FALSE, FALSE, 0, 1, D_BLOCK_WAIT_MS, bArmed ? WHY_NOT_BLOCKED : WHY_INST_NOACK)
    dStopMotion(SIDE_BOTH)
    bDRest(SIDE_BOTH)
    bInstIdle()
    bInstLagExempt := FALSE

PRI dProtectiveStop() : eLeftCode, eRightCode
' Both wheels' latched protective-stop causes, without clearing them.
'
' @returns eLeftCode - the left wheel's cause, NO_ERROR when none
' @returns eRightCode - the right wheel's cause, NO_ERROR when none

    beat(CP_LIB_STEER_QUERY)
    eLeftCode, eRightCode := steering.getProtectiveStop()
    beat(CP_LIB_STEER_QUERY)

PRI dClearProtective() : eError
' Acknowledge a latched protective stop on both wheels.
'
' @returns eError - NO_ERROR once released, or the code the library returned

    beat(CP_LIB_COMMAND)
    eError := steering.clearProtectiveStop()
    beat(CP_LIB_COMMAND)

PRI dLimitRestore() | slotIdx, nPeakA, nContA
' I11: put the MOSFET current limits back and READ THEM BACK, before the segment ends and before the
' single-wheel half runs, so no later measurement is taken under a limit this segment lowered.
'
' @local slotIdx - motor slot
' @local nPeakA - the peak limit read back
' @local nContA - the continuous limit read back

    dSetLimits(D_LIMIT_PEAK_DEF, D_LIMIT_CONT_DEF)
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        nPeakA, nContA, _, _, _ := dLimitState(slotIdx)
        emitLimSt(SIDE_LEFT + slotIdx, slotIdx, DST_BLOCKED, (nPeakA * X10) + nContA)

CON { --- attended segments: OUTSIDE and FLOOR (design sec 4.4) and the operator panel (sec 8) --- }

PRI outsideRun() : whyCode | tid, sid, safeEvent, bReached, rowIdx
' The OUTSIDE body after START (design sec 4.4): steering start (holdAtStop(FALSE) inside bSteerStart());
' arm on the steering source at FLOOR_DECIM; SYNC_PRECOND then driveAtPower(50, 50); both AT_SPEED (<=
' LADDER_STEADY_MS); settle SETTLE_MS; outsideBrake(); stopMotors(); both stopped; freeze; steering.stop().
' Then BM-OPER, BM-STRACE cause BRAKEHAND, BM-TS / BM-TRACE-END (drained only when the fault mark exists)
' and the BM-OUT rows. STOP is live on every screen from the spin-up on (PL-64): the spin-up and settle
' waits end on it (SAFE_OPER_STOP, why OPERATOR_STOP) and the wheels are stopped on the STOPPING screen.
'
' @returns whyCode - WHY_NONE when the brake, the untouched window and both Z steps ran, else the cause
'
' @local tid - trace id
' @local sid - the steering start's life, 0 when it did not start
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - both wheels reached AT_SPEED
' @local rowIdx - BM-OUT row

    tid := nextTraceId()
    cpReset()
    sid := 0
    outCount := 0
    bOutMarked := FALSE
    if bSteerStart(SEG_OUTSIDE) == FALSE
        cpWhy := WHY_NO_COG
        cpEnd := TEND_ABORT
    else
        sid := steerLife
        if bInstArm(INST_SRC_STEER, FLOOR_DECIM) == FALSE
            cpWhy := WHY_INST_NOACK
            cpEnd := TEND_ABORT
        elseif bSteerDriveBoth(SEG_OUTSIDE, tid, STEER_POWER_HALF) == FALSE
            cpWhy := WHY_SYNC_PRECOND
            cpEnd := TEND_ABORT
        else
            safeEvent, bReached := waitWatched(SIDE_BOTH, LADDER_STEADY_MS, CP_LOOP_ATSPEED, UNTIL_AT_SPEED)
            if (safeEvent == SAFE_NONE) and bReached
                safeEvent, _ := waitWatched(SIDE_BOTH, SETTLE_MS, CP_LOOP_SETTLE, UNTIL_TIME)
            if safeEvent <> SAFE_NONE
                cpWhy := safeWhy(safeEvent)
                cpEnd := safeEnd(safeEvent)
            elseif bReached == FALSE
                cpWhy := WHY_STEADY_TIMEOUT
                cpEnd := TEND_TIMEOUT
            else
                outsideBrake(tid)
            if bSteerUp
                panelShow(BM_SCR_STOPPING, BM_STATE_STOPPING, PNL_BTN_NONE)
                steerStopMotors()
                steerPollPhase(0, getms(), STOP_TIMEOUT_MS, TRUE, FALSE)
    bCpFrozen := bInstFreeze(0)
    if (bCpFrozen == FALSE) and (cpWhy == WHY_NONE)
        cpWhy := WHY_INST_NOACK
        cpEnd := TEND_ABORT
    steerStop()
    panelEnd(PROMPT_BRAKE_L, ANS_NONE, cpWhy)
    operFlush()
    emitSTrace(tid, SEG_OUTSIDE, CAUSE_BRAKEHAND, STEER_POWER_HALF, STEER_POWER_HALF, TRUE, 0, MODE_FLOAT, cpWhy)
    if bCpFrozen and bOutMarked
        bTraceDrain(tid, SLOT_LEFT, SLOT_RIGHT, cpEnd)
    else
        traceEmptyEnd(tid, cpEnd, (cpWhy == WHY_NONE) ? WHY_INST_NOACK : cpWhy)
    if outCount > 0
        repeat rowIdx from 0 to outCount - 1
            beat(CP_LOOP_DRAIN)
            emitOut(tid, sid, rowIdx)
    segItems := (segItems + 1) <# LIM_SMALL
    whyCode := cpWhy

PRI outsideBrake(tid) | buttonIdx, inputCode, safeEvent, markMs
' Ask for the LEFT hand-brake and wait for the instrument to see a fault (<= BRAKE_WAIT_MS, SKIP and STOP
' live, the absolute-current abort live). Folds R14-DUAL-BRAKEFLT-H: it ran when a fault or the
' absolute-current abort ended the wait, and the fault was seen when the LEFT fault flag is set. On a fault:
' mark, panel RELEASE, then outsideZSteps(). SKIP ends the step; STOP ends it too and says the operator
' stopped the wheels. An absolute-current abort shows STOPPING, since the operator is still holding the
' wheel and the harness has already stopped it. Fills cpWhy and cpEnd.
'
' @param tid - trace id
'
' @local buttonIdx - BM_BTN_SKIP or BM_BTN_STOP when the operator chose one, else PNL_BTN_NONE
' @local inputCode - INPUT_* of that choice
' @local safeEvent - SAFE_* that ended the wait
' @local markMs - getms() at the fault mark

    panelShow(BM_SCR_BRAKE_NOW, BM_STATE_BRAKE_NOW, PNL_BTN_NONE)
    operShown(PROMPT_BRAKE_L)
    buttonIdx, inputCode, safeEvent := operWait(BRAKE_WAIT_MS, SIDE_BOTH, TRUE)
    if (safeEvent == SAFE_FAULT) or (safeEvent == SAFE_ABS_ABORT)
        bSfBrakeRan := TRUE
        bSfBrakeSeen := (instLastFault[SLOT_LEFT] <> FALSE)
    if safeEvent == SAFE_FAULT
        instMark()
        markMs := getms()
        bOutMarked := TRUE
        panelShow(BM_SCR_BRAKE_RELEASE, BM_STATE_RELEASE, PNL_BTN_NONE)
        operShown(PROMPT_BRAKE_L)
        cpWhy := outsideZSteps(tid, markMs)
        cpEnd := (cpWhy == WHY_NONE) ? TEND_FROZEN : TEND_ABORT
    elseif buttonIdx == BM_BTN_SKIP
        operNote(PROMPT_BRAKE_L, OPEV_SKIP, ANS_NONE, inputCode, getms() - operShownMs, WHY_OPERATOR_SKIP)
        cpWhy := WHY_OPERATOR_SKIP
        cpEnd := TEND_ABORT
    elseif buttonIdx == BM_BTN_STOP
        operNote(PROMPT_BRAKE_L, OPEV_STOP, ANS_NONE, inputCode, getms() - operShownMs, WHY_OPERATOR_STOP)
        cpWhy := WHY_OPERATOR_STOP
        cpEnd := TEND_ABORT
    elseif safeEvent <> SAFE_NONE
        if safeEvent == SAFE_ABS_ABORT
            panelShow(BM_SCR_STOPPING, BM_STATE_STOPPING, PNL_BTN_NONE)
            operShown(PROMPT_BRAKE_L)
        cpWhy := safeWhy(safeEvent)
        cpEnd := safeEnd(safeEvent)
    else
        operNote(PROMPT_BRAKE_L, OPEV_TIMEOUT, ANS_NONE, INPUT_NONE, getms() - operShownMs, WHY_OPERATOR_TIMEOUT)
        cpWhy := WHY_OPERATOR_TIMEOUT
        cpEnd := TEND_TIMEOUT

PRI outsideZSteps(tid, markMs) : whyCode | phaseStartMs
' After the hand-brake fault (design sec 4.4 OUTSIDE): S5_UNTOUCHED_MS untouched; Z step 1, the same
' driveAtPower(50, 50) again (a request equal to the last is not a new request, sec 12.8), Z_STEP_MS; Z
' step 2, stopMotors(), both STOPPED (<= STOP_TIMEOUT_MS), driveAtPower(50, 50), Z_STEP_MS. The public API
' is polled into outBuf every OUT_POLL_MS throughout, and every drive call is preceded by the SYNC_PRECOND
' check (bSteerDriveBoth()). The operator is told before the harness drives the wheels again: the RELEASE
' screen counts the untouched window down under its own label, and the HANDS CLEAR screen is drawn before the
' first re-command. STOP stays live throughout; a STOP ends the sequence before the next drive command, even
' one chosen during a stop wait.
'
' @param tid - trace id
' @param markMs - getms() at the fault mark: the t_ms origin
' @returns whyCode - WHY_NONE when every step ran, else WHY_SYNC_PRECOND, WHY_ABORTED, WHY_INST_STALLED or
'   WHY_OPERATOR_STOP
'
' @local phaseStartMs - getms() at a step's command

    whyCode := safeWhy(steerPollPhase(markMs, markMs, S5_UNTOUCHED_MS, FALSE, TRUE))
    if whyCode == WHY_NONE
        panelShow(BM_SCR_BRAKE_ZSTEPS, BM_STATE_WHEELS_AGAIN, PNL_BTN_NONE)
        phaseStartMs := getms()
        if bSteerDriveBoth(SEG_OUTSIDE, tid, STEER_POWER_HALF)
            whyCode := safeWhy(steerPollPhase(markMs, phaseStartMs, Z_STEP_MS, FALSE, TRUE))
        else
            whyCode := WHY_SYNC_PRECOND
    if whyCode == WHY_NONE
        steerStopMotors()
        whyCode := safeWhy(steerPollPhase(markMs, getms(), STOP_TIMEOUT_MS, TRUE, TRUE))
    if whyCode == WHY_NONE
        phaseStartMs := getms()
        if bSteerDriveBoth(SEG_OUTSIDE, tid, STEER_POWER_HALF)
            whyCode := safeWhy(steerPollPhase(markMs, phaseStartMs, Z_STEP_MS, FALSE, TRUE))
        else
            whyCode := WHY_SYNC_PRECOND

PRI steerPollPhase(markMs, phaseStartMs, durationMs, bUntilStopped, bPoll) : safeEvent | safeNow, bStopAsked
' One beat-polled steering step: every SAMPLE_MS a safety read of the instrument mirror (sec 2.8) that
' acts on the absolute-current abort and a stalled instrument, but not on a fault flag (a braked or
' faulted wheel's flag is what the step observes); when asked, one public-API row every OUT_POLL_MS since
' the mark. With the panel up, the screen's countdown and heartbeat run and a STOP is taken (PL-64). Ends
' durationMs after phaseStartMs, on a STOP, or once both wheels read DCS_STOPPED when asked. A stop wait
' does not end on a STOP -- the wheels are already stopping -- but reports it when it ends.
'
' @param markMs - getms() at the fault mark: the t_ms origin (read only when bPoll is TRUE)
' @param phaseStartMs - getms() the step's duration is measured from
' @param durationMs - the step's bound
' @param bUntilStopped - TRUE to end early once both wheels read DCS_STOPPED
' @param bPoll - TRUE to poll the public API into outBuf
' @returns safeEvent - SAFE_ABS_ABORT, SAFE_INST_STALL or SAFE_OPER_STOP when one ended or came during the
'   step, else SAFE_NONE
'
' @local safeNow - this pass's safety read
' @local bStopAsked - the operator chose STOP during the step

    safetyReset()
    safeEvent := SAFE_NONE
    bStopAsked := FALSE
    repeat
        beat(CP_LOOP_POLL)
        if bPoll and (outCount < OUT_POLLS) and ((getms() - markMs) >= (outCount * OUT_POLL_MS))
            outPoll(getms() - markMs)
        panelTick(phaseStartMs, durationMs)
        waitms(SAMPLE_MS)
        safeNow := safetyPoll(SIDE_BOTH)
        if (safeNow == SAFE_ABS_ABORT) or (safeNow == SAFE_INST_STALL)
            safeEvent := safeNow
            quit
        if bPanelStopPressed()
            bStopAsked := TRUE
            if bUntilStopped == FALSE
                quit
        if bUntilStopped and bMirrorAllInState(SIDE_BOTH, DCS_STOPPED)
            quit
        if (getms() - phaseStartMs) >= durationMs
            quit
    if bStopAsked and (safeEvent == SAFE_NONE)
        safeEvent := SAFE_OPER_STOP

PRI outPoll(tMs) | rowBase
' One BM-OUT row: the public API as a user sees it -- getStatus(), testGetDriverState(),
' testGetFaultStatus() (no side effect), isTurning(), getPower() -- stored in outBuf and emitted after
' the window (design sec 3.6).
'
' @param tMs - ms since the fault mark
'
' @local rowBase - first long of the row

    rowBase := outCount * OUT_LONGS
    outBuf[rowBase + OUT_T_MS] := tMs
    beat(CP_LIB_STEER_QUERY)
    outBuf[rowBase + OUT_L_STAT], outBuf[rowBase + OUT_R_STAT] := steering.getStatus()
    outBuf[rowBase + OUT_L_ST], outBuf[rowBase + OUT_R_ST] := steering.testGetDriverState()
    outBuf[rowBase + OUT_L_FLT], outBuf[rowBase + OUT_L_SIG], outBuf[rowBase + OUT_R_FLT], outBuf[rowBase + OUT_R_SIG] := steering.testGetFaultStatus()
    outBuf[rowBase + OUT_TURNING] := steering.isTurning()
    outBuf[rowBase + OUT_L_PWR], outBuf[rowBase + OUT_R_PWR] := steering.getPower()
    ' task 3547: the public fault queries a user would call, read inside the same bracket as the rest
    '  of the row so one poll is one instant of the API
    outBuf[rowBase + OUT_FAULTED] := steering.isFaulted()
    outBuf[rowBase + OUT_ESTOP] := steering.isEmergency()
    beat(CP_LIB_STEER_QUERY)
    outCount += 1

PRI floorRun() : whyCode | tid, sid, buttonIdx, inputCode, safeEvent, driveStartMs, startTotal, endTotal
' The FLOOR body after START (design sec 4.4): steering start (holdAtStop(FALSE) inside bSteerStart()); arm
' at FLOOR_DECIM; SYNC_PRECOND; mark (the trace mark and the rate window's first ring total, sec 12.7);
' driveDirection(FLOOR_POWER, FLOOR_DIRECTION); OBSERVING with STOP live for FLOOR_RUN_MS (brief
' wheels-down observation) and the absolute-current abort live; stopMotors(); both stopped; freeze; the
' rates from the frozen ring; the which-way question (floorAsk()); steering.stop(). Then BM-OPER,
' BM-STRACE cause FLOOR, BM-TS / BM-TRACE-END and BM-FLOOR.
'
' @returns whyCode - WHY_NONE when the run and the answer completed, else the first cause
'
' @local tid - trace id
' @local sid - the steering start's life, 0 when it did not start
' @local buttonIdx - BM_BTN_STOP when the operator stopped the run, else PNL_BTN_NONE
' @local inputCode - INPUT_* of the STOP
' @local safeEvent - SAFE_* that ended the run early
' @local driveStartMs - getms() at the drive call
' @local startTotal - ring total at the mark, -1 when not recorded
' @local endTotal - samples stored before the stop command, -1 when the run did not happen

    tid := nextTraceId()
    cpReset()
    sid := 0
    flRunMs := 0
    flAnswer := ANS_NONE
    flInput := INPUT_NONE
    flStopBy := STOPBY_ABORT
    flLeftPwr := 0
    flRightPwr := 0
    bFlDrove := FALSE
    startTotal := -1
    endTotal := -1
    if bSteerStart(SEG_FLOOR) == FALSE
        cpWhy := WHY_NO_COG
        cpEnd := TEND_ABORT
    else
        sid := steerLife
        if bInstArm(INST_SRC_STEER, FLOOR_DECIM) == FALSE
            cpWhy := WHY_INST_NOACK
            cpEnd := TEND_ABORT
        elseif bSteerDrivePrecondition(SEG_FLOOR, tid) == FALSE
            cpWhy := WHY_SYNC_PRECOND
            cpEnd := TEND_ABORT
        else
            startTotal := instMarkIndex()
            driveStartMs := getms()
            curIncre := 0
            beat(CP_LIB_STEER_DRIVE)
            steering.driveDirection(FLOOR_POWER, FLOOR_DIRECTION)
            beat(CP_LIB_STEER_DRIVE)
            bFlDrove := TRUE
            beat(CP_LIB_STEER_QUERY)
            flLeftPwr, flRightPwr := steering.getPower()
            beat(CP_LIB_STEER_QUERY)
            panelShow(BM_SCR_FLOOR_DRIVE, BM_STATE_OBSERVING, PNL_BTN_NONE)
            buttonIdx, inputCode, safeEvent := operWait(FLOOR_RUN_MS, SIDE_BOTH, TRUE)
            endTotal := instTotal                           ' an index, never a time (sec 12.7): the instrument's own count
            flRunMs := getms() - driveStartMs
            if bSteerUp
                panelShow(BM_SCR_STOPPING, BM_STATE_STOPPING, PNL_BTN_NONE)
                steerStopMotors()
            cpEnd := TEND_FROZEN
            if buttonIdx == BM_BTN_STOP
                flStopBy := STOPBY_OPERATOR
                operNote(PROMPT_FLOOR, OPEV_STOP, ANS_NONE, inputCode, flRunMs, WHY_NONE)
            elseif safeEvent <> SAFE_NONE
                cpWhy := safeWhy(safeEvent)
                cpEnd := safeEnd(safeEvent)
            else
                flStopBy := STOPBY_TIMER
            if bSteerUp
                steerPollPhase(0, getms(), STOP_TIMEOUT_MS, TRUE, FALSE)
    bCpFrozen := bInstFreeze(0)
    if (bCpFrozen == FALSE) and (cpWhy == WHY_NONE)
        cpWhy := WHY_INST_NOACK
        cpEnd := TEND_ABORT
    floorRates(startTotal, endTotal)
    if bFlDrove
        floorAsk()
    steerStop()
    whyCode := cpWhy
    if (whyCode == WHY_NONE) and (flAnswer == ANS_NONE)
        whyCode := WHY_OPERATOR_TIMEOUT
    panelEnd(PROMPT_FLOOR, flAnswer, whyCode)
    operFlush()
    emitSTrace(tid, SEG_FLOOR, CAUSE_FLOOR, flLeftPwr, flRightPwr, bFlDrove, FLOOR_DIRECTION, MODE_FLOAT, cpWhy)
    if bCpFrozen and bFlDrove
        bTraceDrain(tid, SLOT_LEFT, SLOT_RIGHT, cpEnd)
    else
        traceEmptyEnd(tid, cpEnd, (cpWhy == WHY_NONE) ? WHY_INST_NOACK : cpWhy)
    emitFloor(tid, sid, flRunMs, flAnswer, flInput, flLeftRateX10, flRightRateX10, bFlRates, flSlower, flStopBy, floorWhy())
    segItems := (segItems + 1) <# LIM_SMALL

PRI floorAsk() | buttonIdx, inputCode
' Ask which way the platform turned (design sec 8.3): the four answer buttons live (keys L R T N), <=
' OPER_ANSWER_TIMEOUT_MS, the absolute-current abort still live. Folds R14-DUAL-FLOORANS-F: an answer was
' recorded. Fills flAnswer and flInput.
'
' @local buttonIdx - BM_BTN_* answered, PNL_BTN_NONE on timeout
' @local inputCode - INPUT_* of the answer

    operFlush()                                             ' the instrument no longer stores: the run's notes go out now
    panelShow(BM_SCR_FLOOR_ASK, BM_STATE_ASK, PNL_BTN_NONE)
    operShown(PROMPT_FLOOR)
    buttonIdx, inputCode, _ := operWait(OPER_ANSWER_TIMEOUT_MS, SIDE_BOTH, FALSE)
    if buttonIdx <> PNL_BTN_NONE
        flAnswer := buttonAnswer(buttonIdx)
        flInput := inputCode
        bSfFloorRan := TRUE
        bSfFloorAnswered := TRUE
        operNote(PROMPT_FLOOR, OPEV_ANSWER, flAnswer, inputCode, getms() - operShownMs, WHY_NONE)
    else
        operNote(PROMPT_FLOOR, OPEV_TIMEOUT, ANS_NONE, INPUT_NONE, getms() - operShownMs, WHY_OPERATOR_TIMEOUT)

PRI floorRates(startTotal, endTotal) | startJ, endJ, spanMs
' BM-FLOOR's rates from the frozen ring, over the samples stored from the mark up to the stop command,
' located by ring index (sec 12.7). The span is samples x period x decimation, never a getct() difference.
' Both ends must have both drivers up (I3). slower is the wheel with the smaller |rate|. Legal only
' while the instrument is FROZEN (I10). Fills flLeftRateX10, flRightRateX10, bFlRates and flSlower.
'
' @param startTotal - ring total at the mark, -1 when not recorded
' @param endTotal - samples stored before the stop command, -1 when the run did not happen
'
' @local startJ - logical index of the first window sample
' @local endJ - logical index of the last window sample
' @local spanMs - the window's span, ms

    bFlRates := FALSE
    flLeftRateX10 := 0
    flRightRateX10 := 0
    flSlower := SLOWER_EQUAL
    if bCpFrozen and (startTotal >= 0) and (endTotal > startTotal)
        drainBegin()
        startJ := startTotal - drLostHead
        endJ := (endTotal - 1 - drLostHead) <# (drStored - 1)
        if (startJ >= 0) and (endJ > startJ)
            if bSmpUp(startJ, SLOT_LEFT) and bSmpUp(endJ, SLOT_LEFT) and bSmpUp(startJ, SLOT_RIGHT) and bSmpUp(endJ, SLOT_RIGHT)
                spanMs := ((endJ - startJ) * INST_PERIOD_US * instDecimate) / US_PER_MS
                if spanMs > 0
                    flLeftRateX10 := ((smpPos(endJ, SLOT_LEFT) - smpPos(startJ, SLOT_LEFT)) * RATE_X10_SCALE) / spanMs
                    flRightRateX10 := ((smpPos(endJ, SLOT_RIGHT) - smpPos(startJ, SLOT_RIGHT)) * RATE_X10_SCALE) / spanMs
                    bFlRates := TRUE
                    if abs(flLeftRateX10) < abs(flRightRateX10)
                        flSlower := SLOWER_LEFT
                    elseif abs(flRightRateX10) < abs(flLeftRateX10)
                        flSlower := SLOWER_RIGHT

PRI floorWhy() : whyCode
' BM-FLOOR's why: the cause of NA rates first, then an unanswered question (answer NONE).
'
' @returns whyCode - WHY_* value

    if bFlRates == FALSE
        whyCode := (cpWhy <> WHY_NONE) ? cpWhy : WHY_NO_SAMPLES
    elseif flAnswer == ANS_NONE
        whyCode := WHY_OPERATOR_TIMEOUT
    else
        whyCode := WHY_NONE

PRI buttonAnswer(buttonIdx) : answerCode
' The BM-FLOOR / BM-OPER answer of an answer button.
'
' @param buttonIdx - BM_BTN_* value
' @returns answerCode - ANS_LEFT, ANS_RIGHT, ANS_STRAIGHT, ANS_NOMOVE, or ANS_NONE for any other button

    case buttonIdx
        BM_BTN_LEFT:
            answerCode := ANS_LEFT
        BM_BTN_RIGHT:
            answerCode := ANS_RIGHT
        BM_BTN_STRAIGHT:
            answerCode := ANS_STRAIGHT
        BM_BTN_NOMOVE:
            answerCode := ANS_NOMOVE
        other:
            answerCode := ANS_NONE

PRI operStartPrompt(promptCode, scrStart, scrNext) : whyCode | buttonIdx, inputCode
' Draw an attended segment's first screen and wait for START (<= its countdown start) before anything moves
' (sec 8.3: no motion before START). No motor runs, so no safety read is owed. On START the next screen is
' drawn at once -- the spin-up screen, with STOP live -- so no instruction to click START stays on screen
' while wheels move (PL-64).
'
' @param promptCode - PROMPT_* value
' @param scrStart - BM_SCR_* asking for START
' @param scrNext - BM_SCR_* drawn once START is chosen
' @returns whyCode - WHY_NONE on START, WHY_OPERATOR_TIMEOUT otherwise
'
' @local buttonIdx - BM_BTN_START, or PNL_BTN_NONE on timeout
' @local inputCode - INPUT_* of the START

    panelShow(scrStart, scrState(scrStart), PNL_BTN_NONE)
    operShown(promptCode)
    buttonIdx, inputCode, _ := operWait(scrCdMs(scrStart), SIDE_NONE, FALSE)
    if buttonIdx == BM_BTN_START
        panelShow(scrNext, scrState(scrNext), PNL_BTN_NONE)
        operNote(promptCode, OPEV_START, ANS_NONE, inputCode, getms() - operShownMs, WHY_NONE)
        whyCode := WHY_NONE
    else
        operNote(promptCode, OPEV_TIMEOUT, ANS_NONE, INPUT_NONE, getms() - operShownMs, WHY_OPERATOR_TIMEOUT)
        whyCode := WHY_OPERATOR_TIMEOUT
    operFlush()

PRI operWait(timeoutMs, watchSide, bEndOnSafety) : buttonIdx, inputCode, safeEvent | startMs, lastInputMs, elapsedMs, safeNow
' The operator wait every attended step shares: a beat-polled loop that polls the panel input every
' OPER_POLL_MS (under PC_KEY's ~100 ms latch), keeps the screen's countdown and heartbeat running (redrawn
' only when one changes, the dirty rule, DISPLAY-PATTERNS-builders-guide.md sec 7), and ends on a live
' button, the timeout or, when asked, a safety event. The buttons it accepts are exactly the ones the screen
' on display has live (pnlLive), so a wait cannot take an input the screen does not offer. With a watched
' side the loop runs every SAMPLE_MS and reads only the instrument mirror (sec 2.8), so the
' absolute-current abort stays live whether or not the wait ends on it.
'
' @param timeoutMs - the wait's bound
' @param watchSide - SIDE_BOTH to read the safety mirror, SIDE_NONE when no motor can run
' @param bEndOnSafety - TRUE to end the wait on any safety event, a fault flag included
' @returns buttonIdx - BM_BTN_* chosen, PNL_BTN_NONE when none
' @returns inputCode - INPUT_KEY, INPUT_MOUSE or INPUT_NONE
' @returns safeEvent - SAFE_* that ended the wait, SAFE_NONE otherwise
'
' @local startMs - getms() when the wait began
' @local lastInputMs - getms() of the last input poll
' @local elapsedMs - ms since the wait began
' @local safeNow - this pass's safety read

    buttonIdx := PNL_BTN_NONE
    inputCode := INPUT_NONE
    safeEvent := SAFE_NONE
    if watchSide <> SIDE_NONE
        safetyReset()
    startMs := getms()
    lastInputMs := startMs - OPER_POLL_MS
    repeat
        beat(CP_LOOP_OPER)
        elapsedMs := getms() - startMs
        panelTick(startMs, timeoutMs)
        if watchSide <> SIDE_NONE
            safeNow := safetyPoll(watchSide)
            if bEndOnSafety and (safeNow <> SAFE_NONE)
                safeEvent := safeNow
                quit
        if (getms() - lastInputMs) >= OPER_POLL_MS
            lastInputMs := getms()
            buttonIdx, inputCode := panelReadInput(pnlLive)
            if buttonIdx <> PNL_BTN_NONE
                pnlPressed := buttonIdx
                panelRender()
                quit
        if elapsedMs >= timeoutMs
            quit
        if watchSide <> SIDE_NONE
            waitms(SAMPLE_MS)
        else
            waitms(OPER_POLL_MS)

PRI operShown(promptCode)
' Start timing a prompt the operator now sees, and note BM-OPER SHOWN.
'
' @param promptCode - PROMPT_* value

    operShownMs := getms()
    operPromptCode := promptCode
    operNote(promptCode, OPEV_SHOWN, ANS_NONE, INPUT_NONE, 0, WHY_NONE)

PRI operNote(promptCode, eventCode, answerCode, inputCode, waitedMs, whyCode) | rowBase
' Note one BM-OPER event. operFlush() emits the notes where the instrument is not storing, so no record is
' emitted inside a capture (design sec 2.6); a full queue is flushed first, so no note is ever dropped.
'
' @param promptCode - PROMPT_* value
' @param eventCode - OPEV_* value
' @param answerCode - ANS_* value
' @param inputCode - INPUT_* value
' @param waitedMs - ms since the prompt was shown
' @param whyCode - WHY_* value
'
' @local rowBase - first long of the queue row

    if operQueueCount >= OPER_QUEUE_MAX
        operFlush()
    rowBase := operQueueCount * OQ_LONGS
    operQueue[rowBase + OQ_PROMPT] := promptCode
    operQueue[rowBase + OQ_EVENT] := eventCode
    operQueue[rowBase + OQ_ANSWER] := answerCode
    operQueue[rowBase + OQ_INPUT] := inputCode
    operQueue[rowBase + OQ_WAIT] := waitedMs
    operQueue[rowBase + OQ_WHY] := whyCode
    operQueueCount += 1

PRI operFlush() | rowIdx, rowBase
' Emit every noted BM-OPER record in the order noted, then empty the queue.
'
' @local rowIdx - queue row
' @local rowBase - first long of the row

    if operQueueCount > 0
        repeat rowIdx from 0 to operQueueCount - 1
            beat(CP_LOOP_OPER)
            rowBase := rowIdx * OQ_LONGS
            emitOper(operQueue[rowBase + OQ_PROMPT], operQueue[rowBase + OQ_EVENT], operQueue[rowBase + OQ_ANSWER], operQueue[rowBase + OQ_INPUT], operQueue[rowBase + OQ_WAIT], operQueue[rowBase + OQ_WHY])
    operQueueCount := 0

PRI panelEnd(promptCode, answerCode, whyCode)
' Note BM-OPER DONE for an attended sequence whose wheels are stopped and released, and draw the LOGGING
' screen while its records are written: the heartbeat may pause there, and the screen says so. The outcome
' is drawn later, by panelFinish() on the end screen.
'
' @param promptCode - PROMPT_* value
' @param answerCode - ANS_* value
' @param whyCode - WHY_* naming why the sequence ended short, WHY_NONE when it ran through

    panelShow(BM_SCR_LOGGING, BM_STATE_LOGGING, PNL_BTN_NONE)
    operNote(promptCode, OPEV_DONE, answerCode, INPUT_NONE, getms() - operShownMs, whyCode)

PRI panelFinish(scr, stateIdx)
' Draw an end screen with its outcome and wait for START (<= its countdown start), so the operator reads the
' result before the session ends (PL-64 audit B-3). Nothing moves: every wheel is stopped and released.
'
' @param scr - BM_SCR_END or BM_SCR_UI_END
' @param stateIdx - BM_STATE_* outcome drawn

    panelShow(scr, stateIdx, PNL_BTN_NONE)
    operWait(scrCdMs(scr), SIDE_NONE, FALSE)

PRI outcomeState(whyCode) : stateIdx
' The end screen's outcome word for an attended sequence's why.
'
' @param whyCode - WHY_* naming why the sequence ended short, WHY_NONE when it ran through
' @returns stateIdx - BM_STATE_DONE, TIMED_OUT, SKIPPED, STOPPED_BY_YOU, or ENDED_EARLY for any harness-side cause

    case whyCode
        WHY_NONE:
            stateIdx := BM_STATE_DONE
        WHY_OPERATOR_TIMEOUT:
            stateIdx := BM_STATE_TIMED_OUT
        WHY_OPERATOR_SKIP:
            stateIdx := BM_STATE_SKIPPED
        WHY_OPERATOR_STOP:
            stateIdx := BM_STATE_STOPPED_BY_YOU
        other:
            stateIdx := BM_STATE_ENDED_EARLY

PRI scrState(scr) : stateIdx
' A screen's default state word, from its bmScreens row.
'
' @param scr - BM_SCR_* value
' @returns stateIdx - BM_STATE_* value

    stateIdx := long[@bmScreens][(scr * BM_SCR_LONGS) + SCR_COL_STATE]

PRI scrLive(scr) : liveMask
' A screen's buttons, drawn and live, from its bmScreens row.
'
' @param scr - BM_SCR_* value
' @returns liveMask - mask with bit BM_BTN_* set per button

    liveMask := long[@bmScreens][(scr * BM_SCR_LONGS) + SCR_COL_LIVE]

PRI scrCdKind(scr) : cdKind
' What a screen's countdown means, from its bmScreens row.
'
' @param scr - BM_SCR_* value
' @returns cdKind - BM_CD_* value, BM_CD_NONE when the screen has no countdown

    cdKind := long[@bmScreens][(scr * BM_SCR_LONGS) + SCR_COL_CDKIND]

PRI scrCdMs(scr) : cdMs
' A screen's countdown start, from its bmScreens row: the bound of the wait it is drawn for.
'
' @param scr - BM_SCR_* value
' @returns cdMs - ms, 0 when the screen has no countdown

    cdMs := long[@bmScreens][(scr * BM_SCR_LONGS) + SCR_COL_CDMS]

PRI panelTick(phaseStartMs, durationMs) | secondsLeft, bDirty
' Keep the panel alive during any wait: the countdown's whole seconds left in the wait (when the screen's
' countdown runs), and the heartbeat dot every PNL_BEAT_MS. One redraw when either changed; nothing at all
' when no panel is up, so the unattended parts pay nothing (PL-64 audit sec 6 items 4 and 6).
'
' @param phaseStartMs - getms() the wait began
' @param durationMs - the wait's bound
'
' @local secondsLeft - whole seconds left, rounded up
' @local bDirty - the frame changed

    if bPanelUp
        bDirty := FALSE
        if bPnlCountdownLive
            secondsLeft := (((durationMs - (getms() - phaseStartMs)) + (MS_PER_SEC - 1)) / MS_PER_SEC) #> 0
            if secondsLeft <> pnlSeconds
                pnlSeconds := secondsLeft
                bDirty := TRUE
        if (getms() - pnlBeatMs) >= PNL_BEAT_MS
            pnlBeatMs := getms()
            pnlHeart := (pnlHeart + 1) // PNL_HEART_CELLS
            bDirty := TRUE
        if bDirty
            panelRender()

PRI bPanelStopPressed() : bStop | buttonIdx, inputCode
' During motion, take a STOP from the panel: polled every OPER_POLL_MS, only while the screen has STOP live
' and only with a panel up. A STOP is drawn highlighted and noted as BM-OPER STOP; the caller stops the
' wheels.
'
' @returns bStop - TRUE when the operator chose STOP on this poll
'
' @local buttonIdx - BM_BTN_STOP, or PNL_BTN_NONE
' @local inputCode - INPUT_* of the STOP

    bStop := FALSE
    if bPanelUp and ((pnlLive & PNL_LIVE_STOP) <> 0) and ((getms() - pnlInputMs) >= OPER_POLL_MS)
        pnlInputMs := getms()
        buttonIdx, inputCode := panelReadInput(PNL_LIVE_STOP)
        if buttonIdx == BM_BTN_STOP
            bStop := TRUE
            pnlPressed := BM_BTN_STOP
            panelRender()
            operNote(operPromptCode, OPEV_STOP, ANS_NONE, inputCode, getms() - operShownMs, WHY_OPERATOR_STOP)

PRI panelSetup()
' Create the bmpanel window and load its eight layers, in src/test_bench_t0.spin2 t0hSetupPanel()'s form
' (crop-and-overlay, DISPLAY-PATTERNS-builders-guide.md sec 2 and 6): PLOT with HIDEXY UPDATE, one LAYER
' per BMP, CROP 1, UPDATE. SIZE 480 306 and POS 60 80 are BM_PANEL_W / BM_PANEL_H / BM_PANEL_POS_X /
' BM_PANEL_POS_Y, and the layer numbers are BM_LYR_*, written as text as t0hSetupPanel() writes its own.
' Display text arguments use single quotes. A panel that fails to draw costs a START timeout, never motion.
'
' CARTESIAN 1 (flipy) is issued right after the window opens so PC_MOUSE reports y DOWN from the top-left,
' the basis mouseButton() hit-tests in and every CROP destination here is written in. PLOT's default basis
' is origin bottom-left with y up, and the mouse coordinate honours it (p2kbSpin2Plot, hardware-verified
' EF-020): the SRC_REV 6 dual-ui run registered no click on any button without this (debug_260915-134659.log).
' The interactive switches example and the analog meter in DISPLAY-PATTERNS-builders-guide.md declare the
' same directive and then work in y-down coordinates (DERIVED from their hit-tests and needle pivot).

    pnlScreen := BM_SCR_BRAKE_START
    pnlState := BM_STATE_WAITING
    pnlDrawn := PNL_LIVE_NONE
    pnlLive := PNL_LIVE_NONE
    pnlPressed := PNL_BTN_NONE
    pnlStrip := BM_STRIP_BLANK
    pnlSeconds := PNL_NO_COUNTDOWN
    bPnlCountdownLive := FALSE
    pnlHeart := 0
    pnlBeatMs := getms()
    pnlInputMs := getms()
    bPanelKeyArmed := FALSE
    bPanelMouseArmed := FALSE
    beat(CP_PANEL)
    debug(`PLOT bmpanel TITLE 'Motion harness operator panel' SIZE 480 306 POS 60 80 HIDEXY UPDATE)
    debug(`bmpanel cartesian 1)
    debug(`bmpanel LAYER 1 'bm_bg.bmp')
    debug(`bmpanel LAYER 2 'bm_prompt.bmp')
    debug(`bmpanel LAYER 3 'bm_state.bmp')
    debug(`bmpanel LAYER 4 'bm_buttons.bmp')
    debug(`bmpanel LAYER 5 'bm_digits.bmp')
    debug(`bmpanel LAYER 6 'bm_cdlabel.bmp')
    debug(`bmpanel LAYER 7 'bm_strip.bmp')
    debug(`bmpanel LAYER 8 'bm_heart.bmp')
    debug(`bmpanel crop 1)
    debug(`bmpanel update)
    bPanelUp := TRUE
    beat(CP_PANEL)

PRI panelShow(scr, stateIdx, pressedIdx)
' Draw an attended screen as its bmScreens row defines it: its prompt, the given state word, its buttons
' drawn and live, its countdown label, a running countdown when it has one, and a blank strip. Every
' attended screen is drawn through here, so a screen cannot offer a control its row does not name.
'
' @param scr - BM_SCR_* value
' @param stateIdx - BM_STATE_* cell (scrState(scr), or an outcome or progress word)
' @param pressedIdx - BM_BTN_* drawn highlighted, PNL_BTN_NONE when none

    panelCompose(scr, stateIdx, scrLive(scr), scrLive(scr), pressedIdx, BM_STRIP_BLANK, FALSE)

PRI panelCompose(scr, stateIdx, drawnMask, liveMask, pressedIdx, stripRow, bPreview)
' Set every pnl* field of one frame and draw it. Any key or click still latched from the last screen is
' dropped, so an input is only ever taken for the screen it was made on. A preview shows the countdown's
' start and does not run it; any other screen with a countdown blanks it until its wait's first tick.
'
' @param scr - BM_SCR_* value: its prompt cell and countdown label
' @param stateIdx - BM_STATE_* cell
' @param drawnMask - mask of the buttons drawn
' @param liveMask - mask of the buttons that may be chosen (drawn too)
' @param pressedIdx - BM_BTN_* drawn highlighted, PNL_BTN_NONE when none
' @param stripRow - BM_STRIP_* row
' @param bPreview - TRUE when dual-ui previews scr: its countdown is shown static

    pnlScreen := scr
    pnlState := stateIdx
    pnlDrawn := drawnMask
    pnlLive := liveMask
    pnlPressed := pressedIdx
    pnlStrip := stripRow
    bPanelKeyArmed := FALSE
    bPanelMouseArmed := FALSE
    bPnlCountdownLive := (scrCdKind(scr) <> BM_CD_NONE) and (bPreview == FALSE)
    if (scrCdKind(scr) <> BM_CD_NONE) and bPreview
        pnlSeconds := scrCdMs(scr) / MS_PER_SEC
    else
        pnlSeconds := PNL_NO_COUNTDOWN
    panelRender()

PRI panelRender() | btnIdx, slotX, slotY, cellCol, divisor, colIdx, digitCell
' Compose one frame from the pnl* state -- the prompt cell, the state cell, every button slot (normal when
' drawn or live, highlighted when pressed, otherwise restored from the background), the countdown label and
' digits (blank when there is none, leading zeros blank), the verdict strip and the heartbeat -- then one
' UPDATE (DISPLAY-PATTERNS-builders-guide.md sec 2). In src/test_bench_t0.spin2 t0hDrawPanel()'s form.
'
' @local btnIdx - BM_BTN_* slot
' @local slotX - the slot's left edge
' @local slotY - the slot's top edge
' @local cellCol - BM_BTN_NORMAL or BM_BTN_HILITE
' @local divisor - place value of the countdown column being drawn
' @local colIdx - countdown column, most significant first
' @local digitCell - bm_digits.bmp cell: 0..9, or BM_DGT_BLANK

    beat(CP_PANEL)
    debug(`bmpanel crop 2 `(0, pnlScreen * BM_PROMPT_H, BM_PROMPT_W, BM_PROMPT_H, BM_PROMPT_X, BM_PROMPT_Y))
    debug(`bmpanel crop 3 `(0, pnlState * BM_STATE_H, BM_STATE_W, BM_STATE_H, BM_STATE_X, BM_STATE_Y))
    debug(`bmpanel crop 6 `(0, scrCdKind(pnlScreen) * BM_CD_LBL_H, BM_CD_LBL_W, BM_CD_LBL_H, BM_CD_LBL_X, BM_CD_LBL_Y))
    debug(`bmpanel crop 7 `(0, pnlStrip * BM_STRIP_H, BM_STRIP_W, BM_STRIP_H, BM_STRIP_X, BM_STRIP_Y))
    debug(`bmpanel crop 8 `(pnlHeart * BM_HEART_W, 0, BM_HEART_W, BM_HEART_H, BM_HEART_X, BM_HEART_Y))
    repeat btnIdx from 0 to BM_BTN_COUNT - 1
        slotX, slotY := buttonSlot(btnIdx)
        if (btnIdx == pnlPressed) or (((pnlDrawn | pnlLive) & (DECOD btnIdx)) <> 0)
            cellCol := (btnIdx == pnlPressed) ? BM_BTN_HILITE : BM_BTN_NORMAL
            debug(`bmpanel crop 4 `(cellCol * BM_BTN_W, btnIdx * BM_BTN_H, BM_BTN_W, BM_BTN_H, slotX, slotY))
        else
            debug(`bmpanel crop 1 `(slotX, slotY, BM_BTN_W, BM_BTN_H))
    divisor := BM_CD_TOP_DIV
    repeat colIdx from 0 to BM_CD_COUNT - 1
        digitCell := BM_DGT_BLANK
        if pnlSeconds >= 0
            if (divisor == 1) or (pnlSeconds >= divisor)
                digitCell := (pnlSeconds / divisor) // PNL_DEC_RADIX
        debug(`bmpanel crop 5 `(digitCell * BM_DGT_W, 0, BM_DGT_W, BM_DGT_H, BM_CD_X + (colIdx * BM_DGT_W), BM_CD_Y))
        divisor /= PNL_DEC_RADIX
    debug(`bmpanel update)
    beat(CP_PANEL)

PRI buttonSlot(btnIdx) : slotX, slotY
' Top-left of a button's slot: buttons 0..BM_BTN_ROW2_FIRST-1 on row 1, then row 2, and from
' BM_BTN_STRIP_FIRST the verdict strip, at a fixed pitch (tools/gen_dual_assets.py slot() draws the frames at
' the same place).
'
' @param btnIdx - BM_BTN_* value
' @returns slotX - the slot's left edge
' @returns slotY - the slot's top edge

    if btnIdx >= BM_BTN_STRIP_FIRST
        slotX := BM_STRIP_BTN_X0 + ((btnIdx - BM_BTN_STRIP_FIRST) * BM_BTN_PITCH)
        slotY := BM_STRIP_Y
    elseif btnIdx >= BM_BTN_ROW2_FIRST
        slotX := BM_BTN_COL0_X + ((btnIdx - BM_BTN_ROW2_FIRST) * BM_BTN_PITCH)
        slotY := BM_BTN_ROW2_Y
    else
        slotX := BM_BTN_COL0_X + (btnIdx * BM_BTN_PITCH)
        slotY := BM_BTN_ROW1_Y

PRI panelReadInput(liveMask) : buttonIdx, inputCode
' Poll the keyboard, then the mouse, once each (design sec 8.2). PC_KEY and PC_MOUSE each carry their own
' backtick and end their debug() statement (p2kbSpin2DbgPcKey, p2kbSpin2DbgPcMouse). A key or a click is
' taken only after a released reading (src/test_bench_t0.spin2 testT0_12()'s arming), and only for a live
' button: keys S START, K SKIP, space STOP, L R T N the answers; a click by the button's bounding box.
'
' @param liveMask - PNL_LIVE_* mask of the buttons that may be chosen
' @returns buttonIdx - BM_BTN_* chosen, PNL_BTN_NONE when none
' @returns inputCode - INPUT_KEY, INPUT_MOUSE or INPUT_NONE

    buttonIdx := PNL_BTN_NONE
    inputCode := INPUT_NONE
    beat(CP_PANEL)
    debug(`bmpanel `pc_key(@panelKey))
    beat(CP_PANEL)
    if panelKey == 0
        bPanelKeyArmed := TRUE
    elseif bPanelKeyArmed
        bPanelKeyArmed := FALSE
        buttonIdx := keyButton(panelKey, liveMask)
        if buttonIdx <> PNL_BTN_NONE
            inputCode := INPUT_KEY
    if buttonIdx == PNL_BTN_NONE
        beat(CP_PANEL)
        debug(`bmpanel `pc_mouse(@panelMouse))
        beat(CP_PANEL)
        if panelMouse[MOUSE_LBTN] == 0
            bPanelMouseArmed := TRUE
        elseif bPanelMouseArmed
            bPanelMouseArmed := FALSE
            uiPressX := panelMouse[MOUSE_XPOS]
            uiPressY := panelMouse[MOUSE_YPOS]
            bUiPressSeen := TRUE
            buttonIdx := mouseButton(panelMouse[MOUSE_XPOS], panelMouse[MOUSE_YPOS], liveMask)
            if buttonIdx <> PNL_BTN_NONE
                inputCode := INPUT_MOUSE

PRI keyButton(keyValue, liveMask) : buttonIdx
' The live button a key names (either letter case): S START, K SKIP, space STOP, L LEFT, R RIGHT,
' T STRAIGHT, N DID NOT MOVE, Y LOOKS RIGHT, W SOMETHING WRONG.
'
' @param keyValue - PC_KEY's reading
' @param liveMask - PNL_LIVE_* mask of the buttons that may be chosen
' @returns buttonIdx - BM_BTN_* named and live, PNL_BTN_NONE otherwise

    case keyValue
        "S", "s":
            buttonIdx := BM_BTN_START
        "K", "k":
            buttonIdx := BM_BTN_SKIP
        " ":
            buttonIdx := BM_BTN_STOP
        "L", "l":
            buttonIdx := BM_BTN_LEFT
        "R", "r":
            buttonIdx := BM_BTN_RIGHT
        "T", "t":
            buttonIdx := BM_BTN_STRAIGHT
        "N", "n":
            buttonIdx := BM_BTN_NOMOVE
        "Y", "y":
            buttonIdx := BM_BTN_LOOKS_RIGHT
        "W", "w":
            buttonIdx := BM_BTN_WRONG
        other:
            buttonIdx := PNL_BTN_NONE
    if buttonIdx <> PNL_BTN_NONE
        if (liveMask & (DECOD buttonIdx)) == 0
            buttonIdx := PNL_BTN_NONE

PRI mouseButton(xPos, yPos, liveMask) : buttonIdx | btnIdx, slotX, slotY
' The live button whose slot holds the pointer; a pointer outside the window reads negative and hits none.
'
' @param xPos - PC_MOUSE x, window pixels
' @param yPos - PC_MOUSE y, window pixels
' @param liveMask - PNL_LIVE_* mask of the buttons that may be chosen
' @returns buttonIdx - BM_BTN_* under the pointer and live, PNL_BTN_NONE otherwise
'
' @local btnIdx - BM_BTN_* slot tested
' @local slotX - the slot's left edge
' @local slotY - the slot's top edge

    buttonIdx := PNL_BTN_NONE
    repeat btnIdx from 0 to BM_BTN_COUNT - 1
        slotX, slotY := buttonSlot(btnIdx)
        if ((liveMask & (DECOD btnIdx)) <> 0) and (xPos >= slotX) and (xPos < slotX + BM_BTN_W) and (yPos >= slotY) and (yPos < slotY + BM_BTN_H)
            buttonIdx := btnIdx
            quit

CON { --- instrument cog: runs in its own cog; no debug() anywhere below it (I1) --- }

PRI instrument() | dueCt, slackTicks, seenSeq
' The instrument cog (design sec 2). Paces itself on an absolute getct() schedule and never calls
' waitct() without positive slack; services cog 0's commands once per pass; reads both motors and the
' hall pins whenever it is not IDLE; stores one sample in instDecimate while RUN or FREEZE. Holds no
' lock, emits nothing, commands no motor. After EXIT it parks until cog 0 stops it (I4).
'
' @local dueCt - getct() the next sample is due at
' @local slackTicks - dueCt - getct(), signed (a GETCT difference is wrap-safe)
' @local seenSeq - instCmdSeq read once this pass

    isDecimCount := 0
    isFreezeLeft := 0
    isFreezeSeq := 0
    instState := INST_ST_IDLE
    dueCt := getct() + INST_PERIOD_TICKS
    repeat
        instHeartbeat += 1
        if instState == INST_ST_EXITED
            waitms(INST_EXIT_POLL_MS)
        else
            seenSeq := instCmdSeq
            if (seenSeq <> instAckSeq) and ((instState <> INST_ST_FREEZE) or (seenSeq <> isFreezeSeq))
                instExecute(seenSeq)
            if instState <> INST_ST_EXITED
                slackTicks := dueCt - getct()
                if slackTicks > INST_MIN_SLACK_US * TICKS_PER_US
                    waitct(dueCt)
                    dueCt += INST_PERIOD_TICKS
                elseif slackTicks > 0
                    dueCt += INST_PERIOD_TICKS              ' on time, too close to the target to wait on
                else
                    instCountLate(0 - slackTicks)
                    if (0 - slackTicks) >= INST_PERIOD_TICKS
                        dueCt := getct() + INST_PERIOD_TICKS  ' re-base; the skipped periods were counted
                    else
                        dueCt += INST_PERIOD_TICKS
                if instState <> INST_ST_IDLE
                    instSample()

PRI instExecute(seenSeq) | motorIdx
' Execute one cog-0 command, write the resulting state, then the ack (instrument cog). A FREEZE with
' post-samples is acked later, by instSample(), when they are stored. A command not legal from the
' current state is acked with the state unchanged; cog 0 checks the state it asked for.
'
' @param seenSeq - the instCmdSeq this command was read under
'
' @local motorIdx - motor slot

    case instCmd
        INST_CMD_ARM:
            if (instState == INST_ST_IDLE) or (instState == INST_ST_FROZEN)
                instW := 0
                instTotal := 0
                instMarkTotal := -1                         ' no mark belongs to this capture until cog 0 marks
                instMarkAckSeq := instMarkSeq
                instLate := 0
                instSkipped := 0
                instMaxLateTicks := 0
                instClamps := 0
                instIntegSat := 0
                repeat motorIdx from SLOT_LEFT to SLOT_RIGHT
                    instHwSkip[motorIdx] := 0
                    isHwPos[motorIdx] := 0
                    isHallCode[motorIdx] := pinread(instMotorBase(motorIdx) + HALL_PIN_OFFSET addpins HALL_PIN_SPAN)
                    isIgPrev[motorIdx] := -1                ' seeded by the first stored sample
                isDecimCount := 0
                instState := INST_ST_RUN
        INST_CMD_FREEZE:
            if instState == INST_ST_RUN
                isFreezeLeft := instArg0
                isFreezeSeq := seenSeq
                instState := (isFreezeLeft > 0) ? INST_ST_FREEZE : INST_ST_FROZEN
        INST_CMD_IDLE:
            if instState <> INST_ST_EXITED
                instState := INST_ST_IDLE
        INST_CMD_EXIT:
            instState := INST_ST_EXITED
    if instState <> INST_ST_FREEZE
        instAckSeq := seenSeq

PRI instCountLate(lateTicks)
' Count one sample that started after its due time (instrument cog): late only past INST_LATE_TICKS,
' the largest lateness, and whole periods with no sample. Every counter saturates at LIM_BIG (I2).
'
' @param lateTicks - how far past its due time the sample starts, in ticks (> 0)

    if instState <> INST_ST_IDLE
        if lateTicks > INST_LATE_TICKS
            instLate := (instLate + 1) <# LIM_BIG
            instRunLate := (instRunLate + 1) <# LIM_BIG
        instMaxLateTicks #>= lateTicks
        instRunMaxLateTicks #>= lateTicks
        if lateTicks >= INST_PERIOD_TICKS
            instSkipped := (instSkipped + (lateTicks / INST_PERIOD_TICKS)) <# LIM_BIG
            instRunSkipped := (instRunSkipped + (lateTicks / INST_PERIOD_TICKS)) <# LIM_BIG

PRI instSample() | motorIdx, sampleCt, seenMarkSeq
' Record a new mark's ring total, read the hall pins and the source once, refresh the last-sample
' mirror, and store a decimated sample while RUN or FREEZE (instrument cog). The mark check comes first,
' before this pass reads or stores anything, so instMarkTotal is the total index of the first stored
' sample taken at or after the mark (sec 12.7: the mark is located by ring index, never by time).
'
' @local motorIdx - motor slot
' @local sampleCt - getct() at the start of the sample, stored as t
' @local seenMarkSeq - instMarkSeq read once this pass

    seenMarkSeq := instMarkSeq
    if seenMarkSeq <> instMarkAckSeq
        instMarkTotal := instTotal                          ' total first, then the ack cog 0 waits on
        instMarkAckSeq := seenMarkSeq
    sampleCt := getct()
    repeat motorIdx from SLOT_LEFT to SLOT_RIGHT
        instReadHall(motorIdx)
    instReadSource()
    repeat motorIdx from SLOT_LEFT to SLOT_RIGHT
        instLastUp[motorIdx] := isUp[motorIdx]
        instLastI[motorIdx] := isUp[motorIdx] ? isSenseI[motorIdx] : 0
        instLastState[motorIdx] := isUp[motorIdx] ? isState[motorIdx] : DCS_UNKNOWN
        instLastFault[motorIdx] := isUp[motorIdx] ? isFault[motorIdx] : FALSE
        instLastPos[motorIdx] := isPos[motorIdx]
        instLastHw[motorIdx] := isHwPos[motorIdx]
    if (instState == INST_ST_RUN) or (instState == INST_ST_FREEZE)
        if isDecimCount == 0
            instStore(sampleCt)
            if instState == INST_ST_FREEZE
                isFreezeLeft -= 1
                if isFreezeLeft <= 0
                    instState := INST_ST_FROZEN
                    instAckSeq := isFreezeSeq
        isDecimCount += 1
        if isDecimCount >= instDecimate
            isDecimCount := 0

PRI instReadHall(motorIdx) | hallCode, hallDelta
' Decode one motor's hall inputs into hwPos with the local deltas65 copy (instrument cog). PINREAD reads
' the IN register and changes no pin configuration, so a running driver is not disturbed (Q4). A code
' change with a zero delta that touches no illegal code is a transition the poll could not resolve:
' counted in instHwSkip, never silent.
'
' @param motorIdx - motor slot
'
' @local hallCode - the 3-bit hall code just read
' @local hallDelta - signed tick delta from hallDeltas65

    hallCode := pinread(instMotorBase(motorIdx) + HALL_PIN_OFFSET addpins HALL_PIN_SPAN)
    if hallCode <> isHallCode[motorIdx]
        hallDelta := hallDeltas65[(isHallCode[motorIdx] << HALL_CODE_BITS) | hallCode] SIGNX FIELD_ERR_SIGNBIT
        if (hallDelta == 0) and (bHallCodeLegal(hallCode) == TRUE) and (bHallCodeLegal(isHallCode[motorIdx]) == TRUE)
            instHwSkip[motorIdx] := (instHwSkip[motorIdx] + 1) <# LIM_BIG
        isHwPos[motorIdx] += hallDelta
        isHallCode[motorIdx] := hallCode

PRI bHallCodeLegal(hallCode) : bLegal
' Report whether a 3-bit hall code is one a working sensor set can produce.
'
' @param hallCode - 3-bit hall code
' @returns bLegal - FALSE for %000 and %111

    bLegal := (hallCode <> HALL_CODE_ILLEGAL_LO) and (hallCode <> HALL_CODE_ILLEGAL_HI)

PRI instReadSource()
' Read the status block of the source latched at ARM, per motor, gated on the driver running (I3):
' WHEELS by testGetMotorCog() <> 0, STEER by the driver state <> DCS_Unknown (stop() writes it after
' its cogstop). Every call here is debug-free (I1, design sec 1 citations). Instrument cog.

    case instSrc
        INST_SRC_WHEELS:
            isUp[SLOT_LEFT] := (wheelL.testGetMotorCog() <> 0)
            if isUp[SLOT_LEFT]
                isDuty[SLOT_LEFT], isErr[SLOT_LEFT], isSenseI[SLOT_LEFT], isSenseU[SLOT_LEFT], isSenseV[SLOT_LEFT], isSenseW[SLOT_LEFT], isState[SLOT_LEFT], isFault[SLOT_LEFT] := wheelL.testGetTelemetry()
                isPos[SLOT_LEFT] := wheelL.getRawHallTicks()
                isMissed[SLOT_LEFT], isIllegal[SLOT_LEFT] := wheelL.getHallIntegrityCounts()
            isUp[SLOT_RIGHT] := (wheelR.testGetMotorCog() <> 0)
            if isUp[SLOT_RIGHT]
                isDuty[SLOT_RIGHT], isErr[SLOT_RIGHT], isSenseI[SLOT_RIGHT], isSenseU[SLOT_RIGHT], isSenseV[SLOT_RIGHT], isSenseW[SLOT_RIGHT], isState[SLOT_RIGHT], isFault[SLOT_RIGHT] := wheelR.testGetTelemetry()
                isPos[SLOT_RIGHT] := wheelR.getRawHallTicks()
                isMissed[SLOT_RIGHT], isIllegal[SLOT_RIGHT] := wheelR.getHallIntegrityCounts()
        INST_SRC_STEER:
            isState[SLOT_LEFT], isState[SLOT_RIGHT] := steering.testGetDriverState()
            isUp[SLOT_LEFT] := (isState[SLOT_LEFT] <> DCS_UNKNOWN)
            isUp[SLOT_RIGHT] := (isState[SLOT_RIGHT] <> DCS_UNKNOWN)
            if isUp[SLOT_LEFT]
                isDuty[SLOT_LEFT], isErr[SLOT_LEFT], isSenseI[SLOT_LEFT], isSenseU[SLOT_LEFT], isSenseV[SLOT_LEFT], isSenseW[SLOT_LEFT], isState[SLOT_LEFT], isFault[SLOT_LEFT] := steering.testLeftGetTelemetry()
            if isUp[SLOT_RIGHT]
                isDuty[SLOT_RIGHT], isErr[SLOT_RIGHT], isSenseI[SLOT_RIGHT], isSenseU[SLOT_RIGHT], isSenseV[SLOT_RIGHT], isSenseW[SLOT_RIGHT], isState[SLOT_RIGHT], isFault[SLOT_RIGHT] := steering.testRightGetTelemetry()
            if isUp[SLOT_LEFT] or isUp[SLOT_RIGHT]
                isPos[SLOT_LEFT], isPos[SLOT_RIGHT] := steering.testGetRawHallTicks()
                isMissed[SLOT_LEFT], isIllegal[SLOT_LEFT], isMissed[SLOT_RIGHT], isIllegal[SLOT_RIGHT] := steering.getHallIntegrityCounts()
        other:
            isUp[SLOT_LEFT] := FALSE
            isUp[SLOT_RIGHT] := FALSE

PRI instStore(sampleCt) | ringBase, motorIdx, motorOff
' Store one sample at the next ring index (instrument cog). The ring is circular: past
' INST_RING_SAMPLES the oldest sample is overwritten, and cog 0 reports the excess as lost_head.
'
' @param sampleCt - getct() at the start of this sample
'
' @local ringBase - first long of this sample in ring[]
' @local motorIdx - motor slot
' @local motorOff - first long of this motor's four longs

    instW := instTotal +// INST_RING_SAMPLES
    ringBase := instW * INST_SAMPLE_LONGS
    ring[ringBase + SMP_T] := sampleCt
    repeat motorIdx from SLOT_LEFT to SLOT_RIGHT
        motorOff := ringBase + SMP_MOTOR_BASE + (motorIdx * SMP_MOTOR_LONGS)
        ring[motorOff + SMP_POS] := isUp[motorIdx] ? isPos[motorIdx] : 0
        ring[motorOff + SMP_SENSE] := instPackSense(motorIdx)
        ring[motorOff + SMP_FLAGS] := instPackFlags(motorIdx)
        ring[motorOff + SMP_HW] := isHwPos[motorIdx]
    instTotal := (instTotal + 1) <# LIM_BIG
    instRunSamples := (instRunSamples + 1) <# LIM_BIG

PRI instClamp(fieldValue, lowLimit, highLimit) : clampedValue
' Clamp one stored field to its width, counting the clamp (instrument cog; I2).
'
' @param fieldValue - the reading
' @param lowLimit - smallest storable value
' @param highLimit - largest storable value
' @returns clampedValue - fieldValue inside lowLimit..highLimit

    clampedValue := (fieldValue #> lowLimit) <# highLimit
    if clampedValue <> fieldValue
        instClamps := (instClamps + 1) <# LIM_BIG
        instRunClamps := (instRunClamps + 1) <# LIM_BIG

PRI instPackSense(motorIdx) : senseLong | senseMv, phaseMv
' Pack i (i16) and the phase sum u+v+w (i16) into one long (instrument cog).
'
' @param motorIdx - motor slot
' @returns senseLong - i << 16 | phase sum & $FFFF; 0 when the driver is not up
'
' @local senseMv - clamped sense_i
' @local phaseMv - clamped phase sum

    senseLong := 0
    if isUp[motorIdx]
        senseMv := instClamp(isSenseI[motorIdx], 0 - FIELD_I16_MAX, FIELD_I16_MAX)
        phaseMv := instClamp(isSenseU[motorIdx] + isSenseV[motorIdx] + isSenseW[motorIdx], 0 - FIELD_I16_MAX, FIELD_I16_MAX)
        senseLong := (senseMv << SENSE_I_SHIFT) | (phaseMv & SENSE_PH_MASK)

PRI instPackFlags(motorIdx) : flagsLong | dutyVal, errVal, igNow, igDelta
' Pack duty, err, state, fault, up and the integrity delta since the previous stored sample into one
' long (instrument cog). The delta saturates at INTEG_DELTA_MAX; a saturation is counted.
'
' @param motorIdx - motor slot
' @returns flagsLong - duty << 16 | err << 8 | state << 5 | fault << 4 | up << 3 | integDelta
'
' @local dutyVal - clamped duty
' @local errVal - clamped err
' @local igNow - missed + illegal now
' @local igDelta - events since the previous stored sample

    flagsLong := 0
    if isUp[motorIdx]
        dutyVal := instClamp(isDuty[motorIdx], 0, FIELD_DUTY_MAX)
        errVal := instClamp(isErr[motorIdx], FIELD_ERR_MIN, FIELD_ERR_MAX)
        igNow := isMissed[motorIdx] + isIllegal[motorIdx]
        igDelta := 0
        if isIgPrev[motorIdx] >= 0
            igDelta := (igNow - isIgPrev[motorIdx]) #> 0
            if igDelta > INTEG_DELTA_MAX
                igDelta := INTEG_DELTA_MAX
                instIntegSat := (instIntegSat + 1) <# LIM_BIG
        isIgPrev[motorIdx] := igNow
        ' LAGBOUND (task 3558): the lag limiter's invariant, folded here because this is the one place a
        '  stored sample's err is already in hand. A faulted sample is left out -- the fault is what the
        '  limiter exists to prevent, and its err is the state after the driver gave up, not under control
        '  -- and so is a sample inside a deliberate provocation window.
        if (isFault[motorIdx] == FALSE) and (bInstLagExempt == FALSE)
            instLagMax[motorIdx] #>= abs(errVal)
            instLagN[motorIdx] := (instLagN[motorIdx] + 1) <# LIM_BIG
        flagsLong := (dutyVal << FLAG_DUTY_SHIFT) | ((errVal & FIELD_BYTE_MASK) << FLAG_ERR_SHIFT)
        flagsLong |= ((isState[motorIdx] & FLAG_STATE_MASK) << FLAG_STATE_SHIFT)
        flagsLong |= ((isFault[motorIdx] <> FALSE) ? (1 << FLAG_FAULT_BIT) : 0)
        flagsLong |= (1 << FLAG_UP_BIT) | igDelta

PRI instMotorBase(motorIdx) : basePin
' Base pin of a motor slot's board (shared by both cogs; reads only constants).
'
' @param motorIdx - motor slot
' @returns basePin - LEFT_TEST_BASE or RIGHT_TEST_BASE

    basePin := (motorIdx == SLOT_RIGHT) ? RIGHT_TEST_BASE : LEFT_TEST_BASE

CON { --- instrument control, cog 0 side (design sec 2.4, 2.5) --- }

PRI instStart() | startMs, bAcked
' Start the instrument cog once for the run (I4), prove it answers a command, and emit BM-INST.
'
' @local startMs - getms() before the first command
' @local bAcked - the first IDLE command was acknowledged

    benchLog.cogEventBegin()
    instCogId := cogspin(NEWCOG, instrument(), @instStack)
    benchLog.cogEventEnd()
    if instCogId < 0
        emitInst(INST_EV_NOSTART, 0, FALSE, WHY_NO_COG)
    else
        startMs := getms()
        bAcked := bInstCommand(INST_CMD_IDLE, 0, 0, INST_ACK_TIMEOUT_MS)
        if bAcked
            emitInst(INST_EV_START, getms() - startMs, TRUE, WHY_NONE)
        else
            emitInst(INST_EV_NOACK, 0, FALSE, WHY_INST_NOACK)

PRI instStop() | startMs, bAcked
' Stop the instrument cooperatively at run end: EXIT, bounded wait for the ack, then cogstop (I4).
' Without an ack the cogstop still runs: the instrument holds no lock and emits no debug (I1, I4).
'
' @local startMs - getms() before the EXIT command
' @local bAcked - the EXIT command was acknowledged

    if instCogId >= 0
        startMs := getms()
        bAcked := bInstCommand(INST_CMD_EXIT, 0, 0, INST_ACK_TIMEOUT_MS)
        benchLog.cogEventBegin()
        cogstop(instCogId)
        emitInst(INST_EV_STOP, getms() - startMs, bAcked, bAcked ? WHY_NONE : WHY_INST_NOACK)
        instCogId := -1

PRI bInstCommand(cmdCode, argFirst, argSecond, timeoutMs) : bAcked | startMs
' Send one command and wait, bounded and beating CP_INST_ACK every SAMPLE_MS, for its ack. The
' arguments are written first, then the command, then the sequence number the instrument watches.
'
' @param cmdCode - INST_CMD_* value
' @param argFirst - instArg0
' @param argSecond - instArg1
' @param timeoutMs - the longest wait for the ack
' @returns bAcked - TRUE when instAckSeq reached this command's sequence number
'
' @local startMs - getms() when the command was sent

    bAcked := FALSE
    if instCogId >= 0
        instArg0 := argFirst
        instArg1 := argSecond
        instArg2 := 0
        instCmd := cmdCode
        instCmdSeq += 1
        startMs := getms()
        repeat
            beat(CP_INST_ACK)
            if instAckSeq == instCmdSeq
                bAcked := TRUE
                quit
            if (getms() - startMs) >= timeoutMs
                quit
            waitms(SAMPLE_MS)

PRI bInstQuiet() : bQuiet
' Report whether the instrument has acknowledged IDLE or FROZEN (or is not running): the only states in
' which cog 0 may start, stop or switch a wheel, or drain the ring (I10).
'
' @returns bQuiet - TRUE when a wheel may be touched

    bQuiet := (instCogId < 0) or ((instAckSeq == instCmdSeq) and ((instState == INST_ST_IDLE) or (instState == INST_ST_FROZEN)))

PRI bInstArm(eSource, decimation) : bArmed
' Arm a capture on a source, legal only from IDLE or FROZEN. A missing ack emits BM-INST NOACK.
'
' @param eSource - INST_SRC_* value
' @param decimation - store one sample in this many (1..INST_DECIM_MAX)
' @returns bArmed - TRUE when the instrument acknowledged RUN

    bArmed := FALSE
    if (instCogId >= 0) and bInstQuiet()
        instSrc := eSource
        instDecimate := (decimation #> 1) <# INST_DECIM_MAX
        if bInstCommand(INST_CMD_ARM, eSource, instDecimate, INST_ACK_TIMEOUT_MS)
            bArmed := (instState == INST_ST_RUN)
        else
            emitInst(INST_EV_NOACK, INST_ACK_TIMEOUT_MS, FALSE, WHY_INST_NOACK)

PRI bInstFreeze(postSamples) : bFrozen | timeoutMs
' Freeze the capture after postSamples more stored samples. The ack bound covers the post samples.
'
' @param postSamples - samples to store after the command (0: freeze now)
' @returns bFrozen - TRUE when the instrument acknowledged FROZEN
'
' @local timeoutMs - ack bound: INST_ACK_TIMEOUT_MS plus the post samples' own duration

    bFrozen := (instCogId >= 0) and (instAckSeq == instCmdSeq) and (instState == INST_ST_FROZEN)
    if (bFrozen == FALSE) and (instCogId >= 0) and (instState == INST_ST_RUN)
        timeoutMs := INST_ACK_TIMEOUT_MS + ((postSamples #> 0) * instDecimate * MS_PER_SEC) / INST_RATE_HZ
        if bInstCommand(INST_CMD_FREEZE, postSamples #> 0, 0, timeoutMs)
            bFrozen := (instState == INST_ST_FROZEN)
        else
            emitInst(INST_EV_NOACK, timeoutMs, FALSE, WHY_INST_NOACK)

PRI bInstIdle() : bIdle
' Return the instrument to IDLE: it stops storing and stops reading any wheel.
'
' @returns bIdle - TRUE when IDLE is acknowledged (or no instrument runs)

    bIdle := (instCogId < 0) or ((instAckSeq == instCmdSeq) and (instState == INST_ST_IDLE))
    if bIdle == FALSE
        if bInstCommand(INST_CMD_IDLE, 0, 0, INST_ACK_TIMEOUT_MS)
            bIdle := (instState == INST_ST_IDLE)
        else
            emitInst(INST_EV_NOACK, INST_ACK_TIMEOUT_MS, FALSE, WHY_INST_NOACK)

PRI instIdleForShutdown()
' Before the end-of-run stops, return the instrument to IDLE so no wheel is stopped under it (I10).

    bInstIdle()

PRI instMark()
' Mark an event immediately before its library call. The instrument records the ring total on its
' next pass (instMarkTotal); instMarkCt is kept only for timing within one sample period (sec 12.7).

    instMarkCt := getct()
    instMarkSeq += 1

PRI instMarkIndex() : markTotal | startMs
' Mark a window boundary and wait, bounded and beating CP_INST_ACK every SAMPLE_MS, for the instrument
' to record the ring total at the mark (sec 12.7). A window is delimited by two of these totals.
'
' @returns markTotal - total index of the first sample stored at or after the mark, -1 when not recorded
'
' @local startMs - getms() when the mark was written

    markTotal := -1
    instMark()
    startMs := getms()
    repeat
        beat(CP_INST_ACK)
        if instMarkAckSeq == instMarkSeq
            markTotal := instMarkTotal
            quit
        if (getms() - startMs) >= INST_ACK_TIMEOUT_MS
            quit
        waitms(SAMPLE_MS)

CON { --- cog-0 safety monitor and watched waits (design sec 2.8) --- }

PRI safetyReset() | slotIdx
' Start a watched wait: clear the consecutive-current counts and take the heartbeat baseline.
'
' @local slotIdx - motor slot

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        safeAbsCount[slotIdx] := 0
    safeLastHeartbeat := instHeartbeat
    safeLastHeartbeatMs := getms()

PRI safetyPoll(side) : safeEvent | slotIdx
' One safety read of the instrument's last-sample mirror (no library getter). An absolute current at or
' above ABS_ABORT_MV on ABS_ABORT_SAMPLES consecutive reads stops that wheel FIRST, then emits BM-ABORT.
' Precedence: ABS_ABORT, then INST_STALL, then FAULT.
'
' @param side - SIDE_LEFT, SIDE_RIGHT or SIDE_BOTH: which motors are watched
' @returns safeEvent - SAFE_* value
'
' @local slotIdx - motor slot

    safeEvent := SAFE_NONE
    if instHeartbeat <> safeLastHeartbeat
        safeLastHeartbeat := instHeartbeat
        safeLastHeartbeatMs := getms()
    elseif (getms() - safeLastHeartbeatMs) >= INST_STALL_MS
        safeEvent := SAFE_INST_STALL
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        if bSideWatches(side, slotIdx) and (instLastUp[slotIdx] <> FALSE)
            if instLastI[slotIdx] >= ABS_ABORT_MV
                safeAbsCount[slotIdx] += 1
                if (safeAbsCount[slotIdx] >= ABS_ABORT_SAMPLES) and (safeEvent <> SAFE_ABS_ABORT)
                    abortStopMotor(side, slotIdx)
                    emitAbort(curSeg, curTid, (side == SIDE_BOTH) ? SIDE_BOTH : side, curIncre, ABR_ABS_CURRENT, ...
                        instLastI[slotIdx], SCOPE_TRIAL)
                    safeEvent := SAFE_ABS_ABORT
            else
                safeAbsCount[slotIdx] := 0
            if (instLastFault[slotIdx] <> FALSE) and (safeEvent == SAFE_NONE)
                safeEvent := SAFE_FAULT

PRI bSideWatches(side, slotIdx) : bWatched
' Report whether a motor slot belongs to a side.
'
' @param side - SIDE_* value
' @param slotIdx - motor slot
' @returns bWatched - TRUE when the side covers the slot

    bWatched := (side == SIDE_BOTH) or ((side - SIDE_LEFT) == slotIdx)

PRI abortStopMotor(side, slotIdx)
' The absolute-current abort's stop: the one place a wheel is stopped while the instrument may be
' reading it. Safety outranks I10; a straddled sample is gated by up (I3) on its next read.
'
' @param side - SIDE_BOTH stops the steering object; otherwise the slot's wheel
' @param slotIdx - motor slot over the limit

    beat(CP_LIB_STOP)
    if side == SIDE_BOTH
        benchLog.cogEventBegin()
        steering.stop()
        bSteerUp := FALSE
    elseif slotIdx == SLOT_RIGHT
        benchLog.cogEventBegin()
        wheelR.stop()
    else
        benchLog.cogEventBegin()
        wheelL.stop()
    beat(CP_LIB_STOP)

PRI waitWatched(side, durationMs, cpId, untilKind) : safeEvent, bReached | startMs
' A beat-polled wait of at most durationMs that reads only the instrument mirror every SAMPLE_MS, and
' ends early on a safety event or when every watched motor reaches the requested state. With the operator
' panel up (the attended parts only) it also keeps the heartbeat running and ends on a STOP
' (SAFE_OPER_STOP); in every unattended part both are no-ops.
'
' @param side - SIDE_LEFT, SIDE_RIGHT or SIDE_BOTH
' @param durationMs - the wait's bound
' @param cpId - CP_LOOP_* beaten every pass
' @param untilKind - UNTIL_TIME, UNTIL_STOPPED, UNTIL_AT_SPEED or UNTIL_MOVING
' @returns safeEvent - SAFE_* that ended the wait, SAFE_NONE otherwise
' @returns bReached - TRUE when the requested state (or, for UNTIL_TIME, the full duration) was reached
'
' @local startMs - getms() when the wait began

    safetyReset()
    safeEvent := SAFE_NONE
    bReached := FALSE
    startMs := getms()
    repeat
        beat(cpId)
        panelTick(startMs, durationMs)
        waitms(SAMPLE_MS)
        safeEvent := safetyPoll(side)
        if (safeEvent == SAFE_NONE) and bPanelStopPressed()
            safeEvent := SAFE_OPER_STOP
        if untilKind == UNTIL_STOPPED
            bReached := bMirrorAllInState(side, DCS_STOPPED)
        elseif untilKind == UNTIL_AT_SPEED
            bReached := bMirrorAllInState(side, DCS_AT_SPEED)
        elseif untilKind == UNTIL_MOVING
            bReached := bMirrorNoneInState(side, DCS_STOPPED)
        if (safeEvent <> SAFE_NONE) or bReached or ((getms() - startMs) >= durationMs)
            quit
    if untilKind == UNTIL_TIME
        bReached := (safeEvent == SAFE_NONE)

PRI bMirrorAllInState(side, eState) : bAll | slotIdx
' Report whether every watched motor's mirror shows the driver up and in one state.
'
' @param side - SIDE_LEFT, SIDE_RIGHT or SIDE_BOTH
' @param eState - DCS_* value
' @returns bAll - TRUE when every watched motor is up and in eState
'
' @local slotIdx - motor slot

    bAll := TRUE
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        if bSideWatches(side, slotIdx)
            if (instLastUp[slotIdx] == FALSE) or (instLastState[slotIdx] <> eState)
                bAll := FALSE

PRI bMirrorNoneInState(side, eState) : bNone | slotIdx
' Report whether every watched motor's mirror shows the driver up and outside one state.
'
' @param side - SIDE_LEFT, SIDE_RIGHT or SIDE_BOTH
' @param eState - DCS_* value
' @returns bNone - TRUE when every watched motor is up and not in eState
'
' @local slotIdx - motor slot

    bNone := TRUE
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        if bSideWatches(side, slotIdx)
            if (instLastUp[slotIdx] == FALSE) or (instLastState[slotIdx] == eState)
                bNone := FALSE

PRI waitRest(side, durationMs, bEndOnFault) : safeEvent, bRest | slotIdx, startMs, stillStartMs, lastPos[INST_MOTORS], lastHw[INST_MOTORS], bMoved
' A beat-polled capture wait after an event that reads only the instrument mirror (sec 2.8): ends when
' EVERY watched motor's pos and hwPos have been unchanged for REST_CONFIRM_MS, on a safety event, or
' after durationMs. After stop() pos is frozen, so hwPos alone decides.
'
' SIDE_BOTH WAITS FOR THE PLATFORM, not for a wheel. The slots are walked through bSideWatches(), as every
' other watched wait does: indexing a per-slot array with side - SIDE_LEFT would read past the array for
' SIDE_BOTH, which is why the walk is here rather than one computed slot.
'
' @param side - SIDE_LEFT, SIDE_RIGHT or SIDE_BOTH
' @param durationMs - the capture bound
' @param bEndOnFault - FALSE when the fault is the event under capture, so its flag does not end the wait
' @returns safeEvent - SAFE_* that ended the wait, SAFE_NONE otherwise
' @returns bRest - TRUE when rest was confirmed
'
' @local slotIdx - motor slot
' @local startMs - getms() when the wait began
' @local stillStartMs - getms() when any watched pos or hwPos last changed
' @local lastPos - mirrored pos of each slot at the previous pass
' @local lastHw - mirrored hwPos of each slot at the previous pass
' @local bMoved - a watched slot moved during this pass

    safetyReset()
    safeEvent := SAFE_NONE
    bRest := FALSE
    startMs := getms()
    stillStartMs := startMs
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        lastPos[slotIdx] := instLastPos[slotIdx]
        lastHw[slotIdx] := instLastHw[slotIdx]
    repeat
        beat(CP_LOOP_CAPTURE)
        waitms(SAMPLE_MS)
        safeEvent := safetyPoll(side)
        if (safeEvent == SAFE_FAULT) and (bEndOnFault == FALSE)
            safeEvent := SAFE_NONE
        bMoved := FALSE
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            if bSideWatches(side, slotIdx)
                if (instLastPos[slotIdx] <> lastPos[slotIdx]) or (instLastHw[slotIdx] <> lastHw[slotIdx])
                    bMoved := TRUE
                lastPos[slotIdx] := instLastPos[slotIdx]
                lastHw[slotIdx] := instLastHw[slotIdx]
        if bMoved
            stillStartMs := getms()
        elseif (getms() - stillStartMs) >= REST_CONFIRM_MS
            bRest := TRUE
        if (safeEvent <> SAFE_NONE) or bRest or ((getms() - startMs) >= durationMs)
            quit

PRI waitBeat(durationMs, cpId) | startMs
' A beat-polled wait with no motor watched (rests, cool-downs): no single waitms() exceeds SAMPLE_MS.
'
' @param durationMs - the wait's length
' @param cpId - CP_LOOP_* beaten every pass
'
' @local startMs - getms() when the wait began

    startMs := getms()
    repeat
        beat(cpId)
        if (getms() - startMs) >= durationMs
            quit
        waitms(SAMPLE_MS)

CON { --- ring drain accessors, cog 0, legal only while the instrument is IDLE or FROZEN (I10) --- }

PRI drainBegin()
' Snapshot the ring geometry for a drain: how many samples are readable, how many were overwritten,
' and where logical sample 0 sits.

    beat(CP_LOOP_DRAIN)
    drStored := instTotal <# INST_RING_SAMPLES
    drLostHead := instTotal - drStored
    drOldest := 0
    if instTotal > INST_RING_SAMPLES
        drOldest := (instW + 1) +// INST_RING_SAMPLES

PRI smpBase(sampleIdx) : ringBase
' First long in ring[] of a logical sample.
'
' @param sampleIdx - logical index 0..drStored-1, oldest first
' @returns ringBase - index of its t long

    ringBase := ((drOldest + sampleIdx) +// INST_RING_SAMPLES) * INST_SAMPLE_LONGS

PRI smpMotorLong(sampleIdx, slotIdx, fieldOff) : fieldLong
' One motor long of a logical sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @param fieldOff - SMP_POS, SMP_SENSE, SMP_FLAGS or SMP_HW
' @returns fieldLong - the stored long

    fieldLong := ring[smpBase(sampleIdx) + SMP_MOTOR_BASE + (slotIdx * SMP_MOTOR_LONGS) + fieldOff]

PRI smpT(sampleIdx) : sampleCt
' getct() at the start of a logical sample.
'
' @param sampleIdx - logical index
' @returns sampleCt - the stored t

    sampleCt := ring[smpBase(sampleIdx) + SMP_T]

PRI smpPos(sampleIdx, slotIdx) : nPos
' Driver pos of a logical sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns nPos - stored pos (0 when the driver was not up)

    nPos := smpMotorLong(sampleIdx, slotIdx, SMP_POS)

PRI smpHw(sampleIdx, slotIdx) : nHwPos
' Hall-decoded hwPos of a logical sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns nHwPos - stored hwPos

    nHwPos := smpMotorLong(sampleIdx, slotIdx, SMP_HW)

PRI smpI(sampleIdx, slotIdx) : senseMv
' sense_i of a logical sample, sign-extended from 16 bits.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns senseMv - mV

    senseMv := smpMotorLong(sampleIdx, slotIdx, SMP_SENSE) SAR SENSE_I_SHIFT

PRI smpPh(sampleIdx, slotIdx) : phaseMv
' Phase sum u+v+w of a logical sample, sign-extended from 16 bits.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns phaseMv - mV

    phaseMv := (smpMotorLong(sampleIdx, slotIdx, SMP_SENSE) & SENSE_PH_MASK) SIGNX SENSE_PH_SIGNBIT

PRI smpDuty(sampleIdx, slotIdx) : dutyVal
' Duty of a logical sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns dutyVal - 0..65535

    dutyVal := smpMotorLong(sampleIdx, slotIdx, SMP_FLAGS) >> FLAG_DUTY_SHIFT

PRI smpErr(sampleIdx, slotIdx) : errVal
' Position error of a logical sample, sign-extended from 8 bits.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns errVal - -128..127

    errVal := ((smpMotorLong(sampleIdx, slotIdx, SMP_FLAGS) >> FLAG_ERR_SHIFT) & FIELD_BYTE_MASK) SIGNX FIELD_ERR_SIGNBIT

PRI smpState(sampleIdx, slotIdx) : eDrvrState
' Driver state of a logical sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns eDrvrState - DCS_* 0..7

    eDrvrState := (smpMotorLong(sampleIdx, slotIdx, SMP_FLAGS) >> FLAG_STATE_SHIFT) & FLAG_STATE_MASK

PRI bSmpFault(sampleIdx, slotIdx) : bFaulted
' Fault flag of a logical sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns bFaulted - TRUE when the fault flag was set

    bFaulted := ((smpMotorLong(sampleIdx, slotIdx, SMP_FLAGS) >> FLAG_FAULT_BIT) & 1) <> 0

PRI bSmpUp(sampleIdx, slotIdx) : bUp
' Driver-running flag of a logical sample (I3).
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns bUp - TRUE when the driver was up

    bUp := ((smpMotorLong(sampleIdx, slotIdx, SMP_FLAGS) >> FLAG_UP_BIT) & 1) <> 0

PRI smpIg(sampleIdx, slotIdx) : igDelta
' Hall integrity events since the previous stored sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns igDelta - 0..INTEG_DELTA_MAX

    igDelta := smpMotorLong(sampleIdx, slotIdx, SMP_FLAGS) & FLAG_IG_MASK

PRI drainFindMark() | markIdx
' Locate the event mark by ring index (sec 12.7): its logical index is instMarkTotal - drLostHead, valid
' when the instrument recorded it for the latest mark and it lies in 0..drStored-1. Below 0 the mark
' sample was overwritten, so lost_head reaches the mark. Sets drMarkJ and bDrMarkFound.
'
' @local markIdx - the mark's logical index

    drMarkJ := drStored
    bDrMarkFound := FALSE
    if (instMarkAckSeq == instMarkSeq) and (instMarkTotal >= 0)
        markIdx := instMarkTotal - drLostHead
        if (markIdx >= 0) and (markIdx < drStored)
            drMarkJ := markIdx
            bDrMarkFound := TRUE

CON { --- trace emission (design sec 3.5, sec 12.4) and window statistics (I2) --- }

PRI bTraceDrain(tid, slotPri, slotOth, endCode) : bLost
' Drain a frozen capture as one trace: locate the mark by ring index, bound the trace to
' TRACE_MAX_SAMPLES from TRACE_PRE_SAMPLES before it, find rest, choose the dense window and stride that
' fit TRACE_EMIT_MAX (dense 250, then 100, then stride 1, 2, 4, 8), emit the BM-TS lines, then
' BM-TRACE-END. The caller has emitted BM-TRACE or BM-STRACE, and folds nothing: this method folds the
' trace into R14-DUAL-TRACES-*.
'
' @param tid - trace id from nextTraceId()
' @param slotPri - primary motor slot (the o_ fields are the other slot)
' @param slotOth - the other motor slot
' @param endCode - TEND_* naming why the capture ended
' @returns bLost - TRUE when the capture lost data at or before its mark, or dropped samples

    drainBegin()
    drPri := slotPri
    drOth := slotOth
    drainFindMark()
    drStartJ := 0
    if bDrMarkFound
        drStartJ := (drMarkJ - TRACE_PRE_SAMPLES) #> 0
    drEndJ := drStored - 1
    drDropped := 0
    if (drStored > 0) and ((drEndJ - drStartJ + 1) > TRACE_MAX_SAMPLES)
        drDropped := (drEndJ - drStartJ + 1) - TRACE_MAX_SAMPLES
        drEndJ := drStartJ + TRACE_MAX_SAMPLES - 1
    traceFindRest()
    traceStopTicks()
    traceIntegritySums()
    traceIdleMove()
    trTid := tid
    trDense := TRACE_DENSE_SAMPLES
    trStride := 1
    traceWalk(FALSE)
    if trLines > TRACE_EMIT_MAX
        trDense := TRACE_DENSE_MIN
        traceWalk(FALSE)
        repeat while (trLines > TRACE_EMIT_MAX) and (trStride < TRACE_STRIDE_MAX)
            trStride *= TRACE_STRIDE_GROWTH
            traceWalk(FALSE)
    traceWalk(TRUE)
    ' lost_head reaches the mark: samples were overwritten and none survives before the mark
    bLost := (drDropped > 0) or ((drLostHead > 0) and ((bDrMarkFound == FALSE) or (drMarkJ == 0)))
    sfTraces := (sfTraces + 1) <# LIM_BIG
    if bLost
        sfTraceLost := (sfTraceLost + 1) <# LIM_BIG
    emitTraceEnd(tid, endCode, WHY_NO_SAMPLES)

PRI traceFindRest() | restSamples, stillCount, runStartJ, sampleIdx
' Find rest after the mark: pos and hwPos of the primary motor unchanged for REST_CONFIRM_MS. Sets
' drRestK (k where the still run began) and bDrRestFound.
'
' @local restSamples - stored samples spanning REST_CONFIRM_MS at this capture's decimation
' @local stillCount - consecutive unchanged samples so far
' @local runStartJ - logical index where the current still run began
' @local sampleIdx - logical index

    bDrRestFound := FALSE
    drRestK := 0
    restSamples := ((REST_CONFIRM_MS * INST_RATE_HZ) / MS_PER_SEC / instDecimate) #> 1
    if bDrMarkFound and (drMarkJ < drEndJ)
        stillCount := 0
        runStartJ := drMarkJ
        repeat sampleIdx from drMarkJ + 1 to drEndJ
            beat(CP_LOOP_DRAIN)
            if (smpPos(sampleIdx, drPri) == smpPos(sampleIdx - 1, drPri)) and (smpHw(sampleIdx, drPri) == smpHw(sampleIdx - 1, drPri))
                stillCount += 1
                if stillCount >= restSamples
                    drRestK := runStartJ - drStartJ
                    bDrRestFound := TRUE
                    quit
            else
                stillCount := 0
                runStartJ := sampleIdx

PRI traceStopTicks() | restJ
' STPDECEL: how far the primary motor travelled between the event and rest, from the trace the drain has
' just located. One subtraction on samples the trace already found, so no extra reading and no extra run:
' the deceleration number rides the capture C-4 already takes.
'
' @local restJ - logical index of the sample where the still run began

    trStopTicks := 0
    bTrStopValid := FALSE
    if bDrMarkFound and bDrRestFound
        restJ := drStartJ + drRestK
        if (restJ >= drMarkJ) and (restJ <= drEndJ)
            trStopTicks := abs(smpPos(restJ, drPri) - smpPos(drMarkJ, drPri))
            bTrStopValid := TRUE

PRI traceIdleMove() | sampleIdx
' IDLEMOVE (task 3572): the largest distance the OTHER wheel's halls moved during the trace, from its own
' hwPos (the instrument decodes the hall pins itself, so this sees the wheel whether or not its driver runs).
' In a motor-frame trial the other wheel is stopped and nobody commands it; a wheel that moves anyway is a
' command reaching the wrong wheel (PL-76's class) or a mechanical coupling, and either invalidates the trial.
'
' @local sampleIdx - logical index

    trIdleMove := 0
    if drStored > 0
        repeat sampleIdx from drStartJ to drEndJ
            beat(CP_LOOP_DRAIN)
            trIdleMove #>= abs(smpHw(sampleIdx, drOth) - smpHw(drStartJ, drOth))

PRI traceIntegritySums() | sampleIdx
' Integrity events over the trace for both motors, and the primary motor's unresolved hall transitions.
'
' @local sampleIdx - logical index

    drIgSum := 0
    drOIgSum := 0
    drHwSkip := instHwSkip[drPri]
    if (drStored > 0) and (drStartJ < drEndJ)
        repeat sampleIdx from drStartJ + 1 to drEndJ
            beat(CP_LOOP_DRAIN)
            drIgSum := (drIgSum + smpIg(sampleIdx, drPri)) <# LIM_BIG
            drOIgSum := (drOIgSum + smpIg(sampleIdx, drOth)) <# LIM_BIG

PRI traceWalk(bEmit) | sampleIdx, kIdx, markK, posRel, hwRel, stNow, bFltNow, bUpNow, bWant, bChanged
' Walk the trace applying the emission rule. With bEmit FALSE it only counts the lines the rule wants
' (trLines), so bTraceDrain() can pick a dense window and stride; with bEmit TRUE it emits them, never
' more than TRACE_EMIT_MAX (the last sample is always kept), and leaves trLines / trKSum as emitted.
' Rule: k below mark_k + dense; or, on every stride-th k, a change of pos, hw, st, flt or up from the
' last emitted line, or k a multiple of TRACE_SPARSE_EVERY x stride; or the first or last sample.
'
' @param bEmit - TRUE to emit BM-TS lines, FALSE to count only
'
' @local sampleIdx - logical index
' @local kIdx - trace index k
' @local markK - k of the mark (0 when the mark was not found)
' @local posRel - primary pos relative to k = 0
' @local hwRel - primary hwPos relative to k = 0
' @local stNow - primary state
' @local bFltNow - primary fault flag
' @local bUpNow - primary up flag
' @local bWant - the rule wants this line
' @local bChanged - a watched field differs from the last emitted line

    trLines := 0
    trKSum := 0
    trIgRun := 0
    bTrEmitted := FALSE
    markK := bDrMarkFound ? (drMarkJ - drStartJ) : 0
    if drStored > 0
        repeat sampleIdx from drStartJ to drEndJ
            beat(CP_LOOP_DRAIN)
            kIdx := sampleIdx - drStartJ
            if kIdx > 0
                trIgRun := (trIgRun + smpIg(sampleIdx, drPri)) <# LIM_BIG
            posRel := smpPos(sampleIdx, drPri) - smpPos(drStartJ, drPri)
            hwRel := smpHw(sampleIdx, drPri) - smpHw(drStartJ, drPri)
            stNow := smpState(sampleIdx, drPri)
            bFltNow := bSmpFault(sampleIdx, drPri)
            bUpNow := bSmpUp(sampleIdx, drPri)
            bWant := (sampleIdx == drStartJ) or (sampleIdx == drEndJ) or (kIdx < markK + trDense)
            if (kIdx +// trStride) == 0
                bChanged := (bTrEmitted == FALSE) or (posRel <> trLastPos) or (hwRel <> trLastHw)
                bChanged := bChanged or (stNow <> trLastSt) or (bFltNow <> trLastFlt) or (bUpNow <> trLastUp)
                if bChanged or ((kIdx +// (TRACE_SPARSE_EVERY * trStride)) == 0)
                    bWant := TRUE
            if bWant and ((bEmit == FALSE) or (trLines < TRACE_EMIT_MAX - 1) or (sampleIdx == drEndJ))
                trLines += 1
                trKSum := (trKSum + kIdx) <# LIM_MID
                trLastPos := posRel
                trLastHw := hwRel
                trLastSt := stNow
                trLastFlt := bFltNow
                trLastUp := bUpNow
                bTrEmitted := TRUE
                if bEmit
                    emitTs(sampleIdx, kIdx, posRel, hwRel)

PRI windowStats(slotIdx, otherIdx, winStartTotal, winEndTotal) | sampleIdx, startJ, endJ, firstJ, lastJ, iSum, phSum, dutySum, errSum, sampleI
' Compute a measurement window's statistics from drained samples (I2). The window is delimited by ring
' index, never by time (sec 12.7): only samples whose total index lies in winStartTotal..winEndTotal-1
' count (each bound is an instMarkIndex() total, the first sample at or after its mark). Sums run over
' at most INST_RING_SAMPLES clamped fields, and i / phase / duty / err statistics use only samples whose
' driver was up (I3). A bound below 0 selects no sample and reads no ring long. Fills the rs* staging.
'
' @param slotIdx - motor slot under test
' @param otherIdx - the idle motor slot (bRsIdleUp / rsIdleIMax, I6)
' @param winStartTotal - total index at the window start, -1 when not recorded
' @param winEndTotal - total index at the window end, -1 when not recorded
'
' @local sampleIdx - logical index
' @local startJ - logical index of the first sample in the window
' @local endJ - logical index of the last sample in the window
' @local firstJ - first sample inside the window, -1 when none
' @local lastJ - last sample inside the window
' @local iSum - sum of i over up samples, |sum| <= 32_767 x 4_096
' @local phSum - sum of the phase sum over up samples, same bound
' @local dutySum - sum of duty over up samples, <= 65_535 x 4_096
' @local errSum - sum of err over up samples
' @local sampleI - this sample's i

    drainBegin()
    rsN := 0
    iSum := 0
    phSum := 0
    dutySum := 0
    errSum := 0
    rsIMin := POSX
    rsIMax := NEGX
    rsDutyPk := 0
    rsErrPk := 0
    rsIgSum := 0
    rsIMeanX10 := 0
    rsPhMeanX10 := 0
    rsDutyMean := 0
    rsErrMean := 0
    rsTicks := 0
    rsHwTicks := 0
    rsWinMs := 0
    rsRateX10 := 0
    bRsAllUp := TRUE
    bRsIdleUp := FALSE
    rsIdleIMax := 0
    firstJ := -1
    lastJ := -1
    startJ := 0
    endJ := -1
    if (winStartTotal >= 0) and (winEndTotal > winStartTotal) and (drStored > 0)
        startJ := (winStartTotal - drLostHead) #> 0
        endJ := (winEndTotal - 1 - drLostHead) <# (drStored - 1)
    if endJ >= startJ
        repeat sampleIdx from startJ to endJ
            beat(CP_LOOP_DRAIN)
            if firstJ < 0
                firstJ := sampleIdx
            elseif bSmpUp(sampleIdx, slotIdx)
                rsIgSum := (rsIgSum + smpIg(sampleIdx, slotIdx)) <# LIM_BIG
            lastJ := sampleIdx
            if bSmpUp(sampleIdx, slotIdx)
                sampleI := smpI(sampleIdx, slotIdx)
                rsN += 1
                iSum += sampleI
                phSum += smpPh(sampleIdx, slotIdx)
                dutySum += smpDuty(sampleIdx, slotIdx)
                errSum += smpErr(sampleIdx, slotIdx)
                rsIMin <#= sampleI
                rsIMax #>= sampleI
                rsDutyPk #>= smpDuty(sampleIdx, slotIdx)
                rsErrPk #>= abs(smpErr(sampleIdx, slotIdx))
            else
                bRsAllUp := FALSE
            if bSmpUp(sampleIdx, otherIdx)
                bRsIdleUp := TRUE
                rsIdleIMax #>= abs(smpI(sampleIdx, otherIdx))
    if rsN > 0
        rsIMeanX10 := (iSum * X10) / rsN
        rsPhMeanX10 := (phSum * X10) / rsN
        rsDutyMean := dutySum / rsN
        rsErrMean := errSum / rsN
    else
        rsIMin := 0
        rsIMax := 0
        bRsAllUp := FALSE
    if (firstJ >= 0) and (lastJ > firstJ)
        rsTicks := smpPos(lastJ, slotIdx) - smpPos(firstJ, slotIdx)
        rsHwTicks := smpHw(lastJ, slotIdx) - smpHw(firstJ, slotIdx)
        rsWinMs := (smpT(lastJ) - smpT(firstJ)) / TICKS_PER_MS
        if rsWinMs > 0
            rsRateX10 := (rsTicks * RATE_X10_SCALE) / rsWinMs
    rsLate := instLate
    rsSkipped := instSkipped
    rsClamps := instClamps
    rsHwSkip := instHwSkip[slotIdx]

PRI predictX10(motorIncre) : predX10
' C-1's predicted hall ticks per second x10 for an increment (design sec 3.2), signed like the increment.
'
' @param motorIncre - signed increment
' @returns predX10 - (|incre| / PRED_INCRE_DIV) x PRED_MUL / PRED_DIV, with the increment's sign

    predX10 := ((abs(motorIncre) / PRED_INCRE_DIV) * PRED_MUL) / PRED_DIV
    if motorIncre < 0
        predX10 := 0 - predX10

PRI foldIdleWheel(slotIdx, bIdleUp)
' Fold one motor-frame capture into R14-DUAL-IDLEFLT-A: one capture on this motor, and whether any of its
' samples showed the idle wheel up (bCaptureIdleUp()).
'
' @param slotIdx - motor slot under test
' @param bIdleUp - TRUE when any sample of the capture showed the idle wheel up

    sfFrameCaps[slotIdx] := (sfFrameCaps[slotIdx] + 1) <# LIM_BIG
    if bIdleUp
        sfIdleUp[slotIdx] := (sfIdleUp[slotIdx] + 1) <# LIM_BIG

PRI foldIntegrity(slotIdx, nMissed, nIllegal)
' Fold integrity counts into R14-DUAL-INTEG-A. Each count is clamped before abs() so a corrupt count
' still adds and abs() never sees NEGX; the sum saturates at LIM_BIG (scan addIntegritySum()).
'
' @param slotIdx - motor slot
' @param nMissed - missed hall transitions
' @param nIllegal - illegal hall codes

    sfIntegSum[slotIdx] := (sfIntegSum[slotIdx] + abs((nMissed #> (0 - LIM_MID)) <# LIM_MID) + abs((nIllegal #> (0 - LIM_MID)) <# LIM_MID)) <# LIM_BIG

PRI nextTraceId() : tid
' Allocate a run-wide trace id and make it the current one (BM-ABORT context).
'
' @returns tid - 1, 2, 3 ...

    traceSeq := (traceSeq + 1) <# LIM_SMALL
    tid := traceSeq
    curTid := tid

PRI nextRungId() : rid
' Allocate a run-wide rung id.
'
' @returns rid - 1, 2, 3 ...

    rungSeq := (rungSeq + 1) <# LIM_SMALL
    rid := rungSeq

PRI segWhy() : whyCode
' The BM-SEG END why of a segment body: ABORTED once the run has aborted, else NONE.
'
' @returns whyCode - WHY_ABORTED or WHY_NONE

    whyCode := bRunAborted ? WHY_ABORTED : WHY_NONE

PRI safeWhy(safeEvent) : whyCode
' The why token of a safety event that ended a trial before its event.
'
' @param safeEvent - SAFE_* value
' @returns whyCode - FAULTED, ABORTED, INST_STALLED, OPERATOR_STOP, or NONE for SAFE_NONE

    case safeEvent
        SAFE_FAULT:
            whyCode := WHY_FAULTED
        SAFE_ABS_ABORT:
            whyCode := WHY_ABORTED
        SAFE_INST_STALL:
            whyCode := WHY_INST_STALLED
        SAFE_OPER_STOP:
            whyCode := WHY_OPERATOR_STOP
        other:
            whyCode := WHY_NONE

PRI safeEnd(safeEvent) : endCode
' The BM-TRACE-END end token of a safety event that ended a capture.
'
' @param safeEvent - SAFE_* value (not SAFE_NONE)
' @returns endCode - TEND_FAULT for a fault, TEND_ABORT for an abort or a stalled instrument

    endCode := (safeEvent == SAFE_FAULT) ? TEND_FAULT : TEND_ABORT

PRI trialSkipWhy(seg, side, skipWhy) : whyCode
' Decide whether one wheel trial may run: a cause already known first, then the run caps, a retired
' motor (sec 4.2 step 4) and a driver cog that is not running.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param skipWhy - WHY_* already known, WHY_NONE when none
' @returns whyCode - WHY_NONE when the trial may run, else its cause

    whyCode := skipWhy
    if whyCode == WHY_NONE
        if bRunContinue(seg) == FALSE
            whyCode := WHY_ABORTED
        elseif bSlotRetired[side - SIDE_LEFT]
            whyCode := WHY_MOTOR_RETIRED
        elseif isWheelUp(side) == FALSE
            whyCode := WHY_NO_COG

PRI traceCaptureMs(decimation) : captureMs
' The post-mark capture bound: the samples TRACE_MAX_SAMPLES leaves after TRACE_PRE_SAMPLES and the
' freeze margin, as ms at a decimation. A capture held to it never drops samples, and its mark stays in
' the ring (the ring holds TRACE_MAX_SAMPLES plus the margin), so R14-DUAL-TRACES-* cannot fail on it.
'
' @param decimation - samples stored one in this many
' @returns captureMs - the longest post-mark capture, ms

    captureMs := ((TRACE_MAX_SAMPLES - TRACE_PRE_SAMPLES - TRACE_FREEZE_MARGIN) * decimation * MS_PER_SEC) / INST_RATE_HZ

PRI bCaptureIdleUp(otherIdx) : bIdleUp | sampleIdx
' Report whether any sample of the frozen capture showed the idle wheel's driver up (R14-DUAL-IDLEFLT-A).
' Legal only while the instrument is FROZEN (I10).
'
' @param otherIdx - the idle motor slot
' @returns bIdleUp - TRUE when any stored sample has the idle wheel up
'
' @local sampleIdx - logical index

    drainBegin()
    bIdleUp := FALSE
    if drStored > 0
        repeat sampleIdx from 0 to drStored - 1
            beat(CP_LOOP_DRAIN)
            if bSmpUp(sampleIdx, otherIdx)
                bIdleUp := TRUE
                quit

PRI cpReset()
' Clear the trace capture staging before a trial.

    cpWhy := WHY_NONE
    cpEnd := TEND_TIMEOUT
    bCpFrozen := FALSE
    bCpFaultSeen := FALSE
    cpWantNeg := 0
    cpWantPos := 0
    bCpOffWritten := FALSE
    bCpOffRestored := FALSE
    bCpEstopSet := FALSE

PRI traceEmptyEnd(tid, endCode, whyCode)
' BM-TRACE-END for a trace with no drainable capture (skipped, or never frozen so never drained, I10):
' every drain field is reset so nothing stale prints, and why names the cause. Not folded into TRACES.
'
' @param tid - trace id
' @param endCode - TEND_* value
' @param whyCode - WHY_* naming why nothing was captured

    drStored := 0
    drLostHead := 0
    drDropped := 0
    drStartJ := 0
    drEndJ := -1
    drMarkJ := 0
    bDrMarkFound := FALSE
    drRestK := 0
    bDrRestFound := FALSE
    drIgSum := 0
    drOIgSum := 0
    drHwSkip := 0
    trLines := 0
    trKSum := 0
    trStride := 1
    emitTraceEnd(tid, endCode, whyCode)

PRI traceSkip(tid, seg, side, causeCode, motorIncre, reqMode, rampInc, whyCode)
' Emit a wheel trace that did not run: its header (offsets from cpWantNeg / cpWantPos) and an empty end
' whose why names the cause, so the analyser sees every planned trace.
'
' @param tid - trace id
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param causeCode - CAUSE_* the trace would have done
' @param motorIncre - signed increment
' @param reqMode - MODE_* requested
' @param rampInc - ramp_inc read back
' @param whyCode - WHY_* naming why it did not run

    emitTrace(tid, seg, side, causeCode, motorIncre, cpWantNeg, cpWantPos, reqMode, rampInc, WHY_NONE)
    traceEmptyEnd(tid, TEND_ABORT, whyCode)

PRI traceEmitCapture(seg, side, tid, causeCode, motorIncre, reqMode, rampInc) | slotIdx, otherIdx
' Finish a wheel trace's capture. First every side effect the trial created is undone and read back
' (I11: offsets with BM-OFFREST, the e-stop, the brake request, I6); only then BM-TRACE, and BM-TS /
' BM-TRACE-END from the frozen ring, folded into R14-DUAL-TRACES-* and R14-DUAL-IDLEFLT-A. An unfrozen
' capture is never drained (I10): its end is empty with why from cpWhy.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param tid - trace id
' @param causeCode - CAUSE_* done
' @param motorIncre - signed increment
' @param reqMode - MODE_* requested
' @param rampInc - ramp_inc read back
'
' @local slotIdx - motor slot
' @local otherIdx - the idle motor slot

    slotIdx := side - SIDE_LEFT
    otherIdx := SLOT_RIGHT - slotIdx
    if bCpOffWritten and (bCpOffRestored == FALSE)
        bRestoreOffsets(side, cpWantNeg, cpWantPos)
        bCpOffRestored := TRUE
    if bCpEstopSet
        restoreEmergency(side)
        bCpEstopSet := FALSE
    if bBrakeRequested[slotIdx]
        restoreStopMode(side)
    emitTrace(tid, seg, side, causeCode, motorIncre, cpWantNeg, cpWantPos, reqMode, rampInc, cpWhy)
    if bCpFrozen
        bTraceDrain(tid, slotIdx, otherIdx, cpEnd)
        foldIdleWheel(slotIdx, bCaptureIdleUp(otherIdx))
        sfIdleMoveMax[slotIdx] #>= trIdleMove               ' IDLEMOVE (task 3572): bTraceDrain() measured it
        sfIdleMoveN[slotIdx] := (sfIdleMoveN[slotIdx] + 1) <# LIM_SMALL
    else
        traceEmptyEnd(tid, cpEnd, (cpWhy == WHY_NONE) ? WHY_INST_NOACK : cpWhy)

PRI traceRecover(seg, side, tid, motorIncre, coolMs) : rstCode, rstMs | slotIdx, uncBefore, startMs, bFaultNow, bCleared
' Close a wheel trial after its restores and records (sec 4.2): when a fault was seen, or the fault flag
' is set now, recover it (testResetFault() alone, then restart, then retire) and cool coolMs; then zero
' and wait stopped.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param tid - trace id of the trial
' @param motorIncre - the trial's command
' @param coolMs - cool-down after a fault
' @returns rstCode - RST_NONE (no fault), RST_RESET, RST_RESTART or RST_FAILED
' @returns rstMs - ms the recovery took, cool-down excluded
'
' @local slotIdx - motor slot
' @local uncBefore - R14-DUAL-RSTPROV count before the recovery (a change means step 2 did not clear)
' @local startMs - getms() before the recovery
' @local bFaultNow - the fault flag after the restores
' @local bCleared - bRecoverFault()'s result

    slotIdx := side - SIDE_LEFT
    rstCode := RST_NONE
    rstMs := 0
    bFaultNow := FALSE
    if isWheelUp(side)
        _, _, bFaultNow := wheelClearedState(side)
    if bCpFaultSeen or (bFaultNow <> FALSE)
        uncBefore := sfResetUncleared[slotIdx]
        startMs := getms()
        bCleared := bRecoverFault(seg, tid, side, motorIncre, 0)
        rstMs := getms() - startMs
        if bCleared == FALSE
            rstCode := RST_FAILED
        elseif sfResetUncleared[slotIdx] == uncBefore
            rstCode := RST_RESET
        else
            rstCode := RST_RESTART
        waitBeat(coolMs, CP_LOOP_COOL)
    bZeroAndWaitStopped(side)

CON { --- wheel and steering wrappers: every library call is bracketed by beat(CP_LIB_*) --- }

PRI bWheelStart(seg, side) : bStarted | slotIdx, cogValue, startMs, restMs, nMissed, nIllegal
' Start one wheel alone and record its lifetime: refuse unless the instrument is IDLE or FROZEN (I10);
' stop the steering object and both wheels first (I6, shared pin claims PL-18); keep starts at least
' START_SPACING_MS apart; start with board detection never forced (I12); wait ready; read the cog,
' board, offsets and integrity counts; take this lifetime's floated zero-command sense mean through
' the instrument; emit BM-START. A retired motor is not started.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bStarted - TRUE when the cog is valid and the driver reported ready
'
' @local slotIdx - motor slot
' @local cogValue - testGetMotorCog() after the start
' @local startMs - getms() after start(), for the ready wait
' @local restMs - spacing still owed before this start
' @local nMissed - missed transitions at start
' @local nIllegal - illegal codes at start

    slotIdx := side - SIDE_LEFT
    bStarted := FALSE
    stWhy := WHY_NONE
    if bInstQuiet() == FALSE
        instRefused(seg)
        stWhy := WHY_INST_BUSY
    elseif bSlotRetired[slotIdx]
        stWhy := WHY_MOTOR_RETIRED
    else
        steerStop()
        wheelStopRaw(SIDE_LEFT)
        wheelStopRaw(SIDE_RIGHT)
        restMs := START_SPACING_MS - (getms() - lastStartMs)
        if bAnyStart and (restMs > 0)
            waitBeat(restMs, CP_LOOP_REST)
        beat(CP_LIB_START)
        if side == SIDE_RIGHT
            benchLog.cogEventBegin()
            stCogRet := wheelR.start(RIGHT_TEST_BASE, TEST_VOLTAGE, TEST_DET_MODE)
            benchLog.cogEventEnd()
        else
            benchLog.cogEventBegin()
            stCogRet := wheelL.start(LEFT_TEST_BASE, TEST_VOLTAGE, TEST_DET_MODE)
            benchLog.cogEventEnd()
        beat(CP_LIB_START)
        lastStartMs := getms()
        bAnyStart := TRUE
        lifeSeq := (lifeSeq + 1) <# LIM_SMALL
        slotLife[slotIdx] := lifeSeq
        bBrakeRequested[slotIdx] := FALSE                   ' init() sets SM_FLOAT
        startMs := getms()
        repeat
            bStReady := isWheelReady(side)
            if bStReady or ((getms() - startMs) >= READY_TIMEOUT_MS)
                quit
            beat(CP_LOOP_READY)
            waitms(SAMPLE_MS)
        stReadyMs := getms() - startMs
        beat(CP_LIB_QUERY)
        if side == SIDE_RIGHT
            cogValue := wheelR.testGetMotorCog()
            stBoard := wheelR.getBoardType()
            nMissed, nIllegal := wheelR.getHallIntegrityCounts()
        else
            cogValue := wheelL.testGetMotorCog()
            stBoard := wheelL.getBoardType()
            nMissed, nIllegal := wheelL.getHallIntegrityCounts()
        beat(CP_LIB_QUERY)
        stOffNeg, stOffPos := wheelGetOffsets(side)
        stMissed := nMissed
        stIllegal := nIllegal
        bStCogOk := (stCogRet >= 0) and (stCogRet <= MAX_COG_ID) and (stCogRet == cogValue - 1)
        bStarted := bStCogOk and bStReady
        sfStarts[slotIdx] := (sfStarts[slotIdx] + 1) <# LIM_BIG
        if stBoard <> wheelL.REV_B
            sfNotRevb[slotIdx] := (sfNotRevb[slotIdx] + 1) <# LIM_BIG
        foldIntegrity(slotIdx, nMissed, nIllegal)
        bLifeZeroValid[slotIdx] := FALSE
        slotLastIncre[slotIdx] := 0                         ' R18.1: a new lifetime starts at rest
        if bStarted
            stWhy := lifetimeZero(side)
        else
            stWhy := WHY_NO_COG
        emitStart(seg, side)

PRI lifetimeZero(side) : whyCode | slotIdx, winStartTotal, winEndTotal
' Take this driver lifetime's floated zero-command sense_i and phase-sum means: ZERO_WINDOW_MS through
' the instrument (no getter in a timed wait, sec 2.8), valid only within this lifetime (PL-32). The
' window is delimited by two instrument-recorded ring totals (sec 12.7).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns whyCode - WHY_NONE, or the cause of the missing zero
'
' @local slotIdx - motor slot
' @local winStartTotal - ring total at the window start
' @local winEndTotal - ring total at the window end

    slotIdx := side - SIDE_LEFT
    whyCode := WHY_INST_NOACK
    if bInstArm(INST_SRC_WHEELS, 1)
        winStartTotal := instMarkIndex()
        waitWatched(side, ZERO_WINDOW_MS, CP_LOOP_ZERO, UNTIL_TIME)
        winEndTotal := instMarkIndex()
        if bInstFreeze(0)
            windowStats(slotIdx, SLOT_RIGHT - slotIdx, winStartTotal, winEndTotal)
            if rsN > 0
                lifeZeroX10[slotIdx] := rsIMeanX10
                lifePhX10[slotIdx] := rsPhMeanX10
                bLifeZeroValid[slotIdx] := TRUE
                whyCode := WHY_NONE
            else
                whyCode := WHY_NO_SAMPLES
        bInstIdle()

PRI instRefused(seg)
' Record a wrapper refusal because the instrument had not acknowledged IDLE or FROZEN (I10).
'
' @param seg - SEG_* in progress

    instBusyRefusals := (instBusyRefusals + 1) <# LIM_BIG
    emitSeg(seg, SEGEV_SKIP, bSegAttended(seg), 0, 0, 0, 0, WHY_INST_BUSY)

PRI wheelStop(side)
' Stop one wheel. The instrument is first returned to IDLE (I10). A stop is never refused: if the
' instrument does not acknowledge, the refusal is recorded and the wheel is stopped anyway, because
' stopping is the safe direction and a straddled sample is gated by up (I3).
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    if bInstQuiet() == FALSE
        bInstIdle()
        if bInstQuiet() == FALSE
            instRefused(curSeg)
    wheelStopRaw(side)

PRI wheelStopRaw(side)
' stop() one wheel (cogstop + pinclear, which floats it) and forget any brake request (I6).
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    beat(CP_LIB_STOP)
    if side == SIDE_RIGHT
        benchLog.cogEventBegin()
        wheelR.stop()
    else
        benchLog.cogEventBegin()
        wheelL.stop()
    beat(CP_LIB_STOP)
    bBrakeRequested[side - SIDE_LEFT] := FALSE

PRI wheelCommand(side, motorIncre) | safeIncre
' Command one wheel's raw increment. Nothing above LADDER_MAX_INCRE is ever sent.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
'
' @local safeIncre - the increment actually sent

    safeIncre := motorIncre
    if abs(motorIncre) > LADDER_MAX_INCRE
        safeIncre := 0
    curIncre := safeIncre
    beat(CP_LIB_COMMAND)
    if side == SIDE_RIGHT
        wheelR.testDriveAtMotorIncrement(safeIncre)
    else
        wheelL.testDriveAtMotorIncrement(safeIncre)
    beat(CP_LIB_COMMAND)

PRI wheelHold(side, bBrake)
' Request BRAKE or FLOAT at stop on the wheel under test only (I6); every exit path of a BRAKE trial
' calls restoreStopMode() before the next command.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param bBrake - TRUE for holdAtStop(TRUE)

    beat(CP_LIB_HOLD)
    if side == SIDE_RIGHT
        wheelR.holdAtStop(bBrake)
    else
        wheelL.holdAtStop(bBrake)
    beat(CP_LIB_HOLD)
    bBrakeRequested[side - SIDE_LEFT] := (bBrake <> FALSE)

PRI isWheelReady(side) : bReady
' isReady() of one wheel.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bReady - TRUE when its driver reports a state

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT                                   ' if/else, never `? :` -- PL-29, PL-76
        bReady := wheelR.isReady()
    else
        bReady := wheelL.isReady()
    beat(CP_LIB_QUERY)

PRI wheelGetOffsets(side) : offNeg, offPos
' Read back the applied commutation offsets (logged beside every wheel measurement).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns offNeg - offset_fwd degrees (negative increments)
' @returns offPos - offset_rev degrees (positive increments)

    beat(CP_LIB_OFFSETS)
    if side == SIDE_RIGHT
        offNeg, offPos := wheelR.testGetFwdRevIndep()
    else
        offNeg, offPos := wheelL.testGetFwdRevIndep()
    beat(CP_LIB_OFFSETS)

PRI wheelIntegrity(side) : nMissed, nIllegal
' Hall integrity counts of one wheel since its start.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns nMissed - missed transitions
' @returns nIllegal - illegal codes

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        nMissed, nIllegal := wheelR.getHallIntegrityCounts()
    else
        nMissed, nIllegal := wheelL.getHallIntegrityCounts()
    beat(CP_LIB_QUERY)

PRI wheelClearedState(side) : bCleared, eDrvrState, bFaultSig
' Recovery's cleared test (design sec 4.2): isStopped() AND NOT isFaultSignal().
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bCleared - stopped and not faulted
' @returns eDrvrState - DCS_* now
' @returns bFaultSig - the fault flag now

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        bCleared := wheelR.isStopped()
        bFaultSig := wheelR.isFaultSignal()
        eDrvrState := wheelR.getDriverState()
    else
        bCleared := wheelL.isStopped()
        bFaultSig := wheelL.isFaultSignal()
        eDrvrState := wheelL.getDriverState()
    beat(CP_LIB_QUERY)
    bCleared := (bCleared <> FALSE) and (bFaultSig == FALSE)

PRI isWheelUp(side) : bUp
' Report whether a wheel's driver cog is running (testGetMotorCog() <> 0, the I3 gate).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bUp - TRUE when the driver cog runs

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT                                   ' if/else, never `? :` -- PL-29, PL-76
        bUp := wheelR.testGetMotorCog() <> 0
    else
        bUp := wheelL.testGetMotorCog() <> 0
    beat(CP_LIB_QUERY)

PRI wheelStopMotor(side)
' stopMotor() one wheel: the zero command, under whatever stop mode was requested.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    curIncre := 0
    beat(CP_LIB_COMMAND)
    if side == SIDE_RIGHT
        wheelR.stopMotor()
    else
        wheelL.stopMotor()
    beat(CP_LIB_COMMAND)

PRI wheelEstop(side)
' emergencyCutoff() one wheel. Every caller clears it with restoreEmergency() after its freeze (I11).
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    curIncre := 0
    beat(CP_LIB_ESTOP)
    if side == SIDE_RIGHT
        wheelR.emergencyCutoff()
    else
        wheelL.emergencyCutoff()
    beat(CP_LIB_ESTOP)

PRI wheelRampInc(side) : incRamp
' Read back one wheel's ramp_inc.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns incRamp - ramp_inc read back

    beat(CP_LIB_RAMP)
    if side == SIDE_RIGHT
        _, _, incRamp, _ := wheelR.getRampingValues()
    else
        _, _, incRamp, _ := wheelL.getRampingValues()
    beat(CP_LIB_RAMP)

PRI wheelSetRamp(side, incWant) : incReadBack
' Set a FAULTB trial's ramp (the defaults with ramp_inc replaced) and read ramp_inc back. Every caller
' restores the defaults with bRestoreRamp() after its freeze (I11).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param incWant - the trial's ramp_inc
' @returns incReadBack - ramp_inc read back

    beat(CP_LIB_RAMP)
    if side == SIDE_RIGHT
        wheelR.setRampingValues(RAMP_DEF_MIN, RAMP_DEF_MAX, incWant, RAMP_DEF_DOWN)
        _, _, incReadBack, _ := wheelR.getRampingValues()
    else
        wheelL.setRampingValues(RAMP_DEF_MIN, RAMP_DEF_MAX, incWant, RAMP_DEF_DOWN)
        _, _, incReadBack, _ := wheelL.getRampingValues()
    beat(CP_LIB_RAMP)

PRI wheelSetOffsets(side, negDegrees, posDegrees)
' Write one wheel's commutation offsets (POSTFLT's fault-provoking write). The pair read before it is
' restored and read back with bRestoreOffsets() on every exit path (I11).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param negDegrees - offset_fwd degrees (negative increments)
' @param posDegrees - offset_rev degrees (positive increments)

    beat(CP_LIB_OFFSETS)
    if side == SIDE_RIGHT
        wheelR.testSetFwdRevIndep(negDegrees, posDegrees)
    else
        wheelL.testSetFwdRevIndep(negDegrees, posDegrees)
    beat(CP_LIB_OFFSETS)

PRI wheelCurrent(side) : ampsX10k
' getCurrent() of one wheel (debug-free, the only library call inside a ladder window).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns ampsX10k - motor current, A x 10_000

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        ampsX10k, _ := wheelR.getCurrent()
    else
        ampsX10k, _ := wheelL.getCurrent()
    beat(CP_LIB_QUERY)

PRI bWheelDerated(side) : bDeratedNow
' Whether one wheel's fold-back currently holds the continuous limit rather than the peak one.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bDeratedNow - T/F where T means the front cog has derated this motor's limit

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        _, _, bDeratedNow, _, _ := wheelR.testGetCurrentLimitState()
    else
        _, _, bDeratedNow, _, _ := wheelL.testGetCurrentLimitState()
    beat(CP_LIB_QUERY)

PRI wheelDriveConstants(side) : deadGap, dutyMax, adcFrame, frameCnt
' The drive constants init() derived for one wheel (testGetDriveConstants()).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns deadGap - dead_gap, system ticks
' @returns dutyMax - duty_max, 1/16ths
' @returns adcFrame - adc_fram
' @returns frameCnt - frame_cnt

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        deadGap, _, _, dutyMax, adcFrame, frameCnt := wheelR.testGetDriveConstants()
    else
        deadGap, _, _, dutyMax, adcFrame, frameCnt := wheelL.testGetDriveConstants()
    beat(CP_LIB_QUERY)

PRI wheelDriveHealth(side) : nLagHeld, nDutyCapped, nDrvIncr
' The driver's two UNBOUNDED health counters for one wheel (testGetDriveHealth(), R18.1). Both count
' control passes since the driver started, so a rung's reading is a DIFFERENCE across its window, the
' way pos is; neither can top out, which is the whole point (PL-95: err is held near LAG_HOLD by the
' limiter and bounded by its own +-127, and duty saturates at duty_max -- so above mid-range both stop
' reporting exactly where the behaviour is).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns nLagHeld - passes on which the limiter withheld the field advance
' @returns nDutyCapped - passes on which the duty demand exceeded the cap
' @returns nDrvIncr - the field's increment per drive pass, so a withheld count converts to an advance

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT                                   ' if/else, never `? :` -- PL-29, PL-76
        nLagHeld, nDutyCapped, nDrvIncr, _ := wheelR.testGetDriveHealth()
    else
        nLagHeld, nDutyCapped, nDrvIncr, _ := wheelL.testGetDriveHealth()
    beat(CP_LIB_QUERY)

PRI wheelStartSense(side)
' startSenseCog() for one wheel (LIVE: testGetRpm() needs it). Its debug is compiled out in the quiet
' build (I5), and the wheel's stop() ends it.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    beat(CP_LIB_START)
    if side == SIDE_RIGHT
        wheelR.startSenseCog()
    else
        wheelL.startSenseCog()
    beat(CP_LIB_START)

PRI wheelRpm(side) : rpmRead
' testGetRpm() of one wheel.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns rpmRead - rpm averaged over the ~1 s window

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT                                   ' if/else, never `? :` -- PL-29, PL-76
        rpmRead := wheelR.testGetRpm()
    else
        rpmRead := wheelL.testGetRpm()
    beat(CP_LIB_QUERY)

PRI bZeroAndWaitStopped(side) : bStopped | bArmedHere
' Command zero to a running wheel and wait, beat-polled, for DCS_STOPPED. The mirror is current only
' while the instrument is not IDLE, so an IDLE instrument is armed for the wait and frozen after it
' (callers drain before calling this). A wheel whose driver cog is not running is left alone.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bStopped - TRUE when the mirror showed DCS_STOPPED within STOP_TIMEOUT_MS
'
' @local bArmedHere - this call armed the instrument, so it freezes it

    bStopped := FALSE
    if isWheelUp(side)
        wheelCommand(side, 0)
        bArmedHere := FALSE
        if bInstQuiet() and (instState == INST_ST_IDLE)
            bArmedHere := bInstArm(INST_SRC_WHEELS, 1)
        _, bStopped := waitWatched(side, STOP_TIMEOUT_MS, CP_LOOP_STOPPED, UNTIL_STOPPED)
        if bArmedHere
            bInstFreeze(0)

PRI bSteerStart(seg) : bStarted | startMs, restMs, leftMissed, leftIllegal, rightMissed, rightIllegal
' Start the steering object: refuse unless the instrument is IDLE or FROZEN (I10); stop both wheel
' instances first (shared pin claims, PL-18); detection never forced (I12); wait ready; read both
' drivers' states, offsets, integrity counts and detected boards (testGetBoardTypes(), sec 12.1 Q8);
' set holdAtStop(FALSE); emit BM-SSTART. The steering start's life is the sid its records carry.
'
' @param seg - SEG_* in progress
' @returns bStarted - TRUE when start() returned a cog id and both drivers reported ready
'
' @local startMs - getms() after start(), for the ready wait
' @local restMs - spacing still owed before this start
' @local leftMissed - left missed transitions
' @local leftIllegal - left illegal codes
' @local rightMissed - right missed transitions
' @local rightIllegal - right illegal codes

    bStarted := FALSE
    ssWhy := WHY_NONE
    if bInstQuiet() == FALSE
        instRefused(seg)
    else
        wheelStopRaw(SIDE_LEFT)
        wheelStopRaw(SIDE_RIGHT)
        restMs := START_SPACING_MS - (getms() - lastStartMs)
        if bAnyStart and (restMs > 0)
            waitBeat(restMs, CP_LOOP_REST)
        beat(CP_LIB_STEER_START)
        benchLog.cogEventBegin()
        ssRet := steering.start(LEFT_TEST_BASE, RIGHT_TEST_BASE, TEST_VOLTAGE, TEST_DET_MODE, TEST_DET_MODE)
        benchLog.cogEventEnd()
        beat(CP_LIB_STEER_START)
        lastStartMs := getms()
        bAnyStart := TRUE
        lifeSeq := (lifeSeq + 1) <# LIM_SMALL
        steerLife := lifeSeq
        bSsRetOk := (ssRet >= 0) and (ssRet <= MAX_COG_ID)
        bSteerUp := (ssRet >= 0)
        startMs := getms()
        repeat
            beat(CP_LIB_STEER_QUERY)
            bStarted := steering.isReady()
            beat(CP_LIB_STEER_QUERY)
            if bStarted or ((getms() - startMs) >= READY_TIMEOUT_MS)
                quit
            beat(CP_LOOP_READY)
            waitms(SAMPLE_MS)
        ssReadyMs := getms() - startMs
        beat(CP_LIB_STEER_QUERY)
        ssLeftState, ssRightState := steering.testGetDriverState()
        ssLeftNeg, ssLeftPos := steering.testLeftGetFwdRevIndep()
        ssRightNeg, ssRightPos := steering.testRightGetFwdRevIndep()
        leftMissed, leftIllegal, rightMissed, rightIllegal := steering.getHallIntegrityCounts()
        ssLeftBoard, ssRightBoard := steering.testGetBoardTypes()
        beat(CP_LIB_STEER_QUERY)
        ssLeftIg := leftMissed + leftIllegal
        ssRightIg := rightMissed + rightIllegal
        bStarted := bSsRetOk and (bStarted <> FALSE)
        if bSteerUp
            steerHold(FALSE)
        emitSStart(seg)

PRI steerStop()
' Stop the steering object (both drivers and its sense cog), returning the instrument to IDLE first
' (I10). Like wheelStop(), never refused.

    if bInstQuiet() == FALSE
        bInstIdle()
        if bInstQuiet() == FALSE
            instRefused(curSeg)
    beat(CP_LIB_STEER_STOP)
    benchLog.cogEventBegin()
    steering.stop()
    beat(CP_LIB_STEER_STOP)
    bSteerUp := FALSE

PRI steerHold(bBrake)
' holdAtStop() on both steering wheels; steering segments set FALSE at start (I6).
'
' @param bBrake - TRUE for holdAtStop(TRUE)

    beat(CP_LIB_HOLD)
    steering.holdAtStop(bBrake)
    beat(CP_LIB_HOLD)

PRI steerTrackTicks() : leftTicks, rightTicks
' The steering object's own tracking count, in hall ticks, per wheel.
'
' @returns leftTicks - left getRotationCount(DRU_HALL_TICKS)
' @returns rightTicks - right getRotationCount(DRU_HALL_TICKS)

    beat(CP_LIB_STEER_QUERY)
    leftTicks, rightTicks := steering.getRotationCount(steering.DRU_HALL_TICKS)
    beat(CP_LIB_STEER_QUERY)

PRI steerStopMotors()
' stopMotors() on the steering object (no sync wait, so no SYNC_PRECOND check is owed).

    curIncre := 0
    beat(CP_LIB_STEER_STOP)
    steering.stopMotors()
    beat(CP_LIB_STEER_STOP)

PRI bSteerDriveBoth(seg, tid, powerValue) : bDriven
' driveAtPower(powerValue, powerValue) on the steering object, always preceded by the SYNC_PRECOND check
' (design sec 4.3): a driver in DCS_ESTOP would hang the call's SyncStatus() wait. A failed check emits
' BM-ABORT SYNC_PRECOND and drives nothing; a stopped steering object is never driven.
'
' @param seg - SEG_* in progress
' @param tid - trace id in progress, 0 when none
' @param powerValue - power [-100..100] for both wheels
' @returns bDriven - TRUE when the drive call was made

    bDriven := FALSE
    if bSteerUp
        if bSteerDrivePrecondition(seg, tid)
            curIncre := 0
            beat(CP_LIB_STEER_DRIVE)
            steering.driveAtPower(powerValue, powerValue)
            beat(CP_LIB_STEER_DRIVE)
            bDriven := TRUE

PRI steerRecoverFault(tid) : whyCode | slotIdx, side, startMs, bLtFlt, bLtSig, bRtFlt, bRtSig, eLeftState, eRightState, eDrvrState, bFaultSig, bCleared, offNeg, offPos
' Recover a steering-segment fault per motor through the TEST-USE pass-throughs (sec 4.2 step 2:
' testResetFault() alone, which issues the zero command itself). The steering object has no per-wheel
' restart, so a fault reset does not clear is BM-UNRECOV MOTOR_RETIRED and ends the segment's trials.
' Folds R14-DUAL-RSTPROV-* and cools FAULT_COOL_MS after any fault.
'
' @param tid - trace id of the trial
' @returns whyCode - WHY_MOTOR_RETIRED when a fault stayed uncleared, else WHY_NONE
'
' @local slotIdx - motor slot
' @local side - SIDE_LEFT or SIDE_RIGHT
' @local startMs - getms() before the reset
' @local bLtFlt - left isFaulted()
' @local bLtSig - left isFaultSignal()
' @local bRtFlt - right isFaulted()
' @local bRtSig - right isFaultSignal()
' @local eLeftState - left driver state after the reset
' @local eRightState - right driver state after the reset
' @local eDrvrState - this motor's driver state after the reset
' @local bFaultSig - this motor's fault flag
' @local bCleared - stopped and not faulted after the reset
' @local offNeg - offset_fwd read back
' @local offPos - offset_rev read back

    whyCode := WHY_NONE
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        beat(CP_LOOP_POLL)
        side := SIDE_LEFT + slotIdx
        beat(CP_LIB_STEER_QUERY)
        bLtFlt, bLtSig, bRtFlt, bRtSig := steering.testGetFaultStatus()
        beat(CP_LIB_STEER_QUERY)
        bFaultSig := (slotIdx == SLOT_RIGHT) ? (bRtFlt or bRtSig) : (bLtFlt or bLtSig)
        if bFaultSig
            runFaults := (runFaults + 1) <# LIM_BIG
            segFaults := (segFaults + 1) <# LIM_SMALL
            sfFaults[slotIdx] := (sfFaults[slotIdx] + 1) <# LIM_BIG
            startMs := getms()
            beat(CP_LIB_RESETFAULT)
            if slotIdx == SLOT_RIGHT
                steering.testRightResetFault()
            else
                steering.testLeftResetFault()
            beat(CP_LIB_RESETFAULT)
            beat(CP_LIB_STEER_QUERY)
            eLeftState, eRightState := steering.testGetDriverState()
            bLtFlt, bLtSig, bRtFlt, bRtSig := steering.testGetFaultStatus()
            if slotIdx == SLOT_RIGHT
                offNeg, offPos := steering.testRightGetFwdRevIndep()
            else
                offNeg, offPos := steering.testLeftGetFwdRevIndep()
            beat(CP_LIB_STEER_QUERY)
            eDrvrState := (slotIdx == SLOT_RIGHT) ? eRightState : eLeftState
            bFaultSig := (slotIdx == SLOT_RIGHT) ? bRtSig : bLtSig
            bCleared := (eDrvrState == DCS_STOPPED) and (bFaultSig == FALSE)
            emitRecover(curSeg, tid, side, 0, offNeg, offPos, RSTEP_RESET, bCleared, getms() - startMs, eDrvrState, bFaultSig)
            if bCleared == FALSE
                sfResetUncleared[slotIdx] := (sfResetUncleared[slotIdx] + 1) <# LIM_BIG
                unrecovTotal := (unrecovTotal + 1) <# LIM_TINY
                segUnrecov := (segUnrecov + 1) <# LIM_TINY
                emitUnrecov(curSeg, tid, side, 0, offNeg, offPos, eDrvrState, bFaultSig, eDrvrState <> DCS_UNKNOWN)
                whyCode := WHY_MOTOR_RETIRED
            waitBeat(FAULT_COOL_MS, CP_LOOP_COOL)

PRI bSteerDrivePrecondition(seg, tid) : bOk | eLeftState, eRightState
' The SYNC_PRECOND construction (design sec 4.3): both drivers up and neither in DCS_ESTOP, else BM-ABORT
' SYNC_PRECOND and the caller does not call.
'
' WHY IT IS STILL HERE, NOW THAT THE HANG IT GUARDED IS GONE. Before task 3513, steering.driveAtPower()
' ended in an unbounded SyncStatus() wait that never returned while a driver sat in DCS_ESTOP -- one
' e-stopped wheel could hang cog 0 for the rest of the run. The front cog now owns the ATN and the wait,
' and a caller waits only the bounded request round trip, so the hang cannot recur. The check is kept
' because a measuring trial that begins with an e-stopped driver is measuring the wrong thing, and it
' says so in a record instead of quietly producing a trial with no motion. The one place it is
' deliberately NOT used is dDrive(), where the refusal is the measurement (DST_ESTOP_REFUSE).
'
' @param seg - SEG_* in progress
' @param tid - trace id in progress, 0 when none
' @returns bOk - TRUE when the drive call may be made
'
' @local eLeftState - left driver state
' @local eRightState - right driver state

    beat(CP_LIB_STEER_QUERY)
    eLeftState, eRightState := steering.testGetDriverState()
    beat(CP_LIB_STEER_QUERY)
    bOk := (eLeftState <> DCS_UNKNOWN) and (eRightState <> DCS_UNKNOWN) and (eLeftState <> DCS_ESTOP) and (eRightState <> DCS_ESTOP)
    if bOk == FALSE
        emitAbort(seg, tid, SIDE_BOTH, 0, ABR_SYNC_PRECOND, (eLeftState * X10) + eRightState, SCOPE_TRIAL)

PRI shutdownAll()
' Stop the steering object and both wheels unconditionally at run end. stop() on a never-started
' instance touches no pin.

    beat(CP_LIB_STOP)
    benchLog.cogEventBegin()
    steering.stop()
    wheelL.stop()
    wheelR.stop()
    beat(CP_LIB_STOP)
    bSteerUp := FALSE

CON { --- recovery policy (design sec 4.2) and side-effect restores (I11) --- }

PRI bRecoverFault(seg, tid, side, motorIncre, coolMs) : bCleared | slotIdx, startMs, offNeg, offPos, eDrvrState, bFaultSig, bUp
' Recover a faulted wheel in-session. Step 2: testResetFault() alone (it issues the zero command
' itself). Step 3, if not cleared: stop, rest RESTART_REST_MS, start, wait ready. Step 4, if still not
' cleared: BM-UNRECOV MOTOR_RETIRED; that motor's remaining trials in this load are skipped; the run
' continues. Then the cool-down, beat-polled. Callers restore every trial side effect BEFORE calling.
'
' @param seg - SEG_* in progress
' @param tid - trace id of the faulted trial, 0 when none
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - the faulted command
' @param coolMs - FAULT_COOL_MS, or FAULT_TRIAL_COOL_MS for FAULTB
' @returns bCleared - TRUE when step 2 or step 3 cleared the fault
'
' @local slotIdx - motor slot
' @local startMs - getms() at the start of a step
' @local offNeg - offset_fwd read back
' @local offPos - offset_rev read back
' @local eDrvrState - driver state after a step
' @local bFaultSig - fault flag after a step
' @local bUp - the restart's start succeeded

    slotIdx := side - SIDE_LEFT
    slotLastIncre[slotIdx] := 0                             ' R18.1: recovery leaves the wheel at rest -- the next rung starts from there
    runFaults := (runFaults + 1) <# LIM_BIG
    segFaults := (segFaults + 1) <# LIM_SMALL
    sfFaults[slotIdx] := (sfFaults[slotIdx] + 1) <# LIM_BIG
    startMs := getms()
    beat(CP_LIB_RESETFAULT)
    if side == SIDE_RIGHT
        wheelR.testResetFault()
    else
        wheelL.testResetFault()
    beat(CP_LIB_RESETFAULT)
    bCleared, eDrvrState, bFaultSig := wheelClearedState(side)
    offNeg, offPos := wheelGetOffsets(side)
    emitRecover(seg, tid, side, motorIncre, offNeg, offPos, RSTEP_RESET, bCleared, getms() - startMs, eDrvrState, bFaultSig)
    if bCleared == FALSE
        sfResetUncleared[slotIdx] := (sfResetUncleared[slotIdx] + 1) <# LIM_BIG
        startMs := getms()
        wheelStop(side)
        waitBeat(RESTART_REST_MS, CP_LOOP_REST)
        bUp := bWheelStart(seg, side)
        bCleared, eDrvrState, bFaultSig := wheelClearedState(side)
        bCleared := bCleared and bUp
        offNeg, offPos := wheelGetOffsets(side)
        emitRecover(seg, tid, side, motorIncre, offNeg, offPos, RSTEP_RESTART, bCleared, getms() - startMs, eDrvrState, bFaultSig)
        if bCleared == FALSE
            bSlotRetired[slotIdx] := TRUE
            unrecovTotal := (unrecovTotal + 1) <# LIM_TINY
            segUnrecov := (segUnrecov + 1) <# LIM_TINY
            emitUnrecov(seg, tid, side, motorIncre, offNeg, offPos, eDrvrState, bFaultSig, bUp)
            wheelStop(side)
    waitBeat(coolMs, CP_LOOP_COOL)

PRI bRestoreRamp(side) : bOk | minRamp, maxRamp, incRamp, downRamp
' Restore the ramp defaults, read them back and emit BM-RAMPREST (I11). The last read-back of each
' motor is R14-DUAL-RAMPREST-B's measurement.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bOk - TRUE when 1_500 / 200_000 / 22 / 50_000 read back
'
' @local minRamp - ramp_min read back
' @local maxRamp - ramp_max read back
' @local incRamp - ramp_inc read back
' @local downRamp - ramp_down read back

    beat(CP_LIB_RAMP)
    if side == SIDE_RIGHT
        wheelR.setRampingValues(RAMP_DEF_MIN, RAMP_DEF_MAX, RAMP_DEF_INC, RAMP_DEF_DOWN)
        minRamp, maxRamp, incRamp, downRamp := wheelR.getRampingValues()
    else
        wheelL.setRampingValues(RAMP_DEF_MIN, RAMP_DEF_MAX, RAMP_DEF_INC, RAMP_DEF_DOWN)
        minRamp, maxRamp, incRamp, downRamp := wheelL.getRampingValues()
    beat(CP_LIB_RAMP)
    bOk := (minRamp == RAMP_DEF_MIN) and (maxRamp == RAMP_DEF_MAX) and (incRamp == RAMP_DEF_INC) and (downRamp == RAMP_DEF_DOWN)
    bSfRampRan[side - SIDE_LEFT] := TRUE
    bSfRampOk[side - SIDE_LEFT] := bOk
    emitRampRest(side, minRamp, maxRamp, incRamp, downRamp, bOk)

PRI bRestoreOffsets(side, wantNeg, wantPos) : bOk | offNeg, offPos
' Restore the offsets read at the trial's start, read them back and emit BM-OFFREST (I11). Every
' read-back of a motor is ANDed into R14-DUAL-OFFREST-C.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param wantNeg - offset_fwd degrees to restore
' @param wantPos - offset_rev degrees to restore
' @returns bOk - TRUE when both read back equal
'
' @local offNeg - offset_fwd read back
' @local offPos - offset_rev read back

    beat(CP_LIB_OFFSETS)
    if side == SIDE_RIGHT
        wheelR.testSetFwdRevIndep(wantNeg, wantPos)
    else
        wheelL.testSetFwdRevIndep(wantNeg, wantPos)
    beat(CP_LIB_OFFSETS)
    offNeg, offPos := wheelGetOffsets(side)
    bOk := (offNeg == wantNeg) and (offPos == wantPos)
    bSfOffRan[side - SIDE_LEFT] := TRUE
    bSfOffOk[side - SIDE_LEFT] := (bSfOffOk[side - SIDE_LEFT] <> FALSE) and bOk
    emitOffRest(side, wantNeg, wantPos, offNeg, offPos, bOk)

PRI restoreStopMode(side)
' Return the wheel under test to FLOAT at stop (I6, I11). The library has no stop-mode getter, so this
' restore cannot be read back; bBrakeRequested records that it was issued.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    wheelHold(side, FALSE)

PRI restoreEmergency(side)
' Clear an e-stop issued by a trial (I11). The library has no e_stop getter; the driver state leaving
' DCS_ESTOP on a later instrument sample is the evidence.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    beat(CP_LIB_ESTOP)
    if side == SIDE_RIGHT
        wheelR.clearEmergency()
    else
        wheelL.clearEmergency()
    beat(CP_LIB_ESTOP)

CON { --- record emission, cog 0 (design sec 3). Byte counts: each field is 2 + len(name) + width --- }

PRI recBegin(pTag)
' Start a BM- record: tag first, then the run-wide seq (I8).
'
' @param pTag - pointer to the record tag

    benchLog.begin(pTag)
    logSeq := (logSeq + 1) <# LIM_MID
    benchLog.numField(@"seq", logSeq, LIM_MID)

PRI emitRecord() | pRecord
' Emit the assembled record: the one cog-0 debug() statement in this file, bracketed by CP_EMIT.
'
' @local pRecord - pointer to the zero-terminated record

    pRecord := benchLog.pLine()
    beat(CP_EMIT)
    debug(zstr_(pRecord))
    beat(CP_EMIT)

PRI tokenAt(pTable, tokenCount, tokenIdx) : pTok | skipCount
' Look up a token in a packed zero-separated DAT table; an index outside the table returns "?".
' Reads only DAT, so it is safe from any cog.
'
' @param pTable - pointer to the packed table
' @param tokenCount - tokens in the table
' @param tokenIdx - 0-based token index
' @returns pTok - pointer to the token text
'
' @local skipCount - bytes skipped inside one token (bounded)

    pTok := @sUnknownTok
    if (tokenIdx >= 0) and (tokenIdx < tokenCount)
        pTok := pTable
        repeat tokenIdx
            repeat skipCount from 0 to TOKEN_SCAN_MAX
                if BYTE[pTok] == 0
                    quit
                pTok += 1
            pTok += 1

PRI whyField(whyCode)
' Append the why field (always last in a measurement record).
'
' @param whyCode - WHY_* value

    benchLog.tokenField(@"why", tokenAt(@tokWhy, WHY_COUNT, whyCode), TOKMAX_WHY)

PRI sideToken(side) : pTok
' Motor token for a side.
'
' @param side - SIDE_* value
' @returns pTok - NONE, LEFT, RIGHT or BOTH

    pTok := tokenAt(@tokSide, SIDE_BOTH + 1, side)

PRI segToken(seg) : pTok
' Segment token.
'
' @param seg - SEG_* value
' @returns pTok - segment token

    pTok := tokenAt(@tokSeg, SEG_COUNT, seg)

PRI dcsToken(eDrvrState) : pTok
' Driver-state token.
'
' @param eDrvrState - DCS_* value
' @returns pTok - state token, "?" outside 0..7

    pTok := tokenAt(@tokDcs, DCS_MAX + 1, eDrvrState)

PRI boardToken(eBoardRev) : pTok
' Board-revision token.
'
' @param eBoardRev - REV_* value
' @returns pTok - REV_A, REV_B or UNKNOWN

    if eBoardRev == wheelL.REV_A
        pTok := @sBoardRevA
    elseif eBoardRev == wheelL.REV_B
        pTok := @sBoardRevB
    else
        pTok := @sBoardUnknown

PRI statusToken(eStatus) : pTok
' getStatus() token for BM-OUT.
'
' @param eStatus - DS_* value
' @returns pTok - MOVING, HOLDING, OFF, FAULTED, ESTOP or UNKNOWN

    if eStatus == wheelL.DS_MOVING
        pTok := tokenAt(@tokStat, STAT_COUNT, STAT_MOVING)
    elseif eStatus == wheelL.DS_HOLDING
        pTok := tokenAt(@tokStat, STAT_COUNT, STAT_HOLDING)
    elseif eStatus == wheelL.DS_OFF
        pTok := tokenAt(@tokStat, STAT_COUNT, STAT_OFF)
    elseif eStatus == wheelL.DS_FAULTED
        pTok := tokenAt(@tokStat, STAT_COUNT, STAT_FAULTED)
    elseif eStatus == wheelL.DS_ESTOP
        pTok := tokenAt(@tokStat, STAT_COUNT, STAT_ESTOP)
    else
        pTok := tokenAt(@tokStat, STAT_COUNT, STAT_UNKNOWN)

PRI emitHeaderRecords() | orderIdx
' Emit the header before anything moves: BM-BANNER, BM-BUILD, one SIGNOFF-DECL per judged cell, one
' BM-PLAN per segment of this part, the BM-LADDER table when the part ladders, and the panic line.
'
' @local orderIdx - rung index

    emitBanner()
    emitBuild()
    emitSignoffDecls()
    case PART_ID
        PART_A:
            emitPlan(SEG_PREFLT, 1)
            emitPlan(SEG_STOPMODE, 2)
            emitPlan(SEG_LIVE, 3)
            emitPlan(SEG_LADDER, 4)
        PART_CLOCK:
            emitPlan(SEG_PREFLT, 1)
            emitPlan(SEG_CLOCK, 2)
        PART_B:
            emitPlan(SEG_PREFLT, 1)
            emitPlan(SEG_FAULTB, 2)
            emitPlan(SEG_OVERSHT, 3)
        PART_BRAKE:
            emitPlan(SEG_OUTSIDE, 1)
        PART_C:
            emitPlan(SEG_PREFLT, 1)
            emitPlan(SEG_BASELINE, 2)
            emitPlan(SEG_POSTFLT, 3)
        PART_D:
            emitPlan(SEG_PREFLT, 1)
            emitPlan(SEG_STEERSEG, 2)
            emitPlan(SEG_LIMIT, 3)
        PART_FLOOR:
            emitPlan(SEG_FLOOR, 1)
        PART_UICHECK:
            emitPlan(SEG_UICHECK, 1)
    if PART_ID == PART_A
        repeat orderIdx from 0 to LADDER_RUNGS - 1
            emitLadder(orderIdx)
    beat(CP_EMIT)
    debug(zstr_(@sPanicLine))
    beat(CP_EMIT)

PRI emitWdStart(bStarted, cogIdRead)
' BM-WDSTART: whether the watchdog cog started. Worst case 48 bytes.
'
' @param bStarted - TRUE when cogspin() returned a cog id
' @param cogIdRead - cogspin()'s raw return

    recBegin(@"BM-WDSTART")
    benchLog.boolField(@"started", bStarted)
    benchLog.numField(@"cog", cogIdRead, LIM_TINY)
    emitRecord()

PRI emitBanner()
' BM-BANNER. part and cfg_id come from #ifdef-selected constants; quiet, mdbg and sdbg print the
' compiled masks. Worst case 241 bytes (design sec 3.2's 256 less the removed cables field, 2+6+7).

    recBegin(@"BM-BANNER")
    benchLog.numField(@"src_rev", SRC_REV, LIM_SMALL)
    benchLog.numField(@"fmt", FMT_VERSION, LIM_SMALL)
    benchLog.tokenField(@"part", tokenAt(@tokPart, PART_COUNT, PART_ID), TOKMAX_PART)
#ifdef BENCH_CFG
    benchLog.tokenField(@"cfg_id", @sCfgBench, TOKMAX_CFG)
#else
    benchLog.tokenField(@"cfg_id", @sCfgUser, TOKMAX_CFG)
#endif
    benchLog.tokenField(@"frame", @sFrameMotor, TOKMAX_FRAME)
    benchLog.numField(@"clkfreq", CLKFREQ, LIM_BIG)
    benchLog.numField(@"left_base", LEFT_TEST_BASE, LIM_SMALL)
    benchLog.numField(@"right_base", RIGHT_TEST_BASE, LIM_SMALL)
    benchLog.numField(@"voltage_enum", TEST_VOLTAGE, LIM_SMALL)
    benchLog.numField(@"det_mode", TEST_DET_MODE, LIM_SMALL)
    benchLog.numField(@"motor_type", user.MOTOR_TYPE, LIM_SMALL)
    benchLog.boolField(@"quiet", bQuietMasks)
    benchLog.numField(@"mdbg", user.MOTOR_DBG_MASK, LIM_SMALL)
    benchLog.numField(@"sdbg", user.STEER_DBG_MASK, LIM_SMALL)
    emitRecord()

PRI emitBuild()
' BM-BUILD: the compiled instrument, limits and C-6 constants. Worst case 237 bytes.

    recBegin(@"BM-BUILD")
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.numField(@"inst_hz", INST_RATE_HZ, LIM_SMALL)
    benchLog.numField(@"inst_ticks", INST_PERIOD_TICKS, LIM_BIG)
    benchLog.numField(@"ring", INST_RING_SAMPLES, LIM_SMALL)
    benchLog.numField(@"slongs", INST_SAMPLE_LONGS, LIM_TINY)
    benchLog.numField(@"waitms_max", WAITMS_MAX_MS, LIM_SMALL)
    benchLog.numField(@"wd_stall_ms", WD_STALL_MS, LIM_SMALL)
    benchLog.numField(@"abs_abort_mV", ABS_ABORT_MV, LIM_SMALL)
    benchLog.numField(@"ladder_max", LADDER_MAX_INCRE, LIM_BIG)
    benchLog.numField(@"rwire_mohm", RWIRE_MOHM, LIM_SMALL)
    benchLog.numField(@"pack_mV", PACK_MV, LIM_SMALL)
    benchLog.numField(@"fault_cool_ms", FAULT_COOL_MS, LIM_SMALL)
    emitRecord()

PRI emitInst(eventCode, ackMs, bAckValid, whyCode)
' BM-INST: instrument lifecycle event with its run-wide counters. Worst case 198 bytes.
'
' @param eventCode - INST_EV_* value
' @param ackMs - ms the acknowledged command took
' @param bAckValid - TRUE when ackMs is a measurement
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-INST")
    benchLog.tokenField(@"event", tokenAt(@tokInstEv, INST_EV_COUNT, eventCode), TOKMAX_INSTEV)
    benchLog.naNumField(@"cog", instCogId, LIM_TINY, instCogId >= 0)
    benchLog.tokenField(@"state", tokenAt(@tokInstSt, INST_ST_COUNT, instState), TOKMAX_INSTST)
    benchLog.naNumField(@"ack_ms", ackMs, LIM_SMALL, bAckValid)
    benchLog.numField(@"samples", instRunSamples, LIM_BIG)
    benchLog.numField(@"late", instRunLate, LIM_BIG)
    benchLog.numField(@"skipped", instRunSkipped, LIM_BIG)
    benchLog.numField(@"max_late_us", instRunMaxLateTicks / TICKS_PER_US, LIM_MID)
    benchLog.numField(@"clamps", instRunClamps, LIM_MID)
    whyField(whyCode)
    emitRecord()

PRI emitPlan(seg, orderIdx) | bAttended, estS, estKb
' BM-PLAN: one segment of this load, its findings and its planned size (sec 12.4 est_kb).
' Worst case: 117 + est_kb(2+6+7=15) = 132 bytes.
'
' @param seg - SEG_* value
' @param orderIdx - 1-based position in this load
'
' @local bAttended - the segment needs a person
' @local estS - planned seconds (design sec 4.4)
' @local estKb - worst-case log KB: traces x (TRACE_EMIT_MAX x 241 B + headers) plus records

    bAttended := bSegAttended(seg)
    ' OVERSHT: the four distance trials plus the fault-API trial (task 3552) -- about 6 s of poll, the
    '  stop, and up to two FAULT_COOL_MS cool-downs. Its rows are BM-OUT, already counted in est_kb.
    ' STEERSEG and LIMIT (task 3560) print few records and no traces: their time is the steps' own holds
    ' R18.1: LADDER's walk went from 12 steps to LADDER_WALK_STEPS per motor and sign -- 38 x 4 = 152
    '  measured rungs against 48 -- and each rung now prints five records rather than four. Visit 6a
    '  MEASURED 119_523 ms and about 960 B per rung for the 48, so the walk is about 375 s and 180 KB;
    '  both figures are rounded up, as every other entry here is.
    estS := lookupz(seg: 0, 5, 540, 60, 420, 60, 420, 150, 120, 120, 120, 180, 120, 180, 180)
    estKb := lookupz(seg: 0, 2, 4_700, 3, 190, 8, 1_960, 420, 130, 16, 790, 1_180, 100, 4, 6)
    recBegin(@"BM-PLAN")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"order", orderIdx, LIM_TINY)
    benchLog.boolField(@"attended", bAttended)
    benchLog.tokenField(@"part", tokenAt(@tokPart, PART_COUNT, PART_ID), TOKMAX_PART)
    benchLog.tokenField(@"finds", tokenAt(@tokFinds, SEG_COUNT, seg), TOKMAX_FINDS)
    benchLog.numField(@"est_s", estS, LIM_SMALL)
    benchLog.numField(@"est_kb", estKb, LIM_SMALL)
    emitRecord()

PRI emitLadder(rungIdx) | motorIncre
' BM-LADDER: one row of the LADDER table. Worst case 85 bytes.
'
' @param rungIdx - 0-based rung
'
' @local motorIncre - the rung's increment

    motorIncre := ladderIncre[rungIdx]
    recBegin(@"BM-LADDER")
    benchLog.numField(@"rung", rungIdx, LIM_TINY)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"pred_x10", predictX10(motorIncre), LIM_MID)
    benchLog.boolField(@"probe", rungIdx >= LADDER_BASE_RUNGS)
    emitRecord()

PRI emitStart(seg, side) | slotIdx, bZero
' BM-START from the st* staging and this lifetime's zero. Worst case 264 bytes.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
'
' @local slotIdx - motor slot
' @local bZero - the lifetime zero is a measurement

    slotIdx := side - SIDE_LEFT
    bZero := bLifeZeroValid[slotIdx] <> FALSE
    recBegin(@"BM-START")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"life", slotLife[slotIdx], LIM_SMALL)
    benchLog.numField(@"cog_ret", stCogRet, LIM_TINY)
    benchLog.boolField(@"cog_ok", bStCogOk)
    benchLog.tokenField(@"board", boardToken(stBoard), TOKMAX_BOARD)
    benchLog.numField(@"board_enum", stBoard, LIM_TINY)
    benchLog.boolField(@"ready", bStReady)
    benchLog.numField(@"ready_ms", stReadyMs, LIM_SMALL)
    benchLog.numField(@"off_neg", stOffNeg, LIM_TINY)
    benchLog.numField(@"off_pos", stOffPos, LIM_TINY)
    benchLog.numField(@"missed", stMissed, LIM_SMALL)
    benchLog.numField(@"illegal", stIllegal, LIM_SMALL)
    benchLog.naNumField(@"zero_x10", lifeZeroX10[slotIdx], LIM_MID, bZero)
    benchLog.naNumField(@"ph_x10", lifePhX10[slotIdx], LIM_MID, bZero)
    whyField(bZero ? WHY_NONE : stWhy)
    emitRecord()

PRI emitSStart(seg)
' BM-SSTART from the ss* staging (sec 12.1 Q8: l_board / r_board replace board NA).
' Worst case: tag(9) + seq(15) + seg(13) + life(13) + motor(12) + ret(9) + ret_ok(13) + l_st(16) +
' r_st(16) + ready_ms(17) + l_neg(11) + l_pos(11) + r_neg(11) + r_pos(11) + l_ig(13) + r_ig(13) +
' l_board(16) + r_board(16) + why(23) = 258 bytes.
'
' @param seg - SEG_* in progress

    recBegin(@"BM-SSTART")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"life", steerLife, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(SIDE_BOTH), TOKMAX_MOTOR)
    benchLog.numField(@"ret", ssRet, LIM_TINY)
    benchLog.boolField(@"ret_ok", bSsRetOk)
    benchLog.tokenField(@"l_st", dcsToken(ssLeftState), TOKMAX_STATE)
    benchLog.tokenField(@"r_st", dcsToken(ssRightState), TOKMAX_STATE)
    benchLog.numField(@"ready_ms", ssReadyMs, LIM_SMALL)
    benchLog.numField(@"l_neg", ssLeftNeg, LIM_TINY)
    benchLog.numField(@"l_pos", ssLeftPos, LIM_TINY)
    benchLog.numField(@"r_neg", ssRightNeg, LIM_TINY)
    benchLog.numField(@"r_pos", ssRightPos, LIM_TINY)
    benchLog.numField(@"l_ig", ssLeftIg, LIM_SMALL)
    benchLog.numField(@"r_ig", ssRightIg, LIM_SMALL)
    benchLog.tokenField(@"l_board", boardToken(ssLeftBoard), TOKMAX_BOARD)
    benchLog.tokenField(@"r_board", boardToken(ssRightBoard), TOKMAX_BOARD)
    whyField(ssWhy)
    emitRecord()

PRI emitRung(seg, rid, rungIdx, side, motorIncre, resultCode, steadyMs, bSteadyValid, bWindowValid, whyCode)
' BM-RUNG from the caller's result and the rs* window statistics. Worst case 262 bytes.
'
' @param seg - SEG_* in progress
' @param rid - rung id from nextRungId()
' @param rungIdx - rung index into ladderIncre (or the segment's own rung number)
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param resultCode - RES_* value
' @param steadyMs - ms from command to AT_SPEED
' @param bSteadyValid - TRUE when steadyMs is a measurement
' @param bWindowValid - TRUE when the window statistics are a measurement
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-RUNG")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"life", slotLife[side - SIDE_LEFT], LIM_SMALL)
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.numField(@"rung", rungIdx, LIM_TINY)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.tokenField(@"result", tokenAt(@tokRes, RES_COUNT, resultCode), TOKMAX_RESULT)
    benchLog.numField(@"off_neg", rsOffNeg, LIM_TINY)
    benchLog.numField(@"off_pos", rsOffPos, LIM_TINY)
    benchLog.naNumField(@"steady_ms", steadyMs, LIM_SMALL, bSteadyValid)
    benchLog.naNumField(@"win_ms", rsWinMs, LIM_SMALL, bWindowValid)
    benchLog.naNumField(@"ticks", rsTicks, LIM_MID, bWindowValid)
    benchLog.naNumField(@"rate_x10", rsRateX10, LIM_MID, bWindowValid)
    benchLog.numField(@"pred_x10", predictX10(motorIncre), LIM_MID)
    whyField(whyCode)
    emitRecord()

PRI emitRung2(rid, side, motorIncre, dutyMax, bWindowValid, whyCode) | slotIdx, bZero
' BM-RUNG2: currents, phase sum and duty over the window; inet uses this lifetime's zero (PL-32).
' err / err_pk are the STEADY window's, opened after AT_SPEED and the settle: err_pk - err is the duty
' servo's ripple, never a transition kick (PL-87) -- BM-RUNGTR carries the transition. Worst case 269 bytes.
'
' @param rid - rung id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param dutyMax - duty_max from testGetDriveConstants()
' @param bWindowValid - TRUE when the window statistics are a measurement
' @param whyCode - WHY_* naming the cause of every NA
'
' @local slotIdx - motor slot
' @local bZero - this lifetime's zero is a measurement

    slotIdx := side - SIDE_LEFT
    bZero := bLifeZeroValid[slotIdx] <> FALSE
    recBegin(@"BM-RUNG2")
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.naNumField(@"zero_x10", lifeZeroX10[slotIdx], LIM_MID, bZero)
    benchLog.naNumField(@"i_x10", rsIMeanX10, LIM_MID, bWindowValid)
    benchLog.naNumField(@"inet_x10", rsIMeanX10 - lifeZeroX10[slotIdx], LIM_MID, bWindowValid and bZero)
    benchLog.naNumField(@"i_min", rsIMin, LIM_SMALL, bWindowValid)
    benchLog.naNumField(@"i_max", rsIMax, LIM_SMALL, bWindowValid)
    benchLog.naNumField(@"ph_x10", rsPhMeanX10, LIM_MID, bWindowValid)
    benchLog.naNumField(@"duty", rsDutyMean, LIM_SMALL, bWindowValid)
    benchLog.naNumField(@"duty_pk", rsDutyPk, LIM_SMALL, bWindowValid)
    benchLog.numField(@"duty_max", dutyMax, LIM_SMALL)
    benchLog.naNumField(@"err", rsErrMean, LIM_TINY, bWindowValid)
    benchLog.naNumField(@"err_pk", rsErrPk, LIM_TINY, bWindowValid)
    benchLog.numField(@"n", rsN, LIM_SMALL)
    whyField(whyCode)
    emitRecord()

PRI emitRungTransition(rid, side, motorIncre)
' The pair of records every measured rung's TRANSITION needs -- BM-RUNGTR and BM-RUNGHL -- as one call,
' so the two rung kinds that emit them (rungEmitAll() for LADDER and CLOCK, liveRung() for LIVE) cannot
' drift apart on what a transition is recorded as (R18.1).
'
' @param rid - rung id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment

    emitRungTr(rid, side, motorIncre)
    emitRungHl(rid, side, motorIncre)

PRI emitRungTr(rid, side, motorIncre) | whyCode
' BM-RUNGTR (PL-87): the rung's TRANSITION, from the command mark to the window start -- peak |err| and
' peak |i| over the ramp and settle, against the rung's own steady statistics.
'
' R18.1 (PL-95), two fields, and the second one is what the cell now judges:
'  from_incre - the speed the wheel was HOLDING when the command arrived, so the transition's delta and
'               its direction are read off the record. from_rest is DERIVED from it here rather than
'               passed in: it is the same fact, and two copies of one fact maintained by different code
'               paths are two copies that can drift (D7).
'  tr_i_over  - the transition current peak above this rung's own steady peak. tr_over is the same
'               comparison on err, and err is CLAMPED: the limiter holds it near LAG_HOLD, so tr_over
'               read 0 of 22 at Visit 6a while tr_i_pk rose seventy-five-fold on the same rungs
'               (PL-87's table). Current is not clamped, and it was being recorded the whole time.
'
' Worst case 219 bytes: tag(9) + seq(15) + rid(12) + motor(12) + incre(19) + from_incre(24) +
' from_rest(16) + tr_ms(14) + tr_err_pk(15) + tr_i_pk(16) + tr_i_over(18) + tr_over(13) + tr_n(13) +
' why(23).
'
' @param rid - rung id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
'
' @local whyCode - the rung's why when it did not run clean, else the transition's own

    whyCode := rgWhy
    if whyCode == WHY_NONE
        whyCode := trWhy
    recBegin(@"BM-RUNGTR")
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"from_incre", rgFromIncre, LIM_BIG)
    benchLog.boolField(@"from_rest", rgFromIncre == 0)
    benchLog.naNumField(@"tr_ms", trMs, LIM_SMALL, trWhy == WHY_NONE)
    benchLog.naNumField(@"tr_err_pk", trErrPk, LIM_TINY, trWhy == WHY_NONE)
    benchLog.naNumField(@"tr_i_pk", trIPk, LIM_SMALL, trWhy == WHY_NONE)
    benchLog.naNumField(@"tr_i_over", trIOver(), LIM_SMALL, bTrIOverValid())
    benchLog.naNumField(@"tr_over", trErrPk - rsErrPk, LIM_TINY, (trWhy == WHY_NONE) and bRgWindowValid)
    benchLog.numField(@"tr_n", trN, LIM_SMALL)
    whyField(whyCode)
    emitRecord()

PRI trIOver() : nOver
' tr_i_over: the transition current peak above this rung's own steady peak (R18.1). One derivation, read
' by the BM-RUNGTR field and by R17-DUAL-TRKICK-A, so the printed value and the judged value are the same
' value rather than two expressions that agree today. Only a measurement when bTrIOverValid().
'
' @returns nOver - transition peak |i| less the steady window's i_max, in sense mV

    nOver := trIPk - rsIMax

PRI bTrIOverValid() : bValid
' Whether tr_i_over is a measurement: both peaks it subtracts must be measurements of this rung (R18.1).
' One test, used by the record and by the cell, so a printed NA and an unjudged rung cannot diverge.
'
' @returns bValid - TRUE when the transition and the steady window both measured

    bValid := (trWhy == WHY_NONE) and (bRgWindowValid <> FALSE)

PRI emitRungHl(rid, side, motorIncre)
' BM-RUNGHL (R18.1, PL-95): the driver's two UNBOUNDED health counters over this rung, differenced --
' tr_* across the TRANSITION (command to window start: the ramp and the settle), win_* across the STEADY
' window. drv_incr is the field's increment per drive pass at the window start, so lag_held converts to
' the field advance the limiter withheld: withheld angle = lag x drv_incr.
'
' WHY THIS RECORD EXISTS. err and duty, which BM-RUNG2 prints, both TOP OUT exactly where the drive stops
' keeping up -- err is held near LAG_HOLD by the limiter and bounded by its own +-127, duty saturates at
' duty_max and pins there for the whole top half of the range. Above the knee they report a ceiling, not
' a drive. These counts have no ceiling: zero means the drive kept up for every pass of the window, and
' they grow without bound when it cannot.
'
' NO CELL JUDGES THEM. They are characterisation readings for Visit 7, and the acceptance numbers that
' will judge them are R18.3's to choose, before R18.4 builds against them (doctrine D2: a criterion
' chosen after the fact cannot fail). On today's drive they are expected to be large above mid-range --
' that is PL-95, already recorded, not a verdict this harness re-states.
'
' Worst case 174 bytes: tag(9) + seq(15) + rid(12) + motor(12) + incre(19) + tr_lag(15) + tr_cap(15) +
' win_lag(16) + win_cap(16) + drv_incr(22) + why(23).
'
' @param rid - rung id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment

    recBegin(@"BM-RUNGHL")
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.naNumField(@"tr_lag", rgHlTrLag, LIM_SMALL, bRgHlTrValid)
    benchLog.naNumField(@"tr_cap", rgHlTrCap, LIM_SMALL, bRgHlTrValid)
    benchLog.naNumField(@"win_lag", rgHlWinLag, LIM_SMALL, bRgHlWinValid)
    benchLog.naNumField(@"win_cap", rgHlWinCap, LIM_SMALL, bRgHlWinValid)
    benchLog.naNumField(@"drv_incr", rgHlDrvIncr, LIM_BIG, bRgHlTrValid)
    whyField(rgWhy)
    emitRecord()

PRI emitRung3(rid, side, motorIncre, missedD, illegalD, ampsX10k, bAmpsValid, bWindowValid, whyCode) | rsImpl
' BM-RUNG3: integrity deltas, hwPos, getCurrent() mean and the capture's counters. Worst case 270 bytes.
'
' @param rid - rung id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param missedD - missed transitions over the rung (read before arm and after freeze)
' @param illegalD - illegal codes over the rung
' @param ampsX10k - mean getCurrent() over the window, A x 10_000
' @param bAmpsValid - TRUE when ampsX10k is a measurement
' @param bWindowValid - TRUE when the window statistics are a measurement
' @param whyCode - WHY_* naming the cause of every NA
'
' @local rsImpl - implied sense scale i_x10 x 1_000 / amps_x10k

    rsImpl := 0
    if bAmpsValid and (ampsX10k > 0)
        rsImpl := (rsIMeanX10 * MS_PER_SEC) / ampsX10k
    recBegin(@"BM-RUNG3")
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"missed_d", missedD, LIM_SMALL)
    benchLog.numField(@"illegal_d", illegalD, LIM_SMALL)
    benchLog.naNumField(@"hw_ticks", rsHwTicks, LIM_MID, bWindowValid)
    benchLog.numField(@"hw_skip", rsHwSkip, LIM_SMALL)
    benchLog.naNumField(@"amps_x10k", ampsX10k, LIM_MID, bAmpsValid)
    benchLog.naNumField(@"rs_impl", rsImpl, LIM_SMALL, bAmpsValid and bWindowValid and (ampsX10k > 0))
    benchLog.numField(@"late", rsLate, LIM_SMALL)
    benchLog.numField(@"skipped", rsSkipped, LIM_SMALL)
    benchLog.numField(@"clamps", rsClamps, LIM_SMALL)
    benchLog.boolField(@"idle_up", bRsIdleUp)
    benchLog.numField(@"idle_i", rsIdleIMax, LIM_SMALL)
    whyField(whyCode)
    emitRecord()

PRI emitLive(rid, side, motorIncre, rpmRead, bHeartbeatOk, bWindowValid, whyCode)
' BM-LIVE: instrument liveness beside testGetRpm(). Worst case 203 bytes.
'
' @param rid - rung id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param rpmRead - testGetRpm() after the window
' @param bHeartbeatOk - the instrument heartbeat advanced over the window
' @param bWindowValid - TRUE when the window statistics are a measurement
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-LIVE")
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.boolField(@"up_all", bRsAllUp)
    benchLog.naNumField(@"ticks", rsTicks, LIM_MID, bWindowValid)
    benchLog.naNumField(@"i_min", rsIMin, LIM_SMALL, bWindowValid)
    benchLog.naNumField(@"i_max", rsIMax, LIM_SMALL, bWindowValid)
    benchLog.boolField(@"frozen", bWindowValid and (rsIMin == rsIMax))
    benchLog.naNumField(@"rpm", rpmRead, LIM_SMALL, bWindowValid)
    benchLog.naNumField(@"rate_x10", rsRateX10, LIM_MID, bWindowValid)
    benchLog.boolField(@"hb_ok", bHeartbeatOk)
    whyField(whyCode)
    emitRecord()

PRI bEmitClock(side, adcFram, frameCnt, deadGap) : bFrameOk | expFrame, bSwept
' BM-CLOCK: the driver's frame count against the compiled clock's expected value. Also returns the
' comparison this clock's R14-DUAL-CLKFRM-K200 / -K270 / -K300 cell folds. Worst case 159 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param adcFram - adc_fram from testGetDriveConstants()
' @param frameCnt - frame_cnt from testGetDriveConstants()
' @param deadGap - dead_gap from testGetDriveConstants()
' @returns bFrameOk - adc_fram equals the expected frame count at a swept clock
'
' @local expFrame - expected frame count at CLK_FREQ
' @local bSwept - CLK_FREQ is 200, 270 or 300 MHz

    bSwept := TRUE
    case CLK_FREQ
        CLK_SWEEP_200:
            expFrame := EXP_FRAME_200
        CLK_SWEEP_270:
            expFrame := EXP_FRAME_270
        CLK_SWEEP_300:
            expFrame := EXP_FRAME_300
        other:
            expFrame := 0
            bSwept := FALSE
    bFrameOk := bSwept and (adcFram == expFrame)
    recBegin(@"BM-CLOCK")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"clkfreq", CLKFREQ, LIM_BIG)
    benchLog.numField(@"adc_fram", adcFram, LIM_SMALL)
    benchLog.numField(@"frame_cnt", frameCnt, LIM_SMALL)
    benchLog.numField(@"dead_gap", deadGap, LIM_TINY)
    benchLog.naNumField(@"exp_fram", expFrame, LIM_SMALL, bSwept)
    benchLog.boolField(@"fram_ok", bFrameOk)
    whyField(bSwept ? WHY_NONE : WHY_UNSWEPT_CLOCK)
    emitRecord()

PRI emitTrace(tid, seg, side, causeCode, motorIncre, offNeg, offPos, reqMode, rampInc, whyCode)
' BM-TRACE: a wheel trace header naming what was requested and what was done, never the outcome (I7).
' Worst case 233 bytes.
'
' @param tid - trace id
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param causeCode - CAUSE_* value
' @param motorIncre - signed increment
' @param offNeg - offset_fwd read back before the measurement
' @param offPos - offset_rev read back before the measurement
' @param reqMode - MODE_* requested
' @param rampInc - ramp_inc read back
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-TRACE")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"life", slotLife[side - SIDE_LEFT], LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"cause", tokenAt(@tokCause, CAUSE_COUNT, causeCode), TOKMAX_CAUSE)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"off_neg", offNeg, LIM_TINY)
    benchLog.numField(@"off_pos", offPos, LIM_TINY)
    benchLog.tokenField(@"req_mode", tokenAt(@tokMode, MODE_COUNT, reqMode), TOKMAX_REQMODE)
    benchLog.numField(@"ramp_inc", rampInc, LIM_MID)
    benchLog.numField(@"period_us", INST_PERIOD_US, LIM_SMALL)
    benchLog.numField(@"decim", instDecimate, LIM_TINY)
    benchLog.numField(@"pre", TRACE_PRE_SAMPLES, LIM_SMALL)
    whyField(whyCode)
    emitRecord()

PRI emitSTrace(tid, seg, causeCode, leftPower, rightPower, bPowersValid, dirValue, reqMode, whyCode)
' BM-STRACE: a steering trace header; primary motor LEFT, o_ fields RIGHT. Worst case 200 bytes (an NA
' power is shorter than a number).
'
' @param tid - trace id
' @param seg - SEG_* in progress
' @param causeCode - CAUSE_* value
' @param leftPower - requested left power, or FLOOR's getPower() read-back
' @param rightPower - requested right power, or FLOOR's getPower() read-back
' @param bPowersValid - TRUE when the powers are a request or a read-back; FALSE prints NA
' @param dirValue - commanded direction (0 when not driveDirection())
' @param reqMode - MODE_* requested
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-STRACE")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"life", steerLife, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(SIDE_BOTH), TOKMAX_MOTOR)
    benchLog.tokenField(@"cause", tokenAt(@tokCause, CAUSE_COUNT, causeCode), TOKMAX_CAUSE)
    benchLog.naNumField(@"l_pwr", leftPower, LIM_TINY, bPowersValid)
    benchLog.naNumField(@"r_pwr", rightPower, LIM_TINY, bPowersValid)
    benchLog.numField(@"dir", dirValue, LIM_TINY)
    benchLog.tokenField(@"req_mode", tokenAt(@tokMode, MODE_COUNT, reqMode), TOKMAX_REQMODE)
    benchLog.numField(@"period_us", INST_PERIOD_US, LIM_SMALL)
    benchLog.numField(@"decim", instDecimate, LIM_TINY)
    benchLog.numField(@"pre", TRACE_PRE_SAMPLES, LIM_SMALL)
    whyField(whyCode)
    emitRecord()

PRI emitTs(sampleIdx, kIdx, posRel, hwRel) | bUp, bOtherUp, bLate
' BM-TS: one stored sample of the trace in drain (drPri primary, drOth other). lt is computed from the
' stored t of the previous sample. Worst case 241 bytes.
'
' @param sampleIdx - logical index
' @param kIdx - trace index k
' @param posRel - primary pos relative to k = 0
' @param hwRel - primary hwPos relative to k = 0
'
' @local bUp - primary driver up
' @local bOtherUp - other driver up
' @local bLate - this sample started late relative to the previous stored one

    bUp := bSmpUp(sampleIdx, drPri)
    bOtherUp := bSmpUp(sampleIdx, drOth)
    bLate := FALSE
    if kIdx > 0
        bLate := (smpT(sampleIdx) - smpT(sampleIdx - 1)) > ((INST_PERIOD_TICKS * instDecimate) + INST_LATE_TICKS)
    recBegin(@"BM-TS")
    benchLog.numField(@"tid", trTid, LIM_SMALL)
    benchLog.numField(@"k", kIdx, LIM_SMALL)
    benchLog.boolField(@"lt", bLate)
    benchLog.numField(@"pos", posRel, LIM_MID)
    benchLog.numField(@"hw", hwRel, LIM_MID)
    benchLog.naNumField(@"i", smpI(sampleIdx, drPri), LIM_SMALL, bUp)
    benchLog.naNumField(@"ph", smpPh(sampleIdx, drPri), LIM_SMALL, bUp)
    benchLog.naNumField(@"d", smpDuty(sampleIdx, drPri), LIM_SMALL, bUp)
    benchLog.naNumField(@"e", smpErr(sampleIdx, drPri), LIM_TINY, bUp)
    benchLog.tokenField(@"st", dcsToken(smpState(sampleIdx, drPri)), TOKMAX_STATE)
    benchLog.boolField(@"flt", bSmpFault(sampleIdx, drPri))
    benchLog.boolField(@"up", bUp)
    benchLog.numField(@"ig", trIgRun, LIM_SMALL)
    benchLog.numField(@"o_pos", smpPos(sampleIdx, drOth) - smpPos(drStartJ, drOth), LIM_MID)
    benchLog.numField(@"o_hw", smpHw(sampleIdx, drOth) - smpHw(drStartJ, drOth), LIM_MID)
    benchLog.naNumField(@"o_i", smpI(sampleIdx, drOth), LIM_SMALL, bOtherUp)
    benchLog.boolField(@"o_up", bOtherUp)
    whyField((bUp and bOtherUp) ? WHY_NONE : WHY_NO_COG)
    emitRecord()

PRI emitTraceEnd(tid, endCode, emptyWhy) | traceSamples, markK, whyCode
' BM-TRACE-END from the drain state, with sec 12.4's stride before why. Worst case: 265 + stride
' (2+6+4=12) = 277 bytes.
'
' @param tid - trace id
' @param endCode - TEND_* value
' @param emptyWhy - WHY_* printed when no sample was stored (NO_SAMPLES, or why the trial never ran)
'
' @local traceSamples - samples in the trace (drStartJ..drEndJ)
' @local markK - k of the mark
' @local whyCode - emptyWhy, NOT_REACHED (mark or rest not found) or NONE

    traceSamples := 0
    if drStored > 0
        traceSamples := drEndJ - drStartJ + 1
    markK := drMarkJ - drStartJ
    if drStored == 0
        whyCode := emptyWhy
    elseif (bDrMarkFound == FALSE) or (bDrRestFound == FALSE)
        whyCode := WHY_NOT_REACHED
    else
        whyCode := WHY_NONE
    recBegin(@"BM-TRACE-END")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.numField(@"stored", traceSamples, LIM_SMALL)
    benchLog.numField(@"emitted", trLines, LIM_SMALL)
    benchLog.numField(@"ksum", trKSum, LIM_MID)
    benchLog.naNumField(@"mark_k", markK, LIM_SMALL, bDrMarkFound)
    benchLog.naNumField(@"late", instLate, LIM_SMALL, drStored > 0)
    benchLog.naNumField(@"skipped", instSkipped, LIM_SMALL, drStored > 0)
    benchLog.numField(@"lost_head", drLostHead, LIM_SMALL)
    benchLog.numField(@"dropped", drDropped, LIM_SMALL)
    benchLog.tokenField(@"end", tokenAt(@tokTend, TEND_COUNT, endCode), TOKMAX_TEND)
    benchLog.naNumField(@"rest_k", drRestK, LIM_SMALL, bDrRestFound)
    benchLog.numField(@"ig_sum", drIgSum, LIM_SMALL)
    benchLog.numField(@"o_ig_sum", drOIgSum, LIM_SMALL)
    benchLog.numField(@"hw_skip", drHwSkip, LIM_SMALL)
    benchLog.numField(@"stride", trStride, LIM_TINY)
    whyField(whyCode)
    emitRecord()

PRI emitFbTrial(tid, side)
' BM-FBTRIAL from the fb* staging. Worst case 269 bytes.
'
' @param tid - trace id of the trial
' @param side - SIDE_LEFT or SIDE_RIGHT

    recBegin(@"BM-FBTRIAL")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"trial", fbTrial, LIM_TINY)
    benchLog.numField(@"ramp_inc", fbRampInc, LIM_MID)
    benchLog.numField(@"incre", fbIncre, LIM_BIG)
    benchLog.numField(@"off_neg", fbOffNeg, LIM_TINY)
    benchLog.numField(@"off_pos", fbOffPos, LIM_TINY)
    benchLog.tokenField(@"result", tokenAt(@tokRes, RES_COUNT, fbResult), TOKMAX_RESULT)
    benchLog.naNumField(@"t_ms", fbTMs, LIM_SMALL, bFbTValid)
    benchLog.numField(@"i_pk", fbIPk, LIM_SMALL)
    benchLog.numField(@"duty_pk", fbDutyPk, LIM_SMALL)
    benchLog.numField(@"duty_max", fbDutyMax, LIM_SMALL)
    benchLog.boolField(@"dsat", bFbDsat)
    benchLog.tokenField(@"rst", tokenAt(@tokRst, RST_COUNT, fbRst), TOKMAX_RST)
    benchLog.numField(@"rst_ms", fbRstMs, LIM_SMALL)
    whyField(fbWhy)
    emitRecord()

PRI emitRampRest(side, minRamp, maxRamp, incRamp, downRamp, bOk)
' BM-RAMPREST: the ramp restore read back (I11). Worst case 131 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param minRamp - ramp_min read back
' @param maxRamp - ramp_max read back
' @param incRamp - ramp_inc read back
' @param downRamp - ramp_down read back
' @param bOk - TRUE when the defaults read back

    recBegin(@"BM-RAMPREST")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"min", minRamp, LIM_MID)
    benchLog.numField(@"max", maxRamp, LIM_MID)
    benchLog.numField(@"inc", incRamp, LIM_MID)
    benchLog.numField(@"down", downRamp, LIM_MID)
    benchLog.boolField(@"ok", bOk)
    whyField(WHY_NONE)
    emitRecord()

PRI emitOffRest(side, wantNeg, wantPos, offNeg, offPos, bOk)
' BM-OFFREST: the offset restore read back (I11). Worst case 123 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param wantNeg - offset_fwd restored
' @param wantPos - offset_rev restored
' @param offNeg - offset_fwd read back
' @param offPos - offset_rev read back
' @param bOk - TRUE when both read back equal

    recBegin(@"BM-OFFREST")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"want_neg", wantNeg, LIM_TINY)
    benchLog.numField(@"want_pos", wantPos, LIM_TINY)
    benchLog.numField(@"off_neg", offNeg, LIM_TINY)
    benchLog.numField(@"off_pos", offPos, LIM_TINY)
    benchLog.boolField(@"ok", bOk)
    whyField(WHY_NONE)
    emitRecord()

PRI emitRecover(seg, tid, side, motorIncre, offNeg, offPos, stepCode, bCleared, stepMs, eDrvrState, bFaultSig)
' BM-RECOVER: one recovery step. Worst case 193 bytes.
'
' @param seg - SEG_* in progress
' @param tid - trace id, 0 when none
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - the faulted command
' @param offNeg - offset_fwd read back
' @param offPos - offset_rev read back
' @param stepCode - RSTEP_* value
' @param bCleared - stopped and not faulted
' @param stepMs - ms the step took
' @param eDrvrState - driver state after the step
' @param bFaultSig - fault flag after the step

    recBegin(@"BM-RECOVER")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"off_neg", offNeg, LIM_TINY)
    benchLog.numField(@"off_pos", offPos, LIM_TINY)
    benchLog.tokenField(@"step", tokenAt(@tokRstep, RSTEP_COUNT, stepCode), TOKMAX_STEP)
    benchLog.boolField(@"cleared", bCleared)
    benchLog.numField(@"ms", stepMs, LIM_SMALL)
    benchLog.tokenField(@"st", dcsToken(eDrvrState), TOKMAX_STATE)
    benchLog.boolField(@"flt", bFaultSig)
    whyField(WHY_NONE)
    emitRecord()

PRI emitUnrecov(seg, tid, side, motorIncre, offNeg, offPos, eDrvrState, bFaultSig, bUp)
' BM-UNRECOV: recovery step 4, the motor is retired for this load. Worst case 184 bytes.
'
' @param seg - SEG_* in progress
' @param tid - trace id, 0 when none
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - the faulted command
' @param offNeg - offset_fwd read back
' @param offPos - offset_rev read back
' @param eDrvrState - driver state after the restart
' @param bFaultSig - fault flag after the restart
' @param bUp - the restart's start succeeded

    recBegin(@"BM-UNRECOV")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"off_neg", offNeg, LIM_TINY)
    benchLog.numField(@"off_pos", offPos, LIM_TINY)
    benchLog.tokenField(@"st", dcsToken(eDrvrState), TOKMAX_STATE)
    benchLog.boolField(@"flt", bFaultSig)
    benchLog.boolField(@"up", bUp)
    benchLog.tokenField(@"action", @sActionRetired, TOKMAX_ACTION)
    whyField(WHY_MOTOR_RETIRED)
    emitRecord()

PRI emitAbort(seg, tid, side, motorIncre, reasonCode, detailValue, scopeCode)
' BM-ABORT. Worst case 153 bytes.
'
' @param seg - SEG_* in progress
' @param tid - trace id, 0 when none
' @param side - SIDE_* affected
' @param motorIncre - the command in force
' @param reasonCode - ABR_* value
' @param detailValue - the reading or count that triggered it
' @param scopeCode - SCOPE_* value

    recBegin(@"BM-ABORT")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.tokenField(@"reason", tokenAt(@tokAbr, ABR_COUNT, reasonCode), TOKMAX_REASON)
    benchLog.numField(@"value", detailValue, LIM_BIG)
    benchLog.tokenField(@"scope", tokenAt(@tokScope, SCOPE_COUNT, scopeCode), TOKMAX_SCOPE)
    whyField(WHY_NONE)
    emitRecord()

PRI emitOvershoot(tid, sid, powerValue, distFt, bStraight) | bValid
' BM-OVERSHOOT from the ov* staging. Worst case 271 bytes. On a TURN trial (two distances) dist_ft and tgt
' print NA, since one number cannot describe both wheels; BM-TURN carries each wheel's (task 3577).
'
' @param tid - trace id
' @param sid - the steering start's life
' @param powerValue - commanded power
' @param distFt - commanded distance, feet (a straight trial's; printed NA on a turn)
' @param bStraight - TRUE when both wheels were given distFt
'
' @local bValid - the stop/rest fields are measurements (ovWhy is WHY_NONE)

    bValid := (ovWhy == WHY_NONE)
    recBegin(@"BM-OVERSHOOT")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.numField(@"sid", sid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(SIDE_BOTH), TOKMAX_MOTOR)
    benchLog.numField(@"power", powerValue, LIM_TINY)
    benchLog.naNumField(@"dist_ft", distFt, LIM_TINY, bStraight)
    benchLog.naNumField(@"tgt", overshootTarget(distFt), LIM_MID, bStraight)
    benchLog.naNumField(@"l_stop", ovLeftStop, LIM_MID, bValid)
    benchLog.naNumField(@"r_stop", ovRightStop, LIM_MID, bValid)
    benchLog.naNumField(@"l_rest", ovLeftRest, LIM_MID, bValid)
    benchLog.naNumField(@"r_rest", ovRightRest, LIM_MID, bValid)
    benchLog.numField(@"l_trk", ovLeftTrk, LIM_MID)
    benchLog.numField(@"r_trk", ovRightTrk, LIM_MID)
    benchLog.naNumField(@"t_stop", ovTStopMs, LIM_SMALL, bValid)
    benchLog.numField(@"l_ig", ovLeftIg, LIM_SMALL)
    benchLog.numField(@"r_ig", ovRightIg, LIM_SMALL)
    whyField(ovWhy)
    emitRecord()

PRI emitTurn(tid, leftFt, rightFt) | bValid
' BM-TURN (task 3577): a turn trial's two distances, two targets and two rests, the rests in the PLATFORM
' frame (ovRightRestPf, the right wheel's raw rest x STEER_RIGHT_RAW_SIGN), so each rest reads against its own target as
' R17-DUAL-TURNDIST-B judges it. BM-OVERSHOOT beside it keeps the raw stop and rest fields. Worst case:
' tag(7) + seq(15) + tid(12) + l_ft(10) + r_ft(10) + l_tgt(17) + r_tgt(17) + l_rest(18) + r_rest(18) +
' why(23) = 147 bytes.
'
' @param tid - trace id
' @param leftFt - the left wheel's commanded distance, feet
' @param rightFt - the right wheel's commanded distance, feet
'
' @local bValid - the rest fields are measurements (ovWhy is WHY_NONE)

    bValid := (ovWhy == WHY_NONE)
    recBegin(@"BM-TURN")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.numField(@"l_ft", leftFt, LIM_TINY)
    benchLog.numField(@"r_ft", rightFt, LIM_TINY)
    benchLog.numField(@"l_tgt", overshootTarget(leftFt), LIM_MID)
    benchLog.numField(@"r_tgt", overshootTarget(rightFt), LIM_MID)
    benchLog.naNumField(@"l_rest", ovLeftRest, LIM_MID, bValid)
    benchLog.naNumField(@"r_rest", ovRightRestPf, LIM_MID, bValid)
    whyField(ovWhy)
    emitRecord()

PRI emitOut(tid, sid, rowIdx) | rowBase
' BM-OUT: one 100 ms poll of the public API from outBuf. Worst case 239 + faulted(2+7+5=14) +
' estop(2+5+5=12) = 265 bytes.
'
' @param tid - trace id
' @param sid - the steering start's life
' @param rowIdx - 0-based poll row
'
' @local rowBase - first long of the row

    rowBase := rowIdx * OUT_LONGS
    recBegin(@"BM-OUT")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.numField(@"sid", sid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(SIDE_BOTH), TOKMAX_MOTOR)
    benchLog.numField(@"t_ms", outBuf[rowBase + OUT_T_MS], LIM_SMALL)
    benchLog.tokenField(@"l_stat", statusToken(outBuf[rowBase + OUT_L_STAT]), TOKMAX_STAT)
    benchLog.tokenField(@"r_stat", statusToken(outBuf[rowBase + OUT_R_STAT]), TOKMAX_STAT)
    benchLog.tokenField(@"l_st", dcsToken(outBuf[rowBase + OUT_L_ST]), TOKMAX_STATE)
    benchLog.tokenField(@"r_st", dcsToken(outBuf[rowBase + OUT_R_ST]), TOKMAX_STATE)
    benchLog.boolField(@"l_flt", outBuf[rowBase + OUT_L_FLT])
    benchLog.boolField(@"l_sig", outBuf[rowBase + OUT_L_SIG])
    benchLog.boolField(@"r_flt", outBuf[rowBase + OUT_R_FLT])
    benchLog.boolField(@"r_sig", outBuf[rowBase + OUT_R_SIG])
    benchLog.boolField(@"turning", outBuf[rowBase + OUT_TURNING])
    benchLog.numField(@"l_pwr", outBuf[rowBase + OUT_L_PWR], LIM_TINY)
    benchLog.numField(@"r_pwr", outBuf[rowBase + OUT_R_PWR], LIM_TINY)
    benchLog.boolField(@"faulted", outBuf[rowBase + OUT_FAULTED])
    benchLog.boolField(@"estop", outBuf[rowBase + OUT_ESTOP])
    whyField(WHY_NONE)
    emitRecord()

PRI emitFltApi(tid, sid, whyCode)
' BM-FLTAPI: the OVERSHT fault-API trial's own verdict (task 3552). The trial PRINTS WHETHER IT FAULTED,
' so a run that provoked nothing says so in one line instead of being inferred from the absence of rows.
' flt_ms and held_ms print NA when no fault arrived. Worst case 224 - want_off(17) + l_shift(16) + r_shift(16)
' + l_cause(13) + r_cause(13) = 265 bytes.
'
' @param tid - trace id, the one the BM-OUT rows below carry
' @param sid - the steering start's life
' @param whyCode - WHY_NONE when the fault arrived and the verdict was read, else the cause

    recBegin(@"BM-FLTAPI")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.numField(@"sid", sid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(SIDE_BOTH), TOKMAX_MOTOR)
    ' task 3572: the provocation is a COMPUTED shift per wheel (faultShiftDeg()), so the record names each
    '  wheel's shift and the offset it read back (the offsets in force are in the BM-OFFREST pair beside this)
    benchLog.numField(@"l_shift", fltLeftShift, LIM_SMALL)
    benchLog.numField(@"r_shift", fltRightShift, LIM_SMALL)
    benchLog.numField(@"l_off", fltLeftInc, LIM_SMALL)
    benchLog.numField(@"r_off", fltRightInc, LIM_SMALL)
    benchLog.numField(@"power", FLTAPI_POWER, LIM_TINY)
    benchLog.numField(@"rows", outCount, LIM_SMALL)
    benchLog.naNumField(@"flt_ms", fltFaultMs, LIM_SMALL, bSfFltApiRan)
    benchLog.naNumField(@"held_ms", fltLatchMs, LIM_SMALL, bSfFltApiRan)
    benchLog.numField(@"need_ms", FLTAPI_LATCH_MS, LIM_SMALL)
    benchLog.boolField(@"latched", bSfFltApiOk)
    ' task 3560 / PL-66: the SAME power commanded again after the fault. Appended, so a fmt-3 reader
    '  still parses every field it knows.
    benchLog.naNumField(@"retry_err", fltRetryErr, LIM_MID, bSfRetryRan)
    benchLog.naNumField(@"retry_ms", fltRetryMs, LIM_SMALL, bSfRetryRan and bFltRetryOk)
    benchLog.boolField(@"retry_ok", bFltRetryOk)
    ' task 3572 (S-7): the cause each wheel reports for the provoked fault. Appended.
    benchLog.tokenField(@"l_cause", tokenAt(@tokFltCause, FC_COUNT, fltLeftCause), TOKMAX_FCAUSE)
    benchLog.tokenField(@"r_cause", tokenAt(@tokFltCause, FC_COUNT, fltRightCause), TOKMAX_FCAUSE)
    whyField(whyCode)
    emitRecord()

PRI emitDStep(side)
' BM-DSTEP: one part-D claim, from the ds* staging. One record shape for every step, so the log reads as
' one table and a step that could not be provoked prints its NOMEAS row beside the ones that did.
' Worst case 187 bytes.
'
' @param side - SIDE_BOTH (the steering object) or SIDE_LEFT (the single wheel)

    recBegin(@"BM-DSTEP")
    benchLog.tokenField(@"step", tokenAt(@tokDStep, DST_COUNT, dsStep), TOKMAX_DSTEP)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"seg", segToken(curSeg), TOKMAX_SEG)
    benchLog.naNumField(@"measured", dsMeasured, LIM_MID, dsResult <> DRES_NOMEAS)
    benchLog.numField(@"lo", dsLo, LIM_MID)
    benchLog.numField(@"hi", dsHi, LIM_MID)
    benchLog.tokenField(@"result", tokenAt(@tokDRes, DRES_COUNT, dsResult), TOKMAX_DRES)
    whyField(dsWhy)
    emitRecord()

PRI emitFrontSt(side, nPasses, nLate, nMaxTicks, nStackHi, nStackOf)
' BM-FRONTST: one front cog's loop health, with the pass time in microseconds beside the raw ticks so the
' reading does not have to be divided by a clock the reader has to look up. Worst case 174 bytes.
'
' PL-75: stack_of is now the size the OBJECT reports alongside its own mark, not a harness constant.
' It used to print D_FRONT_STACK_HI, which is a number this file holds and the object never sees, so
' the record would have kept saying 128 however much the object actually allocated -- and the two
' front cogs do not have the same allocation. A record that carries both numbers from one source
' cannot misreport a saturated mark as a healthy one.
'
' @param side - SIDE_BOTH (the steering front cog) or SIDE_LEFT (the wheel's own)
' @param nPasses - passes since launch
' @param nLate - passes that overran their slot
' @param nMaxTicks - longest pass body, in system ticks
' @param nStackHi - stack longs ever used
' @param nStackOf - the allocation that mark is measured against, from the same object

    recBegin(@"BM-FRONTST")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"passes", nPasses, LIM_BIG)
    benchLog.numField(@"late", nLate, LIM_BIG)
    benchLog.numField(@"max_ticks", nMaxTicks, LIM_BIG)
    benchLog.numField(@"max_us", nMaxTicks / TICKS_PER_US, LIM_MID)
    benchLog.numField(@"slot_us", US_PER_SEC / wheelL.FRONT_LOOP_HZ, LIM_SMALL)
    benchLog.numField(@"stack_hi", nStackHi, LIM_SMALL)
    benchLog.numField(@"stack_of", nStackOf, LIM_SMALL)
    whyField(WHY_NONE)
    emitRecord()

PRI emitLimSt(side, slotIdx, stepCode, stepValue) | nPeakA, nContA, bDeratedNow, nPhaseMa, nLimitK
' BM-LIMST: one wheel's current-limit state as the step that printed it left it, plus that step's own
' number. The RESTORE rows are the ones whose peak_a and cont_a read the MOSFET values back (I11).
' Worst case 190 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param slotIdx - motor slot
' @param stepCode - DST_* the row belongs to
' @param stepValue - the printing step's number (a phase average, a derate time, or peak x10 + cont)
'
' @local nPeakA - the peak limit in force
' @local nContA - the continuous limit in force
' @local bDeratedNow - the fold-back holds the continuous limit
' @local nPhaseMa - the judged phase average, mA
' @local nLimitK - the fold-back factor

    nPeakA, nContA, bDeratedNow, nPhaseMa, nLimitK := dLimitState(slotIdx)
    recBegin(@"BM-LIMST")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"step", tokenAt(@tokDStep, DST_COUNT, stepCode), TOKMAX_DSTEP)
    benchLog.numField(@"peak_a", nPeakA, LIM_SMALL)
    benchLog.numField(@"cont_a", nContA, LIM_SMALL)
    benchLog.boolField(@"derated", bDeratedNow)
    benchLog.numField(@"phase_ma", nPhaseMa, LIM_BIG)
    benchLog.numField(@"limit_k", nLimitK, LIM_MID)
    benchLog.numField(@"value", stepValue, LIM_BIG)
    whyField(WHY_NONE)
    emitRecord()

PRI emitLag(side, slotIdx)
' BM-LAG: the run's largest |err| the instrument saw for one motor, with the samples behind it.
'
' THE FIELD SATURATES AT 127, which is what a driver with no lag limiter prints: the stored err is a
' signed byte and the driver's own fault test sits at 125. So a printed 127 says "the limiter did not
' hold", and the bound below says how far under the fault test it did hold.
'
' PL-78: hold and fault are printed beside max_err so the whole band is in the record and the reader
' does not have to look up either number. hold is the gate the driver applies once per drive pass
' (LAG_HOLD); fault is the test it trips (125); hi is the criterion, one below fault. A max_err between
' hold and hi is the normal state, not a near-miss. Worst case 174 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param slotIdx - motor slot

    recBegin(@"BM-LAG")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"part", tokenAt(@tokPart, PART_COUNT, PART_ID), TOKMAX_PART)
    benchLog.naNumField(@"max_err", instLagMax[slotIdx], LIM_SMALL, instLagN[slotIdx] > 0)
    benchLog.numField(@"samples", instLagN[slotIdx], LIM_BIG)
    benchLog.numField(@"lo", LAG_MAX_LO, LIM_SMALL)
    benchLog.numField(@"hi", LAG_MAX_HI, LIM_SMALL)
    benchLog.numField(@"hold", LAG_HOLD_REF, LIM_SMALL)
    benchLog.numField(@"fault", LAG_FAULT_TEST, LIM_SMALL)
    benchLog.numField(@"sat", FIELD_ERR_MAX, LIM_SMALL)
    whyField((instLagN[slotIdx] > 0) ? WHY_NONE : WHY_NO_SAMPLES)
    emitRecord()

PRI emitLagAll() | slotIdx
' One BM-LAG per motor, on cog 0's end path, after every capture this part took.
'
' @local slotIdx - motor slot

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        emitLag(SIDE_LEFT + slotIdx, slotIdx)

PRI emitStopCur(tid, side, slotIdx)
' BM-STOPCUR: what a stop FROM SPEED costs in current, against what holding that speed cost.
'
' The claim (task 3558) is that a commanded stop does not surge -- the surge tripped the harness's own
' 10 A abort at Visit 2 (PL-55). Every number comes from the same frozen capture, so they are the same
' instrument and the same scale.
'
' PL-82: bound_mV IS THE CRITERION and hold_pk_mV is the comparison a reader makes. The old criterion was
' stop_pk against hold_mV_x10, which is a peak against a mean AND against a reference that drifts about
' 25 % as the motor warms -- so it failed on the reference. hold_mV_x10 is kept precisely because the
' drift is visible in it. Worst case 210 bytes.
'
' @param tid - trace id of the trial
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param slotIdx - motor slot

    recBegin(@"BM-STOPCUR")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.naNumField(@"hold_mV_x10", scHoldIX10[slotIdx], LIM_BIG, bScValid[slotIdx])
    benchLog.naNumField(@"hold_pk_mV", scHoldPk[slotIdx], LIM_MID, bScValid[slotIdx])
    benchLog.naNumField(@"stop_pk_mV", scStopPk[slotIdx], LIM_MID, bScValid[slotIdx])
    benchLog.numField(@"samples", scSamples[slotIdx], LIM_SMALL)
    benchLog.numField(@"bound_mV", STOPCUR_BOUND_MV, LIM_SMALL)
    benchLog.numField(@"abort_mV", ABS_ABORT_MV, LIM_SMALL)
    whyField(bScValid[slotIdx] ? WHY_NONE : WHY_NO_SAMPLES)
    emitRecord()

PRI emitDistM(tid, sid, tickMmX100)
' BM-DISTM: the steering object's getDistance(DDU_M) against the ticks it is derived from.
'
' Visit 3 left DDU_M unqualified: task 3502 corrected the metre conversion, and no bench reading has
' compared the two since. l_ticks / r_ticks are THE TICK COUNTS THE GETTER SAW, read in the same place
' and at the same moment as l_m / r_m (PL-77) -- so the comparison really is of the conversion alone,
' and a disagreement names a conversion fault instead of two reads taken moments apart.
'
' PL-84: mm_x100 is the MOTOR object's travel-per-tick and str_mm_x100 is the STEERING object's own
' copy, which every distance it reports or accepts is scaled by. They are equal by construction --
' start() sets the second from the first -- so a difference is a corrupted copy, and until this field
' existed the record showed the healthy one while the steering used something else entirely. Worst case
' 215 bytes.
'
' @param tid - trace id of the trial
' @param sid - the steering start's life
' @param tickMmX100 - wheel travel per hall tick in hundredths of a mm, from the library's own geometry

    recBegin(@"BM-DISTM")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.numField(@"sid", sid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(SIDE_BOTH), TOKMAX_MOTOR)
    benchLog.numField(@"l_ticks", dmLeftTicks, LIM_MID)
    benchLog.numField(@"r_ticks", dmRightTicks, LIM_MID)
    benchLog.numField(@"l_m", dmLeftM, LIM_SMALL)
    benchLog.numField(@"r_m", dmRightM, LIM_SMALL)
    benchLog.numField(@"l_pred_m", dmLeftPredM, LIM_SMALL)
    benchLog.numField(@"r_pred_m", dmRightPredM, LIM_SMALL)
    benchLog.numField(@"mm_x100", tickMmX100, LIM_SMALL)
    benchLog.numField(@"str_mm_x100", dmSteerMmX100, LIM_BIG)
    benchLog.boolField(@"agree", bSfDistMOk)
    whyField(bSfDistMRan ? WHY_NONE : WHY_NO_SAMPLES)
    emitRecord()

PRI emitFloor(tid, sid, runMs, answerCode, inputCode, leftRateX10, rightRateX10, bRatesValid, slowerCode, stopByCode, whyCode)
' BM-FLOOR. The rates and slower print NA together when the rates were not measured. Worst case 219 bytes.
'
' @param tid - trace id
' @param sid - the steering start's life
' @param runMs - ms driven
' @param answerCode - ANS_* value
' @param inputCode - INPUT_* value
' @param leftRateX10 - left ticks per second x10 over the run
' @param rightRateX10 - right ticks per second x10 over the run
' @param bRatesValid - TRUE when the rates (and so slower) are measurements
' @param slowerCode - SLOWER_* value
' @param stopByCode - STOPBY_* value
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-FLOOR")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.numField(@"sid", sid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(SIDE_BOTH), TOKMAX_MOTOR)
    benchLog.numField(@"power", FLOOR_POWER, LIM_TINY)
    benchLog.numField(@"dir", FLOOR_DIRECTION, LIM_TINY)
    benchLog.numField(@"run_ms", runMs, LIM_SMALL)
    benchLog.tokenField(@"answer", tokenAt(@tokAns, ANS_COUNT, answerCode), TOKMAX_ANSWER)
    benchLog.tokenField(@"input", tokenAt(@tokInput, INPUT_COUNT, inputCode), TOKMAX_INPUT)
    benchLog.naNumField(@"l_rate_x10", leftRateX10, LIM_MID, bRatesValid)
    benchLog.naNumField(@"r_rate_x10", rightRateX10, LIM_MID, bRatesValid)
    if bRatesValid
        benchLog.tokenField(@"slower", tokenAt(@tokSlower, SLOWER_COUNT, slowerCode), TOKMAX_SLOWER)
    else
        benchLog.textField(@"slower", @sSfNa)
    benchLog.tokenField(@"stop_by", tokenAt(@tokStopBy, STOPBY_COUNT, stopByCode), TOKMAX_STOPBY)
    whyField(whyCode)
    emitRecord()

PRI emitUiStep(kindCode, testedIdx, gotIdx, bKeyGot, bClickGot, promptIdx, resultCode, waitedMs)
' BM-UISTEP: one UICHECK step, what was shown and what arrived. tested is the one live button a control step
' checks (NA on a screen step); got is the button a screen step received (NA otherwise, or when none did);
' key and click say whether that input arrived; press_x / press_y are the last left-button press of the step
' exactly as PC_MOUSE reported it, NA when there was none (click FALSE then says why). Worst case: tag(9) +
' seq(15) + step(10) + kind(13) + tested(16) + got(13) + key(10) + click(12) + press_x(19) + press_y(19) +
' prompt(12) + result(15) + wait_ms(19) + why(23) = 205 bytes.
'
' @param kindCode - UIK_* value
' @param testedIdx - BM_BTN_* under test, PNL_BTN_NONE on a screen step
' @param gotIdx - BM_BTN_* a screen step received, PNL_BTN_NONE otherwise
' @param bKeyGot - the step's button arrived as a key
' @param bClickGot - the step's button arrived as a mouse click
' @param promptIdx - BM_SCR_* on screen, whose prompt cell has the same index
' @param resultCode - UIR_* value
' @param waitedMs - ms the step took

    uiStepCount := (uiStepCount + 1) <# LIM_SMALL
    recBegin(@"BM-UISTEP")
    benchLog.numField(@"step", uiStepCount, LIM_TINY)
    benchLog.tokenField(@"kind", tokenAt(@tokUiKind, UIK_COUNT, kindCode), TOKMAX_UIKIND)
    uiButtonField(@"tested", testedIdx)
    uiButtonField(@"got", gotIdx)
    benchLog.boolField(@"key", bKeyGot)
    benchLog.boolField(@"click", bClickGot)
    benchLog.naNumField(@"press_x", uiPressX, LIM_MID, bUiPressSeen)
    benchLog.naNumField(@"press_y", uiPressY, LIM_MID, bUiPressSeen)
    benchLog.numField(@"prompt", promptIdx, LIM_TINY)
    benchLog.tokenField(@"result", tokenAt(@tokUiRes, UIR_COUNT, resultCode), TOKMAX_UIRES)
    benchLog.numField(@"wait_ms", waitedMs, LIM_MID)
    whyField(lookupz(resultCode: WHY_NONE, WHY_OPERATOR_SKIP, WHY_OPERATOR_TIMEOUT))
    emitRecord()

PRI uiButtonField(pName, btnIdx)
' Append a button field: its token, or NA when no button applies.
'
' @param pName - pointer to the field name
' @param btnIdx - BM_BTN_* value, PNL_BTN_NONE for none

    if (btnIdx >= 0) and (btnIdx < BM_BTN_COUNT)
        benchLog.tokenField(pName, tokenAt(@tokButton, BM_BTN_COUNT, btnIdx), TOKMAX_BUTTON)
    else
        benchLog.textField(pName, @sSfNa)

PRI emitOper(promptCode, eventCode, answerCode, inputCode, waitedMs, whyCode)
' BM-OPER: what the operator was shown and did. Worst case 125 bytes.
'
' @param promptCode - PROMPT_* value
' @param eventCode - OPEV_* value
' @param answerCode - ANS_* value
' @param inputCode - INPUT_* value
' @param waitedMs - ms since the prompt was shown
' @param whyCode - WHY_* value

    recBegin(@"BM-OPER")
    benchLog.tokenField(@"prompt", tokenAt(@tokPrompt, PROMPT_COUNT, promptCode), TOKMAX_PROMPT)
    benchLog.tokenField(@"event", tokenAt(@tokOpEv, OPEV_COUNT, eventCode), TOKMAX_OPEREV)
    benchLog.tokenField(@"answer", tokenAt(@tokAns, ANS_COUNT, answerCode), TOKMAX_ANSWER)
    benchLog.tokenField(@"input", tokenAt(@tokInput, INPUT_COUNT, inputCode), TOKMAX_INPUT)
    benchLog.numField(@"wait_ms", waitedMs, LIM_MID)
    whyField(whyCode)
    emitRecord()

PRI emitSeg(seg, eventCode, bAttended, itemCount, faultCount, unrecovCount, elapsedMs, whyCode)
' BM-SEG. Worst case 140 bytes.
'
' @param seg - SEG_* value
' @param eventCode - SEGEV_* value
' @param bAttended - the segment needs a person
' @param itemCount - trials, rungs or traces done
' @param faultCount - faults in the segment
' @param unrecovCount - motors retired in the segment
' @param elapsedMs - segment duration
' @param whyCode - WHY_* value

    recBegin(@"BM-SEG")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.tokenField(@"event", tokenAt(@tokSegEv, SEGEV_COUNT, eventCode), TOKMAX_SEGEV)
    benchLog.boolField(@"attended", bAttended)
    benchLog.numField(@"items", itemCount, LIM_SMALL)
    benchLog.numField(@"faults", faultCount, LIM_SMALL)
    benchLog.numField(@"unrecov", unrecovCount, LIM_TINY)
    benchLog.numField(@"ms", elapsedMs, LIM_MID)
    whyField(whyCode)
    emitRecord()

PRI emitPreflt(side, motorIncre, ticksMoved, hwMoved, bMeasured, whyCode)
' BM-PREFLT. Worst case 124 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - the nudge increment
' @param ticksMoved - driver pos delta
' @param hwMoved - hwPos delta
' @param bMeasured - the deltas are measurements
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-PREFLT")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.naNumField(@"ticks", ticksMoved, LIM_SMALL, bMeasured)
    benchLog.naNumField(@"hw_ticks", hwMoved, LIM_MID, bMeasured)
    benchLog.boolField(@"moved", bMeasured and (ticksMoved <> 0))
    whyField(bMeasured ? WHY_NONE : whyCode)
    emitRecord()

PRI emitTrap(trapCode, bReturned)
' BM-TRAP: the one top-level trap's value, every run (I9). Worst case 55 bytes.
'
' @param trapCode - the value \runPart() delivered
' @param bReturned - runPart() reached its end

    recBegin(@"BM-TRAP")
    benchLog.numField(@"code", trapCode, LIM_BIG)
    benchLog.boolField(@"returned", bReturned)
    emitRecord()

PRI emitEnd(exitCode)
' BM-END: the last record before the marker; records is the seq this record carries (I8).
' Worst case 152 bytes.
'
' @param exitCode - EXIT_* value

    recBegin(@"BM-END")
    benchLog.tokenField(@"exit", tokenAt(@tokExit, EXIT_COUNT, exitCode), TOKMAX_EXIT)
    benchLog.tokenField(@"part", tokenAt(@tokPart, PART_COUNT, PART_ID), TOKMAX_PART)
    benchLog.numField(@"segs", segsRun, LIM_TINY)
    benchLog.tokenField(@"last_seg", segToken(lastSeg), TOKMAX_SEG)
    benchLog.numField(@"records", logSeq, LIM_MID)
    benchLog.numField(@"trap_code", runTrapCode, LIM_BIG)
    benchLog.numField(@"unrecov", unrecovTotal, LIM_TINY)
    whyField(WHY_NONE)
    emitRecord()

CON { --- sign-off verdicts (design sec 5.2; record contract VISIT-SIGNOFF-DESIGN.md sec B.1) --- }

PRI partNoStallCell() : pCell
' This part's R14-DUAL-NOSTALL-* cell id, and for the CLOCK part this clock's (shared by cog 0 and the
' watchdog; reads only DAT).
'
' @returns pCell - pointer to the cell id, "?" for PART_NONE and for a CLOCK build at an unswept clock

    case PART_ID
        PART_A:
            pCell := @sSfCellNoStallA
        PART_CLOCK:
            pCell := clockCell(@sSfCellNoStallK200, @sSfCellNoStallK270, @sSfCellNoStallK300)
        PART_B:
            pCell := @sSfCellNoStallB
        PART_BRAKE:
            pCell := @sSfCellNoStallH
        PART_C:
            pCell := @sSfCellNoStallC
        PART_D:
            pCell := @sSfCellNoStallD
        PART_FLOOR:
            pCell := @sSfCellNoStallF
        PART_UICHECK:
            pCell := @sSfCellNoStallU
        other:
            pCell := @sUnknownTok

PRI partDbgMaskCell() : pCell
' This part's R14-DUAL-DBGMASK-* cell id, and for the CLOCK part this clock's.
'
' @returns pCell - pointer to the cell id, "?" for PART_NONE and for a CLOCK build at an unswept clock

    case PART_ID
        PART_A:
            pCell := @sSfCellDbgMaskA
        PART_CLOCK:
            pCell := clockCell(@sSfCellDbgMaskK200, @sSfCellDbgMaskK270, @sSfCellDbgMaskK300)
        PART_B:
            pCell := @sSfCellDbgMaskB
        PART_BRAKE:
            pCell := @sSfCellDbgMaskH
        PART_C:
            pCell := @sSfCellDbgMaskC
        PART_D:
            pCell := @sSfCellDbgMaskD
        PART_FLOOR:
            pCell := @sSfCellDbgMaskF
        PART_UICHECK:
            pCell := @sSfCellDbgMaskU
        other:
            pCell := @sUnknownTok

PRI clockCell(pCell200, pCell270, pCell300) : pCell
' The compiled clock's cell id, chosen from a cell's three per-clock ids by SF_CLOCK_SLOT (design sec 12.10;
' reads only DAT, so it is safe from any cog).
'
' @param pCell200 - pointer to the cell's 200 MHz id
' @param pCell270 - pointer to the cell's 270 MHz id
' @param pCell300 - pointer to the cell's 300 MHz id
' @returns pCell - pointer to this clock's id, "?" at an unswept clock

    case SF_CLOCK_SLOT
        SF_CLOCK_200:
            pCell := pCell200
        SF_CLOCK_270:
            pCell := pCell270
        SF_CLOCK_300:
            pCell := pCell300
        other:
            pCell := @sUnknownTok

PRI emitSignoffDecls()
' One SIGNOFF-DECL per cell this build judges, before anything moves. A build that judges no cell (PART_NONE,
' or a CLOCK build at an unswept clock: SF_JUDGES_CELLS) declares nothing. Each cell id is a DAT string passed
' by @label on the emitter's own line, so the CLOCK part names each clock's labels under its SF_CLOCK_SLOT.

    if SF_JUDGES_CELLS
        case PART_ID
            PART_A:
                emitSignoffDecl(@sSfCellNoStallA)
                emitSignoffDecl(@sSfCellDbgMaskA)
                emitSignoffDecl(@sSfCellInstLive)
                emitSignoffDecl(@sSfCellIdleFlt)
                emitSignoffDecl(@sSfCellRevB)
                emitSignoffDecl(@sSfCellInteg)
                emitSignoffDecl(@sSfCellTracesA)
                emitSignoffDecl(@sSfCellLagA)
                emitSignoffDecl(@sSfCellNoFold)
                emitSignoffDecl(@sSfCellRateLaw)
                emitSignoffDecl(@sSfCellIdleMvA)
                emitSignoffDecl(@sSfCellTrKickA)
            PART_CLOCK:
                case SF_CLOCK_SLOT
                    SF_CLOCK_200:
                        emitSignoffDecl(@sSfCellNoStallK200)
                        emitSignoffDecl(@sSfCellDbgMaskK200)
                        emitSignoffDecl(@sSfCellClkFrameK200)
                        emitSignoffDecl(@sSfCellHallK200)
                    SF_CLOCK_270:
                        emitSignoffDecl(@sSfCellNoStallK270)
                        emitSignoffDecl(@sSfCellDbgMaskK270)
                        emitSignoffDecl(@sSfCellClkFrameK270)
                        emitSignoffDecl(@sSfCellHallK270)
                    SF_CLOCK_300:
                        emitSignoffDecl(@sSfCellNoStallK300)
                        emitSignoffDecl(@sSfCellDbgMaskK300)
                        emitSignoffDecl(@sSfCellClkFrameK300)
                        emitSignoffDecl(@sSfCellHallK300)
            PART_B:
                emitSignoffDecl(@sSfCellNoStallB)
                emitSignoffDecl(@sSfCellDbgMaskB)
                emitSignoffDecl(@sSfCellTracesB)
                emitSignoffDecl(@sSfCellRstProvB)
                emitSignoffDecl(@sSfCellRampRest)
                emitSignoffDecl(@sSfCellFltApi)
                emitSignoffDecl(@sSfCellLagB)
                emitSignoffDecl(@sSfCellStopCur)
                emitSignoffDecl(@sSfCellRmpDroop)
                emitSignoffDecl(@sSfCellStopLim)
                emitSignoffDecl(@sSfCellTurnDist)
                emitSignoffDecl(@sSfCellDistM)
                emitSignoffDecl(@sSfCellFltRetry)
                emitSignoffDecl(@sSfCellFltCause)
                emitSignoffDecl(@sSfCellOffRestB)
                emitSignoffDecl(@sSfCellIdleMvB)
            PART_BRAKE:
                emitSignoffDecl(@sSfCellNoStallH)
                emitSignoffDecl(@sSfCellDbgMaskH)
                emitSignoffDecl(@sSfCellBrakeFlt)
            PART_C:
                emitSignoffDecl(@sSfCellNoStallC)
                emitSignoffDecl(@sSfCellDbgMaskC)
                emitSignoffDecl(@sSfCellTracesC)
                emitSignoffDecl(@sSfCellRstProvC)
                emitSignoffDecl(@sSfCellOffRest)
                emitSignoffDecl(@sSfCellLagC)
                emitSignoffDecl(@sSfCellStpDecel)
                emitSignoffDecl(@sSfCellFltStop)
                emitSignoffDecl(@sSfCellIdleMvC)
            PART_D:
                emitSignoffDecl(@sSfCellNoStallD)
                emitSignoffDecl(@sSfCellDbgMaskD)
                emitSignoffDecl(@sSfCellLagD)
                emitSignoffDecl(@sSfCellEstopD)
                emitSignoffDecl(@sSfCellOrdered)
                emitSignoffDecl(@sSfCellCoopShut)
                emitSignoffDecl(@sSfCellTrackRst)
                emitSignoffDecl(@sSfCellTimeStop)
                emitSignoffDecl(@sSfCellLockStep)
                emitSignoffDecl(@sSfCellFrontSt)
                emitSignoffDecl(@sSfCellFoldBack)
                emitSignoffDecl(@sSfCellDerate)
                emitSignoffDecl(@sSfCellBlocked)
                emitSignoffDecl(@sSfCellWEstop)
                emitSignoffDecl(@sSfCellWTimStop)
                emitSignoffDecl(@sSfCellCmdTmo)
                emitSignoffDecl(@sSfCellWCmdTmo)
                emitSignoffDecl(@sSfCellDirSign)
            PART_FLOOR:
                emitSignoffDecl(@sSfCellNoStallF)
                emitSignoffDecl(@sSfCellDbgMaskF)
                emitSignoffDecl(@sSfCellFloorAns)
            PART_UICHECK:
                emitSignoffDecl(@sSfCellNoStallU)
                emitSignoffDecl(@sSfCellDbgMaskU)
                emitSignoffDecl(@sSfCellUiCheck)

PRI emitSignoffDecl(pCell)
' SIGNOFF-DECL for one cell: sf, bin, cell, task only (no seq: the collation reads exactly these
' fields). Worst case: tag(12) + sf(8) + bin(11) + cell(26) + task(11) = 68 bytes.
'
' @param pCell - pointer to the cell id

    benchLog.begin(@"SIGNOFF-DECL")
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.tokenField(@"bin", @sSfBin, TOKMAX_BIN)
    benchLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    benchLog.tokenField(@"task", @sSfTask, TOKMAX_TASK)
    emitRecord()

PRI emitSignoffs() | slotIdx, side
' Every declared cell's SIGNOFF instances, once, on cog 0's end path after the wheels, the steering
' object and the instrument are stopped. A build that judges no cell (SF_JUDGES_CELLS FALSE) emits none.
' A cell whose segment did not run prints NOMEAS, measured NA, n 0. Per part:
'  A      NOSTALL BOOL; DBGMASK BOOL; INSTLIVE BOOL per motor; IDLEFLT / REVB / INTEG COUNT per motor;
'         NOFOLD / RATELAW BOOL per motor; IDLEMOVE-A and TRKICK COUNT per motor; TRACES COUNT; LAGBOUND
'         COUNT per motor
'  CLOCK  this clock's NOSTALL BOOL, DBGMASK BOOL, and CLKFRAME BOOL and HALL COUNT per motor (-K200 /
'         -K270 / -K300)
'  B      NOSTALL BOOL; DBGMASK BOOL; TRACES COUNT; RSTPROV COUNT per motor; RAMPREST BOOL per motor;
'         FLTAPI BOOL (the steering object, BOTH); FLTCAUSE BOOL (BOTH); OFFREST-B BOOL and IDLEMOVE-B COUNT
'         per motor; STOPLIM and TURNDIST COUNT (BOTH); DISTM BOOL (BOTH)
'  D      NOSTALL BOOL; DBGMASK BOOL; LAGBOUND COUNT per motor; each part-D step's cell, DIRSIGN among them
'         (emitDStepCells())
'  BRAKE  NOSTALL BOOL; DBGMASK BOOL; BRAKEFLT BOOL (LEFT)
'  C      NOSTALL BOOL; DBGMASK BOOL; TRACES COUNT; RSTPROV COUNT per motor; OFFREST BOOL per motor;
'         IDLEMOVE-C COUNT and FLTSTOP BOOL per motor
'  FLOOR  NOSTALL BOOL; DBGMASK BOOL; FLOORANS BOOL
'  UI     NOSTALL BOOL; DBGMASK BOOL; UICHECK BOOL (every BM-UISTEP OK)
'
' @local slotIdx - motor slot
' @local side - SIDE_LEFT or SIDE_RIGHT

    beat(CP_EMIT)
    if SF_JUDGES_CELLS
        emitSignoffBool(partNoStallCell(), SIDE_NONE, @sSfCritCog0End, TRUE, TRUE, SIGNOFF_ONE_INSTANCE)
        emitSignoffBool(partDbgMaskCell(), SIDE_NONE, @sSfCritQuiet, TRUE, bQuietMasks, SIGNOFF_ONE_INSTANCE)
        case PART_ID
            PART_A:
                repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                    side := SIDE_LEFT + slotIdx
                    emitSignoffBool(@sSfCellInstLive, side, @sSfCritInstLive, bSfLiveRan[slotIdx], bSfLiveOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    emitSignoff(@sSfCellIdleFlt, side, @sSfCritIdleUp, sfFrameCaps[slotIdx] > 0, sfIdleUp[slotIdx], IDLE_UP_LO, IDLE_UP_HI, sfFrameCaps[slotIdx])
                    emitSignoff(@sSfCellRevB, side, @sSfCritNotRevB, sfStarts[slotIdx] > 0, sfNotRevb[slotIdx], NOT_REVB_LO, NOT_REVB_HI, sfStarts[slotIdx])
                    emitSignoff(@sSfCellInteg, side, @sSfCritInteg, sfStarts[slotIdx] > 0, sfIntegSum[slotIdx], INTEG_SUM_LO, INTEG_SUM_HI, sfStarts[slotIdx] + sfIntegN[slotIdx])
                    emitSignoffBool(@sSfCellNoFold, side, @sSfCritNoFold, bSfNoFoldRan[slotIdx], bSfNoFoldOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    emitSignoffBool(@sSfCellRateLaw, side, @sSfCritRateLaw, bSfRateLawRan[slotIdx], bSfRateLawOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    emitIdleMoveCell(@sSfCellIdleMvA, slotIdx)
                    ' task 3573: NOMEAS when no start from rest gave a control, or no running-speed change was judged
                    emitSignoff(@sSfCellTrKickA, side, @sSfCritTrKick, sfTrN[slotIdx] > 0, sfTrKicks[slotIdx], TRKICK_LO, TRKICK_HI, sfTrN[slotIdx])
                emitSignoff(@sSfCellTracesA, SIDE_NONE, @sSfCritTraces, sfTraces > 0, sfTraceLost, TRACE_LOST_LO, TRACE_LOST_HI, sfTraces)
                emitLagCells(@sSfCellLagA)
            PART_CLOCK:
                repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                    emitSignoffBool(clockCell(@sSfCellClkFrameK200, @sSfCellClkFrameK270, @sSfCellClkFrameK300), SIDE_LEFT + slotIdx, @sSfCritClkFrame, bSfClkRan[slotIdx], bSfClkOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    emitSignoff(clockCell(@sSfCellHallK200, @sSfCellHallK270, @sSfCellHallK300), SIDE_LEFT + slotIdx, @sSfCritHall, sfHallLives[slotIdx] > 0, sfHallIllegal[slotIdx], HALL_ILLEGAL_LO, HALL_ILLEGAL_HI, sfHallLives[slotIdx])
            PART_B:
                emitSignoff(@sSfCellTracesB, SIDE_NONE, @sSfCritTraces, sfTraces > 0, sfTraceLost, TRACE_LOST_LO, TRACE_LOST_HI, sfTraces)
                repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                    side := SIDE_LEFT + slotIdx
                    emitSignoff(@sSfCellRstProvB, side, @sSfCritRstProv, sfFaults[slotIdx] > 0, sfResetUncleared[slotIdx], RESET_UNCLEAR_LO, RESET_UNCLEAR_HI, sfFaults[slotIdx])
                    emitSignoffBool(@sSfCellRampRest, side, @sSfCritRampRest, bSfRampRan[slotIdx], bSfRampOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    emitSignoffBool(@sSfCellStopCur, side, @sSfCritStopCur, bSfStopCurRan[slotIdx], bSfStopCurOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    emitSignoffBool(@sSfCellRmpDroop, side, @sSfCritRmpDroop, bSfDroopRan[slotIdx], bSfDroopOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                emitSignoffBool(@sSfCellFltApi, SIDE_BOTH, @sSfCritFltApi, bSfFltApiRan, bSfFltApiOk, SIGNOFF_ONE_INSTANCE)
                emitSignoffBool(@sSfCellFltRetry, SIDE_BOTH, @sSfCritFltRetry, bSfRetryRan, bSfRetryOk, SIGNOFF_ONE_INSTANCE)
                ' task 3572: a lag fault reports FC_LAG on both wheels (S-7); measured only once the provocation faulted
                emitSignoffBool(@sSfCellFltCause, SIDE_BOTH, @sSfCritFltCause, bSfFltApiRan, (fltLeftCause == wheelL.FC_LAG) and (fltRightCause == wheelL.FC_LAG), SIGNOFF_ONE_INSTANCE)
                repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                    emitSignoffBool(@sSfCellOffRestB, SIDE_LEFT + slotIdx, @sSfCritOffRest, bSfOffRan[slotIdx], bSfOffOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    emitIdleMoveCell(@sSfCellIdleMvB, slotIdx)
                emitSignoff(@sSfCellStopLim, SIDE_BOTH, @sSfCritStopLim, sfStopLimN > 0, sfStopLimMax, STOP_LIMIT_LO, STOP_LIMIT_HI, sfStopLimN)
                ' task 3577 (AB): the turn trials, judged against the same band as a straight stop
                emitSignoff(@sSfCellTurnDist, SIDE_BOTH, @sSfCritTurnDist, sfTurnN > 0, sfTurnMax, STOP_LIMIT_LO, STOP_LIMIT_HI, sfTurnN)
                emitSignoffBool(@sSfCellDistM, SIDE_BOTH, @sSfCritDistM, bSfDistMRan, bSfDistMOk, SIGNOFF_ONE_INSTANCE)
                emitLagCells(@sSfCellLagB)
            PART_BRAKE:
                emitSignoffBool(@sSfCellBrakeFlt, SIDE_LEFT, @sSfCritBrakeFlt, bSfBrakeRan, bSfBrakeSeen, SIGNOFF_ONE_INSTANCE)
            PART_C:
                emitSignoff(@sSfCellTracesC, SIDE_NONE, @sSfCritTraces, sfTraces > 0, sfTraceLost, TRACE_LOST_LO, TRACE_LOST_HI, sfTraces)
                repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                    side := SIDE_LEFT + slotIdx
                    emitSignoff(@sSfCellRstProvC, side, @sSfCritRstProv, sfFaults[slotIdx] > 0, sfResetUncleared[slotIdx], RESET_UNCLEAR_LO, RESET_UNCLEAR_HI, sfFaults[slotIdx])
                    emitSignoffBool(@sSfCellOffRest, side, @sSfCritOffRest, bSfOffRan[slotIdx], bSfOffOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    emitSignoff(@sSfCellStpDecel, side, @sSfCritStpDecel, bSfDecelRan[slotIdx], sfDecelTicks[slotIdx], DECEL_TICKS_LO, DECEL_TICKS_HI, SIGNOFF_ONE_INSTANCE)
                    ' task 3572 (R17.1): measured only when both of this motor's provoked faults were captured
                    emitIdleMoveCell(@sSfCellIdleMvC, slotIdx)
                    emitSignoffBool(@sSfCellFltStop, side, @sSfCritFltStop, bSfFltStopRan[(slotIdx * MODE_COUNT) + MODE_FLOAT] and bSfFltStopRan[(slotIdx * MODE_COUNT) + MODE_BRAKE], sfFltStopTicks[(slotIdx * MODE_COUNT) + MODE_FLOAT] >= sfFltStopTicks[(slotIdx * MODE_COUNT) + MODE_BRAKE] + FLTSTOP_GAP_TICKS, SIGNOFF_ONE_INSTANCE)
                emitLagCells(@sSfCellLagC)
            PART_D:
                emitDStepCells()
                emitLagCells(@sSfCellLagD)
            PART_FLOOR:
                emitSignoffBool(@sSfCellFloorAns, SIDE_NONE, @sSfCritFloorAns, bSfFloorRan, bSfFloorAnswered, SIGNOFF_ONE_INSTANCE)
            PART_UICHECK:
                emitSignoffBool(@sSfCellUiCheck, SIDE_NONE, @sSfCritUiCheck, bSfUiRan, bSfUiOk, uiStepCount)

PRI emitIdleMoveCell(pCell, slotIdx)
' IDLEMOVE (task 3572): the other wheel's largest travel over every motor-frame trace this motor was primary in.
' NOMEAS when no such trace was frozen.
'
' @param pCell - pointer to this part's IDLEMOVE cell id
' @param slotIdx - the primary motor's slot

    emitSignoff(pCell, SIDE_LEFT + slotIdx, @sSfCritIdleMove, sfIdleMoveN[slotIdx] > 0, sfIdleMoveMax[slotIdx], IDLE_MOVE_LO, IDLE_MOVE_HI, sfIdleMoveN[slotIdx])

PRI emitLagCells(pCell) | slotIdx
' LAGBOUND's two instances, one per motor: the part's own cell id, judged on the instrument's running
' maximum. A part whose instrument stored no sample for a motor prints NOMEAS for it.
'
' @param pCell - pointer to this part's LAGBND cell id
'
' @local slotIdx - motor slot

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        emitSignoff(pCell, SIDE_LEFT + slotIdx, @sSfCritLag, instLagN[slotIdx] > 0, instLagMax[slotIdx], LAG_MAX_LO, LAG_MAX_HI, instLagN[slotIdx])

PRI emitDStepCells()
' Part D's cells. The steering object's instances carry SIDE_BOTH, the single wheel's SIDE_LEFT, and the
' two forms are judged separately because they are two different shapes of the same contract.

    emitSignoffBool(@sSfCellLockStep, SIDE_BOTH, @sSfCritLockStep, bSfDStepRan[DST_LOCKSTEP], bSfDStepOk[DST_LOCKSTEP], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellTrackRst, SIDE_BOTH, @sSfCritTrackRst, bSfDStepRan[DST_TRACKRESET], bSfDStepOk[DST_TRACKRESET], SIGNOFF_ONE_INSTANCE)
    ' the e-stop cell is the three claims together: a latch that refuses, holds and releases is one property
    emitSignoffBool(@sSfCellEstopD, SIDE_BOTH, @sSfCritEstopD, bDEstopRan(FALSE), bDEstopOk(FALSE), SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellOrdered, SIDE_BOTH, @sSfCritOrdered, bSfDStepRan[DST_ORDERED], bSfDStepOk[DST_ORDERED], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellTimeStop, SIDE_BOTH, @sSfCritTimeStop, bSfDStepRan[DST_TIMESTOP], bSfDStepOk[DST_TIMESTOP], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellCoopShut, SIDE_BOTH, @sSfCritCoopShut, bSfDStepRan[DST_COOPSHUT], bSfDStepOk[DST_COOPSHUT], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellFrontSt, SIDE_BOTH, @sSfCritFrontSt, bSfFrontRan[SLOT_LEFT], bSfFrontOk[SLOT_LEFT], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellFoldBack, SIDE_LEFT, @sSfCritFoldBack, bSfLimRan[SLOT_LEFT], bSfLimOk[SLOT_LEFT], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellFoldBack, SIDE_RIGHT, @sSfCritFoldBack, bSfLimRan[SLOT_RIGHT], bSfLimOk[SLOT_RIGHT], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellDerate, SIDE_LEFT, @sSfCritDerate, bSfDerateRan[SLOT_LEFT], bSfDerateOk[SLOT_LEFT], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellDerate, SIDE_RIGHT, @sSfCritDerate, bSfDerateRan[SLOT_RIGHT], bSfDerateOk[SLOT_RIGHT], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellBlocked, SIDE_BOTH, @sSfCritBlocked, bSfDStepRan[DST_BLOCKED], bSfDStepOk[DST_BLOCKED], SIGNOFF_ONE_INSTANCE)
    ' the single-wheel form: the same latch and the same time stop, with its own front cog
    emitSignoffBool(@sSfCellWEstop, SIDE_LEFT, @sSfCritEstopD, bDEstopRan(TRUE), bDEstopOk(TRUE), SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellWTimStop, SIDE_LEFT, @sSfCritTimeStop, bSfWDStepRan[DST_TIMESTOP], bSfWDStepOk[DST_TIMESTOP], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellFrontSt, SIDE_LEFT, @sSfCritFrontSt, bSfFrontRan[SLOT_RIGHT], bSfFrontOk[SLOT_RIGHT], SIGNOFF_ONE_INSTANCE)
    ' task 3570 (S-8): the command timeout, both forms
    emitSignoffBool(@sSfCellCmdTmo, SIDE_BOTH, @sSfCritCmdTmo, bSfDStepRan[DST_CMDTIMEOUT], bSfDStepOk[DST_CMDTIMEOUT], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellWCmdTmo, SIDE_LEFT, @sSfCritCmdTmo, bSfWDStepRan[DST_CMDTIMEOUT], bSfWDStepOk[DST_CMDTIMEOUT], SIGNOFF_ONE_INSTANCE)
    ' task 3577 (AC): the direction sign, the steering object only -- a single wheel has no direction
    emitSignoffBool(@sSfCellDirSign, SIDE_BOTH, @sSfCritDirSign, bSfDStepRan[DST_DIRSIGN], bSfDStepOk[DST_DIRSIGN], SIGNOFF_ONE_INSTANCE)

PRI bDEstopRan(bWheelForm) : bRan
' Whether all three e-stop steps of one form were measured.
'
' @param bWheelForm - TRUE for the single-wheel form, FALSE for the steering object
' @returns bRan - TRUE when refuse, latch and clear were all measured

    if bWheelForm
        bRan := bSfWDStepRan[DST_ESTOP_REFUSE] and bSfWDStepRan[DST_ESTOP_LATCH] and bSfWDStepRan[DST_ESTOP_CLEAR]
    else
        bRan := bSfDStepRan[DST_ESTOP_REFUSE] and bSfDStepRan[DST_ESTOP_LATCH] and bSfDStepRan[DST_ESTOP_CLEAR]

PRI bDEstopOk(bWheelForm) : bOk
' Whether all three e-stop steps of one form held. A latch that refuses but never releases, or releases
' but never held, is not an emergency stop -- so the cell is their conjunction, not three near-misses.
'
' @param bWheelForm - TRUE for the single-wheel form, FALSE for the steering object
' @returns bOk - TRUE when refuse, latch and clear all held

    if bWheelForm
        bOk := bSfWDStepOk[DST_ESTOP_REFUSE] and bSfWDStepOk[DST_ESTOP_LATCH] and bSfWDStepOk[DST_ESTOP_CLEAR]
    else
        bOk := bSfDStepOk[DST_ESTOP_REFUSE] and bSfDStepOk[DST_ESTOP_LATCH] and bSfDStepOk[DST_ESTOP_CLEAR]

PRI emitSignoff(pCell, side, pCrit, bMeasured, measuredVal, loLimit, hiLimit, instCount) | boundedVal, pVerdict
' One COUNT SIGNOFF verdict (test_bench_scan.spin2 emitSignoff(), units fixed to COUNT). Judged on the
' clamped printed value; PASS only when measured and in range; NOMEAS with measured NA and n 0 when not
' measured. Worst case 196 bytes.
'
' @param pCell - pointer to the cell id
' @param side - SIDE_NONE, SIDE_LEFT or SIDE_RIGHT
' @param pCrit - pointer to the criterion token
' @param bMeasured - TRUE when the instance was measured
' @param measuredVal - the measured count
' @param loLimit - lowest passing value
' @param hiLimit - highest passing value
' @param instCount - starts, captures, traces or faults behind measuredVal
'
' @local boundedVal - measuredVal clamped to +/-LIM_BIG
' @local pVerdict - PASS, FAIL or NOMEAS

    boundedVal := (measuredVal #> (0 - LIM_BIG)) <# LIM_BIG
    if bMeasured == FALSE
        pVerdict := @sSfNomeas
    elseif (boundedVal >= loLimit) and (boundedVal <= hiLimit)
        pVerdict := @sSfPass
    else
        pVerdict := @sSfFail
    benchLog.begin(@"SIGNOFF")
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.tokenField(@"bin", @sSfBin, TOKMAX_BIN)
    benchLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    benchLog.tokenField(@"task", @sSfTask, TOKMAX_TASK)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"crit", pCrit, TOKMAX_CRIT)
    benchLog.naNumField(@"measured", boundedVal, LIM_BIG, bMeasured)
    benchLog.numField(@"lo", loLimit, LIM_BIG)
    benchLog.numField(@"hi", hiLimit, LIM_BIG)
    benchLog.tokenField(@"units", @sSfUnitsCount, TOKMAX_UNITS)
    benchLog.numField(@"n", bMeasured ? instCount : 0, LIM_SMALL)
    benchLog.tokenField(@"verdict", pVerdict, TOKMAX_SFVERDICT)
    emitRecord()

PRI emitSignoffBool(pCell, side, pCrit, bMeasured, bCriterionMet, instCount) | pVerdict
' One BOOL SIGNOFF verdict: measured TRUE/FALSE (NA when not measured), lo TRUE, hi TRUE. PASS only
' when measured and TRUE. Worst case 173 bytes.
'
' @param pCell - pointer to the cell id
' @param side - SIDE_NONE, SIDE_LEFT or SIDE_RIGHT
' @param pCrit - pointer to the criterion token
' @param bMeasured - TRUE when the instance was measured
' @param bCriterionMet - TRUE when the whole criterion held
' @param instCount - instances behind the result
'
' @local pVerdict - PASS, FAIL or NOMEAS

    if bMeasured == FALSE
        pVerdict := @sSfNomeas
    elseif bCriterionMet <> FALSE
        pVerdict := @sSfPass
    else
        pVerdict := @sSfFail
    benchLog.begin(@"SIGNOFF")
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.tokenField(@"bin", @sSfBin, TOKMAX_BIN)
    benchLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    benchLog.tokenField(@"task", @sSfTask, TOKMAX_TASK)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"crit", pCrit, TOKMAX_CRIT)
    if bMeasured
        benchLog.boolField(@"measured", bCriterionMet)
    else
        benchLog.textField(@"measured", @sSfNa)
    benchLog.textField(@"lo", @sSfTrue)
    benchLog.textField(@"hi", @sSfTrue)
    benchLog.tokenField(@"units", @sSfUnitsBool, TOKMAX_UNITS)
    benchLog.numField(@"n", bMeasured ? instCount : 0, LIM_SMALL)
    benchLog.tokenField(@"verdict", pVerdict, TOKMAX_SFVERDICT)
    emitRecord()

CON { --- watchdog cog (test_bench_scan.spin2 pattern, design sec 4.3): runs in its own cog --- }

PRI watchdog() | lastSeenBeat, lastChangeMs, msSinceBeat
' Watch cog 0's heartbeat every WD_POLL_MS; declare a stall once it has not advanced for WD_STALL_MS.
' Runs forever: declareStall() never returns.
'
' @local lastSeenBeat - wdHeartbeat at the previous sample
' @local lastChangeMs - getms() when wdHeartbeat last changed
' @local msSinceBeat - ms since wdHeartbeat last changed

    lastSeenBeat := wdHeartbeat
    lastChangeMs := getms()
    repeat
        waitms(WD_POLL_MS)
        if wdHeartbeat <> lastSeenBeat
            lastSeenBeat := wdHeartbeat
            lastChangeMs := getms()
        else
            msSinceBeat := getms() - lastChangeMs
            if msSinceBeat >= WD_STALL_MS
                declareStall(msSinceBeat)

PRI declareStall(msSinceBeat)
' Cog 0 has stalled: set wdDeclaring first, snapshot, stop wheelL, wheelR and the steering object
' (never through a beat() wrapper), then emit BM-WATCHDOG, BM-WATCHDOG2, this part's NOSTALL FAIL,
' BM-END exit WATCHDOG and the marker through the watchdog's own builder, and idle forever. It never
' commands the instrument (not its value to write, sec 2.4). Its seq continues from logSeq.
'
' @param msSinceBeat - ms since wdHeartbeat last changed

    wdDeclaring := TRUE
    wdSeq := logSeq
    wdSnapshotStall()
    benchLog.cogEventBegin()
    wheelL.stop()
    wheelR.stop()
    steering.stop()
    wdEmitWatchdog(msSinceBeat)
    wdEmitWatchdog2()
    if SF_JUDGES_CELLS
        wdEmitNoStall()
    wdEmitEnd()
    ' QUOTED, not backticked: matches main()'s marker exactly
    debug("DEBUG_END_SESSION")
    repeat
        waitms(WD_IDLE_MS)

PRI wdSnapshotStall()
' Snapshot, before the stops, every value the watchdog records report (watchdog cog). The source is the
' steering object when either of its drivers is up, else the two wheel instances. Direct getters only.

    wdSnapCheckpoint := wdCheckpoint
    wdSnapInstState := instState
    wdSnapLeftCog := wheelL.testGetMotorCog()
    wdSnapRightCog := wheelR.testGetMotorCog()
    wdSnapState[SLOT_LEFT], wdSnapState[SLOT_RIGHT] := steering.testGetDriverState()
    wdSnapSteerUp := (wdSnapState[SLOT_LEFT] <> DCS_UNKNOWN) or (wdSnapState[SLOT_RIGHT] <> DCS_UNKNOWN)
    if wdSnapSteerUp
        wdSnapDuty[SLOT_LEFT], wdSnapErr[SLOT_LEFT], wdSnapSenseI[SLOT_LEFT], _, _, _, wdSnapState[SLOT_LEFT], wdSnapFault[SLOT_LEFT] := steering.testLeftGetTelemetry()
        wdSnapDuty[SLOT_RIGHT], wdSnapErr[SLOT_RIGHT], wdSnapSenseI[SLOT_RIGHT], _, _, _, wdSnapState[SLOT_RIGHT], wdSnapFault[SLOT_RIGHT] := steering.testRightGetTelemetry()
        wdSnapPos[SLOT_LEFT], wdSnapPos[SLOT_RIGHT] := steering.testGetRawHallTicks()
    else
        wdSnapDuty[SLOT_LEFT], wdSnapErr[SLOT_LEFT], wdSnapSenseI[SLOT_LEFT], _, _, _, wdSnapState[SLOT_LEFT], wdSnapFault[SLOT_LEFT] := wheelL.testGetTelemetry()
        wdSnapDuty[SLOT_RIGHT], wdSnapErr[SLOT_RIGHT], wdSnapSenseI[SLOT_RIGHT], _, _, _, wdSnapState[SLOT_RIGHT], wdSnapFault[SLOT_RIGHT] := wheelR.testGetTelemetry()
        wdSnapPos[SLOT_LEFT] := wheelL.getRawHallTicks()
        wdSnapPos[SLOT_RIGHT] := wheelR.getRawHallTicks()

PRI wdRecBegin(pTag)
' Start a watchdog record in wdLog (never cog 0's builder) with the watchdog's own seq.
'
' @param pTag - pointer to the record tag

    wdLog.begin(pTag)
    wdSeq := (wdSeq + 1) <# LIM_MID
    wdLog.numField(@"seq", wdSeq, LIM_MID)

PRI wdEmitRecord() | pRecord
' Emit the watchdog's assembled record: the watchdog's one record debug() statement. No beat().
'
' @local pRecord - pointer to the zero-terminated record

    pRecord := wdLog.pLine()
    debug(zstr_(pRecord))

PRI wdEmitWatchdog(msSinceBeat)
' BM-WATCHDOG. Worst case 142 bytes.
'
' @param msSinceBeat - ms since wdHeartbeat last changed

    wdRecBegin(@"BM-WATCHDOG")
    wdLog.numField(@"ms", msSinceBeat, LIM_SMALL)
    wdLog.numField(@"checkpoint", wdSnapCheckpoint, LIM_TINY)
    wdLog.tokenField(@"cp_tok", tokenAt(@tokCp, CP_COUNT, wdSnapCheckpoint), TOKMAX_CP)
    wdLog.numField(@"l_cog", wdSnapLeftCog, LIM_TINY)
    wdLog.numField(@"r_cog", wdSnapRightCog, LIM_TINY)
    wdLog.boolField(@"steer_up", wdSnapSteerUp)
    wdLog.tokenField(@"inst_state", tokenAt(@tokInstSt, INST_ST_COUNT, wdSnapInstState), TOKMAX_INSTST)
    wdLog.boolField(@"stack_ok", wdStackSentinel == WD_STACK_SENTINEL)
    wdEmitRecord()

PRI wdEmitWatchdog2()
' BM-WATCHDOG2: both motors' pre-stop telemetry. Worst case 193 bytes.

    wdRecBegin(@"BM-WATCHDOG2")
    wdLog.tokenField(@"l_st", dcsToken(wdSnapState[SLOT_LEFT]), TOKMAX_STATE)
    wdLog.boolField(@"l_flt", wdSnapFault[SLOT_LEFT])
    wdLog.numField(@"l_duty", wdSnapDuty[SLOT_LEFT], LIM_SMALL)
    wdLog.numField(@"l_err", wdSnapErr[SLOT_LEFT], LIM_TINY)
    wdLog.numField(@"l_i", wdSnapSenseI[SLOT_LEFT], LIM_SMALL)
    wdLog.numField(@"l_pos", wdSnapPos[SLOT_LEFT], LIM_MID)
    wdLog.tokenField(@"r_st", dcsToken(wdSnapState[SLOT_RIGHT]), TOKMAX_STATE)
    wdLog.boolField(@"r_flt", wdSnapFault[SLOT_RIGHT])
    wdLog.numField(@"r_duty", wdSnapDuty[SLOT_RIGHT], LIM_SMALL)
    wdLog.numField(@"r_err", wdSnapErr[SLOT_RIGHT], LIM_TINY)
    wdLog.numField(@"r_i", wdSnapSenseI[SLOT_RIGHT], LIM_SMALL)
    wdLog.numField(@"r_pos", wdSnapPos[SLOT_RIGHT], LIM_MID)
    wdEmitRecord()

PRI wdEmitNoStall()
' This part's R14-DUAL-NOSTALL-* as FAIL from the watchdog cog: measured FALSE, n 1. Worst case 173 bytes.

    wdLog.begin(@"SIGNOFF")
    wdLog.numField(@"sf", SF_VERSION, LIM_TINY)
    wdLog.tokenField(@"bin", @sSfBin, TOKMAX_BIN)
    wdLog.tokenField(@"cell", partNoStallCell(), TOKMAX_CELL)
    wdLog.tokenField(@"task", @sSfTask, TOKMAX_TASK)
    wdLog.tokenField(@"motor", sideToken(SIDE_NONE), TOKMAX_MOTOR)
    wdLog.tokenField(@"crit", @sSfCritCog0End, TOKMAX_CRIT)
    wdLog.boolField(@"measured", FALSE)
    wdLog.textField(@"lo", @sSfTrue)
    wdLog.textField(@"hi", @sSfTrue)
    wdLog.tokenField(@"units", @sSfUnitsBool, TOKMAX_UNITS)
    wdLog.numField(@"n", SIGNOFF_ONE_INSTANCE, LIM_SMALL)
    wdLog.tokenField(@"verdict", @sSfFail, TOKMAX_SFVERDICT)
    wdEmitRecord()

PRI wdEmitEnd()
' BM-END exit WATCHDOG from the watchdog cog; trap_code NA because runPart() never returned to main().
' Worst case 152 bytes.

    wdRecBegin(@"BM-END")
    wdLog.tokenField(@"exit", tokenAt(@tokExit, EXIT_COUNT, EXIT_WATCHDOG), TOKMAX_EXIT)
    wdLog.tokenField(@"part", tokenAt(@tokPart, PART_COUNT, PART_ID), TOKMAX_PART)
    wdLog.numField(@"segs", segsRun, LIM_TINY)
    wdLog.tokenField(@"last_seg", segToken(lastSeg), TOKMAX_SEG)
    wdLog.numField(@"records", wdSeq, LIM_MID)
    wdLog.naNumField(@"trap_code", 0, LIM_BIG, FALSE)
    wdLog.numField(@"unrecov", unrecovTotal, LIM_TINY)
    wdLog.tokenField(@"why", tokenAt(@tokWhy, WHY_COUNT, WHY_NOT_REACHED), TOKMAX_WHY)
    wdEmitRecord()

CON { --- cog-0 heartbeat --- }

PRI beat(checkpointId)
' Advance cog 0's heartbeat and record its checkpoint (cog 0 only; the watchdog and the instrument must
' never call this). Once the watchdog has declared, beat() never returns: a slow cog 0 that resumes
' parks here and cannot command a motor the watchdog already stopped (test_bench_scan.spin2 beat()).
'
' @param checkpointId - CP_* naming the statement group cog 0 is now inside

    if wdDeclaring
        repeat
            waitms(WD_IDLE_MS)
    wdCheckpoint := checkpointId
    wdHeartbeat += 1

