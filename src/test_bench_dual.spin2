VAR { rung staging -- filled by rungMeasure(), read by the rung emitters and the folds }

    LONG    rgResult                                        ' RES_* of the rung
    LONG    rgWhy                                           ' WHY_* naming the cause of every NA
    LONG    rgSteadyMs                                      ' ms from command to AT_SPEED
    LONG    bRgSteadyValid
