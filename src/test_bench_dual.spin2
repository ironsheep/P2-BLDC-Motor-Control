VAR { part D: the ordered-stop helper cog (task 3560) }

' The ORDERED step needs a SECOND cog commanding the platform while cog 0 stops it, because the property
'  under test -- that a stop ordered during another cog's drive leaves both wheels in one state -- cannot
'  arise from a single cog's calls. The helper only drives; every stop, every reading and every record
'  stays on cog 0.
    LONG    odStack[D_ORDERED_STACK_LONGS]
    LONG    odCogId                                         ' cogspin()'s return; < 0 when it failed
    LONG    bOdRun                                          ' cog 0 raises this to start driving, lowers it to end
    LONG    odDrives                                        ' drive calls the helper has made
    LONG    odLastErr                                       ' the last drive call's return, read after the step
    LONG    bOdDone                                         ' the helper has left its loop

VAR { watchdog cog }

    LONG    wdStack[WD_STACK_LONGS]
    LONG    wdStackSentinel                                 ' MUST abut wdStack (P2AN006); checked on the stall path
    LONG    wdCogId
    LONG    wdSeq                                           ' the watchdog's record seq, from logSeq at declaration
    LONG    wdSnapCheckpoint
    LONG    wdSnapLeftCog
    LONG    wdSnapRightCog
    LONG    wdSnapSteerUp
    LONG    wdSnapInstState
    LONG    wdSnapDuty[INST_MOTORS]
    LONG    wdSnapErr[INST_MOTORS]
    LONG    wdSnapSenseI[INST_MOTORS]
    LONG    wdSnapState[INST_MOTORS]
    LONG    wdSnapFault[INST_MOTORS]
    LONG    wdSnapPos[INST_MOTORS]

PUB main() | trapCode
'' Run this build's part of the motion harness, then stop every cog it started and end the session.
''

' Local Variables:
' @local trapCode - value delivered by the one top-level trap around runPart() (I9)

    initRunState()
    wdStackSentinel := WD_STACK_SENTINEL                    ' in place before the cog that could overrun it
    benchLog.cogEventBegin()
    wdCogId := cogspin(NEWCOG, watchdog(), @wdStack)
    benchLog.cogEventEnd()
    emitWdStart(wdCogId >= 0, wdCogId)
    emitHeaderRecords()
    instStart()
    bRunReturned := FALSE
    trapCode := \runPart()                                  ' the ONLY trap in this file (I9)
    runTrapCode := trapCode
    instIdleForShutdown()                                   ' I10: no wheel is stopped under a reading instrument
    shutdownAll()
    instStop()
    ' The watchdog is stopped only when it is not declaring (test_bench_scan.spin2 main()); if it is,
    '  its records are the session's end and cog 0 parks without emitting.
    if wdDeclaring == FALSE
        if wdCogId >= 0
            benchLog.cogEventBegin()
            cogstop(wdCogId)
        emitLagAll()                                        ' one BM-LAG per motor, covering every capture this part took
        emitSignoffs()
        emitTrap(trapCode, bRunReturned)
        emitEnd(bRunAborted ? EXIT_ABORTED : EXIT_COMPLETE)
#ifdef DBP_SPIN
        floorResult()                                       ' SRC_REV 69: the one plain RESULT line, printed last, before the session ends
#endif
        ' QUOTED, not backticked: a backtick makes it a display command and the marker is missed
        debug("DEBUG_END_SESSION")
    else
        repeat
            waitms(WD_IDLE_MS)

PRI initRunState() | slotIdx
' Reset every run-wide counter, lifetime slot and sign-off accumulator before anything is emitted.
'
' @local slotIdx - motor slot

    beat(CP_INIT)
    logSeq := 0
    runStartMs := getms()
    bRunAborted := FALSE
    bRunReturned := FALSE
    runTrapCode := 0
    runFaults := 0
    unrecovTotal := 0
    segsRun := 0
    lastSeg := SEG_NONE
    curSeg := SEG_NONE
    curTid := 0
    curIncre := 0
    lastStartMs := runStartMs
    bAnyStart := FALSE
    lifeSeq := 0
    traceSeq := 0
    rungSeq := 0
    steerSeq := 0
    steerLife := 0
    bSteerUp := FALSE
    instBusyRefusals := 0
    instCogId := -1
    instCmdSeq := 0
    instAckSeq := 0
    instState := INST_ST_IDLE
    instSrc := INST_SRC_NONE
    instDecimate := 1
    sfTraces := 0
    sfTraceLost := 0
    bSfFltApiRan := FALSE
    bSfFltApiOk := FALSE
    fltLeftInc := 0
    fltRightInc := 0
    fltFaultMs := 0
    fltLatchMs := 0
    bSfBrakeRan := FALSE
    bSfBrakeSeen := FALSE
    bSfFloorRan := FALSE
    bSfFloorAnswered := FALSE
    bSfUiRan := FALSE
    bSfUiOk := FALSE
    uiStepCount := 0
    sfStopLimMax := 0
    sfStopLimN := 0
    sfTurnMax := 0
    sfTurnN := 0
    bSfDistMRan := FALSE
    bSfDistMOk := TRUE                                      ' ANDed over the trials that run; NOMEAS until one does
    bSfRetryRan := FALSE
    bSfRetryOk := FALSE
    fltRetryErr := 0
    fltRetryMs := 0
    bFltRetryOk := FALSE
    bInstLagExempt := FALSE
    odCogId := -1
    bOdRun := FALSE
    bOdDone := FALSE
    odDrives := 0
    odLastErr := 0
    repeat slotIdx from 0 to DST_COUNT - 1
        bSfDStepRan[slotIdx] := FALSE
        bSfDStepOk[slotIdx] := FALSE
        bSfWDStepRan[slotIdx] := FALSE
        bSfWDStepOk[slotIdx] := FALSE
    uiPressReset()
    outCount := 0
    operQueueCount := 0
    bPanelUp := FALSE
    pnlPressed := PNL_BTN_NONE
    pnlSeconds := PNL_NO_COUNTDOWN
    operPromptCode := PROMPT_BRAKE_L
    bOutMarked := FALSE
    bFlDrove := FALSE
    bQuietMasks := (user.MOTOR_DBG_MASK == QUIET_DBG_MASK) and (user.STEER_DBG_MASK == QUIET_DBG_MASK)
    bSfTokTabOk := FALSE                                    ' SRC_REV 71: TOKTAB is TRUE only once the self-check has run and found nothing
    sfTokTabN := 0
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        slotLife[slotIdx] := 0
        bSlotRetired[slotIdx] := FALSE
        lifeZeroX10[slotIdx] := 0
        lifePhX10[slotIdx] := 0
        bLifeZeroValid[slotIdx] := FALSE
        bBrakeRequested[slotIdx] := FALSE
        safeAbsCount[slotIdx] := 0
        sfStarts[slotIdx] := 0
        sfNotRevb[slotIdx] := 0
        sfIntegSum[slotIdx] := 0
        sfIntegN[slotIdx] := 0
        bSfLiveRan[slotIdx] := FALSE
        bSfLiveOk[slotIdx] := FALSE
        sfFrameCaps[slotIdx] := 0
        sfIdleUp[slotIdx] := 0
        bSfClkRan[slotIdx] := FALSE
        bSfClkOk[slotIdx] := FALSE
        sfFaults[slotIdx] := 0
        sfResetUncleared[slotIdx] := 0
        bSfRampRan[slotIdx] := FALSE
        bSfRampOk[slotIdx] := FALSE
        bSfOffRan[slotIdx] := FALSE
        bSfOffOk[slotIdx] := TRUE                           ' ANDed over every restore; NOMEAS until one ran
        instLagMax[slotIdx] := 0
        instLagN[slotIdx] := 0
        bSfNoFoldRan[slotIdx] := FALSE
        bSfNoFoldOk[slotIdx] := TRUE                        ' ANDed over the base rungs
        srvHuntSigns[slotIdx] := 0
        bSfSrvHuntOk[slotIdx] := TRUE                       ' ANDed over every judged window
        srvKeepSigns[slotIdx] := 0
        bSfSrvKeepOk[slotIdx] := TRUE
        bSfRateLawRan[slotIdx] := FALSE
        bSfRateLawOk[slotIdx] := TRUE                       ' ANDed over the base rungs with a valid window
        bSfStopCurRan[slotIdx] := FALSE
        bSfStopCurOk[slotIdx] := TRUE                       ' ANDed over the trials that reached speed
        bSfDroopRan[slotIdx] := FALSE
        bSfDroopOk[slotIdx] := TRUE                         ' ANDed over the steep-ramp trials
        sfDecelTicks[slotIdx] := 0
        bSfDecelRan[slotIdx] := FALSE
        bSfLimRan[slotIdx] := FALSE
        bSfLimOk[slotIdx] := FALSE
        bSfDerateRan[slotIdx] := FALSE
        bSfDerateOk[slotIdx] := FALSE
        bSfFrontRan[slotIdx] := FALSE
        bSfFrontOk[slotIdx] := FALSE
        scHoldIX10[slotIdx] := 0
        scHoldPk[slotIdx] := 0
        scStopPk[slotIdx] := 0
        scSamples[slotIdx] := 0
        bScValid[slotIdx] := FALSE
        sfTrN[slotIdx] := 0                                 ' TRKICK's two accumulators and the from_incre state
        sfTrKickPk[slotIdx] := 0
        slotLastIncre[slotIdx] := 0
    ' PL-152: each part's own accumulators are reset in its own build only, beside the code that folds them
#ifdef DBP_FAULTRESP
    frResetCells()                                          ' task 3613: the FAULTRESP part's accumulators
#endif
#ifdef DBP_START
    skResetCells()                                          ' task 3613: the START part's accumulators
#endif
#ifdef DBP_SPIN
    spResetCells()                                          ' task 3591: the SPIN part's accumulators
#endif
#ifdef DBG_FENCE
    sessReset()                                             ' SRC_REV 70: the floor session's fence and its counters
#endif
#ifdef DBP_PACK
    pkResetCells()                                          ' task 3611: the PACK part's
#endif
    r20ResetCells()                                         ' task 3621: EV-LATE's and part D's event cells
#ifdef DBP_D
    rcResetCells()                                          ' task 3623: RESTCOAST's
#endif

PRI runPart()
' Run this build's segments in the design's sec 4.1 order. Every segment after a run abort is emitted
' as BM-SEG SKIP ABORTED and not run. No part flag: nothing runs.
'
' Returns no value, so the top-level trap in main() carries only an abort code (0 when none), and
' bRunReturned alone says whether runPart() reached its end (I9: one value, one meaning).
'
' PL-152: one #ifdef chain on the DBP_* symbols, where this was a case on PART_ID -- the same selection, made at
' compile time, so a build holds only its own part's calls (and so its own part's code).

#ifdef DBP_A
    runSegment(SEG_PREFLT)
    runSegment(SEG_STOPMODE)
    runSegment(SEG_LIVE)
    runSegment(SEG_LADDER)
    runSegment(SEG_LOWSPD)
    runSegment(SEG_TAKE)                                    ' task 3584: Visit 8's A-6 and A-8 (following)
#elseifdef DBP_CLOCK
    runSegment(SEG_PREFLT)
    runSegment(SEG_CLOCK)
#elseifdef DBP_B
    runSegment(SEG_PREFLT)
    runSegment(SEG_FAULTB)
    runSegment(SEG_OVERSHT)
#elseifdef DBP_BRAKE
    runSegment(SEG_OUTSIDE)
#elseifdef DBP_C
    runSegment(SEG_PREFLT)
    runSegment(SEG_BASELINE)
    runSegment(SEG_POSTFLT)
#elseifdef DBP_D
    runSegment(SEG_PREFLT)
    runSegment(SEG_STEERSEG)
    runSegment(SEG_LIMIT)
#elseifdef DBP_FLOOR
    runSegment(SEG_FLOOR)
#elseifdef DBP_UICHECK
    runSegment(SEG_UICHECK)
#elseifdef DBP_ALIGN
    runSegment(SEG_ALIGN)
#elseifdef DBP_LEAD
    runSegment(SEG_PREFLT)
    runSegment(SEG_LEAD)
#elseifdef DBP_LIMITS
    runSegment(SEG_PREFLT)
    runSegment(SEG_LIMTOP)
    if BUILD_TOP_ONLY == FALSE                               ' dual-limits-top: the confirming climb only (task 3605)
        runSegment(SEG_LIMRAMP)
        runSegment(SEG_LIMLOW)
#elseifdef DBP_FAULTRESP
    runSegment(SEG_PREFLT)
    runSegment(SEG_FLTRESP)                                 ' task 3613: X-3, X-2, X-4 per wheel
    runSegment(SEG_FLTPLAT)                                 ' task 3613: X-5 through the steering object
#elseifdef DBP_START
    runSegment(SEG_SKCHECK)                                 ' task 3613: B-2 and B-5, no PREFLT (the part's CON says why)
#elseifdef DBP_SPIN
    ' SRC_REV 69: ONE floor action, once (Stephen 2026-09-30, R4: "we just run the test sequentially. Again."), after the
    ' lead-in and nothing more (R3); no PREFLT (the part's CON says why). A build with no action symbol runs nothing.
    ' SRC_REV 65: INCLINE is not run -- Stephen, 2026-09-29: "postpone the incline testing until we've returned all other
    ' results and have corrected the driver using them". Its code is compiled out (DBG_INCLINE, defined by no build).
#ifndef DBF_NONE
    floorLeadIn()                                           ' nothing can move before it ends
#endif
#ifdef DBF_AUTO
    ' SRC_REV 70, SESSION 2 (R15): the three parts back to back, in the order the plan gives -- the spins are in place, so they
    '  come first and leave the platform where it stood; then the two straight actions, each out and back to the start
    runSegment(SEG_SPIN)                                    ' the ten spin legs, alternating direction, the event log drained after each
    runSegment(SEG_FAULTRUN)                                ' the fault run, whole
    runSegment(SEG_RAMP)                                    ' the ramp legs: three accelerations, three decelerations
#else
#ifdef DBF_OBST
    runSegment(SEG_OBSTACLE)                                ' the protective stop on an obstacle (PL-106, 111, 132, 95); SESSION 3: both trials
#endif
#ifdef DBF_GRAB
    runSegment(SEG_GRAB)                                    ' one side held back (PL-150, 144, 95)
#endif
#ifdef DBF_FAULTRUN
    runSegment(SEG_FAULTRUN)                                ' a fault on the way back, and the drive after it (PL-93, X-5)
#endif
#ifdef DBF_SPINLEG
    runSegment(SEG_SPIN)                                    ' one spin leg: the commutation offsets under load
#endif
#endif
#elseifdef DBP_PACK
    runSegment(SEG_PACK)                                    ' task 3611: R20.4, nothing moves (the part's CON says why)
#elseifdef DBP_REG
    runSegment(SEG_PREFLT)
    runSegment(SEG_REGRESS)                                 ' PL-151: TURNDIST, then FLTCAUSE and FLTRETRY on forced faults
#elseifdef DBP_KICK
    runSegment(SEG_PREFLT)
    runSegment(SEG_KICK)                                    ' PL-78 / PL-87: the top-of-range transitions
#endif
    bRunReturned := TRUE                                  ' before the return, or main() reads a library abort

#ifdef DBP_NONE
#elseifdef DBF_NONE
#else
PRI runSegment(seg)
' Run one segment when the run caps allow it; otherwise record that it was skipped.
'
' PL-152: each branch is compiled into the parts that run its segment only (a PART_NONE build, and a PART_SPIN build
' with no floor action, run no segment and hold no runSegment()).
'
' @param seg - SEG_* to run

    if bRunContinue(seg)
        case seg
#ifdef DBG_PREFLT
            SEG_PREFLT:
                if bSegPreflight() == FALSE
                    bRunAborted := TRUE
#endif
#ifdef DBP_A
            SEG_STOPMODE:
                segStopMode()
            SEG_LIVE:
                segLive()
            SEG_LADDER:
                segLadder()
            SEG_LOWSPD:
                segLowSpeed()
            SEG_TAKE:
                segTake()
#endif
#ifdef DBP_CLOCK
            SEG_CLOCK:
                segClock()
#endif
#ifdef DBP_B
            SEG_FAULTB:
                segFaultBoundary()
            SEG_OVERSHT:
                segOvershoot()
#endif
#ifdef DBP_BRAKE
            SEG_OUTSIDE:
                segOutside()
#endif
#ifdef DBP_C
            SEG_BASELINE:
                segBaseline()
            SEG_POSTFLT:
                segPostFault()
#endif
#ifdef DBP_D
            SEG_STEERSEG:
                segSteerContract()
            SEG_LIMIT:
                segCurrentLimits()
#endif
#ifdef DBP_FLOOR
            SEG_FLOOR:
                segFloor()
#endif
#ifdef DBP_UICHECK
            SEG_UICHECK:
                segUiCheck()
#endif
#ifdef DBP_ALIGN
            SEG_ALIGN:
                segAlign()
#endif
#ifdef DBP_LEAD
            SEG_LEAD:
                segLead()
#endif
#ifdef DBP_LIMITS
            SEG_LIMTOP:
                segLimTop()
            SEG_LIMRAMP:
                segLimRamp()
            SEG_LIMLOW:
                segLimLow()
#endif
#ifdef DBP_FAULTRESP
            SEG_FLTRESP:
                segFaultResp()
            SEG_FLTPLAT:
                segFaultPlat()
#endif
#ifdef DBP_START
            SEG_SKCHECK:
                segStartChecks()
#endif
#ifdef DBF_OBST
            SEG_OBSTACLE:
                segBlock()
#endif
#ifdef DBF_GRAB
            SEG_GRAB:
                segLoad()
#endif
#ifdef DBF_FAULTRUN
            SEG_FAULTRUN:
                segFaultRun()
#endif
#ifdef DBF_SPINLEG
            SEG_SPIN:
                segSpin()
#endif
#ifdef DBF_RAMP
            SEG_RAMP:
                segRamp()
#endif
#ifdef DBP_PACK
            SEG_PACK:
                segPack()
#endif
#ifdef DBP_REG
            SEG_REGRESS:
                segRegress()
#endif
#ifdef DBP_KICK
            SEG_KICK:
                segKick()
#endif
    else
        emitSeg(seg, SEGEV_SKIP, bSegAttended(seg), 0, 0, 0, 0, WHY_ABORTED)
#endif

PRI bRunContinue(seg) : bContinue | elapsedS
' Check the run caps (design sec 4.2 item 6) before a segment or trial; the first cap hit records a
' run-scope BM-ABORT once.
'
' @param seg - SEG_* about to run, for the abort record
' @returns bContinue - TRUE when the run has not aborted
'
' @local elapsedS - seconds since run start

    if bRunAborted == FALSE
        elapsedS := (getms() - runStartMs) / MS_PER_SEC
        if elapsedS >= RUN_TIME_CAP_S
            emitAbort(seg, curTid, SIDE_NONE, curIncre, ABR_TIME_CAP, elapsedS, SCOPE_RUN)
            bRunAborted := TRUE
        elseif runFaults >= RUN_FAULT_CAP
            emitAbort(seg, curTid, SIDE_NONE, curIncre, ABR_FAULT_CAP, runFaults, SCOPE_RUN)
            bRunAborted := TRUE
    bContinue := (bRunAborted == FALSE)

PRI bSegAttended(seg) : bAttended
' Report whether a segment needs a person at the rig (OUTSIDE, FLOOR, UICHECK, ALIGN, PACK, and the floor run's
' OBSTACLE, GRAB, INCLINE, FAULTRUN, SPIN and, SRC_REV 70, RAMP).
'
' ALIGN is attended in a way none of the others are: the person is not watching the run, he IS the
' actuator -- every leg advances only because he turns the wheel by hand. PACK shares some of that: each of its
' steps after the first is his unplugging or replugging the pack sensor. So do OBSTACLE, where he may be the obstacle,
' and GRAB, where his hold on the frame is the load.
'
' @param seg - SEG_* value
' @returns bAttended - TRUE for an attended segment

    bAttended := (seg == SEG_OUTSIDE) or (seg == SEG_FLOOR) or (seg == SEG_UICHECK) or (seg == SEG_ALIGN)
    bAttended := bAttended or (seg == SEG_SPIN) or (seg == SEG_INCLINE) or (seg == SEG_PACK)
    bAttended := bAttended or (seg == SEG_OBSTACLE) or (seg == SEG_GRAB) or (seg == SEG_FAULTRUN) or (seg == SEG_RAMP)

PRI segBegin(seg)
' Open a segment: reset its counters and emit BM-SEG BEGIN.
'
' @param seg - SEG_* value

    curSeg := seg
    lastSeg := seg
    segsRun := (segsRun + 1) <# LIM_TINY
    segStartMs := getms()
    segItems := 0
    segFaults := 0
    segUnrecov := 0
    emitSeg(seg, SEGEV_BEGIN, bSegAttended(seg), 0, 0, 0, 0, WHY_NONE)

PRI segEnd(whyCode)
' Close the segment in progress with BM-SEG END and its counts.
'
' @param whyCode - WHY_* naming why the segment ended short, or WHY_NONE

    emitSeg(curSeg, SEGEV_END, bSegAttended(curSeg), segItems, segFaults, segUnrecov, getms() - segStartMs, whyCode)
    curSeg := SEG_NONE
    curTid := 0

#ifdef DBP_A
PRI segStopMode() | side, speedIdx, signMul, repIdx
' STOPMODE (part A, T1-1): C-4 deceleration data and the S-9a FLOAT / BRAKE / pins-cleared baselines.
' Per motor x speed (QTR, HALF) x sign (NEG, POS) x STOPMODE_REPS: one driver lifetime, three traces,
' and on the first repetition of each cell a fourth -- the START trace (task 3593, R18.2d).
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local speedIdx - 0 QTR, 1 HALF
' @local signMul - SIGN_NEG then SIGN_POS
' @local repIdx - 0..STOPMODE_REPS-1; the START trace rides repetition 0 only

    segBegin(SEG_STOPMODE)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat speedIdx from 0 to STOPMODE_SPEEDS - 1
            repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
                repeat repIdx from 0 to STOPMODE_REPS - 1
                    beat(CP_LOOP_POLL)
                    ' task 3593 (R18.2d): the START trace rides the first rep of the QTR cells only --
                    '  both motors, both directions, four traces. QTR is chosen and not HALF because
                    '  QTR_SPEED_INCRE IS the speed Visit 7b's from-rest aggregates were taken at, so the
                    '  trace is directly checkable against tr_i_pk 90 / 120 rather than merely plausible.
                    '  Four and not eight because each start trace runs to AT_SPEED, about 1_225 samples,
                    '  where a stop trace ends at rest in about 310 -- the log grows by a third at four.
                    stopModeLifetime(SEG_STOPMODE, side, lookupz(speedIdx: QTR_SPEED_INCRE, HALF_SPEED_INCRE) * signMul, TRUE, (repIdx == 0) and (speedIdx == 0))
    segEnd(segWhy())

PRI segLive() | side, rungNum, whyCode
' LIVE (part A, T1-2, W): telemetry liveness beside testGetRpm(). Per motor one lifetime with
' startSenseCog() (its debug compiled out, I5); positive rungs QTR, HALF, LIVE_TOP_INCRE.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local rungNum - 0 QTR, 1 HALF, 2 LIVE_TOP_INCRE
' @local whyCode - why the remaining rungs are skipped, WHY_NONE while they run

    segBegin(SEG_LIVE)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        whyCode := WHY_NONE
        if bRunContinue(SEG_LIVE) == FALSE
            whyCode := WHY_ABORTED
        elseif bWheelStart(SEG_LIVE, side) == FALSE
            whyCode := stWhy
        else
            wheelStartSense(side)
        repeat rungNum from 0 to LIVE_RUNGS - 1
            beat(CP_LOOP_POLL)
            whyCode := trialSkipWhy(SEG_LIVE, side, whyCode)
            whyCode := liveRung(side, nextRungId(), rungNum, lookupz(rungNum: QTR_SPEED_INCRE, HALF_SPEED_INCRE, LIVE_TOP_INCRE), whyCode)
        bZeroAndWaitStopped(side)
        bInstIdle()
        wheelStop(side)
    segEnd(segWhy())

PRI segLadder() | side, signMul
' LADDER (part A, T1-3): C-1 speed law, C-5 duty question, S-3 linearity, C-6 data. Per motor x sign
' (NEG then POS) one lifetime over the whole ladderAllIdx walk -- climb, descent, then the delta cells;
' the BM-LADDER table of the twelve SPEEDS is in the header records.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS

    segBegin(SEG_LADDER)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            beat(CP_LOOP_POLL)
            ladderSign(SEG_LADDER, side, signMul, @ladderAllIdx, LADDER_WALK_STEPS)
    segEnd(segWhy())

PRI segLowSpeed() | side, signMul, rungNum, rid, whyCode, safeEvent, consecFaults
' LOWSPD (part A, R18.2 item 5): the regime BELOW the ladder's bottom rung, which no test has ever
' covered. Per motor x sign, one lifetime over lowIncre, each rung measured with LOW_WINDOW_MS so its
' tick count is a measurement rather than quantisation, and each printing BM-LOW beside the rung records
' the other segments already emit.
'
' WHY IT IS ITS OWN SEGMENT rather than four more rungs on the ladder: every timing constant differs
' (the window is 4x, the settle and the AT_SPEED bound are longer), and mixing two populations under one
' segment token would put them in one verdict later.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS
' @local rungNum - 0..LOW_RUNGS-1, this segment's own rung number
' @local rid - rung id
' @local whyCode - why the remaining rungs are skipped, WHY_NONE while they run
' @local safeEvent - SAFE_* that ended the rung
' @local consecFaults - consecutive faulted rungs, as the ladder counts them

    segBegin(SEG_LOWSPD)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            beat(CP_LOOP_POLL)
            consecFaults := 0
            whyCode := WHY_NONE
            if bRunContinue(SEG_LOWSPD) == FALSE
                whyCode := WHY_ABORTED
            elseif bWheelStart(SEG_LOWSPD, side) == FALSE
                whyCode := stWhy
            repeat rungNum from 0 to LOW_RUNGS - 1
                beat(CP_LOOP_POLL)
                rid := nextRungId()
                whyCode := trialSkipWhy(SEG_LOWSPD, side, whyCode)
                if whyCode <> WHY_NONE
                    rungSkip(SEG_LOWSPD, rid, rungNum, side, lowIncre[rungNum] * signMul, whyCode)
                else
                    safeEvent := lowRung(SEG_LOWSPD, side, rid, rungNum, lowIncre[rungNum] * signMul, LOW_WINDOW_MS, 1)
                    if bRungFaultRecover(SEG_LOWSPD, side, lowIncre[rungNum] * signMul, safeEvent)
                        consecFaults += 1
                        if consecFaults >= LADDER_FAULT_STOP
                            whyCode := WHY_LADDER_STOPPED
                    else
                        consecFaults := 0
                    if (safeEvent == SAFE_ABS_ABORT) or (safeEvent == SAFE_INST_STALL)
                        whyCode := WHY_LADDER_STOPPED
            bZeroAndWaitStopped(side)
            bInstIdle()
            wheelStop(side)
    segEnd(segWhy())
#endif

#ifdef DBG_LOWRUNG
PRI lowRung(seg, side, rid, rungNum, motorIncre, windowMs, decimation) : safeEvent | slotIdx
' One low-speed rung (LOWSPD, and LIMLOW below the old floor, task 3604): the shared measured-rung routine with
' the low-speed timings, then the rung records and BM-LOW. R17-DUAL-TRKICK-A is NOT folded here -- these
' transitions are a different population from the ladder's, with a different window and settle, and one verdict
' over two populations fails on the mixture rather than on the drive (D2), exactly as LIVE's rungs are left out.
'
' @param seg - SEG_LOWSPD or SEG_LIMLOW
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param rid - rung id
' @param rungNum - this segment's rung number
' @param motorIncre - signed increment
' @param windowMs - the measurement window, ms
' @param decimation - the instrument stores one sample in this many
' @returns safeEvent - SAFE_* that ended the rung, SAFE_NONE otherwise
'
' @local slotIdx - motor slot

    slotIdx := side - SIDE_LEFT
    safeEvent := rungMeasure(side, motorIncre, LOW_STEADY_MS, LOW_SETTLE_MS, windowMs, TRUE, decimation)
    ' I10: an unfrozen ring is never read. rungMeasure() leaves rgCmdStart / rgWinStart / rgWinEnd at -1
    '  when the capture did not freeze, and lowStats()'s guards turn that into reset staging and NA
    '  fields without touching a ring long -- the same contract transitionStats() already keeps.
    lowStats(slotIdx)
    rungEmitAll(seg, rid, rungNum, side, motorIncre)
    emitLow(rid, side, motorIncre, rgWhy)
#endif

#ifdef DBP_CLOCK
PRI segClock() | side, signMul
' CLOCK (the three clock loads, T1-4): frame count and net current at 75_000_000, per motor x sign.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS

    segBegin(SEG_CLOCK)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            beat(CP_LOOP_POLL)
            clockLifetime(side, signMul)
    segEnd(segWhy())
#endif

#ifdef DBP_B
PRI segFaultBoundary() | side, signMul, trialIdx, whyCode
' FAULTB (part B, T1-7): the ramp fault-boundary sweep (C-5, Z; S-1 not measured). Per motor x sign
' one lifetime and FB_TRIALS trials, the speed-up rate ascending (fbAccelRates; SRC_REV 61, was ramp_inc).
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS
' @local trialIdx - 0-based trial
' @local whyCode - why the lifetime did not start, WHY_NONE when it did

    segBegin(SEG_FAULTB)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            whyCode := WHY_NONE
            if bRunContinue(SEG_FAULTB) == FALSE
                whyCode := WHY_ABORTED
            elseif bWheelStart(SEG_FAULTB, side) == FALSE
                whyCode := stWhy
            repeat trialIdx from 0 to FB_TRIALS - 1
                beat(CP_LOOP_POLL)
                faultbTrial(side, signMul, trialIdx, whyCode)
            bZeroAndWaitStopped(side)
            bInstIdle()
            wheelStop(side)
    segEnd(segWhy())

PRI segOvershoot() | distIdx, whyCode, sid
' OVERSHT (part B, T1-8): C-3 distance overshoot through the steering object. Both wheel objects are
' stopped first (shared pin claims, PL-18); bSteerStart() sets holdAtStop(FALSE); the distance power is
' set once to OVERSHT_POWER, the value every trial prints (sec 12.8: never read back through the
' steering getter, PL-51); 2 ft and 10 ft x OVERSHT_REPS; then the two turn trials (task 3577); then the
' fault-API trial (task 3552); steering.stop() at the end.
'
' THE FAULT-API TRIAL RUNS LAST, and the order is the construction, not a preference: a provoked fault
' resets the driver's tracking, so running it first or between reps would contaminate C-3, this
' segment's primary job. It is here at all because it is the only UNATTENDED segment that runs the
' steering object, and the steering object's isFaulted() / isEmergency() cannot be read without it.
'
' @local distIdx - 0 short, 1 long; then the turn index, 0 the left wheel long, 1 the right wheel long
' @local whyCode - why the remaining trials are skipped, WHY_NONE while they run
' @local sid - the steering start's life, 0 when it did not start

    segBegin(SEG_OVERSHT)
    wheelStop(SIDE_LEFT)
    wheelStop(SIDE_RIGHT)
    whyCode := WHY_NONE
    sid := 0
    if bRunContinue(SEG_OVERSHT) == FALSE
        whyCode := WHY_ABORTED
    elseif bSteerStart(SEG_OVERSHT) == FALSE
        whyCode := WHY_NO_COG
    else
        sid := steerLife
        beat(CP_LIB_STEER_DRIVE)
        steering.setMaxSpeedForDistance(OVERSHT_POWER)
        beat(CP_LIB_STEER_DRIVE)
    repeat distIdx from 0 to OVERSHT_DISTS - 1
        repeat OVERSHT_REPS
            beat(CP_LOOP_POLL)
            whyCode := overshootTrial(SEG_OVERSHT, sid, lookupz(distIdx: OVERSHT_FT_SHORT, OVERSHT_FT_LONG), lookupz(distIdx: OVERSHT_FT_SHORT, OVERSHT_FT_LONG), whyCode)
    repeat distIdx from 0 to OVERSHT_TURNS - 1
        beat(CP_LOOP_POLL)
        whyCode := overshootTrial(SEG_OVERSHT, sid, lookupz(distIdx: OVERSHT_FT_LONG, OVERSHT_FT_SHORT), lookupz(distIdx: OVERSHT_FT_SHORT, OVERSHT_FT_LONG), whyCode)
    faultApiTrial(sid, whyCode)
    bInstIdle()
    steerStop()
    segEnd(segWhy())
#endif

#ifdef DBP_BRAKE
PRI segOutside() | whyCode
' OUTSIDE (attended load 6, T1-9): M, AF, S-5, Z. The panel asks for START and nothing moves before it
' (sec 8.3); a START timeout ends the segment with no motion. outsideRun() then drives both wheels at
' STEER_POWER_HALF, asks for the LEFT hand-brake and polls the public API through the fault and both Z
' steps. The end screen shows the outcome and waits for START, so the operator reads it before the session
' ends.
'
' @local whyCode - why the segment ended short, WHY_NONE when it ran through

    segBegin(SEG_OUTSIDE)
    panelSetup()
    whyCode := operStartPrompt(PROMPT_BRAKE_L, BM_SCR_BRAKE_START, BM_SCR_BRAKE_SPINUP)
    if whyCode == WHY_NONE
        whyCode := outsideRun()
    operFlush()
    panelFinish(BM_SCR_END, outcomeState(whyCode))
    ' if/else, never `? :` -- PL-29: a ternary evaluates BOTH branches, so this called segWhy() even
    '  when whyCode already held the answer. segWhy() is a pure read of bRunAborted, so the cost here was
    '  a wasted call and nothing else -- but a counter-example living in the file that states the rule is
    '  how the rule stops being followed (P10: the construction, not a reminder).
    if whyCode <> WHY_NONE
        segEnd(whyCode)
    else
        segEnd(segWhy())
#endif

#ifdef DBP_C
PRI segBaseline() | side, signMul
' BASELINE (part C, before POSTFLT, I7): STOPMODE conditions (1) and (2) at HALF, per motor x sign, one
' lifetime each. Shares stopModeLifetime() with STOPMODE.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS

    segBegin(SEG_BASELINE)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            beat(CP_LOOP_POLL)
            stopModeLifetime(SEG_BASELINE, side, HALF_SPEED_INCRE * signMul, FALSE, FALSE)
    segEnd(segWhy())

PRI segPostFault() | side, signMul, reqMode, whyCode
' POSTFLT (part C, T1-1 d and e; S-9a): coast after a provoked fault (NEG, HALF, FLOAT then BRAKE) and
' after an e-stop (both signs, HALF, FLOAT then BRAKE), per motor in one lifetime. No outcome is
' labelled (I7): BASELINE's traces in this load are the comparison.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS
' @local reqMode - MODE_FLOAT then MODE_BRAKE
' @local whyCode - why the lifetime did not start, WHY_NONE when it did

    segBegin(SEG_POSTFLT)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        whyCode := WHY_NONE
        if bRunContinue(SEG_POSTFLT) == FALSE
            whyCode := WHY_ABORTED
        elseif bWheelStart(SEG_POSTFLT, side) == FALSE
            whyCode := stWhy
        repeat reqMode from MODE_FLOAT to MODE_BRAKE
            beat(CP_LOOP_POLL)
            eventTrace(SEG_POSTFLT, side, HALF_SPEED_INCRE * SIGN_NEG, CAUSE_FAULT, EVT_OFFSET, reqMode, whyCode)
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            repeat reqMode from MODE_FLOAT to MODE_BRAKE
                beat(CP_LOOP_POLL)
                eventTrace(SEG_POSTFLT, side, HALF_SPEED_INCRE * signMul, CAUSE_ESTOP, EVT_ESTOP, reqMode, whyCode)
        bInstIdle()
        wheelStop(side)
    segEnd(segWhy())
#endif

CON { --- part D: the front cog's contract (STEERSEG) and current limiting (LIMIT), task 3560 --- }

#ifdef DBP_D
PRI segSteerContract() | whyCode
' STEERSEG (part D, plan sec R16.8 b): the front cog's contract, measured first through the steering
' object -- the three-cog form, where one front cog owns both drivers -- and then through one wheel, the
' two-cog form. Both forms are what 6.0.0 ships, so both are certified here (FIXED-COG-SHAPE-DESIGN.md
' sec 6).
'
' THE ORDER IS THE CONSTRUCTION. LOCKSTEP must run first: it watches the platform's very first departure
' from rest, which only exists once per start. COOPSHUT must run last on each object: it is the shutdown.
' Everything between leaves the object running and at rest. RESTCOAST (task 3623) runs after COOPSHUT on
' lifetimes of its own, because its reference and its trial each END a lifetime with a stop() from speed.
'
' @local whyCode - why the steering half did not run, WHY_NONE when it did

    segBegin(SEG_STEERSEG)
    wheelStop(SIDE_LEFT)                                    ' shared pin claims (PL-18), as OVERSHT does
    wheelStop(SIDE_RIGHT)
    whyCode := WHY_NONE
    if bRunContinue(SEG_STEERSEG) == FALSE
        whyCode := WHY_ABORTED
    elseif bSteerStart(SEG_STEERSEG) == FALSE
        whyCode := WHY_NO_COG
    if whyCode == WHY_NONE
        dStepLockstep()
        dStepTrackReset(SIDE_BOTH)
        dStepEstopSet(SIDE_BOTH)
        dStepOrdered()
        dStepTimeStop(SIDE_BOTH)
        dStepCmdTimeout(SIDE_BOTH)
        dStepDirSign()
        dStepFrontStats(SIDE_BOTH)
        dStepCoopShut(SIDE_BOTH)                            ' stops the steering object
        dStepRestCoast()                                    ' task 3623: two lifetimes of its own, each stopped
    else
        dStepSkip(DST_LOCKSTEP, SIDE_BOTH, whyCode)
        dStepSkip(DST_TRACKRESET, SIDE_BOTH, whyCode)
        dStepSkip(DST_ESTOP_REFUSE, SIDE_BOTH, whyCode)
        dStepSkip(DST_ESTOP_LATCH, SIDE_BOTH, whyCode)
        dStepSkip(DST_ESTOP_CLEAR, SIDE_BOTH, whyCode)
        dStepSkip(DST_ORDERED, SIDE_BOTH, whyCode)
        dStepSkip(DST_TIMESTOP, SIDE_BOTH, whyCode)
        dStepSkip(DST_CMDTIMEOUT, SIDE_BOTH, whyCode)
        dStepSkip(DST_DIRSIGN, SIDE_BOTH, whyCode)
        dStepSkip(DST_COOPSHUT, SIDE_BOTH, whyCode)
        dStepSkip(DST_RESTCOAST, SIDE_BOTH, whyCode)
        steerStop()
    segEnd(segWhy())

PRI segCurrentLimits() | whyCode
' LIMIT (part D, plan sec R16.8 d): current limiting as a user meets it, through the steering object.
' testSetCurrentLimits() lowers the limits so a wheels-lifted rig can reach them -- at the MOSFET values
' (40 A peak, 27 A continuous) a lifted 6.5in wheel never comes close, so without this the design's own
' mechanisms could not be provoked at all on this rig (doctrine overlay P1: every run is wheels-lifted).
' The MOSFET values are restored and read back before the segment ends (I11).
'
' THE SINGLE-WHEEL half of part D runs here, after the limits are restored, so a wheel-frame e-stop and
' time stop are measured on a platform whose limits are back at their shipping values.
'
' @local whyCode - why the segment did not run, WHY_NONE when it did

    segBegin(SEG_LIMIT)
    whyCode := WHY_NONE
    if bRunContinue(SEG_LIMIT) == FALSE
        whyCode := WHY_ABORTED
    elseif bSteerStart(SEG_LIMIT) == FALSE
        whyCode := WHY_NO_COG
    if whyCode == WHY_NONE
        dStepFoldBack()
        dEvStage(EVST_D_FOLD)                               ' task 3621: each step's events, drained once it has settled
        dStepDerate()
        dEvStage(EVST_D_DERATE)
        dStepBlocked()
        dEvStage(EVST_D_BLOCK)
        dLimitRestore()                                     ' I11: the MOSFET values back, read back, before anything else
        steerStop()
    else
        dStepSkip(DST_FOLDBACK, SIDE_BOTH, whyCode)
        dStepSkip(DST_DERATE, SIDE_BOTH, whyCode)
        dStepSkip(DST_BLOCKED, SIDE_BOTH, whyCode)
        steerStop()
    dWheelHalf(whyCode)
    segEnd(segWhy())

PRI dWheelHalf(segWhyCode) | whyCode
' The two-cog form: one wheel started on its own (start() runs its own front cog), carrying the same
' e-stop, time-stop and loop-health claims the steering object was just measured against. LEFT is the
' wheel under test throughout, as every other wheel-frame segment uses it.
'
' @param segWhyCode - WHY_NONE when the segment ran, else why nothing ran
'
' @local whyCode - why the wheel half did not run, WHY_NONE when it did

    whyCode := segWhyCode
    if whyCode == WHY_NONE
        if bRunContinue(SEG_LIMIT) == FALSE
            whyCode := WHY_ABORTED
        elseif bWheelStart(SEG_LIMIT, SIDE_LEFT) == FALSE
            whyCode := stWhy
    if whyCode == WHY_NONE
        dStepEstopSet(SIDE_LEFT)
        dStepTimeStop(SIDE_LEFT)
        dStepCmdTimeout(SIDE_LEFT)
        dStepFrontStats(SIDE_LEFT)
        dStepCoopShut(SIDE_LEFT)                            ' stops the wheel
    else
        dStepSkip(DST_ESTOP_REFUSE, SIDE_LEFT, whyCode)
        dStepSkip(DST_ESTOP_LATCH, SIDE_LEFT, whyCode)
        dStepSkip(DST_ESTOP_CLEAR, SIDE_LEFT, whyCode)
        dStepSkip(DST_TIMESTOP, SIDE_LEFT, whyCode)
        dStepSkip(DST_CMDTIMEOUT, SIDE_LEFT, whyCode)
        dStepSkip(DST_COOPSHUT, SIDE_LEFT, whyCode)
        bInstIdle()
        wheelStop(SIDE_LEFT)
#endif

#ifdef DBP_FLOOR
PRI segFloor() | whyCode
' FLOOR (attended load 9, T2-1; AC). The panel asks for START and nothing moves before it (sec 8.3); a
' START timeout ends the segment with no motion. floorRun() then drives driveDirection(FLOOR_POWER,
' FLOOR_DIRECTION) for FLOOR_RUN_MS with STOP always live, and asks which way the platform turned.
'
' @local whyCode - why the segment ended short, WHY_NONE when it ran through

    segBegin(SEG_FLOOR)
    panelSetup()
    whyCode := operStartPrompt(PROMPT_FLOOR, BM_SCR_FLOOR_START, BM_SCR_FLOOR_STARTING)
    if whyCode == WHY_NONE
        whyCode := floorRun()
    operFlush()
    panelFinish(BM_SCR_END, outcomeState(whyCode))
    ' if/else, never `? :` -- PL-29: a ternary evaluates BOTH branches, so this called segWhy() even
    '  when whyCode already held the answer. segWhy() is a pure read of bRunAborted, so the cost here was
    '  a wasted call and nothing else -- but a counter-example living in the file that states the rule is
    '  how the rule stops being followed (P10: the construction, not a reminder).
    if whyCode <> WHY_NONE
        segEnd(whyCode)
    else
        segEnd(segWhy())
#endif

#ifdef DBP_UICHECK
PRI segUiCheck() | stepIdx
' UICHECK (tier dual-ui; STEPHEN 2026-09-15: "a no-motor-control test form of run that takes me thru the
' series of UI controls to make sure they work"): no wheel or steering object is ever started. Every panel
' button, one live at a time, must arrive both as its key and as a mouse click; then every screen dual-brake
' draws (BM_SCR_PREVIEW_FIRST..LAST) is drawn from the same bmScreens row the run uses, its own buttons drawn
' but dead, and judged with the two verdict buttons in their own strip (PL-64: no input both operates a
' screen and judges it). Each step is a BM-UISTEP; R14-DUAL-UICHECK-U is TRUE only when every step was OK.
' The result screen waits for START so the operator reads it before the session ends.
'
' @local stepIdx - button or screen index

    segBegin(SEG_UICHECK)
    panelSetup()
    bSfUiRan := TRUE
    bSfUiOk := TRUE
    repeat stepIdx from 0 to BM_BTN_COUNT - 1
        uiCheckButton(stepIdx)
    panelShow(BM_SCR_UI_INTRO, BM_STATE_UI_CHECK, PNL_BTN_NONE)
    operWait(scrCdMs(BM_SCR_UI_INTRO), SIDE_NONE, FALSE)
    repeat stepIdx from BM_SCR_PREVIEW_FIRST to BM_SCR_PREVIEW_LAST
        uiCheckScreen(stepIdx)
    panelFinish(BM_SCR_UI_END, bSfUiOk ? BM_STATE_UI_PASSED : BM_STATE_UI_FAILED)
    segEnd(segWhy())

PRI uiCheckButton(btnIdx) | startMs, remainMs, buttonIdx, inputCode, bKeyGot, bClickGot, resultCode
' One UICHECK control step: only btnIdx is live, and it must arrive both as its key and as a mouse click, in
' either order. Whichever arrives first is acknowledged on the panel, which then names the input it still
' needs, so no input is ever discarded unseen and a working key cannot pass a broken mouse. A step that got
' both is drawn highlighted for UI_HILITE_MS.
'
' @param btnIdx - BM_BTN_* under test
'
' @local startMs - getms() when the step was shown
' @local remainMs - ms left in the step
' @local buttonIdx - BM_BTN_* received, PNL_BTN_NONE on timeout
' @local inputCode - INPUT_* of the button received
' @local bKeyGot - the button arrived as its key
' @local bClickGot - the button arrived as a mouse click
' @local resultCode - UIR_OK or UIR_TIMEOUT

    uiPressReset()
    bKeyGot := FALSE
    bClickGot := FALSE
    panelCompose(BM_SCR_UI_CONTROL, BM_STATE_UI_CHECK, DECOD btnIdx, DECOD btnIdx, PNL_BTN_NONE, BM_STRIP_BLANK, FALSE)
    startMs := getms()
    repeat
        remainMs := UI_STEP_TIMEOUT_MS - (getms() - startMs)
        if remainMs <= 0
            quit
        buttonIdx, inputCode, _ := operWait(remainMs, SIDE_NONE, FALSE)
        if buttonIdx == PNL_BTN_NONE
            quit
        if inputCode == INPUT_KEY
            bKeyGot := TRUE
        else
            bClickGot := TRUE
        if bKeyGot and bClickGot
            quit
        panelCompose(BM_SCR_UI_CONTROL, bKeyGot ? BM_STATE_UI_NOW_CLICK : BM_STATE_UI_NOW_KEY, DECOD btnIdx, DECOD btnIdx, PNL_BTN_NONE, BM_STRIP_BLANK, FALSE)
    resultCode := (bKeyGot and bClickGot) ? UIR_OK : UIR_TIMEOUT
    if resultCode == UIR_OK
        panelCompose(BM_SCR_UI_CONTROL, BM_STATE_UI_CHECK, PNL_LIVE_NONE, PNL_LIVE_NONE, btnIdx, BM_STRIP_BLANK, FALSE)
        waitBeat(UI_HILITE_MS, CP_LOOP_OPER)
    else
        bSfUiOk := FALSE
    emitUiStep(UIK_CONTROL, btnIdx, PNL_BTN_NONE, bKeyGot, bClickGot, BM_SCR_UI_CONTROL, resultCode, getms() - startMs)
#endif

PRI uiPressReset()
' Forget the last left-button press, so a BM-UISTEP reports only presses made during its own step.

    uiPressX := 0
    uiPressY := 0
    bUiPressSeen := FALSE

#ifdef DBP_UICHECK
PRI uiCheckScreen(scr) | startMs, buttonIdx, inputCode, resultCode
' One UICHECK screen: an attended screen drawn from its own bmScreens row exactly as the run draws it --
' prompt, state, countdown label and start, and its own buttons, drawn but dead -- with the judge
' instruction and the two verdict buttons live in the strip below. LOOKS RIGHT means it reads right;
' SOMETHING WRONG means it does not. No input the screen itself offers is accepted here.
'
' @param scr - BM_SCR_* previewed
'
' @local startMs - getms() when the screen was shown
' @local buttonIdx - BM_BTN_LOOKS_RIGHT, BM_BTN_WRONG, or PNL_BTN_NONE on timeout
' @local inputCode - INPUT_* of the button received
' @local resultCode - UIR_* of the step

    uiPressReset()
    panelCompose(scr, scrState(scr), scrLive(scr), PNL_LIVE_VERDICT, PNL_BTN_NONE, BM_STRIP_JUDGE, TRUE)
    startMs := getms()
    buttonIdx, inputCode, _ := operWait(UI_STEP_TIMEOUT_MS, SIDE_NONE, FALSE)
    if buttonIdx == BM_BTN_LOOKS_RIGHT
        resultCode := UIR_OK
    elseif buttonIdx == BM_BTN_WRONG
        resultCode := UIR_WRONG
        bSfUiOk := FALSE
    else
        resultCode := UIR_TIMEOUT
        bSfUiOk := FALSE
    if buttonIdx <> PNL_BTN_NONE
        panelCompose(scr, scrState(scr), scrLive(scr), PNL_LIVE_NONE, buttonIdx, BM_STRIP_JUDGE, TRUE)
        waitBeat(UI_HILITE_MS, CP_LOOP_OPER)
    emitUiStep(UIK_PREVIEW, PNL_BTN_NONE, buttonIdx, inputCode == INPUT_KEY, inputCode == INPUT_MOUSE, scr, resultCode, getms() - startMs)
#endif

#ifdef DBG_PREFLT
PRI bSegPreflight() : bRunGoes | side, bMoved, nFailed, failedSide
' PREFLT (every motion load, design sec 4.4): prove each wheel turns before anything is measured. A
' wheel that moves 0 ticks ends the run with BM-ABORT scope RUN reason NO_MOTION -- except in part FAULTRESP,
' where ONE such wheel is retired for the run (bSlotRetired, and bFrPreRetired so its cells print NOMEAS), named
' by BM-ABORT scope SEG, and the part goes on with the other wheel; both failing ends the run as in every part
' (task 3615, PL-120: the trip must measure the left wheel whatever the right does).
'
' PL-136, part FAULTRESP: before a wheel counts as not moving it is diagnosed in two stages. First, AT ONCE and before
' the other wheel's nudge, up to PF_RETRY_TRIES fresh lifetimes (bPfRetry()). Then, only when every retry failed and it
' is the only wheel still unmoved, the recovery probe on it, before FLTRESP (bPfProbe()). A wheel either stage moves is
' not retired, and its FLTRESP trials and FLTPLAT run. The stages are FAULTRESP's only: in every other part a PREFLT
' failure ends the run by that part's contract, and a wheel that needed a retry would be measured there as though it
' had not. The mid-nudge dump and the trace, which change no outcome, run in every part (bPreflightWheel()).
'
' @returns bRunGoes - TRUE when the run continues: both wheels moved, or in FAULTRESP exactly one did
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local bMoved - this wheel moved (at its first nudge, or in FAULTRESP at a retry)
' @local nFailed - wheels that did not move
' @local failedSide - the last wheel that did not move, SIDE_NONE when none

    segBegin(SEG_PREFLT)
    nFailed := 0
    failedSide := SIDE_NONE
    ' PL-152: the part-FAULTRESP stages are compiled into that part only (they were `PART_ID == PART_FAULTRESP` tests)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        beat(CP_LOOP_POLL)
        bMoved := bPreflightWheel(side)
#ifdef DBP_FAULTRESP
        if bMoved == FALSE
            bMoved := bPfRetry(side)                        ' PL-136: at once, in fresh lifetimes
#endif
        if bMoved == FALSE
            nFailed += 1
            failedSide := side
        segItems += 1
#ifdef DBP_FAULTRESP
    if nFailed == 1
        if bPfProbe(failedSide)                             ' PL-136: every retry failed; the probe, before FLTRESP
            nFailed := 0
#endif
    bRunGoes := (nFailed == 0)
#ifdef DBP_FAULTRESP
    if nFailed == 1
        bSlotRetired[failedSide - SIDE_LEFT] := TRUE
        bFrPreRetired[failedSide - SIDE_LEFT] := TRUE
        emitAbort(SEG_PREFLT, 0, failedSide, PREFLIGHT_INCRE, ABR_NO_MOTION, 0, SCOPE_SEG)
        bRunGoes := TRUE
        segEnd(WHY_MOTOR_RETIRED)
    else
        if nFailed > 0
            emitFrRecSum()                                  ' PL-136: both wheels dead after their retries still reports
                                                            '  its stages, so the run's end never reads as nothing tried
            emitAbort(SEG_PREFLT, 0, SIDE_NONE, PREFLIGHT_INCRE, ABR_NO_MOTION, 0, SCOPE_RUN)
        segEnd(bRunGoes ? WHY_NONE : WHY_ABORTED)
#else
    if nFailed > 0
        emitAbort(SEG_PREFLT, 0, SIDE_NONE, PREFLIGHT_INCRE, ABR_NO_MOTION, 0, SCOPE_RUN)
    segEnd(bRunGoes ? WHY_NONE : WHY_ABORTED)
#endif

PRI bPreflightWheel(side) : bMoved | slotIdx, safeEvent, ticksMoved, hwMoved, bMeasured, whyCode, lastJ, bStopped, bFrozen, endCode
' One wheel's preflight: start it alone (I6), arm the instrument on it, mark, PREFLIGHT_INCRE for
' PREFLIGHT_MS, zero, wait stopped, freeze, and measure the driver tick and hwPos deltas from the ring.
' Emits BM-START (inside bWheelStart()) and BM-PREFLT. A fault is recovered per sec 4.2. Then, before the
' wheel is stopped, what its driver holds (abiDumpWheel(), BM-ABIL / -ABIS* / -ABIP*, task 3615), whether it
' moved or not.
'
' PL-136, in every part that runs PREFLT:
'  - the nudge's wait is waitWatchedNoMo(), so a nudge with no hall tick by FR_NOMOTION_MS dumps the driver's runs
'    mid-nudge, while the drive is still on (BM-ABI* where,NOMOTION) -- the mechanism FLTRESP's trials use;
'  - a nudge that did not move emits its frozen ring as a trace (pfTrace()), and in part FAULTRESP every nudge does, so
'    a failing nudge's per-phase shape has a moving one's beside it in the same run. The trace is drained BEFORE a
'    fault is recovered, because recovery step 3 restarts the wheel and re-arms the ring (lifetimeZero()).
' The nudge's readings are staged (pf*) for BM-PFRETRY.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bMoved - TRUE when the driver's tick count changed across the nudge
'
' @local slotIdx - motor slot
' @local safeEvent - SAFE_* from the watched waits
' @local ticksMoved - driver pos delta over the capture
' @local hwMoved - hwPos delta over the capture
' @local bMeasured - the deltas are measurements
' @local whyCode - first cause of any NA in BM-PREFLT
' @local lastJ - logical index of the last drained sample
' @local bStopped - the stop wait saw DCS_STOPPED
' @local bFrozen - the ring was frozen on the nudge
' @local endCode - TEND_* the trace names: how the capture ended

    slotIdx := side - SIDE_LEFT
    bMoved := FALSE
    bMeasured := FALSE
    ticksMoved := 0
    hwMoved := 0
    whyCode := WHY_NONE
    safeEvent := SAFE_NONE
    bStopped := FALSE
    bFrozen := FALSE
    endCode := TEND_ABORT
    curTid := 0
    pfTid := 0
    bPfCmdValid := FALSE
    pfCmdMs := getms()
    pfEndMs := pfCmdMs
    if bWheelStart(SEG_PREFLT, side) == FALSE
        whyCode := stWhy
    elseif bInstArm(INST_SRC_WHEELS, 1) == FALSE
        whyCode := WHY_INST_NOACK
    else
        instMark()                                          ' the mark is the command: the trace's k 0
        pfCmdMs := getms()
        bPfCmdValid := TRUE
        wheelCommand(side, PREFLIGHT_INCRE)
        safeEvent, _, _ := waitWatchedNoMo(side, slotIdx, PREFLIGHT_MS, CP_LOOP_CAPTURE, UNTIL_TIME)   ' PL-136: + NOMOTION dump
        pfEndMs := getms()
        if safeEvent == SAFE_NONE
            wheelCommand(side, 0)
            safeEvent, bStopped := waitWatched(side, STOP_TIMEOUT_MS, CP_LOOP_STOPPED, UNTIL_STOPPED)
        else
            wheelCommand(side, 0)
        bFrozen := bInstFreeze(0)
        if bFrozen
            drainBegin()
            if drStored > 1
                lastJ := drStored - 1
                ticksMoved := smpPos(lastJ, slotIdx) - smpPos(0, slotIdx)
                hwMoved := smpHw(lastJ, slotIdx) - smpHw(0, slotIdx)
                bMeasured := TRUE
            else
                whyCode := WHY_NO_SAMPLES
        else
            whyCode := WHY_INST_NOACK
        bMoved := bMeasured and (ticksMoved <> 0)
        if safeEvent <> SAFE_NONE
            endCode := safeEnd(safeEvent)
        elseif bStopped
            endCode := TEND_REST
        else
            endCode := TEND_TIMEOUT
        if bFrozen and ((bMoved == FALSE) or (PART_ID == PART_FAULTRESP))
            pfTrace(side, whyCode, endCode)                 ' PL-136: while FROZEN, before any recovery re-arms the ring
        if safeEvent == SAFE_INST_STALL
            emitAbort(SEG_PREFLT, 0, side, PREFLIGHT_INCRE, ABR_INST_STALLED, INST_STALL_MS, SCOPE_SEG)
        if safeEvent == SAFE_FAULT
            bRecoverFault(SEG_PREFLT, 0, side, PREFLIGHT_INCRE, FAULT_COOL_MS)
    bMoved := bMeasured and (ticksMoved <> 0)
    pfTicks := ticksMoved
    pfHw := hwMoved
    bPfMeasured := bMeasured
    pfWhy := whyCode
    if (pfWhy == WHY_NONE) and (safeEvent <> SAFE_NONE)
        pfWhy := safeWhy(safeEvent)
    emitPreflt(side, PREFLIGHT_INCRE, ticksMoved, hwMoved, bMeasured, whyCode)
    abiDumpWheel(side, ABIW_PREFLT)                         ' task 3615: after the nudge, before wheelStop()
    bInstIdle()
    wheelStop(side)

PRI pfTrace(side, whyCode, endCode) | slotIdx, offNeg, offPos
' PL-136: a PREFLT nudge's frozen ring as one wheel trace -- BM-TRACE (seg PREFLT, cause START: a start from rest at
' PREFLIGHT_INCRE; the offsets and accel_up read back now), then bTraceDrain()'s BM-TS lines and BM-TRACE-END. The mark
' is the command, so every 2 ms sample of the drive's first TRACE_DENSE_SAMPLES (0.5 s of PREFLIGHT_MS) is a line, and
' after that every change and every 50 ms. BM-TS carries the three phases apart (u, v, w) beside their sum, current and
' duty: PL-120's leading reading -- the low-side switches not turning on, so one phase held high and then draining as its
' high-side bootstrap empties -- needs the shape per phase, which the sum hides. The trace counts toward
' R14-DUAL-TRACES-X as every trace does. Legal only while the ring is FROZEN (I10). Sets pfTid.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param whyCode - the nudge's WHY_* (NONE when it ran)
' @param endCode - TEND_* naming how the capture ended
'
' @local slotIdx - motor slot
' @local offNeg - offset_fwd read back
' @local offPos - offset_rev read back

    slotIdx := side - SIDE_LEFT
    pfTid := nextTraceId()
    offNeg, offPos := wheelGetOffsets(side)
    emitTrace(pfTid, SEG_PREFLT, side, CAUSE_START, PREFLIGHT_INCRE, offNeg, offPos, MODE_FLOAT, wheelAccelUp(side), whyCode)
    bTraceDrain(pfTid, slotIdx, SLOT_RIGHT - slotIdx, endCode)
#endif

#ifdef DBP_FAULTRESP
PRI bPfRetry(side) : bMoved | slotIdx, tryIdx
' PL-136, part FAULTRESP, the first stage: a wheel whose PREFLT nudge did not move is retried AT ONCE, in up to
' PF_RETRY_TRIES fresh driver lifetimes, each PF_RETRY_GAP_MS after the previous one stopped, each nudged, dumped and
' traced exactly as the first (bPreflightWheel()) and followed by its BM-PFRETRY. It ends at the first retry that
' moves (pfOutcome RETRY), on a run cap, or when a failed fault recovery retires the wheel (both UNDECIDED). Pass 4
' started the right wheel once and never again, so one failed drive could not tell a transient first-drive failure
' from a persistent one (VISIT-10-PASS4-EVALUATION.md sec 4); this is the second, third and fourth drive.
'
' The wheel's cells print NOMEAS (bFrPreRetired) from here until a stage moves it. bSlotRetired is NOT set here: it
' would refuse the retries' own starts (bWheelStart()), and bSegPreflight() sets it only when every stage has failed.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bMoved - TRUE when a retry moved the wheel
'
' @local slotIdx - motor slot
' @local tryIdx - 1..PF_RETRY_TRIES

    slotIdx := side - SIDE_LEFT
    bMoved := FALSE
    pfOutcome[slotIdx] := PFO_UNDECIDED
    pfFailMs[slotIdx] := pfEndMs                            ' the retries' and the probe's clock start at the failure
    pfFailTid[slotIdx] := pfTid
    bFrPreRetired[slotIdx] := TRUE
    repeat tryIdx from 1 to PF_RETRY_TRIES
        beat(CP_LOOP_POLL)
        if (bRunContinue(SEG_PREFLT) == FALSE) or bSlotRetired[slotIdx]
            quit
        waitBeat(PF_RETRY_GAP_MS, CP_LOOP_REST)
        bMoved := bPreflightWheel(side)
        pfTries[slotIdx] := tryIdx
        emitPfRetry(side, tryIdx)
        if bMoved
            pfOutcome[slotIdx] := PFO_RETRY
            pfRecTry[slotIdx] := tryIdx
            bFrPreRetired[slotIdx] := FALSE                 ' un-retired: its trials run
            quit

PRI bPfProbe(side) : bRecovered | slotIdx, nTries, recTry, whyCode
' PL-136, part FAULTRESP, the second stage: every immediate retry failed and this is the only wheel still unmoved, so
' PL-120's recovery probe runs on it now, BEFORE FLTRESP -- probeRun() from the first nudge's failure (pfFailMs),
' each try a BM-FRRECOV with seg PREFLT. A try that moves un-retires the wheel (pfOutcome PROBE) and its trials run.
' All FR_RECOVER_TRIES tries unmoved is DEAD: time inside one program did not clear it. A probe ended short (a run cap,
' a retirement) stays UNDECIDED. This probe is PREFLT's own: FLTRESP's probe keeps its one turn (frRecoverProbe()).
'
' @param side - the unmoved wheel: SIDE_LEFT or SIDE_RIGHT
' @returns bRecovered - TRUE when a probe try moved it
'
' @local slotIdx - motor slot
' @local nTries - probe tries made
' @local recTry - the try that moved it, 0 when none
' @local whyCode - what ended the probe short, WHY_NONE when it ran out or recovered

    slotIdx := side - SIDE_LEFT
    bRecovered, nTries, recTry, _, whyCode := probeRun(SEG_PREFLT, pfFailTid[slotIdx], side, pfFailMs[slotIdx])
    if bRecovered
        pfOutcome[slotIdx] := PFO_PROBE
        pfRecTry[slotIdx] := recTry
        bFrPreRetired[slotIdx] := FALSE                     ' un-retired: its trials run
    elseif (whyCode == WHY_NONE) and (nTries == FR_RECOVER_TRIES)
        pfOutcome[slotIdx] := PFO_DEAD
#endif

CON { --- segment routines: traces (STOPMODE, BASELINE, POSTFLT, FAULTB), rungs (LADDER, LIVE, CLOCK), OVERSHT --- }

#ifdef DBG_STOPMODE
PRI stopModeLifetime(seg, side, motorIncre, bWithStopCog, bWithStart) | whyCode
' One stop-mode driver lifetime, the routine STOPMODE and BASELINE share: start the wheel under test
' alone (I6; the lifetime zero is read inside bWheelStart()), then, when asked, condition (0) the START
' from rest, then condition (1) STOPCMD FLOAT, (2) STOPCMD BRAKE and, when asked, (3) STOPCOG FLOAT,
' which ends the lifetime.
'
' Condition (0) is traced FIRST because it is the only one whose subject is the spin-up the other three
' each perform and discard: the wheel is at rest here and nowhere else in the lifetime (task 3593).
'
' @param seg - SEG_STOPMODE or SEG_BASELINE
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param bWithStopCog - TRUE to trace condition (3)
' @param bWithStart - TRUE to trace condition (0)
'
' @local whyCode - why the lifetime did not start, WHY_NONE when it did

    whyCode := WHY_NONE
    if bRunContinue(seg) == FALSE
        whyCode := WHY_ABORTED
    elseif bWheelStart(seg, side) == FALSE
        whyCode := stWhy
    if bWithStart
        eventTrace(seg, side, motorIncre, CAUSE_START, EVT_START, MODE_FLOAT, whyCode)
    eventTrace(seg, side, motorIncre, CAUSE_STOPCMD, EVT_STOPMOTOR, MODE_FLOAT, whyCode)
    eventTrace(seg, side, motorIncre, CAUSE_STOPCMD, EVT_STOPMOTOR, MODE_BRAKE, whyCode)
    if bWithStopCog
        eventTrace(seg, side, motorIncre, CAUSE_STOPCOG, EVT_STOPCOG, MODE_FLOAT, whyCode)
    bInstIdle()
    wheelStop(side)

#endif

#ifdef DBG_EVTRACE
PRI eventTrace(seg, side, motorIncre, causeCode, eventCode, reqMode, skipWhy) | tid, whyCode, accelUp
' One wheel trace, the trace routine STOPMODE, BASELINE and POSTFLT share: BRAKE requested before
' spin-up, on the wheel under test only (I6); eventCapture(); every side effect restored and read back,
' then BM-TRACE, BM-TS and BM-TRACE-END (traceEmitCapture()); recovery per sec 4.2, zero and wait
' stopped (traceRecover()). A trial the caps, a retired motor or a stopped driver prevent is emitted as
' its header and an empty end naming the cause.
'
' @param seg - SEG_STOPMODE, SEG_BASELINE or SEG_POSTFLT
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param causeCode - CAUSE_* the header names (what was done, I7)
' @param eventCode - EVT_* the trial issues
' @param reqMode - MODE_FLOAT or MODE_BRAKE (what was requested, I7)
' @param skipWhy - WHY_NONE to run, else why the lifetime could not start
'
' @local tid - trace id
' @local whyCode - why the trial is skipped, WHY_NONE when it runs
' @local accelUp - accel_up (the speed-up limit, maxRamp) read back for the header

    tid := nextTraceId()
    cpReset()
    whyCode := trialSkipWhy(seg, side, skipWhy)
    accelUp := wheelAccelUp(side)
    if whyCode <> WHY_NONE
        cpWantNeg, cpWantPos := wheelGetOffsets(side)
        traceSkip(tid, seg, side, causeCode, motorIncre, reqMode, accelUp, whyCode)
    else
        if reqMode == MODE_BRAKE
            wheelHold(side, TRUE)
        if eventCode == EVT_START
            startCapture(side, motorIncre)
        else
            eventCapture(side, motorIncre, eventCode)
        traceEmitCapture(seg, side, tid, causeCode, motorIncre, reqMode, accelUp)
        ' STPDECEL rides BASELINE's floated stop from half speed -- the one condition Visit 3 measured
        '  74-77 ticks on -- so the no-regression reading costs no trial of its own
        if (seg == SEG_BASELINE) and (causeCode == CAUSE_STOPCMD) and (reqMode == MODE_FLOAT) and bTrStopValid
            sfDecelTicks[side - SIDE_LEFT] := trStopTicks
            bSfDecelRan[side - SIDE_LEFT] := TRUE
        ' FLTSTOP (task 3572, R17.1): POSTFLT's provoked faults, FLOAT then BRAKE -- the travel from the provocation
        '  to rest under each stop mode. The computed provocation faults within a control frame, so this is the
        '  post-fault coast (COAST) or brake (SHORT) the user's holdAtStop() selected
        if (seg == SEG_POSTFLT) and (causeCode == CAUSE_FAULT) and bCpFaultSeen and bTrStopValid
            sfFltStopTicks[((side - SIDE_LEFT) * MODE_COUNT) + reqMode] := trStopTicks
            bSfFltStopRan[((side - SIDE_LEFT) * MODE_COUNT) + reqMode] := TRUE
        traceRecover(seg, side, tid, motorIncre, FAULT_COOL_MS)
    segItems := (segItems + 1) <# LIM_SMALL

PRI startCapture(side, motorIncre) | safeEvent, bReached, markMs, captureLeftMs
' Run one wheel trace's motion and capture for a START FROM REST (task 3593, R18.2d). The sibling of
' eventCapture() for the one event whose mark must PRECEDE the motion: arm; read the offsets; mark; the
' command; capture until AT_SPEED or the trace's own bound; freeze. Fills the same cp* staging, so
' traceEmitCapture() emits it exactly as it emits a stop.
'
' WHY THIS EXISTS. Every trace this binary took before R18.2d triggered on a STOP -- all 48 of Visit
' 7b's carry seg STOPMODE -- while the same run performed 48 spin-ups from rest and recorded none of
' them beyond BM-RUNGTR's four aggregates. Visit 7b measured a startup current surge of 90-120 sense mV
' that the commutation correction did not move (VISIT-7B-EVALUATION.md F13), and nothing in the log can
' say what duty and err were doing while it happened. This is the instrument for that, and ONLY the
' instrument: the mechanism it is meant to test is stated in the run sheet, not assumed here.
'
' WHAT THE WINDOW REACHES, and what it costs. traceCaptureMs(1) is 7_850 ms at INST_RATE_HZ 500, and a
' from-rest spin-up to QTR_SPEED_INCRE took about 2_450 ms at Visit 7b, so the capture reaches AT_SPEED
' with room to spare and ends there rather than at its bound: the WHOLE ramp is resolved at 2 ms, which
' is what a deadband-then-catch-up reading needs. It is also why this trace is far longer than a stop
' trace -- about 1_225 samples against about 310, a stop ending at rest inside a second -- and why it
' rides four cells rather than every one.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment commanded from rest
'
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - AT_SPEED was reached inside the capture bound
' @local markMs - getms() at the mark
' @local captureLeftMs - capture bound still owed after the command

    safeEvent := SAFE_NONE
    bReached := FALSE
    ' the pair read immediately before the event, and the one read serves both paths: unlike
    '  eventCapture(), nothing runs between here and the mark that could change the offsets
    cpWantNeg, cpWantPos := wheelGetOffsets(side)
    if bInstArm(INST_SRC_WHEELS, 1) == FALSE
        cpWhy := WHY_INST_NOACK
    else
        if PART_ID == PART_LIMITS                            ' only LIMRAMP prints the ramp's reading (BM-RAMP)
            rampLagOpen(side)                                ' outside the measured interval (D6)
        instMark()                                           ' the mark PRECEDES the command: that is the whole point
        markMs := getms()
        wheelCommand(side, motorIncre)
        captureLeftMs := (traceCaptureMs(1) - (getms() - markMs)) #> 0
        safeEvent, bReached := waitWatched(side, captureLeftMs, CP_LOOP_CAPTURE, UNTIL_AT_SPEED)
        if PART_ID == PART_LIMITS
            rampLagClose(side, markMs, bReached)
        ' AT_SPEED inside the window is not required and is not a failure: the ramp is longer than the
        '  window by design, so a capture that simply runs out is the expected end
        cpEnd := bReached ? TEND_REST : TEND_TIMEOUT
        if safeEvent <> SAFE_NONE
            cpWhy := safeWhy(safeEvent)
            cpEnd := safeEnd(safeEvent)
            bCpFaultSeen := (safeEvent == SAFE_FAULT)
        bCpFrozen := bInstFreeze(0)
        if (bCpFrozen == FALSE) and (cpWhy == WHY_NONE)
            cpWhy := WHY_INST_NOACK
        wheelStopMotor(side)                                 ' leave the wheel as every other trial leaves it

PRI rampLagOpen(side)
' Open a ramp's hold count (task 3604, E3): the driver's lag_held just before the mark. A driver that is not up
' leaves the count invalid, and rampLagClose() then reports none rather than a difference against nothing.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    bCpRampLagValid := isWheelUp(side)
    if bCpRampLagValid
        cpRampLag, _, _ := wheelDriveHealth(side)

PRI rampLagClose(side, markMs, bReached) | lagNow
' Close a ramp's reading (task 3604, E3): mark to AT_SPEED in ms, and the lag holds across it -- the passes on
' which the limiter held the field because the rotor could not follow the ramp. Read after the wait ends.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param markMs - getms() at the mark
' @param bReached - AT_SPEED was reached inside the capture
'
' @local lagNow - lag_held now

    bCpRampReached := bReached
    cpRampMs := getms() - markMs
    if bCpRampLagValid and isWheelUp(side)
        lagNow, _, _ := wheelDriveHealth(side)
        cpRampLag := lagNow - cpRampLag                     ' NOT floored: only a driver restart makes it negative
    else
        bCpRampLagValid := FALSE

PRI eventCapture(side, motorIncre, eventCode) | safeEvent, bReached, bRest, markMs, captureLeftMs, shiftDeg
' Run one wheel trace's motion and capture (design sec 4.4): arm; command; AT_SPEED (<=
' STEADY_TIMEOUT_MS); settle SETTLE_MS; read the offsets; mark; the event; capture until rest or
' traceCaptureMs(1); freeze. EVT_OFFSET first waits POSTFLT_NO_FAULT_MS for the provoked fault and, when
' none comes, restores the offsets and stops the motor at once (why NO_FAULT). EVT_STOPCOG calls stop()
' while the instrument runs, because the cog stop IS the event under capture (condition 3): the one I10
' exception besides the absolute-current abort; a straddled sample is gated by up (I3). EVT_SLOWER commands
' cpSlowTo at the mark and captures to AT_SPEED on it rather than to rest, reading the ramp's time and hold
' count (task 3604). Fills the cp* staging; the remaining restores are traceEmitCapture()'s.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param eventCode - EVT_* value
'
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - AT_SPEED was reached
' @local bRest - rest was confirmed
' @local markMs - getms() at the mark
' @local captureLeftMs - capture bound still owed after the no-fault wait
' @local shiftDeg - EVT_OFFSET: the computed offset shift that provokes the fault (faultShiftDeg())

    safeEvent := SAFE_NONE
    bReached := FALSE
    cpWantNeg, cpWantPos := wheelGetOffsets(side)
    if bInstArm(INST_SRC_WHEELS, 1) == FALSE
        cpWhy := WHY_INST_NOACK
    else
        wheelCommand(side, motorIncre)
        safeEvent, bReached := waitWatched(side, STEADY_TIMEOUT_MS, CP_LOOP_ATSPEED, UNTIL_AT_SPEED)
        if (safeEvent == SAFE_NONE) and bReached
            safeEvent, _ := waitWatched(side, SETTLE_MS, CP_LOOP_SETTLE, UNTIL_TIME)
        if safeEvent <> SAFE_NONE
            cpWhy := safeWhy(safeEvent)
            cpEnd := safeEnd(safeEvent)
            bCpFaultSeen := (safeEvent == SAFE_FAULT)
        elseif bReached == FALSE
            cpWhy := WHY_STEADY_TIMEOUT
        else
            cpWantNeg, cpWantPos := wheelGetOffsets(side)    ' the pair read immediately before the event
            if eventCode == EVT_SLOWER
                rampLagOpen(side)                           ' before the mark, outside the measured interval (D6)
            instMark()
            markMs := getms()
            case eventCode
                EVT_SLOWER:
                    wheelCommand(side, cpSlowTo)
                EVT_STOPMOTOR:
                    wheelStopMotor(side)
                EVT_STOPCOG:
                    wheelStopRaw(side)
                EVT_ESTOP:
                    wheelEstop(side)
                    bCpEstopSet := TRUE
                EVT_OFFSET:
                    ' task 3572 (PL-59): the computed shift that lands this wheel's error on the fault test, both
                    '  offsets moved by it, so the fault arrives in the next control frame under either sign
                    shiftDeg := faultShiftDeg(side, FALSE)
                    instMark()                              ' re-mark: the shift's error reads took SAMPLE_MS each
                    markMs := getms()
                    wheelSetOffsets(side, cpWantNeg + shiftDeg, cpWantPos + shiftDeg)
                    bCpOffWritten := TRUE
            if eventCode == EVT_OFFSET
                safeEvent, _ := waitWatched(side, POSTFLT_NO_FAULT_MS, CP_LOOP_CAPTURE, UNTIL_TIME)
                if safeEvent == SAFE_FAULT
                    bCpFaultSeen := TRUE
                    safeEvent := SAFE_NONE                  ' the provoked fault is the event, not the capture's end
                elseif safeEvent == SAFE_NONE
                    bRestoreOffsets(side, cpWantNeg, cpWantPos)
                    bCpOffRestored := TRUE
                    wheelStopMotor(side)
                    cpWhy := WHY_NO_FAULT
            if safeEvent == SAFE_NONE
                captureLeftMs := (traceCaptureMs(1) - (getms() - markMs)) #> 0
                if eventCode == EVT_SLOWER
                    ' the mirror still reads the old speed's AT_SPEED until the driver takes the command
                    bReached := FALSE
                    safeEvent, _ := waitWatched(side, COMMAND_SEEN_MS, CP_LOOP_CAPTURE, UNTIL_TIME)
                    if safeEvent == SAFE_NONE
                        safeEvent, bReached := waitWatched(side, (captureLeftMs - COMMAND_SEEN_MS) #> 0, CP_LOOP_CAPTURE, UNTIL_AT_SPEED)
                    rampLagClose(side, markMs, bReached)
                    cpEnd := bReached ? TEND_REST : TEND_TIMEOUT
                else
                    safeEvent, bRest := waitRest(side, captureLeftMs, eventCode <> EVT_OFFSET)
                    cpEnd := bRest ? TEND_REST : TEND_TIMEOUT
            if safeEvent <> SAFE_NONE
                cpEnd := safeEnd(safeEvent)
                if safeEvent == SAFE_FAULT
                    bCpFaultSeen := TRUE
        bCpFrozen := bInstFreeze(0)
        if (bCpFrozen == FALSE) and (cpWhy == WHY_NONE)
            cpWhy := WHY_INST_NOACK

#endif

#ifdef DBG_RUNG
PRI rungMeasure(side, motorIncre, steadyBoundMs, settleMs, windowMs, bPollCurrent, decimation) : safeEvent | slotIdx, otherIdx, startMs, bReached, missedStart, illegalStart, missedEnd, illegalEnd
' One measured rung, the routine LADDER, LIVE and CLOCK share (design sec 4.4): read the offsets,
' duty_max and integrity counts; arm; mark; command; AT_SPEED (<= steadyBoundMs); settle; a WINDOW_MS
' window delimited by two ring totals (rungWindow(), sec 12.7); freeze; window statistics, the
' transition statistics from the command mark to the window start (PL-87), and the capture's idle-wheel
' check; integrity deltas. Fills the rg* staging and the rs* and tr* statistics; emits nothing.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param steadyBoundMs - the AT_SPEED bound
' @param settleMs - settle after AT_SPEED
' @param windowMs - how long the measurement window runs; WINDOW_MS everywhere but LOWSPD, whose edge
'                   rate is too low for a 1 s window to hold a measurable tick count (R18.2)
' @param bPollCurrent - TRUE to read getCurrent() every CURRENT_POLL_MS in the window
' @param decimation - the instrument stores one sample in this many: 1 everywhere but LIMLOW, whose window
'                     and transition together outrun the ring at full rate (task 3604)
' @returns safeEvent - SAFE_* that ended the rung early, SAFE_NONE otherwise
'
' @local slotIdx - motor slot
' @local otherIdx - the idle motor slot
' @local startMs - getms() at the command
' @local bReached - AT_SPEED was reached
' @local missedStart - missed transitions before the rung
' @local illegalStart - illegal codes before the rung
' @local missedEnd - missed transitions after the rung
' @local illegalEnd - illegal codes after the rung

    slotIdx := side - SIDE_LEFT
    otherIdx := SLOT_RIGHT - slotIdx
    rgResult := RES_OK
    rgWhy := WHY_NONE
    rgSteadyMs := 0
    bRgSteadyValid := FALSE
    bRgWindowValid := FALSE
    rgAmpsX10k := 0
    bRgAmpsValid := FALSE
    bRgHbOk := FALSE
    bRgCaptured := FALSE
    bRgIdleUp := FALSE
    rgWinStart := -1
    rgWinEnd := -1
    rgCmdStart := -1
    rgFromIncre := slotLastIncre[slotIdx]                   ' R18.1: 0 when the wheel is at rest
    rgHlTrLag := 0
    rgHlTrCap := 0
    rgHlWinLag := 0
    rgHlWinCap := 0
    rgHlDrvIncr := 0
    bRgHlCmd := FALSE
    bRgHlTrValid := FALSE
    bRgHlWinValid := FALSE
    safeEvent := SAFE_NONE
    bReached := FALSE
    rsOffNeg, rsOffPos := wheelGetOffsets(side)
    foldOffsetCheck(side, rsOffNeg, rsOffPos)
    rgDeadGap, rgDutyMax, _, rgFrameCnt, _ := wheelDriveConstants(side)
    missedStart, illegalStart := wheelIntegrity(side)
    if bInstArm(INST_SRC_WHEELS, decimation) == FALSE
        windowStats(slotIdx, otherIdx, -1, -1)              ' resets the rs* staging; reads no ring long
        transitionStats(slotIdx, -1, -1)                    ' and the tr* staging, likewise
        rgResult := RES_SKIPPED
        rgWhy := WHY_INST_NOACK
    else
        ' R18.1: the health snapshot is taken BEFORE the mark, so nothing stands between the mark and the
        '  command that the transition's first sample has to account for (sec 12.7).
        if isWheelUp(side)                                  ' I3: a stopped driver's status block is stale, never read
            hlCmdLag, hlCmdCap, _ := wheelDriveHealth(side)
            bRgHlCmd := TRUE
        rgCmdStart := instMarkIndex()                       ' PL-87: the transition's first sample, marked before the command
        startMs := getms()
        wheelCommand(side, motorIncre)
        slotLastIncre[slotIdx] := curIncre                  ' what wheelCommand() actually SENT, which is the next rung's from_incre
        ' from a previous rung the mirror still reads AT_SPEED until the driver takes the new command
        safeEvent, _ := waitWatched(side, COMMAND_SEEN_MS, CP_LOOP_ATSPEED, UNTIL_TIME)
        if safeEvent == SAFE_NONE
            safeEvent, bReached := waitWatched(side, steadyBoundMs, CP_LOOP_ATSPEED, UNTIL_AT_SPEED)
        rgSteadyMs := getms() - startMs
        if (safeEvent == SAFE_NONE) and bReached
            bRgSteadyValid := TRUE
            safeEvent, _ := waitWatched(side, settleMs, CP_LOOP_SETTLE, UNTIL_TIME)
            if safeEvent == SAFE_NONE
                safeEvent := rungWindow(side, windowMs, bPollCurrent)
        bRgCaptured := bInstFreeze(0)
        if bRgCaptured
            bRgIdleUp := bCaptureIdleUp(otherIdx)
            windowStats(slotIdx, otherIdx, rgWinStart, rgWinEnd)
            transitionStats(slotIdx, rgCmdStart, rgWinStart)
        else
            windowStats(slotIdx, otherIdx, -1, -1)          ' I10: an unfrozen ring is never read
            transitionStats(slotIdx, -1, -1)
        case safeEvent
            SAFE_FAULT:
                rgResult := RES_FAULT
                rgWhy := WHY_FAULTED
            SAFE_ABS_ABORT:
                rgResult := RES_ABORT_I
                rgWhy := WHY_ABORTED
            SAFE_INST_STALL:
                rgResult := RES_WINDOW_TIMEOUT
                rgWhy := WHY_INST_STALLED
            other:
                if bReached == FALSE
                    rgResult := RES_STEADY_TIMEOUT
                    rgWhy := WHY_STEADY_TIMEOUT
                elseif bRgCaptured == FALSE
                    rgResult := RES_WINDOW_TIMEOUT
                    rgWhy := WHY_INST_NOACK
                elseif rsN == 0
                    rgResult := RES_WINDOW_TIMEOUT
                    rgWhy := WHY_NO_SAMPLES
                else
                    bRgWindowValid := TRUE
    missedEnd, illegalEnd := wheelIntegrity(side)
    rgMissedD := (missedEnd - missedStart) #> 0
    rgIllegalD := (illegalEnd - illegalStart) #> 0

PRI transitionStats(slotIdx, cmdTotal, endTotal) | sampleIdx, startJ, endJ, firstJ, lastJ
' PL-87: the rung's TRANSITION statistics -- peak |err| and peak |i| from the command mark to the window
' start, which is the ramp to the new speed and the settle after it. windowStats() reads only the steady
' window, which opens after both, so its err_pk is the duty servo's ripple and cannot see a kick. The ring
' holds these samples already (the instrument is armed before the command); this pass reads them. A
' command sample the ring has overwritten makes the peak partial, so it is NA (WHY_RING_LOST_HEAD) rather
' than a smaller number. Samples whose driver was not up are left out, as in windowStats() (I3). Separate
' tr* staging, so the rs* statistics BM-RUNG2 prints are untouched.
'
' @param slotIdx - motor slot under test
' @param cmdTotal - total index of the first sample at or after the command mark, -1 when not recorded
' @param endTotal - total index at the window start, -1 when the window never opened
'
' @local sampleIdx - logical index
' @local startJ - logical index of the command's sample
' @local endJ - logical index of the last sample before the window
' @local firstJ - first sample walked, -1 when none
' @local lastJ - last sample walked

    drainBegin()
    trN := 0
    trErrPk := 0
    trIPk := 0
    trMs := 0
    firstJ := -1
    lastJ := -1
    if (cmdTotal < 0) or (endTotal <= cmdTotal) or (drStored == 0)
        trWhy := WHY_NO_SAMPLES
    elseif cmdTotal < drLostHead
        trWhy := WHY_RING_LOST_HEAD
    else
        trWhy := WHY_NONE
        startJ := cmdTotal - drLostHead
        endJ := (endTotal - 1 - drLostHead) <# (drStored - 1)
        if endJ >= startJ                                   ' a descending repeat would walk backwards
            repeat sampleIdx from startJ to endJ
                beat(CP_LOOP_DRAIN)
                if firstJ < 0
                    firstJ := sampleIdx
                lastJ := sampleIdx
                if bSmpUp(sampleIdx, slotIdx)
                    trN += 1
                    trErrPk #>= abs(smpErr(sampleIdx, slotIdx))
                    trIPk #>= abs(smpI(sampleIdx, slotIdx))
        if (firstJ >= 0) and (lastJ > firstJ)
            trMs := (smpT(lastJ) - smpT(firstJ)) / TICKS_PER_MS
        if trN == 0
            trWhy := WHY_NO_SAMPLES

#endif

#ifdef DBG_LOWRUNG
PRI lowStats(slotIdx) | sampleIdx, startJ, endJ, refPos, nowPos, lastEdgeT, gapMs
' The LOWSPD rung's two readings, both of which exist only at this end of the range (R18.2 item 5).
'
'  lsFirstEdgeMs - command mark to the FIRST hall edge. It answers "does it start, and how long does
'                  starting take", which no test has ever asked. No edge before the window opened
'                  leaves it NA rather than zero -- a wheel that never moved is a finding, not a 0 ms
'                  start (D2: a discovery failure must never render as a zero).
'  lsGapMin/Max  - shortest and longest interval between consecutive edges across the window. THE
'                  SAMPLING PROBLEM INVERTS DOWN HERE: at the top rung the instrument gets 1.1 samples
'                  per hall edge and cannot see between edges at all, but at 1x10^6 it gets about 187,
'                  so the SHAPE of the advance is visible. A rotor turning smoothly keeps the two
'                  close; one that cogs -- advancing in steps as each commutation catches it -- spreads
'                  them, and the spread is the reading R18.3 needs to know whether open-loop drive
'                  survives to zero speed.
'
' Both halves read the ring the instrument has already frozen, so they cost no bench time.
'
' @param slotIdx - motor slot under test
'
' @local sampleIdx - logical index
' @local startJ - first logical index of the half being walked
' @local endJ - last logical index of that half
' @local refPos - the position at the last reference point: the half's first up sample, then each edge
' @local nowPos - this sample's position
' @local lastEdgeT - getct() of that reference point, and zero until one has been found
' @local gapMs - interval between the last two edges

    drainBegin()
    lsFirstEdgeMs := 0
    bLsFirstValid := FALSE
    lsEdges := 0
    lsGapMin := POSX
    lsGapMax := 0
    bLsGapValid := FALSE
    ' THE REFERENCE IS THE FIRST *UP* SAMPLE OF EACH HALF, never simply the first. instStore() writes
    '  pos 0 for a motor that is not up, so taking the reference from a down sample would make the next
    '  real reading look like an edge and report a first-edge time that never happened (I3, D2).
    refPos := 0
    lastEdgeT := 0
    ' the transition half: command mark to the window, looking for the first edge
    if (rgCmdStart >= drLostHead) and (rgWinStart > rgCmdStart) and (drStored > 0)
        startJ := rgCmdStart - drLostHead
        endJ := (rgWinStart - 1 - drLostHead) <# (drStored - 1)
        repeat sampleIdx from startJ to endJ
            beat(CP_LOOP_DRAIN)
            if bSmpUp(sampleIdx, slotIdx)
                nowPos := smpPos(sampleIdx, slotIdx)
                if lastEdgeT == 0                           ' the reference sample: its time is the command's
                    refPos := nowPos
                    lastEdgeT := smpT(sampleIdx)
                elseif nowPos <> refPos
                    lsFirstEdgeMs := (smpT(sampleIdx) - lastEdgeT) / TICKS_PER_MS
                    bLsFirstValid := TRUE
                    quit
    ' the window half: every edge, and the spread of the intervals between them
    refPos := 0
    lastEdgeT := 0
    if (rgWinStart >= drLostHead) and (rgWinEnd > rgWinStart) and (drStored > 0)
        startJ := rgWinStart - drLostHead
        endJ := (rgWinEnd - 1 - drLostHead) <# (drStored - 1)
        repeat sampleIdx from startJ to endJ
            beat(CP_LOOP_DRAIN)
            if bSmpUp(sampleIdx, slotIdx)
                nowPos := smpPos(sampleIdx, slotIdx)
                if lastEdgeT == 0
                    refPos := nowPos
                    lastEdgeT := smpT(sampleIdx)
                elseif nowPos <> refPos
                    gapMs := (smpT(sampleIdx) - lastEdgeT) / TICKS_PER_MS
                    lsEdges := (lsEdges + 1) <# LIM_SMALL
                    if lsEdges > 1                          ' the first edge dates from the window start, not from an edge
                        lsGapMin <#= gapMs
                        lsGapMax #>= gapMs
                        bLsGapValid := TRUE
                    lastEdgeT := smpT(sampleIdx)
                    refPos := nowPos
    if bLsGapValid == FALSE
        lsGapMin := 0

#endif

#ifdef DBG_RUNG
PRI foldTransitionKick(slotIdx)
' TRKICK (PL-87, PL-95): a LADDER rung's transition kick, judged on CURRENT. A change of speed from a
' running speed kicks when its transition current peak stands more than TRKICK_EXCESS_MV above what the
' motor then draws holding that same speed -- tr_i_over, the record's own field. Only rungs whose
' transition AND steady window both measured are judged, and a start from rest is not a change of speed
' from a running speed, so it is not one of them -- which is what a zero from_incre says, the same fact
' the record prints as from_rest.
'
' WHAT THIS REPLACES, AND WHY. The cell used to judge tr_over, the same comparison on err, against a
' from-rest control. It PASSED 0 kicks of 22 per wheel at Visit 6a while Stephen felt a kick at every
' increment of the long ramps -- a false pass, and his hand is the control (doctrine D2: when the
' measurement and the system disagree, suspect the measurement). The cause is that err is CLAMPED: the
' lag limiter holds it near LAG_HOLD, so tr_over stayed inside +-5 counts across a ramp on which the
' transition current rose seventy-five-fold. An instrument built on a clamped observable is blind by
' construction, whatever control it is given, which is why the control machinery goes with it.
'
' THE REFERENCE IS THE RUNG'S OWN STEADY PEAK, not a control rung's, because current scales with speed:
' comparing a rung at the knee against a rung at 5x10^6 would measure the ladder, not the transition.
' PL-82's lesson applies to the choice and is respected here -- the reference is a peak against a peak,
' from the same rung, seconds apart, rather than a hold that drifts with motor temperature.
'
' @param slotIdx - motor slot

    if bTrIOverValid() and (rgFromIncre <> 0)               ' non-zero from_incre IS "from a running speed"
        sfTrN[slotIdx] := (sfTrN[slotIdx] + 1) <# LIM_SMALL
        ' the running PEAK excess, clamped at 0: a transition peaking below its own steady window is
        '  no kick rather than a negative one, and 0 is what "never kicked" must read as
        sfTrKickPk[slotIdx] := (sfTrKickPk[slotIdx] #> trIOver()) <# LIM_BIG
#endif

VAR { transition statistics (PL-87) -- cog 0 only }

    LONG    rgCmdStart                                      ' total index of the first sample at or after the command mark
    LONG    trN                                             ' up samples in the transition
    LONG    trErrPk                                         ' peak |err| over the transition, err units
    LONG    trIPk                                           ' peak |i| over the transition, as BM-RUNG2's i_min / i_max
    LONG    trMs                                            ' the transition's span, command sample to last sample before the window
    LONG    trWhy                                           ' WHY_NONE when the tr* values are a measurement
    LONG    sfTrN[INST_MOTORS]                              ' TRKICK: running-speed transitions judged, per motor
    LONG    sfTrKickPk[INST_MOTORS]                         ' TRKICK: peak excess over those transitions, sense mV, 0 when none kicked

VAR { low-speed statistics (R18.2 item 5) -- cog 0 only }

    ' At these rungs the sampling problem INVERTS. High up, the instrument gets 1.1 samples per hall
    '  edge and can see nothing between edges; at 1x10^6 it gets about 187, so the SHAPE of the rotor's
    '  advance is visible here and nowhere else. That is what these record.
    LONG    lsFirstEdgeMs                                   ' command -> first hall edge: does it start, and how long does it take
    LONG    bLsFirstValid                                   ' FALSE when no edge came before the window opened
    LONG    lsEdges                                         ' hall edges counted across the window
    LONG    lsGapMin                                        ' shortest interval between consecutive edges, ms
    LONG    lsGapMax                                        ' longest -- with lsGapMin this is the COGGING reading: smooth
    LONG    bLsGapValid                                     '  advance keeps them close, a stepping rotor spreads them

#ifdef DBG_RUNG
PRI rungWindow(side, windowMs, bPollCurrent) : safeEvent | startMs, lastPollMs, ampsSum, ampsCount, hbStart, bComplete, hlWinLag, hlWinCap, hlEndLag, hlEndCap
' The rung's measurement window: a start mark (ring total), windowMs of beat-polled safety reads with
' getCurrent() every CURRENT_POLL_MS when asked, and an end mark. The window is delimited by the two
' instrument-recorded totals, never by time (sec 12.7). An interrupted window records no end total.
'
' R18.1: the driver's health counters are read at each mark, which closes the TRANSITION's difference
' and opens and closes the STEADY window's. Both reads are outside the measured interval.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param windowMs - how long the window runs
' @param bPollCurrent - TRUE to read getCurrent()
' @returns safeEvent - SAFE_* that ended the window early, SAFE_NONE otherwise
'
' @local startMs - getms() at the start mark
' @local lastPollMs - getms() of the last getCurrent()
' @local ampsSum - sum of clamped readings, |sum| <= 51 x LIM_MID
' @local ampsCount - readings taken
' @local hbStart - instrument heartbeat at the window start
' @local bComplete - the window ran its full windowMs
' @local hlWinLag - lag_held at the window start
' @local hlWinCap - duty_capped at the window start
' @local hlEndLag - lag_held at the window end
' @local hlEndCap - duty_capped at the window end

    safetyReset()
    safeEvent := SAFE_NONE
    ampsSum := 0
    ampsCount := 0
    bComplete := FALSE
    hbStart := instHeartbeat
    ' R18.1: close the TRANSITION's health difference and open the WINDOW's, both from one read. It sits
    '  outside the measured interval, before the window's own mark and clock (doctrine D6).
    if bRgHlCmd and isWheelUp(side)
        hlWinLag, hlWinCap, rgHlDrvIncr := wheelDriveHealth(side)
        rgHlTrLag := hlWinLag - hlCmdLag                    ' NOT floored at zero: only a driver restart can
        rgHlTrCap := hlWinCap - hlCmdCap                    '  make it negative, and that must be visible
        bRgHlTrValid := TRUE
    rgWinStart := instMarkIndex()
    startMs := getms()
    lastPollMs := startMs
    repeat
        beat(CP_LOOP_WINDOW)
        if bPollCurrent and ((ampsCount == 0) or ((getms() - lastPollMs) >= CURRENT_POLL_MS))
            lastPollMs := getms()
            ampsSum += (wheelCurrent(side) #> (0 - LIM_MID)) <# LIM_MID
            ampsCount += 1
        waitms(SAMPLE_MS)
        safeEvent := safetyPoll(side)
        if safeEvent <> SAFE_NONE
            quit
        if (getms() - startMs) >= windowMs
            bComplete := TRUE
            quit
    if bComplete
        rgWinEnd := instMarkIndex()
        if bRgHlTrValid and isWheelUp(side)                 ' R18.1: the steady window's health difference
            hlEndLag, hlEndCap, _ := wheelDriveHealth(side)
            rgHlWinLag := hlEndLag - hlWinLag
            rgHlWinCap := hlEndCap - hlWinCap
            bRgHlWinValid := TRUE
    bRgHbOk := (instHeartbeat <> hbStart)
    if ampsCount > 0
        rgAmpsX10k := ampsSum / ampsCount
        bRgAmpsValid := bComplete

PRI rungEmitAll(seg, rid, rungIdx, side, motorIncre) | slotIdx, rung2Why
' Emit a measured rung's BM-RUNG, BM-RUNG2, BM-RUNGTR, BM-RUNGHL and BM-RUNG3 from the rg* / rs* / tr*
' staging, and fold it into R14-DUAL-INTEG-A (its integrity deltas), R14-DUAL-IDLEFLT-A (one motor-frame
' capture) and, for a LADDER rung, R17-DUAL-TRKICK-A (its transition current above its own steady peak).
'
' @param seg - SEG_* in progress
' @param rid - rung id
' @param rungIdx - index into ladderIncre (or the segment's rung number)
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
'
' @local slotIdx - motor slot
' @local rung2Why - BM-RUNG2's why: the rung's, or NO_SAMPLES when only this lifetime's zero is missing

    slotIdx := side - SIDE_LEFT
    emitRung(seg, rid, rungIdx, side, motorIncre, rgResult, rgSteadyMs, bRgSteadyValid, bRgWindowValid, rgWhy)
    rung2Why := rgWhy
    if (rung2Why == WHY_NONE) and (bLifeZeroValid[slotIdx] == FALSE)
        rung2Why := WHY_NO_SAMPLES
    emitRung2(rid, side, motorIncre, rgDutyMax, bRgWindowValid, rung2Why)
    emitRungTransition(rid, side, motorIncre)
    emitRung3(rid, side, motorIncre, rgMissedD, rgIllegalD, rgAmpsX10k, bRgAmpsValid, bRgWindowValid, rgWhy)
    if (seg == SEG_LADDER) or (seg == SEG_KICK)             ' SRC_REV 54: part KICK's walk is the ladder's, judged the same way
        foldTransitionKick(slotIdx)
    foldIntegrity(slotIdx, rgMissedD, rgIllegalD)
    sfIntegN[slotIdx] := (sfIntegN[slotIdx] + 1) <# LIM_BIG
    if bRgCaptured
        foldIdleWheel(slotIdx, bRgIdleUp)
    segItems := (segItems + 1) <# LIM_SMALL

PRI rungSkip(seg, rid, rungIdx, side, motorIncre, whyCode)
' Emit a rung that did not run: BM-RUNG result SKIPPED with the applied offsets and why.
'
' @param seg - SEG_* in progress
' @param rid - rung id
' @param rungIdx - index into ladderIncre (or the segment's rung number)
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param whyCode - WHY_* naming why it did not run

    rsOffNeg, rsOffPos := wheelGetOffsets(side)
    foldOffsetCheck(side, rsOffNeg, rsOffPos)
    emitRung(seg, rid, rungIdx, side, motorIncre, RES_SKIPPED, 0, FALSE, FALSE, whyCode)
    segItems := (segItems + 1) <# LIM_SMALL

PRI bRungFaultRecover(seg, side, motorIncre, safeEvent) : bFaulted | bFaultSig
' Recover a rung's fault once its records are out (sec 4.2): a fault that ended the rung, or a fault
' flag set now.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - the rung's command
' @param safeEvent - SAFE_* that ended the rung
' @returns bFaulted - TRUE when a fault was found and recovery ran
'
' @local bFaultSig - the fault flag now

    bFaulted := (safeEvent == SAFE_FAULT)
    if (bFaulted == FALSE) and isWheelUp(side)
        _, _, bFaultSig := wheelClearedState(side)
        bFaulted := (bFaultSig <> FALSE)
    if bFaulted
        bRecoverFault(seg, 0, side, motorIncre, FAULT_COOL_MS)

#endif

#ifdef DBG_LADDER
PRI ladderSign(seg, side, signMul, pRungTable, rungCount) | orderIdx, rungIdx, motorIncre, rid, whyCode, consecFaults, safeEvent, bFaulted
' One motor x sign of the ladder, driven by an index table into ladderIncre (LADDER passes
' ladderAllIdx): one lifetime (zero read inside bWheelStart()), then the rungs in table order, each
' BM-RUNG / BM-RUNG2 / BM-RUNGTR / BM-RUNGHL / BM-RUNG3, faults recovered per sec 4.2. LADDER_FAULT_STOP consecutive faulted
' rungs, an absolute-current abort or a stalled instrument end the sign: the rest print SKIPPED why
' LADDER_STOPPED.
'
' @param seg - SEG_LADDER
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signMul - SIGN_NEG or SIGN_POS
' @param pRungTable - address of a LONG table of indices into ladderIncre
' @param rungCount - entries in that table
'
' @local orderIdx - position in the table
' @local rungIdx - index into ladderIncre
' @local motorIncre - signed increment
' @local rid - rung id
' @local whyCode - why the remaining rungs are skipped, WHY_NONE while they run
' @local consecFaults - consecutive faulted rungs
' @local safeEvent - SAFE_* that ended the last rung
' @local bFaulted - the rung just measured faulted and was recovered, so it counts toward LADDER_FAULT_STOP

    consecFaults := 0
    bFaulted := FALSE
    whyCode := WHY_NONE
    if bRunContinue(seg) == FALSE
        whyCode := WHY_ABORTED
    elseif bWheelStart(seg, side) == FALSE
        whyCode := stWhy
    repeat orderIdx from 0 to rungCount - 1
        beat(CP_LOOP_POLL)
        rungIdx := LONG[pRungTable][orderIdx]
        motorIncre := ladderIncre[rungIdx] * signMul
        rid := nextRungId()
        whyCode := trialSkipWhy(seg, side, whyCode)
        if whyCode <> WHY_NONE
            rungSkip(seg, rid, rungIdx, side, motorIncre, whyCode)
        else
            safeEvent := rungMeasure(side, motorIncre, LADDER_STEADY_MS, LADDER_SETTLE_MS, WINDOW_MS, TRUE, 1)
            rungEmitAll(seg, rid, rungIdx, side, motorIncre)
            ladderNoFold(side, rungIdx, motorIncre)
            ladderServo(side, rungIdx, motorIncre)          ' SRC_REV 73: SRVHUNT (A-3) and SRVKEEP (A-5)
#ifdef DBP_KICK
            kickStats(side - SIDE_LEFT)                     ' SRC_REV 54: the frozen ring, before a recovery can re-arm it (I10)
            emitKickTr(rid, side, motorIncre)
#endif
            bFaulted := bRungFaultRecover(seg, side, motorIncre, safeEvent)      ' a recovered fault leaves the wheel at rest, which slotLastIncre records
            if bFaulted
                consecFaults += 1
                if consecFaults >= LADDER_FAULT_STOP
                    whyCode := WHY_LADDER_STOPPED
            else
                consecFaults := 0
            if (safeEvent == SAFE_ABS_ABORT) or (safeEvent == SAFE_INST_STALL)
                whyCode := WHY_LADDER_STOPPED
    bZeroAndWaitStopped(side)
    bInstIdle()
    wheelStop(side)

PRI ladderNoFold(side, rungIdx, motorIncre) | slotIdx, predX10, ratioPct, bandPct, bDeratedNow
' Below the MOSFET limits the new current limiting must not act at all. That is TWO claims, and PL-79
' SPLIT THEM INTO TWO CELLS because one compound verdict could report neither:
'
'  NOFOLD  - the front cog never derated at a base rung. This is the claim the cell is named for, and it
'            is judged alone, so it can now say so.
'  RATELAW - every base rung still turns at the rate the speed law predicts, within a band that includes
'            the rung's OWN tick quantisation (rateBandPct()). C-1's cell judges the law; this one judges
'            whether a limiter moved it.
'
' WHY THEY HAD TO SEPARATE. One ANDed boolean covered both claims over every base rung, and rung 0 failed
' it unconditionally -- +/-3 % is narrower than the ~7.5 % that one tick is worth in a 13-tick count -- so
' the cell read FALSE on a driver tracking the law to 0.1 %, and a REAL fold-back at any rung would have
' been indistinguishable from that (doctrine D2: a gate that cannot fail on the thing it names has not
' passed). Read after the rung's window, from the rung's own statistics.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param rungIdx - index into ladderIncre
' @param motorIncre - the rung's signed increment
'
' @local slotIdx - motor slot
' @local predX10 - the rung's predicted rate x10
' @local ratioPct - measured rate as a percentage of the prediction
' @local bandPct - percent one tick of quantisation is worth at this rung's tick count
' @local bDeratedNow - the fold-back holds the continuous limit right now

    if rungIdx < LADDER_BASE_RUNGS
        slotIdx := side - SIDE_LEFT
        bDeratedNow := bWheelDerated(side)
        predX10 := predictX10(abs(motorIncre))
        ' the fold half: measurable on any base rung whose wheel answered, window or no window
        bSfNoFoldRan[slotIdx] := TRUE
        bSfNoFoldOk[slotIdx] := bSfNoFoldOk[slotIdx] and (bDeratedNow == FALSE)
        ' the rate half: only a valid window with a non-zero count and a prediction can be judged
        if bRgWindowValid and (predX10 > 0) and (rsTicks <> 0)
            ratioPct := (abs(rsRateX10) * 100) / predX10
            bandPct := rateBandPct(rsTicks)
            bSfRateLawRan[slotIdx] := TRUE
            bSfRateLawOk[slotIdx] := bSfRateLawOk[slotIdx] and (ratioPct >= (RATELAW_PCT_LO - bandPct)) and (ratioPct <= (RATELAW_PCT_HI + bandPct))

PRI ladderServo(side, rungIdx, motorIncre) | slotIdx, signIdx, pRef, refDuty, refInet, inet
' SRVHUNT (A-3) and SRVKEEP (A-5), the servo fix's wheels-up cells (SRC_REV 73, task 3654), read from the rung's own steady
' window after rungMeasure(), as ladderNoFold() is. Only a valid window counts, and SRVKEEP also needs this lifetime's zero
' (inet is net of it); a judged window sets its direction's bit, so a cell missing a direction reports NOMEAS. Every
' visit of a rung is judged: the climb, the descent and the delta walk all reach rungs 1, 2, 7 and 8.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param rungIdx - index into ladderIncre
' @param motorIncre - the rung's signed increment
'
' @local slotIdx - motor slot
' @local signIdx - 0 reverse, 1 forward
' @local pRef - this wheel and direction's row of srvKeepRef
' @local refDuty - the DRIVER_REV 46 steady duty at this rung
' @local refInet - the DRIVER_REV 46 inet_x10 at this rung
' @local inet - this window's net current, x10

    if bRgWindowValid
        slotIdx := side - SIDE_LEFT
        signIdx := (motorIncre < 0) ? 0 : 1
        if (rungIdx >= SRVHUNT_RUNG_LO) and (rungIdx <= SRVHUNT_RUNG_HI)
            srvHuntSigns[slotIdx] |= DECOD signIdx
            bSfSrvHuntOk[slotIdx] := bSfSrvHuntOk[slotIdx] and ((rsDutyPk - rsDutyMean) <= SRVHUNT_SWING_MAX) and (rsErrPk <= SRVHUNT_ERRPK_MAX)
        elseif (rungIdx >= SRVKEEP_RUNG_LO) and (rungIdx <= SRVKEEP_RUNG_HI) and bLifeZeroValid[slotIdx]
            pRef := @srvKeepRef[((slotIdx * 2) + signIdx) * 4 + ((rungIdx - SRVKEEP_RUNG_LO) * 2)]
            refDuty := LONG[pRef][0]
            refInet := LONG[pRef][1]
            inet := rsIMeanX10 - lifeZeroX10[slotIdx]
            srvKeepSigns[slotIdx] |= DECOD signIdx
            bSfSrvKeepOk[slotIdx] := bSfSrvKeepOk[slotIdx] and ((abs(rsDutyMean - refDuty) * 100) <= (SRVKEEP_PCT * refDuty)) and ((abs(inet - refInet) * 100) <= (SRVKEEP_PCT * refInet))

#endif

#ifdef DBG_RUNG
PRI rateBandPct(nTicks) : nExtraPct
' What one tick of quantisation is worth, in percent, at this rung's own tick count (PL-79). RATELAW's
' band is the criterion PLUS this, so the criterion is never narrower than the resolution the rung had:
' at 14 ticks one tick is about 7 %, at 441 it is under 1 %. Rounded up by one, so the band is never
' short by the division's remainder.
'
' @param nTicks - the rung's measured tick count over the window, signed and non-zero
' @returns nExtraPct - percent to widen each side of the band by

    nExtraPct := ((RATELAW_QUANT_TICKS * 100) / abs(nTicks)) + 1

#endif

#ifdef DBP_A
PRI liveRung(side, rid, rungNum, motorIncre, skipWhy) : whyNext | slotIdx, safeEvent, rpmRead
' One LIVE rung (design sec 4.4, T1-2): AT_SPEED, settle LIVE_SETTLE_MS so the rpm window fills, a
' WINDOW_MS instrument window, then testGetRpm(); BM-LIVE, BM-RUNGTR and BM-RUNGHL. The QTR rung folds
' R14-DUAL-INSTLIVE-A: every sample up, |ticks| >= LIVE_MIN_TICKS, i_min <> i_max, heartbeat advanced,
' |ticks - hw_ticks| <= 2.
'
' R17-DUAL-TRKICK-A is NOT folded here, deliberately. These rungs settle LIVE_SETTLE_MS against the
' ladder's LADDER_SETTLE_MS, so their transition window is a different length and their tr_i_pk is not
' the same measurement; one verdict over two populations can fail on the mixture rather than on the
' drive (doctrine D2). The records are emitted, and Visit 7 reads them beside the ladder's.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param rid - rung id
' @param rungNum - 0 QTR, 1 HALF, 2 LIVE_TOP_INCRE
' @param motorIncre - signed increment
' @param skipWhy - WHY_NONE to run, else why it is skipped
' @returns whyNext - skip cause for the next rung, WHY_NONE while rungs may run
'
' @local slotIdx - motor slot
' @local safeEvent - SAFE_* that ended the rung
' @local rpmRead - testGetRpm() after the window

    slotIdx := side - SIDE_LEFT
    whyNext := skipWhy
    rpmRead := 0
    if skipWhy <> WHY_NONE
        windowStats(slotIdx, SLOT_RIGHT - slotIdx, -1, -1)  ' resets the rs* staging; reads no ring long
        emitLive(rid, side, motorIncre, rpmRead, FALSE, FALSE, skipWhy)
    else
        safeEvent := rungMeasure(side, motorIncre, STEADY_TIMEOUT_MS, LIVE_SETTLE_MS, WINDOW_MS, FALSE, 1)
        if bRgWindowValid
            rpmRead := wheelRpm(side)
        emitLive(rid, side, motorIncre, rpmRead, bRgHbOk, bRgWindowValid, rgWhy)
        ' R18.1 (PL-87): the SHORT ramps are measured too. Stephen felt a kick between rungs 2 and 3 of
        '  these three, and until now the segment emitted no transition record at all -- only LADDER and
        '  CLOCK did. Same shared pair they emit, so the two paths cannot record a transition differently.
        emitRungTransition(rid, side, motorIncre)
        if rungNum == LIVE_INSTLIVE_RUNG
            bSfLiveRan[slotIdx] := bRgSteadyValid
            bSfLiveOk[slotIdx] := bRgWindowValid and bRsAllUp and (abs(rsTicks) >= LIVE_MIN_TICKS) and (rsIMin <> rsIMax) and bRgHbOk and (abs(rsTicks - rsHwTicks) <= LIVE_HW_TOLERANCE)
        if bRungFaultRecover(SEG_LIVE, side, motorIncre, safeEvent)
            whyNext := WHY_FAULTED                          ' a recovery restart ends the sense cog testGetRpm() needs
        elseif (safeEvent == SAFE_ABS_ABORT) or (safeEvent == SAFE_INST_STALL)
            whyNext := safeWhy(safeEvent)
    segItems := (segItems + 1) <# LIM_SMALL

#endif

#ifdef DBP_CLOCK
PRI clockHallIntegrity(side) | slotIdx, nMissed, nAllLow, nAllHigh
' PL-90 / PL-69 (task 3571): this wheel's hall integrity over its CLOCK lifetime -- entries into %000, into %111,
' and missed transitions -- printed as BM-HALLINT and folded into this clock's R17-DUAL-HALL-K* cell. The counts
' restart with every driver start, so the lifetime is the window: start, zero window, one rung, settle.
'
' THE BEFORE IS ALREADY ON FILE: Visit 3's 200 MHz load read 3 and 5 illegal codes on the RIGHT motor and none
' at 270 or 300 (PL-69), with the three-TESTP read and no input filter. This load carries the atomic read and
' the filt1 input filter, so the same load at the same clock is the comparison, and the %000/%111 split says
' which way a line was pulled when one still appears.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
'
' @local slotIdx - motor slot
' @local nMissed - missed transitions since this lifetime's start
' @local nAllLow - entries into %000
' @local nAllHigh - entries into %111

    slotIdx := side - SIDE_LEFT
    nMissed, _ := wheelIntegrity(side)
    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT                                   ' if/else, never `? :` -- PL-29, PL-76
        nAllLow, nAllHigh := wheelR.getHallIllegalCodes()
    else
        nAllLow, nAllHigh := wheelL.getHallIllegalCodes()
    beat(CP_LIB_QUERY)
    sfHallIllegal[slotIdx] := (sfHallIllegal[slotIdx] + nAllLow + nAllHigh) <# LIM_BIG
    sfHallLives[slotIdx] := (sfHallLives[slotIdx] + 1) <# LIM_SMALL
    emitHallInt(side, nAllLow, nAllHigh, nMissed)

PRI emitHallInt(side, nAllLow, nAllHigh, nMissed)
' BM-HALLINT (task 3571): one wheel's hall integrity over its CLOCK lifetime. Worst case 113 bytes:
' tag(10) + seq(15) + motor(12) + clk_mhz(13) + all_low(21) + all_high(22) + missed(20).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param nAllLow - entries into %000
' @param nAllHigh - entries into %111
' @param nMissed - missed transitions

    recBegin(@"BM-HALLINT")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"clk_mhz", CLK_FREQ / US_PER_SEC, LIM_TINY)
    benchLog.numField(@"all_low", nAllLow, LIM_BIG)
    benchLog.numField(@"all_high", nAllHigh, LIM_BIG)
    benchLog.numField(@"missed", nMissed, LIM_BIG)
    emitRecord()

PRI clockLifetime(side, signMul) | slotIdx, whyCode, deadGap, adcFrame, frameCnt, bFrameOk, rid, motorIncre, safeEvent
' One CLOCK lifetime (design sec 4.4, T1-4): start; testGetDriveConstants() -> BM-CLOCK, folded into
' this clock's R14-DUAL-CLKFRM-K200 / -K270 / -K300 cell (ANDed over the motor's lifetimes; judged only at a
' swept clock, SF_JUDGES_CELLS); zero (inside bWheelStart()); one rung at
' CLOCK_RUNG_INCRE -> BM-RUNG / BM-RUNG2 / BM-RUNG3.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signMul - SIGN_NEG or SIGN_POS
'
' @local slotIdx - motor slot
' @local whyCode - why the rung is skipped, WHY_NONE when it runs
' @local deadGap - dead_gap
' @local adcFrame - adc_fram
' @local frameCnt - frame_cnt
' @local bFrameOk - adc_fram equals the compiled clock's expected frame count
' @local rid - rung id
' @local motorIncre - signed increment
' @local safeEvent - SAFE_* that ended the rung

    slotIdx := side - SIDE_LEFT
    motorIncre := CLOCK_RUNG_INCRE * signMul
    whyCode := WHY_NONE
    if bRunContinue(SEG_CLOCK) == FALSE
        whyCode := WHY_ABORTED
    elseif bWheelStart(SEG_CLOCK, side) == FALSE
        whyCode := stWhy
    else
        deadGap, _, adcFrame, frameCnt, _ := wheelDriveConstants(side)
        bFrameOk := bEmitClock(side, adcFrame, frameCnt, deadGap)
        if bSfClkRan[slotIdx]
            bSfClkOk[slotIdx] := (bSfClkOk[slotIdx] <> FALSE) and bFrameOk
        else
            bSfClkOk[slotIdx] := bFrameOk
        bSfClkRan[slotIdx] := TRUE
    rid := nextRungId()
    whyCode := trialSkipWhy(SEG_CLOCK, side, whyCode)
    if whyCode <> WHY_NONE
        rungSkip(SEG_CLOCK, rid, CLOCK_RUNG_IDX, side, motorIncre, whyCode)
    else
        safeEvent := rungMeasure(side, motorIncre, LADDER_STEADY_MS, LADDER_SETTLE_MS, WINDOW_MS, TRUE, 1)
        clockHallIntegrity(side)
        rungEmitAll(SEG_CLOCK, rid, CLOCK_RUNG_IDX, side, motorIncre)
        bRungFaultRecover(SEG_CLOCK, side, motorIncre, safeEvent)
    bZeroAndWaitStopped(side)
    bInstIdle()
    wheelStop(side)

#endif

#ifdef DBP_B
PRI faultbTrial(side, signMul, trialIdx, skipWhy) | slotIdx, tid, motorIncre, accelUp, safeEvent, bReached, startMs, bStopped
' One FAULTB trial (design sec 4.4, T1-7): wheel stopped; the trial's speed-up rate (fbAccelRates, SRC_REV 61; its
' limit was set raw at SRC_REV 59) with the built-in slow-down rate, through wheelSetRamp(), its limit read
' back; arm; mark; FB_INCRE from standstill; capture until AT_SPEED + FB_AT_SPEED_HOLD_MS, a fault,
' or FB_TIMEOUT_MS; freeze; restore the ramp defaults and read them back (BM-RAMPREST, I11) BEFORE any
' check; BM-TRACE cause RAMP, BM-TS, BM-TRACE-END; peaks and dsat from the trace; recovery (sec 4.2);
' BM-FBTRIAL; zero, wait stopped; cool FAULT_TRIAL_COOL_MS.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signMul - SIGN_NEG or SIGN_POS
' @param trialIdx - 0-based trial, index into fbAccelRates
' @param skipWhy - WHY_NONE to run, else why the lifetime could not start
'
' @local slotIdx - motor slot
' @local tid - trace id
' @local motorIncre - signed increment
' @local accelUp - accel_up (the speed-up limit, maxRamp) read back for the header
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - AT_SPEED was reached
' @local startMs - getms() at the command
' @local bStopped - the trial's own stop from speed reached rest inside the capture

    slotIdx := side - SIDE_LEFT
    tid := nextTraceId()
    bStopped := FALSE
    motorIncre := FB_INCRE * signMul
    cpReset()
    fbTrial := trialIdx + 1
    fbAccelUp := 0                                                  ' the limit read back once set; 0 for a skipped trial
    fbIncre := motorIncre
    fbResult := RES_OK
    fbTMs := 0
    bFbTValid := FALSE
    fbIPk := 0
    fbDutyPk := 0
    bFbDsat := FALSE
    fbRst := RST_NONE
    fbRstMs := 0
    safeEvent := SAFE_NONE
    bReached := FALSE
    _, fbDutyMax, _, _, _ := wheelDriveConstants(side)
    cpWantNeg, cpWantPos := wheelGetOffsets(side)
    fbOffNeg := cpWantNeg
    fbOffPos := cpWantPos
    fbWhy := trialSkipWhy(SEG_FAULTB, side, skipWhy)
    if fbWhy <> WHY_NONE
        accelUp := wheelAccelUp(side)
        fbResult := RES_SKIPPED
        traceSkip(tid, SEG_FAULTB, side, CAUSE_RAMP, motorIncre, MODE_FLOAT, accelUp, fbWhy)
    else
        accelUp, _ := wheelSetRamp(side, fbAccelRates[trialIdx], RAMP_DEF_DECEL_MM_S2)
        fbAccelUp := accelUp
        if bInstArm(INST_SRC_WHEELS, 1) == FALSE
            cpWhy := WHY_INST_NOACK
        else
            safeEvent, _ := waitWatched(side, STOP_TIMEOUT_MS, CP_LOOP_STOPPED, UNTIL_STOPPED)
            if safeEvent == SAFE_NONE
                instMark()
                startMs := getms()
                wheelCommand(side, motorIncre)
                safeEvent, bReached := waitWatched(side, FB_TIMEOUT_MS, CP_LOOP_CAPTURE, UNTIL_AT_SPEED)
                fbTMs := getms() - startMs
                bFbTValid := bReached or (safeEvent == SAFE_FAULT)
                if (safeEvent == SAFE_NONE) and bReached
                    safeEvent, _ := waitWatched(side, FB_AT_SPEED_HOLD_MS, CP_LOOP_CAPTURE, UNTIL_TIME)
                    ' task 3558: THE STOP IS NOW PART OF THE TRIAL, inside the same capture. The design
                    '  bounds the current a stop from speed draws, and Visit 2 measured the unbounded one
                    '  tripping this harness's own 10 A abort (PL-55) -- so the stop has to be measured on
                    '  the same instrument, on the same scale, as the hold it is compared against. A trial
                    '  that faulted or aborted on the way up never reaches here and stops nothing.
                    if safeEvent == SAFE_NONE
                        wheelStopMotor(side)
                        safeEvent, bStopped := waitRest(side, STOP_TIMEOUT_MS, TRUE)
            bCpFaultSeen := (safeEvent == SAFE_FAULT)
            if safeEvent <> SAFE_NONE
                cpEnd := safeEnd(safeEvent)
            elseif bStopped
                cpEnd := TEND_REST
            else
                cpEnd := bReached ? TEND_FROZEN : TEND_TIMEOUT
            bCpFrozen := bInstFreeze(0)
            if bCpFrozen == FALSE
                cpWhy := WHY_INST_NOACK
        bRestoreRamp(side)                                   ' I11: before any check, on every path that set the ramp
        case safeEvent
            SAFE_FAULT:
                fbResult := RES_FAULT
                if bFbTValid == FALSE
                    cpWhy := WHY_FAULTED                    ' faulted before the command
            SAFE_ABS_ABORT:
                fbResult := RES_ABORT_I
                cpWhy := WHY_ABORTED
            SAFE_INST_STALL:
                fbResult := RES_WINDOW_TIMEOUT
                cpWhy := WHY_INST_STALLED
            other:
                if cpWhy <> WHY_NONE
                    fbResult := RES_SKIPPED
                elseif bReached == FALSE
                    fbResult := RES_STEADY_TIMEOUT
                    cpWhy := WHY_STEADY_TIMEOUT
        traceEmitCapture(SEG_FAULTB, side, tid, CAUSE_RAMP, motorIncre, MODE_FLOAT, accelUp)
        if bCpFrozen
            traceFaultStats(slotIdx)
            traceStopCurrent(slotIdx)
            emitStopCur(tid, side, slotIdx)
            fbFoldCells(slotIdx, safeEvent, bReached)
        fbRst, fbRstMs := traceRecover(SEG_FAULTB, side, tid, motorIncre, FAULT_TRIAL_COOL_MS)
        if bFbTValid == FALSE
            fbWhy := (cpWhy <> WHY_NONE) ? cpWhy : WHY_NOT_REACHED
        if fbRst == RST_NONE
            waitBeat(FAULT_TRIAL_COOL_MS, CP_LOOP_COOL)
    emitFbTrial(tid, side)
    segItems := (segItems + 1) <# LIM_SMALL

PRI traceStopCurrent(slotIdx) | sampleIdx, iSum, holdCount, eDrvrState, bSawStop
' STOPCUR's numbers, from the frozen FAULTB capture: over the AT_SPEED hold, the mean AND THE PEAK
' sense_i; over the spin-down, the largest sense_i.
'
' PL-82: THE HOLD PEAK IS TAKEN BECAUSE A PEAK MUST BE COMPARED WITH A PEAK. The cell used to compare the
' spin-down peak against the hold MEAN, which the AT_SPEED ripple alone can lose -- the design's own
' unloaded trace swings sense_i over a visible range while the mean sits well under it. The mean is kept
' because it is what the thermal drift is visible in; neither is the criterion any more (see
' STOPCUR_BOUND_MV).
'
' The two windows are told apart by the DRIVER'S OWN STATE, not by a time this cog recorded: a trial
' reaches AT_SPEED once and leaves it once, so the states partition the capture without any index
' bookkeeping, and every reading comes from the same scale. Legal only while FROZEN (I10).
'
' @param slotIdx - motor slot under test
'
' @local sampleIdx - logical index
' @local iSum - sum of sense_i over the hold
' @local holdCount - hold samples
' @local eDrvrState - the sample's driver state
' @local bSawStop - a spin-down sample was seen

    scHoldIX10[slotIdx] := 0
    scHoldPk[slotIdx] := 0
    scStopPk[slotIdx] := 0
    scSamples[slotIdx] := 0
    bScValid[slotIdx] := FALSE
    iSum := 0
    holdCount := 0
    bSawStop := FALSE
    if (drStored > 0) and (drEndJ >= drStartJ)
        repeat sampleIdx from drStartJ to drEndJ
            beat(CP_LOOP_DRAIN)
            if bSmpUp(sampleIdx, slotIdx)
                eDrvrState := smpState(sampleIdx, slotIdx)
                if eDrvrState == DCS_AT_SPEED
                    iSum += smpI(sampleIdx, slotIdx)
                    scHoldPk[slotIdx] #>= smpI(sampleIdx, slotIdx)
                    holdCount += 1
                elseif eDrvrState == DCS_SPIN_DN
                    scStopPk[slotIdx] #>= smpI(sampleIdx, slotIdx)
                    bSawStop := TRUE
    if (holdCount > 0) and bSawStop
        scHoldIX10[slotIdx] := (iSum * X10) / holdCount
        scSamples[slotIdx] := holdCount
        bScValid[slotIdx] := TRUE

PRI fbFoldCells(slotIdx, safeEvent, bReached)
' The two FAULTB cells, folded from the trial that has just been emitted.
'
'  STOPCUR   - the stop's peak current stayed under STOPCUR_BOUND_MV, a FIXED bound, and the harness's
'              10 A abort never fired. MEASURED at Visit 2 on the unbounded stop: 20-50 % above the hold,
'              and two trials aborted outright (PL-55). PL-82: it used to be judged against the hold
'              current measured moments earlier, which drifts about 25 % as the motor warms -- so the cell
'              failed on its reference rather than on the stop. The hold's mean and peak are still
'              recorded in BM-STOPCUR; they are evidence for the reader, not the criterion.
'  RMPDROOP  - a ramp the motor cannot follow now DROOPS instead of faulting. The three steep trials
'              (ramp_inc 500, 2_000 and 10_000) faulted 3 of 3 at Visit 2, in 96-186 ms; with the lag
'              limiter the field waits for the rotor and the trial reaches speed instead. SRC_REV 59
'              (DRIVER_REV 38): judged on the trials whose speed-up limit is at or above FB_DROOP_MIN_ACCEL, the
'              200_000 a pass each Visit 2 fault reached (the CON says why); the lag gate now eases the
'              acceleration toward 0 rather than freezing the field.
'
' @param slotIdx - motor slot
' @param safeEvent - SAFE_* that ended the trial
' @param bReached - AT_SPEED was reached

    if bScValid[slotIdx]
        bSfStopCurRan[slotIdx] := TRUE
        bSfStopCurOk[slotIdx] := bSfStopCurOk[slotIdx] and (scStopPk[slotIdx] <= STOPCUR_BOUND_MV) and (safeEvent <> SAFE_ABS_ABORT)
    if fbAccelUp >= FB_DROOP_MIN_ACCEL
        bSfDroopRan[slotIdx] := TRUE
        bSfDroopOk[slotIdx] := bSfDroopOk[slotIdx] and bReached and (fbResult <> RES_FAULT) and (bCpFaultSeen == FALSE)

PRI traceFaultStats(slotIdx) | sampleIdx, bFirstFlt
' BM-FBTRIAL's peaks from the drained trace: the largest i and duty over up samples, and dsat, whether
' duty had reached duty_max at the first sample whose fault flag is set. Legal only while FROZEN (I10).
'
' @param slotIdx - motor slot under test
'
' @local sampleIdx - logical index
' @local bFirstFlt - the first faulted sample has been seen

    fbIPk := 0
    fbDutyPk := 0
    bFbDsat := FALSE
    bFirstFlt := FALSE
    if (drStored > 0) and (drEndJ >= drStartJ)
        repeat sampleIdx from drStartJ to drEndJ
            beat(CP_LOOP_DRAIN)
            if bSmpUp(sampleIdx, slotIdx)
                fbIPk #>= smpI(sampleIdx, slotIdx)
                fbDutyPk #>= smpDuty(sampleIdx, slotIdx)
                if (bFirstFlt == FALSE) and bSmpFault(sampleIdx, slotIdx)
                    bFirstFlt := TRUE
                    bFbDsat := (smpDuty(sampleIdx, slotIdx) >= fbDutyMax)
#endif

#ifdef DBG_OVERSHT
PRI overshootTrial(seg, sid, leftFt, rightFt, skipWhy) : whyNext | tid, safeEvent, bReached, recoverWhy, bStraight
' One OVERSHT trial (design sec 4.4, T1-8): arm on the steering source (OVERSHT_DECIM); the SYNC_PRECOND
' check before the drive call (sec 4.3); mark; driveForDistance(left, right, DDU_FT); wait both wheels
' moving, then both STOPPED + OVERSHT_HOLD_MS (<= OVERSHT_WAIT_MS); freeze; BM-STRACE, BM-TS, BM-TRACE-END,
' BM-OVERSHOOT, and BM-TURN when the two distances differ; stopMotors(); a fault recovered through the
' pass-throughs. power prints OVERSHT_POWER, the value segOvershoot() set (sec 12.8).
'
' SRC_REV 54: the segment is a parameter, so part REG's REGRESS runs the same turn trial (PL-151) and its records
' carry seg REGRESS; part B passes SEG_OVERSHT, which is what this routine hard-coded before.
'
' @param seg - SEG_OVERSHT (part B) or SEG_REGRESS (part REG)
' @param sid - the steering start's life
' @param leftFt - the left wheel's commanded distance, feet
' @param rightFt - the right wheel's commanded distance, feet
' @param skipWhy - WHY_NONE to run, else why it is skipped
' @returns whyNext - skip cause for the next trial, WHY_NONE while trials may run
'
' @local tid - trace id
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - the awaited state was reached
' @local recoverWhy - steerRecoverFault()'s result
' @local bStraight - both wheels were given one distance (a turn otherwise)

    tid := nextTraceId()
    cpReset()
    whyNext := skipWhy
    safeEvent := SAFE_NONE
    bReached := FALSE
    ovLeftStop := 0
    ovRightStop := 0
    ovLeftRest := 0
    ovRightRest := 0
    ovRightRestPf := 0
    ovLeftTrk := 0
    ovRightTrk := 0
    ovTStopMs := 0
    ovLeftIg := 0
    ovRightIg := 0
    ovWhy := WHY_NONE
    if (whyNext == WHY_NONE) and (bRunContinue(seg) == FALSE)
        whyNext := WHY_ABORTED
    if whyNext <> WHY_NONE
        cpWhy := whyNext
    elseif bInstArm(INST_SRC_STEER, OVERSHT_DECIM) == FALSE
        cpWhy := WHY_INST_NOACK
    elseif bSteerDrivePrecondition(seg, tid) == FALSE
        cpWhy := WHY_SYNC_PRECOND
    else
        instMark()
        beat(CP_LIB_STEER_DRIVE)
        steering.driveForDistance(leftFt, rightFt, steering.DDU_FT)
        beat(CP_LIB_STEER_DRIVE)
        ' both wheels still read STOPPED at the call's return, so the stop wait follows a moving wait
        safeEvent, bReached := waitWatched(SIDE_BOTH, OVERSHT_MOVE_MS, CP_LOOP_CAPTURE, UNTIL_MOVING)
        if (safeEvent == SAFE_NONE) and bReached
            safeEvent, bReached := waitWatched(SIDE_BOTH, OVERSHT_WAIT_MS, CP_LOOP_CAPTURE, UNTIL_STOPPED)
            if (safeEvent == SAFE_NONE) and bReached
                safeEvent, _ := waitWatched(SIDE_BOTH, OVERSHT_HOLD_MS, CP_LOOP_CAPTURE, UNTIL_TIME)
        if safeEvent <> SAFE_NONE
            cpEnd := safeEnd(safeEvent)
            bCpFaultSeen := (safeEvent == SAFE_FAULT)
        else
            cpEnd := bReached ? TEND_REST : TEND_TIMEOUT
    bCpFrozen := bInstFreeze(0)
    if bSteerUp
        ovLeftTrk, ovRightTrk := steerTrackTicks()
    emitSTrace(tid, seg, CAUSE_DISTANCE, OVERSHT_POWER, OVERSHT_POWER, TRUE, 0, MODE_FLOAT, cpWhy)
    if bCpFrozen and (cpWhy == WHY_NONE)
        bTraceDrain(tid, SLOT_LEFT, SLOT_RIGHT, cpEnd)
        overshootStats()
    else
        if cpWhy == WHY_NONE
            cpWhy := WHY_INST_NOACK
        traceEmptyEnd(tid, TEND_ABORT, cpWhy)
        ovWhy := cpWhy
    bStraight := (leftFt == rightFt)
    emitOvershoot(tid, sid, OVERSHT_POWER, leftFt, bStraight)
    if bStraight == FALSE
        emitTurn(tid, leftFt, rightFt)
    overshootFoldCells(tid, sid, overshootTarget(leftFt), overshootTarget(rightFt), bStraight)
    if bSteerUp
        steerStopMotors()
        recoverWhy := steerRecoverFault(tid)
        if recoverWhy <> WHY_NONE
            whyNext := recoverWhy
        if bCpFrozen
            waitWatched(SIDE_BOTH, STOP_TIMEOUT_MS, CP_LOOP_STOPPED, UNTIL_STOPPED)
    elseif whyNext == WHY_NONE
        whyNext := WHY_NO_COG
    segItems := (segItems + 1) <# LIM_SMALL

PRI overshootStats() | sampleIdx, leftStopJ, rightStopJ
' BM-OVERSHOOT's measurements from the drained steering trace, located by ring index (sec 12.7): each
' wheel's pos delta from the mark to its first DCS_SPIN_DN sample and to the last sample, and the time to
' the left wheel's first SPIN_DN as sample count x period (never a getct() difference across the capture).
'
' @local sampleIdx - logical index
' @local leftStopJ - first left SPIN_DN sample, -1 when none
' @local rightStopJ - first right SPIN_DN sample, -1 when none

    ovWhy := WHY_NOT_REACHED
    ovLeftIg := drIgSum
    ovRightIg := drOIgSum
    leftStopJ := -1
    rightStopJ := -1
    if bDrMarkFound and (drEndJ >= drMarkJ)
        repeat sampleIdx from drMarkJ to drEndJ
            beat(CP_LOOP_DRAIN)
            if (leftStopJ < 0) and (smpState(sampleIdx, SLOT_LEFT) == DCS_SPIN_DN)
                leftStopJ := sampleIdx
            if (rightStopJ < 0) and (smpState(sampleIdx, SLOT_RIGHT) == DCS_SPIN_DN)
                rightStopJ := sampleIdx
            if (leftStopJ >= 0) and (rightStopJ >= 0)
                quit
        if (leftStopJ >= 0) and (rightStopJ >= 0)
            ovLeftStop := smpPos(leftStopJ, SLOT_LEFT) - smpPos(drMarkJ, SLOT_LEFT)
            ovRightStop := smpPos(rightStopJ, SLOT_RIGHT) - smpPos(drMarkJ, SLOT_RIGHT)
            ovLeftRest := smpPos(drEndJ, SLOT_LEFT) - smpPos(drMarkJ, SLOT_LEFT)
            ovRightRest := smpPos(drEndJ, SLOT_RIGHT) - smpPos(drMarkJ, SLOT_RIGHT)
            ovRightRestPf := ovRightRest * STEER_RIGHT_RAW_SIGN
            ovTStopMs := ((leftStopJ - drMarkJ) * INST_PERIOD_US * instDecimate) / US_PER_MS
            ovWhy := WHY_NONE

PRI overshootTarget(distFt) : tgtTicks
' The DERIVED target ticks of one of OVERSHT's two commanded distances.
'
' @param distFt - OVERSHT_FT_SHORT or OVERSHT_FT_LONG
' @returns tgtTicks - OVERSHT_TGT_SHORT or OVERSHT_TGT_LONG

    tgtTicks := (distFt == OVERSHT_FT_LONG) ? OVERSHT_TGT_LONG : OVERSHT_TGT_SHORT

PRI overshootFoldCells(tid, sid, leftTgt, rightTgt, bStraight) | tickMmX100, worstOff
' The OVERSHT cells, from the trial's own measurements.
'
'  STOPLIMIT - on a straight trial, EACH wheel comes to rest AT its own limit. Since task 3570 (finding AB)
'              driveForDistance() stops each wheel at its own distance rather than both at the first
'              wheel's, so both are judged: the old shared stop left the slower wheel short, which this now
'              fails. MEASURED before task 3559: about 77 ticks past, which is the whole deceleration.
'              SRC_REV 59 (DRIVER_REV 38 / 39): the plan it trusts is now the jerk-limited stop's closed form, floored,
'              from the speed AND acceleration in hand, so the 2-ft leg's stop, fired while the platform still
'              accelerates, lands as the 10-ft's does; DRIVER_REV 39's plan (the driver's own) over-states the stop
'              by its age and its take-pass case, so STOP_LIMIT_HI is 3 (STOP_LIMIT_EARLY; the CON derives both
'              sides). A plan that kept the stepped form would rest about v x RAMP_TAU_MS / 2 past (~27 ticks at 218
'              ticks/s), and one that ignored the acceleration in hand the unwind's ~20 ticks past on the 2-ft leg:
'              either FAILS.
'  TURNDIST  - task 3577: the same judgement on a TURN trial, where the two limits differ. The unfixed
'              library stopped both wheels at the shorter distance, so the long wheel rested hundreds of
'              ticks short and this fails.
'  Both judge in the PLATFORM frame. The right wheel's raw rest runs negative for forward travel
'  (STEER_RIGHT_RAW_SIGN, applied once in overshootStats() as ovRightRestPf); task 3570's per-wheel check
'  compared it raw against a positive target, which read a correct stop as 2 x the target off (Visit 5's
'  r_rest -529 against 529).
'  DISTM     - getDistance(DDU_M) agrees with the ticks it is derived from. Task 3502 corrected the metre
'              conversion by a factor of ten and no bench reading has compared the two since; Visit 3 left
'              it unqualified. The comparison uses the library's own travel-per-tick, read from the motor
'              object's geometry, so the harness is not carrying a copy of a number that lives there.
'
' @param tid - trace id of the trial
' @param sid - the steering start's life
' @param leftTgt - the left wheel's DERIVED target ticks
' @param rightTgt - the right wheel's DERIVED target ticks
' @param bStraight - TRUE for a straight trial (STOPLIMIT), FALSE for a turn (TURNDIST)
'
' @local tickMmX100 - wheel travel per hall tick, hundredths of a mm
' @local worstOff - the larger wheel's |rest - its own target|, platform frame

    if ovWhy == WHY_NONE
        worstOff := abs(ovLeftRest - leftTgt) #> abs(ovRightRestPf - rightTgt)
        if bStraight
            sfStopLimMax #>= worstOff
            sfStopLimN := (sfStopLimN + 1) <# LIM_SMALL
        else
            sfTurnMax #>= worstOff
            sfTurnN := (sfTurnN + 1) <# LIM_SMALL
    if bSteerUp
        _, tickMmX100 := wheelL.wheelGeometry()
        ' PL-77: ONE READ, and the record carries the tick count the getter actually saw. This used to
        '  take the ticks from ovLeftTrk/ovRightTrk -- a SNAPSHOT the overshoot trial saved earlier --
        '  and compare them against a LIVE getDistance(), while the emitter's comment claimed both sides
        '  came from the same instant. They did not, so the cell could not tell a conversion fault from
        '  two reads taken moments apart, and it printed the prediction's input rather than the
        '  measurement's. Reading the ticks here, adjacent to the metres, is what makes the comparison
        '  be of the conversion alone (doctrine D2: an instrument that cannot show the difference proves
        '  nothing).
        dmLeftTicks, dmRightTicks := steerTrackTicks()
        dmLeftM, dmRightM := steerDistanceM()
        ' PL-84: read back the STEERING object's OWN travel-per-tick, the one every distance it reports
        '  or accepts is scaled by, beside the MOTOR object's. They are two copies and only the motor's
        '  was ever in the record, so a corrupted steering copy printed a healthy 576 and the cell could
        '  not see it. At Visit 4 the steering copy was about -544_643: getDistance(DDU_M) returned
        '  -14_640 for 2_688 ticks and driveForDistance() refused every trial with ERR_LIMIT_UNRESOLVABLE,
        '  and both are exactly what that value produces. One field tells the two apart.
        dmSteerMmX100 := steerTickInMM()
        dmLeftPredM := ticksToMetres(dmLeftTicks, tickMmX100)
        dmRightPredM := ticksToMetres(dmRightTicks, tickMmX100)
        ' ANDed over every trial that ran (initRunState() starts it TRUE; it is NOMEAS until one does)
        ' PL-84: the two travel-per-tick copies must agree. start() sets the steering object's from
        '  ltWheel.wheelGeometry(), so they are equal by construction and a difference is a corrupted
        '  copy -- the cell now FAILS ON THE THING IT CAN SEE rather than only on the distance the
        '  corruption produced.
        bSfDistMOk := bSfDistMOk and (dmSteerMmX100 == tickMmX100)
        bSfDistMOk := bSfDistMOk and (abs(dmLeftM - dmLeftPredM) <= DISTM_TOL_M) and (abs(dmRightM - dmRightPredM) <= DISTM_TOL_M)
        bSfDistMRan := TRUE
        emitDistM(tid, sid, tickMmX100)

PRI ticksToMetres(nTicks, tickMmX100) : nMetres
' Convert hall ticks to whole metres the way the library does: travel per tick in hundredths of a mm,
' rounded to nearest rather than truncated.
'
' PL-77: THE CONVERSION IS SIGNED, because the library's getter is. This took abs(nTicks), so the
' prediction was always positive while getDistance() returned the sign of travel -- and every trial that
' ran in reverse disagreed with its own prediction by construction, whatever the conversion did. The
' rounding term carries the sign with the value so a negative distance rounds away from zero, matching
' the positive case rather than biasing it by one metre.
'
' @param nTicks - tracked hall ticks, signed
' @param tickMmX100 - wheel travel per hall tick, hundredths of a mm
' @returns nMetres - the distance in whole metres, signed

    if nTicks < 0
        nMetres := 0 - (((0 - nTicks) * tickMmX100 + (MM_PER_M_X100 / 2)) / MM_PER_M_X100)
    else
        nMetres := (nTicks * tickMmX100 + (MM_PER_M_X100 / 2)) / MM_PER_M_X100

#endif

#ifdef DBG_TICKMM
PRI steerTickInMM() : nMmX100
' The STEERING object's own travel-per-tick, through its TEST-USE pass-through (PL-84).
'
' @returns nMmX100 - the steering object's tickInMM_x100, hundredths of a mm per hall tick

    beat(CP_LIB_STEER_QUERY)
    nMmX100 := steering.testGetTickInMM()
    beat(CP_LIB_STEER_QUERY)
#endif

#ifdef DBG_OVERSHT
PRI steerDistanceM() : leftM, rightM
' Both wheels' travelled distance in metres, through the public getter.
'
' @returns leftM - the left wheel's distance, metres
' @returns rightM - the right wheel's distance, metres

    beat(CP_LIB_STEER_QUERY)
    leftM, rightM := steering.getDistance(steering.DDU_M)
    beat(CP_LIB_STEER_QUERY)

#endif

#ifdef DBP_B
PRI faultApiTrial(sid, skipWhy) | tid, whyCode, markMs, rowIdx, recoverWhy, safeEvent, bReached
' The OVERSHT fault-API trial (task 3552, extended by task 3560): certify that a user of the STEERING
' object sees a fault through its public API, that the latch task 3547 stopped auto-clearing is still set
' more than FLTAPI_LATCH_MS later, and that the SAME POWER commanded afterwards runs the motor again
' (PL-66).
'
' THE PROVOCATION IS COMPUTED, NOT CHOSEN (task 3572, PL-86). The ramp that faulted 3 of 3 at Visit 2 now
' droops instead (the lag limiter; RMPDROOP says so). A 180-degree offset written AT REST then replaced it,
' and at Visits 4 and 5 it never faulted: the start re-seeds the field from the halls plus the new offset,
' the limiter holds the field, and the wheel drew ~16 A until this harness's own 10 A abort ended it. The
' construction now: drive to speed, read each wheel's own position error, and shift that wheel's offsets by
' exactly what moves its error to +-128 (faultShiftDeg()). The fault test is |err| >= 125, so the error lands
' with 3 units of margin on either side, in the very next control frame -- before the current can build.
' DERIVED, not measured: if it does not fault, the trial prints NO_FAULT and every cell below it is NOMEAS
' rather than passing by silence.
'
' LAGBOUND IS EXEMPT for the provocation window: this step drives the lag to the limit on purpose, and
' folding it into the run's maximum would make the lag limiter look broken in the one part that breaks it
' deliberately.
'
' The offsets are restored and read back BEFORE the retry (I11) -- a retry under a 180-degree offset would
' fault again and measure nothing.
'
' NO CAPTURE IS DRAINED. The rows already show the post-fault coast at API resolution; the coast at
' instrument resolution is S-9a, motor characterisation, which this trial does not measure.
'
' @param sid - the steering start's life, 0 when it did not start
' @param skipWhy - WHY_NONE to run, else why the segment's trials are being skipped
'
' @local tid - trace id
' @local whyCode - why the verdict was not reached, WHY_NONE when it was
' @local markMs - getms() at the command: the t_ms origin of every row
' @local rowIdx - 0-based poll row
' @local recoverWhy - steerRecoverFault()'s result
' @local safeEvent - SAFE_* from the wait for speed
' @local bReached - both wheels reached AT_SPEED before the provocation

    tid := nextTraceId()
    cpReset()
    outCount := 0
    fltLeftShift := 0
    fltRightShift := 0
    fltLeftCause := wheelL.FC_NONE
    fltRightCause := wheelL.FC_NONE
    whyCode := skipWhy
    if (whyCode == WHY_NONE) and (bRunContinue(SEG_OVERSHT) == FALSE)
        whyCode := WHY_ABORTED
    ' one guard around the whole body: a skipped trial commands nothing, so it has no offset to restore
    '  and no fault to recover, and it still prints its record below
    if whyCode == WHY_NONE
        if bSteerUp == FALSE
            whyCode := WHY_NO_COG
        elseif bInstArm(INST_SRC_STEER, OVERSHT_DECIM) == FALSE
            whyCode := WHY_INST_NOACK
        else
            bInstLagExempt := TRUE                          ' the lag below is provoked on purpose
            ' PL-86: drive FIRST and provoke at speed. An offset written at rest is absorbed: the start re-seeds
            '  the field from the halls PLUS the new offset, the lag limiter then holds the field, and the wheel
            '  draws ~16 A without ever faulting (Visits 4 and 5)
            if bSteerDriveBoth(SEG_OVERSHT, tid, FLTAPI_POWER) == FALSE
                whyCode := WHY_SYNC_PRECOND
            else
                safeEvent, bReached := waitWatched(SIDE_BOTH, D_AT_SPEED_MS, CP_LOOP_ATSPEED, UNTIL_AT_SPEED)
                if safeEvent <> SAFE_NONE
                    whyCode := safeWhy(safeEvent)
                elseif bReached == FALSE
                    whyCode := WHY_STEADY_TIMEOUT
            if whyCode == WHY_NONE
                fltLeftShift := faultShiftDeg(SIDE_LEFT, TRUE)
                fltRightShift := faultShiftDeg(SIDE_RIGHT, TRUE)
                fltLeftInc, fltRightInc := steerOffsetProvoke(fltLeftShift, fltRightShift)
                markMs := getms()
                whyCode := safeWhy(steerPollPhase(markMs, markMs, FLTAPI_POLL_MS, FALSE, TRUE))
            bCpFrozen := bInstFreeze(0)
            steerStopMotors()
            steerOffsetRestore()                            ' I11: before any check, on every path that wrote them
            bInstLagExempt := FALSE
            if (bCpFrozen == FALSE) and (whyCode == WHY_NONE)
                whyCode := WHY_INST_NOACK
            if whyCode == WHY_NONE
                whyCode := fltApiVerdict()
            ' S-7: the cause each wheel latched -- read before the retry, which could fault again and replace it
            beat(CP_LIB_STEER_QUERY)
            fltLeftCause, fltRightCause := steering.getFaultCause()
            beat(CP_LIB_STEER_QUERY)
            fltApiRetry()                                   ' PL-66, on the restored offsets
            recoverWhy := steerRecoverFault(tid)
            if (recoverWhy <> WHY_NONE) and (whyCode == WHY_NONE)
                whyCode := recoverWhy
    emitFltApi(tid, sid, whyCode)
    if outCount > 0
        repeat rowIdx from 0 to outCount - 1
            beat(CP_LOOP_DRAIN)
            emitOut(tid, sid, rowIdx)
    segItems := (segItems + 1) <# LIM_SMALL

#endif

#ifdef DBG_FSHIFT
PRI faultShiftDeg(side, bSteerForm) : shiftDeg | sampleIdx, errSum, errMean, shiftUnits
' The commutation-offset shift that puts this wheel's position error on the driver's fault test (PL-86, PL-59).
'
' The driver's err is one electrical cycle in ERR_UNITS_PER_TURN signed units, so it wraps at +-128, and it
' faults at |err| >= 125. The driver computes err = field angle - (hall angle + offset), and init() maps
' offset degrees positively (degrees frac 360), so raising the offset by D units LOWERS err by D in the next
' control frame, the field angle itself not moving. So D = err + ERR_FAULT_TARGET lands the error on -128, the
' wrap: any landing from 125 to 131 away faults, which is +-3 units (+-4 degrees) of margin against the
' 1-degree offset resolution. The hall angle steps once per hall code, so err sweeps across each step and
' passes the landing point within one hall step. The error is averaged over FAULT_ERR_SAMPLES reads at speed.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param bSteerForm - TRUE to read the wheel through the steering object, FALSE through the wheel object
' @returns shiftDeg - the shift to add to both of the wheel's offsets, degrees [0..359]
'
' @local sampleIdx - read counter
' @local errSum - sum of the reads
' @local errMean - the wheel's mean position error at speed, err units
' @local shiftUnits - the shift, err units [0..255]

    errSum := 0
    repeat sampleIdx from 1 to FAULT_ERR_SAMPLES
        beat(CP_LOOP_POLL)
        errSum += wheelErr(side, bSteerForm)
        waitms(SAMPLE_MS)
    errMean := errSum / FAULT_ERR_SAMPLES
    shiftUnits := (errMean + ERR_FAULT_TARGET) & ERR_UNITS_MASK
    shiftDeg := ((shiftUnits * DEG_PER_TURN) + (ERR_UNITS_PER_TURN / 2)) / ERR_UNITS_PER_TURN

PRI wheelErr(side, bSteerForm) : nErr
' One wheel's latest position error from the driver's status block.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param bSteerForm - TRUE to read it through the steering object's pass-through, FALSE through the wheel object
' @returns nErr - the error, signed err units (ERR_UNITS_PER_TURN per electrical cycle)

    beat(CP_LIB_QUERY)
    if bSteerForm                                           ' if/else, never `? :` -- PL-29, PL-76
        if side == SIDE_RIGHT
            _, nErr, _, _, _, _, _, _ := steering.testRightGetTelemetry()
        else
            _, nErr, _, _, _, _, _, _ := steering.testLeftGetTelemetry()
    elseif side == SIDE_RIGHT
        _, nErr, _, _, _, _, _, _ := wheelR.testGetTelemetry()
    else
        _, nErr, _, _, _, _, _, _ := wheelL.testGetTelemetry()
    beat(CP_LIB_QUERY)

#endif

#ifdef DBP_B
PRI steerOffsetProvoke(leftShiftDeg, rightShiftDeg) : leftNeg, rightNeg | leftPos, rightPos
' Shift each wheel's commutation offsets by its own computed amount (faultShiftDeg()) from the pair it is
' running, and return the negative-increment offset each wheel read back. The pair in force is read first and
' kept in the flt* staging, so the restore puts back what was actually there rather than what this file
' believes is there.
'
' @param leftShiftDeg - the left wheel's shift, degrees
' @param rightShiftDeg - the right wheel's shift, degrees
' @returns leftNeg - the left wheel's offset_fwd after the write, degrees
' @returns rightNeg - the right wheel's offset_fwd after the write, degrees
'
' @local leftPos - the left wheel's offset_rev after the write
' @local rightPos - the right wheel's offset_rev after the write

    beat(CP_LIB_OFFSETS)
    fltOffNeg[SLOT_LEFT], fltOffPos[SLOT_LEFT] := steering.testLeftGetFwdRevIndep()
    fltOffNeg[SLOT_RIGHT], fltOffPos[SLOT_RIGHT] := steering.testRightGetFwdRevIndep()
    steering.testLeftSetFwdRevIndep(fltOffNeg[SLOT_LEFT] + leftShiftDeg, fltOffPos[SLOT_LEFT] + leftShiftDeg)
    steering.testRightSetFwdRevIndep(fltOffNeg[SLOT_RIGHT] + rightShiftDeg, fltOffPos[SLOT_RIGHT] + rightShiftDeg)
    leftNeg, leftPos := steering.testLeftGetFwdRevIndep()
    rightNeg, rightPos := steering.testRightGetFwdRevIndep()
    beat(CP_LIB_OFFSETS)
    bCpOffWritten := TRUE

PRI steerOffsetRestore() | leftNeg, leftPos, rightNeg, rightPos
' I11: put both wheels' commutation offsets back and read them back, folding the result into
' R14-DUAL-OFFREST-C's accumulators so a restore that did not take is visible rather than assumed.
'
' @local leftNeg - the left wheel's offset_fwd read back
' @local leftPos - the left wheel's offset_rev read back
' @local rightNeg - the right wheel's offset_fwd read back
' @local rightPos - the right wheel's offset_rev read back

    if bCpOffWritten
        beat(CP_LIB_OFFSETS)
        steering.testLeftSetFwdRevIndep(fltOffNeg[SLOT_LEFT], fltOffPos[SLOT_LEFT])
        steering.testRightSetFwdRevIndep(fltOffNeg[SLOT_RIGHT], fltOffPos[SLOT_RIGHT])
        leftNeg, leftPos := steering.testLeftGetFwdRevIndep()
        rightNeg, rightPos := steering.testRightGetFwdRevIndep()
        beat(CP_LIB_OFFSETS)
        bCpOffRestored := TRUE
        bSfOffRan[SLOT_LEFT] := TRUE
        bSfOffRan[SLOT_RIGHT] := TRUE
        bSfOffOk[SLOT_LEFT] := bSfOffOk[SLOT_LEFT] and (leftNeg == fltOffNeg[SLOT_LEFT]) and (leftPos == fltOffPos[SLOT_LEFT])
        bSfOffOk[SLOT_RIGHT] := bSfOffOk[SLOT_RIGHT] and (rightNeg == fltOffNeg[SLOT_RIGHT]) and (rightPos == fltOffPos[SLOT_RIGHT])
        emitOffRest(SIDE_LEFT, fltOffNeg[SLOT_LEFT], fltOffPos[SLOT_LEFT], leftNeg, leftPos, (leftNeg == fltOffNeg[SLOT_LEFT]) and (leftPos == fltOffPos[SLOT_LEFT]))
        emitOffRest(SIDE_RIGHT, fltOffNeg[SLOT_RIGHT], fltOffPos[SLOT_RIGHT], rightNeg, rightPos, (rightNeg == fltOffNeg[SLOT_RIGHT]) and (rightPos == fltOffPos[SLOT_RIGHT]))

PRI fltApiRetry() | startMs, safeEvent, bReached
' PL-66: THE SAME POWER, COMMANDED AGAIN after the fault, runs the motor again.
'
' The unfixed library left a faulted driver faulted unless the new command DIFFERED from the standing one,
' because the driver's own compare tests "still standing", not "just arrived" -- so a user who retried at
' the power they were already using stayed stopped with no way to tell why. The front cog now makes that
' edge itself (frontClearFault()), so this retry is the certification: same power, same call, and the
' platform reaches speed.
'
' Runs only when the provocation actually faulted; otherwise there is nothing to retry from and the cell
' stays NOMEAS.
'
' @local startMs - getms() at the retry command
' @local safeEvent - SAFE_* from the watched wait
' @local bReached - both wheels reached AT_SPEED

    fltRetryErr := NO_ERROR
    fltRetryMs := 0
    bFltRetryOk := FALSE
    if bSfFltApiRan and bSteerUp
        bSfRetryRan := TRUE
        startMs := getms()
        fltRetryErr := dDrive(SIDE_BOTH, FLTAPI_POWER)      ' the same power the provocation was driven at
        if fltRetryErr == NO_ERROR
            safeEvent, bReached := waitWatched(SIDE_BOTH, D_AT_SPEED_MS, CP_LOOP_ATSPEED, UNTIL_AT_SPEED)
            if (safeEvent == SAFE_NONE) and bReached
                fltRetryMs := getms() - startMs
                bFltRetryOk := TRUE
        bSfRetryOk := bFltRetryOk
        steerStopMotors()
        waitWatched(SIDE_BOTH, STOP_TIMEOUT_MS, CP_LOOP_STOPPED, UNTIL_STOPPED)

PRI fltApiVerdict() : whyCode | rowIdx, faultIdx, lastIdx, bStatFaulted, bSigHeld
' Read the trial's verdict out of the rows the poll already stored, so BM-FLTAPI, the BM-OUT rows and
' the sign-off cell all have ONE source. The cell is MEASURED once the provocation faulted; it is TRUE
' when the rows carry all three of task 3547's claims: steering.isFaulted() read TRUE, getStatus()
' reported DS_FAULTED, and the last row -- at least FLTAPI_LATCH_MS after the first faulted row -- still
' carried the sticky fault signal. A trial that never faulted is WHY_NO_FAULT and the cell stays NOT
' MEASURED, which prints NOMEAS: the visibility that caught Visit 2's missing cells.
'
' GETSTATUS IS LOOKED FOR FROM THE FAULTED ROW ONWARD, NOT ON THAT ROW ALONE. outPoll() reads
' getStatus() at the top of its bracket and isFaulted() at the bottom, so the status can legitimately
' be one row behind the flag; judging the one row would fail a driver that is behaving.
'
' @returns whyCode - WHY_NONE when a fault was seen in the rows, else WHY_NO_FAULT
'
' @local rowIdx - 0-based poll row
' @local faultIdx - first row reading faulted, -1 when none
' @local lastIdx - last row stored
' @local bStatFaulted - getStatus() read DS_FAULTED on that row or a later one
' @local bSigHeld - the sticky fault signal was still set on the last row

    whyCode := WHY_NO_FAULT
    faultIdx := -1
    bStatFaulted := FALSE
    if outCount > 0
        repeat rowIdx from 0 to outCount - 1
            beat(CP_LOOP_DRAIN)
            if outBuf[(rowIdx * OUT_LONGS) + OUT_FAULTED] <> FALSE
                faultIdx := rowIdx
                quit
    if faultIdx >= 0
        lastIdx := outCount - 1
        repeat rowIdx from faultIdx to lastIdx
            beat(CP_LOOP_DRAIN)
            if (outBuf[(rowIdx * OUT_LONGS) + OUT_L_STAT] == wheelL.DS_FAULTED) or (outBuf[(rowIdx * OUT_LONGS) + OUT_R_STAT] == wheelL.DS_FAULTED)
                bStatFaulted := TRUE
                quit
        fltFaultMs := outBuf[(faultIdx * OUT_LONGS) + OUT_T_MS]
        fltLatchMs := outBuf[(lastIdx * OUT_LONGS) + OUT_T_MS] - fltFaultMs
        bSigHeld := (outBuf[(lastIdx * OUT_LONGS) + OUT_L_SIG] <> FALSE) or (outBuf[(lastIdx * OUT_LONGS) + OUT_R_SIG] <> FALSE)
        bSfFltApiRan := TRUE
        bSfFltApiOk := bStatFaulted and bSigHeld and (fltLatchMs >= FLTAPI_LATCH_MS)
        whyCode := WHY_NONE
#endif

CON { --- part D steps: one claim each, measured once, printed as BM-DSTEP (task 3560) --- }

' EVERY STEP HAS THE SAME SHAPE. It provokes the condition, reads one number, judges it against a stated
' bound, and hands dStepDone() a measured/criterion pair. A condition this rig cannot provoke is NOMEAS
' with a why, never a pass by silence (doctrine overlay P1).
'
' SIDE selects the form under test and nothing else: SIDE_BOTH is the steering object (one front cog,
' two drivers) and SIDE_LEFT is one wheel (its own front cog). The dispatch helpers below are the only
' place the two differ, so each step is written once.
'
' NO DISPATCH HELPER MAY SELECT BETWEEN TWO METHOD CALLS WITH `? :` (PL-29, PL-76). PL-29 MEASURED a
' `? :` whose two branches each call a method running BOTH calls for one evaluation, and Visit 4 measured
' it again here: with side SIDE_LEFT, `(side == SIDE_RIGHT) ? wheelR.driveAtPower(p) : wheelL.driveAtPower(p)`
' also commanded the never-started wheelR, which printed "driveAtPowerEx() motor not started" while the
' expression returned wheelL's NO_ERROR. Five such lines in debug_260917-125859.log (L87, L88, L91, L93,
' L94) match, one for one, the five commanding ternaries the single-wheel half reached -- and the
' steering half, which takes the `if` limb and evaluates no ternary, printed none.
' The construction that makes it impossible is if/else, so every helper below uses if/else for a call
' and keeps `? :` for selecting a VALUE. A getter behaves the same way; it merely says nothing about it.

#ifdef DBP_D
PRI dStepDone(stepCode, side, bMeasured, bCriterionMet, measuredVal, loLimit, hiLimit, whyCode)
' Record one part-D step: fill the BM-DSTEP staging, fold the cell, emit.
'
' @param stepCode - DST_* value
' @param side - SIDE_BOTH (the steering object) or SIDE_LEFT (the single wheel)
' @param bMeasured - TRUE when the step's condition arose and its number is a measurement
' @param bCriterionMet - TRUE when the step's own criterion held
' @param measuredVal - the step's number, meaning per step
' @param loLimit - lowest passing value
' @param hiLimit - highest passing value
' @param whyCode - WHY_* naming what was missing, WHY_NONE when nothing was

    dsStep := stepCode
    dsMeasured := measuredVal
    dsLo := loLimit
    dsHi := hiLimit
    dsWhy := whyCode
    if bMeasured == FALSE
        dsResult := DRES_NOMEAS
    elseif bCriterionMet <> FALSE
        dsResult := DRES_PASS
    else
        dsResult := DRES_FAIL
    if side == SIDE_LEFT
        bSfWDStepRan[stepCode] := (bMeasured <> FALSE)
        bSfWDStepOk[stepCode] := (bMeasured <> FALSE) and (bCriterionMet <> FALSE)
    else
        bSfDStepRan[stepCode] := (bMeasured <> FALSE)
        bSfDStepOk[stepCode] := (bMeasured <> FALSE) and (bCriterionMet <> FALSE)
    emitDStep(side)
    segItems := (segItems + 1) <# LIM_SMALL

PRI dStepSkip(stepCode, side, whyCode)
' Record a part-D step that could not run at all, so every declared cell still prints a row.
'
' @param stepCode - DST_* value
' @param side - SIDE_BOTH or SIDE_LEFT
' @param whyCode - WHY_* naming why nothing ran

    dStepDone(stepCode, side, FALSE, FALSE, 0, 0, 0, whyCode)

PRI bDArm(side) : bArmed
' Arm the instrument on the source this form reads, at the operator-segment decimation.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns bArmed - TRUE when the instrument acknowledged

    bArmed := bInstArm((side == SIDE_BOTH) ? INST_SRC_STEER : INST_SRC_WHEELS, FLOOR_DECIM)

#endif

#ifdef DBG_DDRIVE
PRI dDrive(side, powerValue) : eError
' Drive this form at a power through the PUBLIC method a user would call, and return what it returned.
'
' THE SYNC_PRECOND GUARD IS DELIBERATELY NOT USED HERE. That guard (design sec 4.3) exists because the
' pre-6.0.0 steering driveAtPower() ended in an unbounded SyncStatus() wait that never returned while a
' driver sat in DCS_ESTOP. Task 3513 moved the ATN and the wait into the front cog, and a caller now waits
' only the bounded request round trip (REQ_ACK_TIMEOUT_MS), so the call returns a refusal instead of
' hanging -- and THAT REFUSAL IS WHAT DST_ESTOP_REFUSE MEASURES. Calling through the guard would refuse
' on this cog and measure the harness instead of the driver.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @param powerValue - power [-100..100] for every wheel of this form
' @returns eError - NO_ERROR or the ERR_* code the library returned

    curIncre := 0
    if side == SIDE_BOTH
        beat(CP_LIB_STEER_DRIVE)
        eError := steering.driveAtPower(powerValue, powerValue)
        beat(CP_LIB_STEER_DRIVE)
    elseif side == SIDE_RIGHT
        beat(CP_LIB_COMMAND)
        eError := wheelR.driveAtPower(powerValue)
        beat(CP_LIB_COMMAND)
    else
        beat(CP_LIB_COMMAND)
        eError := wheelL.driveAtPower(powerValue)
        beat(CP_LIB_COMMAND)

#endif

#ifdef DBP_D
PRI dDriveDistance(side, distanceM) : eError
' Drive this form a distance through the PUBLIC driveForDistance() a user would call, and return what it returned.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @param distanceM - the distance for every wheel of this form, metres
' @returns eError - NO_ERROR or the ERR_* code the library returned

    curIncre := 0
    if side == SIDE_BOTH
        beat(CP_LIB_STEER_DRIVE)
        eError := steering.driveForDistance(distanceM, distanceM, steering.DDU_M)
        beat(CP_LIB_STEER_DRIVE)
    elseif side == SIDE_RIGHT
        beat(CP_LIB_COMMAND)
        eError := wheelR.driveForDistance(distanceM, wheelR.DDU_M)
        beat(CP_LIB_COMMAND)
    else
        beat(CP_LIB_COMMAND)
        eError := wheelL.driveForDistance(distanceM, wheelL.DDU_M)
        beat(CP_LIB_COMMAND)

PRI dEstop(side)
' Emergency-stop this form.
'
' @param side - SIDE_BOTH or SIDE_LEFT

    curIncre := 0
    if side == SIDE_BOTH
        beat(CP_LIB_ESTOP)
        steering.emergencyCutoff()
        beat(CP_LIB_ESTOP)
    else
        wheelEstop(side)

PRI dClearEstop(side) : eError
' Release this form's emergency stop.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns eError - NO_ERROR, or the code the library returned

    beat(CP_LIB_ESTOP)
    if side == SIDE_BOTH
        eError := steering.clearEmergency()
    elseif side == SIDE_RIGHT
        eError := wheelR.clearEmergency()
    else
        eError := wheelL.clearEmergency()
    beat(CP_LIB_ESTOP)

PRI dStopMotion(side)
' Stop this form's motion without stopping any cog.
'
' @param side - SIDE_BOTH or SIDE_LEFT

    if side == SIDE_BOTH
        steerStopMotors()
    else
        wheelStopMotor(side)

PRI dStopAfterTime(side, timeMs) : eError
' Arm this form's time stop in milliseconds.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @param timeMs - the limit, in ms
' @returns eError - NO_ERROR, or the code the library returned

    beat(CP_LIB_COMMAND)
    if side == SIDE_BOTH
        eError := steering.stopAfterTime(timeMs, steering.DTU_MILLISEC)
    elseif side == SIDE_RIGHT
        eError := wheelR.stopAfterTime(timeMs, wheelL.DTU_MILLISEC)
    else
        eError := wheelL.stopAfterTime(timeMs, wheelL.DTU_MILLISEC)
    beat(CP_LIB_COMMAND)

PRI isDEstopped(side) : bEstopped | eLeftStatus, eRightStatus
' Report whether every wheel of this form reads emergency-stopped through the PUBLIC status API.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns bEstopped - TRUE when getStatus() reads DS_ESTOP for every wheel and isEmergency() is TRUE
'
' @local eLeftStatus - left getStatus()
' @local eRightStatus - right getStatus()

    beat(CP_LIB_STEER_QUERY)
    if side == SIDE_BOTH
        eLeftStatus, eRightStatus := steering.getStatus()
        bEstopped := (eLeftStatus == wheelL.DS_ESTOP) and (eRightStatus == wheelL.DS_ESTOP) and (steering.isEmergency() <> FALSE)
    elseif side == SIDE_RIGHT
        eLeftStatus := wheelR.getStatus()
        bEstopped := (eLeftStatus == wheelL.DS_ESTOP) and (wheelR.isEmergency() <> FALSE)
    else
        eLeftStatus := wheelL.getStatus()
        bEstopped := (eLeftStatus == wheelL.DS_ESTOP) and (wheelL.isEmergency() <> FALSE)
    beat(CP_LIB_STEER_QUERY)

PRI dPowerSum(side) : nSum | leftPower, rightPower
' Sum of |power| this form reports through getPower(); 0 means every wheel reads stopped (PL-52).
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns nSum - |left power| + |right power|, or |power| for one wheel
'
' @local leftPower - left getPower()
' @local rightPower - right getPower()

    beat(CP_LIB_STEER_QUERY)
    if side == SIDE_BOTH
        leftPower, rightPower := steering.getPower()
        nSum := abs(leftPower) + abs(rightPower)
    elseif side == SIDE_RIGHT
        nSum := abs(wheelR.getPower())
    else
        nSum := abs(wheelL.getPower())
    beat(CP_LIB_STEER_QUERY)

PRI dRawTicks(side) : leftTicks, rightTicks
' Raw driver-maintained tick counts of this form (the reading no tracking reset moves).
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns leftTicks - the left wheel's raw ticks, or this wheel's
' @returns rightTicks - the right wheel's raw ticks, or the same value again for one wheel

    beat(CP_LIB_STEER_QUERY)
    if side == SIDE_BOTH
        leftTicks, rightTicks := steering.testGetRawHallTicks()
    else
        if side == SIDE_RIGHT
            leftTicks := wheelR.getRawHallTicks()
        else
            leftTicks := wheelL.getRawHallTicks()
        rightTicks := leftTicks
    beat(CP_LIB_STEER_QUERY)

PRI dTrackTicks(side) : leftTicks, rightTicks
' Tracked (resettable) tick counts of this form.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns leftTicks - the left wheel's tracked ticks, or this wheel's
' @returns rightTicks - the right wheel's tracked ticks, or the same value again for one wheel

    beat(CP_LIB_STEER_QUERY)
    if side == SIDE_BOTH
        leftTicks, rightTicks := steering.getRotationCount(steering.DRU_HALL_TICKS)
    else
        if side == SIDE_RIGHT
            leftTicks := wheelR.getRotationCount(wheelL.DRU_HALL_TICKS)
        else
            leftTicks := wheelL.getRotationCount(wheelL.DRU_HALL_TICKS)
        rightTicks := leftTicks
    beat(CP_LIB_STEER_QUERY)

PRI dResetTracking(side) : eError
' Reset this form's position tracking.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns eError - NO_ERROR, or the code the library returned

    beat(CP_LIB_COMMAND)
    if side == SIDE_BOTH
        eError := steering.resetTracking()
    elseif side == SIDE_RIGHT
        eError := wheelR.resetTracking()
    else
        eError := wheelL.resetTracking()
    beat(CP_LIB_COMMAND)

#endif

#ifdef DBG_FRONTST
PRI dFrontStats(side) : nPasses, nLate, nMaxTicks, nStackHi, nStackOf
' This form's front-cog loop health, and the stack allocation its high-water mark is measured against.
'
' PL-75: THE SIZE COMES FROM THE OBJECT THAT OWNS THE STACK, never from a constant kept here. The
' steering front cog services two wheels and is sized separately from a wheel's own front cog, so
' one number cannot describe both -- and a record that pairs a mark with the wrong size can report a
' saturated stack as a healthy one.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns nPasses - passes since the cog was launched
' @returns nLate - passes that overran their slot
' @returns nMaxTicks - longest pass body, in system ticks
' @returns nStackHi - stack longs ever used
' @returns nStackOf - the allocation that mark is against, from the same object

    beat(CP_LIB_STEER_QUERY)
    if side == SIDE_BOTH
        nPasses, nLate, nMaxTicks, nStackHi := steering.testGetFrontStats()
        nStackOf := steering.STEER_STACK_LONGS
    elseif side == SIDE_RIGHT
        nPasses, nLate, nMaxTicks, nStackHi := wheelR.testGetFrontStats()
        nStackOf := wheelR.STACK_SIZE_LONGS
    else
        nPasses, nLate, nMaxTicks, nStackHi := wheelL.testGetFrontStats()
        nStackOf := wheelL.STACK_SIZE_LONGS
    beat(CP_LIB_STEER_QUERY)

#endif

#ifdef DBP_D
PRI dShutdown(side)
' Stop this form's cogs through the PUBLIC stop(), with the instrument returned to IDLE first (I10).
'
' @param side - SIDE_BOTH or SIDE_LEFT

    bInstIdle()
    if side == SIDE_BOTH
        beat(CP_LIB_STEER_STOP)
        benchLog.cogEventBegin()
        steering.stop()
        beat(CP_LIB_STEER_STOP)
        bSteerUp := FALSE
    else
        wheelStopRaw(side)

PRI bDToSpeed(side) : bAtSpeed
' Bring this form to D_POWER and hold it at speed, so a step acts on a moving platform.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns bAtSpeed - TRUE when every wheel reached DCS_AT_SPEED and the settle passed cleanly

    bAtSpeed := FALSE
    if dDrive(side, D_POWER) == NO_ERROR
        bAtSpeed := bDHoldSpeed(side)

PRI bDHoldSpeed(side) : bAtSpeed | safeEvent
' After a drive command, wait for every wheel of this form to reach DCS_AT_SPEED, then the D_SETTLE_MS settle.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns bAtSpeed - TRUE when every wheel reached DCS_AT_SPEED and the settle passed cleanly
'
' @local safeEvent - SAFE_* from the watched waits

    safeEvent, bAtSpeed := waitWatched(side, D_AT_SPEED_MS, CP_LOOP_ATSPEED, UNTIL_AT_SPEED)
    if (safeEvent == SAFE_NONE) and bAtSpeed
        safeEvent, _ := waitWatched(side, D_SETTLE_MS, CP_LOOP_SETTLE, UNTIL_TIME)
    if safeEvent <> SAFE_NONE
        bAtSpeed := FALSE

PRI bDRest(side) : bRest
' Wait, bounded by D_REST_MS, for this form to be at rest (pos and hwPos still, per waitRest()).
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns bRest - TRUE when rest was confirmed inside D_REST_MS

    bRest := bDRestWithin(side, D_REST_MS)

PRI bDRestWithin(side, boundMs) : bRest | safeEvent
' Wait, bounded by the caller's own number, for this form to be at rest.
'
' A STEP THAT HAS ARMED A DELAYED STOP MUST PASS ITS OWN BOUND. D_REST_MS bounds the time from a stop
' COMMAND to rest; a step that arms stopAfterTime() is waiting for the limit to arrive first, and giving
' it D_REST_MS means the wait expires at the moment the stop begins (PL-83).
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @param boundMs - the caller's bound, in ms
' @returns bRest - TRUE when rest was confirmed inside boundMs
'
' @local safeEvent - SAFE_* from the wait

    safeEvent, bRest := waitRest(side, boundMs, FALSE)

PRI dStepLockstep() | bArmed, safeEvent, bMoving, leftJ, rightJ, sampleIdx, gapSamples
' LOCKSTEP: both drivers leave DCS_STOPPED in the same instrument sample.
'
' A REGRESSION GUARD, AND IT IS STATED AS ONE: the steering object has always released its two parked
' drivers with one COGATN, and Visit 2 and Visit 3 showed no drift. What changed underneath is WHO
' writes the commands -- one front cog now writes both and sends the ATN (task 3513) -- so the guard is
' here to show that the new writer did not cost the lockstep, not because a defect is suspected.
'
' Measured at decimation 1 (2 ms per sample), the finest the instrument offers.
'
' @local bArmed - the instrument acknowledged the ARM
' @local safeEvent - SAFE_* from the watched waits
' @local bMoving - both wheels left rest inside the bound
' @local leftJ - logical index of the left wheel's first sample not DCS_STOPPED, -1 when none
' @local rightJ - the same for the right wheel
' @local sampleIdx - logical index
' @local gapSamples - |leftJ - rightJ|

    leftJ := -1
    rightJ := -1
    gapSamples := 0
    bMoving := FALSE
    bArmed := bInstArm(INST_SRC_STEER, 1)
    if bArmed
        instMark()
        if dDrive(SIDE_BOTH, D_POWER) == NO_ERROR
            safeEvent, bMoving := waitWatched(SIDE_BOTH, OVERSHT_MOVE_MS, CP_LOOP_CAPTURE, UNTIL_MOVING)
            if safeEvent <> SAFE_NONE
                bMoving := FALSE
        bInstFreeze(0)
        drainBegin()
        drainFindMark()
        if bMoving and bDrMarkFound and (drStored > 0)
            repeat sampleIdx from drMarkJ to drStored - 1
                beat(CP_LOOP_DRAIN)
                if (leftJ < 0) and bSmpUp(sampleIdx, SLOT_LEFT) and (smpState(sampleIdx, SLOT_LEFT) <> DCS_STOPPED)
                    leftJ := sampleIdx
                if (rightJ < 0) and bSmpUp(sampleIdx, SLOT_RIGHT) and (smpState(sampleIdx, SLOT_RIGHT) <> DCS_STOPPED)
                    rightJ := sampleIdx
                if (leftJ >= 0) and (rightJ >= 0)
                    quit
    if (leftJ >= 0) and (rightJ >= 0)
        gapSamples := abs(leftJ - rightJ)
        dStepDone(DST_LOCKSTEP, SIDE_BOTH, TRUE, gapSamples <= D_LOCKSTEP_SAMPLES, gapSamples, 0, D_LOCKSTEP_SAMPLES, WHY_NONE)
    else
        dStepDone(DST_LOCKSTEP, SIDE_BOTH, FALSE, FALSE, 0, 0, D_LOCKSTEP_SAMPLES, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
    dStopMotion(SIDE_BOTH)
    bDRest(SIDE_BOTH)
    bInstIdle()

PRI dStepTrackReset(side) | bArmed, bAtSpeed, startMs, elapsedMs, rawLeft1, rawRight1, trkLeft1, trkRight1, rawLeft2, rawRight2, trkLeft2, trkRight2, bAgrees, eError
' TRACKRESET: resetTracking() at speed returns inside D_TRACKRESET_MS, and the tracking it restarts
' agrees with the driver's own raw ticks from that moment on.
'
' THE UNFIXED VALUE: before task 3513 this call waited on the sense task and took 400 ms or more, during
' which the platform kept moving and the caller could not know from where the new count ran. The bound
' below is the front cog's own request round trip.
'
' @param side - SIDE_BOTH or SIDE_LEFT
'
' @local bArmed - the instrument acknowledged the ARM
' @local bAtSpeed - the platform reached speed
' @local startMs - getms() before the reset call
' @local elapsedMs - how long the reset call took
' @local rawLeft1 - raw ticks just after the reset
' @local rawRight1 - the same, right wheel
' @local trkLeft1 - tracked ticks just after the reset
' @local trkRight1 - the same, right wheel
' @local rawLeft2 - raw ticks after the agreement window
' @local rawRight2 - the same, right wheel
' @local trkLeft2 - tracked ticks after the agreement window
' @local trkRight2 - the same, right wheel
' @local bAgrees - both wheels' tracked travel matched their raw travel
' @local eError - the reset call's return

    elapsedMs := 0
    bAgrees := FALSE
    bArmed := bDArm(side)
    bAtSpeed := bArmed and bDToSpeed(side)
    if bAtSpeed
        startMs := getms()
        eError := dResetTracking(side)
        elapsedMs := getms() - startMs
        rawLeft1, rawRight1 := dRawTicks(side)
        trkLeft1, trkRight1 := dTrackTicks(side)
        waitBeat(D_SETTLE_MS, CP_LOOP_SETTLE)
        rawLeft2, rawRight2 := dRawTicks(side)
        trkLeft2, trkRight2 := dTrackTicks(side)
        bAgrees := (eError == NO_ERROR) and (abs((trkLeft2 - trkLeft1) - abs(rawLeft2 - rawLeft1)) <= D_TRACKRESET_TOL)
        bAgrees := bAgrees and (abs((trkRight2 - trkRight1) - abs(rawRight2 - rawRight1)) <= D_TRACKRESET_TOL)
        dStepDone(DST_TRACKRESET, side, TRUE, bAgrees and (elapsedMs <= D_TRACKRESET_MS), elapsedMs, 0, D_TRACKRESET_MS, WHY_NONE)
    else
        dStepDone(DST_TRACKRESET, side, FALSE, FALSE, 0, 0, D_TRACKRESET_MS, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
    dStopMotion(side)
    bDRest(side)
    bInstIdle()

PRI dStepEstopSet(side) | bArmed, bAtSpeed, startMs, refuseMs, eRefusal, rawLeft1, rawRight1, rawLeft2, rawRight2, bLatched, bMoved, eClear, bStill
' The three e-stop claims, from one provocation (they cannot be separated: each is a different instant of
' the same latch).
'
'  REFUSE - a drive issued while emergency-stopped returns ERR_EMERGENCY_STOPPED, and returns it QUICKLY.
'           The unfixed library hung the caller's cog here (an unbounded SyncStatus() wait), so the
'           measured number is the call's own latency.
'  LATCH  - D_ESTOP_HOLD_MS later the stop is still in force and nothing has moved. S-4 recorded the old
'           e-stop self-cancelling in about 125-250 ms, so this hold is the discriminator.
'  CLEAR  - clearEmergency() releases it, the platform stays where it is, and getPower() reads 0 (PL-52).
'
' @param side - SIDE_BOTH or SIDE_LEFT
'
' @local bArmed - the instrument acknowledged the ARM
' @local bAtSpeed - the platform reached speed
' @local startMs - getms() before a timed call
' @local refuseMs - how long the refused drive took to return
' @local eRefusal - what that drive returned
' @local rawLeft1 - raw ticks once the coast ended
' @local rawRight1 - the same, right wheel
' @local rawLeft2 - raw ticks after the hold
' @local rawRight2 - the same, right wheel
' @local bLatched - the stop was still in force after the hold
' @local bMoved - the platform moved during the hold, beyond D_POS_TOL_TICKS
' @local eClear - clearEmergency()'s return
' @local bStill - nothing moved after the clear

    refuseMs := 0
    bArmed := bDArm(side)
    bAtSpeed := bArmed and bDToSpeed(side)
    if bAtSpeed == FALSE
        dStepSkip(DST_ESTOP_REFUSE, side, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
        dStepSkip(DST_ESTOP_LATCH, side, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
        dStepSkip(DST_ESTOP_CLEAR, side, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
    else
        dEstop(side)
        ' 1. REFUSE, measured at once: the strongest moment, while the platform is still coasting down
        startMs := getms()
        eRefusal := dDrive(side, D_POWER)
        refuseMs := getms() - startMs
        dStepDone(DST_ESTOP_REFUSE, side, TRUE, (eRefusal == wheelL.ERR_EMERGENCY_STOPPED) and (refuseMs <= D_ESTOP_REFUSE_MS), refuseMs, 0, D_ESTOP_REFUSE_MS, WHY_NONE)
        ' 2. LATCH, after the coast has ended so a moving platform cannot be read as a released latch
        bDRest(side)
        rawLeft1, rawRight1 := dRawTicks(side)
        waitBeat(D_ESTOP_HOLD_MS, CP_LOOP_POLL)
        bLatched := isDEstopped(side)
        rawLeft2, rawRight2 := dRawTicks(side)
        bMoved := (abs(rawLeft2 - rawLeft1) > D_POS_TOL_TICKS) or (abs(rawRight2 - rawRight1) > D_POS_TOL_TICKS)
        dStepDone(DST_ESTOP_LATCH, side, TRUE, bLatched and (bMoved == FALSE), D_ESTOP_HOLD_MS, D_ESTOP_HOLD_MS, D_ESTOP_HOLD_MS, WHY_NONE)
        ' 3. CLEAR: released, still at rest, and no power left standing
        eClear := dClearEstop(side)
        rawLeft1, rawRight1 := dRawTicks(side)
        waitBeat(D_CLEAR_STILL_MS, CP_LOOP_POLL)
        rawLeft2, rawRight2 := dRawTicks(side)
        bStill := (abs(rawLeft2 - rawLeft1) <= D_POS_TOL_TICKS) and (abs(rawRight2 - rawRight1) <= D_POS_TOL_TICKS)
        dStepDone(DST_ESTOP_CLEAR, side, TRUE, (eClear == NO_ERROR) and bStill and (isDEstopped(side) == FALSE) and (dPowerSum(side) == 0), eClear, NO_ERROR, NO_ERROR, WHY_NONE)
    dStopMotion(side)
    bDRest(side)
    bInstIdle()

PRI dStepOrdered() | bArmed, bAtSpeed, eLeftState, eRightState, bSameState, bStopped, startMs
' ORDERED: a stop ordered from cog 0 while ANOTHER cog drives the platform repeatedly leaves both wheels
' in one state, not one stopped and one still driving.
'
' THE SECOND COG IS THE POINT. The property cannot arise from one cog's calls, so a helper cog drives at
' D_POWER every D_ORDERED_PERIOD_MS while cog 0 stops the platform; the helper's drives keep arriving
' during and after the stop. Both wheels' requests go through the same front cog, which applies stops
' before drives within a pass, so the platform ends in one state whichever order the calls interleave.
'
' A REGRESSION GUARD, STATED: nothing in Visit 1-3 showed the two wheels diverging. It rides this visit
' because the front cog is new code on the path every one of those calls now takes.
'
' @local bArmed - the instrument acknowledged the ARM
' @local bAtSpeed - the platform reached speed
' @local eLeftState - the left driver's state after everything settled
' @local eRightState - the right driver's state
' @local bSameState - both wheels ended in the same state
' @local bStopped - that state is DCS_STOPPED
' @local startMs - getms() when the wait for the helper to finish began

    bArmed := bDArm(SIDE_BOTH)
    bAtSpeed := bArmed and bDToSpeed(SIDE_BOTH)
    if bAtSpeed
        odDrives := 0
        odLastErr := NO_ERROR
        bOdDone := FALSE
        bOdRun := TRUE
        benchLog.cogEventBegin()
        odCogId := cogspin(NEWCOG, orderedHelper(), @odStack)
        benchLog.cogEventEnd()
        if odCogId < 0
            bOdRun := FALSE
            dStepDone(DST_ORDERED, SIDE_BOTH, FALSE, FALSE, 0, 0, 0, WHY_NO_COG)
        else
            waitBeat(D_ORDERED_PERIOD_MS * 4, CP_LOOP_POLL)  ' let the helper's drives be in flight
            dStopMotion(SIDE_BOTH)                           ' the ordered stop, from cog 0
            waitBeat(D_ORDERED_PERIOD_MS * 4, CP_LOOP_POLL)  ' more drives arrive after it
            bOdRun := FALSE
            ' bounded: a helper that never answers is stopped anyway, and the state check below still runs
            startMs := getms()
            repeat while (bOdDone == FALSE) and ((getms() - startMs) < STOP_TIMEOUT_MS)
                beat(CP_LOOP_POLL)
                waitms(D_STEP_POLL_MS)
            benchLog.cogEventBegin()
            cogstop(odCogId)
            odCogId := -1
            dStopMotion(SIDE_BOTH)                           ' the helper's last drive is superseded here
            bDRest(SIDE_BOTH)
            beat(CP_LIB_STEER_QUERY)
            eLeftState, eRightState := steering.testGetDriverState()
            beat(CP_LIB_STEER_QUERY)
            bSameState := (eLeftState == eRightState)
            bStopped := (eLeftState == DCS_STOPPED)
            dStepDone(DST_ORDERED, SIDE_BOTH, TRUE, bSameState and bStopped, odDrives, 1, LIM_SMALL, WHY_NONE)
    else
        dStepDone(DST_ORDERED, SIDE_BOTH, FALSE, FALSE, 0, 0, 0, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
    dStopMotion(SIDE_BOTH)
    bDRest(SIDE_BOTH)
    bInstIdle()

PRI orderedHelper()
' THE ORDERED-STOP HELPER COG: drive the platform at D_POWER until cog 0 lowers bOdRun, then say so.
'
' It commands and counts, nothing else: no record, no reading, no stop. Every drive goes through the
' public method, from a cog that is not cog 0, which is the whole point of the step.

    repeat while bOdRun
        odLastErr := steering.driveAtPower(D_POWER, D_POWER)
        odDrives := (odDrives + 1) <# LIM_SMALL
        waitms(D_ORDERED_PERIOD_MS)
    bOdDone := TRUE

PRI dStepTimeStop(side) | bArmed, bAtSpeed, deadlineMs, eError, fireMs, zeroMs, restMs, lateMs, bFired, bZero, bRest, bOk, safeEvent, whyCode, nLateBase, nLateEnd
' TIMESTOP: stopAfterTime() brings every field of the form to zero AT its deadline, with no power left standing.
'
' WHAT IS JUDGED (PL-145, SRC_REV 57): the instant every driver of the form reads DCS_STOPPED -- its field's increment
' ramped to zero -- against the deadline, signed, inside -D_TIMESTOP_EARLY_MS .. D_TIMESTOP_LATE_HI (the CON block
' derives both). The library fires the stop early by the ramp-down's own time (bFrontLimitsDue(), frontStopMs(); the
' steering object's bFrontPlatformLimitsDue()), so that instant IS the feature. Until SRC_REV 56 the cell judged rest
' CONFIRMED (the last hall tick plus REST_CONFIRM_MS), which also holds the rotor's coast after the field is at zero:
' the free rotor may lead the field by up to LAG_SOFT and cross hall edges after it, restarting the dwell, so pass 7
' read 386 (steering) and 314 (single) with nothing late. That instant is still printed (BM-TIMESTOP rest_ms), and not
' judged.
'
' THE NEGATIVE. A stop that fires at the deadline instead of one ramp before it -- the pre-task-3559 driver, or a
' frontStopMs() that returned 0 -- reaches zero one whole ramp-down late. DERIVED for this step (not a reading), SRC_REV
' 59 (DRIVER_REV 38): D_POWER commands 81.7 x 10^6 (incrementForPower(50) at 18.5 V; the 165 ticks/s once quoted here
' was OVERSHT's power-50 leg averaged over its ramps), and the jerk-limited stop from it takes 1_637 + 480 + 1 = 2_118
' passes (RAMP_STOP_EXTRA_PASSES), 1_108 ms, so it reads measured about +1_108 and FAILS against hi 6; its BM-TIMESTOP
' reads fire_ms about 0, where a correct stop's reads about -1_108. A stop fired a ramp too EARLY (S counted twice)
' reads about -1_108 and FAILS against lo -6. A plan that kept the stepped ramp's form (n = |incr| / accel_dn) fires
' about RAMP_TAU_MS late: about +250, which FAILS too.
'
' PL-83, kept: the wait runs to the deadline plus D_REST_MS (a stop is only DUE D_TIMESTOP_MS after the call), and
' the deadline is taken BEFORE the call, so the library's own is never earlier than the step's.
'
' @param side - SIDE_BOTH or SIDE_LEFT
'
' @local bArmed - the instrument acknowledged the ARM
' @local bAtSpeed - the platform reached speed
' @local deadlineMs - getms() the limit is due at, taken before the call
' @local eError - stopAfterTime()'s return
' @local fireMs - getms() when getPower() first read 0 for the form: the limit fired
' @local zeroMs - getms() when every driver of the form first read DCS_STOPPED: the field at zero
' @local restMs - getms() when rest was confirmed after it
' @local lateMs - zeroMs - deadlineMs, signed: the judged number
' @local bFired - getPower() read 0 inside the wait
' @local bZero - every driver read DCS_STOPPED inside the wait
' @local bRest - rest was confirmed inside D_REST_MS of the field's zero
' @local bOk - every claim of the step held
' @local safeEvent - SAFE_* that ended the wait, SAFE_NONE otherwise
' @local whyCode - WHY_* for the step's row
' @local nLateBase - the front cog's late passes before the call
' @local nLateEnd - the same after the field's zero

    lateMs := 0
    bArmed := bDArm(side)
    bAtSpeed := bArmed and bDToSpeed(side)
    if bAtSpeed
        _, nLateBase, _, _, _ := dFrontStats(side)
        deadlineMs := getms() + D_TIMESTOP_MS
        eError := dStopAfterTime(side, D_TIMESTOP_MS)
        bFired := bZero := bRest := FALSE
        fireMs := zeroMs := restMs := 0
        safetyReset()
        safeEvent := SAFE_NONE
        repeat
            beat(CP_LOOP_CAPTURE)
            if (bFired == FALSE) and (dPowerSum(side) == 0)
                fireMs := getms()
                bFired := TRUE
            if bDFieldsStopped(side)
                zeroMs := getms()                           ' after the read: never earlier than the reading
                bZero := TRUE
                quit
            safeEvent := safetyPoll(side)
            if safeEvent == SAFE_FAULT
                safeEvent := SAFE_NONE                      ' as waitRest(..., FALSE): a fault never reads DCS_STOPPED, the bound ends it
            if (safeEvent <> SAFE_NONE) or ((getms() - deadlineMs) >= D_REST_MS)
                quit
            waitms(D_TIMESTOP_POLL_MS)
        _, nLateEnd, _, _, _ := dFrontStats(side)
        if bZero
            lateMs := zeroMs - deadlineMs
            bRest := bDRestWithin(side, D_REST_MS)
            restMs := getms()
            whyCode := WHY_NONE
        elseif safeEvent <> SAFE_NONE
            whyCode := WHY_ABORTED
        else
            whyCode := WHY_STOP_TIMEOUT
        bOk := (eError == NO_ERROR) and bFired and (lateMs >= 0 - D_TIMESTOP_EARLY_MS) and (lateMs <= D_TIMESTOP_LATE_HI) and (dPowerSum(side) == 0)
        dStepDone(DST_TIMESTOP, side, bZero, bOk, lateMs, 0 - D_TIMESTOP_EARLY_MS, D_TIMESTOP_LATE_HI, whyCode)
        emitTimeStop(side, bFired, fireMs - deadlineMs, bZero, lateMs, bRest, restMs - deadlineMs, nLateEnd - nLateBase)
    else
        dStepDone(DST_TIMESTOP, side, FALSE, FALSE, 0, 0 - D_TIMESTOP_EARLY_MS, D_TIMESTOP_LATE_HI, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
    dStopMotion(side)
    bDRest(side)
    bInstIdle()

PRI bDFieldsStopped(side) : bStopped | eLeftState, eRightState
' Report whether every driver of this form reads DCS_STOPPED: its field is at zero (PL-145).
'
' The driver sets DCS_STOPPED on the pass its ramp-down finds the increment at its zero target (.endAtZero), and the
' state is a direct read of its status run -- no request, so the read costs this cog no round trip.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns bStopped - TRUE when every driver of the form reads DCS_STOPPED
'
' @local eLeftState - the left driver's DCS_*, or this wheel's
' @local eRightState - the right driver's DCS_*, or this wheel's again

    beat(CP_LIB_STEER_QUERY)
    if side == SIDE_BOTH
        eLeftState, eRightState := steering.testGetDriverState()
    elseif side == SIDE_RIGHT
        eLeftState := eRightState := wheelR.getDriverState()
    else
        eLeftState := eRightState := wheelL.getDriverState()
    beat(CP_LIB_STEER_QUERY)
    bStopped := (eLeftState == DCS_STOPPED) and (eRightState == DCS_STOPPED)

PRI dStepCmdTimeout(side) | bArmed, bAtSpeed, startMs, lastDriveMs, bHeld, eError, bRest, stopMs, bOk
' CMDTIMEOUT (task 3570, S-8): with setCommandTimeout() on, a drive that keeps being refreshed keeps running,
' and one left unrefreshed stops by itself, is at rest inside its bound, and is reported by getError().
'
' BOTH LIMBS ARE THE CELL. The refreshed limb is the negative case: a timeout that fired on a live link would
' stop the platform there and fail it. The silent limb is the positive case: the unfixed library has no
' timeout, so the platform drives on through the rest bound and fails it. Rest is judged no EARLIER than the
' timeout itself, so a stop that came from something else cannot pass as the timeout's.
'
' @param side - SIDE_BOTH or SIDE_LEFT
'
' @local bArmed - the instrument acknowledged the ARM
' @local bAtSpeed - the platform reached speed
' @local startMs - getms() when the refreshed limb began
' @local lastDriveMs - getms() of the last drive command, the silent limb's origin
' @local bHeld - the refreshed limb kept driving (power still standing, every refresh accepted)
' @local eError - a refresh's return, then getError()'s report after the stop
' @local bRest - rest was confirmed inside the silent limb's bound
' @local stopMs - ms from the last drive command to confirmed rest, the step's printed number
' @local bOk - every claim of the step held

    stopMs := 0
    bOk := FALSE
    bArmed := bDArm(side)
    bAtSpeed := bArmed and bDToSpeed(side)
    if bAtSpeed
        dCollectError(side)                                     ' drain: the report judged below must be this step's
        bHeld := (dSetTimeout(side, D_CMDTMO_MS) == NO_ERROR)
        ' 1. REFRESHED: the same drive every D_CMDTMO_EVERY_MS for D_CMDTMO_REFRESH_MS -- must keep running
        startMs := getms()
        repeat while bHeld and ((getms() - startMs) < D_CMDTMO_REFRESH_MS)
            waitBeat(D_CMDTMO_EVERY_MS, CP_LOOP_POLL)
            eError := dDrive(side, D_POWER)
            lastDriveMs := getms()
            bHeld := (eError == NO_ERROR) and (dPowerSum(side) <> 0)
        ' 2. SILENT: no command at all -- must stop, no sooner than the timeout and inside the rest bound
        if bHeld
            bRest := bDRestWithin(side, D_CMDTMO_MS + D_REST_MS)
            stopMs := getms() - lastDriveMs
            eError := dCollectError(side)
            bOk := bRest and (stopMs >= D_CMDTMO_MS) and (eError == wheelL.ERR_COMMAND_TIMEOUT) and (dPowerSum(side) == 0)
        ' 3. BOUNDED AND SILENT (PL-143, STEPHEN 2026-09-26 "no carve-outs"): a driveForDistance() far longer than the
        '  timeout, then no command -- must stop at the timeout, not run on to its distance. The library before
        '  DRIVER_REV 32 exempted this move ("a bounded move is not watched"), so it drove on and fails this limb.
        if bOk
            bOk := (dDriveDistance(side, D_CMDTMO_BOUND_M) == NO_ERROR)
            lastDriveMs := getms()
            bRest := bOk and bDRestWithin(side, D_CMDTMO_MS + D_REST_MS)
            eError := dCollectError(side)
            bOk := bRest and ((getms() - lastDriveMs) >= D_CMDTMO_MS) and (eError == wheelL.ERR_COMMAND_TIMEOUT)
        dSetTimeout(side, wheelL.CMD_TIMEOUT_OFF)               ' I11: off again before anything else drives
        dStepDone(DST_CMDTIMEOUT, side, TRUE, bHeld and bOk, stopMs, D_CMDTMO_MS, D_CMDTMO_MS + D_REST_MS, WHY_NONE)
    else
        dStepDone(DST_CMDTIMEOUT, side, FALSE, FALSE, 0, D_CMDTMO_MS, D_CMDTMO_MS + D_REST_MS, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
    dStopMotion(side)
    bDRest(side)
    bInstIdle()

PRI dStepDirSign() | bArmed, bRanRight, rightTurnLead, bRanLeft, leftTurnLead, worstLead
' DIRSIGN (task 3577, finding AC): driveDirection() turns toward the sign of its direction by slowing the wheel
' on that side. Wheels lifted, the turn is read as which wheel covers fewer tracked ticks over a window at
' speed: a positive direction must leave the LEFT wheel ahead by D_DIRSIGN_GAP_TICKS, a negative one the RIGHT.
'
' BOTH LIMBS ARE THE CELL, and each is the other's negative case: the unfixed library had the sign inverted,
' so it fails both, and a harness that could not tell the wheels apart could not pass both. The platform
' comes to rest between the limbs so the second starts from rest, not from the first's speed. The steering
' object only: one wheel has no direction.
'
' @local bArmed - the instrument acknowledged the ARM
' @local bRanRight - the right-turn limb reached speed and counted its window
' @local rightTurnLead - the LEFT wheel's lead in the right turn, ticks over the window (expected positive)
' @local bRanLeft - the left-turn limb reached speed and counted its window
' @local leftTurnLead - the RIGHT wheel's lead in the left turn, ticks over the window (expected positive)
' @local worstLead - the smaller of the two leads, the step's printed number

    worstLead := 0
    bRanRight := FALSE
    bRanLeft := FALSE
    bArmed := bDArm(SIDE_BOTH)
    if bArmed
        bRanRight, rightTurnLead := dDirectionLead(D_DIRECTION)
    if bRanRight
        dStopMotion(SIDE_BOTH)                              ' the second limb starts from rest
        bDRest(SIDE_BOTH)
        bRanLeft, leftTurnLead := dDirectionLead(0 - D_DIRECTION)
        leftTurnLead := 0 - leftTurnLead                    ' left-minus-right, negated: the right wheel's lead
        worstLead := rightTurnLead <# leftTurnLead
    if bRanRight and bRanLeft
        dStepDone(DST_DIRSIGN, SIDE_BOTH, TRUE, worstLead >= D_DIRSIGN_GAP_TICKS, worstLead, D_DIRSIGN_GAP_TICKS, LIM_MID, WHY_NONE)
    else
        dStepDone(DST_DIRSIGN, SIDE_BOTH, FALSE, FALSE, 0, D_DIRSIGN_GAP_TICKS, LIM_MID, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
    dStopMotion(SIDE_BOTH)
    bDRest(SIDE_BOTH)
    bInstIdle()

PRI dDirectionLead(direction) : bRan, leftLead | eError, safeEvent, leftStart, rightStart, leftEnd, rightEnd
' Drive the steering object at driveDirection(D_POWER, direction), wait for both wheels at speed and the
' settle, then count each wheel's tracked ticks over D_DIRSIGN_WINDOW_MS. Legal only while armed.
'
' @param direction - driveDirection()'s direction, [-100..100]
' @returns bRan - TRUE when the drive was accepted, both wheels reached speed and the window was counted
' @returns leftLead - left tracked ticks minus right over the window: positive when the RIGHT wheel is slower
'
' @local eError - driveDirection()'s return
' @local safeEvent - SAFE_* from the counting window's wait
' @local leftStart - left tracked ticks at the window's start
' @local rightStart - right tracked ticks at the window's start
' @local leftEnd - left tracked ticks at the window's end
' @local rightEnd - right tracked ticks at the window's end

    bRan := FALSE
    leftLead := 0
    curIncre := 0
    beat(CP_LIB_STEER_DRIVE)
    eError := steering.driveDirection(D_POWER, direction)
    beat(CP_LIB_STEER_DRIVE)
    if (eError == NO_ERROR) and bDHoldSpeed(SIDE_BOTH)
        leftStart, rightStart := dTrackTicks(SIDE_BOTH)
        safeEvent, _ := waitWatched(SIDE_BOTH, D_DIRSIGN_WINDOW_MS, CP_LOOP_POLL, UNTIL_TIME)
        leftEnd, rightEnd := dTrackTicks(SIDE_BOTH)
        bRan := (safeEvent == SAFE_NONE)
        leftLead := (leftEnd - leftStart) - (rightEnd - rightStart)

PRI dSetTimeout(side, timeoutMs) : eError
' Set this form's command timeout (S-8).
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @param timeoutMs - the timeout in ms, or CMD_TIMEOUT_OFF
' @returns eError - NO_ERROR, or the code the library returned

    beat(CP_LIB_COMMAND)
    if side == SIDE_BOTH
        eError := steering.setCommandTimeout(timeoutMs)
    elseif side == SIDE_RIGHT
        eError := wheelR.setCommandTimeout(timeoutMs)
    else
        eError := wheelL.setCommandTimeout(timeoutMs)
    beat(CP_LIB_COMMAND)

PRI dCollectError(side) : eError
' Read and clear this cog's first recorded error for this form: the steering object's own (its first result)
' or the wheel's.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @returns eError - the code getError() reported, NO_ERROR when none

    beat(CP_LIB_STEER_QUERY)
    if side == SIDE_BOTH
        eError, _, _ := steering.getError()
    elseif side == SIDE_RIGHT
        eError := wheelR.getError()
    else
        eError := wheelL.getError()
    beat(CP_LIB_STEER_QUERY)

PRI dStepFrontStats(side) | nPasses, nLate, nMaxTicks, nStackHi, nStackOf, slotIdx, bHealthy
' FRONTST: the front cog kept its 1 kHz slot, never overran its stack, and never fell behind.
'
' Read with the object still running and the platform at rest, so the numbers cover every step this part
' has just put the cog through. A late pass is counted and never replayed, so ZERO late passes is the
' criterion, not a small number of them.
'
' SRC_REV 59 (PL-160, PL-161): THIS READING COVERS PASSES WITH A STOP LIMIT ARMED, in both forms. On its passes while a
' limit is armed the front cog tests it against the stop plan (frontStopMs() / frontStopTicks() -- the steering object
' for both wheels on one pass), and the passes counted here include those of every step before this one in the same
' lifetime: TIMESTOP (dStepTimeStop(), a stopAfterTime() armed at D_POWER's cruise and held until it fires, about 0.9 s
' of passes, whenever the form reached speed) and CMDTIMEOUT's third limb (dStepCmdTimeout(), a driveForDistance() of
' D_CMDTMO_BOUND_M from rest -- a distance limit armed through the ramp up and the timeout's ramp down -- run when its
' first two limbs held). So R16-DUAL-FRONTST-D's max_us, late and ok, for SIDE_BOTH (STEERSEG) and for SIDE_LEFT
' (LIMIT's wheel half), carry the armed limit's cost: at DRIVER_REV 38 the front cog's own closed-form plan (stopPlan())
' at cruise and through a ramp; at DRIVER_REV 39, where the driver plans the stop and the front cog only reads two
' status longs and compares, what is left of it. (The DRIVER_REV 39 plan's own cost is the driver's, inside its frame
' slack; no FRONTST reading measures it.)
'
' PL-75: THE STACK CRITERION IS AGAINST THE OWNING OBJECT'S OWN SIZE, not a constant kept in this
' file. It used to judge every cog against D_FRONT_STACK_HI, which no object ever sees; the two
' front cogs are sized differently (the steering's services two wheels), so one number judged both
' wrongly the moment they diverged.
' The comparison stays STRICTLY LESS on purpose: a mark EQUAL to the size is SATURATED -- every
' sentinel long is gone, so "used all of it" and "used more than all of it" are indistinguishable,
' and that must not read as healthy (doctrine D2: a discovery failure must never render as a value).
'
' @param side - SIDE_BOTH (the steering front cog) or SIDE_LEFT (the wheel's own)
'
' @local nPasses - passes since launch
' @local nLate - passes that overran their slot
' @local nMaxTicks - longest pass body, in system ticks
' @local nStackHi - stack longs ever used
' @local nStackOf - the allocation that mark is against, from the owning object
' @local slotIdx - accumulator slot: 0 the steering cog, 1 the wheel's
' @local bHealthy - every criterion held

    nPasses, nLate, nMaxTicks, nStackHi, nStackOf := dFrontStats(side)
    slotIdx := (side == SIDE_BOTH) ? SLOT_LEFT : SLOT_RIGHT
    bHealthy := (nPasses > 0) and (nLate <= D_FRONT_LATE_HI) and (nMaxTicks < D_FRONT_PASS_TICKS_HI) and (nStackHi < nStackOf)
    bSfFrontRan[slotIdx] := (nPasses > 0)
    bSfFrontOk[slotIdx] := bHealthy
    emitFrontSt(side, nPasses, nLate, nMaxTicks, nStackHi, nStackOf)
    dEvDefaults(side, slotIdx, nLate)                       ' task 3621: this default-limit form's event totals, beside its FRONTST

PRI dEvDefaults(side, formIdx, nLate) | lFold, rFold, lClim, rClim, lPath, rPath, nLateEv, stage
' Task 3621: one of part D's DEFAULT-LIMIT forms -- the steering object in STEERSEG, or the single wheel in LIMIT's
' wheel half -- read beside its FRONTST: getEventTotal() since its start for the kinds only a lowered limit should make,
' printed as BM-EVTOT. These are the NEGATIVES of R20-DUAL-EV-FOLDBACK and -EV-CLIMIT (none of either at the shipped
' limits), and STEERSEG's is R20-DUAL-EV-PATH's (a steering segment with no wheel behind its partner: no EV_PATH_LIMIT --
' PL-141: pass 5 engaged at every healthy start, which this negative now fails). Totals, not a
' drain: they are never lost, however many stops the form's steps queued. The late count goes to R20-T0-EV-LATE.
'
' @param side - SIDE_BOTH (the steering object) or SIDE_LEFT (the single wheel)
' @param formIdx - [0] the steering front cog, [1] the single wheel's
' @param nLate - the form's late passes, from its FRONTST
'
' @local lFold - the left wheel's EV_FOLDBACK total (the single wheel's own)
' @local rFold - the right wheel's (0 for the single wheel)
' @local lClim - the left wheel's EV_CURRENT_LIMIT total
' @local rClim - the right wheel's
' @local lPath - the left wheel's EV_PATH_LIMIT total
' @local rPath - the right wheel's
' @local nLateEv - the form's EV_LATE_PASS total
' @local stage - EVST_STEERSEG or EVST_WHEEL

    rFold := 0
    rClim := 0
    rPath := 0
    if side == SIDE_BOTH
        stage := EVST_STEERSEG
        beat(CP_LIB_STEER_QUERY)
        lFold, rFold, _ := steering.getEventTotal(steering.EV_FOLDBACK)
        lClim, rClim, _ := steering.getEventTotal(steering.EV_CURRENT_LIMIT)
        lPath, rPath, _ := steering.getEventTotal(steering.EV_PATH_LIMIT)
        _, _, nLateEv := steering.getEventTotal(steering.EV_LATE_PASS)
        beat(CP_LIB_STEER_QUERY)
        bDDefSteer := TRUE
        if (lPath + rPath) <> 0
            dDefPathBad := (dDefPathBad + 1) <# LIM_SMALL
    else
        stage := EVST_WHEEL
        lFold := wheelEventTotal(side, wheelL.EV_FOLDBACK)
        lClim := wheelEventTotal(side, wheelL.EV_CURRENT_LIMIT)
        lPath := wheelEventTotal(side, wheelL.EV_PATH_LIMIT)
        nLateEv := wheelEventTotal(side, wheelL.EV_LATE_PASS)
    emitEvTot(stage, side, lFold, rFold, lClim, rClim, lPath, rPath, nLateEv)
    dDefForms := (dDefForms + 1) <# LIM_SMALL
    if (lFold + rFold) <> 0
        dDefFoldBad := (dDefFoldBad + 1) <# LIM_SMALL
    if (lClim + rClim) <> 0
        dDefClimBad := (dDefClimBad + 1) <# LIM_SMALL
    lateFold(formIdx, nLate, nLateEv)

PRI dEvStage(stage) | logIdx, nPairs, bFormed, nCount, bOk, bRestored
' Task 3621: drain the steering object's log after one of part D's three LIMIT steps (lowered current limits), EV_SETTLE_MS
' after the step's stop, so the fold-back's release -- queued after a second of quiet -- is in the drain with its engage.
' Folds R20-DUAL-EV-FOLDBACK (every stage), R20-DUAL-EV-CLIMIT (the DERATE stage) and R20-DUAL-EV-PATH (every stage's
' pairing; the BLOCK stage's pair).
'  EV_FOLDBACK and EV_PATH_LIMIT: per log, the sequence must be engage, release ... ending on a release (evPairs())
'  EV_CURRENT_LIMIT, DERATE stage, per wheel against what dStepDerate() saw of the same wheel: a wheel that derated and
'   came back logs D_DERATE_CONT_A then D_DERATE_PEAK_A; one that derated and did not come back, D_DERATE_CONT_A alone;
'   one that never derated, nothing
'
' @param stage - EVST_D_FOLD, EVST_D_DERATE or EVST_D_BLOCK
'
' @local logIdx - EVI_LEFT or EVI_RIGHT
' @local nPairs - pairs in one log
' @local bFormed - that log's sequence was well formed
' @local nCount - one wheel's EV_CURRENT_LIMIT events
' @local bOk - that wheel's EV_CURRENT_LIMIT matched its derate
' @local bRestored - dStepDerate() saw that wheel derate AND come back

    dWaitDriversStopped()                                   ' Visit 10 pass 6: the settle counts from the FIELDS' stop
    waitBeat(EV_SETTLE_MS, CP_LOOP_REST)
    evDrain(EVSRC_STEER, stage)
    dEvStages := (dEvStages + 1) <# LIM_SMALL
    if bEvdClean() == FALSE
        dEvUnclean := (dEvUnclean + 1) <# LIM_SMALL
    repeat logIdx from EVI_LEFT to EVI_RIGHT
        nPairs, bFormed := evPairs(logIdx, EVQ_FOLD)
        dFoldPairs := (dFoldPairs + nPairs) <# LIM_SMALL
        if bFormed == FALSE
            dFoldBadSeq := (dFoldBadSeq + 1) <# LIM_SMALL
        nPairs, bFormed := evPairs(logIdx, EVQ_PATH)
        if stage == EVST_D_BLOCK
            dPathPairs := (dPathPairs + nPairs) <# LIM_SMALL
            dPathLogMax #>= nPairs                              ' PL-144: a limiter that hunts logs a pair per cycle
        if bFormed == FALSE
            dPathBadSeq := (dPathBadSeq + 1) <# LIM_SMALL
        if stage == EVST_D_DERATE
            nCount := evCount(logIdx, wheelL.EV_CURRENT_LIMIT)
            bRestored := bSfDerateOk[logIdx]
            if bSfDerateRan[logIdx] and bRestored
                bOk := (nCount == 2) and (evSeqAt(logIdx, EVQ_CLIMIT, 0) == D_DERATE_CONT_A) and (evSeqAt(logIdx, EVQ_CLIMIT, 1) == D_DERATE_PEAK_A)
            elseif bSfDerateRan[logIdx]
                bOk := (nCount == 1) and (evSeqAt(logIdx, EVQ_CLIMIT, 0) == D_DERATE_CONT_A)
            else
                bOk := (nCount == 0)
            if bSfDerateRan[logIdx]
                bDClimPos := TRUE
            dClimN := (dClimN + 1) <# LIM_SMALL
            if (bOk == FALSE) or (bEvdClean() == FALSE)
                dClimBad := (dClimBad + 1) <# LIM_SMALL
    if stage == EVST_D_BLOCK
        bDBlockDrained := TRUE
        ' PL-141: the path limiter now engages only for a wheel BEHIND its partner, so a stall of both wheels
        '  together (this step's, wheels up) no longer owes a pair; the positive half needs one seen behind
        '  (dBehindPoll(), latched, SRC_REV 56)
        bDPathBehind := bHpBehindSeen[SLOT_LEFT] or bHpBehindSeen[SLOT_RIGHT]

PRI dWaitDriversStopped() | startMs, eLeftState, eRightState
' Wait, bounded by D_REST_MS, until both drivers read DCS_STOPPED.
'
' Visit 10 pass 6, R20-DUAL-EV-FOLDBACK: the BLOCK step's rest wait confirms rest by POSITION, and a wheel stalled at
' 1 A reads at rest while its field is still ramping down and folding back. The drain EV_SETTLE_MS later then fell
' before that wheel's release was queued (a second of quiet after its last folded frame), and its log read engage
' only. Counting the settle from the fields' own stop puts the release inside the drain.
'
' @local startMs - getms() at the call
' @local eLeftState - the left driver's DCS_*
' @local eRightState - the right driver's DCS_*

    startMs := getms()
    repeat
        beat(CP_LIB_STEER_QUERY)
        eLeftState, eRightState := steering.testGetDriverState()
        beat(CP_LIB_STEER_QUERY)
        if (eLeftState == wheelL.DCS_STOPPED) and (eRightState == wheelL.DCS_STOPPED)
            quit
        waitms(D_LIMIT_POLL_MS)
    while (getms() - startMs) < D_REST_MS

PRI dStepCoopShut(side) | startMs, elapsedMs
' COOPSHUT: stop() returns inside D_COOPSHUT_MS.
'
' The front cog is asked to EXIT, answers every open request and parks before it is cogstopped (PL-41),
' so the shutdown is cooperative rather than a cut line -- and it is BOUNDED, which is what this measures.
' The bound is the library's own request round trip; anything longer means the EXIT was not answered.
'
' @param side - SIDE_BOTH or SIDE_LEFT
'
' @local startMs - getms() before stop()
' @local elapsedMs - how long stop() took

    startMs := getms()
    dShutdown(side)
    elapsedMs := getms() - startMs
    dStepDone(DST_COOPSHUT, side, TRUE, elapsedMs < D_COOPSHUT_MS, elapsedMs, 0, D_COOPSHUT_MS - 1, WHY_NONE)

VAR { RESTCOAST (task 3623, PL-138) -- one step's staging, cog 0 only }

    LONG    rcPreX10[RC_RUNS * INST_MOTORS]                 ' [run * INST_MOTORS + slot]: hall ticks/s x10 over RC_PRE_MS before the stop
    LONG    rcTicks[RC_RUNS * INST_MOTORS]                  ' ...hall ticks from the stop call to the window's end
    LONG    rcWinX10[RC_RUNS * INST_MOTORS]                 ' ...that window's rate, hall ticks/s x10
    LONG    rcWhy[RC_RUNS]                                  ' per run: WHY_NONE when it measured
    LONG    bRcCalled                                       ' the trial called start()
    LONG    rcRet                                           ' ...and start() returned this
    LONG    rcCallMs                                        ' ...this long after the stop call
    LONG    rcCoastMs                                       ' the reference: stop call to confirmed rest, ms; -1 when not confirmed
    LONG    rcKeepPct[INST_MOTORS]                          ' R20-DUAL-RESTCOAST's number per wheel: trial rate / reference rate, %
    LONG    bRcRan[INST_MOTORS]                             ' ...measured

PRI rcResetCells() | slotIdx
' Task 3623: RESTCOAST's staging, before anything runs (initRunState()).
'
' @local slotIdx - motor slot

    bRcCalled := FALSE
    rcRet := -1
    rcCallMs := 0
    rcCoastMs := -1
    rcWhy[RC_REF] := WHY_ABORTED
    rcWhy[RC_TRIAL] := WHY_ABORTED
    longfill(@rcPreX10, 0, RC_RUNS * INST_MOTORS)
    longfill(@rcTicks, 0, RC_RUNS * INST_MOTORS)
    longfill(@rcWinX10, 0, RC_RUNS * INST_MOTORS)
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        rcKeepPct[slotIdx] := 0
        bRcRan[slotIdx] := FALSE

PRI dStepRestCoast() | runIdx, slotIdx, whyCode, slotWhy, bBothRan, bBothOk, worstPct
' RESTCOAST (task 3623, PL-138): a platform stopped and restarted back to back while its wheels coast keeps its coast.
'
' WHAT IT CERTIFIES. Before DRIVER_REV 27 every driver start held all three low sides ON -- a phase short, a brake --
' through its sense calibration and, under steering.start(), through the park that waits for the ATN (at least
' 100 ms a wheel: the start launches both drivers, then waits 100 ms before the one COGATN). A wheel still coasting
' when the platform was restarted was braked by it. DRIVER_REV 27 holds every gate OFF through both, and DRIVER_REV 29
' releases the bridge at stop(). PRE-REGISTERED: on DRIVER_REV >= 27 each wheel keeps its coasting rate across a
' steering stop() + start(); on DRIVER_REV <= 26 it would have lost much of it inside RC_WINDOW_MS.
'
' THE NEGATIVE IS THE PRE-FIX BEHAVIOUR, DERIVED -- this harness cannot re-run the old driver. What makes a braking
' restart FAIL is the IN-RUN CONTROL: the same run's REFERENCE, steering.stop() alone from the same speed, a free
' coast measured over the same window by the same instrument. The trial differs from it by the start() alone, so a
' start that shorts the phases reads well under RC_KEEP_PCT of it.
'
' WHY THE REFERENCE IS stop() AND NOT stopMotors(). PL-58: every stop commanded from speed follows the driver's own
' ramp whatever holdAtStop() selects, so a stopMotors() "coast" is a driven deceleration -- faster than a free coast.
' A reference that low would let a braking restart pass. stop() on DRIVER_REV 29 coasts the bridge and lets go.
'
' THE INSTRUMENT RUNS ACROSS THE STOP AND THE START, and it may: armed on INST_SRC_NONE it reads no library object at
' all -- only each wheel's hall pins, with PINREAD, which changes no pin configuration -- so the straddled read I10
' guards against cannot arise. The ring is drained only once it is frozen (I10).
'
' A START THAT RETURNS -1 IS NOMEAS unless it was refused by its own start checks (ERR_START_CHECK_FAILED). The checks
' run after the ATN, so both drivers were launched and parked -- the windows under test -- and the checks meet a wheel
' still turning, by construction. Any other -1 may not have launched a driver at all, and a restart that parks
' nothing would pass for nothing.
'
' @local runIdx - RC_REF then RC_TRIAL
' @local slotIdx - motor slot
' @local whyCode - the first run's WHY_*, WHY_NONE when both measured
' @local slotWhy - this wheel's WHY_*
' @local bBothRan - both wheels measured, for BM-DSTEP
' @local bBothOk - both wheels kept RC_KEEP_PCT
' @local worstPct - the smaller kept percentage

    repeat runIdx from RC_REF to RC_TRIAL
        if bRunContinue(SEG_STEERSEG) == FALSE
            rcWhy[runIdx] := WHY_ABORTED
        elseif bSteerStart(SEG_STEERSEG) == FALSE
            rcWhy[runIdx] := WHY_NO_COG
        else
            rcWhy[runIdx] := rcRun(runIdx)
        steerStop()                                         ' idles the instrument first (I10); safe on a stopped object
        if rcWhy[runIdx] <> WHY_NONE                        ' a trial without its reference judges nothing
            quit
    whyCode := rcWhy[RC_REF]
    if whyCode == WHY_NONE
        whyCode := rcWhy[RC_TRIAL]
    bBothRan := TRUE
    bBothOk := TRUE
    worstPct := LIM_SMALL
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        slotWhy := whyCode
        if (slotWhy == WHY_NONE) and ((rcWinX10[(RC_REF * INST_MOTORS) + slotIdx] == 0) or (rcPreX10[(RC_REF * INST_MOTORS) + slotIdx] == 0) or (rcPreX10[(RC_TRIAL * INST_MOTORS) + slotIdx] == 0))
            slotWhy := WHY_NOT_REACHED                      ' a wheel not turning at a stop, or a reference that did not coast
        if slotWhy == WHY_NONE
            rcKeepPct[slotIdx] := ((rcWinX10[(RC_TRIAL * INST_MOTORS) + slotIdx] * RC_PCT_SCALE) / rcWinX10[(RC_REF * INST_MOTORS) + slotIdx]) <# LIM_SMALL
            bRcRan[slotIdx] := TRUE
            worstPct <#= rcKeepPct[slotIdx]
            if rcKeepPct[slotIdx] < RC_KEEP_PCT
                bBothOk := FALSE
        else
            bBothRan := FALSE
            if whyCode == WHY_NONE
                whyCode := slotWhy
        emitRestCoast(slotIdx, slotWhy)
    dStepDone(DST_RESTCOAST, SIDE_BOTH, bBothRan, bBothOk, worstPct, RC_KEEP_PCT, RC_KEEP_HI_PCT, bBothRan ? WHY_NONE : whyCode)

PRI rcRun(runIdx) : whyCode | safeEvent, bAtSpeed, markMs, leftMs
' One RESTCOAST run on a started steering object: both wheels to D_RC_POWER and AT_SPEED (the instrument on the steering
' object, so the safety watch holds); then the instrument re-armed on the pins alone for RC_PRE_MS; the mark and
' steering.stop(), and for the trial start() at once; the window and its tail; freeze and drain; then a bounded wait for
' the wheels to coast to rest. Leaves the object as the run left it; the caller stops it.
'
' @param runIdx - RC_REF (stop() alone) or RC_TRIAL (stop() then start())
' @returns whyCode - WHY_NONE when the window was measured
'
' @local safeEvent - SAFE_* from the watched waits
' @local bAtSpeed - both wheels reached AT_SPEED and settled
' @local markMs - getms() at the mark, just before the stop call
' @local leftMs - window and tail still owed after the stop (and start)

    whyCode := WHY_NONE
    markMs := -1
    bAtSpeed := FALSE
    if bDArm(SIDE_BOTH) == FALSE
        whyCode := WHY_INST_NOACK
    elseif dDrive(SIDE_BOTH, D_RC_POWER) <> NO_ERROR
        whyCode := WHY_NOT_REACHED
    else
        bAtSpeed := bDHoldSpeed(SIDE_BOTH)
        if bAtSpeed == FALSE
            whyCode := WHY_NOT_REACHED
    if whyCode == WHY_NONE
        bInstFreeze(0)                                      ' FROZEN is quiet: the arm below is legal from it
        if bInstArm(INST_SRC_NONE, RC_DECIM) == FALSE
            whyCode := WHY_INST_NOACK
    if whyCode == WHY_NONE
        safeEvent, _ := waitWatched(SIDE_BOTH, RC_PRE_MS, CP_LOOP_SETTLE, UNTIL_TIME)
        if safeEvent <> SAFE_NONE
            whyCode := safeWhy(safeEvent)
    if whyCode == WHY_NONE
        markMs := rcSteerStop()
        if runIdx == RC_TRIAL
            bSteerStartNow(SEG_STEERSEG)                    ' the harness's own start, its checks on; no walk, no winding probe
            bRcCalled := TRUE
            rcRet := ssRet
            rcCallMs := ssCallMs - markMs
        leftMs := (RC_WINDOW_MS + RC_TAIL_MS) - (getms() - markMs)
        if leftMs > 0
            safeEvent, _ := waitWatched(SIDE_BOTH, leftMs, CP_LOOP_CAPTURE, UNTIL_TIME)
            if safeEvent <> SAFE_NONE
                whyCode := safeWhy(safeEvent)
        if bInstFreeze(0) == FALSE
            whyCode := WHY_INST_NOACK
        elseif whyCode == WHY_NONE
            whyCode := rcDrain(runIdx)
        if (whyCode == WHY_NONE) and (runIdx == RC_TRIAL)
            if (rcRet < 0) and (ssErr <> wheelL.ERR_START_CHECK_FAILED)
                whyCode := WHY_NO_COG                       ' the restart may have parked nothing (see dStepRestCoast())
            elseif rcCallMs > RC_CALL_MAX_MS
                whyCode := WHY_WINDOW_TIMEOUT               ' the restart came too late for the window to hold its parks
    else
        dStopMotion(SIDE_BOTH)                              ' never reached the stop: bring the platform down under power
    if bDRestWithin(SIDE_BOTH, RC_REST_MS) and (runIdx == RC_REF) and (markMs <> -1)
        rcCoastMs := getms() - markMs                       ' includes waitRest()'s REST_CONFIRM_MS dwell

PRI rcSteerStop() : markMs
' steering.stop() WITH THE INSTRUMENT RUNNING on INST_SRC_NONE -- RESTCOAST's one I10 exception, sound because that source
' reads no library object (dStepRestCoast()). The cog-event quiet window opens first (PL-41), then the mark, so the
' window's start sits just before the stop call.
'
' @returns markMs - getms() at the mark

    benchLog.cogEventBegin()
    instMark()
    markMs := getms()
    beat(CP_LIB_STEER_STOP)
    steering.stop()
    beat(CP_LIB_STEER_STOP)
    bSteerUp := FALSE

PRI rcDrain(runIdx) : whyCode | slotIdx, sampleIdx, endJ, winTicks, preMs, winMs, arrIdx
' Read one run's frozen capture (I10): per wheel, the hall ticks and rate over RC_PRE_MS before the mark and over
' RC_WINDOW_MS from it. The window ends at the last stored sample no later than RC_WINDOW_MS after the mark, and each
' rate is taken over the stored samples' own timestamps, so a window a sample short is still a rate, not a count
' short. A window whose stored span falls a sample period short of RC_WINDOW_MS is not a measurement.
'
' @param runIdx - RC_REF or RC_TRIAL
' @returns whyCode - WHY_NONE when both wheels' numbers were read
'
' @local slotIdx - motor slot
' @local sampleIdx - logical index
' @local endJ - the window's last sample
' @local winTicks - RC_WINDOW_MS in system ticks
' @local preMs - the pre-stop span, ms
' @local winMs - the window's stored span, ms
' @local arrIdx - [run * INST_MOTORS + slot]

    whyCode := WHY_NONE
    drainBegin()
    drainFindMark()
    if (bDrMarkFound == FALSE) or (drMarkJ < 1)
        whyCode := WHY_RING_LOST_HEAD                       ' no mark, or no sample before it to take the speed from
    else
        winTicks := RC_WINDOW_MS * TICKS_PER_MS
        endJ := drMarkJ
        ' drMarkJ < drStored (drainFindMark()), so this range never counts down
        repeat sampleIdx from drMarkJ to drStored - 1
            beat(CP_LOOP_DRAIN)
            if (smpT(sampleIdx) - smpT(drMarkJ)) > winTicks
                quit
            endJ := sampleIdx
        if (smpT(endJ) - smpT(drMarkJ)) < (winTicks - (RC_DECIM * INST_PERIOD_TICKS))
            whyCode := WHY_NO_SAMPLES
        else
            preMs := (smpT(drMarkJ) - smpT(0)) / TICKS_PER_MS
            winMs := (smpT(endJ) - smpT(drMarkJ)) / TICKS_PER_MS
            repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                arrIdx := (runIdx * INST_MOTORS) + slotIdx
                rcPreX10[arrIdx] := 0
                if preMs > 0
                    rcPreX10[arrIdx] := ((abs(smpHw(drMarkJ, slotIdx) - smpHw(0, slotIdx)) * RATE_X10_SCALE) / preMs) <# LIM_SMALL
                rcTicks[arrIdx] := abs(smpHw(endJ, slotIdx) - smpHw(drMarkJ, slotIdx)) <# LIM_SMALL
                rcWinX10[arrIdx] := ((rcTicks[arrIdx] * RATE_X10_SCALE) / winMs) <# LIM_SMALL

PRI dLimitState(slotIdx) : nPeakA, nContA, bDeratedNow, nPhaseMa, nLimitK
' One wheel's current-limit state, read through the steering object's pass-through.
'
' @param slotIdx - motor slot
' @returns nPeakA - the peak phase-current limit in force, amps
' @returns nContA - the continuous limit, amps
' @returns bDeratedNow - T/F where T means the fold-back holds the continuous limit
' @returns nPhaseMa - the front cog's ~1 s average of the phase-current lower bound, mA
' @returns nLimitK - the fold-back factor the driver reads

    beat(CP_LIB_STEER_QUERY)
    if slotIdx == SLOT_RIGHT
        nPeakA, nContA, bDeratedNow, nPhaseMa, nLimitK := steering.testRightGetCurrentLimitState()
    else
        nPeakA, nContA, bDeratedNow, nPhaseMa, nLimitK := steering.testLeftGetCurrentLimitState()
    beat(CP_LIB_STEER_QUERY)

PRI dSetLimits(peakAmps, contAmps) : eError
' Replace both wheels' current limits (TEST-USE; the step that sets them restores them).
'
' @param peakAmps - the peak limit, amps
' @param contAmps - the continuous limit, amps
' @returns eError - NO_ERROR, or the code the library returned

    beat(CP_LIB_COMMAND)
    eError := steering.testSetCurrentLimits(peakAmps, contAmps)
    beat(CP_LIB_COMMAND)

PRI dStepFoldBack() | bArmed, eError, slotIdx, startMs, peakMa[INST_MOTORS], startPos[INST_MOTORS], bFaulted, bTurned, bOk, worstMa
' FOLDBACK: with the peak limit lowered to one a lifted wheel can reach, the driver holds the phase
' current at that limit and KEEPS TURNING instead of faulting.
'
' The peak and continuous limits are set to the same value, so only the driver's own fold-back acts --
' the front cog's derate has nothing left to lower. The judged quantity is the front cog's own phase
' estimate (testGetCurrentLimitState()'s average), the same number the derate decision reads, so the
' cell and the driver judge one source.
'
' @local bArmed - the instrument acknowledged the ARM
' @local eError - the limit write's return
' @local slotIdx - motor slot
' @local startMs - getms() at the start of the hold
' @local peakMa - largest phase average seen, per motor
' @local startPos - each wheel's raw ticks at the start of the hold
' @local bFaulted - either wheel's fault flag was seen during the hold
' @local bTurned - both wheels moved during the hold
' @local bOk - both wheels met the criterion
' @local worstMa - the larger of the two peak averages, the step's printed number

    bFaulted := FALSE
    worstMa := 0
    bArmed := bDArm(SIDE_BOTH)
    eError := dSetLimits(D_FOLD_PEAK_A, D_FOLD_CONT_A)
    if bArmed and (eError == NO_ERROR) and (dDrive(SIDE_BOTH, D_POWER) == NO_ERROR)
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            peakMa[slotIdx] := 0
        startPos[SLOT_LEFT], startPos[SLOT_RIGHT] := dRawTicks(SIDE_BOTH)
        startMs := getms()
        repeat
            beat(CP_LOOP_POLL)
            repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                peakMa[slotIdx] #>= dLimitPhaseMa(slotIdx)
                if instLastFault[slotIdx] <> FALSE
                    bFaulted := TRUE
            waitms(D_LIMIT_POLL_MS)
            if (getms() - startMs) >= D_FOLD_HOLD_MS
                quit
        bTurned := bDBothMoved(startPos[SLOT_LEFT], startPos[SLOT_RIGHT])
        bOk := (bFaulted == FALSE) and bTurned
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            worstMa #>= peakMa[slotIdx]
            bSfLimRan[slotIdx] := TRUE
            bSfLimOk[slotIdx] := (peakMa[slotIdx] <= dFoldBoundMa()) and (bFaulted == FALSE) and bTurned
            bOk := bOk and (peakMa[slotIdx] <= dFoldBoundMa())
            emitLimSt(SIDE_LEFT + slotIdx, slotIdx, DST_FOLDBACK, peakMa[slotIdx])
        dStepDone(DST_FOLDBACK, SIDE_BOTH, TRUE, bOk, worstMa, 0, dFoldBoundMa(), WHY_NONE)
    else
        dStepDone(DST_FOLDBACK, SIDE_BOTH, FALSE, FALSE, 0, 0, dFoldBoundMa(), bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
    dStopMotion(SIDE_BOTH)
    bDRest(SIDE_BOTH)
    bInstIdle()

PRI dFoldBoundMa() : nBoundMa
' The phase-current average the FOLDBACK hold may reach: the lowered peak limit plus its stated tolerance.
'
' @returns nBoundMa - the bound, in mA

    nBoundMa := (D_FOLD_PEAK_A * 1_000 * D_FOLD_TOL_PCT) / 100

PRI dLimitPhaseMa(slotIdx) : nPhaseMa
' One wheel's judged phase-current average.
'
' @param slotIdx - motor slot
' @returns nPhaseMa - the front cog's ~1 s average, mA

    _, _, _, nPhaseMa, _ := dLimitState(slotIdx)

PRI bDLimitDerated(slotIdx) : bDeratedNow
' Whether one wheel's fold-back currently holds the continuous limit.
'
' @param slotIdx - motor slot
' @returns bDeratedNow - T/F where T means the limit is derated

    _, _, bDeratedNow, _, _ := dLimitState(slotIdx)

PRI bDBothMoved(startLeft, startRight) : bMoved | nowLeft, nowRight
' Report whether both wheels' raw tick counts have moved since a pair of readings.
'
' @param startLeft - the left wheel's raw ticks at the start
' @param startRight - the right wheel's raw ticks at the start
' @returns bMoved - TRUE when both counts changed
'
' @local nowLeft - the left wheel's raw ticks now
' @local nowRight - the right wheel's raw ticks now

    nowLeft, nowRight := dRawTicks(SIDE_BOTH)
    bMoved := (nowLeft <> startLeft) and (nowRight <> startRight)

PRI dStepDerate() | bArmed, eError, slotIdx, startMs, derateMs[INST_MOTORS], bRestored[INST_MOTORS], bAnyDerated, bOk, worstMs
' DERATE: the front cog lowers the driver's fold-back to the CONTINUOUS limit once its ~1 s average of
' the phase current crosses it, and returns the peak limit once the average falls away again.
'
' The peak limit is set well above the continuous one, so the two are distinguishable: a derate here is
' the front cog's decision, not the driver's fold-back.
'
' THE CLAIM IS "IT DERATED AND THE PEAK LIMIT CAME BACK", NOT "IT DERATED WITHIN N MILLISECONDS" (PL-80).
' The arrival time is recorded and judged only against D_DERATE_WAIT_MS, the bound on it arriving at all;
' a wheel that does not reach the limit inside that wait is NOMEAS with why NOT_DERATED, which is a
' RESULT about this rig rather than a failure of the driver (doctrine overlay P1: every run is
' wheels-lifted, and a lifted 6.5in wheel only just reaches the continuous limit).
'
' @local bArmed - the instrument acknowledged the ARM
' @local eError - the limit write's return
' @local slotIdx - motor slot
' @local startMs - getms() at the drive
' @local derateMs - ms from the drive to the derate, per motor; 0 when it never came
' @local bRestored - the peak limit came back after the stop, per motor
' @local bAnyDerated - at least one wheel derated, so the step was measurable
' @local bOk - both wheels derated inside the window and restored
' @local worstMs - the later of the two derate times, the step's printed number

    bAnyDerated := FALSE
    worstMs := 0
    bArmed := bDArm(SIDE_BOTH)
    eError := dSetLimits(D_DERATE_PEAK_A, D_DERATE_CONT_A)
    if bArmed and (eError == NO_ERROR) and (dDrive(SIDE_BOTH, D_POWER) == NO_ERROR)
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            derateMs[slotIdx] := 0
            bRestored[slotIdx] := FALSE
        startMs := getms()
        repeat
            beat(CP_LOOP_POLL)
            repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                if (derateMs[slotIdx] == 0) and (bDLimitDerated(slotIdx) <> FALSE)
                    derateMs[slotIdx] := (getms() - startMs) #> 1
                    bAnyDerated := TRUE
            waitms(D_LIMIT_POLL_MS)
            if ((derateMs[SLOT_LEFT] <> 0) and (derateMs[SLOT_RIGHT] <> 0)) or ((getms() - startMs) >= D_DERATE_WAIT_MS)
                quit
        dStopMotion(SIDE_BOTH)
        bDRest(SIDE_BOTH)
        startMs := getms()
        repeat                                              ' the peak limit returns once the average decays
            beat(CP_LOOP_POLL)
            repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                if bDLimitDerated(slotIdx) == FALSE
                    bRestored[slotIdx] := TRUE
            waitms(D_LIMIT_POLL_MS)
            if (bRestored[SLOT_LEFT] and bRestored[SLOT_RIGHT]) or ((getms() - startMs) >= D_DERATE_REST_MS)
                quit
        bOk := bAnyDerated
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            worstMs #>= derateMs[slotIdx]
            ' PL-80: a wheel that never derated is NOT MEASURED, so its own cell prints NOMEAS and it does
            '  not fail the step. A wheel that DID derate is judged on the claim the cell is named for --
            '  the peak limit came back once the average decayed.
            bSfDerateRan[slotIdx] := (derateMs[slotIdx] <> 0)
            bSfDerateOk[slotIdx] := bSfDerateRan[slotIdx] and bRestored[slotIdx]
            if bSfDerateRan[slotIdx]
                bOk := bOk and bSfDerateOk[slotIdx]
            emitLimSt(SIDE_LEFT + slotIdx, slotIdx, DST_DERATE, derateMs[slotIdx])
        dStepDone(DST_DERATE, SIDE_BOTH, bAnyDerated, bOk, worstMs, 1, D_DERATE_WAIT_MS, bAnyDerated ? WHY_NONE : WHY_NOT_DERATED)
    else
        dStepDone(DST_DERATE, SIDE_BOTH, FALSE, FALSE, 0, 1, D_DERATE_WAIT_MS, bArmed ? WHY_NOT_REACHED : WHY_INST_NOACK)
    dStopMotion(SIDE_BOTH)
    bDRest(SIDE_BOTH)
    bInstIdle()

PRI dStepBlocked() | bArmed, eError, startMs, blockMs, eLeftCode, eRightCode, eRefusal, eAfterEstopClear, eRelease, rawLeft1, rawRight1, bStill, bDroveAgain, bOk
' BLOCKED: a commanded motor that cannot move latches a PROTECTIVE STOP, refuses every drive with its own
' code, is NOT released by clearEmergency(), and is released by clearProtectiveStop().
'
' THE PROVOCATION IS THE CONSTRUCTION, not a jammed wheel: the current limits are set to 1 A, which the
' driver's fold-back cannot serve, so the rotor never follows the field and the front cog sees a motor
' commanded to move and standing still -- exactly the blocked-platform condition, reached with nothing
' touching the rig (doctrine overlay P1: every run is wheels-lifted). LAGBOUND is exempt for the whole
' step: the lag here is deliberate.
'
' NOMEAS, not FAIL, when the wheels keep turning at 1 A: that means the condition never arose on this rig,
' which is a fact about the rig, not about the driver.
'
' @local bArmed - the instrument acknowledged the ARM
' @local eError - the limit write's return
' @local startMs - getms() at the drive
' @local blockMs - ms from the drive to the latch
' @local eLeftCode - the left wheel's protective code
' @local eRightCode - the right wheel's protective code
' @local eRefusal - what a drive returned while the stop was latched
' @local eAfterEstopClear - what clearEmergency() returned while it was latched
' @local eRelease - what clearProtectiveStop() returned
' @local rawLeft1 - raw ticks after the release
' @local rawRight1 - the same, right wheel
' @local bStill - the platform stayed at rest through the release
' @local bDroveAgain - the platform reached speed once the limits were restored
' @local bOk - every claim of the step held

    blockMs := 0
    bInstLagExempt := TRUE                                  ' the lag below is provoked on purpose
    dHoldProbeReset()                                       ' R18.4 A-7 / A-8: the stall is also the forced shortfall
    bArmed := bDArm(SIDE_BOTH)
    eError := dSetLimits(D_BLOCK_PEAK_A, D_BLOCK_CONT_A)
    if bArmed and (eError == NO_ERROR) and (dDrive(SIDE_BOTH, D_POWER) == NO_ERROR)
        startMs := getms()
        repeat
            beat(CP_LOOP_POLL)
            eLeftCode, eRightCode := dProtectiveStop()
            if (eLeftCode <> NO_ERROR) and (eRightCode <> NO_ERROR)
                blockMs := (getms() - startMs) #> 1
                quit
            dHoldProbe(SLOT_LEFT, getms() - startMs)          ' before the latch: the stall is still being driven
            dHoldProbe(SLOT_RIGHT, getms() - startMs)
            dBehindPoll()                                   ' PL-141: after both wheels' readings of this poll
            waitms(D_LIMIT_POLL_MS)
            if (getms() - startMs) >= D_BLOCK_WAIT_MS
                quit
    if blockMs > 0
        bOk := (eLeftCode == wheelL.ERR_PLATFORM_BLOCKED) and (eRightCode == wheelL.ERR_PLATFORM_BLOCKED)
        eRefusal := dDrive(SIDE_BOTH, D_POWER)              ' refused with the protective code, and nothing moves
        bOk := bOk and (eRefusal == wheelL.ERR_PLATFORM_BLOCKED)
        eAfterEstopClear := dClearEstop(SIDE_BOTH)          ' the e-stop clear does NOT release a protective stop
        eLeftCode, eRightCode := dProtectiveStop()
        bOk := bOk and (eAfterEstopClear <> NO_ERROR) and (eLeftCode <> NO_ERROR) and (eRightCode <> NO_ERROR)
        eRelease := dClearProtective()
        eLeftCode, eRightCode := dProtectiveStop()
        bOk := bOk and (eRelease == NO_ERROR) and (eLeftCode == NO_ERROR) and (eRightCode == NO_ERROR)
        rawLeft1, rawRight1 := dRawTicks(SIDE_BOTH)         ' released, and still stopped until commanded
        waitBeat(D_CLEAR_STILL_MS, CP_LOOP_POLL)
        bStill := (bDBothMoved(rawLeft1, rawRight1) == FALSE)
        bOk := bOk and bStill
        dSetLimits(D_LIMIT_PEAK_DEF, D_LIMIT_CONT_DEF)      ' and the platform drives again once the limits allow it
        bDroveAgain := bDToSpeed(SIDE_BOTH)
        bOk := bOk and bDroveAgain
        dStepDone(DST_BLOCKED, SIDE_BOTH, TRUE, bOk, blockMs, 1, D_BLOCK_WAIT_MS, WHY_NONE)
    else
        dStepDone(DST_BLOCKED, SIDE_BOTH, FALSE, FALSE, 0, 1, D_BLOCK_WAIT_MS, bArmed ? WHY_NOT_BLOCKED : WHY_INST_NOACK)
    dStopMotion(SIDE_BOTH)
    bDRest(SIDE_BOTH)
    bInstIdle()
    bInstLagExempt := FALSE
    dHoldEmit()

PRI dHoldProbeReset() | slotIdx
' Clear the BLOCKED step's A-7 / A-8 probe state for both wheels.
'
' @local slotIdx - motor slot

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        hpFirstShortMs[slotIdx] := -1
        bSfHoldSetRan[slotIdx] := FALSE
        bSfHoldSetOk[slotIdx] := FALSE
        bSfNotFolRan[slotIdx] := FALSE
        bSfNotFolOk[slotIdx] := FALSE
        hpLastPermille[slotIdx] := 0
        hpLastPct[slotIdx] := 0
        bHpShortNow[slotIdx] := FALSE
        hpCmdNow[slotIdx] := 0
        hpBehindRun[slotIdx] := 0
        bHpBehindSeen[slotIdx] := FALSE

PRI dBehindPoll() | slotIdx, otherIdx, bPartnerFree
' PL-141: after both wheels' dHoldProbe() of one poll, judge whether a wheel is seen BEHIND its partner -- R20-DUAL-EV-PATH
' and R20-DUAL-PATH-HUNT's positive precondition, bDPathBehind. A wheel is seen behind when it read held (SHORT) on a
' poll whose commanded partner read NOT held, and the partner still read commanded and not held on the next poll: the
' partner free on D_BEHIND_POLLS polls running, counted from the one that saw the wheel held. Latched for the step.
'
' WHY THE PARTNER, NOT THE HELD WHEEL, MUST HOLD ACROSS TWO POLLS (SRC_REV 56). The two readings of one poll are two
' steering queries taken one after the other, not at one instant, so on one poll a partner's "not held" can predate its
' own hold by that skew -- a stall of both wheels together can read "one held, the other not" once. D_BEHIND_POLLS
' guarded that until SRC_REV 55 by asking the HELD wheel to read held on two polls running; but the fixed limiter
' releases it by scaling the partner down within a slot or two, so it is held only briefly (pass 7,
' debug_260926-175052.log: PATH_LIMIT engaged at 91 and released at 1000 exactly once, BM-HOLD LEFT first_short_ms 601,
' the right never short) and the precondition read NOMEAS on two passes. The partner's reading on the next poll is
' D_LIMIT_POLL_MS after the held reading, far longer than the skew, so a partner still commanded and free then was not
' held when the wheel was; a stall of both together makes it read held on that poll and resets the run. The mechanism
' under test does not erase this: scaling the partner down is what keeps it free.
'
' NOT the steering object's own fraction rule (Visit 10 pass 6). That rule's gap is closed by the limiter itself within
' one 8 ms slot of engaging, and it would share the rule under test.
'
' @local slotIdx - motor slot
' @local otherIdx - its partner's slot
' @local bPartnerFree - T/F where T means the partner is commanded and not held on this poll

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        otherIdx := SLOT_RIGHT - slotIdx
        bPartnerFree := (hpCmdNow[otherIdx] <> 0) and (bHpShortNow[otherIdx] == FALSE)
        if bPartnerFree and ((bHpShortNow[slotIdx] == TRUE) or (hpBehindRun[slotIdx] > 0))
            hpBehindRun[slotIdx] := (hpBehindRun[slotIdx] + 1) <# LIM_SMALL
        else
            hpBehindRun[slotIdx] := 0
        if hpBehindRun[slotIdx] >= D_BEHIND_POLLS
            bHpBehindSeen[slotIdx] := TRUE

PRI dHoldProbe(slotIdx, elapsedMs) | nCmdIncr, nDrvIncr, bShort, nPermille, nPct, bPctOk
' One BLOCKED-step poll of a wheel's path-limiter view (R18.4, DRIVE-INTEGRATION-DESIGN.md 5.5).
'
' A-7 (R18-DUAL-HOLDSET-D): from the first poll that sees the wheel SHORT, the field must settle -- by the
' first poll at least A7_SETTLE_MS later, |drv_incr| is at most A7_SETTLE_PCT of the commanded increment.
' The shipped driver held drv_incr at the command for the whole stall, so the cell fails on it. A-8's
' not-following case (R18-DUAL-NOTFOL-D) is judged on the last poll at which the wheel was SHORT: both readings
' must then say it is not following. dHoldEmit() logs the readings behind both verdicts (BM-HOLD).
'
' @param slotIdx - motor slot
' @param elapsedMs - ms since the stall's drive
'
' @local nCmdIncr - the commanded increment
' @local nDrvIncr - the field's increment now
' @local bShort - T/F where T means the wheel is short
' @local nPermille - the achieved fraction, 0-1000
' @local nPct - the rpm window's following percentage
' @local bPctOk - T/F where T means that percentage is valid

    beat(CP_LIB_STEER_QUERY)
    if slotIdx == SLOT_RIGHT
        nCmdIncr, nDrvIncr, bShort, nPermille, nPct, bPctOk := steering.testRightGetDriveFollow()
    else
        nCmdIncr, nDrvIncr, bShort, nPermille, nPct, bPctOk := steering.testLeftGetDriveFollow()
    beat(CP_LIB_STEER_QUERY)
    bHpShortNow[slotIdx] := bShort                          ' PL-141: dBehindPoll() compares the two wheels' readings
    hpCmdNow[slotIdx] := nCmdIncr
    if (bShort == TRUE) and (hpFirstShortMs[slotIdx] < 0)
        hpFirstShortMs[slotIdx] := elapsedMs
    if (hpFirstShortMs[slotIdx] >= 0) and (bSfHoldSetRan[slotIdx] == FALSE) and (elapsedMs - hpFirstShortMs[slotIdx] >= A7_SETTLE_MS)
        bSfHoldSetRan[slotIdx] := TRUE
        ' divided first: |drv_incr| x 100 overflows 32 bits at the very increment the shipped driver held,
        '  which would turn the cell's FAIL case into a pass
        bSfHoldSetOk[slotIdx] := (nCmdIncr <> 0) and (abs(nDrvIncr) <= (abs(nCmdIncr) / 100) * A7_SETTLE_PCT)
    ' A-8 not-following is judged only on a poll where the wheel IS short: Visit 8 judged a later poll of a wheel
    '  that had been short once and was following again, and failed a following wheel (evaluation F-4)
    if (bShort == TRUE) and (bPctOk == TRUE)
        hpLastPermille[slotIdx] := nPermille
        hpLastPct[slotIdx] := nPct
        bSfNotFolRan[slotIdx] := TRUE
        bSfNotFolOk[slotIdx] := (nPermille < A8_NOTFOL_PERMILLE) and (nPct < A8_NOTFOL_PCT)

PRI dHoldEmit() | slotIdx
' BM-HOLD, one per wheel after the BLOCKED step: what A-7 and A-8's not-following verdicts were judged on.
'
' @local slotIdx - motor slot

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        recBegin(@"BM-HOLD")
        benchLog.tokenField(@"motor", sideToken(SIDE_LEFT + slotIdx), TOKMAX_MOTOR)
        benchLog.naNumField(@"first_short_ms", hpFirstShortMs[slotIdx], LIM_SMALL, hpFirstShortMs[slotIdx] >= 0)
        benchLog.boolField(@"settle_ran", bSfHoldSetRan[slotIdx])
        benchLog.boolField(@"settled", bSfHoldSetOk[slotIdx])
        benchLog.naNumField(@"short_permille", hpLastPermille[slotIdx], LIM_SMALL, bSfNotFolRan[slotIdx] == TRUE)
        benchLog.naNumField(@"short_pct", hpLastPct[slotIdx], LIM_SMALL, bSfNotFolRan[slotIdx] == TRUE)
        emitRecord()

PRI dProtectiveStop() : eLeftCode, eRightCode
' Both wheels' latched protective-stop causes, without clearing them.
'
' @returns eLeftCode - the left wheel's cause, NO_ERROR when none
' @returns eRightCode - the right wheel's cause, NO_ERROR when none

    beat(CP_LIB_STEER_QUERY)
    eLeftCode, eRightCode := steering.getProtectiveStop()
    beat(CP_LIB_STEER_QUERY)

PRI dClearProtective() : eError
' Acknowledge a latched protective stop on both wheels.
'
' @returns eError - NO_ERROR once released, or the code the library returned

    beat(CP_LIB_COMMAND)
    eError := steering.clearProtectiveStop()
    beat(CP_LIB_COMMAND)

PRI dLimitRestore() | slotIdx, nPeakA, nContA
' I11: put the MOSFET current limits back and READ THEM BACK, before the segment ends and before the
' single-wheel half runs, so no later measurement is taken under a limit this segment lowered.
'
' @local slotIdx - motor slot
' @local nPeakA - the peak limit read back
' @local nContA - the continuous limit read back

    dSetLimits(D_LIMIT_PEAK_DEF, D_LIMIT_CONT_DEF)
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        nPeakA, nContA, _, _, _ := dLimitState(slotIdx)
        emitLimSt(SIDE_LEFT + slotIdx, slotIdx, DST_BLOCKED, (nPeakA * X10) + nContA)
#endif

CON { --- attended segments: OUTSIDE and FLOOR (design sec 4.4) and the operator panel (sec 8) --- }

#ifdef DBP_BRAKE
PRI outsideRun() : whyCode | tid, sid, safeEvent, bReached, rowIdx
' The OUTSIDE body after START (design sec 4.4): steering start (holdAtStop(FALSE) inside bSteerStart());
' arm on the steering source at FLOOR_DECIM; SYNC_PRECOND then driveAtPower(50, 50); both AT_SPEED (<=
' LADDER_STEADY_MS); settle SETTLE_MS; outsideBrake(); stopMotors(); both stopped; freeze; steering.stop().
' Then BM-OPER, BM-STRACE cause BRAKEHAND, BM-TS / BM-TRACE-END (drained only when the fault mark exists)
' and the BM-OUT rows. STOP is live on every screen from the spin-up on (PL-64): the spin-up and settle
' waits end on it (SAFE_OPER_STOP, why OPERATOR_STOP) and the wheels are stopped on the STOPPING screen.
'
' @returns whyCode - WHY_NONE when the brake, the untouched window and both Z steps ran, else the cause
'
' @local tid - trace id
' @local sid - the steering start's life, 0 when it did not start
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - both wheels reached AT_SPEED
' @local rowIdx - BM-OUT row

    tid := nextTraceId()
    cpReset()
    sid := 0
    outCount := 0
    bOutMarked := FALSE
    if bSteerStart(SEG_OUTSIDE) == FALSE
        cpWhy := WHY_NO_COG
        cpEnd := TEND_ABORT
    else
        sid := steerLife
        if bInstArm(INST_SRC_STEER, FLOOR_DECIM) == FALSE
            cpWhy := WHY_INST_NOACK
            cpEnd := TEND_ABORT
        elseif bSteerDriveBoth(SEG_OUTSIDE, tid, STEER_POWER_HALF) == FALSE
            cpWhy := WHY_SYNC_PRECOND
            cpEnd := TEND_ABORT
        else
            safeEvent, bReached := waitWatched(SIDE_BOTH, LADDER_STEADY_MS, CP_LOOP_ATSPEED, UNTIL_AT_SPEED)
            if (safeEvent == SAFE_NONE) and bReached
                safeEvent, _ := waitWatched(SIDE_BOTH, SETTLE_MS, CP_LOOP_SETTLE, UNTIL_TIME)
            if safeEvent <> SAFE_NONE
                cpWhy := safeWhy(safeEvent)
                cpEnd := safeEnd(safeEvent)
            elseif bReached == FALSE
                cpWhy := WHY_STEADY_TIMEOUT
                cpEnd := TEND_TIMEOUT
            else
                outsideBrake(tid)
            if bSteerUp
                panelShow(BM_SCR_STOPPING, BM_STATE_STOPPING, PNL_BTN_NONE)
                steerStopMotors()
                steerPollPhase(0, getms(), STOP_TIMEOUT_MS, TRUE, FALSE)
    bCpFrozen := bInstFreeze(0)
    if (bCpFrozen == FALSE) and (cpWhy == WHY_NONE)
        cpWhy := WHY_INST_NOACK
        cpEnd := TEND_ABORT
    steerStop()
    panelEnd(PROMPT_BRAKE_L, ANS_NONE, cpWhy)
    operFlush()
    emitSTrace(tid, SEG_OUTSIDE, CAUSE_BRAKEHAND, STEER_POWER_HALF, STEER_POWER_HALF, TRUE, 0, MODE_FLOAT, cpWhy)
    if bCpFrozen and bOutMarked
        bTraceDrain(tid, SLOT_LEFT, SLOT_RIGHT, cpEnd)
    else
        traceEmptyEnd(tid, cpEnd, (cpWhy == WHY_NONE) ? WHY_INST_NOACK : cpWhy)
    if outCount > 0
        repeat rowIdx from 0 to outCount - 1
            beat(CP_LOOP_DRAIN)
            emitOut(tid, sid, rowIdx)
    segItems := (segItems + 1) <# LIM_SMALL
    whyCode := cpWhy

PRI outsideBrake(tid) | buttonIdx, inputCode, safeEvent, markMs
' Ask for the LEFT hand-brake and wait for the instrument to see a fault (<= BRAKE_WAIT_MS, SKIP and STOP
' live, the absolute-current abort live). Folds R14-DUAL-BRAKEFLT-H: it ran when a fault or the
' absolute-current abort ended the wait, and the fault was seen when the LEFT fault flag is set. On a fault:
' mark, panel RELEASE, then outsideZSteps(). SKIP ends the step; STOP ends it too and says the operator
' stopped the wheels. An absolute-current abort shows STOPPING, since the operator is still holding the
' wheel and the harness has already stopped it. Fills cpWhy and cpEnd.
'
' @param tid - trace id
'
' @local buttonIdx - BM_BTN_SKIP or BM_BTN_STOP when the operator chose one, else PNL_BTN_NONE
' @local inputCode - INPUT_* of that choice
' @local safeEvent - SAFE_* that ended the wait
' @local markMs - getms() at the fault mark

    panelShow(BM_SCR_BRAKE_NOW, BM_STATE_BRAKE_NOW, PNL_BTN_NONE)
    operShown(PROMPT_BRAKE_L)
    buttonIdx, inputCode, safeEvent := operWait(BRAKE_WAIT_MS, SIDE_BOTH, TRUE)
    if (safeEvent == SAFE_FAULT) or (safeEvent == SAFE_ABS_ABORT)
        bSfBrakeRan := TRUE
        bSfBrakeSeen := (instLastFault[SLOT_LEFT] <> FALSE)
    if safeEvent == SAFE_FAULT
        instMark()
        markMs := getms()
        bOutMarked := TRUE
        panelShow(BM_SCR_BRAKE_RELEASE, BM_STATE_RELEASE, PNL_BTN_NONE)
        operShown(PROMPT_BRAKE_L)
        cpWhy := outsideZSteps(tid, markMs)
        cpEnd := (cpWhy == WHY_NONE) ? TEND_FROZEN : TEND_ABORT
    elseif buttonIdx == BM_BTN_SKIP
        operNote(PROMPT_BRAKE_L, OPEV_SKIP, ANS_NONE, inputCode, getms() - operShownMs, WHY_OPERATOR_SKIP)
        cpWhy := WHY_OPERATOR_SKIP
        cpEnd := TEND_ABORT
    elseif buttonIdx == BM_BTN_STOP
        operNote(PROMPT_BRAKE_L, OPEV_STOP, ANS_NONE, inputCode, getms() - operShownMs, WHY_OPERATOR_STOP)
        cpWhy := WHY_OPERATOR_STOP
        cpEnd := TEND_ABORT
    elseif safeEvent <> SAFE_NONE
        if safeEvent == SAFE_ABS_ABORT
            panelShow(BM_SCR_STOPPING, BM_STATE_STOPPING, PNL_BTN_NONE)
            operShown(PROMPT_BRAKE_L)
        cpWhy := safeWhy(safeEvent)
        cpEnd := safeEnd(safeEvent)
    else
        operNote(PROMPT_BRAKE_L, OPEV_TIMEOUT, ANS_NONE, INPUT_NONE, getms() - operShownMs, WHY_OPERATOR_TIMEOUT)
        cpWhy := WHY_OPERATOR_TIMEOUT
        cpEnd := TEND_TIMEOUT

PRI outsideZSteps(tid, markMs) : whyCode | phaseStartMs
' After the hand-brake fault (design sec 4.4 OUTSIDE): S5_UNTOUCHED_MS untouched; Z step 1, the same
' driveAtPower(50, 50) again (a request equal to the last is not a new request, sec 12.8), Z_STEP_MS; Z
' step 2, stopMotors(), both STOPPED (<= STOP_TIMEOUT_MS), driveAtPower(50, 50), Z_STEP_MS. The public API
' is polled into outBuf every OUT_POLL_MS throughout, and every drive call is preceded by the SYNC_PRECOND
' check (bSteerDriveBoth()). The operator is told before the harness drives the wheels again: the RELEASE
' screen counts the untouched window down under its own label, and the HANDS CLEAR screen is drawn before the
' first re-command. STOP stays live throughout; a STOP ends the sequence before the next drive command, even
' one chosen during a stop wait.
'
' @param tid - trace id
' @param markMs - getms() at the fault mark: the t_ms origin
' @returns whyCode - WHY_NONE when every step ran, else WHY_SYNC_PRECOND, WHY_ABORTED, WHY_INST_STALLED or
'   WHY_OPERATOR_STOP
'
' @local phaseStartMs - getms() at a step's command

    whyCode := safeWhy(steerPollPhase(markMs, markMs, S5_UNTOUCHED_MS, FALSE, TRUE))
    if whyCode == WHY_NONE
        panelShow(BM_SCR_BRAKE_ZSTEPS, BM_STATE_WHEELS_AGAIN, PNL_BTN_NONE)
        phaseStartMs := getms()
        if bSteerDriveBoth(SEG_OUTSIDE, tid, STEER_POWER_HALF)
            whyCode := safeWhy(steerPollPhase(markMs, phaseStartMs, Z_STEP_MS, FALSE, TRUE))
        else
            whyCode := WHY_SYNC_PRECOND
    if whyCode == WHY_NONE
        steerStopMotors()
        whyCode := safeWhy(steerPollPhase(markMs, getms(), STOP_TIMEOUT_MS, TRUE, TRUE))
    if whyCode == WHY_NONE
        phaseStartMs := getms()
        if bSteerDriveBoth(SEG_OUTSIDE, tid, STEER_POWER_HALF)
            whyCode := safeWhy(steerPollPhase(markMs, phaseStartMs, Z_STEP_MS, FALSE, TRUE))
        else
            whyCode := WHY_SYNC_PRECOND
#endif

#ifdef DBG_OUTPOLL
PRI steerPollPhase(markMs, phaseStartMs, durationMs, bUntilStopped, bPoll) : safeEvent | safeNow, bStopAsked
' One beat-polled steering step: every SAMPLE_MS a safety read of the instrument mirror (sec 2.8) that
' acts on the absolute-current abort and a stalled instrument, but not on a fault flag (a braked or
' faulted wheel's flag is what the step observes); when asked, one public-API row every OUT_POLL_MS since
' the mark. With the panel up, the screen's countdown and heartbeat run and a STOP is taken (PL-64). Ends
' durationMs after phaseStartMs, on a STOP, or once both wheels read DCS_STOPPED when asked. A stop wait
' does not end on a STOP -- the wheels are already stopping -- but reports it when it ends.
'
' @param markMs - getms() at the fault mark: the t_ms origin (read only when bPoll is TRUE)
' @param phaseStartMs - getms() the step's duration is measured from
' @param durationMs - the step's bound
' @param bUntilStopped - TRUE to end early once both wheels read DCS_STOPPED
' @param bPoll - TRUE to poll the public API into outBuf
' @returns safeEvent - SAFE_ABS_ABORT, SAFE_INST_STALL or SAFE_OPER_STOP when one ended or came during the
'   step, else SAFE_NONE
'
' @local safeNow - this pass's safety read
' @local bStopAsked - the operator chose STOP during the step

    safetyReset()
    safeEvent := SAFE_NONE
    bStopAsked := FALSE
    repeat
        beat(CP_LOOP_POLL)
        if bPoll and (outCount < OUT_POLLS) and ((getms() - markMs) >= (outCount * OUT_POLL_MS))
            outPoll(getms() - markMs)
#ifdef DBG_PANEL
        panelTick(phaseStartMs, durationMs)                 ' PL-152: the panel is compiled into the attended parts only
#endif
        waitms(SAMPLE_MS)
        safeNow := safetyPoll(SIDE_BOTH)
        if (safeNow == SAFE_ABS_ABORT) or (safeNow == SAFE_INST_STALL)
            safeEvent := safeNow
            quit
#ifdef DBG_PANEL
        if bPanelStopPressed()
            bStopAsked := TRUE
            if bUntilStopped == FALSE
                quit
#endif
        if bUntilStopped and bMirrorAllInState(SIDE_BOTH, DCS_STOPPED)
            quit
        if (getms() - phaseStartMs) >= durationMs
            quit
    if bStopAsked and (safeEvent == SAFE_NONE)
        safeEvent := SAFE_OPER_STOP

PRI outPoll(tMs) | rowBase
' One BM-OUT row: the public API as a user sees it -- getStatus(), testGetDriverState(),
' testGetFaultStatus() (no side effect), isTurning(), getPower() -- stored in outBuf and emitted after
' the window (design sec 3.6).
'
' @param tMs - ms since the fault mark
'
' @local rowBase - first long of the row

    rowBase := outCount * OUT_LONGS
    outBuf[rowBase + OUT_T_MS] := tMs
    beat(CP_LIB_STEER_QUERY)
    outBuf[rowBase + OUT_L_STAT], outBuf[rowBase + OUT_R_STAT] := steering.getStatus()
    outBuf[rowBase + OUT_L_ST], outBuf[rowBase + OUT_R_ST] := steering.testGetDriverState()
    outBuf[rowBase + OUT_L_FLT], outBuf[rowBase + OUT_L_SIG], outBuf[rowBase + OUT_R_FLT], outBuf[rowBase + OUT_R_SIG] := steering.testGetFaultStatus()
    outBuf[rowBase + OUT_TURNING] := steering.isTurning()
    outBuf[rowBase + OUT_L_PWR], outBuf[rowBase + OUT_R_PWR] := steering.getPower()
    ' task 3547: the public fault queries a user would call, read inside the same bracket as the rest
    '  of the row so one poll is one instant of the API
    outBuf[rowBase + OUT_FAULTED] := steering.isFaulted()
    outBuf[rowBase + OUT_ESTOP] := steering.isEmergency()
    beat(CP_LIB_STEER_QUERY)
    outCount += 1
#endif

#ifdef DBP_FLOOR
PRI floorRun() : whyCode | tid, sid, buttonIdx, inputCode, safeEvent, driveStartMs, startTotal, endTotal
' The FLOOR body after START (design sec 4.4): steering start (holdAtStop(FALSE) inside bSteerStart()); arm
' at FLOOR_DECIM; SYNC_PRECOND; mark (the trace mark and the rate window's first ring total, sec 12.7);
' driveDirection(FLOOR_POWER, FLOOR_DIRECTION); OBSERVING with STOP live for FLOOR_RUN_MS (brief
' wheels-down observation) and the absolute-current abort live; stopMotors(); both stopped; freeze; the
' rates from the frozen ring; the which-way question (floorAsk()); steering.stop(). Then BM-OPER,
' BM-STRACE cause FLOOR, BM-TS / BM-TRACE-END and BM-FLOOR.
'
' @returns whyCode - WHY_NONE when the run and the answer completed, else the first cause
'
' @local tid - trace id
' @local sid - the steering start's life, 0 when it did not start
' @local buttonIdx - BM_BTN_STOP when the operator stopped the run, else PNL_BTN_NONE
' @local inputCode - INPUT_* of the STOP
' @local safeEvent - SAFE_* that ended the run early
' @local driveStartMs - getms() at the drive call
' @local startTotal - ring total at the mark, -1 when not recorded
' @local endTotal - samples stored before the stop command, -1 when the run did not happen

    tid := nextTraceId()
    cpReset()
    sid := 0
    flRunMs := 0
    flAnswer := ANS_NONE
    flInput := INPUT_NONE
    flStopBy := STOPBY_ABORT
    flLeftPwr := 0
    flRightPwr := 0
    bFlDrove := FALSE
    startTotal := -1
    endTotal := -1
    if bSteerStart(SEG_FLOOR) == FALSE
        cpWhy := WHY_NO_COG
        cpEnd := TEND_ABORT
    else
        sid := steerLife
        if bInstArm(INST_SRC_STEER, FLOOR_DECIM) == FALSE
            cpWhy := WHY_INST_NOACK
            cpEnd := TEND_ABORT
        elseif bSteerDrivePrecondition(SEG_FLOOR, tid) == FALSE
            cpWhy := WHY_SYNC_PRECOND
            cpEnd := TEND_ABORT
        else
            startTotal := instMarkIndex()
            driveStartMs := getms()
            curIncre := 0
            beat(CP_LIB_STEER_DRIVE)
            steering.driveDirection(FLOOR_POWER, FLOOR_DIRECTION)
            beat(CP_LIB_STEER_DRIVE)
            bFlDrove := TRUE
            beat(CP_LIB_STEER_QUERY)
            flLeftPwr, flRightPwr := steering.getPower()
            beat(CP_LIB_STEER_QUERY)
            panelShow(BM_SCR_FLOOR_DRIVE, BM_STATE_OBSERVING, PNL_BTN_NONE)
            buttonIdx, inputCode, safeEvent := operWait(FLOOR_RUN_MS, SIDE_BOTH, TRUE)
            endTotal := instTotal                           ' an index, never a time (sec 12.7): the instrument's own count
            flRunMs := getms() - driveStartMs
            if bSteerUp
                panelShow(BM_SCR_STOPPING, BM_STATE_STOPPING, PNL_BTN_NONE)
                steerStopMotors()
            cpEnd := TEND_FROZEN
            if buttonIdx == BM_BTN_STOP
                flStopBy := STOPBY_OPERATOR
                operNote(PROMPT_FLOOR, OPEV_STOP, ANS_NONE, inputCode, flRunMs, WHY_NONE)
            elseif safeEvent <> SAFE_NONE
                cpWhy := safeWhy(safeEvent)
                cpEnd := safeEnd(safeEvent)
            else
                flStopBy := STOPBY_TIMER
            if bSteerUp
                steerPollPhase(0, getms(), STOP_TIMEOUT_MS, TRUE, FALSE)
    bCpFrozen := bInstFreeze(0)
    if (bCpFrozen == FALSE) and (cpWhy == WHY_NONE)
        cpWhy := WHY_INST_NOACK
        cpEnd := TEND_ABORT
    floorRates(startTotal, endTotal)
    if bFlDrove
        floorAsk()
    steerStop()
    whyCode := cpWhy
    if (whyCode == WHY_NONE) and (flAnswer == ANS_NONE)
        whyCode := WHY_OPERATOR_TIMEOUT
    panelEnd(PROMPT_FLOOR, flAnswer, whyCode)
    operFlush()
    emitSTrace(tid, SEG_FLOOR, CAUSE_FLOOR, flLeftPwr, flRightPwr, bFlDrove, FLOOR_DIRECTION, MODE_FLOAT, cpWhy)
    if bCpFrozen and bFlDrove
        bTraceDrain(tid, SLOT_LEFT, SLOT_RIGHT, cpEnd)
    else
        traceEmptyEnd(tid, cpEnd, (cpWhy == WHY_NONE) ? WHY_INST_NOACK : cpWhy)
    emitFloor(tid, sid, flRunMs, flAnswer, flInput, flLeftRateX10, flRightRateX10, bFlRates, flSlower, flStopBy, floorWhy())
    segItems := (segItems + 1) <# LIM_SMALL

PRI floorAsk() | buttonIdx, inputCode
' Ask which way the platform turned (design sec 8.3): the four answer buttons live (keys L R T N), <=
' OPER_ANSWER_TIMEOUT_MS, the absolute-current abort still live. Folds R14-DUAL-FLOORANS-F: an answer was
' recorded. Fills flAnswer and flInput.
'
' @local buttonIdx - BM_BTN_* answered, PNL_BTN_NONE on timeout
' @local inputCode - INPUT_* of the answer

    operFlush()                                             ' the instrument no longer stores: the run's notes go out now
    panelShow(BM_SCR_FLOOR_ASK, BM_STATE_ASK, PNL_BTN_NONE)
    operShown(PROMPT_FLOOR)
    buttonIdx, inputCode, _ := operWait(OPER_ANSWER_TIMEOUT_MS, SIDE_BOTH, FALSE)
    if buttonIdx <> PNL_BTN_NONE
        flAnswer := buttonAnswer(buttonIdx)
        flInput := inputCode
        bSfFloorRan := TRUE
        bSfFloorAnswered := TRUE
        operNote(PROMPT_FLOOR, OPEV_ANSWER, flAnswer, inputCode, getms() - operShownMs, WHY_NONE)
    else
        operNote(PROMPT_FLOOR, OPEV_TIMEOUT, ANS_NONE, INPUT_NONE, getms() - operShownMs, WHY_OPERATOR_TIMEOUT)

PRI floorRates(startTotal, endTotal) | startJ, endJ, spanMs
' BM-FLOOR's rates from the frozen ring, over the samples stored from the mark up to the stop command,
' located by ring index (sec 12.7). The span is samples x period x decimation, never a getct() difference.
' Both ends must have both drivers up (I3). slower is the wheel with the smaller |rate|. Legal only
' while the instrument is FROZEN (I10). Fills flLeftRateX10, flRightRateX10, bFlRates and flSlower.
'
' @param startTotal - ring total at the mark, -1 when not recorded
' @param endTotal - samples stored before the stop command, -1 when the run did not happen
'
' @local startJ - logical index of the first window sample
' @local endJ - logical index of the last window sample
' @local spanMs - the window's span, ms

    bFlRates := FALSE
    flLeftRateX10 := 0
    flRightRateX10 := 0
    flSlower := SLOWER_EQUAL
    if bCpFrozen and (startTotal >= 0) and (endTotal > startTotal)
        drainBegin()
        startJ := startTotal - drLostHead
        endJ := (endTotal - 1 - drLostHead) <# (drStored - 1)
        if (startJ >= 0) and (endJ > startJ)
            if bSmpUp(startJ, SLOT_LEFT) and bSmpUp(endJ, SLOT_LEFT) and bSmpUp(startJ, SLOT_RIGHT) and bSmpUp(endJ, SLOT_RIGHT)
                spanMs := ((endJ - startJ) * INST_PERIOD_US * instDecimate) / US_PER_MS
                if spanMs > 0
                    flLeftRateX10 := ((smpPos(endJ, SLOT_LEFT) - smpPos(startJ, SLOT_LEFT)) * RATE_X10_SCALE) / spanMs
                    flRightRateX10 := ((smpPos(endJ, SLOT_RIGHT) - smpPos(startJ, SLOT_RIGHT)) * RATE_X10_SCALE) / spanMs
                    bFlRates := TRUE
                    if abs(flLeftRateX10) < abs(flRightRateX10)
                        flSlower := SLOWER_LEFT
                    elseif abs(flRightRateX10) < abs(flLeftRateX10)
                        flSlower := SLOWER_RIGHT

PRI floorWhy() : whyCode
' BM-FLOOR's why: the cause of NA rates first, then an unanswered question (answer NONE).
'
' @returns whyCode - WHY_* value

    if bFlRates == FALSE
        whyCode := (cpWhy <> WHY_NONE) ? cpWhy : WHY_NO_SAMPLES
    elseif flAnswer == ANS_NONE
        whyCode := WHY_OPERATOR_TIMEOUT
    else
        whyCode := WHY_NONE
#endif

#ifdef DBG_PANEL
PRI buttonAnswer(buttonIdx) : answerCode
' The BM-FLOOR / BM-OPER answer of an answer button.
'
' @param buttonIdx - BM_BTN_* value
' @returns answerCode - ANS_LEFT, ANS_RIGHT, ANS_STRAIGHT, ANS_NOMOVE, or ANS_NONE for any other button

    case buttonIdx
        BM_BTN_LEFT:
            answerCode := ANS_LEFT
        BM_BTN_RIGHT:
            answerCode := ANS_RIGHT
        BM_BTN_STRAIGHT:
            answerCode := ANS_STRAIGHT
        BM_BTN_NOMOVE:
            answerCode := ANS_NOMOVE
        other:
            answerCode := ANS_NONE

PRI operStartPrompt(promptCode, scrStart, scrNext) : whyCode | buttonIdx, inputCode
' Draw an attended segment's first screen and wait for START (<= its countdown start) before anything moves
' (sec 8.3: no motion before START). No motor runs, so no safety read is owed. On START the next screen is
' drawn at once -- the spin-up screen, with STOP live -- so no instruction to click START stays on screen
' while wheels move (PL-64).
'
' @param promptCode - PROMPT_* value
' @param scrStart - BM_SCR_* asking for START
' @param scrNext - BM_SCR_* drawn once START is chosen
' @returns whyCode - WHY_NONE on START, WHY_OPERATOR_TIMEOUT otherwise
'
' @local buttonIdx - BM_BTN_START, or PNL_BTN_NONE on timeout
' @local inputCode - INPUT_* of the START

    panelShow(scrStart, scrState(scrStart), PNL_BTN_NONE)
    operShown(promptCode)
    buttonIdx, inputCode, _ := operWait(scrCdMs(scrStart), SIDE_NONE, FALSE)
    if buttonIdx == BM_BTN_START
        panelShow(scrNext, scrState(scrNext), PNL_BTN_NONE)
        operNote(promptCode, OPEV_START, ANS_NONE, inputCode, getms() - operShownMs, WHY_NONE)
        whyCode := WHY_NONE
    else
        operNote(promptCode, OPEV_TIMEOUT, ANS_NONE, INPUT_NONE, getms() - operShownMs, WHY_OPERATOR_TIMEOUT)
        whyCode := WHY_OPERATOR_TIMEOUT
    operFlush()

PRI operWait(timeoutMs, watchSide, bEndOnSafety) : buttonIdx, inputCode, safeEvent | startMs, lastInputMs, elapsedMs, safeNow
' The operator wait every attended step shares: a beat-polled loop that polls the panel input every
' OPER_POLL_MS (under PC_KEY's ~100 ms latch), keeps the screen's countdown and heartbeat running (redrawn
' only when one changes, the dirty rule, DISPLAY-PATTERNS-builders-guide.md sec 7), and ends on a live
' button, the timeout or, when asked, a safety event. The buttons it accepts are exactly the ones the screen
' on display has live (pnlLive), so a wait cannot take an input the screen does not offer. With a watched
' side the loop runs every SAMPLE_MS and reads only the instrument mirror (sec 2.8), so the
' absolute-current abort stays live whether or not the wait ends on it.
'
' @param timeoutMs - the wait's bound
' @param watchSide - SIDE_BOTH to read the safety mirror, SIDE_NONE when no motor can run
' @param bEndOnSafety - TRUE to end the wait on any safety event, a fault flag included
' @returns buttonIdx - BM_BTN_* chosen, PNL_BTN_NONE when none
' @returns inputCode - INPUT_KEY, INPUT_MOUSE or INPUT_NONE
' @returns safeEvent - SAFE_* that ended the wait, SAFE_NONE otherwise
'
' @local startMs - getms() when the wait began
' @local lastInputMs - getms() of the last input poll
' @local elapsedMs - ms since the wait began
' @local safeNow - this pass's safety read

    buttonIdx := PNL_BTN_NONE
    inputCode := INPUT_NONE
    safeEvent := SAFE_NONE
    if watchSide <> SIDE_NONE
        safetyReset()
    startMs := getms()
    lastInputMs := startMs - OPER_POLL_MS
    repeat
        beat(CP_LOOP_OPER)
        elapsedMs := getms() - startMs
        panelTick(startMs, timeoutMs)
        if watchSide <> SIDE_NONE
            safeNow := safetyPoll(watchSide)
            if bEndOnSafety and (safeNow <> SAFE_NONE)
                safeEvent := safeNow
                quit
        if (getms() - lastInputMs) >= OPER_POLL_MS
            lastInputMs := getms()
            buttonIdx, inputCode := panelReadInput(pnlLive)
            if buttonIdx <> PNL_BTN_NONE
                pnlPressed := buttonIdx
                panelRender()
                quit
        if elapsedMs >= timeoutMs
            quit
        if watchSide <> SIDE_NONE
            waitms(SAMPLE_MS)
        else
            waitms(OPER_POLL_MS)

PRI operShown(promptCode)
' Start timing a prompt the operator now sees, and note BM-OPER SHOWN.
'
' @param promptCode - PROMPT_* value

    operShownMs := getms()
    operPromptCode := promptCode
    operNote(promptCode, OPEV_SHOWN, ANS_NONE, INPUT_NONE, 0, WHY_NONE)

PRI operNote(promptCode, eventCode, answerCode, inputCode, waitedMs, whyCode) | rowBase
' Note one BM-OPER event. operFlush() emits the notes where the instrument is not storing, so no record is
' emitted inside a capture (design sec 2.6); a full queue is flushed first, so no note is ever dropped.
'
' @param promptCode - PROMPT_* value
' @param eventCode - OPEV_* value
' @param answerCode - ANS_* value
' @param inputCode - INPUT_* value
' @param waitedMs - ms since the prompt was shown
' @param whyCode - WHY_* value
'
' @local rowBase - first long of the queue row

    if operQueueCount >= OPER_QUEUE_MAX
        operFlush()
    rowBase := operQueueCount * OQ_LONGS
    operQueue[rowBase + OQ_PROMPT] := promptCode
    operQueue[rowBase + OQ_EVENT] := eventCode
    operQueue[rowBase + OQ_ANSWER] := answerCode
    operQueue[rowBase + OQ_INPUT] := inputCode
    operQueue[rowBase + OQ_WAIT] := waitedMs
    operQueue[rowBase + OQ_WHY] := whyCode
    operQueueCount += 1

PRI operFlush() | rowIdx, rowBase
' Emit every noted BM-OPER record in the order noted, then empty the queue.
'
' @local rowIdx - queue row
' @local rowBase - first long of the row

    if operQueueCount > 0
        repeat rowIdx from 0 to operQueueCount - 1
            beat(CP_LOOP_OPER)
            rowBase := rowIdx * OQ_LONGS
            emitOper(operQueue[rowBase + OQ_PROMPT], operQueue[rowBase + OQ_EVENT], operQueue[rowBase + OQ_ANSWER], operQueue[rowBase + OQ_INPUT], operQueue[rowBase + OQ_WAIT], operQueue[rowBase + OQ_WHY])
    operQueueCount := 0

PRI panelEnd(promptCode, answerCode, whyCode)
' Note BM-OPER DONE for an attended sequence whose wheels are stopped and released, and draw the LOGGING
' screen while its records are written: the heartbeat may pause there, and the screen says so. The outcome
' is drawn later, by panelFinish() on the end screen.
'
' @param promptCode - PROMPT_* value
' @param answerCode - ANS_* value
' @param whyCode - WHY_* naming why the sequence ended short, WHY_NONE when it ran through

    panelShow(BM_SCR_LOGGING, BM_STATE_LOGGING, PNL_BTN_NONE)
    operNote(promptCode, OPEV_DONE, answerCode, INPUT_NONE, getms() - operShownMs, whyCode)

PRI panelFinish(scr, stateIdx)
' Draw an end screen with its outcome and wait for START (<= its countdown start), so the operator reads the
' result before the session ends (PL-64 audit B-3). Nothing moves: every wheel is stopped and released.
'
' @param scr - BM_SCR_END or BM_SCR_UI_END
' @param stateIdx - BM_STATE_* outcome drawn

    panelShow(scr, stateIdx, PNL_BTN_NONE)
    operWait(scrCdMs(scr), SIDE_NONE, FALSE)

PRI outcomeState(whyCode) : stateIdx
' The end screen's outcome word for an attended sequence's why.
'
' @param whyCode - WHY_* naming why the sequence ended short, WHY_NONE when it ran through
' @returns stateIdx - BM_STATE_DONE, TIMED_OUT, SKIPPED, STOPPED_BY_YOU, or ENDED_EARLY for any harness-side cause

    case whyCode
        WHY_NONE:
            stateIdx := BM_STATE_DONE
        WHY_OPERATOR_TIMEOUT:
            stateIdx := BM_STATE_TIMED_OUT
        WHY_OPERATOR_SKIP:
            stateIdx := BM_STATE_SKIPPED
        WHY_OPERATOR_STOP:
            stateIdx := BM_STATE_STOPPED_BY_YOU
        other:
            stateIdx := BM_STATE_ENDED_EARLY

PRI scrState(scr) : stateIdx
' A screen's default state word, from its bmScreens row.
'
' @param scr - BM_SCR_* value
' @returns stateIdx - BM_STATE_* value

    stateIdx := long[@bmScreens][(scr * BM_SCR_LONGS) + SCR_COL_STATE]

PRI scrLive(scr) : liveMask
' A screen's buttons, drawn and live, from its bmScreens row.
'
' @param scr - BM_SCR_* value
' @returns liveMask - mask with bit BM_BTN_* set per button

    liveMask := long[@bmScreens][(scr * BM_SCR_LONGS) + SCR_COL_LIVE]

PRI scrCdKind(scr) : cdKind
' What a screen's countdown means, from its bmScreens row.
'
' @param scr - BM_SCR_* value
' @returns cdKind - BM_CD_* value, BM_CD_NONE when the screen has no countdown

    cdKind := long[@bmScreens][(scr * BM_SCR_LONGS) + SCR_COL_CDKIND]

PRI scrCdMs(scr) : cdMs
' A screen's countdown start, from its bmScreens row: the bound of the wait it is drawn for.
'
' @param scr - BM_SCR_* value
' @returns cdMs - ms, 0 when the screen has no countdown

    cdMs := long[@bmScreens][(scr * BM_SCR_LONGS) + SCR_COL_CDMS]

PRI panelTick(phaseStartMs, durationMs) | secondsLeft, bDirty
' Keep the panel alive during any wait: the countdown's whole seconds left in the wait (when the screen's
' countdown runs), and the heartbeat dot every PNL_BEAT_MS. One redraw when either changed; nothing at all
' when no panel is up, so the unattended parts pay nothing (PL-64 audit sec 6 items 4 and 6).
'
' @param phaseStartMs - getms() the wait began
' @param durationMs - the wait's bound
'
' @local secondsLeft - whole seconds left, rounded up
' @local bDirty - the frame changed

    if bPanelUp
        bDirty := FALSE
        if bPnlCountdownLive
            secondsLeft := (((durationMs - (getms() - phaseStartMs)) + (MS_PER_SEC - 1)) / MS_PER_SEC) #> 0
            if secondsLeft <> pnlSeconds
                pnlSeconds := secondsLeft
                bDirty := TRUE
        if (getms() - pnlBeatMs) >= PNL_BEAT_MS
            pnlBeatMs := getms()
            pnlHeart := (pnlHeart + 1) // PNL_HEART_CELLS
            bDirty := TRUE
        if bDirty
            panelRender()

PRI bPanelStopPressed() : bStop | buttonIdx, inputCode
' During motion, take a STOP from the panel: polled every OPER_POLL_MS, only while the screen has STOP live
' and only with a panel up. A STOP is drawn highlighted and noted as BM-OPER STOP; the caller stops the
' wheels.
'
' @returns bStop - TRUE when the operator chose STOP on this poll
'
' @local buttonIdx - BM_BTN_STOP, or PNL_BTN_NONE
' @local inputCode - INPUT_* of the STOP

    bStop := FALSE
    if bPanelUp and ((pnlLive & PNL_LIVE_STOP) <> 0) and ((getms() - pnlInputMs) >= OPER_POLL_MS)
        pnlInputMs := getms()
        buttonIdx, inputCode := panelReadInput(PNL_LIVE_STOP)
        if buttonIdx == BM_BTN_STOP
            bStop := TRUE
            pnlPressed := BM_BTN_STOP
            panelRender()
            operNote(operPromptCode, OPEV_STOP, ANS_NONE, inputCode, getms() - operShownMs, WHY_OPERATOR_STOP)

PRI panelSetup()
' Create the bmpanel window and load its eight layers, in src/test_bench_t0.spin2 t0hSetupPanel()'s form
' (crop-and-overlay, DISPLAY-PATTERNS-builders-guide.md sec 2 and 6): PLOT with HIDEXY UPDATE, one LAYER
' per BMP, CROP 1, UPDATE. SIZE 480 306 and POS 60 80 are BM_PANEL_W / BM_PANEL_H / BM_PANEL_POS_X /
' BM_PANEL_POS_Y, and the layer numbers are BM_LYR_*, written as text as t0hSetupPanel() writes its own.
' Display text arguments use single quotes. A panel that fails to draw costs a START timeout, never motion.
'
' CARTESIAN 1 (flipy) is issued right after the window opens so PC_MOUSE reports y DOWN from the top-left,
' the basis mouseButton() hit-tests in and every CROP destination here is written in. PLOT's default basis
' is origin bottom-left with y up, and the mouse coordinate honours it (p2kbSpin2Plot, hardware-verified
' EF-020): the SRC_REV 6 dual-ui run registered no click on any button without this (debug_260915-134659.log).
' The interactive switches example and the analog meter in DISPLAY-PATTERNS-builders-guide.md declare the
' same directive and then work in y-down coordinates (DERIVED from their hit-tests and needle pivot).

    pnlScreen := BM_SCR_BRAKE_START
    pnlState := BM_STATE_WAITING
    pnlDrawn := PNL_LIVE_NONE
    pnlLive := PNL_LIVE_NONE
    pnlPressed := PNL_BTN_NONE
    pnlStrip := BM_STRIP_BLANK
    pnlSeconds := PNL_NO_COUNTDOWN
    bPnlCountdownLive := FALSE
    pnlHeart := 0
    pnlBeatMs := getms()
    pnlInputMs := getms()
    bPanelKeyArmed := FALSE
    bPanelMouseArmed := FALSE
    beat(CP_PANEL)
    debug(`PLOT bmpanel TITLE 'Motion harness operator panel' SIZE 480 306 POS 60 80 HIDEXY UPDATE)
    debug(`bmpanel cartesian 1)
    debug(`bmpanel LAYER 1 'bm_bg.bmp')
    debug(`bmpanel LAYER 2 'bm_prompt.bmp')
    debug(`bmpanel LAYER 3 'bm_state.bmp')
    debug(`bmpanel LAYER 4 'bm_buttons.bmp')
    debug(`bmpanel LAYER 5 'bm_digits.bmp')
    debug(`bmpanel LAYER 6 'bm_cdlabel.bmp')
    debug(`bmpanel LAYER 7 'bm_strip.bmp')
    debug(`bmpanel LAYER 8 'bm_heart.bmp')
    debug(`bmpanel crop 1)
    debug(`bmpanel update)
    bPanelUp := TRUE
    beat(CP_PANEL)

PRI panelShow(scr, stateIdx, pressedIdx)
' Draw an attended screen as its bmScreens row defines it: its prompt, the given state word, its buttons
' drawn and live, its countdown label, a running countdown when it has one, and a blank strip. Every
' attended screen is drawn through here, so a screen cannot offer a control its row does not name.
'
' @param scr - BM_SCR_* value
' @param stateIdx - BM_STATE_* cell (scrState(scr), or an outcome or progress word)
' @param pressedIdx - BM_BTN_* drawn highlighted, PNL_BTN_NONE when none

    panelCompose(scr, stateIdx, scrLive(scr), scrLive(scr), pressedIdx, BM_STRIP_BLANK, FALSE)

PRI panelCompose(scr, stateIdx, drawnMask, liveMask, pressedIdx, stripRow, bPreview)
' Set every pnl* field of one frame and draw it. Any key or click still latched from the last screen is
' dropped, so an input is only ever taken for the screen it was made on. A preview shows the countdown's
' start and does not run it; any other screen with a countdown blanks it until its wait's first tick.
'
' @param scr - BM_SCR_* value: its prompt cell and countdown label
' @param stateIdx - BM_STATE_* cell
' @param drawnMask - mask of the buttons drawn
' @param liveMask - mask of the buttons that may be chosen (drawn too)
' @param pressedIdx - BM_BTN_* drawn highlighted, PNL_BTN_NONE when none
' @param stripRow - BM_STRIP_* row
' @param bPreview - TRUE when dual-ui previews scr: its countdown is shown static

    pnlScreen := scr
    pnlState := stateIdx
    pnlDrawn := drawnMask
    pnlLive := liveMask
    pnlPressed := pressedIdx
    pnlStrip := stripRow
    bPanelKeyArmed := FALSE
    bPanelMouseArmed := FALSE
    bPnlCountdownLive := (scrCdKind(scr) <> BM_CD_NONE) and (bPreview == FALSE)
    if (scrCdKind(scr) <> BM_CD_NONE) and bPreview
        pnlSeconds := scrCdMs(scr) / MS_PER_SEC
    else
        pnlSeconds := PNL_NO_COUNTDOWN
    panelRender()

PRI panelRender() | btnIdx, slotX, slotY, cellCol, divisor, colIdx, digitCell
' Compose one frame from the pnl* state -- the prompt cell, the state cell, every button slot (normal when
' drawn or live, highlighted when pressed, otherwise restored from the background), the countdown label and
' digits (blank when there is none, leading zeros blank), the verdict strip and the heartbeat -- then one
' UPDATE (DISPLAY-PATTERNS-builders-guide.md sec 2). In src/test_bench_t0.spin2 t0hDrawPanel()'s form.
'
' @local btnIdx - BM_BTN_* slot
' @local slotX - the slot's left edge
' @local slotY - the slot's top edge
' @local cellCol - BM_BTN_NORMAL or BM_BTN_HILITE
' @local divisor - place value of the countdown column being drawn
' @local colIdx - countdown column, most significant first
' @local digitCell - bm_digits.bmp cell: 0..9, or BM_DGT_BLANK

    beat(CP_PANEL)
    debug(`bmpanel crop 2 `(0, pnlScreen * BM_PROMPT_H, BM_PROMPT_W, BM_PROMPT_H, BM_PROMPT_X, BM_PROMPT_Y))
    debug(`bmpanel crop 3 `(0, pnlState * BM_STATE_H, BM_STATE_W, BM_STATE_H, BM_STATE_X, BM_STATE_Y))
    debug(`bmpanel crop 6 `(0, scrCdKind(pnlScreen) * BM_CD_LBL_H, BM_CD_LBL_W, BM_CD_LBL_H, BM_CD_LBL_X, BM_CD_LBL_Y))
    debug(`bmpanel crop 7 `(0, pnlStrip * BM_STRIP_H, BM_STRIP_W, BM_STRIP_H, BM_STRIP_X, BM_STRIP_Y))
    debug(`bmpanel crop 8 `(pnlHeart * BM_HEART_W, 0, BM_HEART_W, BM_HEART_H, BM_HEART_X, BM_HEART_Y))
    repeat btnIdx from 0 to BM_BTN_COUNT - 1
        slotX, slotY := buttonSlot(btnIdx)
        if (btnIdx == pnlPressed) or (((pnlDrawn | pnlLive) & (DECOD btnIdx)) <> 0)
            cellCol := (btnIdx == pnlPressed) ? BM_BTN_HILITE : BM_BTN_NORMAL
            debug(`bmpanel crop 4 `(cellCol * BM_BTN_W, btnIdx * BM_BTN_H, BM_BTN_W, BM_BTN_H, slotX, slotY))
        else
            debug(`bmpanel crop 1 `(slotX, slotY, BM_BTN_W, BM_BTN_H))
    divisor := BM_CD_TOP_DIV
    repeat colIdx from 0 to BM_CD_COUNT - 1
        digitCell := BM_DGT_BLANK
        if pnlSeconds >= 0
            if (divisor == 1) or (pnlSeconds >= divisor)
                digitCell := (pnlSeconds / divisor) // PNL_DEC_RADIX
        debug(`bmpanel crop 5 `(digitCell * BM_DGT_W, 0, BM_DGT_W, BM_DGT_H, BM_CD_X + (colIdx * BM_DGT_W), BM_CD_Y))
        divisor /= PNL_DEC_RADIX
    debug(`bmpanel update)
    beat(CP_PANEL)

PRI buttonSlot(btnIdx) : slotX, slotY
' Top-left of a button's slot: buttons 0..BM_BTN_ROW2_FIRST-1 on row 1, then row 2, and from
' BM_BTN_STRIP_FIRST the verdict strip, at a fixed pitch (tools/gen_dual_assets.py slot() draws the frames at
' the same place).
'
' @param btnIdx - BM_BTN_* value
' @returns slotX - the slot's left edge
' @returns slotY - the slot's top edge

    if btnIdx >= BM_BTN_STRIP_FIRST
        slotX := BM_STRIP_BTN_X0 + ((btnIdx - BM_BTN_STRIP_FIRST) * BM_BTN_PITCH)
        slotY := BM_STRIP_Y
    elseif btnIdx >= BM_BTN_ROW2_FIRST
        slotX := BM_BTN_COL0_X + ((btnIdx - BM_BTN_ROW2_FIRST) * BM_BTN_PITCH)
        slotY := BM_BTN_ROW2_Y
    else
        slotX := BM_BTN_COL0_X + (btnIdx * BM_BTN_PITCH)
        slotY := BM_BTN_ROW1_Y

PRI panelReadInput(liveMask) : buttonIdx, inputCode
' Poll the keyboard, then the mouse, once each (design sec 8.2). PC_KEY and PC_MOUSE each carry their own
' backtick and end their debug() statement (p2kbSpin2DbgPcKey, p2kbSpin2DbgPcMouse). A key or a click is
' taken only after a released reading (src/test_bench_t0.spin2 testT0_12()'s arming), and only for a live
' button: keys S START, K SKIP, space STOP, D DONE, L R T N the answers; a click by the button's bounding box.
' SRC_REV 69: only the attended panel parts (BRAKE, FLOOR, UICHECK) compile this; the floor tiers open no window.
'
' @param liveMask - PNL_LIVE_* mask of the buttons that may be chosen
' @returns buttonIdx - BM_BTN_* chosen, PNL_BTN_NONE when none
' @returns inputCode - INPUT_KEY, INPUT_MOUSE or INPUT_NONE

    buttonIdx := PNL_BTN_NONE
    inputCode := INPUT_NONE
    beat(CP_PANEL)
    debug(`bmpanel `pc_key(@panelKey))
    beat(CP_PANEL)
    if panelKey == 0
        bPanelKeyArmed := TRUE
    elseif bPanelKeyArmed
        bPanelKeyArmed := FALSE
        buttonIdx := keyButton(panelKey, liveMask)
        if buttonIdx <> PNL_BTN_NONE
            inputCode := INPUT_KEY
    if buttonIdx == PNL_BTN_NONE
        beat(CP_PANEL)
        debug(`bmpanel `pc_mouse(@panelMouse))
        beat(CP_PANEL)
        if panelMouse[MOUSE_LBTN] == 0
            bPanelMouseArmed := TRUE
        elseif bPanelMouseArmed
            bPanelMouseArmed := FALSE
            uiPressX := panelMouse[MOUSE_XPOS]
            uiPressY := panelMouse[MOUSE_YPOS]
            bUiPressSeen := TRUE
            buttonIdx := mouseButton(panelMouse[MOUSE_XPOS], panelMouse[MOUSE_YPOS], liveMask)
            if buttonIdx <> PNL_BTN_NONE
                inputCode := INPUT_MOUSE

PRI keyButton(keyValue, liveMask) : buttonIdx
' The live button a key names (either letter case): S START, K SKIP, space STOP, D DONE, L LEFT, R RIGHT,
' T STRAIGHT, N DID NOT MOVE, Y LOOKS RIGHT, W SOMETHING WRONG.
'
' @param keyValue - PC_KEY's reading
' @param liveMask - PNL_LIVE_* mask of the buttons that may be chosen
' @returns buttonIdx - BM_BTN_* named and live, PNL_BTN_NONE otherwise

    case keyValue
        "S", "s":
            buttonIdx := BM_BTN_START
        "K", "k":
            buttonIdx := BM_BTN_SKIP
        " ":
            buttonIdx := BM_BTN_STOP
        "D", "d":
            buttonIdx := BM_BTN_DONE
        "L", "l":
            buttonIdx := BM_BTN_LEFT
        "R", "r":
            buttonIdx := BM_BTN_RIGHT
        "T", "t":
            buttonIdx := BM_BTN_STRAIGHT
        "N", "n":
            buttonIdx := BM_BTN_NOMOVE
        "Y", "y":
            buttonIdx := BM_BTN_LOOKS_RIGHT
        "W", "w":
            buttonIdx := BM_BTN_WRONG
        other:
            buttonIdx := PNL_BTN_NONE
    if buttonIdx <> PNL_BTN_NONE
        if (liveMask & (DECOD buttonIdx)) == 0
            buttonIdx := PNL_BTN_NONE

PRI mouseButton(xPos, yPos, liveMask) : buttonIdx | btnIdx, slotX, slotY
' The live button whose slot holds the pointer; a pointer outside the window reads negative and hits none.
'
' @param xPos - PC_MOUSE x, window pixels
' @param yPos - PC_MOUSE y, window pixels
' @param liveMask - PNL_LIVE_* mask of the buttons that may be chosen
' @returns buttonIdx - BM_BTN_* under the pointer and live, PNL_BTN_NONE otherwise
'
' @local btnIdx - BM_BTN_* slot tested
' @local slotX - the slot's left edge
' @local slotY - the slot's top edge

    buttonIdx := PNL_BTN_NONE
    repeat btnIdx from 0 to BM_BTN_COUNT - 1
        slotX, slotY := buttonSlot(btnIdx)
        if ((liveMask & (DECOD btnIdx)) <> 0) and (xPos >= slotX) and (xPos < slotX + BM_BTN_W) and (yPos >= slotY) and (yPos < slotY + BM_BTN_H)
            buttonIdx := btnIdx
            quit
#endif

CON { --- TAKE: a slower command is taken while ramping, and the two following readings agree (task 3584, Visit 8) --- }

  ' DRIVE-INTEGRATION-DESIGN.md 5.5 A-6 and A-8's following case, in part A. Per motor, one lifetime:
  '  1. A-6 (R18-DUAL-TAKE-A): command HALF from rest; once the field passes QTR while still SPIN_UP,
  '     command an EIGHTH. The shipped driver threw that command away unless STOPPED, AT_SPEED or FAULTED
  '     (PL-104), so its field kept climbing to HALF -- the cell fails on it by construction.
  '     SRC_REV 59 (DRIVER_REV 38, PL-160): THE TAKE IS THE ACCELERATION'S TURN, then the increment's fall. The
  '     jerk-limited generator takes the command on its next pass, but at QTR it is accelerating at its limit
  '     (accel_up), and it unwinds that acceleration at the larger jerk before the increment can turn: the field
  '     climbs on for ceil(accel_up / RAMP_DEF_JERK_X) = 327 passes (171 ms) and only then falls. The old
  '     criterion -- the increment falls within A6_WINDOW_MS -- therefore FAILED a correct driver. The cell now
  '     needs both: drv_accel_now below its value before the command within A6_WINDOW_MS (the command TAKEN), and
  '     the increment below its own peak since the command within A6_FALL_MS (the unwind done). The NEGATIVE is
  '     unchanged: a driver that throws the command away keeps its acceleration at the limit and its field
  '     climbing, and fails both. A6_FALL_MS, DERIVED: the unwind's passes from accel_up, one pass for the take
  '     and one for the first falling pass, at DRIVE_PASS_US, rounded up, plus A6_WINDOW_MS for the command's own
  '     round trip and this loop's reads -- 329 passes, 173 ms, + 20 = 193 ms.
  '  2. A-8 following (R18-DUAL-FOLAGREE-A): command QTR, hold until AT_SPEED and the rpm window has filled,
  '     then the path limiter's achieved fraction and the rpm window's percentage must agree within FOLAGREE_HI.
  A6_WINDOW_MS          = 20                                ' the acceleration must turn this soon after the command returns
  A6_UNWIND_PASSES      = (RAMP_DEF_ACCEL_UP + RAMP_DEF_JERK_X - 1) / RAMP_DEF_JERK_X + 2
  A6_FALL_MS            = (A6_UNWIND_PASSES * wheelL.DRIVE_PASS_US + 999) / 1_000 + A6_WINDOW_MS
  ' bound on reaching QTR while spinning up to HALF: the S-curve reaches QTR (36.75 x 10^6) at about 1_322 passes, 0.7 s
  '  (A / J passes in, then (QTR - A^2 / 2J) / A at A); the stepped ramp took about 0.9 s. The bound stands.
  TAKE_RAMP_WAIT_MS     = 3_000
  TAKE_FOLLOW_HOLD_MS   = 3_000                             ' QTR's ~1 s ramp, then the 1 s rpm window filling
  FOLAGREE_LO           = 0
  FOLAGREE_HI           = 5                                 ' points: permille / 10 against pct

#ifdef DBP_A
PRI segTake() | side
' TAKE (part A, task 3584): per motor, A-6 then A-8's following case, one lifetime each.
'
' @local side - SIDE_LEFT then SIDE_RIGHT

    segBegin(SEG_TAKE)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        beat(CP_LOOP_POLL)
        takeWheel(side)
    segEnd(segWhy())

PRI takeWheel(side) | slotIdx, startMs, cmdMs, nDrvBefore, nDrvNow, nDrvPeak, nAccNow, elapsedMs, eDrvrState, nPermille, nPct, bPctOk
' One motor's TAKE lifetime (see the section's CON). Emits BM-TAKE with what was read.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
'
' @local slotIdx - motor slot
' @local startMs - getms() at the HALF command
' @local cmdMs - getms() when the EIGHTH command returned
' @local nDrvBefore - the field's increment just before the EIGHTH command
' @local nDrvNow - the field's increment while watching for the fall
' @local nDrvPeak - |the increment|'s largest since the command: the unwind's top (SRC_REV 59)
' @local nAccNow - drv_accel_now while watching for its turn
' @local elapsedMs - ms since the command returned
' @local eDrvrState - the driver state just before the EIGHTH command
' @local nPermille - the path limiter's achieved fraction at the steady QTR
' @local nPct - the rpm window's following percentage at the steady QTR
' @local bPctOk - T/F where T means that percentage is valid

    slotIdx := side - SIDE_LEFT
    nDrvBefore := 0
    eDrvrState := 0
    nPermille := 0
    nPct := 0
    bPctOk := FALSE
    if (bRunContinue(SEG_TAKE) == TRUE) and (bWheelStart(SEG_TAKE, side) == TRUE)
        ' 1. A-6: a slower command issued while SPIN_UP
        wheelCommand(side, HALF_SPEED_INCRE)
        startMs := getms()
        repeat
            beat(CP_LOOP_POLL)
            _, _, nDrvBefore := wheelDriveHealth(side)
            if (abs(nDrvBefore) >= QTR_SPEED_INCRE) or ((getms() - startMs) >= TAKE_RAMP_WAIT_MS)
                quit
        _, eDrvrState, _ := wheelClearedState(side)
        sfTakeAccBefore[slotIdx] := wheelAccelNow(side)
        wheelCommand(side, DRIVE_CEILING_INCRE / 8)
        cmdMs := getms()
        if (eDrvrState == wheelL.DCS_SPIN_UP) and (abs(nDrvBefore) >= QTR_SPEED_INCRE)
            bSfTakeRan[slotIdx] := TRUE
            ' SRC_REV 59: the acceleration turns first (A6_WINDOW_MS), the increment falls below its own peak once
            '  the unwind is done (A6_FALL_MS); both are watched in one loop, bounded by the longer
            nDrvPeak := abs(nDrvBefore)
            repeat
                _, _, nDrvNow := wheelDriveHealth(side)
                nAccNow := wheelAccelNow(side)
                elapsedMs := getms() - cmdMs
                if (bSfTakeAccFell[slotIdx] == FALSE) and (elapsedMs < A6_WINDOW_MS) and (abs(nAccNow) < abs(sfTakeAccBefore[slotIdx]) or ((nAccNow < 0) <> (sfTakeAccBefore[slotIdx] < 0)))
                    bSfTakeAccFell[slotIdx] := TRUE
                    sfTakeAccMs[slotIdx] := elapsedMs #> 1
                if abs(nDrvNow) < nDrvPeak
                    bSfTakeFell[slotIdx] := (elapsedMs < A6_FALL_MS)
                    sfTakeMs[slotIdx] := elapsedMs #> 1
                    quit
                nDrvPeak #>= abs(nDrvNow)
                if elapsedMs >= A6_FALL_MS
                    quit
            bSfTakeOk[slotIdx] := bSfTakeAccFell[slotIdx] and bSfTakeFell[slotIdx]
        ' 2. A-8 following: a steady QTR, the rpm window full
        wheelCommand(side, QTR_SPEED_INCRE)
        waitBeat(TAKE_FOLLOW_HOLD_MS, CP_LOOP_POLL)
        beat(CP_LIB_QUERY)
        if side == SIDE_RIGHT
            _, _, _, nPermille, nPct, bPctOk := wheelR.testGetDriveFollow()
        else
            _, _, _, nPermille, nPct, bPctOk := wheelL.testGetDriveFollow()
        beat(CP_LIB_QUERY)
        if bPctOk == TRUE
            bSfFolAgreeRan[slotIdx] := TRUE
            sfFolAgreeDiff[slotIdx] := abs(nPermille / 10 - nPct)
        bZeroAndWaitStopped(side)
        bInstIdle()
        wheelStop(side)
    emitTake(side, nDrvBefore, eDrvrState, nPermille, nPct, bPctOk)

PRI emitTake(side, nDrvBefore, eDrvrState, nPermille, nPct, bPctOk) | slotIdx
' BM-TAKE: one motor's TAKE readings -- A-6's precondition and fall, A-8's two following readings. SRC_REV 59 (FMT 38):
' fell is now the increment's fall below its peak within A6_FALL_MS (was: below drv_before within A6_WINDOW_MS), and
' acc_before, acc_fell, acc_ms (the acceleration's turn within A6_WINDOW_MS) and fall_hi (A6_FALL_MS) are appended
' before permille; take_ms is still the increment's fall. Worst case 217 bytes (tag 7 + seq 15 + motor 12 +
' drv_before 24 + state 11 + take_ran 15 + fell 11 + take_ms 16 + acc_before 24 + acc_fell 15 + acc_ms 15 + fall_hi 16
' + permille 17 + follow_pct 19).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param nDrvBefore - the field's increment just before the EIGHTH command
' @param eDrvrState - the driver state then (DCS_*)
' @param nPermille - the path limiter's achieved fraction at the steady QTR
' @param nPct - the rpm window's percentage there
' @param bPctOk - T/F where T means that percentage is valid
'
' @local slotIdx - motor slot

    slotIdx := side - SIDE_LEFT
    recBegin(@"BM-TAKE")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"drv_before", nDrvBefore, LIM_BIG)
    benchLog.numField(@"state", eDrvrState, LIM_TINY)
    benchLog.boolField(@"take_ran", bSfTakeRan[slotIdx])
    benchLog.boolField(@"fell", bSfTakeFell[slotIdx])
    benchLog.naNumField(@"take_ms", sfTakeMs[slotIdx], LIM_SMALL, sfTakeMs[slotIdx] > 0)
    benchLog.numField(@"acc_before", sfTakeAccBefore[slotIdx], LIM_BIG)
    benchLog.boolField(@"acc_fell", bSfTakeAccFell[slotIdx])
    benchLog.naNumField(@"acc_ms", sfTakeAccMs[slotIdx], LIM_SMALL, bSfTakeAccFell[slotIdx] == TRUE)
    benchLog.numField(@"fall_hi", A6_FALL_MS, LIM_SMALL)
    benchLog.numField(@"permille", nPermille, LIM_SMALL)
    benchLog.naNumField(@"follow_pct", nPct, LIM_SMALL, bPctOk == TRUE)
    emitRecord()
#endif

CON { --- LEAD: the live lead-step run that measures the dynamic-lead table (task 3583, R18.4) --- }

  ' DOCs/plans/DRIVE-INTEGRATION-DESIGN.md 7 C-A. At each of the driver's four lead-table speeds, per motor x
  '  sign, the motor is held at speed and the commutation pair is stepped LIVE through Z + L / Z - L -- not
  '  restarted at each value, since a per-point start was the suspect in the offset scan's half-rung
  '  torque bound. Each step is an ordinary measured rung (BM-RUNG .. BM-RUNG3, off_neg / off_pos carry the
  '  pair), and each speed ends with BM-LEADMIN: the lead of least net current and whether it is bracketed.
  LEAD_RUNGS        = 4                                     ' the driver's leadIncrTbl points: eighth, quarter, half, full
  LEAD_STEPS        = 9                                     ' 18 first (the shipped lead), then down to -7, then up to 33
  ' task 3601: the steps reach -7 because Visit 8 found the quarter's minimum at the old lowest step (3) on 3 of 4.
  '  The quarter's known answer (R18-DUAL-LEAD-KNOWN) was retired with it: its 15.8 deg was the OLD servo's, and
  '  Visit 8 showed the new servo moves the optimum by more than its band allowed (evaluation F-5).
  ' R18-DUAL-LEAD-BRKT: of each motor's 2 signs x LEAD_RUNGS speeds, at least this many bracket their minimum
  LEAD_BRKT_MIN     = 4
  LEAD_FOLLOW_PCT   = 98                                    ' a step's current counts only if it ran at >= this % of commanded

  ' LEAD rung verdict (token = the name after LEADV_):
  '  LEADV_BRACKETED - the least current is at an interior step, with both neighbours measured
  '  LEADV_EDGE      - the least current is at the first or last step, or beside an unmeasured one
  '  LEADV_NOMEAS    - no step at this speed was measured
    #0, LEADV_BRACKETED, LEADV_EDGE, LEADV_NOMEAS
    LEADV_COUNT = LEADV_NOMEAS + 1
    TOKMAX_LEADV = 9

#ifdef DBP_LEAD
DAT ' ---- LEAD tables ----

leadRungIncre   LONG    DRIVE_CEILING_INCRE / 8, DRIVE_CEILING_INCRE / 4, DRIVE_CEILING_INCRE / 2, DRIVE_CEILING_INCRE
leadStepDeg     LONG    18, 13, 8, 3, -2, -7, 23, 28, 33                    ' step order: the shipped lead first
leadAscIdx      LONG    5, 4, 3, 2, 1, 0, 6, 7, 8                           ' leadStepDeg's indices by ascending lead

VAR { LEAD tier state -- cog 0 only }

    LONG    leadInet[LEAD_STEPS]                            ' net current per step at the speed in progress, mV x10
    LONG    bLeadStepValid[LEAD_STEPS]                      ' T/F where T means that step's window was measured
    LONG    sfLeadBrkt[2]                                   ' per motor slot: speeds whose minimum was bracketed
    LONG    sfLeadN[2]                                      ' per motor slot: speeds with any measured step

PRI segLead() | side, signMul
' LEAD (part LEAD, task 3583): per motor x sign, one lifetime over the four lead-table speeds, stepping the lead live.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS

    segBegin(SEG_LEAD)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            beat(CP_LOOP_POLL)
            leadSign(side, signMul)
    segEnd(segWhy())

PRI leadSign(side, signMul) | slotIdx, rungIdx, stepIdx, motorIncre, leadDeg, rid, whyCode, safeEvent, minLeadDeg, eVerdict
' One motor x sign of the LEAD tier: at each speed, every lead step as a measured rung, then BM-LEADMIN; the
' lead schedule is turned back on at the end, whatever happened.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signMul - SIGN_NEG or SIGN_POS
'
' @local slotIdx - motor slot
' @local rungIdx - the lead-table speed, 0..LEAD_RUNGS-1
' @local stepIdx - the lead step, 0..LEAD_STEPS-1
' @local motorIncre - signed increment
' @local leadDeg - this step's lead, degrees
' @local rid - rung id
' @local whyCode - why the remaining steps are skipped, WHY_NONE while they run
' @local safeEvent - SAFE_* that ended the last step
' @local minLeadDeg - the speed's lead of least net current, degrees
' @local eVerdict - LEADV_* for the speed

    slotIdx := side - SIDE_LEFT
    whyCode := WHY_NONE
    if bRunContinue(SEG_LEAD) == FALSE
        whyCode := WHY_ABORTED
    elseif bWheelStart(SEG_LEAD, side) == FALSE
        whyCode := stWhy
    repeat rungIdx from 0 to LEAD_RUNGS - 1
        motorIncre := leadRungIncre[rungIdx] * signMul
        repeat stepIdx from 0 to LEAD_STEPS - 1
            beat(CP_LOOP_POLL)
            leadDeg := leadStepDeg[stepIdx]
            bLeadStepValid[stepIdx] := FALSE
            rid := nextRungId()
            whyCode := trialSkipWhy(SEG_LEAD, side, whyCode)
            if whyCode <> WHY_NONE
                rungSkip(SEG_LEAD, rid, rungIdx, side, motorIncre, whyCode)
            else
                ' the pair is changed while the motor runs: the command below repeats the one it is already at
                wheelSetOffsets(side, wheelL.HUB_HALL_ZERO_DEGR + leadDeg, wheelL.HUB_HALL_ZERO_DEGR - leadDeg)
                safeEvent := rungMeasure(side, motorIncre, LADDER_STEADY_MS, LADDER_SETTLE_MS, WINDOW_MS, TRUE, 1)
                rungEmitAll(SEG_LEAD, rid, rungIdx, side, motorIncre)
                ' a step counts only if the wheel FOLLOWED: at too low a lead the rotor slows, and a slower
                '  wheel draws less current for that reason alone (Visit 8b F-10: 3 deg ran at 91 % at an eighth)
                bLeadStepValid[stepIdx] := bRgWindowValid and (bLifeZeroValid[slotIdx] <> FALSE) and (safeEvent == SAFE_NONE) and (bLeadFollowed(motorIncre) == TRUE)
                leadInet[stepIdx] := rsIMeanX10 - lifeZeroX10[slotIdx]
                bRungFaultRecover(SEG_LEAD, side, motorIncre, safeEvent)          ' a torque-wall fault is recovered, and the next step runs
                if (safeEvent == SAFE_ABS_ABORT) or (safeEvent == SAFE_INST_STALL)
                    whyCode := WHY_LADDER_STOPPED
        minLeadDeg, eVerdict := leadMinimum()
        emitLeadMin(side, motorIncre, minLeadDeg, eVerdict)
        if eVerdict <> LEADV_NOMEAS
            sfLeadN[slotIdx]++
        if eVerdict == LEADV_BRACKETED
            sfLeadBrkt[slotIdx]++
    wheelSetLeadScheduled(side)                                                 ' back on, on every path
    bZeroAndWaitStopped(side)
    bInstIdle()
    wheelStop(side)

PRI bLeadFollowed(motorIncre) : bFollowed | predX10
' Whether the rung just measured ran at its commanded rate, within LEAD_FOLLOW_PCT (task 3601, Visit 8b F-10).
'
' @param motorIncre - the rung's signed increment
' @returns bFollowed - T/F where T means |rate| is at least LEAD_FOLLOW_PCT % of |predicted|
'
' @local predX10 - the predicted rate, ticks/s x 10

    predX10 := abs(predictX10(motorIncre))
    bFollowed := (predX10 > 0) and (abs(rsRateX10) * 100 >= predX10 * LEAD_FOLLOW_PCT)

PRI leadMinimum() : minLeadDeg, eVerdict | ascPos, stepIdx, minPos, bHaveMin
' The lead of least net current among this speed's measured steps, and whether it is bracketed.
'
' @returns minLeadDeg - that lead, degrees (0 when nothing was measured)
' @returns eVerdict - LEADV_BRACKETED, LEADV_EDGE or LEADV_NOMEAS
'
' @local ascPos - position in ascending-lead order
' @local stepIdx - the step at that position
' @local minPos - ascending position of the least current
' @local bHaveMin - T/F where T means a measured step has been seen

    minLeadDeg := 0
    minPos := 0
    bHaveMin := FALSE
    repeat ascPos from 0 to LEAD_STEPS - 1
        stepIdx := leadAscIdx[ascPos]
        if bLeadStepValid[stepIdx] == TRUE
            if (bHaveMin == FALSE) or (leadInet[stepIdx] < leadInet[leadAscIdx[minPos]])
                minPos := ascPos
                bHaveMin := TRUE
    eVerdict := LEADV_NOMEAS
    if bHaveMin == TRUE
        minLeadDeg := leadStepDeg[leadAscIdx[minPos]]
        eVerdict := LEADV_EDGE
        if (minPos > 0) and (minPos < LEAD_STEPS - 1)
            if (bLeadStepValid[leadAscIdx[minPos - 1]] == TRUE) and (bLeadStepValid[leadAscIdx[minPos + 1]] == TRUE)
                eVerdict := LEADV_BRACKETED

PRI emitLeadMin(side, motorIncre, minLeadDeg, eVerdict) | stepIdx, validN
' BM-LEADMIN: one speed's lead of least net current, the net current there and at the shipped 18, and the verdict.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param minLeadDeg - the lead of least net current, degrees
' @param eVerdict - LEADV_*
'
' @local stepIdx - a lead step
' @local validN - steps measured at this speed

    validN := 0
    repeat stepIdx from 0 to LEAD_STEPS - 1
        if bLeadStepValid[stepIdx] == TRUE
            validN++
    recBegin(@"BM-LEADMIN")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.naNumField(@"lead_min", minLeadDeg, LIM_TINY, eVerdict <> LEADV_NOMEAS)
    benchLog.naNumField(@"inet_min_x10", leadMinInet(), LIM_MID, eVerdict <> LEADV_NOMEAS)
    benchLog.naNumField(@"inet18_x10", leadInet[0], LIM_MID, bLeadStepValid[0] == TRUE)     ' step 0 is the shipped 18
    benchLog.numField(@"steps", validN, LIM_TINY)
    benchLog.tokenField(@"verdict", tokenAt(@tokLeadV, LEADV_COUNT, eVerdict), TOKMAX_LEADV)
    emitRecord()

PRI leadMinInet() : minInet | stepIdx, bHaveMin
' The least net current among this speed's measured steps, mV x10 (0 when none was measured).
'
' @returns minInet - that current
'
' @local stepIdx - a lead step
' @local bHaveMin - T/F where T means a measured step has been seen

    minInet := 0
    bHaveMin := FALSE
    repeat stepIdx from 0 to LEAD_STEPS - 1
        if bLeadStepValid[stepIdx] == TRUE
            if (bHaveMin == FALSE) or (leadInet[stepIdx] < minInet)
                minInet := leadInet[stepIdx]
                bHaveMin := TRUE

PRI emitLeadCells() | slotIdx
' The LEAD tier's judged cell per motor: coverage (R18-DUAL-LEAD-BRKT), NOMEAS when nothing measured it.
'
' @local slotIdx - motor slot

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        emitSignoff(@sSfCellLeadBrkt, SIDE_LEFT + slotIdx, @sSfCritLeadBrkt, sfLeadN[slotIdx] > 0, sfLeadBrkt[slotIdx], LEAD_BRKT_MIN, 2 * LEAD_RUNGS, sfLeadN[slotIdx], @sSfUnitsCount)

PRI wheelSetLeadScheduled(side)
' Turn one wheel's dynamic lead schedule back on after the LEAD tier stepped its pair by hand.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    beat(CP_LIB_OFFSETS)
    if side == SIDE_RIGHT
        wheelR.testSetLeadScheduled(TRUE)
    else
        wheelL.testSetLeadScheduled(TRUE)
    beat(CP_LIB_OFFSETS)
#endif

CON { --- LIMITS: the limits reset's experiments E1-E4 (task 3604, DOCs/plans/LIMITS-RESET-PLAN.md) --- }

  ' LIMTOP (E1; Visit 9 ran E2 as the same climb on the since-adopted duty ceiling). Per motor x sign, one lifetime climbing
  '  limTopIncre(). A rung is CLEAN when its window ran with no fault, no lag hold and a rate within
  '  LIMTOP_FOLLOW_PCT of the speed law, widened by the rung's own tick quantisation (rateBandPct()). The EDGE
  '  is the first rung that is not clean, and TOP the highest clean rung below it. The climb always runs the
  '  ladder's base rungs -- known speeds, and the per-rung comparison E2 reads -- and stops at the first
  '  unclean rung at or above DRIVE_CEILING_INCRE; the rest print SKIPPED why PAST_EDGE.
  '
  ' FOLLOWING ALONE DOES NOT FIND A USABLE TOP, and BM-TOPSPD says so with a second reading. MEASURED: on the
  '  shipped drive AND the R18.4 drive every ladder rung up to 165 x 10^6 followed at 99.8-100.3 % with zero
  '  lag holds, while duty sat at its cap from 147 x 10^6 up (debug_260922-122752.log, -161317.log). A wheel
  '  that follows with duty pinned has no torque in reserve. So BM-TOPSPD also prints the highest clean rung
  '  that never capped duty (unsat): the top the drive can still hold a speed at, which is what a load needs.
  LIMTOP_FOLLOW_PCT     = 98
  ' R18-DUAL-TOPSPD-M: each motor's worse sign must reach the published 18.5 V ceiling -- a lower top is a
  '  regression (LIMITS-RESET-PLAN.md E1). A REGRESSION GUARD, not a certification: no driver on file has
  '  failed it (both logs above follow to 165), so its negative limb is the arithmetic in limTopSign(), not a run.
  TOPSPD_LO_E6          = DRIVE_CEILING_INCRE / 1_000_000
  TOPSPD_HI_E6          = LIMTOP_MAX_INCRE / 1_000_000
  ' R18-DUAL-PWMCLIP-M: the least room any stored level left to a rail, per motor -- the high side's Y above 0,
  '  and the low side's (Y + dead_gap) below F = frame_cnt / 2 (p2kbArchSmartPin01000PwmTriangle). Negative is a
  '  clip. The judge's own negative case runs first, on synthetic levels (BM-CLIPTEST); the sampling's is the
  '  desk prediction: 1-2 counts at full duty (Visit 9 read 2 on the ceiling now the drive's; the old read 151).
  PWMCLIP_ROOM_LO       = 0
  PWMCLIP_ROOM_HI       = LIM_BIG
  CLIPTEST_FRAME        = 1_000                             ' synthetic F and dead-gap for the judge's self-test
  CLIPTEST_GAP          = 10
  ' R18-DUAL-POWERMAP-M (task 3605): the moved power table reaches the drive through the PUBLIC API. At the end of
  '  each climb, setMaxSpeed(100), then driveAtPower(+-100) and driveAtPower(+-1); the increment the driver holds
  '  (testGetDriveFollow()'s commanded side) must equal LIB_MAX_FWD_INCRE / LIB_MIN_FWD_INCRE exactly. The
  '  NEGATIVE CASE is the table this replaced: 147_000_000 and 544_628 fail it by construction. maxSpeed is read
  '  first and put back after.
  POWERCHK_HOLD_MS      = 3_000                             ' the ramp from wherever the climb ended, and the settle
  ' R18-DUAL-FOLLOW-M / R18-DUAL-FOLFALL-M (task 3597): the DRIVER's own following reading -- testGetDriveFollow()'s
  '  rpm-window percentage -- judged against the HARNESS's rate over the same second. Moved here from the scan's
  '  R18-SCAN-FOLLOW, whose negative limb could never fire (PL-98 (3)).
  ' A CROSS-CHECK, NOT A RESTATEMENT. The harness counts ticks in its own window against the speed law
  '  (predictX10()); the driver sums its rpm window against a rate it derives from the live command. Different
  '  numerators and denominators, so agreement is evidence, and a wrong derivation misses by a factor, not by points.
  ' ONE CRITERION, TWO POPULATIONS, AND THE HARNESS PICKS THE POPULATION: letting the reading under test pick its
  '  own limb would let a stuck reading choose the limb it passes. Both cells judge the gap |driver - harness| less
  '  the window's own tick quantisation (rateBandPct()) against FOLLOW_GAP_PTS:
  '   FOLLOW  - readings the harness says FOLLOWED (>= LIMTOP_FOLLOW_PCT): every clean LIMTOP rung;
  '   FOLFALL - readings the harness says did NOT (< FOLLOW_SHORT_PCT): the over-command step after each climb
  '  A reading stuck at 100 fails FOLFALL by the whole shortfall; one stuck low fails FOLLOW. A reading between the
  '  two thresholds feeds neither, and a driver window that had not filled feeds neither (its number is a transient
  '  and would read as a fall for the wrong reason). NOMEAS, never PASS, when a population is empty.
  ' THE OVER-COMMAND STEP BUILDS THE NEGATIVE CASE ON PURPOSE (P10), and its current limit is what makes it
  '  certain. An over-command ALONE is not enough: MEASURED at Visit 9, three of four wheel-directions follow
  '  LIMTOP_MAX_INCRE by field weakening, drawing 2.3-4.2 A, and the fourth fell short only by slipping, with a
  '  ~25 A single peak (PL-108) -- a negative case stumbled into, not built. So the step lowers the motor's current
  '  limits to OVERCMD_LIMIT_A first. Field weakening needs current, the limit caps it, and the drive must fall back
  '  to a speed it holds at that current -- about 185-195 x 10^6 on the Visit 9 figures, 76-80 % of the command --
  '  while targetIncre stays at the command. The driver's window fills at a real shortfall, bounded by the drive's
  '  own limiter, far from the scan's current wall where every scan droop was cut short. The limits are restored
  '  and read back before anything else runs but the step's own study trace (BM-OCLIM, I11; the trace drains first, so the wheel
  '  is still held at OVERCMD_LIMIT_A while it does). The harness still decides the population.
  ' SRC_REV 81 (PL-189, HOLD-SPEED-UNDER-LOAD-DESIGN.md sec 4.12.7, S-b): at DRIVER_REV 49 a wheel held at its current limit is
  '  held by the fold-back hold, and while it is, drv_incr (the printed drv_incr and the permille the path limiter reads) is not the
  '  field's speed. The over-command step IS that situation, so its BM-FOLLOW reading (kind OVER) prints why FIELD_NOT_SPEED. It still
  '  FOLDS into FOLLOW / FOLFALL: the cells compare the driver's rpm window (d_pct) with the harness's (h_pct), both measured rotor
  '  rates that S-b does not touch (the second visit's three OVER readings: h_pct 3-4, d_pct 3-4, gap 0). What the over-command
  '  newly certifies is R22-DUAL-OVRSTEP-M below.
  ' R22-DUAL-OVRSTEP-M (new, SRC_REV 81; PL-189's I-12): the over-command is followed by limPowerCheck()'s full-power step, where the
  '  restored limits meet whatever field the hold kept. After each over-command whose full-power step was reached, that step's window
  '  (POWERCHK_HOLD_MS + WINDOW_MS) ends on NO safety event: BM-POWER's why NONE, and no BM-ABORT (the 10 A absolute-current abort),
  '  fault, instrument stall or operator stop in it. BOOL per motor, ANDed over the signs reached; n is the steps reached. NEGATIVE, on
  '  disk (DOCs/analyses/bench/2026-10-02b/debug_261002-142002.log): LEFT reverse -- BM-OCLIM seq 160, BM-ABORT seq 161 ABS_CURRENT 1_445
  '  mV, BM-POWER seq 162 why ABORTED -- FAIL; LEFT forward BM-POWER seq 271 why NONE; RIGHT never reached its step (the log ends after
  '  seq 379), so RIGHT reads NOMEAS with n 0. RIVAL EXPLANATION for a FAIL: the abort was the platform's, not the step's (a wheel
  '  already running away before the limits came back): BM-FOLLOW kind OVER is printed only when the over-command's own window ended
  '  with no safety event (seq 159 was), so a step that aborts after one is the restore's, which is the claim.
  FOLLOW_SHORT_PCT      = 90
  FOLLOW_GAP_PTS        = 5
  OVERCMD_HOLD_MS       = 3_000                             ' the field settles at the rotor's rate, and the 1 s window refills
  OVERCMD_LIMIT_A       = 1                                 ' peak and continuous, amps: testSetCurrentLimits()'s least

  ' BM-FOLLOW kind (token = the name after FOLK_):
  '  FOLK_RUNG - a LIMTOP rung, read at its window's end with its command still standing
  '  FOLK_OVER - the over-command step after a climb
    #0, FOLK_RUNG, FOLK_OVER
    FOLK_COUNT = FOLK_OVER + 1
    TOKMAX_FOLK = 4

  ' LIMTOP's STUDY TRACES (SRC_REV 79, PL-187: why the wheels labour above 175 x 10^6). Two per climb, each a BM-TRACE, its BM-TS
  '  lines and a BM-TRACE-END (seg LIMTOP), drained by limTrace() from the capture the rung or step already took:
  '   cause EDGE    - the climb's first not-clean rung (BM-TOPSPD's edge): the capture from just before its command, so the approach
  '                   from the last clean rung, the whole AT_SPEED wait it fails (LADDER_STEADY_MS, 6 s) and, when it reached speed,
  '                   its settle and window. It is the capture rungMeasure() took at decimation 1 (2 ms; 3_010 samples for a rung
  '                   that times out), drained before the rung's recovery re-arms the ring
  '   cause OVERCMD - the over-command step: armed before LIMTOP_MAX_INCRE is commanded at OVERCMD_LIMIT_A, frozen when the window
  '                   closes, so the whole OVERCMD_HOLD_MS + WINDOW_MS (about 4 s, 2_030 samples) while the field falls back
  '  The ring holds INST_RING_SAMPLES = 4_096 samples, 8.19 s at 2 ms; the longest rung capture (a window reached at the bound,
  '  6 + 0.5 + 1 s) is about 3_780 samples, inside TRACE_MAX_SAMPLES. The log cannot carry 2 ms throughout (400 lines of up to
  '  308 bytes is the cap): the first dense lines after k = 0 are every sample (100 once the fit shrinks the dense window from
  '  TRACE_DENSE_SAMPLES), the last LIMTRACE_TAIL_SAMPLES are every sample, and between them the stride grows (bTraceDrain()) up to
  '  LIMTRACE_STRIDE_MAX: 16 samples (32 ms) for either trace at its usual length. Each BM-TS carries i, ph, u, v, w, d (duty), e
  '  (err) and the hall pos; the PWM levels are NOT per sample (the ring's sample is full): BM-CLIP's room is the capture's least.
  '  k = 0 is the first stored sample, a few ms before the command (bTrWhole: the rung's window marks are not the event). The wheel
  '  is still driven while a study trace drains, so its safety is read by traceWatchPoll(). The traces are not counted into
  '  R14-DUAL-TRACES-M, whose population stays LIMRAMP's (limTrace() restores the counts bTraceDrain() folds).
    LIMTRACE_TAIL_SAMPLES = 100                               ' 0.2 s at 2 ms
    LIMTRACE_STRIDE_MAX   = 32

  ' LIMRAMP (E3). Per motor x sign, one lifetime: a START trace from rest to QTR at each speed-up limit, then a SLOWER
  '  trace from the ceiling to QTR at each slow-down limit, each followed by BM-RAMP; the defaults are restored and
  '  read back at the end (BM-RAMPREST, I11). Duty drop and peak ratio are read from the trace by
  '  DOCs/plans/servo-model/start_metrics.py, the code that judged A-1 / A-2 at Visit 8. SRC_REV 59 (DRIVER_REV 38): the
  '  ramp is the jerk-limited generator's, whose only settings are its two limits (its jerks follow them over
  '  RAMP_TAU_MS), so the traces step those: the built-in limit, twice and four times it speeding up, the built-in
  '  and twice it slowing down. (They stepped ramp_inc 22 / 44 / 88 and ramp_down 50_000 / 100_000, and ramp_inc no
  '  longer does anything.)
  LIMRAMP_UPS           = 3                                 ' RAMP_DEF_ACCEL_MM_S2 x 1, 2, 4 (1_000, 2_000, 4_000 mm/s^2)
  LIMRAMP_DOWNS         = 2                                 ' RAMP_DEF_DECEL_MM_S2 x 1, 2 (1_470, 2_940 mm/s^2)

  ' LIMLOW (E4). Per motor x sign, one lifetime: four rungs from the old floor down, then the same four with
  '  duty_min halved (read back, and restored and read back after). The window is as long as the ring's
  '  timebase allows: a getct() difference wraps past 2^31 ticks, 7.9 s at 270 MHz, and windowStats() times
  '  the window by one. At 250_000 that holds about 5 hall edges and at 100_000 about 2 -- enough to say
  '  whether a rung rotates, and how evenly, not to measure its rate finely.
  LIMLOW_RUNGS          = 4                                 ' 544_628 (the old floor), 400_000, 250_000, 100_000
  LIMLOW_VARIANTS       = 2                                 ' duty_min as built, then halved
  LIMLOW_WINDOW_MS      = 7_500
  LIMLOW_DECIM          = 3                                 ' 6 ms samples: the ring holds 24.6 s
  LIMLOW_DUTY_DIV       = 2

  ' BM-TOPSPD edge cause (token = the name after EDGE_):
  '  EDGE_NONE    - every rung in the table was clean; there is no edge below LIMTOP_MAX_INCRE
  '  EDGE_FAULT   - the rung faulted
  '  EDGE_HOLD    - the lag limiter held the field inside the window
  '  EDGE_SLOW    - the window's rate fell below LIMTOP_FOLLOW_PCT of the speed law
  '  EDGE_NOWIN   - the rung measured no window (a timeout, an abort or a lost capture)
    #0, EDGE_NONE, EDGE_FAULT, EDGE_HOLD, EDGE_SLOW, EDGE_NOWIN
    EDGE_COUNT = EDGE_NOWIN + 1
    TOKMAX_EDGE = 5

#ifdef DBP_LIMITS
DAT ' ---- LIMITS tables ----

limRampUps      LONG    RAMP_DEF_ACCEL_MM_S2, RAMP_DEF_ACCEL_MM_S2 * 2, RAMP_DEF_ACCEL_MM_S2 * 4    ' mm/s^2 (SRC_REV 61)
limRampDowns    LONG    RAMP_DEF_DECEL_MM_S2, RAMP_DEF_DECEL_MM_S2 * 2
limLowIncre     LONG    544_628, 400_000, 250_000, 100_000                  ' the old confgurePowerLimits() floor, then below it (Visit 9 moved the floor to 100_000)
tokEdge         BYTE    "NONE", 0, "FAULT", 0, "HOLD", 0, "SLOW", 0, "NOWIN", 0, TOK_END
tokFolK         BYTE    "RUNG", 0, "OVER", 0, TOK_END

VAR { LIMITS state -- cog 0 only; index = motor slot }

    LONG    sfTopMinE6[INST_MOTORS]                         ' TOPSPD: the lower of the two signs' tops, x 10^-6
    LONG    sfTopN[INST_MOTORS]                             ' TOPSPD: signs whose climb measured a top
    LONG    sfClipRoomMin[INST_MOTORS]                      ' PWMCLIP: least room to a rail over the motor's rungs
    LONG    sfClipN[INST_MOTORS]                            ' PWMCLIP: rungs whose capture folded any level
    LONG    bSfClipTestOk                                   ' PWMCLIP: the judge passed its own negative case
    LONG    sfPowerN[INST_MOTORS]                           ' POWERMAP: power commands read back
    LONG    bSfPowerBad[INST_MOTORS]                        ' POWERMAP: any one did not hold exactly the table's increment
    ' followRead()'s staging: the driver's view as a window closed (task 3597), read by followFold() and BM-POWER
    LONG    folCmdIncr
    LONG    folDrvIncr
    LONG    bFolShort
    LONG    folPermille
    LONG    folPct
    LONG    bFolOk
    LONG    sfFolGapWorst[INST_MOTORS]                      ' FOLLOW: worst unexplained gap among following readings, points
    LONG    sfFolN[INST_MOTORS]                             ' FOLLOW: readings judged
    LONG    sfFallGapWorst[INST_MOTORS]                     ' FOLFALL: worst unexplained gap among not-following readings, points
    LONG    sfFallN[INST_MOTORS]                            ' FOLFALL: readings judged
    LONG    sfOvrN[INST_MOTORS]                             ' OVRSTEP (SRC_REV 81): over-command full-power steps reached
    LONG    bSfOvrBad[INST_MOTORS]                          ' ...any of them ended on a safety event (BM-ABORT, a fault, a stalled instrument, a stop)
    LONG    bOvrReached                                     ' the sign in progress: its over-command's full-power step was reached (limTopSign() clears it)
    LONG    ovrSafeEvent                                    ' ...and the SAFE_* its full-power window ended on

PRI segLimTop() | side, signMul
' LIMTOP (part LIMITS, E1 / E2): the judge's self-test, then per motor x sign one climb to the edge.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS

    segBegin(SEG_LIMTOP)
    clipSelfTest()
    repeat side from SIDE_LEFT to SIDE_RIGHT
        sfTopMinE6[side - SIDE_LEFT] := LIM_BIG
        sfClipRoomMin[side - SIDE_LEFT] := LIM_BIG
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            beat(CP_LOOP_POLL)
            limTopSign(side, signMul)
    segEnd(segWhy())

PRI limTopSign(side, signMul) | slotIdx, rungIdx, motorIncre, rid, whyCode, safeEvent, topIncre, unsatIncre, edgeIncre, edgeCode, consecFaults, traceEvent
' One motor x sign of LIMTOP: every rung a measured rung plus BM-CLIP, the edge found as the section's CON says and its capture
' drained as a study trace (SRC_REV 79), then BM-TOPSPD.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signMul - SIGN_NEG or SIGN_POS
'
' @local slotIdx - motor slot
' @local rungIdx - 0..LIMTOP_RUNGS-1
' @local motorIncre - signed increment
' @local rid - rung id
' @local whyCode - why the remaining rungs are skipped, WHY_NONE while they run
' @local safeEvent - SAFE_* that ended the last rung
' @local topIncre - the highest clean rung below the edge, 0 while none
' @local unsatIncre - the highest clean rung below the edge that never capped duty, 0 while none
' @local edgeIncre - the first unclean rung, 0 while none
' @local edgeCode - EDGE_* naming why that rung was not clean
' @local consecFaults - consecutive faulted rungs, as the ladder counts them
' @local traceEvent - SAFE_* the edge trace's drain read from the wheel, still driven

    slotIdx := side - SIDE_LEFT
    topIncre := 0
    unsatIncre := 0
    edgeIncre := 0
    edgeCode := EDGE_NONE
    consecFaults := 0
    whyCode := WHY_NONE
    if bRunContinue(SEG_LIMTOP) == FALSE
        whyCode := WHY_ABORTED
    elseif bWheelStart(SEG_LIMTOP, side) == FALSE
        whyCode := stWhy
    repeat rungIdx from 0 to LIMTOP_RUNGS - 1
        beat(CP_LOOP_POLL)
        motorIncre := limTopIncre(rungIdx) * signMul
        rid := nextRungId()
        whyCode := trialSkipWhy(SEG_LIMTOP, side, whyCode)
        if whyCode <> WHY_NONE
            rungSkip(SEG_LIMTOP, rid, rungIdx, side, motorIncre, whyCode)
        else
            safeEvent := rungMeasure(side, motorIncre, LADDER_STEADY_MS, LADDER_SETTLE_MS, WINDOW_MS, TRUE, 1)
            followRead(side)                                ' as the window closes, before any record is printed
            rungEmitAll(SEG_LIMTOP, rid, rungIdx, side, motorIncre)
            limClipRung(rid, side, motorIncre)
            if (safeEvent == SAFE_NONE) and bRgWindowValid and (rsTicks <> 0)
                followFold(rid, side, motorIncre, FOLK_RUNG, rsTicks, rsRateX10)
            if edgeIncre == 0
                edgeCode := limEdgeCode(motorIncre, safeEvent)
                if edgeCode == EDGE_NONE
                    topIncre := abs(motorIncre)
                    if rgHlWinCap == 0
                        unsatIncre := abs(motorIncre)
                else
                    edgeIncre := abs(motorIncre)
                    traceEvent := limTrace(side, CAUSE_EDGE, motorIncre, bRgCaptured, safeEvent)    ' the frozen capture, before the recovery re-arms the ring (I10)
                    if safeEvent == SAFE_NONE
                        safeEvent := traceEvent
            if bRungFaultRecover(SEG_LIMTOP, side, motorIncre, safeEvent)
                consecFaults += 1
                if consecFaults >= LADDER_FAULT_STOP
                    whyCode := WHY_LADDER_STOPPED
            else
                consecFaults := 0
            if (safeEvent == SAFE_ABS_ABORT) or (safeEvent == SAFE_INST_STALL)
                whyCode := WHY_LADDER_STOPPED
            elseif (edgeIncre <> 0) and (abs(motorIncre) >= DRIVE_CEILING_INCRE)
                whyCode := WHY_PAST_EDGE                    ' found above the ceiling: nothing past it is clean by definition
    bOvrReached := FALSE
    ovrSafeEvent := SAFE_NONE
    if (whyCode == WHY_NONE) or (whyCode == WHY_PAST_EDGE)
        overCommandStep(side, signMul)
        limPowerCheck(side, signMul)
    emitOvrStep(side, signMul)
    bZeroAndWaitStopped(side)
    bInstIdle()
    wheelStop(side)
    if topIncre > 0
        sfTopMinE6[slotIdx] <#= topIncre / 1_000_000
        sfTopN[slotIdx] := (sfTopN[slotIdx] + 1) <# LIM_TINY
    emitTopSpd(side, signMul, topIncre, unsatIncre, edgeIncre, edgeCode)

PRI limTopIncre(rungIdx) : motorIncre
' The unsigned increment of LIMTOP's rung: the ladder's twelve speeds, then LIMTOP_STEP_INCRE apart above them.
'
' @param rungIdx - 0..LIMTOP_RUNGS-1
' @returns motorIncre - the rung's increment

    if rungIdx < LADDER_RUNGS
        motorIncre := ladderIncre[rungIdx]
    else
        motorIncre := LADDER_MAX_INCRE + (rungIdx - LADDER_RUNGS + 1) * LIMTOP_STEP_INCRE

PRI limEdgeCode(motorIncre, safeEvent) : edgeCode | predX10, ratioPct
' Judge the rung just measured: EDGE_NONE when it is clean, else why it is not (the section's CON).
'
' @param motorIncre - the rung's signed increment
' @param safeEvent - SAFE_* that ended the rung
' @returns edgeCode - EDGE_NONE, EDGE_FAULT, EDGE_HOLD, EDGE_SLOW or EDGE_NOWIN
'
' @local predX10 - the speed law's rate, ticks/s x 10
' @local ratioPct - the window's rate as a percentage of it

    predX10 := abs(predictX10(motorIncre))
    if safeEvent == SAFE_FAULT
        edgeCode := EDGE_FAULT
    elseif (safeEvent <> SAFE_NONE) or (bRgWindowValid == FALSE) or (bRgHlWinValid == FALSE) or (predX10 == 0) or (rsTicks == 0)
        edgeCode := EDGE_NOWIN
    elseif rgHlWinLag <> 0
        edgeCode := EDGE_HOLD
    else
        ratioPct := (abs(rsRateX10) * 100) / predX10
        edgeCode := (ratioPct >= (LIMTOP_FOLLOW_PCT - rateBandPct(rsTicks))) ? EDGE_NONE : EDGE_SLOW

PRI clipRoom(lvlMin, lvlMax, frameHalf, deadGap) : nRoom
' The least room the levels left to a rail, PWM counts; negative is a clip (R18-DUAL-PWMCLIP-M).
'
' @param lvlMin - the least high-side level
' @param lvlMax - the greatest high-side level
' @param frameHalf - F, the PWM's Y range (frame_cnt / 2)
' @param deadGap - dead_gap, added to the high side's level to make the low side's
' @returns nRoom - lvlMin's room above 0, or the low side's below F, whichever is less

    nRoom := lvlMin <# (frameHalf - (lvlMax + deadGap))

PRI clipSelfTest() | roomOk, roomHigh, roomLow
' BM-CLIPTEST: the PWMCLIP judge's own negative case, on synthetic levels before anything moves. A level set that
' just touches both rails must read 0 room (PASS), and one count past either rail must read negative (FAIL). A
' judge that fails this cannot certify a clip-free build, so PWMCLIP is NOMEAS unless it passes.
'
' @local roomOk - room of levels touching both rails exactly
' @local roomHigh - room with the low side one count past F
' @local roomLow - room with the high side one count below 0

    roomOk := clipRoom(0, CLIPTEST_FRAME - CLIPTEST_GAP, CLIPTEST_FRAME, CLIPTEST_GAP)
    roomHigh := clipRoom(0, CLIPTEST_FRAME - CLIPTEST_GAP + 1, CLIPTEST_FRAME, CLIPTEST_GAP)
    roomLow := clipRoom(-1, CLIPTEST_FRAME - CLIPTEST_GAP, CLIPTEST_FRAME, CLIPTEST_GAP)
    bSfClipTestOk := (roomOk == 0) and (roomHigh < 0) and (roomLow < 0)
    recBegin(@"BM-CLIPTEST")
    benchLog.numField(@"room_ok", roomOk, LIM_SMALL)
    benchLog.numField(@"room_high", roomHigh, LIM_SMALL)
    benchLog.numField(@"room_low", roomLow, LIM_SMALL)
    benchLog.boolField(@"judge_ok", bSfClipTestOk)
    emitRecord()

PRI limClipRung(rid, side, motorIncre) | slotIdx, lvlMin, lvlMax, lvlN, nRoom, bValid
' BM-CLIP for the rung just measured, from the instrument's per-capture fold of the driver's levels, and its fold
' into R18-DUAL-PWMCLIP-M. Read only from a frozen capture (I10). The drive constants are the rung's own,
' staged by rungMeasure(): dead_gap is in system ticks, one PWM count each, and the Y range is frame_cnt / 2.
'
' @param rid - rung id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
'
' @local slotIdx - motor slot
' @local lvlMin - the least high-side level the capture stored
' @local lvlMax - the greatest
' @local lvlN - samples folded
' @local nRoom - the least room to a rail
' @local bValid - T/F where T means the capture was frozen and folded at least one level

    slotIdx := side - SIDE_LEFT
    lvlMin := instLvlMin[slotIdx]
    lvlMax := instLvlMax[slotIdx]
    lvlN := instLvlN[slotIdx]
    bValid := bRgCaptured and (lvlN > 0)
    nRoom := 0
    if bValid
        nRoom := clipRoom(lvlMin, lvlMax, rgFrameCnt / 2, rgDeadGap)
        sfClipRoomMin[slotIdx] <#= nRoom
        sfClipN[slotIdx] := (sfClipN[slotIdx] + 1) <# LIM_BIG
    recBegin(@"BM-CLIP")
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"duty_max", rgDutyMax, LIM_BIG)
    benchLog.numField(@"frame_half", rgFrameCnt / 2, LIM_MID)
    benchLog.numField(@"dead_gap", rgDeadGap, LIM_SMALL)
    benchLog.naNumField(@"lvl_min", lvlMin, LIM_MID, bValid)
    benchLog.naNumField(@"lvl_max", lvlMax, LIM_MID, bValid)
    benchLog.naNumField(@"room", nRoom, LIM_MID, bValid)
    benchLog.numField(@"n", lvlN, LIM_BIG)
    emitRecord()

PRI emitTopSpd(side, signMul, topIncre, unsatIncre, edgeIncre, edgeCode)
' BM-TOPSPD: one motor x sign's climb -- the plan's top, the top that never capped duty, and the edge.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signMul - SIGN_NEG or SIGN_POS
' @param topIncre - the highest clean rung below the edge (0 when none)
' @param unsatIncre - the highest clean rung below the edge that never capped duty (0 when none)
' @param edgeIncre - the first unclean rung (0 when every rung was clean)
' @param edgeCode - EDGE_*

    recBegin(@"BM-TOPSPD")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"sign", signMul, LIM_TINY)
    benchLog.naNumField(@"top", topIncre, LIM_BIG, topIncre > 0)
    benchLog.naNumField(@"unsat", unsatIncre, LIM_BIG, unsatIncre > 0)
    benchLog.naNumField(@"edge", edgeIncre, LIM_BIG, edgeIncre > 0)
    benchLog.tokenField(@"edge_why", tokenAt(@tokEdge, EDGE_COUNT, edgeCode), TOKMAX_EDGE)
    benchLog.numField(@"follow_pct", LIMTOP_FOLLOW_PCT, LIM_TINY)
    emitRecord()

PRI limTrace(side, causeCode, motorIncre, bFrozen, endEvent) : safeEvent | slotIdx, tid, offNeg, offPos, endCode, whyCode, tracesWas, lostWas
' One LIMTOP study trace (the section's CON): the frozen ring as BM-TRACE, BM-TS and BM-TRACE-END, drained while the wheel is still
' driven, so its safety is read throughout (traceWatchPoll(), safeEvent) and the wheel is neither stopped nor re-commanded here. The
' header names what was done (I7), never the outcome, and its why is NONE unless no capture exists. An unfrozen capture is never
' drained (I10): its end is empty, why INST_NOACK. At most TRACE_EMIT_MAX BM-TS lines, the last sample always one; should the stride
' cap be reached with more lines wanted, the cap cuts the middle and the tail short of the last sample. The drain's counts are
' put back: R14-DUAL-TRACES-M stays LIMRAMP's.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param causeCode - CAUSE_EDGE or CAUSE_OVERCMD
' @param motorIncre - the command standing, signed
' @param bFrozen - T/F where T means the capture was frozen and may be drained
' @param endEvent - SAFE_* that ended the capture, SAFE_NONE when the harness ended it
' @returns safeEvent - SAFE_* the drain's reads of the wheel returned, SAFE_NONE when none
'
' @local slotIdx - motor slot
' @local tid - trace id
' @local offNeg - offset_fwd read back
' @local offPos - offset_rev read back
' @local endCode - TEND_* the end names: the safety event's, else FROZEN (the capture ends with the wheel running)
' @local whyCode - NONE, or INST_NOACK when there is no capture
' @local tracesWas - sfTraces before the drain
' @local lostWas - sfTraceLost before the drain

    slotIdx := side - SIDE_LEFT
    safeEvent := SAFE_NONE
    tid := nextTraceId()
    offNeg, offPos := wheelGetOffsets(side)
    endCode := TEND_FROZEN
    if endEvent <> SAFE_NONE
        endCode := safeEnd(endEvent)
    whyCode := WHY_NONE
    if bFrozen == FALSE
        whyCode := WHY_INST_NOACK
    emitTrace(tid, SEG_LIMTOP, side, causeCode, motorIncre, offNeg, offPos, MODE_FLOAT, wheelAccelUp(side), whyCode)
    if bFrozen
        tracesWas := sfTraces
        lostWas := sfTraceLost
        safetyReset()
        trWatchEvent := SAFE_NONE
        trWatch := side
        bTrWhole := TRUE
        trTail := LIMTRACE_TAIL_SAMPLES
        trStrideCap := LIMTRACE_STRIDE_MAX
        bTraceDrain(tid, slotIdx, SLOT_RIGHT - slotIdx, endCode)
        trWatch := SIDE_NONE
        safeEvent := trWatchEvent
        sfTraces := tracesWas
        sfTraceLost := lostWas
    else
        traceEmptyEnd(tid, endCode, whyCode)

PRI holdThenWindow(side, holdMs) : safeEvent, nTicks, nMs | startTicks, startMs
' Hold the command standing for holdMs, then count the wheel's hall ticks over a WINDOW_MS window, watched for
' safety throughout, and take the driver's following reading at the window's end (followRead()). A safety event
' in the hold skips the window, leaving nTicks and nMs 0.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param holdMs - the hold before the window, ms
' @returns safeEvent - SAFE_* that ended the hold or the window, SAFE_NONE otherwise
' @returns nTicks - ticks moved across the window, signed
' @returns nMs - the window's length, ms
'
' @local startTicks - the hall position at the window's start
' @local startMs - getms() there

    nTicks := 0
    nMs := 0
    safeEvent, _ := waitWatched(side, holdMs, CP_LOOP_SETTLE, UNTIL_TIME)
    if safeEvent == SAFE_NONE
        startTicks := wheelRawTicks(side)
        startMs := getms()
        safeEvent, _ := waitWatched(side, WINDOW_MS, CP_LOOP_WINDOW, UNTIL_TIME)
        nTicks := wheelRawTicks(side) - startTicks
        nMs := getms() - startMs
    followRead(side)

PRI followRead(side)
' Stage the driver's view of the command standing (testGetDriveFollow()) for followFold() and BM-POWER, read the
' moment a window closes so the driver's own 1 s window covers the harness's, not the records printed after it.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    folCmdIncr, folDrvIncr, bFolShort, folPermille, folPct, bFolOk := wheelDriveFollow(side)

PRI overCommandStep(side, signMul) | motorIncre, safeEvent, nTicks, nMs, peakWas, contWas, bArmed, bFrozen, traceEvent
' The FOLFALL population's step (task 3597): lower the current limits to OVERCMD_LIMIT_A, command
' LIMTOP_MAX_INCRE, hold while the field falls back to what the rotor holds at that current and the driver's window
' refills, then a WINDOW_MS tick count and the driver's reading at its end, the command still standing. The limits
' are put back and read back on every path; a fault is recovered, and the step is then not judged. SRC_REV 79 (PL-187): the
' instrument is armed just before the command and frozen as the window closes, and that capture is drained as a study trace
' (cause OVERCMD, the section's CON) while the current limits are still lowered -- the wheel is driven throughout the drain --
' and before they are put back.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signMul - SIGN_NEG or SIGN_POS
'
' @local motorIncre - the over-command, signed
' @local safeEvent - SAFE_* from the watched waits, else the trace drain's
' @local nTicks - ticks moved across the window
' @local nMs - the window's length, ms
' @local peakWas - the peak limit before the step, amps
' @local contWas - the continuous limit before the step, amps
' @local bArmed - T/F where T means the instrument armed for the step's capture
' @local bFrozen - T/F where T means that capture was frozen and may be drained
' @local traceEvent - SAFE_* the trace's drain read from the wheel

    motorIncre := LIMTOP_MAX_INCRE * signMul
    peakWas, contWas := wheelLimits(side)
    wheelSetLimits(side, OVERCMD_LIMIT_A, OVERCMD_LIMIT_A)
    bArmed := bInstArm(INST_SRC_WHEELS, 1)
    wheelCommand(side, motorIncre)
    safeEvent, nTicks, nMs := holdThenWindow(side, OVERCMD_HOLD_MS)
    bFrozen := FALSE
    if bArmed
        bFrozen := bInstFreeze(0)
    if (safeEvent == SAFE_NONE) and (nMs > 0) and (nTicks <> 0)
        followFold(nextRungId(), side, motorIncre, FOLK_OVER, nTicks, (nTicks * RATE_X10_SCALE) / nMs)
    traceEvent := limTrace(side, CAUSE_OVERCMD, motorIncre, bFrozen, safeEvent)
    if safeEvent == SAFE_NONE
        safeEvent := traceEvent
    wheelSetLimits(side, peakWas, contWas)
    emitOverCmdLimits(side, peakWas, contWas)
    bRungFaultRecover(SEG_LIMTOP, side, motorIncre, safeEvent)

PRI emitOverCmdLimits(side, peakWant, contWant) | nPeakA, nContA
' BM-OCLIM: the current limits read back after the over-command step put them back (I11).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param peakWant - the peak limit restored, amps
' @param contWant - the continuous limit restored, amps
'
' @local nPeakA - the peak limit read back
' @local nContA - the continuous limit read back

    nPeakA, nContA := wheelLimits(side)
    recBegin(@"BM-OCLIM")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"set_a", OVERCMD_LIMIT_A, LIM_TINY)
    benchLog.numField(@"peak_a", nPeakA, LIM_TINY)
    benchLog.numField(@"cont_a", nContA, LIM_TINY)
    benchLog.boolField(@"restored", (nPeakA == peakWant) and (nContA == contWant))
    emitRecord()

PRI followFold(rid, side, motorIncre, eKind, nTicks, rateX10) | slotIdx, predX10, harnessPct, nBand, nGap, whyCode
' BM-FOLLOW for one reading, and its fold into R18-DUAL-FOLLOW-M or R18-DUAL-FOLFALL-M by the HARNESS's own verdict
' (the section's CON). The driver's side is followRead()'s staging, taken as the harness's window closed. SRC_REV 81 (PL-189,
' S-b): a FOLK_OVER reading's why says FIELD_NOT_SPEED -- the wheel is held at OVERCMD_LIMIT_A there, so the printed drv_incr
' and permille are not the field's speed. It still FOLDS: the cells compare the driver's rpm window (d_pct) with the harness's
' (h_pct), both measured rotor rates that S-b does not touch (the second visit's three OVER readings: gap 0).
'
' @param rid - rung id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - the command standing, signed
' @param eKind - FOLK_RUNG or FOLK_OVER
' @param nTicks - ticks in the harness's window, signed and non-zero
' @param rateX10 - the harness's rate over it, ticks/s x 10, signed
'
' @local slotIdx - motor slot
' @local predX10 - the speed law's rate for the command, x10
' @local harnessPct - the harness's rate as a percentage of it
' @local nBand - the harness window's tick quantisation, percent
' @local nGap - |driver - harness| less nBand, floored at 0
' @local whyCode - WHY_NONE when the reading was folded where it qualified, FIELD_NOT_SPEED for an over-command reading

    slotIdx := side - SIDE_LEFT
    predX10 := abs(predictX10(motorIncre))
    harnessPct := 0
    if predX10 > 0
        harnessPct := (abs(rateX10) * 100) / predX10
    nBand := rateBandPct(nTicks)
    nGap := (abs(folPct - harnessPct) - nBand) #> 0
    whyCode := WHY_NONE
    if eKind == FOLK_OVER
        whyCode := WHY_FIELD_NOT_SPEED                  ' the printed drv_incr / permille only: the rpm windows still compare
    if (bFolOk == TRUE) and (predX10 > 0)
        if harnessPct >= LIMTOP_FOLLOW_PCT
            sfFolGapWorst[slotIdx] #>= nGap
            sfFolN[slotIdx] := (sfFolN[slotIdx] + 1) <# LIM_BIG
        elseif harnessPct < FOLLOW_SHORT_PCT
            sfFallGapWorst[slotIdx] #>= nGap
            sfFallN[slotIdx] := (sfFallN[slotIdx] + 1) <# LIM_BIG
    recBegin(@"BM-FOLLOW")
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"kind", tokenAt(@tokFolK, FOLK_COUNT, eKind), TOKMAX_FOLK)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"drv_incr", folDrvIncr, LIM_BIG)
    benchLog.numField(@"h_pct", harnessPct, LIM_SMALL)
    benchLog.naNumField(@"d_pct", folPct, LIM_SMALL, bFolOk == TRUE)
    benchLog.numField(@"band", nBand, LIM_TINY)
    benchLog.naNumField(@"gap", nGap, LIM_SMALL, bFolOk == TRUE)
    benchLog.numField(@"permille", folPermille, LIM_SMALL)
    benchLog.boolField(@"short", bFolShort)
    benchLog.tokenField(@"why", tokenAt(@tokWhy, WHY_COUNT, whyCode), TOKMAX_WHY)
    emitRecord()

PRI emitOvrStep(side, signMul)
' BM-OVRSTEP (SRC_REV 81, PL-189): one sign's over-command and the full-power step that follows it -- whether the step was reached
' (limPowerCheck() ran it) and its why: NONE when its window ran to its end with no safety event, ABORTED for the absolute-current
' abort (the BM-ABORT it follows), FAULTED, INST_STALLED or OPERATOR_STOP for the others, NOT_REACHED when the climb ended before
' the over-command. R18-DUAL-OVRSTEP-M's n is the steps reached. Worst case 84 bytes: tag 10 + seq 15 + motor 12 + sign 10 +
' reached 14 + why 23 (each field is 2 + its name + its width).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signMul - SIGN_NEG or SIGN_POS

    recBegin(@"BM-OVRSTEP")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"sign", signMul, LIM_TINY)
    benchLog.boolField(@"reached", bOvrReached)
    if bOvrReached
        benchLog.tokenField(@"why", tokenAt(@tokWhy, WHY_COUNT, safeWhy(ovrSafeEvent)), TOKMAX_WHY)
    else
        benchLog.tokenField(@"why", tokenAt(@tokWhy, WHY_COUNT, WHY_NOT_REACHED), TOKMAX_WHY)
    emitRecord()

PRI limPowerCheck(side, signMul) | speedWas, checkIdx, nPower, nExpect, safeEvent, nTicks, nMs, bHeld
' R18-DUAL-POWERMAP-M (task 3605): full and least power through the public API, each read back against the moved
' table, with BM-POWER per command; maxSpeed is restored to what it was. The driver holds the mapped increment
' the moment driveAtPower() returns, so the verdict needs no wait: full power is held and windowed only so BM-POWER
' can say whether the wheel follows at the new top, and least power (under one hall edge a second) is read at once.
' SRC_REV 81 (PL-189): the full-power command is also OVRSTEP's step -- it follows the over-command, so the restored current
' limits meet a field the hold left behind -- and its window ending on any safety event stages bOvrReached / ovrSafeEvent and folds
' sfOvrN / bSfOvrBad.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signMul - SIGN_NEG or SIGN_POS
'
' @local speedWas - maxSpeed before the check
' @local checkIdx - 0 full power, 1 least power
' @local nPower - the signed power commanded
' @local nExpect - the increment the table maps it to
' @local safeEvent - SAFE_* from the watched waits
' @local nTicks - ticks moved across the window (0 when none ran)
' @local nMs - the window's length, ms (0 when none ran)
' @local bHeld - T/F where T means the driver holds exactly nExpect

    speedWas := wheelMaxSpeed(side)
    wheelSetMaxSpeed(side, POWER_FULL)
    repeat checkIdx from 0 to 1
        nPower := lookupz(checkIdx: POWER_FULL, POWER_MIN) * signMul
        nExpect := lookupz(checkIdx: LIB_MAX_FWD_INCRE, LIB_MIN_FWD_INCRE) * signMul
        wheelDriveAtPower(side, nPower)
        if checkIdx == 0
            safeEvent, nTicks, nMs := holdThenWindow(side, POWERCHK_HOLD_MS)
        else
            safeEvent := SAFE_NONE
            nTicks := 0
            nMs := 0
            followRead(side)
        bHeld := (folCmdIncr == nExpect)
        sfPowerN[side - SIDE_LEFT] := (sfPowerN[side - SIDE_LEFT] + 1) <# LIM_SMALL
        bSfPowerBad[side - SIDE_LEFT] |= (bHeld == FALSE)
        if checkIdx == 0                                    ' SRC_REV 81 (PL-189), OVRSTEP: the full-power step after the over-command
            bOvrReached := TRUE
            ovrSafeEvent := safeEvent
            sfOvrN[side - SIDE_LEFT] := (sfOvrN[side - SIDE_LEFT] + 1) <# LIM_SMALL
            bSfOvrBad[side - SIDE_LEFT] |= (safeEvent <> SAFE_NONE)
        emitPower(side, nPower, nExpect, bHeld, nTicks, nMs, safeEvent)
        bRungFaultRecover(SEG_LIMTOP, side, nExpect, safeEvent)
    wheelSetMaxSpeed(side, speedWas)

PRI emitPower(side, nPower, nExpect, bHeld, nTicks, nMs, safeEvent) | predX10, bRate, nPct
' BM-POWER: one power command read back -- the table's increment, what the driver holds (followRead()'s staging),
' the field then, and the rate over the window as a percentage of the speed law's (NA when no window ran).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param nPower - the signed power commanded
' @param nExpect - the table's increment for it
' @param bHeld - T/F where T means the driver holds exactly nExpect
' @param nTicks - ticks across the window
' @param nMs - the window's length, ms
' @param safeEvent - SAFE_* that ended the command's hold or window
'
' @local predX10 - the speed law's rate for nExpect, x10
' @local bRate - T/F where T means a window ran and the rate is printed
' @local nPct - the window's rate as a percentage of the speed law's, 0 when none ran

    predX10 := abs(predictX10(nExpect))
    bRate := (safeEvent == SAFE_NONE) and (nMs > 0) and (predX10 > 0)
    nPct := 0
    if bRate
        nPct := ((abs(nTicks) * RATE_X10_SCALE) / nMs) * 100 / predX10
    recBegin(@"BM-POWER")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"power", nPower, LIM_TINY)
    benchLog.numField(@"expect", nExpect, LIM_BIG)
    benchLog.numField(@"cmd_incr", folCmdIncr, LIM_BIG)
    benchLog.numField(@"drv_incr", folDrvIncr, LIM_BIG)
    benchLog.boolField(@"held", bHeld)
    benchLog.numField(@"ticks", nTicks, LIM_MID)
    benchLog.naNumField(@"follow_pct", nPct, LIM_SMALL, bRate)
    benchLog.tokenField(@"why", tokenAt(@tokWhy, WHY_COUNT, safeWhy(safeEvent)), TOKMAX_WHY)
    emitRecord()

PRI segLimRamp() | side, signMul
' LIMRAMP (part LIMITS, E3): per motor x sign, one lifetime of ramp traces (the section's CON).
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS

    segBegin(SEG_LIMRAMP)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            beat(CP_LOOP_POLL)
            limRampSign(side, signMul)
    segEnd(segWhy())

PRI limRampSign(side, signMul) | settingIdx, whyCode, qtrIncre
' One motor x sign of LIMRAMP: the START traces at each speed-up limit, the SLOWER traces at each slow-down limit, each
' with BM-RAMP; then the defaults restored and read back, on every path.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signMul - SIGN_NEG or SIGN_POS
'
' @local settingIdx - the ramp setting in progress
' @local whyCode - why the remaining trials are skipped, WHY_NONE while they run
' @local qtrIncre - the quarter, signed: every trace's target

    qtrIncre := QTR_SPEED_INCRE * signMul
    whyCode := WHY_NONE
    if bRunContinue(SEG_LIMRAMP) == FALSE
        whyCode := WHY_ABORTED
    elseif bWheelStart(SEG_LIMRAMP, side) == FALSE
        whyCode := stWhy
    repeat settingIdx from 0 to LIMRAMP_UPS - 1
        whyCode := limRampTrial(side, limRampUps[settingIdx], RAMP_DEF_DECEL_MM_S2, CAUSE_START, 0, qtrIncre, whyCode)
    repeat settingIdx from 0 to LIMRAMP_DOWNS - 1
        whyCode := limRampTrial(side, RAMP_DEF_ACCEL_MM_S2, limRampDowns[settingIdx], CAUSE_SLOWER, DRIVE_CEILING_INCRE * signMul, qtrIncre, whyCode)
    if isWheelUp(side)
        bRestoreRamp(side)
    bInstIdle()
    wheelStop(side)

PRI limRampTrial(side, upWant, downWant, causeCode, fromIncre, toIncre, skipWhy) : whyCode | upBack, downBack
' One LIMRAMP trace and its BM-RAMP: set the ramp, then a START from rest to toIncre (fromIncre 0) or a SLOWER
' from fromIncre to toIncre. A skipped trial prints its why and no ramp settings of its own.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param upWant - the speed-up rate for the trial, mm/s^2 (SRC_REV 61; its limit accel_up is read back)
' @param downWant - the slow-down rate for the trial, mm/s^2 (its limit accel_dn is read back)
' @param causeCode - CAUSE_START or CAUSE_SLOWER
' @param fromIncre - the speed a SLOWER starts from (0 for a START)
' @param toIncre - the speed commanded at the mark
' @param skipWhy - WHY_* already known, WHY_NONE when none
' @returns whyCode - why this and the remaining trials are skipped, WHY_NONE while they run
'
' @local upBack - accel_up read back, 0 when the trial was skipped
' @local downBack - accel_dn read back, 0 when the trial was skipped

    beat(CP_LOOP_POLL)
    upBack := 0
    downBack := 0
    whyCode := trialSkipWhy(SEG_LIMRAMP, side, skipWhy)
    if whyCode == WHY_NONE
        upBack, downBack := wheelSetRamp(side, upWant, downWant)
    if causeCode == CAUSE_SLOWER
        cpSlowTo := toIncre
        eventTrace(SEG_LIMRAMP, side, fromIncre, CAUSE_SLOWER, EVT_SLOWER, MODE_FLOAT, whyCode)
    else
        eventTrace(SEG_LIMRAMP, side, toIncre, CAUSE_START, EVT_START, MODE_FLOAT, whyCode)
    emitRampRec(side, causeCode, fromIncre, toIncre, upBack, downBack, whyCode)

PRI emitRampRec(side, causeCode, fromIncre, toIncre, upBack, downBack, skipWhy) | bFollowed
' BM-RAMP: the trace just taken's ramp -- its settings read back, mark to AT_SPEED, and the lag holds across it.
' followed is TRUE only when AT_SPEED was reached with no hold: the ramp never ran ahead of what the rotor could
' follow (LIMITS-RESET-PLAN.md E3's third criterion). The trace's own tid is the run's latest.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param causeCode - CAUSE_START or CAUSE_SLOWER
' @param fromIncre - the speed the ramp started from (0 for a START)
' @param toIncre - the speed it was commanded to
' @param upBack - accel_up read back
' @param downBack - accel_dn read back
' @param skipWhy - WHY_NONE when the trace ran, else why it was skipped (its staging is then empty)
'
' @local bFollowed - T/F where T means AT_SPEED was reached with no lag hold

    if skipWhy == WHY_NONE
        skipWhy := cpWhy
    bFollowed := bCpRampReached and bCpRampLagValid and (cpRampLag == 0) and (skipWhy == WHY_NONE)
    recBegin(@"BM-RAMP")
    benchLog.numField(@"tid", traceSeq, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"cause", tokenAt(@tokCause, CAUSE_COUNT, causeCode), TOKMAX_CAUSE)
    benchLog.numField(@"from_incre", fromIncre, LIM_BIG)
    benchLog.numField(@"to_incre", toIncre, LIM_BIG)
    benchLog.numField(@"accel_up", upBack, LIM_BIG)                          ' SRC_REV 59 (FMT 38): was ramp_inc
    benchLog.numField(@"accel_dn", downBack, LIM_BIG)                        ' ...and ramp_down
    benchLog.boolField(@"reached", bCpRampReached)
    benchLog.naNumField(@"ramp_ms", cpRampMs, LIM_MID, bCpRampReached)
    benchLog.naNumField(@"lag_holds", cpRampLag, LIM_BIG, bCpRampLagValid)
    benchLog.boolField(@"followed", bFollowed)
    benchLog.tokenField(@"why", tokenAt(@tokWhy, WHY_COUNT, skipWhy), TOKMAX_WHY)
    emitRecord()

PRI segLimLow() | side, signMul
' LIMLOW (part LIMITS, E4): per motor x sign, one lifetime of low rungs, as built and with duty_min halved.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS

    segBegin(SEG_LIMLOW)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            beat(CP_LOOP_POLL)
            limLowSign(side, signMul)
    segEnd(segWhy())

PRI limLowSign(side, signMul) | variantIdx, rungIdx, motorIncre, rid, whyCode, safeEvent, consecFaults, dutyMinBuilt
' One motor x sign of LIMLOW: the four rungs descending, with duty_min as built and then halved; duty_min is put
' back and read back on every path that wrote it, and BM-LOWDUTY records each write.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signMul - SIGN_NEG or SIGN_POS
'
' @local variantIdx - 0 as built, 1 halved
' @local rungIdx - 0..LIMLOW_RUNGS-1
' @local motorIncre - signed increment
' @local rid - rung id
' @local whyCode - why the remaining rungs are skipped, WHY_NONE while they run
' @local safeEvent - SAFE_* that ended the last rung
' @local consecFaults - consecutive faulted rungs, as the ladder counts them
' @local dutyMinBuilt - duty_min as init() derived it, 0 until the lifetime started

    consecFaults := 0
    dutyMinBuilt := 0
    whyCode := WHY_NONE
    if bRunContinue(SEG_LIMLOW) == FALSE
        whyCode := WHY_ABORTED
    elseif bWheelStart(SEG_LIMLOW, side) == FALSE
        whyCode := stWhy
    else
        _, _, _, _, dutyMinBuilt := wheelDriveConstants(side)
    repeat variantIdx from 0 to LIMLOW_VARIANTS - 1
        if (variantIdx > 0) and (whyCode == WHY_NONE)
            wheelSetDutyMin(side, dutyMinBuilt / LIMLOW_DUTY_DIV)
        repeat rungIdx from 0 to LIMLOW_RUNGS - 1
            beat(CP_LOOP_POLL)
            motorIncre := limLowIncre[rungIdx] * signMul
            rid := nextRungId()
            whyCode := trialSkipWhy(SEG_LIMLOW, side, whyCode)
            if whyCode <> WHY_NONE
                rungSkip(SEG_LIMLOW, rid, rungIdx, side, motorIncre, whyCode)
            else
                safeEvent := lowRung(SEG_LIMLOW, side, rid, rungIdx, motorIncre, LIMLOW_WINDOW_MS, LIMLOW_DECIM)
                if bRungFaultRecover(SEG_LIMLOW, side, motorIncre, safeEvent)
                    consecFaults += 1
                    if consecFaults >= LADDER_FAULT_STOP
                        whyCode := WHY_LADDER_STOPPED
                else
                    consecFaults := 0
                if (safeEvent == SAFE_ABS_ABORT) or (safeEvent == SAFE_INST_STALL)
                    whyCode := WHY_LADDER_STOPPED
    if (dutyMinBuilt > 0) and isWheelUp(side)                   ' restored on every path that wrote it (I11)
        wheelSetDutyMin(side, dutyMinBuilt)
    bZeroAndWaitStopped(side)
    bInstIdle()
    wheelStop(side)

PRI wheelSetDutyMin(side, dutyWant) | dutyBack
' Write one wheel's duty_min (testSetDutyMin()), read it back, and print BM-LOWDUTY: the write and whether it held.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param dutyWant - duty_min, 1/16ths
'
' @local dutyBack - duty_min read back

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        wheelR.testSetDutyMin(dutyWant)
    else
        wheelL.testSetDutyMin(dutyWant)
    beat(CP_LIB_QUERY)
    _, _, _, _, dutyBack := wheelDriveConstants(side)
    recBegin(@"BM-LOWDUTY")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"duty_min", dutyWant, LIM_MID)
    benchLog.numField(@"read_back", dutyBack, LIM_MID)
    benchLog.boolField(@"ok", dutyWant == dutyBack)
    emitRecord()

PRI emitLimitsCells() | slotIdx
' The LIMITS part's judged cells: TRACES over LIMRAMP's traces, and per motor TOPSPD, PWMCLIP, POWERMAP, FOLLOW, FOLFALL and
' (SRC_REV 81) OVRSTEP. Each prints NOMEAS when nothing measured it -- the top-only build takes no trace, PWMCLIP needs its judge's
' self-test, and OVRSTEP needs an over-command whose full-power step was reached.
'
' @local slotIdx - motor slot

    emitSignoff(@sSfCellTracesM, SIDE_NONE, @sSfCritTraces, sfTraces > 0, sfTraceLost, TRACE_LOST_LO, TRACE_LOST_HI, sfTraces, @sSfUnitsCount)
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        emitSignoff(@sSfCellTopSpd, SIDE_LEFT + slotIdx, @sSfCritTopSpd, sfTopN[slotIdx] > 0, sfTopMinE6[slotIdx], TOPSPD_LO_E6, TOPSPD_HI_E6, sfTopN[slotIdx], @sSfUnitsE6)
        emitSignoff(@sSfCellPwmClip, SIDE_LEFT + slotIdx, @sSfCritPwmClip, bSfClipTestOk and (sfClipN[slotIdx] > 0), sfClipRoomMin[slotIdx], PWMCLIP_ROOM_LO, PWMCLIP_ROOM_HI, sfClipN[slotIdx], @sSfUnitsPwm)
        emitSignoffBool(@sSfCellPowerMap, SIDE_LEFT + slotIdx, @sSfCritPowerMap, sfPowerN[slotIdx] > 0, bSfPowerBad[slotIdx] == FALSE, sfPowerN[slotIdx])
        emitSignoff(@sSfCellFollowM, SIDE_LEFT + slotIdx, @sSfCritFolGap, sfFolN[slotIdx] > 0, sfFolGapWorst[slotIdx], 0, FOLLOW_GAP_PTS, sfFolN[slotIdx], @sSfUnitsPct)
        emitSignoff(@sSfCellFolFall, SIDE_LEFT + slotIdx, @sSfCritFolGap, sfFallN[slotIdx] > 0, sfFallGapWorst[slotIdx], 0, FOLLOW_GAP_PTS, sfFallN[slotIdx], @sSfUnitsPct)
        ' SRC_REV 81 (PL-189): OVRSTEP -- every over-command's full-power step that was reached ran to its window with no safety event
        emitSignoffBool(@sSfCellOvrStep, SIDE_LEFT + slotIdx, @sSfCritOvrStep, sfOvrN[slotIdx] > 0, bSfOvrBad[slotIdx] == FALSE, sfOvrN[slotIdx])


PRI wheelMaxSpeed(side) : nSpeed
' One wheel's maxSpeed (getMaxSpeed()), the clamp driveAtPower() applies.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns nSpeed - maxSpeed, percent

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        nSpeed := wheelR.getMaxSpeed()
    else
        nSpeed := wheelL.getMaxSpeed()
    beat(CP_LIB_QUERY)

PRI wheelSetMaxSpeed(side, nSpeed)
' setMaxSpeed() on one wheel.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param nSpeed - maxSpeed, percent

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        wheelR.setMaxSpeed(nSpeed)
    else
        wheelL.setMaxSpeed(nSpeed)
    beat(CP_LIB_QUERY)

PRI wheelDriveAtPower(side, nPower)
' driveAtPower() on one wheel: the public command, through the power table.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param nPower - power, -100 to 100

    curIncre := 0                                           ' a power command's increment is the table's, not this wrapper's (as dDrive())
    beat(CP_LIB_COMMAND)
    if side == SIDE_RIGHT
        wheelR.driveAtPower(nPower)
    else
        wheelL.driveAtPower(nPower)
    beat(CP_LIB_COMMAND)

PRI wheelDriveFollow(side) : nCmdIncr, nDrvIncr, bShort, nPermille, nPct, bPctOk
' The path limiter's view of one wheel beside the driver's rpm-window percentage (testGetDriveFollow()).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns nCmdIncr - the increment last commanded
' @returns nDrvIncr - the field's increment now
' @returns bShort - T/F where T means the lag limiter held the field recently
' @returns nPermille - the field's rate as a fraction of the commanded, 0-1000
' @returns nPct - the rpm window's measured rate as a percentage of commanded
' @returns bPctOk - T/F where T means that window has filled

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        nCmdIncr, nDrvIncr, bShort, nPermille, nPct, bPctOk := wheelR.testGetDriveFollow()
    else
        nCmdIncr, nDrvIncr, bShort, nPermille, nPct, bPctOk := wheelL.testGetDriveFollow()
    beat(CP_LIB_QUERY)

PRI wheelLimits(side) : nPeakA, nContA
' One wheel's current limits in force (testGetCurrentLimitState()).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns nPeakA - the peak phase-current limit, amps
' @returns nContA - the continuous limit, amps

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        nPeakA, nContA, _, _, _ := wheelR.testGetCurrentLimitState()
    else
        nPeakA, nContA, _, _, _ := wheelL.testGetCurrentLimitState()
    beat(CP_LIB_QUERY)

PRI wheelSetLimits(side, peakAmps, contAmps)
' One wheel's current limits (testSetCurrentLimits()); every caller restores them and reads them back.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param peakAmps - the peak limit, amps
' @param contAmps - the continuous limit, amps

    beat(CP_LIB_COMMAND)
    if side == SIDE_RIGHT
        wheelR.testSetCurrentLimits(peakAmps, contAmps)
    else
        wheelL.testSetCurrentLimits(peakAmps, contAmps)
    beat(CP_LIB_COMMAND)

PRI wheelRawTicks(side) : nTicks
' One wheel's raw hall position (getRawHallTicks()).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns nTicks - hall ticks since the driver started

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        nTicks := wheelR.getRawHallTicks()
    else
        nTicks := wheelL.getRawHallTicks()
    beat(CP_LIB_QUERY)
#endif

CON { --- FAULTRESP: the fault study's X-cells, faults forced at speed (task 3613, R19.7) --- }

  ' WHAT THIS PART IS FOR. Visit 10 sizes what R19.3 exposes and certifies the responses before any becomes the
  '  default (P5). The cells are DOCs/analyses/FAULT-STRATA-STUDY-2026-09-23.md sec 7's X-2 .. X-6, each judged
  '  against the reading pre-registered for it, restated where it is judged. EVERY TRIAL IS ITS OWN DRIVER LIFETIME:
  '  a start re-inits the fault response, the stop mode and the fault latch -- and discards a forced fault still
  '  pending -- so no trial, and no abort, leaves the next one in a state it did not choose. The explicit restores
  '  after each trial are still made, and read back, as the evidence they took (R19-DUAL-FRREST-X).
  '
  ' EVERY FAULT IS FORCED (testForceFault(), DRIVER_REV 12): the driver takes a fault at its own fault test on its next
  '  DRIVEN frame, so the response is the mode's real response and getFaultCause() reads FC_LAG (the halls are legal).
  '  The offsets are never touched, so no field is left 180 degrees off: the offset-shift provocation this replaces
  '  faulted 2 of 5 times on file and plugged the motor into the 10 A abort the other 3 (PL-119). The forced fault is
  '  still GUARDED (frGuard()): cog 0 reads the mirror with no wait for FR_PROVOKE_MS and stops the wheel on the first
  '  read at or over ABS_ABORT_MV, or when no fault latched by then -- a failure of the HOOK, recorded as BM-ABORT
  '  reason NO_FAULT and counted by R19-DUAL-FORCED-X. The hook's own negative control runs first on each wheel: a
  '  forced fault AT REST, bridge coasting, must not fault (R19-DUAL-HOOKREST-X). A request made at rest stays pending
  '  in the driver (force_seen is advanced only by a fault), so that check ends its lifetime and the pending request
  '  with it.
  '
  ' A SECOND FORCED FAULT DURING A RE-SYNCED RAMP TAKES THE FALLBACK (DRIVER_REV 12: fault_stop now stays pending until
  '  rest). X-6 uses it: FR_GRADED with holdAtStop(TRUE) at FR_SPEED_X6, the second fault forced once the mirror reads
  '  DCS_SPIN_DN, gives BR_BRAKE at each brake % in frBrakePcts; its coast bound is the same double fault with
  '  holdAtStop(FALSE) (X6C), and its full-short bound is X-2 at the same speed.
  '
  ' THE DC-LINK SHUNT CANNOT SEE A PHASE SHORT'S CURRENT. DERIVED (BOARD-REVISION-FACTS.md sec 2.3: the shunt sits
  '  between the common MOSFET ground and system ground): with every low side on, the phase currents circulate
  '  through the low-side FETs and their common node and never cross the shunt. So X-2's pre-registered "peak
  '  current rises with speed" is judged only when the highest speed's post-fault peak stands FR_I_VISIBLE_MV over
  '  the lifetime zero; otherwise R19-DUAL-SHORTI-X is NOMEAS and BM-FRWIND's winding resistance NA, why NOT_VISIBLE.
  '  A flat zero is reported as unobservable, never as a short that drew nothing.
  '
  ' The startup study's B-4 current pulse was not built; X-2 replaces it (R19-DUAL-B4PULSE-X NOT_BUILT, why
  '  REPLACED_BY_X2), and by PL-118 its winding-resistance estimate from the short's current is expected to read NA.
    FR_SPEEDS             = 3                               ' a low, middle and high rung of the ladder (frRungIdx)
    FR_SPEED_X4           = 1                               ' X-4 runs once per wheel, at the middle rung
    FR_SPEED_X6           = 1                               ' X-6 and its bounds too, so X-2's middle rung is its full-short bound
    FR_PHASES             = 3
    FR_BRAKE_PCT          = wheelL.BRAKE_PCT_DEFAULT        ' 10: the graded short's %, the driver's own default
    FR_BRAKE_STEPS        = 4                               ' frBrakePcts: 10, 25, 50, 100
    FR_GRADED_POINTS      = FR_BRAKE_STEPS + 1              ' the coast bound (X6C) as point 0, then the four brake %s
    FR_GRADED_MIN_POINTS  = 3                               ' a monotone reading needs at least three measured points
    ' 100 % graded is the full short (brake_on is the whole period), entered a few ms later on a ramp already begun,
    '  so it should stop within hall quantisation of X-2's short at the same speed: one tick either side, and one more
    '  for the slower speed at the second fault.
    FR_FULL_TOL_TICKS     = 2
    ' FR_PROVOKE_MS: testForceFault() returns once the front cog has taken the request (a front pass, 1 ms); the driver
    '  faults on its next driven pass (0.52 ms) and the instrument mirrors the latch within one 2 ms sample, so a
    '  forced fault shows by about 4 ms. 8 ms is twice that.
    FR_PROVOKE_MS         = 8
    FR_SECOND_WAIT_MS     = 50                              ' X-6: the bound on the mirror reading SPIN_DN before the second force
    FR_HOOK_SETTLE_MS     = 200                             ' HOOKREST: at rest this long before the force
    FR_HOOK_WIN_MS        = 500                             ' ...and watched this long after it
    ' X-4's ramp. A re-synced stop reads its command as 0 and ramps down at the slow-down limit. SRC_REV 59 (DRIVER_REV
    '  38, PL-160): the jerk-limited stop, so from |incre| it takes |incre| / RAMP_DEF_ACCEL_DN + RAMP_STOP_EXTRA_PASSES
    '  passes at FR_PASSES_PER_SEC (the S-curve's v / A + A / J, and the take; every FLTRESP speed is above the 24 x 10^6
    '  the plateau needs): 1_088 ms at 80 x 10^6, where the stepped ramp's |incre| / 50_000 gave 836. MEASURED against
    '  the stepped form: a commanded stop from half speed took 730 ms to the start of rest (BASELINE,
    '  debug_260919-173537.log, mark_k 50 to rest_k 415) against 768 ms predicted -- the last sparse ticks read as rest a
    '  little early. The re-synced stop must land inside FR_RAMP_LO_PCT..FR_RAMP_HI_PCT of the prediction: a short (a few
    '  ms) or a stop that ran on fails it; the band is the pre-registered one, unchanged.
    FR_PASSES_PER_SEC     = wheelL.PWM_RATE_IN_HZ / wheelL.DRIVE_PASS_FRAMES      ' 1_913
    FR_RAMP_LO_PCT        = 50
    FR_RAMP_HI_PCT        = 150
    FR_PRE_SAMPLES        = 250                             ' 500 ms before the mark: the wheel's rate, current and duty at speed
    FR_SETTLE_SAMPLES     = 2                               ' the moving window starts this many samples after the fault
    FR_REST_WIN_MS        = 500                             ' X-3's negative control: the phases floated at rest, before spin-up
    FR_REST_MIN_SAMPLES   = 50                              ' a rest window shorter than this (100 ms) judges nothing
    ' FLAT. MEASURED 2026-09-22 (the ALIGN tier's bias reads, debug_260922-122515.log and -122644.log): a floated phase
    '  at rest strays at most 18 mV from its mean (hyst 9-22 mV is that stray + ALIGN_HYST_MARGIN_MV), so its
    '  peak-to-peak at rest is at most 36 mV. A coast from speed swings hundreds (Visit 6's coast moved the phase SUM
    '  alone 541-1_013 mV). A phase under FR_FLAT_MV peak-to-peak is flat; the crossing band is half of it, above the
    '  rest stray, so noise about a flat phase makes no crossing.
    FR_FLAT_MV            = 50
    FR_XING_BAND_MV       = FR_FLAT_MV / 2
    FR_XING_PER_CYCLE     = 2                               ' a phase crosses its mean twice per electrical cycle
    FR_XING_MIN           = 2                               ' one full alternation at least, so a single step is not a swing
    FR_COAST_MIN_TICKS    = wheelL.HALL_TICKS_PER_CYCLE     ' one electrical cycle: a coast of fewer ticks is NOMEAS
    SENSE_MV_PER_A        = 150                             ' the Rev B sense scale (BOARD-REVISION-FACTS.md sec 2.4)
    ' 1 A over the lifetime zero: the floated zero reads -0.5 to +8.7 mV over 200 starts (ALIGN_NODRIVE_MV's note)
    FR_I_VISIBLE_MV       = SENSE_MV_PER_A
    FR_RISE_MIN_SPEEDS    = 2                               ' "rises with speed" needs two measured speeds
    FR_BAD_LO             = 0                               ' every FAULTRESP count cell passes at zero bad instances
    FR_BAD_HI             = 0
    ' X-5. The other wheel must be at rest one ramp time after the fault. MEASURED: a commanded stop from half speed
    '  takes about 730 ms (BASELINE, debug_260919-173537.log, mark_k 50 to rest_k 415 at 2 ms); D_REST_MS, the
    '  harness's bound on the platform reaching rest after a stop, is used as the ramp time. The window after it must
    '  show the wheel under FR_PLAT_REST_PCT of its pre-fault rate; a wheel driving on reads about 100 %. SRC_REV 59
    '  (DRIVER_REV 38): the jerk-limited stop from FLTAPI_POWER's 81.7 x 10^6 is 2_118 passes, 1_108 ms (DERIVED as
    '  frRampPredMs() is), still under D_REST_MS; the 730 ms above was the stepped ramp's.
    FR_PLAT_RAMP_MS       = D_REST_MS
    FR_PLAT_WIN_MS        = 500
    FR_PLAT_MARGIN_MS     = 200
    FR_PLAT_CAPTURE_MS    = FR_PLAT_RAMP_MS + FR_PLAT_WIN_MS + REST_CONFIRM_MS + FR_PLAT_MARGIN_MS
    FR_PLAT_RAMP_SAMPLES  = (FR_PLAT_RAMP_MS * INST_RATE_HZ) / MS_PER_SEC
    FR_PLAT_WIN_SAMPLES   = (FR_PLAT_WIN_MS * INST_RATE_HZ) / MS_PER_SEC
    FR_PLAT_PCT_LO        = 0
    FR_PLAT_REST_PCT      = 10
    FR_PLAT_MIN_TICKS     = 10                              ' the other wheel's pre-fault window: it was turning
    FR_PCT_SCALE          = 100

  ' PL-120, THE NO-MOTION FORM (2026-09-24 21:21, VISIT-10-DUALFAULT-T0-EVALUATION.md sec 4). From its first 120 x 10^6
  '  start the right wheel produced no motion in 8 fresh driver lifetimes; its phase reading rose to 2_194 mV as the
  '  drive began and drained to 18 mV within about 200 ms, and the TIMEOUT dump could only read the state after the
  '  driver's own protective stop had latched (~1 s in). A fresh program load cleared it. Two diagnostics:
  '   - NOMOTION dump: once a trial's wheel has been commanded for FR_NOMOTION_MS with no hall tick (neither the
  '     driver's pos nor the instrument's own hall count has changed), its driver runs are dumped ONCE, as
  '     BM-ABI* where,NOMOTION, while the drive is still on and before the protective stop overwrites them.
  '     PROVISIONAL (PL-120's figure): 150 ms is inside the ~200 ms drain and well before the ~1 s stop. How soon a
  '     healthy wheel's first tick comes after a start from rest is not measured here; a dump on a wheel that then
  '     drives is read as early, not as a failure.
  '   - RECOVERY probe: after the run's FIRST FLTRESP trial that ends STEADY_TIMEOUT, that wheel is tried up to
  '     FR_RECOVER_TRIES times, one try every FR_RECOVER_GAP_MS measured from the failure (at 20 s, 40 s .. 120 s),
  '     each a fresh driver lifetime that drives FR_RECOVER_INCRE (NEG, as the trials) for FR_RECOVER_DRIVE_MS; it
  '     ends at the first try that moves. It decides TIME against RELOAD: a wheel that moves in a later try recovered
  '     with time inside one program; one that never moves needs the reload. One probe per run bounds a dead wheel's
  '     cost at about 2 minutes, not 2 minutes per trial. (PL-136 adds PREFLT's own probe, below, which does not take
  '     this one's turn: a wheel recovered at PREFLT that then dies mid-run is still probed here.)
    FR_NOMOTION_MS        = 150                             ' PROVISIONAL: commanded this long with no hall tick
    FR_RECOVER_TRIES      = 6
    FR_RECOVER_GAP_MS     = 20_000                          ' try n starts n x this after the failure
    FR_RECOVER_DRIVE_MS   = 2_000
    FR_RECOVER_INCRE      = 40_000_000                      ' the low rung's speed, ladderIncre[frRungIdx[0]]

  ' PL-136, PL-120 AT PREFLT (Visit 10 pass 4, 2026-09-25 11:41, VISIT-10-PASS4-EVALUATION.md sec 4a): the right wheel
  '  did not move on the first drive of a fresh load, was retired by PREFLT, and so ran no FLTRESP trial -- and both
  '  diagnostics above hung off a trial, so neither fired, and the nudge's ring was drained to count ticks and thrown
  '  away. The diagnostics now key on a commanded wheel that does not move, wherever it happens:
  '   - every part: a PREFLT nudge with no hall tick by FR_NOMOTION_MS dumps where,NOMOTION mid-nudge, and a nudge that
  '     did not move is traced (in FAULTRESP every nudge is, as the in-run control) -- bPreflightWheel();
  '   - FAULTRESP only: a wheel whose nudge did not move is retried AT ONCE in PF_RETRY_TRIES fresh lifetimes
  '     (bPfRetry(), BM-PFRETRY); only if every retry fails, and it is the only such wheel, the recovery probe runs on
  '     it before FLTRESP (bPfProbe(), BM-FRRECOV seg,PREFLT). A wheel either stage moves runs its trials. The retries
  '     tell a transient first-drive failure from a persistent one; the probe, as at FLTRESP, time from the reload.
  '     BM-FRRECSUM reports both stages per wheel (l_pf / r_pf).
    PF_RETRY_TRIES        = 3                               ' fresh lifetimes, at once, after a nudge that did not move
    PF_RETRY_GAP_MS       = 1_000                           ' from one attempt's wheelStop() to the next one's start

  ' What PREFLT's stages found for a wheel (token = tokPfOut; BM-FRRECSUM l_pf and r_pf):
  '  PFO_NO_FAIL   - its first nudge moved; no stage ran
  '  PFO_RETRY     - an immediate retry moved it: recovered, and its trials run
  '  PFO_PROBE     - every retry failed and a recovery-probe try moved it: recovered, and its trials run
  '  PFO_DEAD      - every retry and all FR_RECOVER_TRIES probe tries left it unmoved: not recovered, retired
  '  PFO_UNDECIDED - its first nudge did not move and the stages ended before deciding: a run cap, a retirement by a
  '                  failed fault recovery, or both wheels unmoved (the run then ends, and no probe runs)
    #0, PFO_NO_FAIL, PFO_RETRY, PFO_PROBE, PFO_DEAD, PFO_UNDECIDED
    PFO_COUNT    = PFO_UNDECIDED + 1
    TOKMAX_PFOUT = 9

  ' PL-120, THE ORDER: -D FRESP_RIGHT_FIRST (tier dual-fault-rightfirst) runs the RIGHT wheel's own FLTRESP trials
  '  before the LEFT's, everything else identical (PREFLT and FLTPLAT keep their order). The failure followed the left
  '  wheel's trials; this build decides whether they are its precondition.
#ifdef FRESP_RIGHT_FIRST
    BUILD_RIGHT_FIRST     = TRUE
    FR_SIDE_FIRST         = SIDE_RIGHT
    FR_SIDE_LAST          = SIDE_LEFT
#else
    BUILD_RIGHT_FIRST     = FALSE
    FR_SIDE_FIRST         = SIDE_LEFT
    FR_SIDE_LAST          = SIDE_RIGHT
#endif

  ' The X-cell of a wheel trial (token = tokFrCell):
  '  FRC_X2 - SHORT from speed: FR_SHIPPED, holdAtStop(TRUE)
  '  FRC_X3 - COAST from speed: FR_SHIPPED, holdAtStop(FALSE)
  '  FRC_X4 - RE-SYNC: FR_GRADED, holdAtStop(FALSE): one forced fault, re-seeded onto the correct offsets
  '  FRC_X6 - GRADED SHORT: FR_GRADED at frBrakePcts[], holdAtStop(TRUE): a second forced fault on the re-synced ramp
  '  FRC_X6C - X-6's coast bound: the same double fault with holdAtStop(FALSE), which coasts
    #0, FRC_X2, FRC_X3, FRC_X4, FRC_X6, FRC_X6C
    FRC_COUNT = FRC_X6C + 1
    TOKMAX_FRCELL = 3

  ' The outcome of a forced fault (and, for X-6, of its second):
  '  FRO_FAULT    - the fault latched inside FR_PROVOKE_MS (the second: the mirror read DCS_FAULTED inside it)
  '  FRO_NO_FAULT - it did not: the HOOK failed. A first fault's wheel was stopped (BM-ABORT NO_FAULT); a second's
  '                 wheel is left ramping under control, since nothing is wrong with it
  '  FRO_ABORT_I  - the current reached ABS_ABORT_MV first; the wheel was stopped (BM-ABORT ABS_CURRENT)
  '  FRO_NOT_RUN  - the trial never reached this fault; why says what stopped it (for a second: none was asked)
    #0, FRO_FAULT, FRO_NO_FAULT, FRO_ABORT_I, FRO_NOT_RUN
    FRO_COUNT = FRO_NOT_RUN + 1
    TOKMAX_FROUT = 8

  ' What the driver was SEEN to do after the fault (I7: observed, never labelled in advance):
  '  FRP_NONE       - nothing to classify (no fault, or the after-reads could not be taken)
  '  FRP_FAULTED    - DCS_FAULTED with no re-sync: the stop mode's fault bridge (FR_SHIPPED's, or FR_GRADED's blunt)
  '  FRP_RESYNC     - one re-sync and no DCS_FAULTED: re-seeded from the halls and stopped along the ramp
  '  FRP_RESYNC_N   - two or more re-syncs and no DCS_FAULTED: it faulted again on the ramp and re-seeded again
  '  FRP_RESYNC_FLT - a re-sync, then DCS_FAULTED
    #0, FRP_NONE, FRP_FAULTED, FRP_RESYNC, FRP_RESYNC_N, FRP_RESYNC_FLT
    FRP_COUNT = FRP_RESYNC_FLT + 1
    TOKMAX_FRPATH = 10

  ' BM-FRPHASE window:
  '  FRW_PRE  - floated at rest before spin-up: X-3's negative control, measured first
  '  FRW_MOVE - from FR_SETTLE_SAMPLES after the fault to rest: the wheel coasting or braked
  '  FRW_REST - from rest to the capture's end, the bridge in its post-fault state
    #0, FRW_PRE, FRW_MOVE, FRW_REST
    FR_WINS = FRW_REST + 1                                  ' (SRC_REV 71: was a literal 3, beside FR_SPEEDS above)
    TOKMAX_FRWIN = 4

    FR_MODE_COUNT = wheelL.FR_GRADED + 1                    ' tokFrMode is indexed by the library's FR_*
    TOKMAX_FRMODE = 7
    HS_COUNT = wheelL.HS_LIMITED + 1                        ' tokHold is indexed by the library's HS_*
    TOKMAX_HOLD = 7

#ifdef DBG_FRPLAT
DAT ' ---- FAULTRESP tables ----

' The three rungs, as ladderIncre indices: 40, 80 and 120 x 10^6, low, middle and high. The high rung stays below the
'  ceiling: the full short from it is the hardest stop in the part, and every X-2 ends in one.
frRungIdx       LONG    3, 5, 7
' X-6's brake %s, ascending: setFaultResponse(FR_GRADED, pct) before each trial
frBrakePcts     LONG    10, 25, 50, 100
tokFrCell       BYTE    "X-2", 0, "X-3", 0, "X-4", 0, "X-6", 0, "X6C", 0, TOK_END
tokFrOut        BYTE    "FAULT", 0, "NO_FAULT", 0, "ABORT_I", 0, "NOT_RUN", 0, TOK_END
tokFrPath       BYTE    "NONE", 0, "FAULTED", 0, "RESYNC", 0, "RESYNC_N", 0, "RESYNC_FLT", 0, TOK_END
tokFrMode       BYTE    "SHIPPED", 0, "GRADED", 0, TOK_END
tokFrWin        BYTE    "PRE", 0, "MOVE", 0, "REST", 0, TOK_END
tokHold         BYTE    "OFF", 0, "HOLDING", 0, "SLIPPED", 0, "LIMITED", 0, TOK_END
tokPfOut        BYTE    "NO_FAIL", 0, "RETRY", 0, "PROBE", 0, "DEAD", 0, "UNDECIDED", 0, TOK_END
#endif

' PL-152: this VAR block stays in every build -- the pf* longs below are the PREFLT nudge's staging, which every part
'  that runs PREFLT writes (bPreflightWheel()); the FAULTRESP code that reads the rest is compiled into that part only.
VAR { FAULTRESP state -- cog 0 only }

    ' the trial in hand (frStagingReset())
    LONG    frCell                                          ' FRC_*
    LONG    frSpeedIdx                                      ' 0..FR_SPEEDS-1
    LONG    frBrakeIdx                                      ' X-6: 0..FR_BRAKE_STEPS-1 into frBrakePcts
    LONG    frBrakePct                                      ' the graded short's % this trial set
    LONG    frMode                                          ' FR_* the trial set
    LONG    frReqMode                                       ' MODE_* the trial requested
    LONG    frSetErr                                        ' setFaultResponse()'s return
    LONG    frOutcome                                       ' FRO_* of the (first) forced fault
    LONG    frOutcome2                                      ' FRO_* of X-6's second, FRO_NOT_RUN when none was asked
    LONG    frForceErr                                      ' testForceFault()'s return (the first)
    LONG    frForceErr2                                     ' ...and X-6's second
    LONG    bFrForced                                       ' the first fault was requested
    LONG    frMarkMs                                        ' getms() at the forced fault's mark
    LONG    frGuardPkMv                                     ' the largest mirrored sense_i inside the guard, mV
    LONG    frCaptureSafe                                   ' SAFE_* that ended the post-fault capture
    LONG    frBrakeOnBase                                   ' testGetFaultResponse()'s brake_on at the lifetime's start
    LONG    frResyncBase                                    ' ...its re-sync count at speed, just before the forced fault
    LONG    frResyncAfter                                   ' ...and after the capture
    LONG    bFrReadsValid                                   ' the after-reads were taken from a running driver
    LONG    frCause                                         ' getFaultCause() after the capture
    LONG    frPath                                          ' FRP_*
    LONG    frWhy                                           ' first cause of the trial's NA fields
    LONG    frPreWhy                                        ' ...and of the negative-control window's
    LONG    frDutyMax                                       ' duty_max of this lifetime
    LONG    bFrRestUp                                       ' the restores were issued to a running driver
    LONG    frRestErr                                       ' the fault-response restore's return
    ' the capture's readings (frStats())
    LONG    bFrPreValid                                     ' the pre-fault window held samples
    LONG    frPreX10                                        ' the wheel's rate over it, ticks/s x10
    LONG    frPreIX10                                       ' its mean sense_i, mV x10
    LONG    frPreDuty                                       ' its mean duty
    LONG    bFrFltFound                                     ' a sample at or after the mark carried the fault latch
    LONG    frFltJ                                          ' the first one, logical index
    LONG    bFrFlt2Found                                    ' X-6: a sample after it read DCS_FAULTED (the second fault's fallback)
    LONG    frFlt2J                                         ' ...the first one
    LONG    frRefJ                                          ' the reading's reference: the second fault for X-6 / X6C, else the first
    LONG    bFrRestFound                                    ' the trace found rest after the reference
    LONG    frRestJ                                         ' where the still run began, logical index
    LONG    frTicksRest                                     ' |pos| from the reference to rest
    LONG    frRestMs                                        ' ms from the reference to rest
    LONG    frT1                                            ' ticks over the first half of that interval
    LONG    frT2                                            ' ...and the second: a falling rate has frT1 > frT2
    LONG    bFrPkValid                                      ' an up sample lay between the fault and rest
    LONG    frPkI                                           ' the largest sense_i there, mV
    LONG    frPkK                                           ' its trace k
    LONG    bFrSawSpinDn                                    ' DCS_SPIN_DN seen after the fault
    LONG    bFrSawFaulted                                   ' DCS_FAULTED seen after the fault
    LONG    frStEnd                                         ' the state on the capture's last sample
    ' the three phase windows, [window] or [window * FR_PHASES + phase]
    LONG    bFrWinValid[FR_WINS]
    LONG    frWinN[FR_WINS]
    LONG    frWinTicks[FR_WINS]
    LONG    frWinPp[FR_WINS * FR_PHASES]
    LONG    frWinX[FR_WINS * FR_PHASES]
    ' X-5 (frPlatStats()): the wheel that was NOT faulted
    LONG    bFrPlatPreValid                                 ' its pre-fault window held samples
    LONG    bFrPlatPreOk                                    ' ...and it was turning (FR_PLAT_MIN_TICKS)
    LONG    frPlatPreX10
    LONG    bFrPlatWinValid                                 ' its window one ramp time after the fault was measured
    LONG    frPlatWinX10
    LONG    frPlatPct                                       ' the window's rate as a percentage of the pre-fault rate
    LONG    bFrPlatRestFound
    LONG    frPlatRestJ
    LONG    frPlatRestMs                                    ' ms from the fault to its rest
    LONG    bFrPlatSpinDn                                   ' DCS_SPIN_DN seen on it after the fault
    ' the cells' accumulators, [slot] or [slot * FR_SPEEDS + speed] (frResetCells())
    LONG    frShortPk[INST_MOTORS * FR_SPEEDS]              ' SHORTI: X-2's post-fault peak sense_i per speed
    LONG    bFrShortPkRan[INST_MOTORS * FR_SPEEDS]
    LONG    bFrShortVis[INST_MOTORS * FR_SPEEDS]
    LONG    frShortTicks[INST_MOTORS * FR_SPEEDS]           ' SHORTTK: X-2's fault-to-rest ticks per speed
    LONG    bFrShortTkRan[INST_MOTORS * FR_SPEEDS]
    LONG    frCoastTicks[INST_MOTORS * FR_SPEEDS]           ' ...and X-3's
    LONG    bFrCoastTkRan[INST_MOTORS * FR_SPEEDS]
    LONG    sfCoastN[INST_MOTORS]                           ' COASTEMF: X-3 coasts judged, and those that stayed flat
    LONG    sfCoastBad[INST_MOTORS]
    LONG    sfRestN[INST_MOTORS]                            ' RESTFLAT: rest windows judged, and those that were not flat
    LONG    sfRestBad[INST_MOTORS]
    LONG    bSfResyncRan[INST_MOTORS]                       ' RESYNC
    LONG    bSfResyncOk[INST_MOTORS]
    LONG    sfFrRestN[INST_MOTORS]                          ' FRREST: restores read back, and those that did not hold
    LONG    sfFrRestBad[INST_MOTORS]
    LONG    bSfPlatRan[INST_MOTORS]                         ' PLATSTOP, indexed by the wheel that was NOT faulted
    LONG    sfPlatPct[INST_MOTORS]
    LONG    frGradedTicks[INST_MOTORS * FR_GRADED_POINTS]   ' GRADED: [slot * FR_GRADED_POINTS + point], point 0 the coast bound
    LONG    frGradedMs[INST_MOTORS * FR_GRADED_POINTS]
    LONG    bFrGradedRan[INST_MOTORS * FR_GRADED_POINTS]
    LONG    sfBluntN[INST_MOTORS]                           ' BLUNT: double-fault trials judged, and those not FAULTED after the second
    LONG    sfBluntBad[INST_MOTORS]
    LONG    sfForcedN[INST_MOTORS]                          ' FORCED: driven forced faults, and those that did not latch
    LONG    sfForcedBad[INST_MOTORS]
    LONG    bSfHookRan[INST_MOTORS]                         ' HOOKREST
    LONG    bSfHookOk[INST_MOTORS]
    LONG    bFrPreRetired[INST_MOTORS]                      ' task 3615: retired by PREFLT (did not move); every cell NOMEAS
    ' PL-120's recovery probe, one per run (frResetCells())
    LONG    frFailMs                                        ' getms() when the trial's AT_SPEED wait ended unreached
    LONG    bFrProbed                                       ' the probe ran (after the run's first STEADY_TIMEOUT)
    LONG    bFrRecovered                                    ' ...and a try moved
    LONG    frProbeTid                                      ' the failed trial's tid
    LONG    frProbeSide                                     ' ...and its wheel
    LONG    frProbeTries                                    ' tries made
    LONG    frRecTry                                        ' the try that moved, 1-based
    LONG    frRecMs                                         ' ...its ms since the failure
    LONG    frProbeWhy                                      ' what ended the probe short: NONE, ABORTED or MOTOR_RETIRED
    LONG    frTryMs                                         ' the try in hand: ms since the failure at its command
    ' PL-136: PREFLT's retries and probe, per wheel (frResetCells(); bPfRetry(), bPfProbe()), for BM-FRRECSUM
    LONG    pfOutcome[INST_MOTORS]                          ' PFO_*: what PREFLT's stages found
    LONG    pfTries[INST_MOTORS]                            ' immediate retries made
    LONG    pfRecTry[INST_MOTORS]                           ' the retry (RETRY) or probe try (PROBE) that moved it, 1-based
    LONG    pfFailMs[INST_MOTORS]                           ' getms() when its first nudge's drive ended unmoved
    LONG    pfFailTid[INST_MOTORS]                          ' that nudge's trace id, 0 when it was not traced
    ' PL-136: the PREFLT nudge in hand, staged by bPreflightWheel() in every part, read by BM-PFRETRY
    LONG    pfTid                                           ' its trace id, 0 when it was not traced
    LONG    pfTicks                                         ' driver pos delta
    LONG    pfHw                                            ' the instrument's hall-count delta
    LONG    bPfMeasured                                     ' the deltas are measurements
    LONG    pfWhy                                           ' first cause of an NA, or what ended the drive early
    LONG    pfCmdMs                                         ' getms() at its command
    LONG    bPfCmdValid                                     ' the command was sent
    LONG    pfEndMs                                         ' getms() when its drive ended
    ' task 3621 (R20.1): the trial's stop reason (frReadAfter()), and the reporting cells' accumulators (frResetCells())
    LONG    frSr                                            ' getStopReason() after the capture, beside the drain of its log
    LONG    sfSrFaultN[INST_MOTORS]                         ' SR-FAULT: trials judged -- X-4 (the positive), X-2 and HOOKREST (the negatives)
    LONG    sfSrFaultBad[INST_MOTORS]                       ' ...that did not read as pre-registered
    LONG    bSfSrFaultPos[INST_MOTORS]                      ' ...an X-4 was judged
    LONG    bSfSrFaultNeg[INST_MOTORS]                      ' ...an X-2 or HOOKREST was judged
    LONG    sfSrLostN[INST_MOTORS]                          ' SR-FLOST: trials judged -- X-2, X-3, X-6, X6C (the positives), X-4 (the negative)
    LONG    sfSrLostBad[INST_MOTORS]
    LONG    bSfSrLostPos[INST_MOTORS]
    LONG    bSfSrLostNeg[INST_MOTORS]
    LONG    bSfPartRan[INST_MOTORS]                         ' SR-PARTNER, indexed by the wheel FLTPLAT faulted
    LONG    bSfPartOk[INST_MOTORS]
    LONG    bSfFrontEvRan[INST_MOTORS]                      ' FRONTST-EV, indexed by the wheel FLTPLAT faulted
    LONG    bSfFrontEvOk[INST_MOTORS]

#ifdef DBP_FAULTRESP
PRI frResetCells() | arrIdx, slotIdx
' Clear the FAULTRESP part's cell accumulators (initRunState()): every count 0 and every ran FALSE, so a cell no
' trial reached prints NOMEAS. The recovery probe's state too, so BM-FRRECSUM reads probed FALSE when none ran, and
' PREFLT's stages (PL-136), so each wheel reads NO_FAIL until its first nudge fails.
'
' @local arrIdx - [slot * FR_SPEEDS + speed] index
' @local slotIdx - motor slot

    repeat arrIdx from 0 to (INST_MOTORS * FR_SPEEDS) - 1
        frShortPk[arrIdx] := 0
        bFrShortPkRan[arrIdx] := FALSE
        bFrShortVis[arrIdx] := FALSE
        frShortTicks[arrIdx] := 0
        bFrShortTkRan[arrIdx] := FALSE
        frCoastTicks[arrIdx] := 0
        bFrCoastTkRan[arrIdx] := FALSE
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        sfCoastN[slotIdx] := 0
        sfCoastBad[slotIdx] := 0
        sfRestN[slotIdx] := 0
        sfRestBad[slotIdx] := 0
        bSfResyncRan[slotIdx] := FALSE
        bSfResyncOk[slotIdx] := FALSE
        sfFrRestN[slotIdx] := 0
        sfFrRestBad[slotIdx] := 0
        bSfPlatRan[slotIdx] := FALSE
        sfPlatPct[slotIdx] := 0
        sfBluntN[slotIdx] := 0
        sfBluntBad[slotIdx] := 0
        sfForcedN[slotIdx] := 0
        sfForcedBad[slotIdx] := 0
        bSfHookRan[slotIdx] := FALSE
        bSfHookOk[slotIdx] := FALSE
        bFrPreRetired[slotIdx] := FALSE
        sfSrFaultN[slotIdx] := 0                            ' task 3621
        sfSrFaultBad[slotIdx] := 0
        bSfSrFaultPos[slotIdx] := FALSE
        bSfSrFaultNeg[slotIdx] := FALSE
        sfSrLostN[slotIdx] := 0
        sfSrLostBad[slotIdx] := 0
        bSfSrLostPos[slotIdx] := FALSE
        bSfSrLostNeg[slotIdx] := FALSE
        bSfPartRan[slotIdx] := FALSE
        bSfPartOk[slotIdx] := FALSE
        bSfFrontEvRan[slotIdx] := FALSE
        bSfFrontEvOk[slotIdx] := FALSE
    repeat arrIdx from 0 to (INST_MOTORS * FR_GRADED_POINTS) - 1
        frGradedTicks[arrIdx] := 0
        frGradedMs[arrIdx] := 0
        bFrGradedRan[arrIdx] := FALSE
    frFailMs := 0
    bFrProbed := FALSE
    bFrRecovered := FALSE
    frProbeTid := 0
    frProbeSide := SIDE_NONE
    frProbeTries := 0
    frRecTry := 0
    frRecMs := 0
    frProbeWhy := WHY_NONE
    frTryMs := 0
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT             ' PL-136: no PREFLT stage has run
        pfOutcome[slotIdx] := PFO_NO_FAIL
        pfTries[slotIdx] := 0
        pfRecTry[slotIdx] := 0
        pfFailMs[slotIdx] := 0
        pfFailTid[slotIdx] := 0

PRI segFaultResp() | side, speedIdx, brakeIdx
' FLTRESP (part FAULTRESP, task 3613): the fault study's wheel-frame X-cells. Per wheel: FIRST the hook's negative
' control (a forced fault at rest must not fault, frHookRestTrial()); then at each rung of frRungIdx in ascending
' order X-3 (the coast, its own negative control first) and X-2 (the short) at the same speed, so each speed's pair is
' taken a minute apart at most; then at the middle rung X-4 (the re-sync), X-6's coast bound (X6C) and X-6 at each
' brake % ascending. Every trial is its own lifetime (frTrial()), and every forced fault is guarded (frGuard()).
' The wheels run FR_SIDE_FIRST then FR_SIDE_LAST: LEFT first, or RIGHT first in the FRESP_RIGHT_FIRST build (PL-120).
' After the trials, BM-FRRECSUM: whether PL-120's recovery probe ran (frTrial()) and what it found, and what PREFLT's
' stages found for each wheel (PL-136, bSegPreflight()).
'
' @local side - FR_SIDE_FIRST then FR_SIDE_LAST
' @local speedIdx - 0..FR_SPEEDS-1, ascending
' @local brakeIdx - 0..FR_BRAKE_STEPS-1, ascending

    segBegin(SEG_FLTRESP)
    repeat side from FR_SIDE_FIRST to FR_SIDE_LAST
        beat(CP_LOOP_POLL)
        frHookRestTrial(side)
        repeat speedIdx from 0 to FR_SPEEDS - 1
            beat(CP_LOOP_POLL)
            frTrial(side, FRC_X3, speedIdx, 0)
            frTrial(side, FRC_X2, speedIdx, 0)
        beat(CP_LOOP_POLL)
        frTrial(side, FRC_X4, FR_SPEED_X4, 0)
        frTrial(side, FRC_X6C, FR_SPEED_X6, 0)
        repeat brakeIdx from 0 to FR_BRAKE_STEPS - 1
            beat(CP_LOOP_POLL)
            frTrial(side, FRC_X6, FR_SPEED_X6, brakeIdx)
    emitFrRecSum()
    segEnd(segWhy())

PRI segFaultPlat()
' FLTPLAT (part FAULTRESP, task 3613): X-5, PL-117 -- one wheel of the steering object faults while both drive, and
' the other must stop along its ramp. Once per wheel, each its own steering lifetime: the LEFT forced under
' FR_SHIPPED (the fault latches, DCS_FAULTED), then the RIGHT under FR_GRADED (it re-syncs and stops itself). The
' policy is stated for a fault of EITHER kind (R19.2), so the two forced faults the cell needs cover both kinds, and
' each wheel is once the one faulted and once the one watched.

    segBegin(SEG_FLTPLAT)
    wheelStop(SIDE_LEFT)                                    ' shared pin claims (PL-18), as OVERSHT does
    wheelStop(SIDE_RIGHT)
    frPlatTrial(SIDE_LEFT, wheelL.FR_SHIPPED)
    frPlatTrial(SIDE_RIGHT, wheelL.FR_GRADED)
    segEnd(segWhy())

PRI frTrial(side, cellKind, speedIdx, brakeIdx) | slotIdx, tid, motorIncre, whyCode, accelUp, bTimedOut
' One wheel-frame X-cell trial in its own driver lifetime: start the wheel alone (the lifetime zero is read inside
' bWheelStart()); X-3 only, the phases at rest (the negative control, first); set the fault response (X-6 at its
' brake %); X-2 and X-6, holdAtStop(TRUE) before the spin-up; spin up, settle and force the fault -- X-6 and X6C a
' second on the re-synced ramp (frCapture()); then, in I11's order, the reads that must see the driver as the fault
' left it, every restore, and only then the trace and the readings; recover the fault and cool; read the restores
' back at rest (frRestoreCheck()); stop the wheel. PL-120: a trial whose wheel never reached AT_SPEED
' (STEADY_TIMEOUT) is followed, the first time in the run only, by the recovery probe on that wheel
' (frRecoverProbe()), before the next trial.
'
' The sign is NEG, as POSTFLT's, so these traces sit beside part C's.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param cellKind - FRC_X2, FRC_X3, FRC_X4, FRC_X6 or FRC_X6C
' @param speedIdx - 0..FR_SPEEDS-1, the rung in frRungIdx
' @param brakeIdx - X-6: 0..FR_BRAKE_STEPS-1 into frBrakePcts (ignored otherwise)
'
' @local slotIdx - motor slot
' @local tid - trace id
' @local motorIncre - signed increment
' @local whyCode - why the trial did not run, WHY_NONE when it did
' @local accelUp - accel_up (the speed-up limit, maxRamp) read back for the trace header
' @local bTimedOut - the capture ended STEADY_TIMEOUT (the wheel never reached AT_SPEED)

    slotIdx := side - SIDE_LEFT
    motorIncre := ladderIncre[frRungIdx[speedIdx]] * SIGN_NEG
    tid := nextTraceId()
    cpReset()
    frStagingReset(cellKind, speedIdx, brakeIdx)
    whyCode := WHY_NONE
    bTimedOut := FALSE
    if bRunContinue(SEG_FLTRESP) == FALSE
        whyCode := WHY_ABORTED
    elseif bWheelStart(SEG_FLTRESP, side) == FALSE
        whyCode := stWhy
    whyCode := trialSkipWhy(SEG_FLTRESP, side, whyCode)
    accelUp := wheelAccelUp(side)
    if whyCode <> WHY_NONE
        frWhy := whyCode
        cpWantNeg, cpWantPos := wheelGetOffsets(side)
        traceSkip(tid, SEG_FLTRESP, side, CAUSE_FAULT, motorIncre, frReqMode, accelUp, whyCode)
        emitFrTrial(tid, side, motorIncre)
    else
        _, frBrakeOnBase, _ := wheelFaultResponse(side)
        _, frDutyMax, _, _, _ := wheelDriveConstants(side)
        if cellKind == FRC_X3
            frRestWindow(side, slotIdx)                     ' the negative control, measured FIRST (D2)
        frSetErr := wheelSetFaultResponse(side, frMode, frBrakePct)
        if frReqMode == MODE_BRAKE
            wheelHold(side, TRUE)
        frCapture(side, slotIdx, motorIncre)
        bTimedOut := (cpWhy == WHY_STEADY_TIMEOUT)
        frReadAfter(side)                                   ' reads only: the driver as the fault left it
        frRestore(side, slotIdx)                            ' I11: before anything is drained or judged
        traceEmitCapture(SEG_FLTRESP, side, tid, CAUSE_FAULT, motorIncre, frReqMode, accelUp)
        if bCpFrozen
            frStats(slotIdx)
        frClassify()
        emitFrTrial(tid, side, motorIncre)
        emitFrResults(tid, side, slotIdx, motorIncre)
        frFold(slotIdx)
        frSrFold(slotIdx)                                   ' task 3621: the stop reason and the events frReadAfter() read
        if isWheelUp(side)
            traceRecover(SEG_FLTRESP, side, tid, motorIncre, FAULT_COOL_MS)
        else
            waitBeat(FAULT_COOL_MS, CP_LOOP_COOL)           ' stopped by a guard or an abort: nothing to recover, the same cool
        frRestoreCheck(tid, side, slotIdx)                  ' a lifetime a guard or an abort ended prints NA, not judged
    bInstIdle()
    wheelStop(side)
    segItems := (segItems + 1) <# LIM_SMALL
    if bTimedOut and (bFrProbed == FALSE)
        frRecoverProbe(tid, side)                           ' PL-120: once per run, before the next trial

#endif

#ifdef DBG_FRPLAT
PRI frStagingReset(cellKind, speedIdx, brakeIdx)
' Clear the trial staging, and name the trial's fault response, brake % and stop request from its X-cell.
'
' @param cellKind - FRC_* value
' @param speedIdx - 0..FR_SPEEDS-1
' @param brakeIdx - X-6: 0..FR_BRAKE_STEPS-1 into frBrakePcts

    frCell := cellKind
    frSpeedIdx := speedIdx
    frBrakeIdx := brakeIdx
    frBrakePct := FR_BRAKE_PCT
    if cellKind == FRC_X6
        frBrakePct := frBrakePcts[brakeIdx]
    frMode := wheelL.FR_SHIPPED
    if (cellKind == FRC_X4) or (cellKind == FRC_X6) or (cellKind == FRC_X6C)
        frMode := wheelL.FR_GRADED
    frReqMode := MODE_FLOAT
    if (cellKind == FRC_X2) or (cellKind == FRC_X6)
        frReqMode := MODE_BRAKE
    frSetErr := NO_ERROR
    frOutcome := FRO_NOT_RUN
    frOutcome2 := FRO_NOT_RUN
    frForceErr := NO_ERROR
    frForceErr2 := NO_ERROR
    bFrForced := FALSE
    frMarkMs := getms()
    frGuardPkMv := 0
    frCaptureSafe := SAFE_NONE
    frBrakeOnBase := 0
    frResyncBase := 0
    frResyncAfter := 0
    bFrReadsValid := FALSE
    frCause := wheelL.FC_NONE
    frPath := FRP_NONE
    frWhy := WHY_NONE
    frPreWhy := WHY_NONE
    frDutyMax := 0
    bFrRestUp := FALSE
    frRestErr := NO_ERROR
    frWinReset(FRW_PRE)
    frStatReset()

PRI frStatReset()
' Clear the capture's readings and its two post-fault phase windows (the pre-spin-up window is the trial's own).

    bFrPreValid := FALSE
    frPreX10 := 0
    frPreIX10 := 0
    frPreDuty := 0
    bFrFltFound := FALSE
    frFltJ := 0
    bFrFlt2Found := FALSE
    frFlt2J := 0
    frRefJ := 0
    bFrRestFound := FALSE
    frRestJ := 0
    frTicksRest := 0
    frRestMs := 0
    frT1 := 0
    frT2 := 0
    bFrPkValid := FALSE
    frPkI := 0
    frPkK := 0
    bFrSawSpinDn := FALSE
    bFrSawFaulted := FALSE
    frStEnd := DCS_UNKNOWN
    frWinReset(FRW_MOVE)
    frWinReset(FRW_REST)

PRI frWinReset(winIdx) | phaseIdx
' Clear one phase window.
'
' @param winIdx - FRW_* value
'
' @local phaseIdx - 0..FR_PHASES-1

    bFrWinValid[winIdx] := FALSE
    frWinN[winIdx] := 0
    frWinTicks[winIdx] := 0
    repeat phaseIdx from 0 to FR_PHASES - 1
        frWinPp[(winIdx * FR_PHASES) + phaseIdx] := 0
        frWinX[(winIdx * FR_PHASES) + phaseIdx] := 0

#endif

#ifdef DBP_FAULTRESP
PRI frRestWindow(side, slotIdx) | winStartTotal, winEndTotal, startJ, endJ
' X-3's negative control, measured FIRST (D2): the three phases over FR_REST_WIN_MS with the wheel at rest and the
' bridge floated, before anything is commanded. The coast's own at-rest tail (FRW_REST) is its second instance. Both
' must read flat, or R19-DUAL-RESTFLAT-X fails -- a channel that swings with nothing turning would otherwise pass X-3
' on noise. The window is delimited by two instrument-recorded ring totals (sec 12.7).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param slotIdx - motor slot
'
' @local winStartTotal - ring total at the window start
' @local winEndTotal - ring total at the window end
' @local startJ - logical index of the window's first sample
' @local endJ - logical index of its last

    frPreWhy := WHY_INST_NOACK
    if bInstArm(INST_SRC_WHEELS, 1)
        winStartTotal := instMarkIndex()
        waitWatched(side, FR_REST_WIN_MS, CP_LOOP_ZERO, UNTIL_TIME)
        winEndTotal := instMarkIndex()
        if bInstFreeze(0)
            drainBegin()
            if (winStartTotal >= 0) and (winEndTotal > winStartTotal) and (drStored > 0)
                startJ := (winStartTotal - drLostHead) #> 0
                endJ := (winEndTotal - 1 - drLostHead) <# (drStored - 1)
                frPhaseWindow(FRW_PRE, slotIdx, startJ, endJ)
            frPreWhy := WHY_NO_SAMPLES
            if bFrWinValid[FRW_PRE]
                frPreWhy := WHY_NONE
        bInstIdle()

PRI frCapture(side, slotIdx, motorIncre) | safeEvent, bReached, bRest, captureLeftMs
' A wheel trial's motion and capture, shaped as eventCapture()'s fault path: arm; command; AT_SPEED (<=
' LADDER_STEADY_MS, the high rung's spin-up from rest; frWaitAtSpeed(), which dumps the driver once, where NOMOTION, when
' no hall tick has come by FR_NOMOTION_MS -- PL-120); settle SETTLE_MS; read the re-sync count at speed; the guarded
' forced fault (frProvoke()) and, for X-6 / X6C, the second on its ramp (frForceSecond()); a fault is the event, so
' the capture then runs until rest or traceCaptureMs(1) without ending on it; freeze. Fills the cp* staging, as
' eventCapture() does, so traceEmitCapture() emits it as it emits every other trace. The offsets are read only for
' the trace header.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param slotIdx - motor slot
' @param motorIncre - signed increment
'
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - AT_SPEED was reached
' @local bRest - rest was confirmed
' @local captureLeftMs - capture bound still owed after the forced fault

    safeEvent := SAFE_NONE
    bReached := FALSE
    cpWantNeg, cpWantPos := wheelGetOffsets(side)
    if bInstArm(INST_SRC_WHEELS, 1) == FALSE
        cpWhy := WHY_INST_NOACK
    else
        wheelCommand(side, motorIncre)
        safeEvent, bReached := frWaitAtSpeed(side, slotIdx)     ' waitWatched()'s AT_SPEED wait, plus the NOMOTION dump
        if (safeEvent == SAFE_NONE) and bReached
            safeEvent, _ := waitWatched(side, SETTLE_MS, CP_LOOP_SETTLE, UNTIL_TIME)
        if safeEvent <> SAFE_NONE
            cpWhy := safeWhy(safeEvent)
            cpEnd := safeEnd(safeEvent)
            bCpFaultSeen := (safeEvent == SAFE_FAULT)
        elseif bReached == FALSE
            cpWhy := WHY_STEADY_TIMEOUT
            frFailMs := getms()                                 ' PL-120: the recovery probe's tries count from here
            abiDumpWheel(side, ABIW_TIMEOUT)                    ' PL-120: the failing lifetime's driver, still commanded
        else
            _, _, frResyncBase := wheelFaultResponse(side)
            frOutcome := frProvoke(side, slotIdx, FALSE)
            if frOutcome == FRO_FAULT
                bCpFaultSeen := TRUE
                if (frCell == FRC_X6) or (frCell == FRC_X6C)
                    frOutcome2 := frForceSecond(side, slotIdx)
                if frOutcome2 == FRO_ABORT_I
                    frCaptureSafe := SAFE_ABS_ABORT
                    cpEnd := TEND_ABORT
                else
                    captureLeftMs := (traceCaptureMs(1) - (getms() - frMarkMs)) #> 0
                    safeEvent, bRest := waitRest(side, captureLeftMs, FALSE)
                    frCaptureSafe := safeEvent
                    cpEnd := TEND_TIMEOUT
                    if bRest
                        cpEnd := TEND_REST
                    if safeEvent <> SAFE_NONE
                        cpEnd := safeEnd(safeEvent)
            elseif frOutcome == FRO_ABORT_I
                cpWhy := WHY_ABORTED
                cpEnd := TEND_ABORT
            else
                cpWhy := WHY_NO_FAULT
                cpEnd := TEND_ABORT
        bCpFrozen := bInstFreeze(0)
        if (bCpFrozen == FALSE) and (cpWhy == WHY_NONE)
            cpWhy := WHY_INST_NOACK

PRI frWaitAtSpeed(side, slotIdx) : safeEvent, bReached
' A FLTRESP trial's wait for its wheel to reach speed: waitWatchedNoMo()'s AT_SPEED wait of LADDER_STEADY_MS, which is
' waitWatched(side, LADDER_STEADY_MS, CP_LOOP_ATSPEED, UNTIL_AT_SPEED) pass for pass with PL-120's NOMOTION dump added.
' Until SRC_REV 46 that loop lived here; PL-136 moved it, unchanged, into waitWatchedNoMo() so PREFLT's nudge dumps by
' the same mechanism.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param slotIdx - its motor slot
' @returns safeEvent - SAFE_* that ended the wait, SAFE_NONE otherwise
' @returns bReached - TRUE when the mirror read DCS_AT_SPEED

    safeEvent, bReached, _ := waitWatchedNoMo(side, slotIdx, LADDER_STEADY_MS, CP_LOOP_ATSPEED, UNTIL_AT_SPEED)
#endif

#ifdef DBG_PREFLT
PRI waitWatchedNoMo(side, slotIdx, durationMs, cpId, untilKind) : safeEvent, bReached, bDumped | startMs, basePos, baseHw, bBaseTaken, bTicked
' A commanded wheel's watched wait with PL-120's NOMOTION dump: waitWatched(side, durationMs, cpId, untilKind) pass for
' pass -- one safetyReset(), a beat and a SAMPLE_MS wait every pass, the same safety poll and the same ends -- plus,
' once FR_NOMOTION_MS has passed since the wait began (the command was sent just before it) and neither the mirrored
' driver pos nor the instrument's own hall count has changed, the wheel's driver runs dumped once (abiDumpWheel(), where
' NOMOTION) while the drive is still on; the wait then carries on to its own end. The baseline is the mirror on the
' first pass, SAMPLE_MS after the command, so it is a post-ARM sample. The dump's reads are hub reads of the driver's
' own runs, as the TIMEOUT dump's are; the safety poll resumes on the next pass. Used by FLTRESP's trials
' (frWaitAtSpeed()) and, PL-136, by every PREFLT nudge (bPreflightWheel()).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param slotIdx - its motor slot
' @param durationMs - the wait's bound
' @param cpId - CP_LOOP_* beaten every pass
' @param untilKind - UNTIL_AT_SPEED (ends when the mirror reads DCS_AT_SPEED) or UNTIL_TIME (runs its full bound)
' @returns safeEvent - SAFE_* that ended the wait, SAFE_NONE otherwise
' @returns bReached - UNTIL_AT_SPEED: TRUE when the mirror read DCS_AT_SPEED; UNTIL_TIME: TRUE when the full bound ran
' @returns bDumped - TRUE when the NOMOTION dump was taken
'
' @local startMs - getms() when the wait began
' @local basePos - the mirrored driver pos on the first pass
' @local baseHw - the mirrored hall count on the first pass
' @local bBaseTaken - the baseline has been read
' @local bTicked - pos or the hall count has changed since the baseline

    safetyReset()
    safeEvent := SAFE_NONE
    bReached := FALSE
    basePos := 0
    baseHw := 0
    bBaseTaken := FALSE
    bTicked := FALSE
    bDumped := FALSE
    startMs := getms()
    repeat
        beat(cpId)
#ifdef DBG_PANEL
        panelTick(startMs, durationMs)                      ' PL-152: the panel is compiled into the attended parts only
#endif
        waitms(SAMPLE_MS)
        safeEvent := safetyPoll(side)
#ifdef DBG_PANEL
        if (safeEvent == SAFE_NONE) and bPanelStopPressed()
            safeEvent := SAFE_OPER_STOP
#endif
        if untilKind == UNTIL_AT_SPEED
            bReached := bMirrorAllInState(side, DCS_AT_SPEED)
        if bBaseTaken == FALSE
            basePos := instLastPos[slotIdx]
            baseHw := instLastHw[slotIdx]
            bBaseTaken := TRUE
        elseif (instLastPos[slotIdx] <> basePos) or (instLastHw[slotIdx] <> baseHw)
            bTicked := TRUE
        if (bTicked == FALSE) and (bDumped == FALSE) and (safeEvent == SAFE_NONE) and (bReached == FALSE)
            if (getms() - startMs) >= FR_NOMOTION_MS
                abiDumpWheel(side, ABIW_NOMOTION)
                bDumped := TRUE
        if (safeEvent <> SAFE_NONE) or bReached or ((getms() - startMs) >= durationMs)
            quit
    if untilKind == UNTIL_TIME
        bReached := (safeEvent == SAFE_NONE)
#endif

#ifdef DBG_FRPLAT
PRI frProvoke(side, slotIdx, bSteerForm) : outcome | stopSide
' The forced fault, marked and guarded: the mark, testForceFault() on this wheel only -- through the wheel object or
' the steering object -- and frGuard(). The driver takes it at its own fault test on its next driven frame.
'
' @param side - the wheel faulted: SIDE_LEFT or SIDE_RIGHT
' @param slotIdx - its motor slot
' @param bSteerForm - TRUE through the steering object, FALSE through the wheel object
' @returns outcome - FRO_FAULT, FRO_NO_FAULT or FRO_ABORT_I
'
' @local stopSide - what a guarded stop stops: the wheel, or the whole steering object

    instMark()
    frMarkMs := getms()
    bFrForced := TRUE
    if bSteerForm
        frForceErr := steerForceFault(side)
        stopSide := SIDE_BOTH
    else
        frForceErr := wheelForceFault(side)
        stopSide := side
    outcome := frGuard(slotIdx, stopSide, FALSE, frMarkMs)

#endif

#ifdef DBP_FAULTRESP
PRI frForceSecond(side, slotIdx) : outcome | startMs, markMs
' X-6 and X6C: the SECOND forced fault, on the ramp the first one's re-sync began. Wait (<= FR_SECOND_WAIT_MS) for the
' mirror to read DCS_SPIN_DN, then force again and guard it: the driver's pending re-synced stop (DRIVER_REV 12) sends
' it to the fallback -- BR_BRAKE at the trial's brake % in SM_BRAKE, a coast in SM_FLOAT -- which reads DCS_FAULTED.
' No new mark: the trace keeps the first fault's, and frStats() finds the second from the state.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param slotIdx - motor slot
' @returns outcome - FRO_FAULT (DCS_FAULTED read), FRO_NO_FAULT (not, inside FR_PROVOKE_MS) or FRO_ABORT_I
'
' @local startMs - getms() when the wait for SPIN_DN began
' @local markMs - getms() at the second force

    startMs := getms()
    repeat
        beat(CP_LOOP_CAPTURE)
        if (instLastState[slotIdx] == DCS_SPIN_DN) or ((getms() - startMs) >= FR_SECOND_WAIT_MS)
            quit
    markMs := getms()
    frForceErr2 := wheelForceFault(side)
    outcome := frGuard(slotIdx, side, TRUE, markMs)

#endif

#ifdef DBG_FRPLAT
PRI frGuard(slotIdx, stopSide, bSecond, markMs) : outcome
' THE FORCED FAULT'S GUARD (see this section's CON). For FR_PROVOKE_MS after markMs, read the instrument's mirror with no
' wait between reads. The first fault ends the guard on the fault latch; X-6's second on the state reading
' DCS_FAULTED (the latch is already set). A single read at or over ABS_ABORT_MV stops at once what stopSide names --
' the wheel, or the whole steering object -- and records BM-ABORT ABS_CURRENT. A first fault that did not latch is a
' failure of the HOOK: the wheel is stopped too (it is driving on with a request outstanding) and BM-ABORT NO_FAULT
' recorded. A second that did not go FAULTED leaves the wheel ramping under control, so nothing is stopped: BM-FRTRIAL's
' second field and R19-DUAL-BLUNT-X carry it. The standard absolute abort stays in force for the rest of every capture.
'
' @param slotIdx - the faulted wheel's slot
' @param stopSide - SIDE_LEFT, SIDE_RIGHT or SIDE_BOTH
' @param bSecond - TRUE for X-6's second fault
' @param markMs - getms() just before the force
' @returns outcome - FRO_FAULT, FRO_NO_FAULT or FRO_ABORT_I

    outcome := FRO_NO_FAULT
    frGuardPkMv #>= 0
    repeat
        beat(CP_LOOP_CAPTURE)
        if instLastUp[slotIdx] <> FALSE
            frGuardPkMv #>= instLastI[slotIdx]
            if (bSecond == FALSE) and (instLastFault[slotIdx] <> FALSE)
                outcome := FRO_FAULT
                quit
            if bSecond and (instLastState[slotIdx] == DCS_FAULTED)
                outcome := FRO_FAULT
                quit
            if instLastI[slotIdx] >= ABS_ABORT_MV
                outcome := FRO_ABORT_I
                quit
        if (getms() - markMs) >= FR_PROVOKE_MS
            quit
    if outcome == FRO_ABORT_I
        abortStopMotor(stopSide, slotIdx)
        emitAbort(curSeg, curTid, stopSide, curIncre, ABR_ABS_CURRENT, frGuardPkMv, SCOPE_TRIAL)
    elseif (outcome == FRO_NO_FAULT) and (bSecond == FALSE)
        abortStopMotor(stopSide, slotIdx)
        emitAbort(curSeg, curTid, stopSide, curIncre, ABR_NO_FAULT, frGuardPkMv, SCOPE_TRIAL)

#endif

#ifdef DBP_FAULTRESP
PRI frReadAfter(side)
' The reads that must see the driver as the fault left it, after the freeze and before any restore or recovery: the
' re-sync count (testGetFaultResponse()), the cause (getFaultCause()), and (task 3621) the stop reason and this
' lifetime's event log, drained (BM-EV, then BM-SR). A driver an abort stopped gives none.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    bFrReadsValid := isWheelUp(side)
    if bFrReadsValid
        _, _, frResyncAfter := wheelFaultResponse(side)
        frCause := wheelFaultCause(side)
        frSr := wheelStopReason(side)
        evDrain(EVSRC_LEFT + (side - SIDE_LEFT), EVST_FRTRIAL)
        emitSr(EVST_FRTRIAL, side, frSr, frSr, side == SIDE_LEFT, side == SIDE_RIGHT)

PRI frSrFold(slotIdx) | bJudged, nStops, firstStop, secondStop, bOk
' Fold one FLTRESP trial into R20-DUAL-SR-FAULT and R20-DUAL-SR-FLOST (task 3621, DRIVER-REPORTING-DESIGN.md SS6), from
' frReadAfter()'s stop reason and drain. Judged only when the trial's fault -- and X-6's / X6C's second -- latched and
' the reads were taken from a running driver. Each reading is exact: the stop reason, the EV_STOP sequence and the
' fault events' counts, on a clean drain.
'  X-4        - SR_FAULT_CONTROLLED; one EV_STOP of it; one EV_FAULT_RESYNC, value FC_LAG; no EV_FAULT. SR-FAULT's
'               positive, and SR-FLOST's negative (it must not read SR_FAULT_LOST)
'  X-2, X-3   - SR_FAULT_LOST; one EV_STOP of it; one EV_FAULT. SR-FLOST's positives; X-2 is also SR-FAULT's negative
'               (it must not read SR_FAULT_CONTROLLED)
'  X-6, X6C   - the escalation: SR_FAULT_LOST; EV_STOP SR_FAULT_CONTROLLED then SR_FAULT_LOST; one EV_FAULT_RESYNC and one
'               EV_FAULT. SR-FLOST's positives
'
' @param slotIdx - motor slot (its log index too)
'
' @local bJudged - the trial can be judged
' @local nStops - EV_STOP events in the drain
' @local firstStop - the first EV_STOP's value
' @local secondStop - the second's
' @local bOk - the positive reading held

    bJudged := bFrReadsValid and (frOutcome == FRO_FAULT)
    if (frCell == FRC_X6) or (frCell == FRC_X6C)
        bJudged &= (frOutcome2 == FRO_FAULT)
    if bJudged
        nStops := evCount(slotIdx, wheelL.EV_STOP)
        firstStop := evSeqAt(slotIdx, EVQ_STOP, 0)
        secondStop := evSeqAt(slotIdx, EVQ_STOP, 1)
        case frCell
            FRC_X4:
                bOk := bEvdClean() and (frSr == wheelL.SR_FAULT_CONTROLLED) and (nStops == 1) and (firstStop == wheelL.SR_FAULT_CONTROLLED)
                bOk &= (evCount(slotIdx, wheelL.EV_FAULT_RESYNC) == 1) and (evSum(slotIdx, wheelL.EV_FAULT_RESYNC) == wheelL.FC_LAG) and (evCount(slotIdx, wheelL.EV_FAULT) == 0)
                srFaultNote(slotIdx, TRUE, bOk)
                srLostNote(slotIdx, FALSE, frSr <> wheelL.SR_FAULT_LOST)
            FRC_X2, FRC_X3:
                bOk := bEvdClean() and (frSr == wheelL.SR_FAULT_LOST) and (nStops == 1) and (firstStop == wheelL.SR_FAULT_LOST)
                bOk &= (evCount(slotIdx, wheelL.EV_FAULT) == 1)
                srLostNote(slotIdx, TRUE, bOk)
                if frCell == FRC_X2
                    srFaultNote(slotIdx, FALSE, frSr <> wheelL.SR_FAULT_CONTROLLED)
            other:
                bOk := bEvdClean() and (frSr == wheelL.SR_FAULT_LOST) and (nStops == 2) and (firstStop == wheelL.SR_FAULT_CONTROLLED)
                bOk &= (secondStop == wheelL.SR_FAULT_LOST) and (evCount(slotIdx, wheelL.EV_FAULT_RESYNC) == 1) and (evCount(slotIdx, wheelL.EV_FAULT) == 1)
                srLostNote(slotIdx, TRUE, bOk)

PRI srFaultNote(slotIdx, bPositive, bOk)
' Count one instance of R20-DUAL-SR-FAULT.
'
' @param slotIdx - motor slot
' @param bPositive - TRUE for X-4, FALSE for a negative (X-2, HOOKREST)
' @param bOk - the instance read as pre-registered

    sfSrFaultN[slotIdx] := (sfSrFaultN[slotIdx] + 1) <# LIM_SMALL
    if bOk == FALSE
        sfSrFaultBad[slotIdx] := (sfSrFaultBad[slotIdx] + 1) <# LIM_SMALL
    if bPositive
        bSfSrFaultPos[slotIdx] := TRUE
    else
        bSfSrFaultNeg[slotIdx] := TRUE

PRI srLostNote(slotIdx, bPositive, bOk)
' Count one instance of R20-DUAL-SR-FLOST.
'
' @param slotIdx - motor slot
' @param bPositive - TRUE for X-2, X-3, X-6, X6C; FALSE for X-4, the negative
' @param bOk - the instance read as pre-registered

    sfSrLostN[slotIdx] := (sfSrLostN[slotIdx] + 1) <# LIM_SMALL
    if bOk == FALSE
        sfSrLostBad[slotIdx] := (sfSrLostBad[slotIdx] + 1) <# LIM_SMALL
    if bPositive
        bSfSrLostPos[slotIdx] := TRUE
    else
        bSfSrLostNeg[slotIdx] := TRUE

PRI frRestore(side, slotIdx)
' I11: undo every side effect of the trial before anything is drained or judged -- the fault response to FR_SHIPPED at
' FR_BRAKE_PCT, and the stop mode to FLOAT. The offsets are never touched in this part. A driver an abort stopped needs
' neither, since its next start re-inits both (and drops any forced fault still pending).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param slotIdx - motor slot

    bFrRestUp := isWheelUp(side)
    if bFrRestUp
        frRestErr := wheelSetFaultResponse(side, wheelL.FR_SHIPPED, FR_BRAKE_PCT)
    if bBrakeRequested[slotIdx]
        restoreStopMode(side)

PRI frRestoreCheck(tid, side, slotIdx) | eMode, nBrakeOn, eHold, bMeasured, bOk
' Read the restores back once the wheel is at rest after its recovery, print BM-FRREST and fold R19-DUAL-FRREST-X: the
' fault response reads FR_SHIPPED with this lifetime's own brake_on, and the hold reads HS_OFF -- which it can only
' do at rest in SM_FLOAT, since SM_BRAKE at rest holds (R19.1). The library has no stop-mode getter, so the hold
' status is the stop mode's read-back. A lifetime a guard or an abort ended is printed NA and not judged.
'
' @param tid - trace id of the trial
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param slotIdx - motor slot
'
' @local eMode - the fault response read back
' @local nBrakeOn - the graded short's shorted frames per period, read back
' @local eHold - the hold status read back
' @local bMeasured - the restores went to a driver that is still running
' @local bOk - all three held

    eMode := wheelL.FR_SHIPPED
    nBrakeOn := 0
    eHold := wheelL.HS_OFF
    bOk := FALSE
    bMeasured := bFrRestUp and isWheelUp(side)
    if bMeasured
        eMode, nBrakeOn, _ := wheelFaultResponse(side)
        eHold := wheelHoldStatus(side)
        bOk := (frRestErr == NO_ERROR) and (eMode == wheelL.FR_SHIPPED) and (nBrakeOn == frBrakeOnBase) and (eHold == wheelL.HS_OFF)
        sfFrRestN[slotIdx] := (sfFrRestN[slotIdx] + 1) <# LIM_SMALL
        if bOk == FALSE
            sfFrRestBad[slotIdx] := (sfFrRestBad[slotIdx] + 1) <# LIM_SMALL
    emitFrRest(tid, side, eMode, nBrakeOn, eHold, bMeasured, bOk)

PRI frRecoverProbe(tid, side)
' PL-120's RECOVERY probe at FLTRESP (this part's CON note), run once per run, after the first FLTRESP trial that ended
' STEADY_TIMEOUT and before the next trial: probeRun() on that wheel from the failure (frFailMs), its summary kept for
' BM-FRRECSUM's probed .. ms and why. PL-136's PREFLT probe (bPfProbe()) is separate and does not take this one's turn.
'
' @param tid - trace id of the failed trial
' @param side - its wheel: SIDE_LEFT or SIDE_RIGHT

    bFrProbed := TRUE
    frProbeTid := tid
    frProbeSide := side
    bFrRecovered, frProbeTries, frRecTry, frRecMs, frProbeWhy := probeRun(SEG_FLTRESP, tid, side, frFailMs)

PRI probeRun(seg, tid, side, failMs) : bRecovered, nTries, recTry, recMs, whyCode | slotIdx, tryIdx, bMoved
' PL-120's recovery probe itself, from FLTRESP (frRecoverProbe()) or, PL-136, from PREFLT (bPfProbe()): up to
' FR_RECOVER_TRIES tries on the wheel, try n starting n x FR_RECOVER_GAP_MS after failMs, each its own driver lifetime
' (bFrRecoverTry(), one BM-FRRECOV each, its seg naming the stage). It ends at the first try that moves, on a run cap
' (bRunContinue(): why ABORTED), or when the wheel is retired (why MOTOR_RETIRED). Every wait is beat-polled (waitBeat(),
' and waitWatched() inside a try), so the watchdog is fed throughout; the worst case is FR_RECOVER_TRIES x
' FR_RECOVER_GAP_MS (2 minutes) plus the last try's lifetime (about 8 s: the start and its zero, the drive, the stop
' bound). Unchanged from SRC_REV 44's frRecoverProbe() but for seg and failMs, which were SEG_FLTRESP and frFailMs.
'
' @param seg - SEG_FLTRESP or SEG_PREFLT: the stage the probe runs in
' @param tid - trace id of the failed trial or nudge
' @param side - its wheel: SIDE_LEFT or SIDE_RIGHT
' @param failMs - getms() at the failure the tries are timed from
' @returns bRecovered - TRUE when a try moved the wheel
' @returns nTries - tries made
' @returns recTry - the try that moved it, 1-based; 0 when none did
' @returns recMs - its ms from the failure to its command; 0 when none did
' @returns whyCode - what ended the probe short: WHY_NONE, WHY_ABORTED or WHY_MOTOR_RETIRED
'
' @local slotIdx - motor slot
' @local tryIdx - 1..FR_RECOVER_TRIES
' @local bMoved - the try moved

    slotIdx := side - SIDE_LEFT
    bRecovered := FALSE
    nTries := 0
    recTry := 0
    recMs := 0
    whyCode := WHY_NONE
    repeat tryIdx from 1 to FR_RECOVER_TRIES
        beat(CP_LOOP_POLL)
        if bRunContinue(seg) == FALSE
            whyCode := WHY_ABORTED
            quit
        if bSlotRetired[slotIdx]
            whyCode := WHY_MOTOR_RETIRED
            quit
        waitBeat(((tryIdx * FR_RECOVER_GAP_MS) - (getms() - failMs)) #> 0, CP_LOOP_REST)
        if bRunContinue(seg) == FALSE
            whyCode := WHY_ABORTED
            quit
        bMoved := bFrRecoverTry(seg, tid, side, tryIdx, failMs)
        nTries := tryIdx
        if bMoved
            bRecovered := TRUE
            recTry := tryIdx
            recMs := frTryMs
            quit

PRI bFrRecoverTry(seg, tid, side, tryIdx, failMs) : bMoved | slotIdx, motorIncre, safeEvent, ticksMoved, hwMoved, bMeasured, whyCode, lastJ, sampleIdx, pkPh, pkI, bPkValid
' One recovery try, on bPreflightWheel()'s shape: start the wheel alone (bWheelStart(), a fresh lifetime as every
' trial's is), arm the instrument, command FR_RECOVER_INCRE NEG for FR_RECOVER_DRIVE_MS, zero, wait stopped
' (<= STOP_TIMEOUT_MS), freeze; the driver pos and hall-count deltas across the capture, and over its up samples the
' largest phase sum smpPh() and sense_i smpI() -- BM-TS's ph and i, from the same ring. A fault is counted toward the run
' cap and cooled FAULT_COOL_MS; the lifetime then ends (wheelStop()), which discards it. Emits BM-FRRECOV.
'
' @param seg - SEG_FLTRESP or SEG_PREFLT: the stage the probe runs in
' @param tid - trace id of the failed trial
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param tryIdx - 1..FR_RECOVER_TRIES
' @param failMs - getms() at the failure this try is timed from
' @returns bMoved - TRUE when the driver's pos changed across the capture
'
' @local slotIdx - motor slot
' @local motorIncre - the try's signed increment
' @local safeEvent - SAFE_* from the watched waits
' @local ticksMoved - driver pos delta over the capture
' @local hwMoved - the instrument's hall-count delta over it
' @local bMeasured - the deltas are measurements
' @local whyCode - first cause of any NA, or what ended the drive early
' @local lastJ - logical index of the last drained sample
' @local sampleIdx - logical index
' @local pkPh - the largest phase sum over the up samples, mV
' @local pkI - the largest sense_i over them, mV
' @local bPkValid - an up sample was stored

    slotIdx := side - SIDE_LEFT
    motorIncre := FR_RECOVER_INCRE * SIGN_NEG
    bMoved := FALSE
    bMeasured := FALSE
    ticksMoved := 0
    hwMoved := 0
    pkPh := 0
    pkI := 0
    bPkValid := FALSE
    whyCode := WHY_NONE
    safeEvent := SAFE_NONE
    frTryMs := getms() - failMs
    if bWheelStart(seg, side) == FALSE
        whyCode := stWhy
    elseif bInstArm(INST_SRC_WHEELS, 1) == FALSE
        whyCode := WHY_INST_NOACK
    else
        instMark()
        frTryMs := getms() - failMs
        wheelCommand(side, motorIncre)
        safeEvent, _ := waitWatched(side, FR_RECOVER_DRIVE_MS, CP_LOOP_CAPTURE, UNTIL_TIME)
        wheelCommand(side, 0)
        if safeEvent == SAFE_NONE
            safeEvent, _ := waitWatched(side, STOP_TIMEOUT_MS, CP_LOOP_STOPPED, UNTIL_STOPPED)
        if bInstFreeze(0)
            drainBegin()
            if drStored > 1
                lastJ := drStored - 1
                ticksMoved := smpPos(lastJ, slotIdx) - smpPos(0, slotIdx)
                hwMoved := smpHw(lastJ, slotIdx) - smpHw(0, slotIdx)
                bMeasured := TRUE
                repeat sampleIdx from 0 to lastJ
                    beat(CP_LOOP_DRAIN)
                    if bSmpUp(sampleIdx, slotIdx)
                        if bPkValid
                            pkPh #>= smpPh(sampleIdx, slotIdx)
                            pkI #>= smpI(sampleIdx, slotIdx)
                        else
                            pkPh := smpPh(sampleIdx, slotIdx)
                            pkI := smpI(sampleIdx, slotIdx)
                            bPkValid := TRUE
            else
                whyCode := WHY_NO_SAMPLES
        else
            whyCode := WHY_INST_NOACK
        if (whyCode == WHY_NONE) and (safeEvent <> SAFE_NONE)
            whyCode := safeWhy(safeEvent)
        if safeEvent == SAFE_INST_STALL
            emitAbort(seg, tid, side, motorIncre, ABR_INST_STALLED, INST_STALL_MS, SCOPE_TRIAL)
        if safeEvent == SAFE_FAULT
            runFaults := (runFaults + 1) <# LIM_BIG
            waitBeat(FAULT_COOL_MS, CP_LOOP_COOL)
    bMoved := bMeasured and (ticksMoved <> 0)
    emitFrRecov(seg, tid, side, tryIdx, ticksMoved, hwMoved, bMeasured, pkPh, pkI, bPkValid, whyCode)
    bInstIdle()
    wheelStop(side)

PRI frStats(slotIdx) | sampleIdx, preStartJ, preEndJ, preTicks, preMs, iSum, dutySum, upCount, midJ, endJ, eState, restWinJ
' The trial's readings from its frozen capture, after bTraceDrain() located the mark and rest: the wheel's rate,
' current and duty over FR_PRE_SAMPLES before the mark; the first sample carrying the fault latch; the states seen
' after it; the reference (that sample, or for X-6 / X6C the first DCS_FAULTED one, where the fallback begins); from
' the reference to rest, ticks and ms, each half's ticks and the largest sense_i; and the MOVE and REST phase windows.
' The REST window opens at the first sample from rest on that reads the driver settled (STOPPED, FAULTED or ESTOP),
' not at the last tick: a re-synced ramp still drives the bridge after the wheel's last tick, and its step to the stop
' mode's bridge read as a p-p swing at rest (PL-124). Legal only while FROZEN (I10).
'
' @param slotIdx - motor slot under test
'
' @local sampleIdx - logical index
' @local preStartJ - first sample of the pre-fault window
' @local preEndJ - its last, the sample before the mark
' @local preTicks - |pos| across it
' @local preMs - its length, ms
' @local iSum - sum of sense_i over its up samples
' @local dutySum - sum of duty over them
' @local upCount - its up samples
' @local midJ - the sample halfway from the fault to rest
' @local endJ - the last sample of the moving window
' @local eState - a sample's driver state
' @local restWinJ - the REST window's first sample: the first settled one from rest on, or past drEndJ when none

    frStatReset()
    if bDrMarkFound and (drEndJ > drMarkJ)
        preStartJ := (drMarkJ - FR_PRE_SAMPLES) #> 0
        preEndJ := drMarkJ - 1
        if preEndJ > preStartJ
            iSum := 0
            dutySum := 0
            upCount := 0
            repeat sampleIdx from preStartJ to preEndJ
                beat(CP_LOOP_DRAIN)
                if bSmpUp(sampleIdx, slotIdx)
                    iSum += smpI(sampleIdx, slotIdx)
                    dutySum += smpDuty(sampleIdx, slotIdx)
                    upCount += 1
            preTicks := abs(smpPos(preEndJ, slotIdx) - smpPos(preStartJ, slotIdx))
            preMs := (smpT(preEndJ) - smpT(preStartJ)) / TICKS_PER_MS
            if (preMs > 0) and (upCount > 0)
                frPreX10 := (preTicks * RATE_X10_SCALE) / preMs
                frPreIX10 := (iSum * X10) / upCount
                frPreDuty := dutySum / upCount
                bFrPreValid := TRUE
        repeat sampleIdx from drMarkJ to drEndJ
            beat(CP_LOOP_DRAIN)
            if bSmpFault(sampleIdx, slotIdx)
                frFltJ := sampleIdx
                bFrFltFound := TRUE
                quit
    if bFrFltFound
        ' the reference: X-6 and X6C are read from their SECOND fault -- the first sample after the first that reads
        '  DCS_FAULTED, where the fallback's bridge begins; every other cell from the first
        frRefJ := frFltJ
        repeat sampleIdx from frFltJ to drEndJ
            beat(CP_LOOP_DRAIN)
            if bSmpUp(sampleIdx, slotIdx)
                eState := smpState(sampleIdx, slotIdx)
                if eState == DCS_SPIN_DN
                    bFrSawSpinDn := TRUE
                if eState == DCS_FAULTED
                    if bFrSawFaulted == FALSE
                        frFlt2J := sampleIdx
                    bFrSawFaulted := TRUE
        if ((frCell == FRC_X6) or (frCell == FRC_X6C)) and bFrSawFaulted
            frRefJ := frFlt2J
            bFrFlt2Found := TRUE
        if bDrRestFound and ((drStartJ + drRestK) >= frRefJ)
            frRestJ := drStartJ + drRestK
            bFrRestFound := TRUE
        endJ := drEndJ
        if bFrRestFound
            endJ := frRestJ
        repeat sampleIdx from frRefJ to endJ
            beat(CP_LOOP_DRAIN)
            if bSmpUp(sampleIdx, slotIdx) and ((bFrPkValid == FALSE) or (smpI(sampleIdx, slotIdx) > frPkI))
                frPkI := smpI(sampleIdx, slotIdx)
                frPkK := sampleIdx - drStartJ
                bFrPkValid := TRUE
        if bSmpUp(drEndJ, slotIdx)
            frStEnd := smpState(drEndJ, slotIdx)
        if bFrRestFound
            frTicksRest := abs(smpPos(frRestJ, slotIdx) - smpPos(frRefJ, slotIdx))
            frRestMs := (smpT(frRestJ) - smpT(frRefJ)) / TICKS_PER_MS
            midJ := frRefJ + ((frRestJ - frRefJ) / 2)
            frT1 := abs(smpPos(midJ, slotIdx) - smpPos(frRefJ, slotIdx))
            frT2 := abs(smpPos(frRestJ, slotIdx) - smpPos(midJ, slotIdx))
            frPhaseWindow(FRW_MOVE, slotIdx, frRefJ + FR_SETTLE_SAMPLES, frRestJ - 1)
            restWinJ := drEndJ + 1                                          ' PL-124: none settled leaves REST unmeasured
            repeat sampleIdx from frRestJ to drEndJ
                beat(CP_LOOP_DRAIN)
                if bSmpUp(sampleIdx, slotIdx)
                    eState := smpState(sampleIdx, slotIdx)
                    if (eState == DCS_STOPPED) or (eState == DCS_FAULTED) or (eState == DCS_ESTOP)
                        restWinJ := sampleIdx
                        quit
            if restWinJ <= drEndJ
                frPhaseWindow(FRW_REST, slotIdx, restWinJ, drEndJ)
        else
            frPhaseWindow(FRW_MOVE, slotIdx, frRefJ + FR_SETTLE_SAMPLES, drEndJ)

PRI frPhaseWindow(winIdx, slotIdx, startJ, endJ) | sampleIdx, phaseIdx, phaseMv, upCount, sumMv[FR_PHASES], minMv[FR_PHASES], maxMv[FR_PHASES], lastSide[FR_PHASES], meanMv
' One phase window's readings from drained samples: per phase, the peak-to-peak and the number of crossings of its
' own mean -- a sample leaving the band mean +/- FR_XING_BAND_MV on the side opposite the one it last left from --
' and the hall ticks across the window. Two passes: the means first, then the crossings. Up samples only (I3).
'
' @param winIdx - FRW_* value
' @param slotIdx - motor slot
' @param startJ - first logical index of the window
' @param endJ - last logical index of the window
'
' @local sampleIdx - logical index
' @local phaseIdx - 0..FR_PHASES-1 (U, V, W)
' @local phaseMv - one phase reading, mV
' @local upCount - up samples in the window
' @local sumMv - per-phase sum, |sum| <= 32_767 x 4_096
' @local minMv - per-phase least reading
' @local maxMv - per-phase greatest reading
' @local lastSide - per phase, the side of the band last left: -1 below, +1 above, 0 not yet
' @local meanMv - a phase's mean over the window

    frWinReset(winIdx)
    if (startJ >= 0) and (endJ > startJ) and (endJ < drStored)
        upCount := 0
        repeat phaseIdx from 0 to FR_PHASES - 1
            sumMv[phaseIdx] := 0
            minMv[phaseIdx] := POSX
            maxMv[phaseIdx] := NEGX
            lastSide[phaseIdx] := 0
        repeat sampleIdx from startJ to endJ
            beat(CP_LOOP_DRAIN)
            if bSmpUp(sampleIdx, slotIdx)
                upCount += 1
                repeat phaseIdx from 0 to FR_PHASES - 1
                    phaseMv := frPhaseMv(sampleIdx, slotIdx, phaseIdx)
                    sumMv[phaseIdx] += phaseMv
                    minMv[phaseIdx] <#= phaseMv
                    maxMv[phaseIdx] #>= phaseMv
        if upCount > 1
            repeat phaseIdx from 0 to FR_PHASES - 1
                meanMv := sumMv[phaseIdx] / upCount
                frWinPp[(winIdx * FR_PHASES) + phaseIdx] := maxMv[phaseIdx] - minMv[phaseIdx]
                repeat sampleIdx from startJ to endJ
                    beat(CP_LOOP_DRAIN)
                    if bSmpUp(sampleIdx, slotIdx)
                        phaseMv := frPhaseMv(sampleIdx, slotIdx, phaseIdx)
                        if phaseMv > (meanMv + FR_XING_BAND_MV)
                            if lastSide[phaseIdx] < 0
                                frWinX[(winIdx * FR_PHASES) + phaseIdx] += 1
                            lastSide[phaseIdx] := 1
                        elseif phaseMv < (meanMv - FR_XING_BAND_MV)
                            if lastSide[phaseIdx] > 0
                                frWinX[(winIdx * FR_PHASES) + phaseIdx] += 1
                            lastSide[phaseIdx] := -1
            frWinN[winIdx] := upCount
            frWinTicks[winIdx] := abs(smpPos(endJ, slotIdx) - smpPos(startJ, slotIdx))
            bFrWinValid[winIdx] := TRUE

PRI frPhaseMv(sampleIdx, slotIdx, phaseIdx) : phaseMv
' One phase of a logical sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @param phaseIdx - 0 U, 1 V, 2 W
' @returns phaseMv - mV

    case phaseIdx
        0:
            phaseMv := smpPhU(sampleIdx, slotIdx)
        1:
            phaseMv := smpPhV(sampleIdx, slotIdx)
        other:
            phaseMv := smpPhW(sampleIdx, slotIdx)

PRI bFrWinFlat(winIdx) : bFlat | phaseIdx
' Whether every phase of a window stayed under FR_FLAT_MV peak-to-peak.
'
' @param winIdx - FRW_* value
' @returns bFlat - TRUE when all three are flat
'
' @local phaseIdx - 0..FR_PHASES-1

    bFlat := TRUE
    repeat phaseIdx from 0 to FR_PHASES - 1
        if frWinPp[(winIdx * FR_PHASES) + phaseIdx] >= FR_FLAT_MV
            bFlat := FALSE

PRI frXingExpected(winIdx) : nCrossings
' The crossings a window's hall ticks imply: FR_XING_PER_CYCLE per electrical cycle of HALL_TICKS_PER_CYCLE ticks.
'
' @param winIdx - FRW_* value
' @returns nCrossings - expected crossings per phase

    nCrossings := (frWinTicks[winIdx] * FR_XING_PER_CYCLE) / wheelL.HALL_TICKS_PER_CYCLE

PRI bFrCoastSwings() : bSwings | phaseIdx, xNeed
' X-3's pre-registered reading on the MOVE window: every phase swings at least FR_FLAT_MV peak-to-peak AND crosses its
' mean at least half as often as the hall ticks imply (never fewer than FR_XING_MIN) -- it varies, and at the hall
' rate. Half, because the back-EMF falls with the coast, so the last cycles fall inside the band. FAILS if the phases
' stay flat while the halls tick.
'
' @returns bSwings - TRUE when all three phases swing at the hall rate
'
' @local phaseIdx - 0..FR_PHASES-1
' @local xNeed - the crossings each phase needs

    xNeed := (frXingExpected(FRW_MOVE) / 2) #> FR_XING_MIN
    bSwings := TRUE
    repeat phaseIdx from 0 to FR_PHASES - 1
        if (frWinPp[(FRW_MOVE * FR_PHASES) + phaseIdx] < FR_FLAT_MV) or (frWinX[(FRW_MOVE * FR_PHASES) + phaseIdx] < xNeed)
            bSwings := FALSE

PRI bFrIVisible(slotIdx) : bVisible
' Whether the post-fault peak sense_i stands FR_I_VISIBLE_MV over this lifetime's floated zero -- the DC-link shunt
' saw a current at all (this section's CON: a phase short's current never crosses it).
'
' @param slotIdx - motor slot
' @returns bVisible - TRUE when the peak is a visible current

    bVisible := bFrPkValid and (bLifeZeroValid[slotIdx] <> FALSE) and ((frPkI - (lifeZeroX10[slotIdx] / X10)) >= FR_I_VISIBLE_MV)

PRI frClassify()
' Name what the driver was SEEN to do after the fault (FRP_*, I7), and the first cause of the trial's NA fields.

    frPath := FRP_NONE
    if (frOutcome == FRO_FAULT) and bFrReadsValid and bCpFrozen and bFrFltFound
        if (frResyncAfter - frResyncBase) <= 0
            if bFrSawFaulted
                frPath := FRP_FAULTED
        elseif bFrSawFaulted
            frPath := FRP_RESYNC_FLT
        elseif (frResyncAfter - frResyncBase) == 1
            frPath := FRP_RESYNC
        else
            frPath := FRP_RESYNC_N
    if frWhy == WHY_NONE
        if frOutcome == FRO_NOT_RUN
            frWhy := cpWhy
            if frWhy == WHY_NONE
                frWhy := WHY_NOT_REACHED
        elseif frOutcome == FRO_NO_FAULT
            frWhy := WHY_NO_FAULT
        elseif frOutcome == FRO_ABORT_I
            frWhy := WHY_ABORTED
        elseif bCpFrozen == FALSE
            frWhy := WHY_INST_NOACK
        elseif bFrFltFound == FALSE
            frWhy := WHY_NOT_REACHED
        elseif frCaptureSafe <> SAFE_NONE
            frWhy := safeWhy(frCaptureSafe)
        elseif bFrRestFound == FALSE
            frWhy := WHY_NOT_REACHED

PRI frFold(slotIdx) | arrIdx, bClean, pointIdx
' Fold the trial into its cells. A trial counts only when its forced fault latched, the capture found it, and nothing
' ended the capture early -- a fault that did not latch, or an abort, measured nothing. X-2 and X-3 count only a fault
' the driver answered with DCS_FAULTED (the shipped bridge they are about). Every forced fault that was requested
' counts toward R19-DUAL-FORCED-X, the hook's own reliability.
'
' @param slotIdx - motor slot
'
' @local arrIdx - [slot * FR_SPEEDS + speed] index
' @local bClean - the fault was forced, captured and not cut short
' @local pointIdx - X-6 / X6C: the point in the graded chain, 0 the coast bound

    arrIdx := (slotIdx * FR_SPEEDS) + frSpeedIdx
    bClean := (frOutcome == FRO_FAULT) and bCpFrozen and bFrFltFound and (frCaptureSafe == SAFE_NONE)
    frFoldForced(slotIdx)
    if (frCell == FRC_X6) or (frCell == FRC_X6C)
        ' BLUNT (DRIVER_REV 12): the second fault on a re-synced ramp must read DCS_FAULTED. Judged when the first
        '  latched and re-synced and the second was asked and not cut short by the current trip
        if (frOutcome == FRO_FAULT) and bCpFrozen and bFrFltFound and bFrReadsValid and ((frResyncAfter - frResyncBase) >= 1) and (frOutcome2 <> FRO_NOT_RUN) and (frOutcome2 <> FRO_ABORT_I)
            sfBluntN[slotIdx] := (sfBluntN[slotIdx] + 1) <# LIM_SMALL
            if (frOutcome2 <> FRO_FAULT) or (bFrFlt2Found == FALSE)
                sfBluntBad[slotIdx] := (sfBluntBad[slotIdx] + 1) <# LIM_SMALL
        pointIdx := 0
        if frCell == FRC_X6
            pointIdx := frBrakeIdx + 1
        if bClean and (frOutcome2 == FRO_FAULT) and bFrFlt2Found and bFrRestFound
            frGradedTicks[(slotIdx * FR_GRADED_POINTS) + pointIdx] := frTicksRest
            frGradedMs[(slotIdx * FR_GRADED_POINTS) + pointIdx] := frRestMs
            bFrGradedRan[(slotIdx * FR_GRADED_POINTS) + pointIdx] := TRUE
    case frCell
        FRC_X2:
            if bClean and bFrSawFaulted and bFrPkValid
                frShortPk[arrIdx] := frPkI
                bFrShortPkRan[arrIdx] := TRUE
                bFrShortVis[arrIdx] := bFrIVisible(slotIdx)
            if bClean and bFrSawFaulted and bFrRestFound
                frShortTicks[arrIdx] := frTicksRest
                bFrShortTkRan[arrIdx] := TRUE
        FRC_X3:
            if bClean and bFrSawFaulted and bFrRestFound
                frCoastTicks[arrIdx] := frTicksRest
                bFrCoastTkRan[arrIdx] := TRUE
            if bClean and bFrSawFaulted and bFrWinValid[FRW_MOVE] and (frWinTicks[FRW_MOVE] >= FR_COAST_MIN_TICKS)
                sfCoastN[slotIdx] := (sfCoastN[slotIdx] + 1) <# LIM_SMALL
                if bFrCoastSwings() == FALSE
                    sfCoastBad[slotIdx] := (sfCoastBad[slotIdx] + 1) <# LIM_SMALL
            frFoldRest(slotIdx, FRW_PRE)
            frFoldRest(slotIdx, FRW_REST)
        FRC_X4:
            ' Pre-registered, the re-sync onto the CORRECT offsets: exactly one re-sync (no second fault), FC_LAG, no
            '  DCS_FAULTED, SPIN_DN then STOPPED at the capture's end, the hall rate falling (the first half of the
            '  fault-to-rest interval turns more ticks than the second), and rest reached in FR_RAMP_LO_PCT ..
            '  FR_RAMP_HI_PCT of the configured ramp's time from that speed (frRampPredMs()).
            if bClean and bFrReadsValid
                bSfResyncRan[slotIdx] := TRUE
                bSfResyncOk[slotIdx] := ((frResyncAfter - frResyncBase) == 1) and (frCause == wheelL.FC_LAG) and (bFrSawFaulted == FALSE) and bFrSawSpinDn and (frStEnd == DCS_STOPPED) and bFrRestFound and (frT1 > frT2) and bFrRampInBand()

PRI frFoldForced(slotIdx)
' Fold one requested forced fault into R19-DUAL-FORCED-X: bad when it did not latch inside FR_PROVOKE_MS (the hook
' failed). One that met the current trip first is not the hook's failure and is not counted bad.
'
' @param slotIdx - the faulted wheel's slot

    if bFrForced
        sfForcedN[slotIdx] := (sfForcedN[slotIdx] + 1) <# LIM_SMALL
        if frOutcome == FRO_NO_FAULT
            sfForcedBad[slotIdx] := (sfForcedBad[slotIdx] + 1) <# LIM_SMALL

PRI frRampPredMs() : nMs
' The configured ramp's time to rest from the trial's speed (SRC_REV 59, DRIVER_REV 38): the jerk-limited stop's
' |incre| / RAMP_DEF_ACCEL_DN + RAMP_STOP_EXTRA_PASSES drive passes (v / A + A / J, and the take) at FR_PASSES_PER_SEC.
' 1_088 ms at 80 x 10^6 (the stepped ramp's |incre| / 50_000 gave 836).
'
' @returns nMs - predicted ms from the stop's start to rest

    nMs := ((ladderIncre[frRungIdx[frSpeedIdx]] / RAMP_DEF_ACCEL_DN + RAMP_STOP_EXTRA_PASSES) * MS_PER_SEC) / FR_PASSES_PER_SEC

PRI bFrRampInBand() : bInBand
' Whether the fault-to-rest time sits inside FR_RAMP_LO_PCT .. FR_RAMP_HI_PCT of frRampPredMs().
'
' @returns bInBand - TRUE when rest was found and the time is in the band

    bInBand := bFrRestFound and ((frRestMs * FR_PCT_SCALE) >= (frRampPredMs() * FR_RAMP_LO_PCT)) and ((frRestMs * FR_PCT_SCALE) <= (frRampPredMs() * FR_RAMP_HI_PCT))

PRI frFoldRest(slotIdx, winIdx)
' Fold one at-rest window into R19-DUAL-RESTFLAT-X, X-3's negative control: counted when it held at least
' FR_REST_MIN_SAMPLES samples, and bad when any phase swung FR_FLAT_MV or more.
'
' @param slotIdx - motor slot
' @param winIdx - FRW_PRE or FRW_REST

    if bFrWinValid[winIdx] and (frWinN[winIdx] >= FR_REST_MIN_SAMPLES)
        sfRestN[slotIdx] := (sfRestN[slotIdx] + 1) <# LIM_SMALL
        if bFrWinFlat(winIdx) == FALSE
            sfRestBad[slotIdx] := (sfRestBad[slotIdx] + 1) <# LIM_SMALL

PRI frPlatTrial(side, eMode) | slotIdx, otherIdx, tid, sid, whyCode, safeEvent, bReached, bRest
' X-5 (PL-117, R19.2): one wheel of the steering object faults while both drive, and the OTHER must stop along its ramp
' (the steering object's frontPlatformFaultStop(), DRIVER_REV 9+). Its own steering lifetime: start; set the fault
' response on both wheels; arm on the steering source; driveAtPower(FLTAPI_POWER) on both; AT_SPEED and settle; force a
' fault on {side} ONLY, guarded (frProvoke()); capture until both wheels rest or FR_PLAT_CAPTURE_MS; freeze; stop and
' restore BEFORE any check (I11); BM-STRACE, BM-TS, BM-TRACE-END (primary LEFT, as every steering trace), BM-FRPLAT;
' recover each faulted wheel; stop the steering object.
'
' Pre-registered: one ramp time (FR_PLAT_RAMP_MS) after the fault, the other wheel turns at most FR_PLAT_REST_PCT of its
' pre-fault rate. FAILS when it keeps turning near its commanded rate (about 100 %). NOMEAS unless the forced fault
' latched and the other wheel was turning before it. With either wheel retired (task 3615: PREFLT, or recovery step
' 4) the steering object is never started: BM-FRPLAT prints why MOTOR_RETIRED and the cell NOMEAS.
'
' @param side - the wheel faulted: SIDE_LEFT or SIDE_RIGHT
' @param eMode - FR_SHIPPED (the fault latches) or FR_GRADED (the faulted wheel re-syncs and stops itself)
'
' @local slotIdx - the faulted wheel's slot
' @local otherIdx - the watched wheel's slot
' @local tid - trace id
' @local sid - the steering start's life, 0 when it did not start
' @local whyCode - why the trial measured nothing, WHY_NONE while it runs
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - both wheels reached AT_SPEED
' @local bRest - both wheels were confirmed at rest

    slotIdx := side - SIDE_LEFT
    otherIdx := SLOT_RIGHT - slotIdx
    tid := nextTraceId()
    cpReset()
    frStagingReset(FRC_X3, FR_SPEED_X4, 0)                  ' clears the staging; X-5's own mode and request follow
    frMode := eMode
    frReqMode := MODE_FLOAT
    frPlatReset()
    fltLeftCause := wheelL.FC_NONE
    fltRightCause := wheelL.FC_NONE
    sid := 0
    safeEvent := SAFE_NONE
    whyCode := WHY_NONE
    if bRunContinue(SEG_FLTPLAT) == FALSE
        whyCode := WHY_ABORTED
    elseif bSlotRetired[SLOT_LEFT] or bSlotRetired[SLOT_RIGHT]
        whyCode := WHY_MOTOR_RETIRED                        ' task 3615: X-5 needs both wheels, and a retired one is never driven
    elseif bSteerStart(SEG_FLTPLAT) == FALSE
        whyCode := WHY_NO_COG
    else
        sid := steerLife
        frSetErr := steerSetFaultResponse(eMode, FR_BRAKE_PCT)
        if bInstArm(INST_SRC_STEER, 1) == FALSE
            whyCode := WHY_INST_NOACK
        elseif bSteerDriveBoth(SEG_FLTPLAT, tid, FLTAPI_POWER) == FALSE
            whyCode := WHY_SYNC_PRECOND
        else
            safeEvent, bReached := waitWatched(SIDE_BOTH, D_AT_SPEED_MS, CP_LOOP_ATSPEED, UNTIL_AT_SPEED)
            if (safeEvent == SAFE_NONE) and bReached
                safeEvent, _ := waitWatched(SIDE_BOTH, SETTLE_MS, CP_LOOP_SETTLE, UNTIL_TIME)
            if safeEvent <> SAFE_NONE
                whyCode := safeWhy(safeEvent)
            elseif bReached == FALSE
                whyCode := WHY_STEADY_TIMEOUT
            else
                frOutcome := frProvoke(side, slotIdx, TRUE)
                if frOutcome == FRO_FAULT
                    bCpFaultSeen := TRUE
                    safeEvent, bRest := waitRest(SIDE_BOTH, FR_PLAT_CAPTURE_MS, FALSE)
                    frCaptureSafe := safeEvent
                    cpEnd := TEND_TIMEOUT
                    if bRest
                        cpEnd := TEND_REST
                    if safeEvent <> SAFE_NONE
                        cpEnd := safeEnd(safeEvent)
                elseif frOutcome == FRO_ABORT_I
                    whyCode := WHY_ABORTED
                else
                    whyCode := WHY_NO_FAULT
        bCpFrozen := bInstFreeze(0)
        if frOutcome == FRO_FAULT
            frPlatReport(slotIdx, otherIdx)                 ' task 3621: reads only, as the fault left the platform
        frPlatRestore()                                     ' I11: before anything is drained or judged
    if whyCode <> WHY_NONE
        cpEnd := TEND_ABORT
    emitSTrace(tid, SEG_FLTPLAT, CAUSE_FAULT, FLTAPI_POWER, FLTAPI_POWER, TRUE, 0, MODE_FLOAT, whyCode)
    if bCpFrozen
        bTraceDrain(tid, SLOT_LEFT, SLOT_RIGHT, cpEnd)
        frPlatStats(slotIdx, otherIdx)
    elseif whyCode <> WHY_NONE
        traceEmptyEnd(tid, cpEnd, whyCode)
    else
        traceEmptyEnd(tid, cpEnd, WHY_INST_NOACK)
    frWhy := frPlatWhy(whyCode)
    emitFrPlat(tid, sid, side)
    frPlatFold(otherIdx)
    frFoldForced(slotIdx)
    if bSteerUp
        steerRecoverFault(tid)
    elseif (frOutcome == FRO_NO_FAULT) or (frOutcome == FRO_ABORT_I) or (frCaptureSafe <> SAFE_NONE)
        waitBeat(FAULT_COOL_MS, CP_LOOP_COOL)               ' stopped by a guard or an abort: the same cool-down
    bInstIdle()
    steerStop()
    segItems := (segItems + 1) <# LIM_SMALL

#endif

#ifdef DBG_FRPLAT
PRI frPlatReset()
' Clear X-5's readings of the watched wheel.

    bFrPlatPreValid := FALSE
    bFrPlatPreOk := FALSE
    frPlatPreX10 := 0
    bFrPlatWinValid := FALSE
    frPlatWinX10 := 0
    frPlatPct := 0
    bFrPlatRestFound := FALSE
    frPlatRestJ := 0
    frPlatRestMs := 0
    bFrPlatSpinDn := FALSE

#endif

#ifdef DBP_FAULTRESP
PRI frPlatReport(fSlot, oSlot) | eLeftReason, eRightReason, eFaulted, eOther, eWant, bOk, nPasses, nLate, nMaxTicks, nStackHi, nStackOf, nLateEv
' Task 3621: what the platform reports of one X-5 trial whose forced fault latched, read as the fault left it -- like
' frReadAfter(), reads only, before frPlatRestore() (which stops the platform and would write nothing it could not):
'  R20-DUAL-SR-PARTNER - both getStopReason()s and the drained log (BM-SR, BM-EV). The faulted wheel reads the response's
'                        own reason, SR_FAULT_LOST under FR_SHIPPED (LEFT) or SR_FAULT_CONTROLLED under FR_GRADED (RIGHT),
'                        with one EV_STOP of it; the other reads SR_PARTNER with one EV_STOP of it. The faulted wheel
'                        reading PARTNER, or the other a fault reason, fails; so does an unclean drain
'  R20-DUAL-FRONTST-EV - the steering front cog's loop health over this lifetime, whose worst pass includes the fault pass
'                        and its burst of three events (SS2.3): worst pass at most FRONT_EV_PASS_US, no late pass, stack
'                        under its allocation (BM-FRONTST)
'  R20-T0-EV-LATE      - that late count beside the platform's EV_LATE_PASS total
'
' @param fSlot - the faulted wheel's slot (its log index too)
' @param oSlot - the other wheel's
'
' @local eLeftReason - the left wheel's SR_*
' @local eRightReason - the right wheel's SR_*
' @local eFaulted - the faulted wheel's
' @local eOther - the other wheel's
' @local eWant - the reason the faulted wheel's response gives
' @local bOk - SR-PARTNER's reading held
' @local nPasses - steering front passes since its start
' @local nLate - passes that overran their slot
' @local nMaxTicks - the longest pass body, system ticks
' @local nStackHi - stack longs ever used
' @local nStackOf - the allocation
' @local nLateEv - the platform's EV_LATE_PASS total

    beat(CP_LIB_STEER_QUERY)
    eLeftReason, eRightReason := steering.getStopReason()
    beat(CP_LIB_STEER_QUERY)
    evDrain(EVSRC_STEER, EVST_FRPLAT)
    emitSr(EVST_FRPLAT, SIDE_LEFT + fSlot, eLeftReason, eRightReason, TRUE, TRUE)
    eFaulted := eLeftReason
    eOther := eRightReason
    if fSlot == SLOT_RIGHT
        eFaulted := eRightReason
        eOther := eLeftReason
    eWant := wheelL.SR_FAULT_LOST
    if frMode == wheelL.FR_GRADED
        eWant := wheelL.SR_FAULT_CONTROLLED
    bOk := bEvdClean() and (eFaulted == eWant) and (eOther == wheelL.SR_PARTNER)
    bOk &= (evCount(fSlot, wheelL.EV_STOP) == 1) and (evSeqAt(fSlot, EVQ_STOP, 0) == eWant)
    bOk &= (evCount(oSlot, wheelL.EV_STOP) == 1) and (evSeqAt(oSlot, EVQ_STOP, 0) == wheelL.SR_PARTNER)
    bSfPartRan[fSlot] := TRUE
    bSfPartOk[fSlot] := bOk
    nPasses, nLate, nMaxTicks, nStackHi, nStackOf := dFrontStats(SIDE_BOTH)
    emitFrontSt(SIDE_BOTH, nPasses, nLate, nMaxTicks, nStackHi, nStackOf)
    bSfFrontEvRan[fSlot] := (nPasses > 0)
    bSfFrontEvOk[fSlot] := (nLate == 0) and (nMaxTicks <= FRONT_EV_PASS_US * TICKS_PER_US) and (nStackHi < nStackOf)
    beat(CP_LIB_STEER_QUERY)
    _, _, nLateEv := steering.getEventTotal(steering.EV_LATE_PASS)
    beat(CP_LIB_STEER_QUERY)
    lateFold(SLOT_LEFT, nLate, nLateEv)

PRI frPlatRestore()
' I11 for X-5: stop the platform, then undo the trial's side effect before anything is drained -- the fault response
' to FR_SHIPPED at FR_BRAKE_PCT on both wheels -- and read each wheel's fault cause. A steering object a guard or an
' abort stopped needs nothing: its next start re-inits it.

    if bSteerUp
        steerStopMotors()
        frRestErr := steerSetFaultResponse(wheelL.FR_SHIPPED, FR_BRAKE_PCT)
        beat(CP_LIB_STEER_QUERY)
        fltLeftCause, fltRightCause := steering.getFaultCause()
        beat(CP_LIB_STEER_QUERY)

#endif

#ifdef DBG_FRPLAT
PRI frPlatStats(fSlot, oSlot) | sampleIdx, preStartJ, preEndJ, preTicks, preMs, restSamples, stillCount, runStartJ, winStartJ, winEndJ, winTicks, winMs
' X-5's readings from the frozen steering capture: the faulted wheel's first latched sample; the WATCHED wheel's rate
' over FR_PRE_SAMPLES before the mark, its rest after the fault (pos and hwPos unchanged for REST_CONFIRM_MS, as
' traceFindRest() finds the primary's), whether it passed through DCS_SPIN_DN, and its rate over FR_PLAT_WIN_SAMPLES
' starting FR_PLAT_RAMP_SAMPLES after the fault. A watched wheel already at rest before that window opened reads 0 there
' even when the capture ended first -- the capture waits for BOTH wheels' rest. Legal only while FROZEN (I10).
'
' @param fSlot - the faulted wheel's slot
' @param oSlot - the watched wheel's slot
'
' @local sampleIdx - logical index
' @local preStartJ - first sample of the pre-fault window
' @local preEndJ - its last
' @local preTicks - the watched wheel's |pos| across it
' @local preMs - its length, ms
' @local restSamples - stored samples spanning REST_CONFIRM_MS
' @local stillCount - consecutive unchanged samples so far
' @local runStartJ - where the current still run began
' @local winStartJ - the window's first sample
' @local winEndJ - its last
' @local winTicks - the watched wheel's |pos| across it
' @local winMs - its length, ms

    frStatReset()
    if bDrMarkFound and (drEndJ > drMarkJ)
        preStartJ := (drMarkJ - FR_PRE_SAMPLES) #> 0
        preEndJ := drMarkJ - 1
        if preEndJ > preStartJ
            preTicks := abs(smpPos(preEndJ, oSlot) - smpPos(preStartJ, oSlot))
            preMs := (smpT(preEndJ) - smpT(preStartJ)) / TICKS_PER_MS
            if preMs > 0
                frPlatPreX10 := (preTicks * RATE_X10_SCALE) / preMs
                bFrPlatPreValid := TRUE
                bFrPlatPreOk := (preTicks >= FR_PLAT_MIN_TICKS)
        repeat sampleIdx from drMarkJ to drEndJ
            beat(CP_LOOP_DRAIN)
            if bSmpFault(sampleIdx, fSlot)
                frFltJ := sampleIdx
                bFrFltFound := TRUE
                quit
    if bFrFltFound and (frFltJ < drEndJ)
        restSamples := ((REST_CONFIRM_MS * INST_RATE_HZ) / MS_PER_SEC / instDecimate) #> 1
        stillCount := 0
        runStartJ := frFltJ
        repeat sampleIdx from frFltJ + 1 to drEndJ
            beat(CP_LOOP_DRAIN)
            if bSmpUp(sampleIdx, oSlot) and (smpState(sampleIdx, oSlot) == DCS_SPIN_DN)
                bFrPlatSpinDn := TRUE
            if (smpPos(sampleIdx, oSlot) == smpPos(sampleIdx - 1, oSlot)) and (smpHw(sampleIdx, oSlot) == smpHw(sampleIdx - 1, oSlot))
                stillCount += 1
                if (stillCount >= restSamples) and (bFrPlatRestFound == FALSE)
                    frPlatRestJ := runStartJ
                    bFrPlatRestFound := TRUE
            else
                stillCount := 0
                runStartJ := sampleIdx
        if bFrPlatRestFound
            frPlatRestMs := (smpT(frPlatRestJ) - smpT(frFltJ)) / TICKS_PER_MS
        winStartJ := frFltJ + FR_PLAT_RAMP_SAMPLES
        winEndJ := winStartJ + FR_PLAT_WIN_SAMPLES - 1
        if winEndJ <= drEndJ
            winTicks := abs(smpPos(winEndJ, oSlot) - smpPos(winStartJ, oSlot))
            winMs := (smpT(winEndJ) - smpT(winStartJ)) / TICKS_PER_MS
            if winMs > 0
                frPlatWinX10 := (winTicks * RATE_X10_SCALE) / winMs
                bFrPlatWinValid := TRUE
        elseif bFrPlatRestFound and (frPlatRestJ <= winStartJ)
            frPlatWinX10 := 0
            bFrPlatWinValid := TRUE
        if bFrPlatWinValid and bFrPlatPreOk and (frPlatPreX10 > 0)
            frPlatPct := (frPlatWinX10 * FR_PCT_SCALE) / frPlatPreX10

PRI bFrPlatMeasured() : bMeasured
' Whether X-5's trial measured the cell: the forced fault latched, the capture found it, the watched wheel was
' turning before it, and its window one ramp time later was read.
'
' @returns bMeasured - TRUE when R19-DUAL-PLATSTOP-X has an instance

    bMeasured := (frOutcome == FRO_FAULT) and bCpFrozen and bFrFltFound and bFrPlatPreOk and bFrPlatWinValid and (frPlatPreX10 > 0)

PRI frPlatWhy(whyCode) : firstWhy
' The first cause of BM-FRPLAT's NA fields.
'
' @param whyCode - why the trial measured nothing, WHY_NONE when it ran
' @returns firstWhy - WHY_* value

    firstWhy := whyCode
    if firstWhy == WHY_NONE
        if bCpFrozen == FALSE
            firstWhy := WHY_INST_NOACK
        elseif (bFrFltFound == FALSE) or (bFrPlatPreOk == FALSE) or (bFrPlatWinValid == FALSE)
            firstWhy := WHY_NOT_REACHED
        elseif frCaptureSafe <> SAFE_NONE
            firstWhy := safeWhy(frCaptureSafe)
        elseif bFrPlatRestFound == FALSE
            firstWhy := WHY_NOT_REACHED                     ' the watched wheel never rested: its rest time is NA

PRI frPlatFold(oSlot)
' Fold X-5 into R19-DUAL-PLATSTOP-X, the instance of the wheel that was NOT faulted.
'
' @param oSlot - the watched wheel's slot

    if bFrPlatMeasured()
        bSfPlatRan[oSlot] := TRUE
        sfPlatPct[oSlot] := frPlatPct

#endif

#ifdef DBP_FAULTRESP
PRI frShortRise(slotIdx) : nMeasured, nBad, bVisible | speedIdx, arrIdx, lastPk
' R19-DUAL-SHORTI-X's reading: across the speeds X-2 measured, in ascending order, how many steps did NOT raise the
' post-fault peak current, and whether the highest measured speed's peak was a visible current at all.
'
' @param slotIdx - motor slot
' @returns nMeasured - speeds with a measured peak
' @returns nBad - steps up in speed whose peak did not rise
' @returns bVisible - the highest measured speed's peak was visible (bFrIVisible())
'
' @local speedIdx - 0..FR_SPEEDS-1
' @local arrIdx - [slot * FR_SPEEDS + speed] index
' @local lastPk - the previous measured speed's peak

    nMeasured := 0
    nBad := 0
    bVisible := FALSE
    lastPk := 0
    repeat speedIdx from 0 to FR_SPEEDS - 1
        arrIdx := (slotIdx * FR_SPEEDS) + speedIdx
        if bFrShortPkRan[arrIdx]
            if (nMeasured > 0) and (frShortPk[arrIdx] <= lastPk)
                nBad += 1
            lastPk := frShortPk[arrIdx]
            bVisible := bFrShortVis[arrIdx]
            nMeasured += 1

PRI frShortVsCoast(slotIdx) : nPairs, nBad | speedIdx, arrIdx
' R19-DUAL-SHORTTK-X's reading: at each speed where both X-2 and X-3 reached rest, the short must stop in FEWER ticks
' than the coast.
'
' @param slotIdx - motor slot
' @returns nPairs - speeds with both readings
' @returns nBad - those where the short took as many ticks or more
'
' @local speedIdx - 0..FR_SPEEDS-1
' @local arrIdx - [slot * FR_SPEEDS + speed] index

    nPairs := 0
    nBad := 0
    repeat speedIdx from 0 to FR_SPEEDS - 1
        arrIdx := (slotIdx * FR_SPEEDS) + speedIdx
        if bFrShortTkRan[arrIdx] and bFrCoastTkRan[arrIdx]
            nPairs += 1
            if frShortTicks[arrIdx] >= frCoastTicks[arrIdx]
                nBad += 1

PRI emitFaultRespCells() | slotIdx, side, nMeasured, nBad, bVisible, gradedIdx, shortIdx, bLive
' The FAULTRESP part's judged cells, each NOMEAS when nothing measured it, then the one it prints NOT_BUILT.
'
'  TRACES   - COUNT: traces whose lost head reached the mark, or that dropped samples
'  HOOKREST - BOOL per motor: a forced fault at rest (bridge coasting) did not fault -- the hook's negative control
'  FORCED   - COUNT per motor: requested forced faults that did not latch inside FR_PROVOKE_MS (the hook failed)
'  RSTPROV  - COUNT per motor: faults testResetFault() alone did not clear (every forced fault is recovered by it)
'  FRREST   - COUNT per motor: restores that did not read back FR_SHIPPED, this lifetime's brake_on and HS_OFF
'  RESTFLAT - COUNT per motor: X-3's at-rest windows (before spin-up, and after the coast) that were not flat
'  COASTEMF - COUNT per motor: X-3 coasts whose phases did not swing at the hall rate
'  SHORTTK  - COUNT per motor: speeds where X-2's short took as many ticks to rest as X-3's coast, or more
'  SHORTI   - COUNT per motor: speed steps where X-2's peak current did not rise; NOMEAS unless it was visible
'  RESYNC   - BOOL per motor: X-4 re-synced once onto the correct offsets and stopped along the configured ramp
'  BLUNT    - COUNT per motor: X-6 / X6C second faults on a re-synced ramp that did not read DCS_FAULTED
'  GRADED   - COUNT per motor: steps of the chain coast, 10, 25, 50, 100 % where ticks or time to rest rose, plus one
'             when the 100 % point is not strictly below the coast's in either
'  GRD100   - COUNT per motor: |ticks to rest| of X-6 at 100 % less X-2's short at the same speed
'  PLATSTOP - PCT per watched motor: its rate one ramp time after the other wheel faulted
'
' and task 3621's (R20.1): SR-FAULT and SR-FLOST (COUNT per motor), SR-PARTNER and FRONTST-EV (BOOL per faulted motor),
' EV-LATE (COUNT, the steering form).
'
' A wheel PREFLT retired (task 3615, bFrPreRetired) measured none of its cells: each prints NOMEAS. RSTPROV is the one
' that could otherwise read a PREFLT fault's recovery as an FLTRESP instance.
'
' @local slotIdx - motor slot
' @local side - SIDE_LEFT or SIDE_RIGHT
' @local nMeasured - instances behind a computed cell
' @local nBad - its bad instances
' @local bVisible - SHORTI: the peak was a visible current
' @local gradedIdx - GRD100: X-6's 100 % point
' @local shortIdx - GRD100: X-2 at FR_SPEED_X6
' @local bLive - this wheel was not retired by PREFLT

    emitSignoff(@sSfCellTracesX, SIDE_NONE, @sSfCritTraces, sfTraces > 0, sfTraceLost, TRACE_LOST_LO, TRACE_LOST_HI, sfTraces, @sSfUnitsCount)
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        side := SIDE_LEFT + slotIdx
        bLive := (bFrPreRetired[slotIdx] == FALSE)
        emitSignoffBool(@sSfCellHookRest, side, @sSfCritHookRest, bLive and bSfHookRan[slotIdx], bSfHookOk[slotIdx], SIGNOFF_ONE_INSTANCE)
        emitSignoff(@sSfCellForced, side, @sSfCritForced, bLive and (sfForcedN[slotIdx] > 0), sfForcedBad[slotIdx], FR_BAD_LO, FR_BAD_HI, sfForcedN[slotIdx], @sSfUnitsCount)
        emitSignoff(@sSfCellRstProvX, side, @sSfCritRstProv, bLive and (sfFaults[slotIdx] > 0), sfResetUncleared[slotIdx], RESET_UNCLEAR_LO, RESET_UNCLEAR_HI, sfFaults[slotIdx], @sSfUnitsCount)
        emitSignoff(@sSfCellBlunt, side, @sSfCritBlunt, bLive and (sfBluntN[slotIdx] > 0), sfBluntBad[slotIdx], FR_BAD_LO, FR_BAD_HI, sfBluntN[slotIdx], @sSfUnitsCount)
        nMeasured, nBad := frGradedChain(slotIdx)
        emitSignoff(@sSfCellGraded, side, @sSfCritGraded, bLive and (nMeasured >= FR_GRADED_MIN_POINTS), nBad, FR_BAD_LO, FR_BAD_HI, nMeasured, @sSfUnitsCount)
        gradedIdx := (slotIdx * FR_GRADED_POINTS) + FR_BRAKE_STEPS
        shortIdx := (slotIdx * FR_SPEEDS) + FR_SPEED_X6
        emitSignoff(@sSfCellGrd100, side, @sSfCritGrd100, bLive and bFrGradedRan[gradedIdx] and bFrShortTkRan[shortIdx], abs(frGradedTicks[gradedIdx] - frShortTicks[shortIdx]), 0, FR_FULL_TOL_TICKS, SIGNOFF_ONE_INSTANCE, @sSfUnitsCount)
        emitSignoff(@sSfCellFrRest, side, @sSfCritFrRest, bLive and (sfFrRestN[slotIdx] > 0), sfFrRestBad[slotIdx], FR_BAD_LO, FR_BAD_HI, sfFrRestN[slotIdx], @sSfUnitsCount)
        emitSignoff(@sSfCellRestFlat, side, @sSfCritRestFlat, bLive and (sfRestN[slotIdx] > 0), sfRestBad[slotIdx], FR_BAD_LO, FR_BAD_HI, sfRestN[slotIdx], @sSfUnitsCount)
        emitSignoff(@sSfCellCoastEmf, side, @sSfCritCoastEmf, bLive and (sfCoastN[slotIdx] > 0), sfCoastBad[slotIdx], FR_BAD_LO, FR_BAD_HI, sfCoastN[slotIdx], @sSfUnitsCount)
        nMeasured, nBad := frShortVsCoast(slotIdx)
        emitSignoff(@sSfCellShortTk, side, @sSfCritShortTk, bLive and (nMeasured > 0), nBad, FR_BAD_LO, FR_BAD_HI, nMeasured, @sSfUnitsCount)
        nMeasured, nBad, bVisible := frShortRise(slotIdx)
        emitSignoff(@sSfCellShortI, side, @sSfCritShortI, bLive and (nMeasured >= FR_RISE_MIN_SPEEDS) and bVisible, nBad, FR_BAD_LO, FR_BAD_HI, nMeasured, @sSfUnitsCount)
        emitSignoffBool(@sSfCellResync, side, @sSfCritResync, bLive and bSfResyncRan[slotIdx], bSfResyncOk[slotIdx], SIGNOFF_ONE_INSTANCE)
        emitSignoff(@sSfCellPlatStop, side, @sSfCritPlatStop, bLive and bSfPlatRan[slotIdx], sfPlatPct[slotIdx], FR_PLAT_PCT_LO, FR_PLAT_REST_PCT, SIGNOFF_ONE_INSTANCE, @sSfUnitsPct)
    emitSignoffNotBuilt(@sSfCellB4Pulse, SIDE_NONE, @sSfCritB4Pulse)
    ' task 3621 (R20.1): the reporting cells. SR-FAULT and SR-FLOST are measured only once BOTH their positive and their
    '  negative trial were judged on the wheel (frSrFold(), frHookRestTrial()); SR-PARTNER and FRONTST-EV are per FLTPLAT
    '  trial, named by the wheel that trial faulted (frPlatReport()); EV-LATE is the steering form's, over those trials
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        side := SIDE_LEFT + slotIdx
        bLive := (bFrPreRetired[slotIdx] == FALSE)
        emitSignoff(@sSfCellSrFault, side, @sSfCritSrFault, bLive and bSfSrFaultPos[slotIdx] and bSfSrFaultNeg[slotIdx], sfSrFaultBad[slotIdx], R20_BAD_LO, R20_BAD_HI, sfSrFaultN[slotIdx], @sSfUnitsCount)
        emitSignoff(@sSfCellSrLost, side, @sSfCritSrLost, bLive and bSfSrLostPos[slotIdx] and bSfSrLostNeg[slotIdx], sfSrLostBad[slotIdx], R20_BAD_LO, R20_BAD_HI, sfSrLostN[slotIdx], @sSfUnitsCount)
        emitSignoffBool(@sSfCellSrPart, side, @sSfCritSrPart, bSfPartRan[slotIdx], bSfPartOk[slotIdx], SIGNOFF_ONE_INSTANCE)
        emitSignoffBool(@sSfCellFrontEv, side, @sSfCritFrontEv, bSfFrontEvRan[slotIdx], bSfFrontEvOk[slotIdx], SIGNOFF_ONE_INSTANCE)
    emitLateCells(SLOT_LEFT, SIDE_BOTH)

PRI frGradedChain(slotIdx) : nPoints, nBad | pointIdx, arrIdx, lastTicks, lastMs, firstTicks, firstMs
' R19-DUAL-GRADED-X's reading, X-6's pre-registered one: along the chain coast (X6C), 10, 25, 50, 100 %, ticks AND time
' from the second fault to rest fall monotonically as the brake % rises. A step between measured points where either
' ROSE is bad -- equal is allowed, because one hall tick and one 2 ms sample are the resolution and the upper points
' stop within a tick or two -- and one more is bad when the last measured point is not strictly below the first in
' ticks, or in time: a flat chain has not shown the brake doing anything.
'
' @param slotIdx - motor slot
' @returns nPoints - measured points
' @returns nBad - bad steps, plus the overall-fall check
'
' @local pointIdx - 0..FR_GRADED_POINTS-1
' @local arrIdx - [slot * FR_GRADED_POINTS + point] index
' @local lastTicks - the previous measured point's ticks
' @local lastMs - ...and ms
' @local firstTicks - the first measured point's ticks
' @local firstMs - ...and ms

    nPoints := 0
    nBad := 0
    lastTicks := 0
    lastMs := 0
    firstTicks := 0
    firstMs := 0
    repeat pointIdx from 0 to FR_GRADED_POINTS - 1
        arrIdx := (slotIdx * FR_GRADED_POINTS) + pointIdx
        if bFrGradedRan[arrIdx]
            if nPoints == 0
                firstTicks := frGradedTicks[arrIdx]
                firstMs := frGradedMs[arrIdx]
            elseif (frGradedTicks[arrIdx] > lastTicks) or (frGradedMs[arrIdx] > lastMs)
                nBad += 1
            lastTicks := frGradedTicks[arrIdx]
            lastMs := frGradedMs[arrIdx]
            nPoints += 1
    if (nPoints >= 2) and ((lastTicks >= firstTicks) or (lastMs >= firstMs))
        nBad += 1

PRI emitFrBuild()
' BM-FRBUILD: the FAULTRESP part's compiled, pre-registered numbers, printed before anything moves so a log shows the
' thresholds its verdicts were judged on. Worst case 259 bytes.

    recBegin(@"BM-FRBUILD")
    benchLog.numField(@"lo_incre", ladderIncre[frRungIdx[0]], LIM_BIG)
    benchLog.numField(@"mid_incre", ladderIncre[frRungIdx[1]], LIM_BIG)
    benchLog.numField(@"hi_incre", ladderIncre[frRungIdx[2]], LIM_BIG)
    benchLog.numField(@"brake_pct", FR_BRAKE_PCT, LIM_TINY)
    benchLog.numField(@"provoke_ms", FR_PROVOKE_MS, LIM_SMALL)
    benchLog.numField(@"wait2_ms", FR_SECOND_WAIT_MS, LIM_SMALL)
    benchLog.numField(@"flat_mV", FR_FLAT_MV, LIM_SMALL)
    benchLog.numField(@"vis_mV", FR_I_VISIBLE_MV, LIM_SMALL)
    benchLog.numField(@"ramp_ms", FR_PLAT_RAMP_MS, LIM_SMALL)
    benchLog.numField(@"rest_pct", FR_PLAT_REST_PCT, LIM_TINY)
    benchLog.numField(@"min_ticks", FR_COAST_MIN_TICKS, LIM_TINY)
    benchLog.numField(@"ramp_lo", FR_RAMP_LO_PCT, LIM_TINY)
    benchLog.numField(@"ramp_hi", FR_RAMP_HI_PCT, LIM_TINY)
    benchLog.numField(@"full_tol", FR_FULL_TOL_TICKS, LIM_TINY)
    emitRecord()

PRI emitFrDiag()
' BM-FRDIAG: PL-120's diagnostic constants and this build's wheel order, printed after BM-FRBUILD and before anything
' moves (BM-FRBUILD, at 259 bytes, has no room for them under 280). right_first TRUE is the FRESP_RIGHT_FIRST build
' (tier dual-fault-rightfirst). PL-136 appends PREFLT's retry count and gap (pf_tries, pf_gap_ms). Worst case 168 bytes.

    recBegin(@"BM-FRDIAG")
    benchLog.numField(@"nomo_ms", FR_NOMOTION_MS, LIM_SMALL)
    benchLog.numField(@"rec_tries", FR_RECOVER_TRIES, LIM_TINY)
    benchLog.numField(@"rec_gap_ms", FR_RECOVER_GAP_MS, LIM_SMALL)
    benchLog.numField(@"rec_drive_ms", FR_RECOVER_DRIVE_MS, LIM_SMALL)
    benchLog.numField(@"rec_incre", FR_RECOVER_INCRE, LIM_BIG)
    benchLog.boolField(@"right_first", BUILD_RIGHT_FIRST)
    benchLog.numField(@"pf_tries", PF_RETRY_TRIES, LIM_TINY)
    benchLog.numField(@"pf_gap_ms", PF_RETRY_GAP_MS, LIM_SMALL)
    emitRecord()

#endif

#ifdef DBG_NOTBUILT
PRI emitNotBuilt(pCell, pStudy, whyCode)
' BM-NOTBUILT: a cell this build declares and cannot build, the study cell or plan item it stands for, and why. Worst
' case 89 bytes (the study token widened to TOKMAX_STUDY by task 3621, for R20-PACK-EV's R20.4).
'
' @param pCell - pointer to the cell id
' @param pStudy - pointer to the study's cell name
' @param whyCode - WHY_* naming the reason

    recBegin(@"BM-NOTBUILT")
    benchLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    benchLog.tokenField(@"study", pStudy, TOKMAX_STUDY)
    whyField(whyCode)
    emitRecord()

#endif

#ifdef DBP_FAULTRESP
PRI emitFrTrial(tid, side, motorIncre)
' BM-FRTRIAL: one wheel trial -- its X-cell, what it set and requested, the forced fault and its outcome, and what the
' driver was seen to do. second is X-6's second forced fault (NOT_RUN when none was asked), and f2_err its call's
' return. Worst case 274 bytes.
'
' @param tid - trace id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment

    recBegin(@"BM-FRTRIAL")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"cell", tokenAt(@tokFrCell, FRC_COUNT, frCell), TOKMAX_FRCELL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.tokenField(@"fr_mode", tokenAt(@tokFrMode, FR_MODE_COUNT, frMode), TOKMAX_FRMODE)
    benchLog.numField(@"brake_pct", frBrakePct, LIM_TINY)
    benchLog.tokenField(@"req_mode", tokenAt(@tokMode, MODE_COUNT, frReqMode), TOKMAX_REQMODE)
    benchLog.numField(@"set_err", frSetErr, LIM_SMALL)
    benchLog.naNumField(@"f_err", frForceErr, LIM_SMALL, bFrForced)
    benchLog.tokenField(@"outcome", tokenAt(@tokFrOut, FRO_COUNT, frOutcome), TOKMAX_FROUT)
    benchLog.tokenField(@"second", tokenAt(@tokFrOut, FRO_COUNT, frOutcome2), TOKMAX_FROUT)
    benchLog.naNumField(@"f2_err", frForceErr2, LIM_SMALL, frOutcome2 <> FRO_NOT_RUN)
    benchLog.tokenField(@"path", tokenAt(@tokFrPath, FRP_COUNT, frPath), TOKMAX_FRPATH)
    benchLog.naNumField(@"rs_d", frResyncAfter - frResyncBase, LIM_TINY, bFrReadsValid and (frOutcome == FRO_FAULT))
    benchLog.tokenField(@"cause", tokenAt(@tokFltCause, FC_COUNT, frCause), TOKMAX_FCAUSE)
    benchLog.naNumField(@"g_mV", frGuardPkMv, LIM_SMALL, bFrForced)
    whyField(frWhy)
    emitRecord()

PRI emitFrRecov(seg, tid, side, tryIdx, ticksMoved, hwMoved, bMeasured, pkPh, pkI, bPkValid, whyCode) | slotIdx
' BM-FRRECOV: one try of PL-120's recovery probe -- the failed trial's tid, the wheel, the try (1-based), this try's
' driver lifetime, ms from the failure to its command (to its start attempt when it never started), moved and the driver
' pos delta (ticks) with the instrument's own hall-count delta (hw) beside it, the largest phase sum (pk_ph, BM-TS's ph)
' and sense_i (pk_i, BM-TS's i) over the capture's up samples, the stage the probe ran in (seg: FLTRESP, or PREFLT for
' PL-136's probe of a wheel whose every PREFLT retry failed, where tid is the failed nudge's trace), and why.
'  RECOVERED reads moved,TRUE with ticks non-zero and hw beside it, and pk_ph well above the dead reading.
'  STILL DEAD reads moved,FALSE, ticks,0 and hw,0 with why NONE (the drive ran its full FR_RECOVER_DRIVE_MS), pk_ph at
'   the dead bridge's level (PL-120: 30-50 mV on BM-TS ph from the first frame, trials 18-24) and pk_i at the lifetime
'   zero (0-9 mV).
'  A why other than NONE means the try did not measure a full drive (NO_COG, INST_NOACK, FAULTED, ABORTED ...) and
'   decides nothing either way.
' Worst case 191 bytes (178, and seg's 13, PL-136).
'
' @param seg - SEG_FLTRESP or SEG_PREFLT: the stage the probe ran in
' @param tid - trace id of the failed trial
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param tryIdx - 1..FR_RECOVER_TRIES
' @param ticksMoved - driver pos delta over the capture
' @param hwMoved - hall-count delta over it
' @param bMeasured - the deltas are measurements
' @param pkPh - the largest phase sum, mV
' @param pkI - the largest sense_i, mV
' @param bPkValid - the peaks are measurements (an up sample was stored)
' @param whyCode - WHY_* naming the cause of every NA, or what ended the drive early
'
' @local slotIdx - motor slot

    slotIdx := side - SIDE_LEFT
    recBegin(@"BM-FRRECOV")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"try", tryIdx, LIM_TINY)
    benchLog.naNumField(@"life", slotLife[slotIdx], LIM_SMALL, slotLife[slotIdx] > 0)
    benchLog.numField(@"ms", frTryMs, LIM_MID)
    benchLog.boolField(@"moved", bMeasured and (ticksMoved <> 0))
    benchLog.naNumField(@"ticks", ticksMoved, LIM_MID, bMeasured)
    benchLog.naNumField(@"hw", hwMoved, LIM_MID, bMeasured)
    benchLog.naNumField(@"pk_ph", pkPh, LIM_SMALL, bPkValid)
    benchLog.naNumField(@"pk_i", pkI, LIM_SMALL, bPkValid)
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    whyField(whyCode)
    emitRecord()

PRI emitPfRetry(side, tryIdx) | slotIdx
' BM-PFRETRY (PL-136): one immediate retry of a wheel whose PREFLT nudge did not move, printed after the retry's own
' BM-START, BM-PREFLT, any where,NOMOTION dump, its trace (BM-TRACE seg PREFLT) and its where,PREFLT dump -- the wheel,
' the retry (1-based, of PF_RETRY_TRIES), its driver lifetime, ms from the first nudge's failure to this retry's command,
' moved with the driver pos delta (ticks) and the instrument's own hall-count delta (hw) beside it, the tid of its
' trace, and why.
'  RECOVERED reads moved,TRUE with ticks non-zero and hw beside it: the first failure did not persist, and the wheel's
'   FLTRESP trials run.
'  STILL DEAD reads moved,FALSE, ticks,0 and hw,0 with why NONE: the nudge ran its full PREFLIGHT_MS and nothing turned.
'  A why other than NONE means the retry did not measure a full nudge (NO_COG, INST_NOACK, FAULTED ...) and decides
'   nothing either way; ms is NA when it never commanded, tid NA when its ring was not frozen.
' Worst case 148 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param tryIdx - 1..PF_RETRY_TRIES
'
' @local slotIdx - motor slot

    slotIdx := side - SIDE_LEFT
    recBegin(@"BM-PFRETRY")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"try", tryIdx, LIM_TINY)
    benchLog.naNumField(@"life", slotLife[slotIdx], LIM_SMALL, slotLife[slotIdx] > 0)
    benchLog.naNumField(@"ms", pfCmdMs - pfFailMs[slotIdx], LIM_MID, bPfCmdValid)
    benchLog.boolField(@"moved", bPfMeasured and (pfTicks <> 0))
    benchLog.naNumField(@"ticks", pfTicks, LIM_SMALL, bPfMeasured)
    benchLog.naNumField(@"hw", pfHw, LIM_MID, bPfMeasured)
    benchLog.naNumField(@"tid", pfTid, LIM_SMALL, pfTid > 0)
    whyField(pfWhy)
    emitRecord()

PRI emitFrRecSum()
' BM-FRRECSUM: PL-120's recovery probe, once per run after FLTRESP's trials, whether or not it ran. probed FALSE (every
' other probe field NA or NONE) means no FLTRESP trial ended STEADY_TIMEOUT. probed TRUE names the failed trial (tid),
' its wheel and the tries made.
'  RECOVERED reads recovered,TRUE with the try that moved and its ms since the failure: time inside one program
'   cleared the state.
'  STILL DEAD reads recovered,FALSE, tries FR_RECOVER_TRIES, try and ms NA, why NONE: 2 minutes did not clear it, so
'   the reload is what does.
'  why ABORTED or MOTOR_RETIRED with recovered FALSE means the probe ended short and decides nothing.
' PL-136: recovered and tries print NA when probed is FALSE (a probe that did not run recovered nothing and made no
' try; FALSE and 0 there were silent zeros, D2). Then, per wheel, what PREFLT's stages found (pfSumFields()): l_pf and
' r_pf NO_FAIL, RETRY, PROBE, DEAD or UNDECIDED; l_pf_rec / r_pf_rec TRUE for RETRY and PROBE, FALSE for DEAD, and NA only
' where nothing was decided (NO_FAIL, UNDECIDED); the retries made; and the retry or probe try that moved it. So a wheel
' that failed PREFLT always reads a named outcome here, never a silent NA.
' Worst case 248 bytes (136, and 56 per wheel).

    recBegin(@"BM-FRRECSUM")
    benchLog.boolField(@"probed", bFrProbed)
    if bFrProbed
        benchLog.boolField(@"recovered", bFrRecovered)
    else
        benchLog.textField(@"recovered", @sSfNa)
    benchLog.naNumField(@"tid", frProbeTid, LIM_SMALL, bFrProbed)
    benchLog.tokenField(@"motor", sideToken(frProbeSide), TOKMAX_MOTOR)
    benchLog.naNumField(@"tries", frProbeTries, LIM_TINY, bFrProbed)
    benchLog.naNumField(@"try", frRecTry, LIM_TINY, bFrRecovered)
    benchLog.naNumField(@"ms", frRecMs, LIM_MID, bFrRecovered)
    pfSumFields(@"l_pf", @"l_pf_rec", @"l_pf_n", @"l_pf_try", SLOT_LEFT)
    pfSumFields(@"r_pf", @"r_pf_rec", @"r_pf_n", @"r_pf_try", SLOT_RIGHT)
    whyField(frProbeWhy)
    emitRecord()

PRI pfSumFields(pOutName, pRecName, pTriesName, pTryName, slotIdx) | eOut
' BM-FRRECSUM's four PREFLT-stage fields for one wheel (PL-136): the outcome token, recovered (TRUE / FALSE, NA when
' nothing was decided), the immediate retries made (NA when its first nudge moved), and the retry or probe try that
' moved it (NA unless RETRY or PROBE).
'
' @param pOutName - the outcome field's name
' @param pRecName - the recovered field's name
' @param pTriesName - the retries-made field's name
' @param pTryName - the moving-try field's name
' @param slotIdx - motor slot
'
' @local eOut - PFO_* the wheel's stages found

    eOut := pfOutcome[slotIdx]
    benchLog.tokenField(pOutName, tokenAt(@tokPfOut, PFO_COUNT, eOut), TOKMAX_PFOUT)
    if (eOut == PFO_RETRY) or (eOut == PFO_PROBE)
        benchLog.boolField(pRecName, TRUE)
    elseif eOut == PFO_DEAD
        benchLog.boolField(pRecName, FALSE)
    else
        benchLog.textField(pRecName, @sSfNa)
    benchLog.naNumField(pTriesName, pfTries[slotIdx], LIM_TINY, eOut <> PFO_NO_FAIL)
    benchLog.naNumField(pTryName, pfRecTry[slotIdx], LIM_TINY, (eOut == PFO_RETRY) or (eOut == PFO_PROBE))

PRI emitFrResults(tid, side, slotIdx, motorIncre)
' A wheel trial's readings: BM-FRSTAT and BM-FRCUR, BM-FRWIND for X-2, and the phase windows -- X-3's negative control
' first, then the moving window and the at-rest tail.
'
' @param tid - trace id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param slotIdx - motor slot
' @param motorIncre - signed increment

    emitFrStat(tid, side, motorIncre)
    emitFrCur(tid, side, slotIdx)
    if frCell == FRC_X2
        emitFrWind(tid, side, slotIdx, motorIncre)
    if frCell == FRC_X3
        emitFrPhase(tid, side, FRW_PRE)
    emitFrPhase(tid, side, FRW_MOVE)
    emitFrPhase(tid, side, FRW_REST)

PRI emitFrStat(tid, side, motorIncre)
' BM-FRSTAT: the fault's motion -- where it was latched, where X-6's second read DCS_FAULTED, and where rest began (trace
' k), the rate before it, ticks and ms from the reference (frStats()) to rest against the configured ramp's prediction
' from this speed (exp_ms, X-4's band), each half's ticks, and the states seen after the fault. f2_k is NA by
' construction for every cell but X-6 and X6C. Worst case 270 bytes.
'
' @param tid - trace id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment

    recBegin(@"BM-FRSTAT")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.naNumField(@"flt_k", frFltJ - drStartJ, LIM_SMALL, bFrFltFound)
    benchLog.naNumField(@"f2_k", frFlt2J - drStartJ, LIM_SMALL, bFrFlt2Found)
    benchLog.naNumField(@"rest_k", frRestJ - drStartJ, LIM_SMALL, bFrRestFound)
    benchLog.naNumField(@"pre_x10", frPreX10, LIM_MID, bFrPreValid)
    benchLog.numField(@"exp_ms", frRampPredMs(), LIM_SMALL)
    benchLog.naNumField(@"t_rest_ms", frRestMs, LIM_SMALL, bFrRestFound)
    benchLog.naNumField(@"ticks_rest", frTicksRest, LIM_SMALL, bFrRestFound)
    benchLog.naNumField(@"t1", frT1, LIM_SMALL, bFrRestFound)
    benchLog.naNumField(@"t2", frT2, LIM_SMALL, bFrRestFound)
    benchLog.boolField(@"spin_dn", bFrSawSpinDn)
    benchLog.boolField(@"flt_st", bFrSawFaulted)
    benchLog.tokenField(@"st_end", dcsToken(frStEnd), TOKMAX_STATE)
    whyField(frWhy)
    emitRecord()

PRI emitFrCur(tid, side, slotIdx) | whyCode
' BM-FRCUR: the DC-link current around the fault -- the lifetime zero, the mean current and duty at speed before it,
' duty_max, the largest sense_i from the fault to rest and where, and whether that peak was a visible current. Worst
' case 183 bytes.
'
' @param tid - trace id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param slotIdx - motor slot
'
' @local whyCode - the first cause of the record's NA fields

    whyCode := frWhy
    if (whyCode == WHY_NONE) and (bLifeZeroValid[slotIdx] == FALSE)
        whyCode := WHY_NO_SAMPLES
    recBegin(@"BM-FRCUR")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.naNumField(@"zero_x10", lifeZeroX10[slotIdx], LIM_MID, bLifeZeroValid[slotIdx])
    benchLog.naNumField(@"pre_i_x10", frPreIX10, LIM_MID, bFrPreValid)
    benchLog.naNumField(@"pre_duty", frPreDuty, LIM_SMALL, bFrPreValid)
    benchLog.numField(@"duty_max", frDutyMax, LIM_SMALL)
    benchLog.naNumField(@"pk_i", frPkI, LIM_SMALL, bFrPkValid)
    benchLog.naNumField(@"pk_k", frPkK, LIM_SMALL, bFrPkValid)
    benchLog.boolField(@"i_vis", bFrIVisible(slotIdx))
    whyField(whyCode)
    emitRecord()

PRI emitFrWind(tid, side, slotIdx, motorIncre) | bEmf, emfMv, bNet, netMv, bR, rMohm, whyCode
' BM-FRWIND (X-2 only): the winding resistance the log allows, R = back-EMF / short-circuit current. The back-EMF is
' the driver's own line -- the mean duty at speed before the fault, as a fraction of duty_max, of the nominal pack
' (PACK_MV); DERIVED, an estimate: the modulation's scale and the I x R drop are in it. The current is the post-fault
' peak over the lifetime zero at SENSE_MV_PER_A. It replaces the startup study's B-4 pulse. When the peak is not a
' visible current (bFrIVisible(); this section's CON says why it should not be), r_mohm is NA, why NOT_VISIBLE.
' Worst case 137 bytes.
'
' @param tid - trace id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param slotIdx - motor slot
' @param motorIncre - signed increment
'
' @local bEmf - the back-EMF estimate is valid
' @local emfMv - the estimate, mV
' @local bNet - the net peak current is valid
' @local netMv - the post-fault peak over the zero, mV
' @local bR - the resistance is valid
' @local rMohm - the resistance, milliohms
' @local whyCode - the first cause of the record's NA fields

    bEmf := bFrPreValid and (frDutyMax > 0)
    emfMv := 0
    if bEmf
        emfMv := (frPreDuty * PACK_MV) / frDutyMax
    bNet := bFrPkValid and (bLifeZeroValid[slotIdx] <> FALSE)
    netMv := 0
    if bNet
        netMv := frPkI - (lifeZeroX10[slotIdx] / X10)
    bR := bEmf and bFrIVisible(slotIdx) and (netMv > 0)
    rMohm := 0
    if bR
        rMohm := (emfMv * SENSE_MV_PER_A) / netMv
    whyCode := frWhy
    if whyCode == WHY_NONE
        if bFrIVisible(slotIdx) == FALSE
            whyCode := WHY_NOT_VISIBLE
        elseif bEmf == FALSE
            whyCode := WHY_NO_SAMPLES
    recBegin(@"BM-FRWIND")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.naNumField(@"emf_mV", emfMv, LIM_SMALL, bEmf)
    benchLog.naNumField(@"i_net_mV", netMv, LIM_SMALL, bNet)
    benchLog.naNumField(@"r_mohm", rMohm, LIM_SMALL, bR)
    whyField(whyCode)
    emitRecord()

PRI emitFrPhase(tid, side, winIdx) | winBase, whyCode
' BM-FRPHASE: one phase window -- samples, hall ticks across it, each phase's peak-to-peak and crossings of its mean,
' the crossings the ticks imply, and whether all three stayed flat. Worst case 205 bytes.
'
' @param tid - trace id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param winIdx - FRW_* value
'
' @local winBase - the window's first index in frWinPp / frWinX
' @local whyCode - the first cause of the record's NA fields

    winBase := winIdx * FR_PHASES
    whyCode := WHY_NONE
    if bFrWinValid[winIdx] == FALSE
        if winIdx == FRW_PRE
            whyCode := frPreWhy
        else
            whyCode := frWhy
        if whyCode == WHY_NONE
            whyCode := WHY_NO_SAMPLES                       ' e.g. a short that stopped inside FR_SETTLE_SAMPLES
    recBegin(@"BM-FRPHASE")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"win", tokenAt(@tokFrWin, FR_WINS, winIdx), TOKMAX_FRWIN)
    benchLog.naNumField(@"n", frWinN[winIdx], LIM_SMALL, bFrWinValid[winIdx])
    benchLog.naNumField(@"ticks", frWinTicks[winIdx], LIM_SMALL, bFrWinValid[winIdx])
    benchLog.naNumField(@"pp_u", frWinPp[winBase], LIM_SMALL, bFrWinValid[winIdx])
    benchLog.naNumField(@"pp_v", frWinPp[winBase + 1], LIM_SMALL, bFrWinValid[winIdx])
    benchLog.naNumField(@"pp_w", frWinPp[winBase + 2], LIM_SMALL, bFrWinValid[winIdx])
    benchLog.naNumField(@"x_u", frWinX[winBase], LIM_SMALL, bFrWinValid[winIdx])
    benchLog.naNumField(@"x_v", frWinX[winBase + 1], LIM_SMALL, bFrWinValid[winIdx])
    benchLog.naNumField(@"x_w", frWinX[winBase + 2], LIM_SMALL, bFrWinValid[winIdx])
    benchLog.naNumField(@"x_exp", frXingExpected(winIdx), LIM_SMALL, bFrWinValid[winIdx])
    if bFrWinValid[winIdx]
        benchLog.boolField(@"flat", bFrWinFlat(winIdx))
    else
        benchLog.textField(@"flat", @sSfNa)
    whyField(whyCode)
    emitRecord()

PRI emitFrRest(tid, side, eMode, nBrakeOn, eHold, bMeasured, bOk)
' BM-FRREST: a wheel trial's restores read back at rest after the recovery -- the fault response, the graded short's
' brake_on against this lifetime's own, and the hold status (HS_OFF is SM_FLOAT at rest). Worst case 156 bytes.
'
' @param tid - trace id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param eMode - the fault response read back
' @param nBrakeOn - its brake_on read back
' @param eHold - the hold status read back
' @param bMeasured - the read-backs came from the lifetime the restores went to
' @param bOk - all three held

    recBegin(@"BM-FRREST")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    if bMeasured
        benchLog.tokenField(@"fr_back", tokenAt(@tokFrMode, FR_MODE_COUNT, eMode), TOKMAX_FRMODE)
        benchLog.tokenField(@"hs_back", tokenAt(@tokHold, HS_COUNT, eHold), TOKMAX_HOLD)
    else
        benchLog.textField(@"fr_back", @sSfNa)
        benchLog.textField(@"hs_back", @sSfNa)
    benchLog.naNumField(@"bo_back", nBrakeOn, LIM_SMALL, bMeasured)
    benchLog.naNumField(@"bo_base", frBrakeOnBase, LIM_SMALL, bMeasured)
    benchLog.numField(@"set_err", frRestErr, LIM_SMALL)
    benchLog.boolField(@"ok", bMeasured and bOk)
    if bMeasured
        whyField(WHY_NONE)
    else
        whyField(WHY_NO_COG)
    emitRecord()

#endif

#ifdef DBG_FRPLAT
PRI emitFrPlat(tid, sid, side)
' BM-FRPLAT: X-5 -- the wheel faulted and its fault response, the forced fault's call and outcome, then the WATCHED
' wheel: its rate before the fault, in the window one ramp time after it and as a percentage, its ms to rest (o_rest)
' and whether it passed through SPIN_DN (o_spndn); and each wheel's fault cause. Worst case 275 bytes.
'
' @param tid - trace id
' @param sid - the steering start's life, 0 when it did not start
' @param side - the wheel faulted

    recBegin(@"BM-FRPLAT")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.naNumField(@"sid", sid, LIM_SMALL, sid > 0)
    benchLog.tokenField(@"flt_motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"fr_mode", tokenAt(@tokFrMode, FR_MODE_COUNT, frMode), TOKMAX_FRMODE)
    benchLog.numField(@"set_err", frSetErr, LIM_SMALL)
    benchLog.naNumField(@"f_err", frForceErr, LIM_SMALL, bFrForced)
    benchLog.tokenField(@"outcome", tokenAt(@tokFrOut, FRO_COUNT, frOutcome), TOKMAX_FROUT)
    benchLog.naNumField(@"flt_k", frFltJ - drStartJ, LIM_SMALL, bFrFltFound)
    benchLog.naNumField(@"o_pre_x10", frPlatPreX10, LIM_MID, bFrPlatPreValid)
    benchLog.naNumField(@"o_win_x10", frPlatWinX10, LIM_MID, bFrPlatWinValid)
    benchLog.naNumField(@"o_pct", frPlatPct, LIM_SMALL, bFrPlatMeasured())
    benchLog.naNumField(@"o_rest", frPlatRestMs, LIM_SMALL, bFrPlatRestFound)
    benchLog.boolField(@"o_spndn", bFrPlatSpinDn)
    benchLog.tokenField(@"l_cause", tokenAt(@tokFltCause, FC_COUNT, fltLeftCause), TOKMAX_FCAUSE)
    benchLog.tokenField(@"r_cause", tokenAt(@tokFltCause, FC_COUNT, fltRightCause), TOKMAX_FCAUSE)
    whyField(frWhy)
    emitRecord()

#endif

#ifdef DBG_NOTBUILT
PRI emitSignoffNotBuilt(pCell, side, pCrit)
' One NOT_BUILT SIGNOFF: a cell this build declares and does not build, measured NA, n 0 (the reason is its
' BM-NOTBUILT header record). Worst case 168 bytes.
'
' @param pCell - pointer to the cell id
' @param side - SIDE_* value
' @param pCrit - pointer to the criterion token

    benchLog.begin(@"SIGNOFF")
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.tokenField(@"bin", @sSfBin, TOKMAX_BIN)
    benchLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    benchLog.tokenField(@"task", @sSfTask, TOKMAX_TASK)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"crit", pCrit, TOKMAX_CRIT)
    benchLog.textField(@"measured", @sSfNa)
    benchLog.textField(@"lo", @sSfNa)
    benchLog.textField(@"hi", @sSfNa)
    benchLog.tokenField(@"units", @sSfNa, TOKMAX_UNITS)
    benchLog.numField(@"n", 0, LIM_SMALL)
    benchLog.tokenField(@"verdict", @sSfNotBuilt, TOKMAX_SFVERDICT)
    emitRecord()

#endif

#ifdef DBP_FAULTRESP
PRI wheelSetFaultResponse(side, eMode, brakePct) : eError
' setFaultResponse() on one wheel (R19.3; public since R20.1): the response to a position fault, and the graded short's %.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param eMode - FR_SHIPPED or FR_GRADED
' @param brakePct - the graded short's shorted time, % of each brake period
' @returns eError - the library's return

    beat(CP_LIB_COMMAND)
    if side == SIDE_RIGHT                                   ' if/else, never `? :` -- PL-29, PL-76
        eError := wheelR.setFaultResponse(eMode, brakePct)
    else
        eError := wheelL.setFaultResponse(eMode, brakePct)
    beat(CP_LIB_COMMAND)

PRI wheelFaultResponse(side) : eMode, nBrakeOn, nResyncs
' testGetFaultResponse() of one wheel: the response in effect, the graded short's brake_on, and the re-syncs since start.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns eMode - FR_SHIPPED or FR_GRADED
' @returns nBrakeOn - the graded short's shorted frames per brake period
' @returns nResyncs - faults answered by a re-sync and a controlled stop since start

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        eMode, nBrakeOn, nResyncs := wheelR.testGetFaultResponse()
    else
        eMode, nBrakeOn, nResyncs := wheelL.testGetFaultResponse()
    beat(CP_LIB_QUERY)

PRI wheelFaultCause(side) : eCause
' getFaultCause() of one wheel.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns eCause - FC_NONE, FC_LAG or FC_HALL

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        eCause := wheelR.getFaultCause()
    else
        eCause := wheelL.getFaultCause()
    beat(CP_LIB_QUERY)

PRI wheelHoldStatus(side) : eHoldState
' getHoldStatus() of one wheel, the state only.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns eHoldState - HS_OFF, HS_HOLDING, HS_SLIPPED or HS_LIMITED

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        eHoldState, _ := wheelR.getHoldStatus()
    else
        eHoldState, _ := wheelL.getHoldStatus()
    beat(CP_LIB_QUERY)

#endif

#ifdef DBG_FORCE
PRI steerSetFaultResponse(eMode, brakePct) : eError
' setFaultResponse() on both steering wheels (R19.3; public since R20.1).
'
' @param eMode - FR_SHIPPED or FR_GRADED
' @param brakePct - the graded short's shorted time, % of each brake period
' @returns eError - the steering object's return

    beat(CP_LIB_STEER_DRIVE)
    eError := steering.setFaultResponse(eMode, brakePct)
    beat(CP_LIB_STEER_DRIVE)

#endif

#ifdef DBG_FRPLAT
PRI wheelForceFault(side) : eError
' testForceFault() on one wheel (R19.3, TEST-USE): the driver faults on its next driven frame.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns eError - the library's return

    beat(CP_LIB_COMMAND)
    if side == SIDE_RIGHT                                   ' if/else, never `? :` -- PL-29, PL-76
        eError := wheelR.testForceFault()
    else
        eError := wheelL.testForceFault()
    beat(CP_LIB_COMMAND)

#endif

#ifdef DBG_FORCE
PRI steerForceFault(side) : eError
' testLeftForceFault() / testRightForceFault() on the steering object: one wheel faults on its next driven frame.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns eError - the steering object's return

    beat(CP_LIB_STEER_DRIVE)
    if side == SIDE_RIGHT
        eError := steering.testRightForceFault()
    else
        eError := steering.testLeftForceFault()
    beat(CP_LIB_STEER_DRIVE)

#endif

#ifdef DBP_FAULTRESP
PRI frHookRestTrial(side) | slotIdx, whyCode, sampleIdx, nSamples, bFaultSeen, bStateOk, hwMoved, bMeasured, bOk, hookSr
' HOOKREST, the forced-fault hook's negative control, run FIRST on each wheel (D2). In its own lifetime, holdAtStop(FALSE)
' (the lifetime's own), the wheel at rest and the bridge coasting: testForceFault() must NOT fault, because the driver
' looks for a forced fault only on a DRIVEN frame (isp_bldc_motor.spin2, the fault test's `tjnz bridge, #.noFault`
' ahead of the force check). Watched FR_HOOK_WIN_MS after the force: no sample may carry the fault latch and every
' sample must read DCS_STOPPED. FAILS on either -- a hook that faults a motor it is not driving. The request stays
' pending in the driver (only a fault advances force_seen), so this lifetime ends here and the pending request with it;
' the next trial starts a fresh one. BM-FRHOOK.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
'
' @local slotIdx - motor slot
' @local whyCode - why nothing was measured, WHY_NONE when it was
' @local sampleIdx - logical index
' @local nSamples - up samples watched after the force
' @local bFaultSeen - a sample carried the fault latch
' @local bStateOk - every sample was up and read DCS_STOPPED
' @local hwMoved - hall ticks the wheel moved across the window (hwPos)
' @local bMeasured - samples after the force were read
' @local bOk - no fault, and STOPPED throughout
' @local hookSr - task 3621: getStopReason() after the window, R20-DUAL-SR-FAULT's HOOKREST negative (BM-SR)

    slotIdx := side - SIDE_LEFT
    curTid := 0
    frForceErr := NO_ERROR
    nSamples := 0
    bFaultSeen := FALSE
    bStateOk := TRUE
    hwMoved := 0
    bMeasured := FALSE
    whyCode := WHY_NONE
    if bRunContinue(SEG_FLTRESP) == FALSE
        whyCode := WHY_ABORTED
    elseif bWheelStart(SEG_FLTRESP, side) == FALSE
        whyCode := stWhy
    whyCode := trialSkipWhy(SEG_FLTRESP, side, whyCode)
    if whyCode == WHY_NONE
        if bInstArm(INST_SRC_WHEELS, 1) == FALSE
            whyCode := WHY_INST_NOACK
        else
            waitWatched(side, FR_HOOK_SETTLE_MS, CP_LOOP_SETTLE, UNTIL_TIME)
            instMark()
            frForceErr := wheelForceFault(side)
            waitWatched(side, FR_HOOK_WIN_MS, CP_LOOP_CAPTURE, UNTIL_TIME)    ' a fault ends it early: the samples say so
            if bInstFreeze(0)
                drainBegin()
                drainFindMark()
                if bDrMarkFound and (drMarkJ < drStored)
                    repeat sampleIdx from drMarkJ to drStored - 1
                        beat(CP_LOOP_DRAIN)
                        nSamples += 1
                        if bSmpFault(sampleIdx, slotIdx)
                            bFaultSeen := TRUE
                        if (bSmpUp(sampleIdx, slotIdx) == FALSE) or (smpState(sampleIdx, slotIdx) <> DCS_STOPPED)
                            bStateOk := FALSE
                    hwMoved := abs(smpHw(drStored - 1, slotIdx) - smpHw(drMarkJ, slotIdx))
                    bMeasured := TRUE
                else
                    whyCode := WHY_NO_SAMPLES
            else
                whyCode := WHY_INST_NOACK
    bOk := bMeasured and (bFaultSeen == FALSE) and bStateOk
    if bMeasured
        bSfHookRan[slotIdx] := TRUE
        bSfHookOk[slotIdx] := bOk
    emitFrHook(side, nSamples, bFaultSeen, bStateOk, hwMoved, bMeasured, bOk, whyCode)
    if bMeasured and isWheelUp(side)                        ' task 3621: nothing was driven, so no drive has ended: SR_NONE
        hookSr := wheelStopReason(side)
        emitSr(EVST_FRHOOK, side, hookSr, hookSr, side == SIDE_LEFT, side == SIDE_RIGHT)
        srFaultNote(slotIdx, FALSE, hookSr == wheelL.SR_NONE)
    bInstIdle()
    wheelStop(side)                                         ' ends the lifetime, and the pending forced request with it
    segItems := (segItems + 1) <# LIM_SMALL

PRI emitFrHook(side, nSamples, bFaultSeen, bStateOk, hwMoved, bMeasured, bOk, whyCode)
' BM-FRHOOK: the hook's at-rest negative control -- the force call's return, the samples watched after it, whether any
' carried the fault latch, whether every one read DCS_STOPPED, how far the wheel moved, and the verdict's input. Worst
' case 131 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param nSamples - samples watched after the force
' @param bFaultSeen - a sample carried the fault latch
' @param bStateOk - every sample was up and read DCS_STOPPED
' @param hwMoved - hall ticks moved across the window
' @param bMeasured - the samples were read
' @param bOk - no fault, and STOPPED throughout
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-FRHOOK")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"f_err", frForceErr, LIM_SMALL)
    benchLog.naNumField(@"n", nSamples, LIM_SMALL, bMeasured)
    if bMeasured
        benchLog.boolField(@"flt", bFaultSeen)
        benchLog.boolField(@"st_ok", bStateOk)
    else
        benchLog.textField(@"flt", @sSfNa)
        benchLog.textField(@"st_ok", @sSfNa)
    benchLog.naNumField(@"hw_moved", hwMoved, LIM_SMALL, bMeasured)
    benchLog.boolField(@"ok", bOk)
    whyField(whyCode)
    emitRecord()
#endif

CON { --- START: the startup study's B-cells through the steering object (task 3613, R19.7) --- }

  ' WHAT THIS PART IS FOR. Visit 10 sizes what R19.4 exposes -- the rest-zero band (REST_ZERO_MIN_MV / MAX_MV) and the
  '  lead check's two thresholds (CONT_MIN_DRIVEN_MV, CONT_FOLLOW_PCT) -- and certifies the start checks and the
  '  opt-in wiring walk, per DOCs/analyses/STARTUP-SELFTEST-STUDY-2026-09-23.md sec 6 (B-2, B-5). Every start is its
  '  own steering lifetime, so each one re-runs the rest zero, runStartChecks() and the lead probe from scratch.
  '
  ' WHAT EACH LIFETIME READS, in this order: getHealth() (checked and failed masks per wheel), the illegal hall codes
  '  split by kind (B-1's reading), getPackVoltage(), and the nine BR_PROBE readings per wheel (testLeftGetProbe() /
  '  testRightGetProbe(), PRB_U..PRB_W) -- all of them what start() itself judged. Then, with the bridge coasting
  '  (holdAtStop(FALSE), nothing commanded), a ZERO_WINDOW_MS window through the instrument gives two things:
  '   - the REST ZERO, as lifetimeZero() takes every wheel lifetime's: the mean sense_i over the window. The driver's
  '     own restZeroSenseMv has no getter, and this part adds none; the driver's own verdict on it is HLT_SENSE_ZERO.
  '     RZSPREAD judges THIS estimate against the driver's band, REST_ZERO_MIN_MV .. REST_ZERO_MAX_MV (-17 .. 36 mV,
  '     DERIVED at DRIVER_REV 40 for the driver's own estimate, the offset rounded, with 2 mV allowed for it). This
  '     one is the plain mean of floored readings (x10, truncated), so it reads the offset less 0.5 mV, less up to
  '     0.1 for the x10 truncate, +/- 0.23 (3 sigma of ~500 samples at the library's 1.73 mV a reading): offset
  '     -0.83 .. -0.27 mV. Inside the band's 2 mV either way: a healthy Rev B offset (-15 .. 34.1 mV by the
  '     band's own terms) reads -15.83 .. 33.83. Not a reading the driver changed at DRIVER_REV 40 (raw sense_i).
  '   - the COAST FLOOR, each phase's largest |reading| over the window: THE PROBE'S ABLE-TO-REPORT CONTROL. An open
  '     lead reads this floor while its phase is probed, so the follower test can tell an open lead from a connected
  '     one only when the floor sits under the least a follower may read and pass (SK_FLOOR_HI_MV).
  '
  ' THE WALK (B-5 positive), the last SK_WALKS lifetimes: checkWiring() turns the platform in place, each wheel
  '  one electrical cycle each way at WALK_POWER. Its verdict is HLT_WIRING. The two legs are REBUILT from the
  '  instrument's ring on raw hall ticks (the reading checkWiring() itself differences), independently of the driver:
  '  from the first sample at the mark, the leg out is the largest excursion and the leg back is from there to the last
  '  sample. A failing walk cannot be rebuilt into a passing one -- a leg back that runs past the start moves the
  '  excursion to the end, which leaves a leg of 0. checkWiring() blocks cog 0: in the steering object two legs of at
  '  most WALK_LEG_TIMEOUT_MS each, the second run after a timed-out first too, plus the request bounds -- about 4.1 s
  '  at worst, so the watchdog is granted WD_WALK_GRACE_MS for that one call (derived at the constant). The absolute
  '  current abort is not polled while it blocks; the walk's peak sense_i is printed from the ring (at WALK_POWER 10 it
  '  is small).
  '
  ' THE DRIVER'S OWN LEG RECORD (PL-137, DRIVER_REV 24). Visit 10 pass 4 saw a healthy left wheel come back 5 ticks
  '  (walk_ms 1_621, against 1_275), and neither the ring's two numbers nor HLT_WIRING could say why. So dual-start walks
  '  in every lifetime (SK_WALKS = SK_LIVES; a false FAIL at about 1 in 24 needs the walks), and after the rest confirm
  '  each wheel's record of each leg is read (testLeftGetWalkLeg() / testRightGetWalkLeg()) and printed as BM-SKWLEG:
  '  how the leg ended (WLE_*), its post position, and relative to that the furthest it went, where the distance limit
  '  fired (with the tracked ticks and the stopping ticks it fired on), where the driver first reported rest, where the
  '  wait ended, and where the rotor settled -- the first leg's at the second leg's command, the second's at this read,
  '  after the rest confirm -- with the ms of each and the lag-held passes. A DIAGNOSTIC: no cell judges it; the report
  '  reads it beside BM-SKWALK. dual-start-swapneg keeps its last SK_WALKS_SWAP walks, its negative unchanged.
  '
  ' NO PREFLT. B-1's attended negative loads this same part (the START_NO_WALK build) with a wheel's hall connector
  '  unplugged, and a preflight would drive that wheel before a single start was read, or end the run at NO_MOTION
  '  before the cells. The walk is this part's motion proof. B-3's and B-5's negatives need no rewiring (task 3614):
  '  the rig cannot open a motor lead or swap two hall wires, so the firmware makes both, below.
  '
  ' THE FIRMWARE NEGATIVES (task 3614), each its own build and each on the LEFT wheel, the board known to drive; the
  '  RIGHT runs unarmed beside it as the in-run control. Each hook is one-shot: set on the steering object before
  '  bSteerStart(), consumed by that start. Every armed start prints BM-SKNEG before its BM-SSTART.
  '   - START_NEG_PHASE (B-3's negative, no walk): every lifetime withholds one LEFT phase from the lead check
  '     (testLeftSetProbeWithhold()), U V W in turn by lifetime. R19-DUAL-PHNEG-X counts the starts whose LEFT failed
  '     mask is not EXACTLY that phase's HLT_PHASE_* bit: a wheel whose bridge drives nothing fails all three bits
  '     ($001C, debug_260923-160440.log), so a cell satisfied by any failed bit could not tell one lead from a bridge.
  '     Task 3621: since a failing check now refuses the start, the lifetimes rotate through three start modes (THE
  '     START REFUSAL, below), and PHNEG-X counts the opt-out ones, which start exactly as every lifetime did before.
  '   - START_NEG_SWAP (B-5's negative, the walk build): every walk lifetime reads LEFT hall bits 0 and 1 swapped
  '     (testLeftSetHallSwap(HSW_HALLS_01)). R19-DUAL-SWNEG-X counts the walks in which the LEFT HLT_WIRING was not
  '     judged failed: a pass, and equally a walk that never judged it, leaves the swap undetected.
  '
  ' THE WINDING CHECK (task 3610, R19.4 1e; BUILD_WIND). Armed on the steering object before bSteerStart(), one-shot
  '  like the negatives, it has start() drive each wheel's pairs U->V, V->W, W->U in turn from the DC link and report
  '  each pair's state and resistance (testLeftGetWinding() / testRightGetWinding(), read right after skReadHealth()).
  '  THE ROTORS MOVE to each pair's alignment: wheels up. Every armed lifetime prints BM-SKWIND per wheel.
  '   - dual-start: lifetimes 0 .. SK_WIND_LIVES-1. R19-DUAL-WINDR-X counts the pairs not WND_MEASURED or outside
  '     WIND_R_LO_MOHM .. WIND_R_HI_MOHM (a PROVISIONAL plausibility band); R19-DUAL-WINDSPR-X counts the lifetimes
  '     whose three pairs are not all MEASURED and within WIND_SPREAD_PCT of their mean. Pre-registered for the report
  '     (not a cell): each pair 300-600 mohm (task 3609), the two wheels within 20 %. R20.4 (DRIVER_REV 25): R = d^2 x V
  '     / I_dc takes the pack sensor's own reading for V when it reads a pack, else the nominal; BM-SKWIND prints which
  '     (v_src, v_mV), and R20-PACK-WINDV counts the lifetimes whose voltage does not have the basis the sensor reads.
  '   - START_NEG_PHASE: every lifetime, beside its withheld LEFT phase. A withheld phase neither drives nor returns, so
  '     R19-DUAL-WINDNEG-X counts the LEFT lifetimes in which the two pairs containing it are not both WND_NOT_VISIBLE
  '     or the third is not WND_MEASURED: a hook that did not take (three MEASURED) fails it, and so does the wrong
  '     pair going dark. The RIGHT is the in-run control (all three MEASURED), judged in the report from BM-SKWIND.
    SK_LIVES_BASE         = 10                              ' steering lifetimes, each one start (B-2: "several starts")
    SK_LIVES_PHASENEG     = 12                              ' task 3621: START_NEG_PHASE's, 4 blocks of U V W (skModeOf())
    SK_LIVES              = SK_LIVES_BASE + ((BUILD_NEG == SKNEG_PHASE) & (SK_LIVES_PHASENEG - SK_LIVES_BASE))
    SK_WALKS_SWAP         = 3                               ' dual-start-swapneg: its last this many lifetimes walk (B-5's negative)
    ' the last this many lifetimes also walk (B-5): every one in dual-start (PL-137), SK_WALKS_SWAP otherwise
    SK_WALKS              = SK_WALKS_SWAP + (BUILD_START_POS & (SK_LIVES - SK_WALKS_SWAP))
    SK_PHASES             = 3
    SK_PROBE_LONGS        = SK_PHASES * SK_PHASES           ' per wheel: [probed phase * SK_PHASES + read phase], U V W
    SK_PCT_SCALE          = 100
    SK_ZERO_SCALE         = X10                             ' the rest zero is carried x10, as lifetimeZero() carries it
    ' The least a follower may read and still pass is CONT_FOLLOW_PCT of the least a driven phase may read: 200 x 50 %
    '  = 100 mV. A coast floor strictly under it would fail the follower test -- the control passes at 99 mV and below.
    SK_FLOOR_LO_MV        = 0
    SK_FLOOR_HI_MV        = ((wheelL.CONT_MIN_DRIVEN_MV * wheelL.CONT_FOLLOW_PCT) / SK_PCT_SCALE) - 1
    ' B-5's pre-registered legs: one electrical cycle, plus the coast checkWiring() allows -- 6 .. 9 ticks each way
    SK_LEG_LO_TICKS       = wheelL.WALK_TICKS - wheelL.WALK_SHORT_TICKS   ' the driver's own band (DRIVER_REV 40)
    SK_LEG_HI_TICKS       = wheelL.WALK_TICKS + wheelL.WALK_OVERSHOOT_TICKS
    SK_WALK_PRE_MS        = 20                              ' samples stored before the walk's mark
    SK_WALK_REST_MS       = 1_000                           ' bound on the rest confirm after checkWiring() returns
    SK_BAD_LO             = 0                               ' every START count cell passes at zero bad instances
    SK_BAD_HI             = 0
    PACK_TOK_COUNT        = wheelL.PACK_PRESENT + 1         ' tokPack is indexed by the library's PACK_*
    TOKMAX_PACK           = 10
    ' SRC_REV 56: R19-DUAL-PACK-X, fitted, wants a plausible 5S pack (VOLTAGE-SENSOR.md "The numbers (5S)", the pack
    '  the sensor is sized for and the bench runs). LOW: the cutoff, 3.00 V/cell = 15.0 V -- under it the pack is not
    '  one to run on, and both of the page's wrong readings lie under it (an unplugged sensor about 0 V, a floating pin
    '  about 12.8 V). HIGH: fully charged, 4.20 V/cell = 21.0 V, plus 500 mV for the divider's gain error before
    '  calibration (two 1 % resistors, up to about 2 %, 420 mV at 21 V; the bench's measured 1.2 %, cal 1012).
    SK_PACK_LO_MV         = 15_000
    SK_PACK_HI_MV         = 21_500
    ' task 3614: the firmware negatives' names (the motor object's own enums, reached as wheelL.<CONST>)
    SKNEG_SWAP_SEL        = wheelL.HSW_HALLS_01             ' the one hall pair START_NEG_SWAP reads as swapped
    PRB_TOK_COUNT         = wheelL.PRB_W + 1                ' tokPrbPhase is indexed by the library's PRB_*
    HSW_TOK_COUNT         = wheelL.HSW_HALLS_02 + 1         ' tokHallSwap by its HSW_*
    TOKMAX_SKNEG_KIND     = 5
    TOKMAX_SKNEG_WHICH    = 8
    ' task 3610: the winding check (the motor object's WND_* reached as wheelL.<CONST>)
    SK_WIND_LIVES         = 2                               ' dual-start: lifetimes 0 .. SK_WIND_LIVES-1 arm it
    SK_WIND_PAIRS         = 3                               ' U->V, V->W, W->U: pair p drives phase p, returns through p+1
    WIND_R_LO_MOHM        = 100                             ' PROVISIONAL plausibility band for one pair, mohm
    WIND_R_HI_MOHM        = 1_500
    WIND_SPREAD_PCT       = 20                              ' a lifetime's pairs each within this % of their mean
    WND_TOK_COUNT         = wheelL.WND_UNSETTLED + 1        ' tokWndState is indexed by the library's WND_*
    TOKMAX_WND            = 11                              ' NOT_VISIBLE
    ' R20.4 (task 3611): R20-PACK-WINDV. The check reads the pack itself before the pairs (windVoltage(), ~64 ms averaged)
    '  and the getter's own average is read about a second later, both at rest: 200 mV is 1 % of the pack, so a
    '  resistance computed from either differs by 1 %, a twentieth of WIND_SPREAD_PCT. A check that used the nominal
    '  18.5 V beside a pack above 18.7 V or under 18.3 V falls outside it; nearer 18.5 V only the source can tell them
    '  apart, and it must read PRESENT
    SK_WINDV_MV           = 200
    ' PL-137: one wheel's record of one walk leg, in skWl[] from skWlBase(), in the getter's order (testLeftGetWalkLeg())
    #0, SKWL_END, SKWL_END_MS, SKWL_POST, SKWL_PEAK, SKWL_LIM, SKWL_LIM_MS, SKWL_TRK, SKWL_STPTK, SKWL_STOP, ...
        SKWL_STOP_MS, SKWL_ENDP, SKWL_SETTLE, SKWL_MV_MS, SKWL_FINAL, SKWL_LAG
    SKWL_FIELDS           = SKWL_LAG + 1
    SKWL_LONGS            = INST_MOTORS * wheelL.WALK_LEGS * SKWL_FIELDS
    WLEG_TOK_COUNT        = wheelL.WALK_LEGS                ' tokWalkLeg is indexed by the library's WLEG_*
    WLE_TOK_COUNT         = wheelL.WLE_OTHER + 1            ' tokWalkEnd by its WLE_*
    TOKMAX_WLEG           = 4                               ' BACK
    TOKMAX_WLE            = 7                               ' NOT_RUN, TIMEOUT

  ' THE START REFUSAL (task 3621, R20.1; DRIVER-REPORTING-DESIGN.md SS3). start() now re-runs a failing check up to
  '  START_CHECK_RETRIES times and then REFUSES the start (-1, ERR_START_CHECK_FAILED) unless setStartChecks(FALSE) was
  '  called. Each lifetime's start is given a MODE, set before it (skSetRefusal(), skArmNeg()) and printed on BM-SKHEALTH
  '  (refuse) and BM-SKNEG (mode):
  '   SKM_DEFAULT - refusal on (the library's default), nothing withheld: dual-start, dual-start-swapneg
  '   SKM_OPTOUT  - setStartChecks(FALSE): every dual-start-nowalk lifetime (B-1's unplugged halls must still start), and
  '                 START_NEG_PHASE's blocks 0 and 3 with the LEFT phase withheld from EVERY attempt -- where R19-DUAL-PHNEG-X
  '                 and R19-DUAL-WINDNEG-X are judged exactly as before task 3621, and where R20-DUAL-OPTOUT is judged
  '   SKM_REFUSE  - refusal on, the LEFT phase withheld from every attempt: START_NEG_PHASE's block 1 (R20-DUAL-REFUSE)
  '   SKM_FIRST   - refusal on, the LEFT phase withheld from the FIRST attempt only
  '                 (testLeftSetProbeWithholdFirst()): START_NEG_PHASE's block 2 (R20-DUAL-RETRY)
  '  A block is SK_PHASES lifetimes, so each mode withholds U, V and W once (the phase is lifeIdx // SK_PHASES, as
  '  before). The winding check is armed only in the opt-out lifetimes: it honours only the every-attempt withhold, and
  '  a refused start reads nothing of it.
    #0, SKM_DEFAULT, SKM_OPTOUT, SKM_REFUSE, SKM_FIRST
    SKM_COUNT             = SKM_FIRST + 1
    SKM_ROTATION          = 3                               ' START_NEG_PHASE: OPTOUT, REFUSE, FIRST, then OPTOUT again
    TOKMAX_SKMODE         = 7                               ' DEFAULT
  ' The reporting cells the START builds judge (task 3621, SS6), each a count of instances and of bad ones (skrNote()):
  '  SKR_REF   - REFUSE, START_NEG_PHASE block 1: -1, ERR_START_CHECK_FAILED from the platform and the LEFT, and the LEFT
  '              failed mask exactly the withheld bit, read after the refusal (BM-SREFUSE)
  '  SKR_OPT   - OPTOUT, START_NEG_PHASE's opt-out blocks: the start taken, with the LEFT failed mask exactly that bit
  '  SKR_RET   - RETRY's positive, START_NEG_PHASE block 2: the start taken, LEFT failed 0, recovered the bit, and one
  '              LEFT EV_CHECK_RETRY valued the bit | 2 attempts
  '  SKR_NORET - RETRY's negative, per wheel judged: recovered 0 and no EV_CHECK_RETRY -- START_NEG_PHASE's RIGHT every
  '              started lifetime and its LEFT in the opt-out ones (withheld every attempt, so never recovered);
  '              dual-start both wheels every started lifetime
  '  SKR_NOREF - NOREFUSE, dual-start: a start returned -1
  '  SKR_GRD   - EV-WALKGUARD's positive, dual-start-swapneg LEFT walks: at least one EV_WALK_GUARD, each at least
  '              WALK_I_LIMIT_MV (Visit 10 pass 2 MEASURED every crossed-hall leg at 577 mV or more, so the guard trips)
  '  SKR_NOGRD - its negative, per wheel judged: no EV_WALK_GUARD -- swapneg's RIGHT walks, dual-start's walks, both wheels
  '  SKR_MIS   - EV-HALLMISSED's positive, swapneg LEFT walk lifetimes that missed a transition: the EV_HALL_MISSED values
  '              sum to getHallIntegrityCounts()'s missed count
  '  SKR_NOHAL - its negative, dual-start, both wheels every started lifetime: no EV_HALL_MISSED and no EV_HALL_ILLEGAL
  '  SKR_ILL   - EV-HALLILL's positive, dual-start-nowalk RIGHT lifetimes with an illegal code: the EV_HALL_ILLEGAL values
  '              sum to getHallIllegalCodes()'s two counts
  '  SKR_NOILL - its negative, dual-start-nowalk LEFT (connected), every started lifetime: no EV_HALL_ILLEGAL
  '  SKR_PACK  - R20-PACK-EV's negative, dual-start with the pack sensor fitted: no EV_PACK while the pack stands
  '  Every instance judged on a drain that was not clean is bad.
    #0, SKR_REF, SKR_OPT, SKR_RET, SKR_NORET, SKR_NOREF, SKR_GRD, SKR_NOGRD, SKR_MIS, SKR_NOHAL, SKR_ILL, SKR_NOILL, SKR_PACK
    SKR_COUNT             = SKR_PACK + 1

#ifdef DBG_PACKTOK
DAT ' ---- the pack status tokens, START's and PACK's (PL-152: in those two parts' images only) ----

tokPack         BYTE    "NOT_FITTED", 0, "ABSENT", 0, "PRESENT", 0, TOK_END
#endif

#ifdef DBP_START
DAT ' ---- START tables ----

tokSkNegKind    BYTE    "NONE", 0, "PHASE", 0, "SWAP", 0, TOK_END                       ' indexed by SKNEG_*
tokPrbPhase     BYTE    "NONE", 0, "U", 0, "V", 0, "W", 0, TOK_END                      ' by PRB_*
tokHallSwap     BYTE    "NONE", 0, "HALLS_01", 0, "HALLS_12", 0, "HALLS_02", 0, TOK_END ' by HSW_*
tokWndState     BYTE    "NOT_RUN", 0, "MEASURED", 0, "NOT_VISIBLE", 0, "TRIPPED", 0, "UNSETTLED", 0, TOK_END   ' by WND_*
tokSkMode       BYTE    "DEFAULT", 0, "OPTOUT", 0, "REFUSE", 0, "FIRST", 0, TOK_END                   ' by SKM_* (task 3621)
tokWalkLeg      BYTE    "OUT", 0, "BACK", 0, TOK_END                                                  ' by WLEG_* (PL-137)
tokWalkEnd      BYTE    "NOT_RUN", 0, "LIMIT", 0, "TIMEOUT", 0, "GUARD", 0, "FAULT", 0, "ESTOP", 0, "OTHER", 0, TOK_END   ' by WLE_*

VAR { START state -- cog 0 only }

    ' one lifetime's readings (skStagingReset())
    LONG    skLife                                          ' the steering lifetime, 0 when none was started
    LONG    bSkHealthRead                                   ' start()'s verdicts were read from a running object
    LONG    skChk[INST_MOTORS]                              ' getHealth() checked mask
    LONG    skFail[INST_MOTORS]                             ' ...and failed mask
    LONG    skIllLo[INST_MOTORS]                            ' getHallIllegalCodes(): entries into %000
    LONG    skIllHi[INST_MOTORS]                            ' ...and into %111
    LONG    skPack                                          ' getPackVoltage() status
    LONG    skPackMv                                        ' ...and mV
    LONG    skProbe[INST_MOTORS * SK_PROBE_LONGS]           ' [slot * SK_PROBE_LONGS + probed * SK_PHASES + read], mV
    LONG    skPrbBadNow[INST_MOTORS]                        ' this start's probes that failed the lead check
    LONG    bSkZeroValid[INST_MOTORS]                       ' the floated window held samples
    LONG    skZeroX10[INST_MOTORS]                          ' its mean sense_i, mV x10: the rest zero
    LONG    skZeroN[INST_MOTORS]                            ' its samples
    LONG    skFloor[INST_MOTORS * SK_PHASES]                ' each phase's largest |reading| over it, mV
    LONG    skZeroWhy                                       ' the first cause of a missing window
    LONG    bSkNegArmed                                     ' task 3614: this lifetime's start carried the build's negative
    LONG    skNegSel                                        ' ...its PRB_* (PHASE) or HSW_* (SWAP) selection
    LONG    skNegErr                                        ' ...the hook's return
    LONG    bSkWindArmed                                    ' task 3610: this lifetime's start carried the winding check
    LONG    skWindState[INST_MOTORS * SK_WIND_PAIRS]        ' [slot * SK_WIND_PAIRS + pair]: WND_*
    LONG    skWindMohm[INST_MOTORS * SK_WIND_PAIRS]         ' ...the pair's resistance when WND_MEASURED, mohm
    LONG    skWindMv[INST_MOTORS * SK_WIND_PAIRS]           ' ...its net DC-link reading, mV
    LONG    skWindVSrc[INST_MOTORS]                         ' R20.4: the PACK_* source of the voltage each wheel's check used
    LONG    skWindVMv[INST_MOTORS]                          ' ...and that voltage, mV
    ' one walk (skWalk())
    LONG    bSkWalkRan                                      ' checkWiring() was called
    LONG    skWalkErr                                       ' its return
    LONG    skWalkMs                                        ' how long it blocked
    LONG    bSkLegsValid                                    ' the legs were rebuilt from the ring
    LONG    bSkWalkHlt[INST_MOTORS]                         ' HLT_WIRING checked and not failed
    LONG    bSkWalkHltFail[INST_MOTORS]                     ' HLT_WIRING checked and failed (task 3614: the swap caught)
    LONG    skLegFwd[INST_MOTORS]                           ' the leg out, raw hall ticks
    LONG    skLegRev[INST_MOTORS]                           ' the leg back
    LONG    skWalkIg[INST_MOTORS]                           ' missed + illegal hall events across the walk
    LONG    skWalkPkI[INST_MOTORS]                          ' the largest sense_i across it, mV; NEGX when none
    LONG    bSkWalkOk[INST_MOTORS]                          ' the walk's pre-registered reading held
    LONG    skWalkCause[INST_MOTORS]                        ' getFaultCause() after it
    LONG    skWalkWhy                                       ' the first cause of the walk's NA fields
    LONG    bSkWlRead                                       ' PL-137: the driver's leg records were read after the walk
    LONG    skWl[SKWL_LONGS]                                ' ...each wheel's, each leg's, at skWlBase(): the getter's values
    ' the cells' accumulators (skResetCells())
    LONG    sfSkStarts[INST_MOTORS]                         ' HEALTH: starts read
    LONG    sfSkHealthBad[INST_MOTORS]                      ' ...with any failed bit, or not every check checked
    LONG    skRzN[INST_MOTORS]                              ' RZSPREAD: rest zeros measured
    LONG    skRzMin[INST_MOTORS]                            ' ...least, x10
    LONG    skRzMax[INST_MOTORS]                            ' ...greatest, x10
    LONG    skRzSum[INST_MOTORS]                            ' ...sum, x10
    LONG    sfSkRzOut[INST_MOTORS]                          ' ...outside REST_ZERO_MIN_MV .. REST_ZERO_MAX_MV
    LONG    skFlN[INST_MOTORS]                              ' PRBFLR: coast floors measured
    LONG    skFlMax[INST_MOTORS]                            ' ...the largest phase reading of any, mV
    LONG    skPrbN[INST_MOTORS]                             ' PROBE: probes judged (three a start)
    LONG    sfSkPrbBad[INST_MOTORS]                         ' ...that failed the lead check
    LONG    skDrvMin[INST_MOTORS]                           ' ...the least driven reading, mV
    LONG    skFolMinPct[INST_MOTORS]                        ' ...the least follower reading, % of its driven phase
    LONG    sfSkWalkN[INST_MOTORS]                          ' WALK: walks run
    LONG    sfSkWalkBad[INST_MOTORS]                        ' ...whose pre-registered reading did not hold
    LONG    sfSkPackN                                       ' PACK: starts read
    LONG    sfSkPackBad                                     ' ...whose pack reading did not match the configuration (bSkPackAsConfig())
    LONG    sfSkPhNegN                                      ' PHNEG (task 3614): armed starts read, LEFT
    LONG    sfSkPhNegBad                                    ' ...whose failed mask was not exactly the withheld phase's bit
    LONG    sfSkSwNegN                                      ' SWNEG (task 3614): armed walks run, LEFT
    LONG    sfSkSwNegBad                                    ' ...whose HLT_WIRING was not judged failed
    LONG    sfSkWindRN[INST_MOTORS]                         ' WINDR (task 3610): pairs read, dual-start
    LONG    sfSkWindRBad[INST_MOTORS]                       ' ...not WND_MEASURED or outside WIND_R_LO_MOHM .. WIND_R_HI_MOHM
    LONG    sfSkWindSpN[INST_MOTORS]                        ' WINDSPR: armed lifetimes read, dual-start
    LONG    sfSkWindSpBad[INST_MOTORS]                      ' ...whose pairs were not all MEASURED within WIND_SPREAD_PCT
    LONG    sfSkWindNgN                                     ' WINDNEG: armed lifetimes read, LEFT, START_NEG_PHASE
    LONG    sfSkWindNgBad                                   ' ...whose pair states were not exactly the withheld phase's
    LONG    sfSkWindVN[INST_MOTORS]                         ' WINDV (R20.4): armed lifetimes read, dual-start
    LONG    sfSkWindVBad[INST_MOTORS]                       ' ...whose check's voltage was not the one its basis names
    ' task 3621 (R20.1): the lifetime's start mode and what it recovered, and the reporting cells' accumulators
    LONG    skLifeMode                                      ' SKM_* of the lifetime in hand
    LONG    bSkStartTried                                   ' its start was called
    LONG    skRec[INST_MOTORS]                              ' getHealth()'s recovered mask, per wheel, of a start that ran
    LONG    sfSkrN[SKR_COUNT]                               ' instances judged, per SKR_*
    LONG    sfSkrBad[SKR_COUNT]                             ' ...that did not read as pre-registered

PRI skResetCells() | slotIdx
' Clear the START part's cell accumulators (initRunState()): every count 0, every least POSX and greatest NEGX, so a
' cell no lifetime reached prints NOMEAS.
'
' @local slotIdx - motor slot

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        sfSkStarts[slotIdx] := 0
        sfSkHealthBad[slotIdx] := 0
        skRzN[slotIdx] := 0
        skRzMin[slotIdx] := POSX
        skRzMax[slotIdx] := NEGX
        skRzSum[slotIdx] := 0
        sfSkRzOut[slotIdx] := 0
        skFlN[slotIdx] := 0
        skFlMax[slotIdx] := 0
        skPrbN[slotIdx] := 0
        sfSkPrbBad[slotIdx] := 0
        skDrvMin[slotIdx] := POSX
        skFolMinPct[slotIdx] := POSX
        sfSkWalkN[slotIdx] := 0
        sfSkWalkBad[slotIdx] := 0
        sfSkWindRN[slotIdx] := 0
        sfSkWindRBad[slotIdx] := 0
        sfSkWindSpN[slotIdx] := 0
        sfSkWindSpBad[slotIdx] := 0
        sfSkWindVN[slotIdx] := 0                            ' R20.4
        sfSkWindVBad[slotIdx] := 0
    sfSkPackN := 0
    sfSkPackBad := 0
    sfSkPhNegN := 0
    sfSkPhNegBad := 0
    sfSkSwNegN := 0
    sfSkSwNegBad := 0
    sfSkWindNgN := 0
    sfSkWindNgBad := 0
    longfill(@sfSkrN, 0, SKR_COUNT)                         ' task 3621
    longfill(@sfSkrBad, 0, SKR_COUNT)

PRI segStartChecks() | lifeIdx, slotIdx
' SKCHECK (part START, task 3613): SK_LIVES steering lifetimes, each one start with its reads and its floated window
' (skLifetime()); the last SK_WALKS also walk. Then one BM-SKSUM per wheel: the rest-zero spread and the probe's
' least margins, the numbers that size the R19.4 thresholds.
'
' @local lifeIdx - 0..SK_LIVES-1
' @local slotIdx - motor slot

    segBegin(SEG_SKCHECK)
    repeat lifeIdx from 0 to SK_LIVES - 1
        beat(CP_LOOP_POLL)
        skLifetime(lifeIdx, bSkWalkLife(lifeIdx))
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        emitSkSum(slotIdx)
    segEnd(segWhy())

PRI bSkWalkLife(lifeIdx) : bWalk
' Whether a lifetime also walks: the last SK_WALKS of them (every one in dual-start, PL-137), and never in the
' START_NO_WALK build.
'
' @param lifeIdx - 0..SK_LIVES-1
' @returns bWalk - TRUE when this lifetime calls checkWiring()

    bWalk := (BUILD_NO_WALK == FALSE) and (lifeIdx >= (SK_LIVES - SK_WALKS))

PRI skLifetime(lifeIdx, bWalk) | whyCode, slotIdx, legIdx, lifeBefore
' One steering lifetime: arm the build's negative, if any (skArmNeg(), BM-SKNEG), and the winding check, if this
' lifetime carries it (skArmWind(), task 3610); start (bSteerStart(), BM-SSTART); read what start() judged
' (skReadHealth(), then skReadWinding()) before anything else; whenever start() returned a cog, ready or not, what
' both drivers hold (abiDumpSteer(), BM-ABI*, task 3615); the floated window (skZeroWindow()); fold;
' BM-SKHEALTH, a BM-SKPROBE per wheel and, on an armed lifetime, a BM-SKWIND per wheel; on a walk lifetime the walk,
' BM-SKWALK, a BM-SKWLEG per wheel per leg (PL-137) and the recovery of any fault it caused; stop. Task 3621: the
' lifetime's start mode (skModeOf()) is set before the start (skSetRefusal(), and skArmNeg() in START_NEG_PHASE); a
' start that returned -1 prints BM-SREFUSE (bSteerStart()) and is folded into the refusal cells (skFoldModes()); a
' started object's event log is drained last, EV_SETTLE_MS after the lifetime's last act, and folded (skEvents()).
'
' @param lifeIdx - 0..SK_LIVES-1
' @param bWalk - TRUE when this lifetime also walks
'
' @local whyCode - why nothing was read, WHY_NONE when the start was read
' @local slotIdx - motor slot
' @local legIdx - the library's WLEG_OUT, then WLEG_BACK
' @local lifeBefore - lifeSeq before the start, so a start that was refused never names a lifetime

    skStagingReset()
    skLifeMode := skModeOf(lifeIdx)
    whyCode := WHY_NONE
    lifeBefore := lifeSeq
    if bRunContinue(SEG_SKCHECK) == FALSE
        whyCode := WHY_ABORTED
    else
        skSetRefusal()                                      ' task 3621: kept across starts, so set every lifetime
        skArmNeg(lifeIdx, bWalk)                            ' task 3614: before the start that consumes it
        skArmWind(lifeIdx)                                  ' task 3610: likewise, after the phase it may sit beside
        if bSteerStart(SEG_SKCHECK) == FALSE
            whyCode := WHY_NO_COG
        else
            skReadHealth()                                  ' first: exactly what start() left
            skReadWinding()
        bSkStartTried := bSsCalled                          ' task 3621: start() was called, so its return and cause are this lifetime's
        if bSteerUp
            abiDumpSteer()                                  ' task 3615: both drivers, before anything is folded
        if whyCode == WHY_NONE
            skZeroWindow()
    if lifeSeq <> lifeBefore
        skLife := steerLife
    skFoldStart()
    skFoldPhaseNeg()
    skFoldWinding()
    skFoldModes()                                           ' task 3621: REFUSE, OPTOUT, NOREFUSE, and a FIRST start not taken
    emitSkHealth(bWalk, whyCode)
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        emitSkProbe(slotIdx, whyCode)
    if bSkWindArmed
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            emitSkWind(slotIdx, whyCode)
    if bWalk and (whyCode == WHY_NONE)
        skWalk()
        skFoldWalk()
        skFoldSwapNeg()
        emitSkWalk()
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT         ' PL-137: the driver's own record, each wheel, each leg
            repeat legIdx from wheelL.WLEG_OUT to wheelL.WLEG_BACK
                emitSkWalkLeg(slotIdx, legIdx)
        if bSteerUp
            skFrontSt()                                     ' PL-140: this lifetime's front-cog worst pass and late count, beside its walk
            steerRecoverFault(0)                            ' a walk that faulted a wheel: recovered, counted, cooled
    bInstIdle()
    if bSteerUp
        skEvents(bWalk)                                     ' task 3621: this lifetime's event log, drained last
    steerStop()
    segItems := (segItems + 1) <# LIM_SMALL

PRI skStagingReset() | arrIdx
' Clear one lifetime's readings and its walk.
'
' @local arrIdx - index into a per-wheel array

    skLife := 0
    bSkHealthRead := FALSE
    bSkStartTried := FALSE
    skPack := wheelL.PACK_NOT_FITTED
    skPackMv := 0
    skZeroWhy := WHY_NONE
    bSkNegArmed := FALSE
    skNegSel := 0
    skNegErr := NO_ERROR
    bSkWindArmed := FALSE
    repeat arrIdx from 0 to (INST_MOTORS * SK_WIND_PAIRS) - 1
        skWindState[arrIdx] := wheelL.WND_NOT_RUN
        skWindMohm[arrIdx] := 0
        skWindMv[arrIdx] := 0
    repeat arrIdx from 0 to (INST_MOTORS * SK_PROBE_LONGS) - 1
        skProbe[arrIdx] := 0
    repeat arrIdx from 0 to (INST_MOTORS * SK_PHASES) - 1
        skFloor[arrIdx] := 0
    repeat arrIdx from SLOT_LEFT to SLOT_RIGHT
        skWindVSrc[arrIdx] := wheelL.PACK_NOT_FITTED        ' R20.4
        skWindVMv[arrIdx] := 0
        skChk[arrIdx] := 0
        skFail[arrIdx] := 0
        skRec[arrIdx] := 0
        skIllLo[arrIdx] := 0
        skIllHi[arrIdx] := 0
        skPrbBadNow[arrIdx] := 0
        bSkZeroValid[arrIdx] := FALSE
        skZeroX10[arrIdx] := 0
        skZeroN[arrIdx] := 0
        bSkWalkHlt[arrIdx] := FALSE
        bSkWalkHltFail[arrIdx] := FALSE
        skLegFwd[arrIdx] := 0
        skLegRev[arrIdx] := 0
        skWalkIg[arrIdx] := 0
        skWalkPkI[arrIdx] := NEGX
        bSkWalkOk[arrIdx] := FALSE
        skWalkCause[arrIdx] := wheelL.FC_NONE
    bSkWalkRan := FALSE
    skWalkErr := NO_ERROR
    skWalkMs := 0
    bSkLegsValid := FALSE
    skWalkWhy := WHY_NONE
    bSkWlRead := FALSE                                      ' PL-137
    longfill(@skWl, wheelL.WALK_NA, SKWL_LONGS)

PRI skFrontSt() | nPasses, nLate, nMaxTicks, nStackHi, nStackOf
' PL-140: BM-FRONTST for this lifetime's steering front cog after its walk -- passes, late passes, the worst pass body
' and the stack mark since the cog was launched -- so a LATE_PASS event in part START can be placed. No cell judges it.
'
' @local nPasses - passes since the front cog was launched
' @local nLate - passes that overran their slot
' @local nMaxTicks - longest pass body, in system ticks
' @local nStackHi - stack longs ever used
' @local nStackOf - the allocation that mark is against

    nPasses, nLate, nMaxTicks, nStackHi, nStackOf := dFrontStats(SIDE_BOTH)
    emitFrontSt(SIDE_BOTH, nPasses, nLate, nMaxTicks, nStackHi, nStackOf)

PRI skReadHealth() | probedIdx, rowBase
' What start() judged, read through the steering object before anything else touches it: both wheels' getHealth()
' masks (checked, failed and, task 3621, recovered), the illegal hall codes by kind, the pack sensor, and every lead-check reading (three probes a wheel, each the
' three phase voltages averaged while one phase was driven).
'
' @local probedIdx - 0..SK_PHASES-1: the phase driven, U V W
' @local rowBase - its row's first index in skProbe (the left wheel's; the right's is SK_PROBE_LONGS on)

    beat(CP_LIB_STEER_QUERY)
    skChk[SLOT_LEFT], skFail[SLOT_LEFT], skRec[SLOT_LEFT], skChk[SLOT_RIGHT], skFail[SLOT_RIGHT], skRec[SLOT_RIGHT] := steering.getHealth()
    skIllLo[SLOT_LEFT], skIllHi[SLOT_LEFT], skIllLo[SLOT_RIGHT], skIllHi[SLOT_RIGHT] := steering.getHallIllegalCodes()
    skPack, skPackMv := steering.getPackVoltage()
    repeat probedIdx from 0 to SK_PHASES - 1
        rowBase := probedIdx * SK_PHASES
        skProbe[rowBase], skProbe[rowBase + 1], skProbe[rowBase + 2] := steering.testLeftGetProbe(wheelL.PRB_U + probedIdx)
        rowBase += SK_PROBE_LONGS
        skProbe[rowBase], skProbe[rowBase + 1], skProbe[rowBase + 2] := steering.testRightGetProbe(wheelL.PRB_U + probedIdx)
    beat(CP_LIB_STEER_QUERY)
    bSkHealthRead := TRUE

PRI skZeroWindow() | winStartTotal, winEndTotal, safeEvent, slotIdx
' The floated window, ZERO_WINDOW_MS through the instrument on the steering source with nothing commanded: per wheel
' the rest zero (windowStats()'s mean sense_i, as lifetimeZero() takes it) and the coast floor (skFloorWindow()).
' Delimited by two instrument-recorded ring totals (sec 12.7). A safety event voids both.
'
' @local winStartTotal - ring total at the window start
' @local winEndTotal - ring total at the window end
' @local safeEvent - SAFE_* from the watched wait
' @local slotIdx - motor slot

    skZeroWhy := WHY_INST_NOACK
    if bInstArm(INST_SRC_STEER, 1)
        winStartTotal := instMarkIndex()
        safeEvent, _ := waitWatched(SIDE_BOTH, ZERO_WINDOW_MS, CP_LOOP_ZERO, UNTIL_TIME)
        winEndTotal := instMarkIndex()
        if bInstFreeze(0)
            skZeroWhy := safeWhy(safeEvent)
            if safeEvent == SAFE_NONE
                repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                    windowStats(slotIdx, SLOT_RIGHT - slotIdx, winStartTotal, winEndTotal)
                    if rsN > 0
                        skZeroX10[slotIdx] := rsIMeanX10
                        skZeroN[slotIdx] := rsN
                        skFloorWindow(slotIdx, winStartTotal, winEndTotal)
                        bSkZeroValid[slotIdx] := TRUE
                    else
                        skZeroWhy := WHY_NO_SAMPLES
        bInstIdle()

PRI skFloorWindow(slotIdx, winStartTotal, winEndTotal) | sampleIdx, startJ, endJ, floorBase
' The coast floor of one wheel: each phase's largest |reading| over the window's up samples (I3), bounded by ring
' index exactly as windowStats() bounds it. Legal only while FROZEN (I10).
'
' @param slotIdx - motor slot
' @param winStartTotal - ring total at the window start
' @param winEndTotal - ring total at the window end
'
' @local sampleIdx - logical index
' @local startJ - the window's first logical index
' @local endJ - its last
' @local floorBase - this wheel's first index in skFloor

    floorBase := slotIdx * SK_PHASES
    if (winStartTotal >= 0) and (winEndTotal > winStartTotal) and (drStored > 0)
        startJ := (winStartTotal - drLostHead) #> 0
        endJ := (winEndTotal - 1 - drLostHead) <# (drStored - 1)
        if endJ >= startJ                                   ' a Spin2 repeat from a higher bound counts down
            repeat sampleIdx from startJ to endJ
                beat(CP_LOOP_DRAIN)
                if bSmpUp(sampleIdx, slotIdx)
                    skFloor[floorBase] #>= abs(smpPhU(sampleIdx, slotIdx))
                    skFloor[floorBase + 1] #>= abs(smpPhV(sampleIdx, slotIdx))
                    skFloor[floorBase + 2] #>= abs(smpPhW(sampleIdx, slotIdx))

PRI skFoldStart() | slotIdx, phaseIdx
' Fold one lifetime into the cells. PACK: counted once a start, bad unless the start's pack reading matches the build's
' configuration (bSkPackAsConfig()). HEALTH: bad on any failed bit, or when not every start check was checked. PROBE:
' each probe judged (skFoldProbe()). RZSPREAD and PRBFLR: from the floated window, when it held samples.
'
' @local slotIdx - motor slot
' @local phaseIdx - 0..SK_PHASES-1

    if bSkHealthRead
        sfSkPackN := (sfSkPackN + 1) <# LIM_SMALL
        if bSkPackAsConfig() == FALSE
            sfSkPackBad := (sfSkPackBad + 1) <# LIM_SMALL
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        if bSkHealthRead
            sfSkStarts[slotIdx] := (sfSkStarts[slotIdx] + 1) <# LIM_SMALL
            if (skFail[slotIdx] <> 0) or ((skChk[slotIdx] & wheelL.HLT_ALL_CHECKS) <> wheelL.HLT_ALL_CHECKS)
                sfSkHealthBad[slotIdx] := (sfSkHealthBad[slotIdx] + 1) <# LIM_SMALL
            skFoldProbe(slotIdx)
        if bSkZeroValid[slotIdx]
            skRzN[slotIdx] := (skRzN[slotIdx] + 1) <# LIM_SMALL
            skRzSum[slotIdx] += skZeroX10[slotIdx]
            skRzMin[slotIdx] <#= skZeroX10[slotIdx]
            skRzMax[slotIdx] #>= skZeroX10[slotIdx]
            if (skZeroX10[slotIdx] < (wheelL.REST_ZERO_MIN_MV * SK_ZERO_SCALE)) or (skZeroX10[slotIdx] > (wheelL.REST_ZERO_MAX_MV * SK_ZERO_SCALE))
                sfSkRzOut[slotIdx] := (sfSkRzOut[slotIdx] + 1) <# LIM_SMALL
            skFlN[slotIdx] := (skFlN[slotIdx] + 1) <# LIM_SMALL
            repeat phaseIdx from 0 to SK_PHASES - 1
                skFlMax[slotIdx] #>= skFloor[(slotIdx * SK_PHASES) + phaseIdx]

PRI bSkPackAsConfig() : bOk
' Whether one start's pack reading (skReadHealth(): the steering object's getPackVoltage() and both wheels' getHealth())
' matches the build's configuration -- R19-DUAL-PACK-X, PACK_AS_CONFIGURED. Until SRC_REV 56 it assumed no sensor, and
' failed every start once the bench fitted one (pass 7).
'  FITTED (user.PACK_SENSOR_FITTED TRUE): the steering object read PACK_PRESENT at SK_PACK_LO_MV .. SK_PACK_HI_MV (a
'   plausible 5S pack, this part's CON), the left wheel -- the one isp_steering_2wheel starts the sensor on -- checked
'   HLT_PACK, and neither wheel failed it. The right wheel's checked bit is not judged: which wheel reads the one pack
'   is the steering object's choice, not this cell's claim.
'  NOT FITTED: PACK_NOT_FITTED, 0 mV, and neither wheel checked HLT_PACK (the rule before SRC_REV 56).
'
' @returns bOk - T/F where T means the reading matches the configuration

    if user.PACK_SENSOR_FITTED
        bOk := (skPack == wheelL.PACK_PRESENT) and (skPackMv >= SK_PACK_LO_MV) and (skPackMv <= SK_PACK_HI_MV)
        bOk &= ((skChk[SLOT_LEFT] & wheelL.HLT_PACK) <> 0) and (((skFail[SLOT_LEFT] | skFail[SLOT_RIGHT]) & wheelL.HLT_PACK) == 0)
    else
        bOk := (skPack == wheelL.PACK_NOT_FITTED) and (skPackMv == 0) and (((skChk[SLOT_LEFT] | skChk[SLOT_RIGHT]) & wheelL.HLT_PACK) == 0)

PRI skFoldProbe(slotIdx) | probedIdx, readIdx, rowBase, drivenMv, folMv, bBad
' Judge one wheel's three probes by B-3's pre-registered reading, which is STRICTER than the driver's (a phase passes
' there when it followed in any one probe): the driven phase reads at least CONT_MIN_DRIVEN_MV, and EACH undriven
' phase reads at least CONT_FOLLOW_PCT of it. Tracks the least driven reading and the least follower percentage --
' the margins that size the two thresholds.
'
' @param slotIdx - motor slot
'
' @local probedIdx - 0..SK_PHASES-1: the phase driven
' @local readIdx - 0..SK_PHASES-1: the phase read
' @local rowBase - the probe's first index in skProbe
' @local drivenMv - the driven phase's reading
' @local folMv - an undriven phase's reading
' @local bBad - this probe failed

    skPrbBadNow[slotIdx] := 0
    repeat probedIdx from 0 to SK_PHASES - 1
        rowBase := (slotIdx * SK_PROBE_LONGS) + (probedIdx * SK_PHASES)
        drivenMv := skProbe[rowBase + probedIdx]
        skDrvMin[slotIdx] <#= drivenMv
        bBad := (drivenMv < wheelL.CONT_MIN_DRIVEN_MV)
        repeat readIdx from 0 to SK_PHASES - 1
            if readIdx <> probedIdx
                folMv := skProbe[rowBase + readIdx]
                if drivenMv > 0
                    skFolMinPct[slotIdx] <#= (folMv * SK_PCT_SCALE) / drivenMv
                if (folMv * SK_PCT_SCALE) < (drivenMv * wheelL.CONT_FOLLOW_PCT)
                    bBad := TRUE
        skPrbN[slotIdx] := (skPrbN[slotIdx] + 1) <# LIM_SMALL
        if bBad
            sfSkPrbBad[slotIdx] := (sfSkPrbBad[slotIdx] + 1) <# LIM_SMALL
            skPrbBadNow[slotIdx] += 1

PRI skWalk() | slotIdx, legIdx, startMs, safeEvent, bFrozen, igBefore[INST_MOTORS], chkNow[INST_MOTORS], failNow[INST_MOTORS], missedLeft, illegalLeft, missedRight, illegalRight
' B-5 positive: checkWiring() under the instrument. The integrity counts first; arm; SK_WALK_PRE_MS of samples; mark;
' checkWiring() (it blocks, see this section's CON; the watchdog is granted WD_WALK_GRACE_MS for that one call); the
' rest confirm; freeze; then getHealth()'s HLT_WIRING, the integrity counts again, the fault causes and (PL-137) each
' wheel's own record of each leg (skReadWalkLeg()); the legs from the ring (skWalkLegs()). Pre-registered, per wheel:
' NO_ERROR, HLT_WIRING passed, both legs SK_LEG_LO_TICKS .. SK_LEG_HI_TICKS in opposite directions, no hall event.
'
' @local slotIdx - motor slot
' @local legIdx - the library's WLEG_OUT, then WLEG_BACK
' @local startMs - getms() at the call
' @local safeEvent - SAFE_* from the rest confirm
' @local bFrozen - the capture froze
' @local igBefore - per wheel, missed + illegal before the walk
' @local chkNow - per wheel, getHealth() checked mask after it
' @local failNow - per wheel, failed mask after it
' @local missedLeft - the left wheel's missed transitions
' @local illegalLeft - the left wheel's illegal codes
' @local missedRight - the right wheel's missed transitions
' @local illegalRight - the right wheel's illegal codes

    beat(CP_LIB_STEER_QUERY)
    missedLeft, illegalLeft, missedRight, illegalRight := steering.getHallIntegrityCounts()
    beat(CP_LIB_STEER_QUERY)
    igBefore[SLOT_LEFT] := missedLeft + illegalLeft
    igBefore[SLOT_RIGHT] := missedRight + illegalRight
    skWalkWhy := WHY_INST_NOACK
    if bInstArm(INST_SRC_STEER, 1)
        waitWatched(SIDE_BOTH, SK_WALK_PRE_MS, CP_LOOP_SETTLE, UNTIL_TIME)
        instMark()
        wdGraceMs := WD_WALK_GRACE_MS                       ' PL-137: for this one call only (derived at the constant)
        startMs := getms()
        beat(CP_LIB_STEER_DRIVE)
        skWalkErr := steering.checkWiring()
        beat(CP_LIB_STEER_DRIVE)
        skWalkMs := getms() - startMs
        wdGraceMs := 0
        bSkWalkRan := TRUE
        safeEvent, _ := waitRest(SIDE_BOTH, SK_WALK_REST_MS, FALSE)
        bFrozen := bInstFreeze(0)
        beat(CP_LIB_STEER_QUERY)
        chkNow[SLOT_LEFT], failNow[SLOT_LEFT], _, chkNow[SLOT_RIGHT], failNow[SLOT_RIGHT], _ := steering.getHealth()
        missedLeft, illegalLeft, missedRight, illegalRight := steering.getHallIntegrityCounts()
        skWalkCause[SLOT_LEFT], skWalkCause[SLOT_RIGHT] := steering.getFaultCause()
        beat(CP_LIB_STEER_QUERY)
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT         ' PL-137: after the rest confirm, so the second leg's settle is at rest
            repeat legIdx from wheelL.WLEG_OUT to wheelL.WLEG_BACK
                skReadWalkLeg(slotIdx, legIdx)
        bSkWlRead := TRUE
        skWalkIg[SLOT_LEFT] := (missedLeft + illegalLeft) - igBefore[SLOT_LEFT]
        skWalkIg[SLOT_RIGHT] := (missedRight + illegalRight) - igBefore[SLOT_RIGHT]
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            bSkWalkHlt[slotIdx] := ((chkNow[slotIdx] & wheelL.HLT_WIRING) <> 0) and ((failNow[slotIdx] & wheelL.HLT_WIRING) == 0)
            bSkWalkHltFail[slotIdx] := ((chkNow[slotIdx] & wheelL.HLT_WIRING) <> 0) and ((failNow[slotIdx] & wheelL.HLT_WIRING) <> 0)
        if bFrozen
            drainBegin()
            drainFindMark()
            skWalkWhy := WHY_NO_SAMPLES
            if bDrMarkFound and (drMarkJ < (drStored - 1))
                repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                    skWalkLegs(slotIdx)
                bSkLegsValid := TRUE
                skWalkWhy := safeWhy(safeEvent)
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        bSkWalkOk[slotIdx] := bSkWalkRan and (skWalkErr == NO_ERROR) and bSkWalkHlt[slotIdx] and bSkLegsValid and bSkLegsOk(skLegFwd[slotIdx], skLegRev[slotIdx]) and (skWalkIg[slotIdx] == 0)

PRI skWalkLegs(slotIdx) | sampleIdx, bFirst, pos0, extAbs, extPos, lastPos
' One wheel's two legs from the frozen walk capture, on raw hall ticks over its up samples from the mark: the leg out
' is the largest excursion from the first, the leg back from there to the last (this section's CON). Also the largest
' sense_i across the walk. Legal only while FROZEN (I10).
'
' @param slotIdx - motor slot
'
' @local sampleIdx - logical index
' @local bFirst - no up sample seen yet
' @local pos0 - the first up sample's position
' @local extAbs - the largest |excursion| so far
' @local extPos - the position at it
' @local lastPos - the last up sample's position

    bFirst := TRUE
    pos0 := 0
    extAbs := 0
    extPos := 0
    lastPos := 0
    repeat sampleIdx from drMarkJ to drStored - 1
        beat(CP_LOOP_DRAIN)
        if bSmpUp(sampleIdx, slotIdx)
            lastPos := smpPos(sampleIdx, slotIdx)
            if bFirst
                pos0 := lastPos
                extPos := lastPos
                bFirst := FALSE
            elseif abs(lastPos - pos0) > extAbs
                extAbs := abs(lastPos - pos0)
                extPos := lastPos
            skWalkPkI[slotIdx] #>= smpI(sampleIdx, slotIdx)
    skLegFwd[slotIdx] := extPos - pos0
    skLegRev[slotIdx] := lastPos - extPos

PRI bSkLegsOk(nFwdTicks, nRevTicks) : bOk
' B-5's pre-registered legs: each SK_LEG_LO_TICKS .. SK_LEG_HI_TICKS in size, and in opposite directions.
'
' @param nFwdTicks - the leg out
' @param nRevTicks - the leg back
' @returns bOk - TRUE when both legs hold

    bOk := (abs(nFwdTicks) >= SK_LEG_LO_TICKS) and (abs(nFwdTicks) <= SK_LEG_HI_TICKS) and (abs(nRevTicks) >= SK_LEG_LO_TICKS)
    bOk &= (abs(nRevTicks) <= SK_LEG_HI_TICKS) and ((nFwdTicks > 0) <> (nRevTicks > 0))

PRI skWlBase(slotIdx, legIdx) : nBase
' PL-137: where one wheel's record of one walk leg starts in skWl.
'
' @param slotIdx - motor slot
' @param legIdx - the library's WLEG_OUT or WLEG_BACK
' @returns nBase - the index of its SKWL_END long

    nBase := ((slotIdx * wheelL.WALK_LEGS) + legIdx) * SKWL_FIELDS

PRI skReadWalkLeg(slotIdx, legIdx) | pRec
' PL-137: one wheel's own record of one walk leg, through the steering object, into skWl in the getter's order (SKWL_*).
'
' @param slotIdx - motor slot
' @param legIdx - the library's WLEG_OUT or WLEG_BACK
'
' @local pRec - the record's first long in skWl

    pRec := @skWl[skWlBase(slotIdx, legIdx)]
    beat(CP_LIB_STEER_QUERY)
    if slotIdx == SLOT_LEFT
        long[pRec][SKWL_END], long[pRec][SKWL_END_MS], long[pRec][SKWL_POST], long[pRec][SKWL_PEAK], long[pRec][SKWL_LIM], long[pRec][SKWL_LIM_MS], long[pRec][SKWL_TRK], long[pRec][SKWL_STPTK], long[pRec][SKWL_STOP], long[pRec][SKWL_STOP_MS], long[pRec][SKWL_ENDP], long[pRec][SKWL_SETTLE], long[pRec][SKWL_MV_MS], long[pRec][SKWL_FINAL], long[pRec][SKWL_LAG] := steering.testLeftGetWalkLeg(legIdx)
    else
        long[pRec][SKWL_END], long[pRec][SKWL_END_MS], long[pRec][SKWL_POST], long[pRec][SKWL_PEAK], long[pRec][SKWL_LIM], long[pRec][SKWL_LIM_MS], long[pRec][SKWL_TRK], long[pRec][SKWL_STPTK], long[pRec][SKWL_STOP], long[pRec][SKWL_STOP_MS], long[pRec][SKWL_ENDP], long[pRec][SKWL_SETTLE], long[pRec][SKWL_MV_MS], long[pRec][SKWL_FINAL], long[pRec][SKWL_LAG] := steering.testRightGetWalkLeg(legIdx)
    beat(CP_LIB_STEER_QUERY)

PRI emitSkWalkLeg(slotIdx, legIdx) | recBase, postPos, bRan
' BM-SKWLEG (PL-137): the driver's own record of one walk leg for one wheel, beside BM-SKWALK's ring-rebuilt legs. The
' leg (OUT, BACK), how it ended (end: the library's WLE_* name -- LIMIT is the healthy ending), its elapsed ms and its
' post position (raw hall ticks); then, as hall ticks from the post and clamped at +-999, the furthest it went (peak),
' where the distance limit fired (lim; lim_ms, and the tracked ticks trk and stopping ticks stp_tk it fired on), where
' the driver first reported rest (stop, stop_ms), where the wait ended (end_p), where the rotor settled (settle; final
' TRUE once the next drive closed the watch -- the OUT leg's at the BACK leg's command, the BACK leg's still open at this
' read, after the rest confirm) and when it last moved (mv_ms); last the drive passes the lag limiter held the field
' (lag). A reading the driver did not take prints NA; a leg that did not run prints NA throughout (end NOT_RUN); a
' record not read prints NA throughout with the walk's why. Worst case 264 bytes.
'
' @param slotIdx - motor slot
' @param legIdx - the library's WLEG_OUT or WLEG_BACK
'
' @local recBase - the record's first index in skWl
' @local postPos - its post position, WALK_NA when not taken
' @local bRan - the record was read and the leg ran

    recBase := skWlBase(slotIdx, legIdx)
    postPos := skWl[recBase + SKWL_POST]
    bRan := bSkWlRead and (skWl[recBase + SKWL_END] <> wheelL.WLE_NOT_RUN)
    recBegin(@"BM-SKWLEG")
    benchLog.naNumField(@"life", skLife, LIM_SMALL, skLife > 0)
    benchLog.tokenField(@"motor", sideToken(SIDE_LEFT + slotIdx), TOKMAX_MOTOR)
    benchLog.tokenField(@"leg", tokenAt(@tokWalkLeg, WLEG_TOK_COUNT, legIdx), TOKMAX_WLEG)
    if bSkWlRead
        benchLog.tokenField(@"end", tokenAt(@tokWalkEnd, WLE_TOK_COUNT, skWl[recBase + SKWL_END]), TOKMAX_WLE)
    else
        benchLog.textField(@"end", @sSfNa)
    skWlNumField(@"ms", recBase + SKWL_END_MS, LIM_SMALL)
    skWlNumField(@"post", recBase + SKWL_POST, LIM_BIG)
    skWlDeltaField(@"peak", recBase + SKWL_PEAK, postPos)
    skWlDeltaField(@"lim", recBase + SKWL_LIM, postPos)
    skWlNumField(@"lim_ms", recBase + SKWL_LIM_MS, LIM_SMALL)
    skWlNumField(@"trk", recBase + SKWL_TRK, LIM_TINY)
    skWlNumField(@"stp_tk", recBase + SKWL_STPTK, LIM_TINY)
    skWlDeltaField(@"stop", recBase + SKWL_STOP, postPos)
    skWlNumField(@"stop_ms", recBase + SKWL_STOP_MS, LIM_SMALL)
    skWlDeltaField(@"end_p", recBase + SKWL_ENDP, postPos)
    skWlDeltaField(@"settle", recBase + SKWL_SETTLE, postPos)
    if bRan
        benchLog.boolField(@"final", skWl[recBase + SKWL_FINAL])
    else
        benchLog.textField(@"final", @sSfNa)
    skWlNumField(@"mv_ms", recBase + SKWL_MV_MS, LIM_SMALL)
    skWlNumField(@"lag", recBase + SKWL_LAG, LIM_SMALL)
    if bSkWlRead
        whyField(WHY_NONE)
    else
        whyField(skWalkWhy)
    emitRecord()

PRI skWlNumField(pName, wlIdx, limitAbs)
' PL-137: one BM-SKWLEG number as the driver gave it, NA when it is the library's WALK_NA (not taken).
'
' @param pName - pointer to the field name
' @param wlIdx - its index in skWl
' @param limitAbs - clamp magnitude (LIM_*)

    benchLog.naNumField(pName, skWl[wlIdx], limitAbs, skWl[wlIdx] <> wheelL.WALK_NA)

PRI skWlDeltaField(pName, wlIdx, postPos)
' PL-137: one BM-SKWLEG position as hall ticks from the leg's post position, clamped at +-LIM_TINY; NA when either is
' the library's WALK_NA.
'
' @param pName - pointer to the field name
' @param wlIdx - its index in skWl
' @param postPos - the leg's post position

    benchLog.naNumField(pName, skWl[wlIdx] - postPos, LIM_TINY, (skWl[wlIdx] <> wheelL.WALK_NA) and (postPos <> wheelL.WALK_NA))

PRI skFoldWalk() | slotIdx
' Fold one walk into R19-DUAL-WALK-X, per wheel: counted once checkWiring() was called, bad unless its pre-registered
' reading held (skWalk()).
'
' @local slotIdx - motor slot

    if bSkWalkRan
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            sfSkWalkN[slotIdx] := (sfSkWalkN[slotIdx] + 1) <# LIM_SMALL
            if bSkWalkOk[slotIdx] == FALSE
                sfSkWalkBad[slotIdx] := (sfSkWalkBad[slotIdx] + 1) <# LIM_SMALL

PRI skArmNeg(lifeIdx, bWalk)
' Task 3614: arm this build's firmware negative on the LEFT wheel before the start that consumes it, and print what was
' armed (BM-SKNEG). PHASE: every lifetime withholds one lead-check phase, PRB_U, PRB_V, PRB_W in turn by lifetime --
' from every attempt, or (task 3621, SKM_FIRST lifetimes) from the first attempt only.
' SWAP: every walk lifetime reads hall bits 0 and 1 swapped. The positive builds arm nothing and print nothing. A hook
' that refuses is still counted as armed: its start then shows no negative, and the negative's cell fails.
'
' @param lifeIdx - 0..SK_LIVES-1
' @param bWalk - TRUE when this lifetime also walks

    if BUILD_NEG == SKNEG_PHASE
        skNegSel := wheelL.PRB_U + (lifeIdx // SK_PHASES)
        beat(CP_LIB_STEER_START)
        if skLifeMode == SKM_FIRST                          ' task 3621: the first attempt only, so a retry recovers it
            skNegErr := steering.testLeftSetProbeWithholdFirst(skNegSel)
        else
            skNegErr := steering.testLeftSetProbeWithhold(skNegSel)
        beat(CP_LIB_STEER_START)
        bSkNegArmed := TRUE
    elseif (BUILD_NEG == SKNEG_SWAP) and bWalk
        skNegSel := SKNEG_SWAP_SEL
        beat(CP_LIB_STEER_START)
        skNegErr := steering.testLeftSetHallSwap(skNegSel)
        beat(CP_LIB_STEER_START)
        bSkNegArmed := TRUE
    if bSkNegArmed
        emitSkNeg(lifeIdx)

PRI skFoldPhaseNeg() | wantMask
' Fold one armed start into R19-DUAL-PHNEG-X (START_NEG_PHASE only): counted once start()'s verdicts were read, bad
' unless the LEFT failed mask is EXACTLY the withheld phase's HLT_PHASE_* bit -- any other bit set, that bit missing,
' or no bit at all (the hook did not take) is the negative going unseen. Task 3621: only the opt-out lifetimes, whose
' start runs with the phase withheld from every attempt, are the start this cell was written for.
'
' @local wantMask - the withheld phase's HLT_PHASE_* bit

    if (BUILD_NEG == SKNEG_PHASE) and bSkNegArmed and bSkHealthRead and (skLifeMode == SKM_OPTOUT)    ' task 3621: exactly as before
        wantMask := wheelL.HLT_PHASE_U << (skNegSel - wheelL.PRB_U)
        sfSkPhNegN := (sfSkPhNegN + 1) <# LIM_SMALL
        if skFail[SLOT_LEFT] <> wantMask
            sfSkPhNegBad := (sfSkPhNegBad + 1) <# LIM_SMALL

PRI skFoldSwapNeg()
' Fold one armed walk into R19-DUAL-SWNEG-X (START_NEG_SWAP only): counted once checkWiring() was called, bad unless
' the LEFT HLT_WIRING was checked AND failed -- a pass, or a walk that never judged it, leaves the swap undetected.

    if (BUILD_NEG == SKNEG_SWAP) and bSkNegArmed and bSkWalkRan
        sfSkSwNegN := (sfSkSwNegN + 1) <# LIM_SMALL
        if bSkWalkHltFail[SLOT_LEFT] == FALSE
            sfSkSwNegBad := (sfSkSwNegBad + 1) <# LIM_SMALL

PRI skModeOf(lifeIdx) : eMode
' Task 3621: a lifetime's start mode (this part's CON, SKM_*): START_NEG_PHASE rotates blocks of SK_PHASES lifetimes
' through OPTOUT, REFUSE and FIRST; dual-start-nowalk opts out every lifetime; every other START build is DEFAULT.
'
' @param lifeIdx - 0..SK_LIVES-1
' @returns eMode - SKM_*

    if BUILD_NEG == SKNEG_PHASE
        eMode := lookupz((lifeIdx / SK_PHASES) // SKM_ROTATION : SKM_OPTOUT, SKM_REFUSE, SKM_FIRST)
    elseif BUILD_START_B1
        eMode := SKM_OPTOUT
    else
        eMode := SKM_DEFAULT

PRI skSetRefusal()
' Task 3621: set the lifetime's refusal choice on the steering object before its start -- refusal on unless the
' lifetime opts out (SKM_OPTOUT). setStartChecks() is kept across starts, so it is set every lifetime, never assumed.

    beat(CP_LIB_STEER_START)
    steering.setStartChecks(skLifeMode <> SKM_OPTOUT)
    beat(CP_LIB_STEER_START)

PRI skrNote(skrIdx, bOk)
' Task 3621: count one instance of a START reporting cell (SKR_*).
'
' @param skrIdx - SKR_*
' @param bOk - the instance read as pre-registered

    sfSkrN[skrIdx] := (sfSkrN[skrIdx] + 1) <# LIM_SMALL
    if bOk == FALSE
        sfSkrBad[skrIdx] := (sfSkrBad[skrIdx] + 1) <# LIM_SMALL

PRI skFoldModes() | wantMask, bTaken
' Task 3621: fold one lifetime whose start was called into the cells judged on the start itself (this part's CON,
' SKR_*): REFUSE and OPTOUT (START_NEG_PHASE), NOREFUSE (dual-start), and a START_NEG_PHASE FIRST start that was not
' taken, which is a bad RETRY instance (the taken ones are judged on their event log, skEvents()). A refusal's cause
' and masks are bSteerStart()'s, read right after the call (BM-SREFUSE).
'
' @local wantMask - the withheld phase's HLT_PHASE_* bit (START_NEG_PHASE)
' @local bTaken - the start returned a cog

    if bSkStartTried
        bTaken := (ssRet >= 0)
        if BUILD_NEG == SKNEG_PHASE
            wantMask := wheelL.HLT_PHASE_U << (skNegSel - wheelL.PRB_U)
            case skLifeMode
                SKM_REFUSE:
                    skrNote(SKR_REF, (bTaken == FALSE) and (skNegErr == NO_ERROR) and (ssErr == wheelL.ERR_START_CHECK_FAILED) and (ssLErr == wheelL.ERR_START_CHECK_FAILED) and (ssFail[SLOT_LEFT] == wantMask))
                SKM_OPTOUT:
                    skrNote(SKR_OPT, bTaken and bSkHealthRead and (skNegErr == NO_ERROR) and (skFail[SLOT_LEFT] == wantMask))
                SKM_FIRST:
                    if bTaken == FALSE
                        skrNote(SKR_RET, FALSE)
        elseif BUILD_START_POS
            skrNote(SKR_NOREF, bTaken)

PRI skEvents(bWalk) | bClean, missedL, illegalL, missedR, illegalR, wantMask, slotIdx, nGuard, seqIdx, bOk, nGuardMv
' Task 3621: the lifetime's event log, drained EV_SETTLE_MS after its last act (so a rate-limited hall count is in it),
' with the hall counts read beside it, then folded into the START reporting cells this build judges (this part's CON,
' SKR_*). Called only for a started object, before its stop.
'
' @param bWalk - TRUE when this lifetime walked
'
' @local bClean - the drain ended on EV_NONE with nothing lost
' @local missedL - the left wheel's missed hall transitions since its start
' @local illegalL - its illegal hall codes (%000 and %111 entries)
' @local missedR - the right wheel's missed transitions
' @local illegalR - its illegal codes
' @local wantMask - the withheld phase's HLT_PHASE_* bit (START_NEG_PHASE)
' @local slotIdx - motor slot, which is also its log's index
' @local nGuard - the left wheel's EV_WALK_GUARD events
' @local seqIdx - 0..nGuard-1
' @local bOk - one instance's reading held
' @local nGuardMv - the left wheel's walk guard in force, mV on its board's scale (SRC_REV 60, DRIVER_REV 40)

    waitBeat(EV_SETTLE_MS, CP_LOOP_REST)
    evDrain(EVSRC_STEER, EVST_SKCHECK)
    beat(CP_LIB_STEER_QUERY)
    missedL, illegalL, missedR, illegalR := steering.getHallIntegrityCounts()
    beat(CP_LIB_STEER_QUERY)
    bClean := bEvdClean()
    if BUILD_NEG == SKNEG_PHASE
        wantMask := wheelL.HLT_PHASE_U << (skNegSel - wheelL.PRB_U)
        if skLifeMode == SKM_FIRST                          ' RETRY's positive: recovered, and reported once with 2 attempts
            bOk := bClean and bSkHealthRead and (skFail[SLOT_LEFT] == 0) and (skRec[SLOT_LEFT] == wantMask)
            bOk &= (evCount(SLOT_LEFT, wheelL.EV_CHECK_RETRY) == 1) and (evSeqAt(SLOT_LEFT, EVQ_RETRY, 0) == (wantMask | (2 << wheelL.EV_START_ATTEMPT_SHIFT)))
            skrNote(SKR_RET, bOk)
        elseif skLifeMode == SKM_OPTOUT                     ' withheld from every attempt: never recovered
            skrNote(SKR_NORET, bClean and (skRec[SLOT_LEFT] == 0) and (evCount(SLOT_LEFT, wheelL.EV_CHECK_RETRY) == 0))
        skrNote(SKR_NORET, bClean and (skRec[SLOT_RIGHT] == 0) and (evCount(SLOT_RIGHT, wheelL.EV_CHECK_RETRY) == 0))
    elseif BUILD_START_POS
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            skrNote(SKR_NORET, bClean and (skRec[slotIdx] == 0) and (evCount(slotIdx, wheelL.EV_CHECK_RETRY) == 0))
            skrNote(SKR_NOHAL, bClean and ((evCount(slotIdx, wheelL.EV_HALL_MISSED) + evCount(slotIdx, wheelL.EV_HALL_ILLEGAL)) == 0))
            if bWalk and bSkWalkRan
                skrNote(SKR_NOGRD, bClean and (evCount(slotIdx, wheelL.EV_WALK_GUARD) == 0))
        if skPack <> wheelL.PACK_NOT_FITTED
            skrNote(SKR_PACK, bClean and (evCount(EVI_PLAT, wheelL.EV_PACK) == 0))
    elseif BUILD_NEG == SKNEG_SWAP
        if bWalk and bSkWalkRan
            nGuard := evCount(SLOT_LEFT, wheelL.EV_WALK_GUARD)
            bOk := bClean and (nGuard >= 1) and (nGuard <= EV_SEQ_MAX)
            beat(CP_LIB_STEER_QUERY)                        ' SRC_REV 60 (DRIVER_REV 40): the guard in force on the left
            nGuardMv, _ := steering.testGetWalkGuardMv()    '  wheel's own board, never Rev B's WALK_I_LIMIT_MV (5 mV on Rev A)
            beat(CP_LIB_STEER_QUERY)
            if bOk                                          ' a Spin2 repeat from a higher bound counts down
                repeat seqIdx from 0 to nGuard - 1
                    bOk &= (evSeqAt(SLOT_LEFT, EVQ_GUARD, seqIdx) >= nGuardMv)
            skrNote(SKR_GRD, bOk)
            skrNote(SKR_NOGRD, bClean and (evCount(SLOT_RIGHT, wheelL.EV_WALK_GUARD) == 0))
            if missedL > 0
                skrNote(SKR_MIS, bClean and (evSum(SLOT_LEFT, wheelL.EV_HALL_MISSED) == missedL))
    elseif BUILD_START_B1
        if illegalR > 0
            skrNote(SKR_ILL, bClean and (evSum(SLOT_RIGHT, wheelL.EV_HALL_ILLEGAL) == illegalR))
        skrNote(SKR_NOILL, bClean and (evCount(SLOT_LEFT, wheelL.EV_HALL_ILLEGAL) == 0))

PRI emitSkNeg(lifeIdx) | pWhich
' BM-SKNEG (task 3614): the firmware negative armed on the next start, printed before its BM-SSTART -- the part's
' lifetime index (idx; BM-SKHEALTH's life is the steering lifetime the start then takes), the wheel, the kind, which
' phase or hall pair, the hook's return, and (task 3621, before why) the lifetime's start mode. Worst case 118 bytes.
'
' @param lifeIdx - 0..SK_LIVES-1
'
' @local pWhich - the selection's token

    if BUILD_NEG == SKNEG_PHASE
        pWhich := tokenAt(@tokPrbPhase, PRB_TOK_COUNT, skNegSel)
    else
        pWhich := tokenAt(@tokHallSwap, HSW_TOK_COUNT, skNegSel)
    recBegin(@"BM-SKNEG")
    benchLog.numField(@"idx", lifeIdx, LIM_TINY)
    benchLog.tokenField(@"motor", sideToken(SIDE_LEFT), TOKMAX_MOTOR)
    benchLog.tokenField(@"kind", tokenAt(@tokSkNegKind, SKNEG_COUNT, BUILD_NEG), TOKMAX_SKNEG_KIND)
    benchLog.tokenField(@"which", pWhich, TOKMAX_SKNEG_WHICH)
    benchLog.numField(@"err", skNegErr, LIM_SMALL)
    benchLog.tokenField(@"mode", tokenAt(@tokSkMode, SKM_COUNT, skLifeMode), TOKMAX_SKMODE)
    whyField(WHY_NONE)
    emitRecord()

PRI skArmWind(lifeIdx)
' Task 3610 (R19.4 1e): arm the driver's winding check on both wheels before the start that consumes it -- in the
' dual-start build lifetimes 0 .. SK_WIND_LIVES-1, in the START_NEG_PHASE build every opt-out lifetime (task 3621: the
' check honours only the every-attempt withhold, after skArmNeg() has set it), in any other build none. THE ROTORS MOVE at that start, to each pair's alignment. Nothing
' prints here: every armed lifetime's BM-SKWIND carries what the check read.
'
' @param lifeIdx - 0..SK_LIVES-1

    if ((BUILD_WIND == SKWIND_NEG) and (skLifeMode == SKM_OPTOUT)) or ((BUILD_WIND == SKWIND_POS) and (lifeIdx < SK_WIND_LIVES))
        beat(CP_LIB_STEER_START)
        steering.testSetWindingProbe(TRUE)
        beat(CP_LIB_STEER_START)
        bSkWindArmed := TRUE

PRI skReadWinding() | pairIdx
' Task 3610: each wheel's three winding pairs (U->V, V->W, W->U) from the start just made, read right after
' skReadHealth(), on an armed lifetime only: an unarmed start measures nothing of its own. R20.4: and the voltage each
' wheel's check computed with, with its source (the pack sensor, or the nominal).
'
' @local pairIdx - 0..SK_WIND_PAIRS-1, the pair; the right wheel's entries are SK_WIND_PAIRS on

    if bSkWindArmed
        beat(CP_LIB_STEER_QUERY)
        repeat pairIdx from 0 to SK_WIND_PAIRS - 1
            skWindState[pairIdx], skWindMohm[pairIdx], skWindMv[pairIdx] := steering.testLeftGetWinding(pairIdx)
            skWindState[SK_WIND_PAIRS + pairIdx], skWindMohm[SK_WIND_PAIRS + pairIdx], skWindMv[SK_WIND_PAIRS + pairIdx] := steering.testRightGetWinding(pairIdx)
        skWindVSrc[SLOT_LEFT], skWindVMv[SLOT_LEFT] := steering.testLeftGetWindingVoltage()
        skWindVSrc[SLOT_RIGHT], skWindVMv[SLOT_RIGHT] := steering.testRightGetWindingVoltage()
        beat(CP_LIB_STEER_QUERY)

PRI skFoldWinding() | slotIdx, pairIdx, windBase, sumMohm, meanMohm, bAllMeasured, bLifeOk, withIdx, wantState
' Task 3610: fold one armed lifetime whose start()'s verdicts were read into the winding cells.
'  dual-start, per wheel: WINDR counts each pair, bad unless WND_MEASURED and WIND_R_LO_MOHM .. WIND_R_HI_MOHM;
'   WINDSPR counts the lifetime, bad unless all three pairs are MEASURED and each lies within WIND_SPREAD_PCT of
'   their mean.
'  START_NEG_PHASE, LEFT only: WINDNEG counts the lifetime, bad unless the two pairs containing the withheld phase
'   (pair p drives phase p and returns through p+1) are WND_NOT_VISIBLE and the third is WND_MEASURED. Three MEASURED
'   (the hook did not take) and the wrong pair dark both fail it.
'  dual-start, per wheel (R20.4): WINDV counts the lifetime, bad unless the check's voltage has the basis the pack
'   sensor reads (bSkWindVOk()).
'
' @local slotIdx - motor slot
' @local pairIdx - 0..SK_WIND_PAIRS-1: U->V, V->W, W->U
' @local windBase - this wheel's first index in the skWind* arrays
' @local sumMohm - the lifetime's MEASURED resistances summed, mohm
' @local meanMohm - their mean, mohm
' @local bAllMeasured - every pair read WND_MEASURED
' @local bLifeOk - the lifetime's reading held (WINDSPR or WINDNEG)
' @local withIdx - the withheld phase as a pair index, 0..SK_WIND_PAIRS-1
' @local wantState - the WND_* a pair must read under the withheld phase

    if bSkWindArmed and bSkHealthRead
        if BUILD_WIND == SKWIND_POS
            repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                windBase := slotIdx * SK_WIND_PAIRS
                sumMohm := 0
                bAllMeasured := TRUE
                repeat pairIdx from 0 to SK_WIND_PAIRS - 1
                    sfSkWindRN[slotIdx] := (sfSkWindRN[slotIdx] + 1) <# LIM_SMALL
                    if skWindState[windBase + pairIdx] <> wheelL.WND_MEASURED
                        bAllMeasured := FALSE
                        sfSkWindRBad[slotIdx] := (sfSkWindRBad[slotIdx] + 1) <# LIM_SMALL
                    else
                        sumMohm += skWindMohm[windBase + pairIdx]
                        if (skWindMohm[windBase + pairIdx] < WIND_R_LO_MOHM) or (skWindMohm[windBase + pairIdx] > WIND_R_HI_MOHM)
                            sfSkWindRBad[slotIdx] := (sfSkWindRBad[slotIdx] + 1) <# LIM_SMALL
                sfSkWindSpN[slotIdx] := (sfSkWindSpN[slotIdx] + 1) <# LIM_SMALL
                bLifeOk := bAllMeasured
                if bAllMeasured
                    meanMohm := sumMohm / SK_WIND_PAIRS
                    repeat pairIdx from 0 to SK_WIND_PAIRS - 1
                        if (abs(skWindMohm[windBase + pairIdx] - meanMohm) * SK_PCT_SCALE) > (meanMohm * WIND_SPREAD_PCT)
                            bLifeOk := FALSE
                if bLifeOk == FALSE
                    sfSkWindSpBad[slotIdx] := (sfSkWindSpBad[slotIdx] + 1) <# LIM_SMALL
                sfSkWindVN[slotIdx] := (sfSkWindVN[slotIdx] + 1) <# LIM_SMALL     ' R20.4
                if bSkWindVOk(slotIdx) == FALSE
                    sfSkWindVBad[slotIdx] := (sfSkWindVBad[slotIdx] + 1) <# LIM_SMALL
        elseif (BUILD_WIND == SKWIND_NEG) and bSkNegArmed
            withIdx := skNegSel - wheelL.PRB_U
            windBase := SLOT_LEFT * SK_WIND_PAIRS
            bLifeOk := TRUE
            repeat pairIdx from 0 to SK_WIND_PAIRS - 1
                wantState := wheelL.WND_MEASURED
                if (pairIdx == withIdx) or (((pairIdx + 1) // SK_WIND_PAIRS) == withIdx)
                    wantState := wheelL.WND_NOT_VISIBLE
                if skWindState[windBase + pairIdx] <> wantState
                    bLifeOk := FALSE
            sfSkWindNgN := (sfSkWindNgN + 1) <# LIM_SMALL
            if bLifeOk == FALSE
                sfSkWindNgBad := (sfSkWindNgBad + 1) <# LIM_SMALL

PRI bSkWindVOk(slotIdx) : bOk
' R20.4: whether one wheel's winding check computed with the voltage its basis names, judged against what the pack
' sensor read after the same start (skPack, skPackMv; skReadHealth()). A sensor reading a pack: the source PACK_PRESENT
' and the voltage within SK_WINDV_MV of the getter's (the check's own reading came about a second earlier, at rest).
' Otherwise the source the getter reads (PACK_NOT_FITTED, or PACK_ABSENT) and exactly the nominal, PACK_MV. So a check
' that used the nominal beside a present pack fails it, and so does one that used a reading the sensor did not have.
' Both wheels are judged against the getter the LEFT wheel's object reads: the right wheel reads the same pin for its
' own check.
'
' @param slotIdx - motor slot
' @returns bOk - TRUE when the source and the voltage agree with the sensor

    if skPack == wheelL.PACK_PRESENT
        bOk := (skWindVSrc[slotIdx] == wheelL.PACK_PRESENT) and (abs(skWindVMv[slotIdx] - skPackMv) <= SK_WINDV_MV)
    else
        bOk := (skWindVSrc[slotIdx] == skPack) and (skWindVMv[slotIdx] == PACK_MV)

PRI emitSkWind(slotIdx, whyCode) | windBase
' BM-SKWIND (task 3610): one wheel's winding check at an armed start, printed per wheel on every armed lifetime --
' per pair (uv: U->V, vw: V->W, wu: W->U) its WND_* state, its resistance (<pair>_mohm, NA unless MEASURED) and its
' net DC-link reading over the rest zero (<pair>_mV); every pair field NA when start()'s verdicts were not read. R20.4
' appends, before why, the voltage the resistances were computed with (v_mV) and its source (v_src: PRESENT, the pack
' sensor; ABSENT or NOT_FITTED, the nominal), so a reading's basis is never hidden. Worst case 237 bytes.
'
' @param slotIdx - motor slot
' @param whyCode - why nothing was read, WHY_NONE when it was
'
' @local windBase - this wheel's first index in the skWind* arrays

    windBase := slotIdx * SK_WIND_PAIRS
    recBegin(@"BM-SKWIND")
    benchLog.naNumField(@"life", skLife, LIM_SMALL, skLife > 0)
    benchLog.tokenField(@"motor", sideToken(SIDE_LEFT + slotIdx), TOKMAX_MOTOR)
    windPairFields(@"uv", @"uv_mohm", @"uv_mV", windBase)
    windPairFields(@"vw", @"vw_mohm", @"vw_mV", windBase + 1)
    windPairFields(@"wu", @"wu_mohm", @"wu_mV", windBase + 2)
    if bSkHealthRead                                        ' R20.4: the voltage's basis
        benchLog.tokenField(@"v_src", tokenAt(@tokPack, PACK_TOK_COUNT, skWindVSrc[slotIdx]), TOKMAX_PACK)
    else
        benchLog.textField(@"v_src", @sSfNa)
    benchLog.naNumField(@"v_mV", skWindVMv[slotIdx], LIM_SMALL, bSkHealthRead)
    whyField(whyCode)
    emitRecord()

PRI windPairFields(pStateName, pMohmName, pMvName, arrIdx)
' BM-SKWIND's three fields for one pair: the state token (NA unread), the resistance (NA unless WND_MEASURED) and the
' net mV (NA unread). Worst case 45 bytes: state 2 + 2 + TOKMAX_WND, mohm 2 + 7 + 7, mV 2 + 5 + 7.
'
' @param pStateName - the state field's name
' @param pMohmName - the resistance field's name
' @param pMvName - the net reading field's name
' @param arrIdx - the pair's index in the skWind* arrays

    if bSkHealthRead
        benchLog.tokenField(pStateName, tokenAt(@tokWndState, WND_TOK_COUNT, skWindState[arrIdx]), TOKMAX_WND)
    else
        benchLog.textField(pStateName, @sSfNa)
    benchLog.naNumField(pMohmName, skWindMohm[arrIdx], LIM_SMALL, bSkHealthRead and (skWindState[arrIdx] == wheelL.WND_MEASURED))
    benchLog.naNumField(pMvName, skWindMv[arrIdx], LIM_SMALL, bSkHealthRead)

PRI emitStartCells() | slotIdx, side
' The START part's judged cells, each NOMEAS when nothing measured it. Per motor, the probe's control before the probe:
'
'  HEALTH   - COUNT: starts with any getHealth() failed bit, or with a start check not checked
'  RZSPREAD - COUNT: starts whose rest zero lay outside REST_ZERO_MIN_MV .. REST_ZERO_MAX_MV (spread: BM-SKSUM)
'  PRBFLR   - MV: the largest coast-floor phase reading; passes under the least a follower may read (SK_FLOOR_HI_MV)
'  PROBE    - COUNT: probes whose driven phase read under CONT_MIN_DRIVEN_MV or any follower under CONT_FOLLOW_PCT
'  WALK     - COUNT: walks whose pre-registered reading did not hold; NOT_BUILT in the START_NO_WALK build
'
' and once, PACK - COUNT: starts whose pack reading did not match the configuration (bSkPackAsConfig(): fitted,
' PACK_PRESENT at SK_PACK_LO_MV .. SK_PACK_HI_MV and HLT_PACK checked, not failed; unfitted, PACK_NOT_FITTED, 0 mV and
' no HLT_PACK). Then, only in its own build
' and LEFT only (task 3614):
'
'  PHNEG    - COUNT: armed starts whose LEFT failed mask was not exactly the withheld phase's bit (START_NEG_PHASE)
'  SWNEG    - COUNT: armed walks whose LEFT HLT_WIRING was not judged failed; NOMEAS with no walk (START_NEG_SWAP)
'
' and the winding check's (task 3610), each only in its own build, each passing at 0 and failing at 1 or more:
'
'  WINDR    - COUNT per motor (dual-start): pairs not WND_MEASURED (NOT_RUN, NOT_VISIBLE, TRIPPED, UNSETTLED), or
'             MEASURED under WIND_R_LO_MOHM or over WIND_R_HI_MOHM; NOMEAS when no armed start was read
'  WINDSPR  - COUNT per motor (dual-start): armed lifetimes whose three pairs were not all MEASURED, or any pair lay
'             more than WIND_SPREAD_PCT from the three's mean
'  WINDNEG  - COUNT, LEFT (START_NEG_PHASE): armed lifetimes in which either pair containing the withheld phase was
'             not WND_NOT_VISIBLE, or the third was not WND_MEASURED -- three MEASURED (the hook did not take) fails
'             it, as does the wrong pair going dark
'  WINDV    - R20-PACK-WINDV, COUNT per motor (dual-start, R20.4): armed lifetimes whose check's voltage did not have
'             the basis the pack sensor reads (bSkWindVOk()): with no sensor fitted, NOT_FITTED and the nominal exactly
'
' and task 3621's reporting cells, each a COUNT of bad instances in its own build (this part's CON, SKR_*):
' START_NEG_PHASE REFUSE, OPTOUT (LEFT) and RETRY (LEFT RETRY_REPORTED, BOTH NO_SPURIOUS_RETRY); dual-start NOREFUSE,
' RETRY (NO_SPURIOUS_RETRY), EV-WALKGUARD (NO_GUARD_EV), EV-HALLMISSED (NO_HALL_EV) and R20-PACK-EV (PACK_STEADY_NO_EV,
' NOMEAS unless the sensor is fitted; PACK_UNPLUG_EV NOT_BUILT here, built by dual-pack); dual-start-swapneg EV-WALKGUARD (LEFT GUARD_EV_ON_SWAP,
' RIGHT NO_GUARD_EV) and EV-HALLMISSED (LEFT MISSED_SUM_EQUAL); dual-start-nowalk EV-HALLILL (RIGHT ILLEGAL_SUM_EQUAL,
' LEFT NO_ILLEGAL_EV).
'
' @local slotIdx - motor slot
' @local side - SIDE_LEFT or SIDE_RIGHT

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        side := SIDE_LEFT + slotIdx
        emitSignoff(@sSfCellSkHealth, side, @sSfCritSkHealth, sfSkStarts[slotIdx] > 0, sfSkHealthBad[slotIdx], SK_BAD_LO, SK_BAD_HI, sfSkStarts[slotIdx], @sSfUnitsCount)
        emitSignoff(@sSfCellSkRz, side, @sSfCritSkRz, skRzN[slotIdx] > 0, sfSkRzOut[slotIdx], SK_BAD_LO, SK_BAD_HI, skRzN[slotIdx], @sSfUnitsCount)
        emitSignoff(@sSfCellSkPrbFlr, side, @sSfCritSkPrbFlr, skFlN[slotIdx] > 0, skFlMax[slotIdx], SK_FLOOR_LO_MV, SK_FLOOR_HI_MV, skFlN[slotIdx], @sSfUnitsMv)
        emitSignoff(@sSfCellSkProbe, side, @sSfCritSkProbe, skPrbN[slotIdx] > 0, sfSkPrbBad[slotIdx], SK_BAD_LO, SK_BAD_HI, skPrbN[slotIdx], @sSfUnitsCount)
        if BUILD_NO_WALK
            emitSignoffNotBuilt(@sSfCellSkWalk, side, @sSfCritSkWalk)
        else
            emitSignoff(@sSfCellSkWalk, side, @sSfCritSkWalk, sfSkWalkN[slotIdx] > 0, sfSkWalkBad[slotIdx], SK_BAD_LO, SK_BAD_HI, sfSkWalkN[slotIdx], @sSfUnitsCount)
        if BUILD_WIND == SKWIND_POS                         ' task 3610
            emitSignoff(@sSfCellSkWindR, side, @sSfCritSkWindR, sfSkWindRN[slotIdx] > 0, sfSkWindRBad[slotIdx], SK_BAD_LO, SK_BAD_HI, sfSkWindRN[slotIdx], @sSfUnitsCount)
            emitSignoff(@sSfCellSkWindSp, side, @sSfCritSkWindSp, sfSkWindSpN[slotIdx] > 0, sfSkWindSpBad[slotIdx], SK_BAD_LO, SK_BAD_HI, sfSkWindSpN[slotIdx], @sSfUnitsCount)
            emitSignoff(@sSfCellWindV, side, @sSfCritWindV, sfSkWindVN[slotIdx] > 0, sfSkWindVBad[slotIdx], SK_BAD_LO, SK_BAD_HI, sfSkWindVN[slotIdx], @sSfUnitsCount)   ' R20.4
    emitSignoff(@sSfCellSkPack, SIDE_NONE, @sSfCritSkPack, sfSkPackN > 0, sfSkPackBad, SK_BAD_LO, SK_BAD_HI, sfSkPackN, @sSfUnitsCount)
    if BUILD_NEG == SKNEG_PHASE
        emitSignoff(@sSfCellSkPhNeg, SIDE_LEFT, @sSfCritSkPhNeg, sfSkPhNegN > 0, sfSkPhNegBad, SK_BAD_LO, SK_BAD_HI, sfSkPhNegN, @sSfUnitsCount)
    elseif BUILD_NEG == SKNEG_SWAP
        emitSignoff(@sSfCellSkSwNeg, SIDE_LEFT, @sSfCritSkSwNeg, sfSkSwNegN > 0, sfSkSwNegBad, SK_BAD_LO, SK_BAD_HI, sfSkSwNegN, @sSfUnitsCount)
    if BUILD_WIND == SKWIND_NEG                             ' task 3610
        emitSignoff(@sSfCellSkWindNg, SIDE_LEFT, @sSfCritSkWindNg, sfSkWindNgN > 0, sfSkWindNgBad, SK_BAD_LO, SK_BAD_HI, sfSkWindNgN, @sSfUnitsCount)
    ' task 3621 (R20.1): the reporting cells, each in the build that judges it (this part's CON, SKR_*). REFUSE and
    '  OPTOUT are each the other's control, so each is measured only when both ran. A cell whose negative lives in
    '  another build prints the half this build holds, under its own criterion.
    if BUILD_NEG == SKNEG_PHASE
        emitSignoff(@sSfCellRefuse, SIDE_LEFT, @sSfCritRefuse, (sfSkrN[SKR_REF] > 0) and (sfSkrN[SKR_OPT] > 0), sfSkrBad[SKR_REF], R20_BAD_LO, R20_BAD_HI, sfSkrN[SKR_REF], @sSfUnitsCount)
        emitSignoff(@sSfCellOptOut, SIDE_LEFT, @sSfCritOptOut, (sfSkrN[SKR_OPT] > 0) and (sfSkrN[SKR_REF] > 0), sfSkrBad[SKR_OPT], R20_BAD_LO, R20_BAD_HI, sfSkrN[SKR_OPT], @sSfUnitsCount)
        skrEmit(@sSfCellRetry, SIDE_LEFT, @sSfCritRetry, SKR_RET)
        skrEmit(@sSfCellRetry, SIDE_BOTH, @sSfCritNoRetry, SKR_NORET)
    elseif BUILD_START_POS
        skrEmit(@sSfCellNoRefuse, SIDE_BOTH, @sSfCritNoRefuse, SKR_NOREF)
        skrEmit(@sSfCellRetry, SIDE_BOTH, @sSfCritNoRetry, SKR_NORET)
        skrEmit(@sSfCellEvGuard, SIDE_BOTH, @sSfCritNoGuard, SKR_NOGRD)
        skrEmit(@sSfCellEvMiss, SIDE_BOTH, @sSfCritNoHall, SKR_NOHAL)
        skrEmit(@sSfCellPackEv, SIDE_NONE, @sSfCritPackQ, SKR_PACK)             ' NOMEAS while the sensor is not fitted
        emitSignoffNotBuilt(@sSfCellPackEv, SIDE_NONE, @sSfCritPackEv)          ' the unplug and replug: dual-pack's (R20.4)
    elseif BUILD_NEG == SKNEG_SWAP
        skrEmit(@sSfCellEvGuard, SIDE_LEFT, @sSfCritGuardEv, SKR_GRD)
        skrEmit(@sSfCellEvGuard, SIDE_RIGHT, @sSfCritNoGuard, SKR_NOGRD)
        skrEmit(@sSfCellEvMiss, SIDE_LEFT, @sSfCritMissSum, SKR_MIS)
    elseif BUILD_START_B1
        skrEmit(@sSfCellEvIll, SIDE_RIGHT, @sSfCritIllSum, SKR_ILL)
        skrEmit(@sSfCellEvIll, SIDE_LEFT, @sSfCritNoIll, SKR_NOILL)

PRI skrEmit(pCell, side, pCrit, skrIdx)
' Task 3621: one START reporting cell's instance: the bad count of its SKR_* instances, passing at 0; NOMEAS when none
' was judged.
'
' @param pCell - pointer to the cell id
' @param side - SIDE_* the instance is about
' @param pCrit - pointer to the criterion token
' @param skrIdx - SKR_*

    emitSignoff(pCell, side, pCrit, sfSkrN[skrIdx] > 0, sfSkrBad[skrIdx], R20_BAD_LO, R20_BAD_HI, sfSkrN[skrIdx], @sSfUnitsCount)

PRI emitSkBuild() | nWalks
' BM-SKBUILD: the START part's compiled, pre-registered numbers, printed before anything moves -- the driver's own
' R19.4 thresholds the cells judge against, the probe's timing, the walk's band and power, and the control's bound;
' then the build's firmware negative (neg: NONE, PHASE or SWAP; task 3614, appended); last (PL-137, appended) the
' watchdog's extra allowance inside checkWiring(), wd_walk_ms. Worst case 248 bytes.
'
' @local nWalks - the walks this build makes

    nWalks := SK_WALKS
    if BUILD_NO_WALK
        nWalks := 0
    recBegin(@"BM-SKBUILD")
    benchLog.numField(@"lives", SK_LIVES, LIM_TINY)
    benchLog.numField(@"walks", nWalks, LIM_TINY)
    benchLog.boolField(@"no_walk", BUILD_NO_WALK)
    benchLog.numField(@"rz_lo", wheelL.REST_ZERO_MIN_MV, LIM_SMALL)
    benchLog.numField(@"rz_hi", wheelL.REST_ZERO_MAX_MV, LIM_SMALL)
    benchLog.numField(@"drv_mV", wheelL.CONT_MIN_DRIVEN_MV, LIM_SMALL)
    benchLog.numField(@"fol_pct", wheelL.CONT_FOLLOW_PCT, LIM_TINY)
    benchLog.numField(@"fl_hi", SK_FLOOR_HI_MV, LIM_SMALL)
    benchLog.numField(@"prb_ms", wheelL.PROBE_SETTLE_MS, LIM_TINY)
    benchLog.numField(@"prb_n", wheelL.PROBE_SAMPLES, LIM_TINY)
    benchLog.numField(@"leg_lo", SK_LEG_LO_TICKS, LIM_TINY)
    benchLog.numField(@"leg_hi", SK_LEG_HI_TICKS, LIM_TINY)
    benchLog.numField(@"walk_pwr", wheelL.WALK_POWER, LIM_TINY)
    benchLog.numField(@"zero_ms", ZERO_WINDOW_MS, LIM_SMALL)
    benchLog.tokenField(@"neg", tokenAt(@tokSkNegKind, SKNEG_COUNT, BUILD_NEG), TOKMAX_SKNEG_KIND)
    benchLog.numField(@"wd_walk_ms", WD_WALK_GRACE_MS, LIM_SMALL)   ' PL-137: the watchdog's extra allowance inside checkWiring()
    emitRecord()

PRI emitSkHealth(bWalk, whyCode)
' BM-SKHEALTH: one start's verdicts from start() itself -- each wheel's getHealth() masks (HLT_* bits, hex), its
' illegal hall codes by kind (entries into %000 and %111; B-1 reads them), the pack sensor, and whether this lifetime
' walks; then, added by task 3621 before why (still last), whether this start refused a failing check (refuse: FALSE
' when it opted out) and each wheel's recovered mask (l_rec, r_rec, hex). A refused start's own masks are
' BM-SREFUSE's. Worst case 260 bytes.
'
' @param bWalk - TRUE when this lifetime also walks
' @param whyCode - why nothing was read, WHY_NONE when it was

    recBegin(@"BM-SKHEALTH")
    benchLog.naNumField(@"life", skLife, LIM_SMALL, skLife > 0)
    if bSkHealthRead
        benchLog.hexField(@"l_chk", skChk[SLOT_LEFT])
        benchLog.hexField(@"l_fail", skFail[SLOT_LEFT])
        benchLog.hexField(@"r_chk", skChk[SLOT_RIGHT])
        benchLog.hexField(@"r_fail", skFail[SLOT_RIGHT])
        benchLog.tokenField(@"pack", tokenAt(@tokPack, PACK_TOK_COUNT, skPack), TOKMAX_PACK)
    else
        benchLog.textField(@"l_chk", @sSfNa)
        benchLog.textField(@"l_fail", @sSfNa)
        benchLog.textField(@"r_chk", @sSfNa)
        benchLog.textField(@"r_fail", @sSfNa)
        benchLog.textField(@"pack", @sSfNa)
    benchLog.naNumField(@"pack_mV", skPackMv, LIM_SMALL, bSkHealthRead)
    benchLog.naNumField(@"l_ill_lo", skIllLo[SLOT_LEFT], LIM_SMALL, bSkHealthRead)
    benchLog.naNumField(@"l_ill_hi", skIllHi[SLOT_LEFT], LIM_SMALL, bSkHealthRead)
    benchLog.naNumField(@"r_ill_lo", skIllLo[SLOT_RIGHT], LIM_SMALL, bSkHealthRead)
    benchLog.naNumField(@"r_ill_hi", skIllHi[SLOT_RIGHT], LIM_SMALL, bSkHealthRead)
    benchLog.boolField(@"walk", bWalk)
    benchLog.boolField(@"refuse", skLifeMode <> SKM_OPTOUT)
    if bSkHealthRead
        benchLog.hexField(@"l_rec", skRec[SLOT_LEFT])
        benchLog.hexField(@"r_rec", skRec[SLOT_RIGHT])
    else
        benchLog.textField(@"l_rec", @sSfNa)
        benchLog.textField(@"r_rec", @sSfNa)
    whyField(whyCode)
    emitRecord()

PRI emitSkProbe(slotIdx, whyCode) | rowBase, floorBase, bZero, firstWhy
' BM-SKPROBE: one wheel's lead check at this start -- p_<driven><read> is the phase read while the named phase was
' driven (p_uv: V's reading while U was driven) -- its probes that failed (bad, skFoldProbe()), then the floated
' window: the rest zero, each phase's coast floor and the samples behind them. Worst case 268 bytes.
'
' @param slotIdx - motor slot
' @param whyCode - why nothing was read, WHY_NONE when it was
'
' @local rowBase - this wheel's first index in skProbe
' @local floorBase - its first index in skFloor
' @local bZero - the window is a measurement
' @local firstWhy - the first cause of the record's NA fields

    rowBase := slotIdx * SK_PROBE_LONGS
    floorBase := slotIdx * SK_PHASES
    bZero := bSkZeroValid[slotIdx] <> FALSE
    firstWhy := whyCode
    if (firstWhy == WHY_NONE) and (bZero == FALSE)
        firstWhy := skZeroWhy
        if firstWhy == WHY_NONE
            firstWhy := WHY_NO_SAMPLES
    recBegin(@"BM-SKPROBE")
    benchLog.naNumField(@"life", skLife, LIM_SMALL, skLife > 0)
    benchLog.tokenField(@"motor", sideToken(SIDE_LEFT + slotIdx), TOKMAX_MOTOR)
    benchLog.naNumField(@"p_uu", skProbe[rowBase], LIM_SMALL, bSkHealthRead)
    benchLog.naNumField(@"p_uv", skProbe[rowBase + 1], LIM_SMALL, bSkHealthRead)
    benchLog.naNumField(@"p_uw", skProbe[rowBase + 2], LIM_SMALL, bSkHealthRead)
    benchLog.naNumField(@"p_vu", skProbe[rowBase + 3], LIM_SMALL, bSkHealthRead)
    benchLog.naNumField(@"p_vv", skProbe[rowBase + 4], LIM_SMALL, bSkHealthRead)
    benchLog.naNumField(@"p_vw", skProbe[rowBase + 5], LIM_SMALL, bSkHealthRead)
    benchLog.naNumField(@"p_wu", skProbe[rowBase + 6], LIM_SMALL, bSkHealthRead)
    benchLog.naNumField(@"p_wv", skProbe[rowBase + 7], LIM_SMALL, bSkHealthRead)
    benchLog.naNumField(@"p_ww", skProbe[rowBase + 8], LIM_SMALL, bSkHealthRead)
    benchLog.naNumField(@"bad", skPrbBadNow[slotIdx], LIM_TINY, bSkHealthRead)
    benchLog.naNumField(@"zero_x10", skZeroX10[slotIdx], LIM_MID, bZero)
    benchLog.naNumField(@"fl_u", skFloor[floorBase], LIM_SMALL, bZero)
    benchLog.naNumField(@"fl_v", skFloor[floorBase + 1], LIM_SMALL, bZero)
    benchLog.naNumField(@"fl_w", skFloor[floorBase + 2], LIM_SMALL, bZero)
    benchLog.naNumField(@"n", skZeroN[slotIdx], LIM_SMALL, bZero)
    whyField(firstWhy)
    emitRecord()

PRI emitSkWalk()
' BM-SKWALK: one walk -- checkWiring()'s return, each wheel's HLT_WIRING verdict (l_hlt, r_hlt), its two legs rebuilt
' from the ring, its hall events across the walk, its peak sense_i, whether the pre-registered reading held (l_ok,
' r_ok), how long the call blocked, and each wheel's fault cause after it. Worst case 272 bytes.

    recBegin(@"BM-SKWALK")
    benchLog.naNumField(@"life", skLife, LIM_SMALL, skLife > 0)
    benchLog.naNumField(@"err", skWalkErr, LIM_SMALL, bSkWalkRan)
    benchLog.boolField(@"l_hlt", bSkWalkHlt[SLOT_LEFT])
    benchLog.boolField(@"r_hlt", bSkWalkHlt[SLOT_RIGHT])
    benchLog.naNumField(@"l_fwd", skLegFwd[SLOT_LEFT], LIM_SMALL, bSkLegsValid)
    benchLog.naNumField(@"l_rev", skLegRev[SLOT_LEFT], LIM_SMALL, bSkLegsValid)
    benchLog.naNumField(@"r_fwd", skLegFwd[SLOT_RIGHT], LIM_SMALL, bSkLegsValid)
    benchLog.naNumField(@"r_rev", skLegRev[SLOT_RIGHT], LIM_SMALL, bSkLegsValid)
    benchLog.naNumField(@"l_ig", skWalkIg[SLOT_LEFT], LIM_SMALL, bSkWalkRan)
    benchLog.naNumField(@"r_ig", skWalkIg[SLOT_RIGHT], LIM_SMALL, bSkWalkRan)
    benchLog.naNumField(@"l_pk_i", skWalkPkI[SLOT_LEFT], LIM_SMALL, bSkLegsValid and (skWalkPkI[SLOT_LEFT] <> NEGX))
    benchLog.naNumField(@"r_pk_i", skWalkPkI[SLOT_RIGHT], LIM_SMALL, bSkLegsValid and (skWalkPkI[SLOT_RIGHT] <> NEGX))
    benchLog.boolField(@"l_ok", bSkWalkOk[SLOT_LEFT])
    benchLog.boolField(@"r_ok", bSkWalkOk[SLOT_RIGHT])
    benchLog.naNumField(@"walk_ms", skWalkMs, LIM_SMALL, bSkWalkRan)
    benchLog.tokenField(@"l_cause", tokenAt(@tokFltCause, FC_COUNT, skWalkCause[SLOT_LEFT]), TOKMAX_FCAUSE)
    benchLog.tokenField(@"r_cause", tokenAt(@tokFltCause, FC_COUNT, skWalkCause[SLOT_RIGHT]), TOKMAX_FCAUSE)
    whyField(skWalkWhy)
    emitRecord()

PRI emitSkSum(slotIdx) | bRz, bDrv, bFol, firstWhy
' BM-SKSUM: one wheel over the whole segment -- the numbers that SIZE R19.4. The rest zero's least, greatest, spread
' and mean over every start (x10 mV; B-2 compares the spread on one board with the gap between the boards' means) and
' how many lay outside the driver's band; the probe's least driven reading and least follower percentage, and how
' many probes failed; the largest coast-floor reading. Worst case 263 bytes.
'
' @param slotIdx - motor slot
'
' @local bRz - a rest zero was measured
' @local bDrv - a driven reading was taken
' @local bFol - a follower percentage was taken
' @local firstWhy - the first cause of the record's NA fields

    bRz := skRzN[slotIdx] > 0
    bDrv := skDrvMin[slotIdx] <> POSX
    bFol := skFolMinPct[slotIdx] <> POSX
    firstWhy := WHY_NONE
    if (bRz == FALSE) or (bDrv == FALSE) or (bFol == FALSE)
        firstWhy := WHY_NO_SAMPLES
    recBegin(@"BM-SKSUM")
    benchLog.tokenField(@"motor", sideToken(SIDE_LEFT + slotIdx), TOKMAX_MOTOR)
    benchLog.numField(@"starts", sfSkStarts[slotIdx], LIM_SMALL)
    benchLog.numField(@"rz_n", skRzN[slotIdx], LIM_SMALL)
    benchLog.naNumField(@"rz_min_x10", skRzMin[slotIdx], LIM_MID, bRz)
    benchLog.naNumField(@"rz_max_x10", skRzMax[slotIdx], LIM_MID, bRz)
    benchLog.naNumField(@"rz_spr_x10", skRzMax[slotIdx] - skRzMin[slotIdx], LIM_MID, bRz)
    if bRz
        benchLog.numField(@"rz_mean_x10", skRzSum[slotIdx] / skRzN[slotIdx], LIM_MID)
    else
        benchLog.textField(@"rz_mean_x10", @sSfNa)
    benchLog.numField(@"rz_out", sfSkRzOut[slotIdx], LIM_SMALL)
    benchLog.naNumField(@"drv_min_mV", skDrvMin[slotIdx], LIM_SMALL, bDrv)
    benchLog.naNumField(@"fol_min_pct", skFolMinPct[slotIdx], LIM_SMALL, bFol)
    benchLog.numField(@"prb_bad", sfSkPrbBad[slotIdx], LIM_SMALL)
    benchLog.naNumField(@"fl_max_mV", skFlMax[slotIdx], LIM_SMALL, skFlN[slotIdx] > 0)
    whyField(firstWhy)
    emitRecord()

#endif

CON { --- PACK: the pack voltage sensor, fitted and certified (task 3611, R20.4) --- }

  ' WHAT THIS PART IS FOR. R19.5 built the driver's reading of Stephen's pack voltage sensor (VOLTAGE-SENSOR.md, his spec
  '  and the authority for the unit); R20.4 certifies it on his fitted unit: the reading against a meter at two pack
  '  voltages after the one-time calibration, an unplugged sensor reading PACK_ABSENT and never a voltage (D2, register
  '  INS-10), and EV_PACK on each change (R20-PACK-EV). NOTHING MOVES: one steering lifetime, its start checks only (no
  '  winding check, no walk, nothing commanded), and every reading is the driver's own, through the steering object's
  '  getPackVoltage() and testGetPackRaw() -- the harness reads no pin (P14).
  '
  ' NOT FITTED, NOTHING RUNS. Built with user.PACK_SENSOR_FITTED FALSE (both configs today) the part starts nothing, says
  '  so on the terminal, and every pack cell prints NOT_BUILT beside a BM-NOTBUILT why PACK_NOT_FITTED: a run on an
  '  unfitted bench cannot pass.
  '
  ' THE SEQUENCE, fitted. No panel and no key: every step he takes part in ends on what the sensor itself sees, so he
  '  never clicks, types or times anything. Each step is one plain line on the terminal (alignSay(), as ALIGN's), and
  '  the terminal is silent while he acts. Five steps, numbered 1 to 5 on the terminal, in the runner's banner and here:
  '   1  HANDS OFF, PK_STEADY_MS: the pack read every PK_READ_EVERY_MS (BM-PKREAD: the getter's status and mV, the
  '      reading without the calibration, and the pin's own mV), then the log drained (BM-PKSTEADY). R20-PACK-EV's
  '      negative (DRIVER-REPORTING-DESIGN.md SS6: "a pack held steady for 60 s: no EV_PACK").
  '   2  UNPLUG the sensor's Powerpole at the pack. Seen when the getter stops reading PACK_PRESENT; then, EV_SETTLE_MS
  '      on, the getter must read PACK_ABSENT with 0 mV and the drained log exactly one EV_PACK valued PACK_ABSENT.
  '   3  PLUG IT BACK IN. Seen when the getter reads PACK_PRESENT; then, EV_SETTLE_MS on, the reading must be within
  '      PK_REPLUG_MV of the cycle's reference, and the log exactly one EV_PACK valued PACK_PRESENT.
  '   4, 5  the same again: the second cycle, which is also the first's redo.
  '  Each of 2-5 must be seen within PK_ACT_MS of its line. One that is not is JUDGED, not skipped: an unplug that never
  '  reads absent is the D2 failure itself (a disconnected sensor reading as a voltage), and a program that cannot see
  '  his act cannot tell that from his not acting -- so both FAIL, and BM-PKCYCLE's why says OPERATOR_TIMEOUT. Nothing
  '  runs after a step not seen.
  '
  ' THE REFERENCE, AND THE MARK, ARE TAKEN BEFORE HE IS ASKED TO UNPLUG (SRC_REV 56). The driver's pack reading is a
  '  running average: after the Powerpole is pulled it decays over several samples before it falls under PACK_ABSENT_MV
  '  and reads ABSENT, so every reading while it decays still says PRESENT, and "the last PRESENT reading before the
  '  unplug was seen" can be caught part-way down (pass 7, debug_260926-175052.log: steady mean 20,688 mV, least
  '  20,678, but cycle 1's reference 20,505 and its mark 20,505 / uncal 20,261; the replug's 20,684 then lay 179 mV
  '  from it and failed R20-PACK-ABSENT). No reading taken while an unplug is awaited is used. Cycle 1's reference and
  '  the mark are step 1's mean (pkSteadyMeanMv()), whose window ends before the unplug line appears; each later
  '  cycle's reference is one reading taken just before its own unplug line is printed (bPkCycle()), when he has not
  '  been asked and so cannot have unplugged. The replug is compared with a true pre-unplug value either way.
  '
  ' WHERE HE UNPLUGS. At the PACK END (the sensor's Powerpole), never the header at the P2: VOLTAGE-SENSOR.md puts R4,
  '  the pull-down that makes an unplugged sensor read about 0 V, on the small board before the header, so a header
  '  pulled off the P2 leaves the pin floating, which his page says reads a believable ~12.8 V. This part's negative is
  '  the unplug his circuit is built to read as absent.
  '
  ' THE ONE-TIME CALIBRATION AND THE METER PAIRS -- NO NUMBER IS TYPED AT THE BENCH (overlay P2), AND EACH METER READING
  '  IS SPENT ONCE (overlay P1). A PAIR is one meter reading and the P2's reading at the same moment. The run asks for a
  '  meter reading only when a pair is still owed (pkPairOwed()), just before step 2: "read the meter now, remember it".
  '  The P2's side is step 1's mean, taken over the minute that ends as that line appears (BM-PKMARK: mark_mV, and
  '  uncal_mV, the same mean without the calibration; step 1's spread bounds how far the pack moved in it), and is kept
  '  only once step 2's unplug is seen, so a run whose operator never acted takes no pair. He sends the meter
  '  number to the agent in chat after the run; the agent compiles it in here, beside BM-PKMARK's uncal_mV, and the NEXT
  '  dual-pack run prints the pair's verdict (BM-PKMETER, R20-PACK-METER):
  '   pair 1, CAL: taken while pair 1 is not yet compiled in (bPkCalSet() FALSE; the driver applies the divider's
  '     nominal 7.81 and PACK_SENSE_CAL_PERMILLE's 1000, no correction). The agent sets the bench config's
  '     PACK_SENSE_CAL_PERMILLE to 1000 x meter / uncal_mV, rounded, together with PK_METER1_MV and PK_UNCAL1_MV. Whether
  '     the calibration is done is read from the pair, never from the constant's value, so a pair that rounds to 1000 is
  '     simply 1000 (one value, one meaning). Its verdict, |uncal x CAL / 1000 - meter|, is the calibration applied to
  '     its own point: it holds that the constant compiled is the one the pair gives, and a mis-set or forgotten one
  '     fails it.
  '   pair 2, SECOND: taken on a calibrated run whose steady mean is at least PK_V2_SEP_MV from pair 1's meter reading
  '     -- the same pack at another state of charge (the calibration just after a full charge, pair 2 after the long
  '     unattended tiers have drawn it down, or the reverse). Its verdict is the independent check: the gain-only
  '     calibration holds away from its own point. A sagging pack under load is NOT a second voltage: the wheels are
  '     up and draw little, the sag lasts only while they are driven, and a meter and the P2 cannot be read at one
  '     moment of a changing load.
  '  Each verdict is computed from the two compiled numbers of its own pair, which are both readings of one moment;
  '  the run that took a pair printed the P2's half of it, and the report checks the compiled uncal against that log.
  '
  ' PK_AGREE_MV, DERIVED. With the offset left by a gain-only calibration (P2AN001: up to 9 mV at the pin, 70 mV at the
  '  pack, x 1 V / 20 V = 4 mV at a 1 V separation and 17 mV at 5 V), the calibration's permille rounding (0.05 %, 10 mV),
  '  the resistors' drift over a 10 degC day (100 ppm/degC, 0.1 %, 20 mV), the meter's 0.01 V and the pairing (the
  '  steady window's spread, printed): about 60-70 mV, so 100 mV (0.5 % of a 5S pack).
    PK_STEADY_MS          = 60_000                          ' step 1, hands off
    PK_READ_EVERY_MS      = 2_000                           ' BM-PKREAD's cadence in step 1: 30 readings
    PK_CYCLES             = 2                               ' unplug-and-replug cycles: steps 2-3 and 4-5 (the lines say 1 OF 5 .. 5 OF 5)
    PK_ACT_MS             = 60_000                          ' each of steps 2-5 must be seen within this of its line
    PK_REPLUG_MV          = 100                             ' step 3 / 5: the replugged reading within this of the cycle's reference
    PK_AGREE_MV           = 100                             ' R20-PACK-METER, both pairs (derived above)
    PK_V2_SEP_MV          = 1_000                           ' pair 2 at least this far from pair 1's meter reading
    PK_PERMILLE           = 1_000
    ' THE PAIRS, compiled in by the agent from his chat and BM-PKMARK's uncal_mV (0 while a pair is owed)
    PK_METER1_MV          = 20_740                          ' pair 1 (CAL): the meter, mV -- Stephen's DMM at the sensor Powerpole,
                                                            '  2026-09-26 16:40 (inline meter 20_750 at the same moment)
    PK_UNCAL1_MV          = 20_488                          ' ...BM-PKMARK's uncal_mV of the same moment (debug_260926-163930.log)
    PK_METER2_MV          = 0                               ' pair 2 (SECOND): the meter, mV
    PK_UNCAL2_MV          = 0                               ' ...BM-PKMARK's uncal_mV of the same moment
  ' The pair a run takes, or a BM-PKMETER is about:
  '  PKP_NONE   - no pair
  '  PKP_CAL    - pair 1, the calibration's
  '  PKP_SECOND - pair 2, at a second pack voltage
    #0, PKP_NONE, PKP_CAL, PKP_SECOND
    PKP_COUNT             = PKP_SECOND + 1
    TOKMAX_PKPAIR         = 6                               ' SECOND
    TOKMAX_PKRULE         = 16                              ' sPkRule

#ifdef DBP_PACK
DAT ' ---- PACK tables and the operator's lines (task 3611) ----

tokPkPair       BYTE    "NONE", 0, "CAL", 0, "SECOND", 0, TOK_END                       ' indexed by PKP_*
sPkRule         BYTE    "1000xMETER/UNCAL", 0                                           ' BM-PKMARK: PACK_SENSE_CAL_PERMILLE's rule
' THE OPERATOR'S LINES, written out whole, as ALIGN's are: each is what a person reads at the rig with his hand on the
'  lead, so each says the step, what to do and what the program will do, and needs nothing else on screen.
sPkSayNotFit    BYTE    "PACK: NOT BUILT -- this build has PACK_SENSOR_FITTED FALSE, so no sensor is read and every pack cell prints NOT_BUILT. Nothing to do.", 0
sPkSayStep1     BYTE    "PACK STEP 1 OF 5 -- HANDS OFF for 60 seconds while the pack is read. Leave the sensor plugged in and do nothing yet.", 0
sPkSayNoPack    BYTE    "PACK: the driver reads NO PACK at the start, so there is nothing to unplug. Check that the sensor is plugged in. Nothing more runs.", 0
sPkSayMeter     BYTE    "PACK: METER READING NEEDED -- read the pack voltage on your meter NOW, once, and remember it. Send it to the agent in chat after the run. Type nothing here.", 0
sPkSayNoMeter   BYTE    "PACK: no meter reading is needed this run.", 0
sPkSayStep2     BYTE    "PACK STEP 2 OF 5 -- UNPLUG the sensor Powerpole at the PACK now, within 60 seconds. Leave it out until this terminal says plug it back in.", 0
sPkSayStep3     BYTE    "PACK STEP 3 OF 5 -- PLUG the sensor Powerpole back in now, within 60 seconds.", 0
sPkSayStep4     BYTE    "PACK STEP 4 OF 5 -- UNPLUG the sensor Powerpole at the PACK again, within 60 seconds. Leave it out until this terminal says plug it back in.", 0
sPkSayStep5     BYTE    "PACK STEP 5 OF 5 -- PLUG the sensor Powerpole back in now, within 60 seconds.", 0
sPkSayOutOk     BYTE    "PACK: unplug seen -- the driver reads ABSENT, no voltage. Counted.", 0
sPkSayOutBad    BYTE    "PACK: unplug seen, but the driver did not settle on ABSENT with no voltage. Counted as a FAIL.", 0
sPkSayOutNone   BYTE    "PACK: NO UNPLUG SEEN in 60 seconds -- the driver still reads a voltage. Counted as a FAIL. If you did unplug it, plug it back in now. Nothing more runs.", 0
sPkSayInOk      BYTE    "PACK: plug-in seen -- the driver reads the same pack voltage as before the unplug. Counted.", 0
sPkSayInBad     BYTE    "PACK: plug-in seen, but the driver does not read the pack voltage it read before the unplug. Counted as a FAIL.", 0
sPkSayInNone    BYTE    "PACK: NO PLUG-IN SEEN in 60 seconds -- the driver reads no pack. Counted as a FAIL. Plug the sensor back in. Nothing more runs.", 0
sPkSayNoPair    BYTE    "PACK: the unplug was not seen, so no meter pair was taken: do not send the meter reading.", 0
sPkSayDone      BYTE    "PACK: DONE. Leave the sensor plugged in. Nothing more to do.", 0

VAR { PACK state -- cog 0 only }

    LONG    bPkStarted                                      ' the steering object was started and read ready
    LONG    pkWhy                                           ' the first cause of the part's unread readings
    ' step 1 (pkSteady())
    LONG    bPkSteadyRan                                    ' the window ran to its end with the pack read PRESENT at its start
    LONG    pkReadN                                         ' readings taken
    LONG    pkPresentN                                      ' ...that read PACK_PRESENT
    LONG    pkMinMv                                         ' their least mV, POSX when none
    LONG    pkMaxMv                                         ' their greatest mV, NEGX when none
    LONG    pkSumMv                                         ' their sum, mV
    LONG    pkUncalSum                                      ' the uncalibrated readings' sum, mV
    LONG    pkSteadyEv                                      ' EV_PACK in the window's drain
    LONG    bPkSteadyClean                                  ' that drain was clean
    LONG    pkGioRaw                                        ' the ADC's GIO reading at start (testGetPackRaw())
    LONG    pkVioRaw                                        ' ...its VIO reading
    ' the pair and the mark (pkPairDue(), bPkCycle())
    LONG    pkPairDue                                       ' PKP_* this run takes
    LONG    pkPairWhy                                       ' why it takes none, WHY_NONE when it takes one
    LONG    bPkMarked                                       ' step 2's unplug was seen, so the mark was kept
    LONG    pkMarkMv                                        ' the mark: step 1's mean mV (pkSteadyMeanMv())
    LONG    pkMarkUncal                                     ' ...uncalibrated
    ' one cycle (bPkCycle())
    LONG    pkRefMv                                         ' the cycle's reference: a reading taken before he was asked to unplug
    LONG    bPkOutSeen                                      ' the unplug was seen within PK_ACT_MS
    LONG    pkOutMs                                         ' ms from its line to it
    LONG    pkOutSt                                         ' the getter's status EV_SETTLE_MS after it
    LONG    pkOutMv                                         ' ...and mV
    LONG    pkOutEvN                                        ' EV_PACK drained after it
    LONG    pkOutEvSum                                      ' ...their values summed
    LONG    bPkInSeen                                       ' the plug-in was seen within PK_ACT_MS
    LONG    pkInMs                                          ' ms from its line to it
    LONG    pkInSt                                          ' the getter's status EV_SETTLE_MS after it
    LONG    pkInMv                                          ' ...and mV
    LONG    pkInEvN                                         ' EV_PACK drained after it
    LONG    pkInEvSum                                       ' ...their values summed
    LONG    bPkCycClean                                     ' both drains were clean
    LONG    pkCycWhy                                        ' why a step was not seen, WHY_NONE when both were
    LONG    bPkCycAbsOk                                     ' its R20-PACK-ABSENT reading held (pkFoldCycle())
    LONG    bPkCycEvOk                                      ' its PACK_UNPLUG_EV reading held
    ' the cells' accumulators (pkResetCells())
    LONG    pkCycN                                          ' cycles judged
    LONG    pkAbsBad                                        ' ...whose unplug did not read absent, or whose replug did not read the pack
    LONG    pkEvBad                                         ' ...whose two EV_PACK were not exactly ABSENT then PRESENT

PRI pkResetCells()
' Clear the PACK part's staging and cell accumulators (initRunState()), so a cell no step reached prints NOMEAS.

    bPkStarted := FALSE
    pkWhy := WHY_NONE
    bPkSteadyRan := FALSE
    pkReadN := 0
    pkPresentN := 0
    pkMinMv := POSX
    pkMaxMv := NEGX
    pkSumMv := 0
    pkUncalSum := 0
    pkSteadyEv := 0
    bPkSteadyClean := FALSE
    pkGioRaw := 0
    pkVioRaw := 0
    pkPairDue := PKP_NONE
    pkPairWhy := WHY_NONE
    bPkMarked := FALSE
    pkMarkMv := 0
    pkMarkUncal := 0
    pkCycN := 0
    pkAbsBad := 0
    pkEvBad := 0

PRI segPack() | cycleIdx
' PACK (part PACK, task 3611, R20.4): with the sensor fitted, one steering lifetime -- step 1's steady window
' (pkSteady()), then PK_CYCLES unplug-and-replug cycles (bPkCycle()), the first carrying the meter pair's mark -- and
' BM-PKMARK; unfitted, nothing but the operator's NOT BUILT line. Both pairs' BM-PKMETER either way when fitted.
'
' @local cycleIdx - 1..PK_CYCLES

    segBegin(SEG_PACK)
    if user.PACK_SENSOR_FITTED == FALSE
        alignSay(@sPkSayNotFit)
        pkWhy := WHY_PACK_NOT_FITTED
    elseif bRunContinue(SEG_PACK) == FALSE
        pkWhy := WHY_ABORTED
    else
        beat(CP_LIB_STEER_START)
        steering.setStartChecks(TRUE)                       ' the library's default, set rather than assumed (task 3621)
        beat(CP_LIB_STEER_START)
        if bSteerStart(SEG_PACK) == FALSE
            pkWhy := WHY_NO_COG
        else
            bPkStarted := TRUE
            pkSteady()
            if bPkSteadyRan == FALSE
                alignSay(@sPkSayNoPack)
            else
                pkPairDue, pkPairWhy := pkPairOwed()
                repeat cycleIdx from 1 to PK_CYCLES
                    if bPkCycle(cycleIdx) == FALSE          ' a step not seen: nothing more runs
                        quit
                if bPkOutSeen and bPkInSeen
                    alignSay(@sPkSayDone)
            emitPkMark()
        if bSteerUp
            steerStop()
    if user.PACK_SENSOR_FITTED
        emitPkMeter(PKP_CAL)
        emitPkMeter(PKP_SECOND)
    segItems := pkCycN
    segEnd(pkWhy)

PRI pkRead() : ePackStatus, nMv, nUncalMv, nPinMv
' One reading, the driver's own: getPackVoltage() and testGetPackRaw(), through the steering object.
'
' @returns ePackStatus - the getter's PACK_*
' @returns nMv - its mV, 0 unless PACK_PRESENT
' @returns nUncalMv - the same average without the calibration, mV, ungated
' @returns nPinMv - the pin's own voltage, one sample, mV

    beat(CP_LIB_STEER_QUERY)
    ePackStatus, nMv := steering.getPackVoltage()
    nPinMv, nUncalMv, pkGioRaw, pkVioRaw := steering.testGetPackRaw()
    beat(CP_LIB_STEER_QUERY)

PRI pkSteady() | startMs, nextMs, readIdx, ePackStatus, nMv, nUncalMv, nPinMv, bPresentAtStart
' Step 1: HANDS OFF for PK_STEADY_MS. The start's own events are drained first (printed as BM-EV, not judged), then
' the pack is read every PK_READ_EVERY_MS (BM-PKREAD) and the log drained at the end (BM-PKSTEADY). The window is
' judged only when its first reading was PACK_PRESENT: a sensor reading no pack cannot be held steady.
'
' @local startMs - getms() when the window opened
' @local nextMs - the window's ms of the next reading
' @local readIdx - 1-based reading number
' @local ePackStatus - one reading's status
' @local nMv - its mV
' @local nUncalMv - its uncalibrated mV
' @local nPinMv - the pin's own mV
' @local bPresentAtStart - the first reading was PACK_PRESENT

    alignSay(@sPkSayStep1)
    evDrain(EVSRC_STEER, EVST_PACK)                         ' the start's own events, before the window opens
    bPresentAtStart := FALSE
    readIdx := 0
    nextMs := 0
    startMs := getms()
    repeat
        beat(CP_LOOP_POLL)
        if (getms() - startMs) >= nextMs
            ePackStatus, nMv, nUncalMv, nPinMv := pkRead()
            readIdx++
            if readIdx == 1
                bPresentAtStart := (ePackStatus == wheelL.PACK_PRESENT)
            pkReadN := (pkReadN + 1) <# LIM_TINY
            if ePackStatus == wheelL.PACK_PRESENT
                pkPresentN := (pkPresentN + 1) <# LIM_TINY
                pkMinMv <#= nMv
                pkMaxMv #>= nMv
                pkSumMv += nMv
                pkUncalSum += nUncalMv
            emitPkRead(readIdx, getms() - startMs, ePackStatus, nMv, nUncalMv, nPinMv)
            nextMs += PK_READ_EVERY_MS
        if (getms() - startMs) >= PK_STEADY_MS
            quit
        waitms(SAMPLE_MS)
    evDrain(EVSRC_STEER, EVST_PACK)
    bPkSteadyClean := bEvdClean()
    pkSteadyEv := evCount(EVI_PLAT, wheelL.EV_PACK)
    bPkSteadyRan := bPresentAtStart
    if bPresentAtStart == FALSE
        pkWhy := WHY_NO_PACK
    emitPkSteady()

PRI pkPairOwed() : ePair, whyCode | nMeanMv
' The meter pair this run takes (this part's CON): pair 1 while the calibration is unset; then pair 2, once pair 1 is
' compiled in, when step 1's mean lies at least PK_V2_SEP_MV from pair 1's meter reading; otherwise none.
'
' @returns ePair - PKP_CAL, PKP_SECOND or PKP_NONE
' @returns whyCode - why none, WHY_NONE when one is taken
'
' @local nMeanMv - step 1's mean, mV

    ePair := PKP_NONE
    whyCode := WHY_NONE
    if bPkCalSet() == FALSE
        ePair := PKP_CAL
    elseif PK_METER2_MV <> 0
        whyCode := WHY_NONE                                 ' both pairs are in: nothing is owed
    elseif pkPresentN > 0
        nMeanMv := pkSumMv / pkPresentN
        if abs(nMeanMv - PK_METER1_MV) >= PK_V2_SEP_MV
            ePair := PKP_SECOND
        else
            whyCode := WHY_SAME_PACK_VOLTAGE

PRI bPkCycle(cycleIdx) : bContinue | bClean, ePackStatus, nMv
' One unplug-and-replug cycle, steps 2-3 or 4-5: the reference, the line, the wait for the sensor to see his act, then
' EV_SETTLE_MS on, the getter and the drained log; judged (pkFoldCycle()) and printed (BM-PKCYCLE). Cycle 1 carries the
' meter line (or the line saying none is needed) and keeps the mark once its unplug is seen. A step not seen ends the
' cycle, judged, and ends the cycles.
'
' THE REFERENCE IS TAKEN BEFORE THE UNPLUG LINE IS PRINTED, never from a reading made while the unplug is awaited
' (this part's CON: the driver's average decays over several PRESENT readings after the pull). Cycle 1's, and the mark,
' is step 1's mean; a later cycle's is one reading taken here, before its line, and 0 unless it read PACK_PRESENT (a
' pack not read before the unplug cannot be read again after it, so its replug fails, as it should).
'
' @param cycleIdx - 1..PK_CYCLES
' @returns bContinue - TRUE when both steps were seen
'
' @local bClean - one step's drain was clean
' @local ePackStatus - the reference reading's status (cycles after the first)
' @local nMv - its mV

    bPkOutSeen := bPkInSeen := FALSE
    pkOutMs := pkInMs := 0
    pkOutSt := pkInSt := wheelL.PACK_NOT_FITTED
    pkOutMv := pkInMv := 0
    pkOutEvN := pkOutEvSum := pkInEvN := pkInEvSum := 0
    bPkCycClean := TRUE
    pkCycWhy := WHY_NONE
    if cycleIdx == 1
        pkRefMv, _ := pkSteadyMeanMv()                      ' step 1's window closed before any line below appears
        if pkPairDue == PKP_NONE
            alignSay(@sPkSayNoMeter)
        else
            alignSay(@sPkSayMeter)
        alignSay(@sPkSayStep2)
    else
        ePackStatus, nMv, _, _ := pkRead()                  ' before the line: he has not been asked, so it is the pack
        pkRefMv := (ePackStatus == wheelL.PACK_PRESENT) ? nMv : 0
        alignSay(@sPkSayStep4)
    bPkOutSeen, pkOutMs := pkWaitStatus(FALSE)
    if bPkOutSeen == FALSE
        pkCycWhy := WHY_OPERATOR_TIMEOUT
        alignSay(@sPkSayOutNone)
        if (cycleIdx == 1) and (pkPairDue <> PKP_NONE)
            alignSay(@sPkSayNoPair)
    else
        if cycleIdx == 1
            bPkMarked := TRUE                               ' he acted, so the pair is kept: step 1's mean, not the decaying average
            pkMarkMv, pkMarkUncal := pkSteadyMeanMv()
        pkOutSt, pkOutMv, pkOutEvN, pkOutEvSum, bClean := pkSettleRead()
        bPkCycClean &= bClean
        if (pkOutSt == wheelL.PACK_ABSENT) and (pkOutMv == 0)
            alignSay(@sPkSayOutOk)
        else
            alignSay(@sPkSayOutBad)
        if cycleIdx == 1
            alignSay(@sPkSayStep3)
        else
            alignSay(@sPkSayStep5)
        bPkInSeen, pkInMs := pkWaitStatus(TRUE)
        if bPkInSeen == FALSE
            pkCycWhy := WHY_OPERATOR_TIMEOUT
            alignSay(@sPkSayInNone)
        else
            pkInSt, pkInMv, pkInEvN, pkInEvSum, bClean := pkSettleRead()
            bPkCycClean &= bClean
            if bPkInReadsPack()
                alignSay(@sPkSayInOk)
            else
                alignSay(@sPkSayInBad)
    pkFoldCycle()
    emitPkCycle(cycleIdx)
    bContinue := bPkOutSeen and bPkInSeen

PRI pkWaitStatus(bWantPresent) : bSeen, nWaitMs | startMs, ePackStatus
' Wait, beat-polled every SAMPLE_MS, for the getter to read PACK_PRESENT (bWantPresent) or to stop reading it: his act,
' seen by the sensor, ends the step. At most PK_ACT_MS. No reading taken here is kept: while an unplug is awaited the
' driver's average may already be decaying under a PRESENT status, so none of them is a pre-unplug value (SRC_REV 56;
' bPkCycle() takes the reference before the line).
'
' @param bWantPresent - TRUE to wait for PACK_PRESENT, FALSE to wait for anything else
' @returns bSeen - TRUE when it was seen in time
' @returns nWaitMs - ms from the call to it (to PK_ACT_MS when not seen)
'
' @local startMs - getms() at the call
' @local ePackStatus - one reading's status

    bSeen := FALSE
    ePackStatus, _, _, _ := pkRead()
    startMs := getms()
    repeat
        beat(CP_LOOP_OPER)
        if (ePackStatus == wheelL.PACK_PRESENT) == bWantPresent
            bSeen := TRUE
            quit
        if (getms() - startMs) >= PK_ACT_MS
            quit
        waitms(SAMPLE_MS)
        ePackStatus, _, _, _ := pkRead()
    nWaitMs := (getms() - startMs) <# PK_ACT_MS

PRI pkSteadyMeanMv() : nMeanMv, nUncalMeanMv
' Step 1's mean over its PRESENT readings (BM-PKSTEADY's mean_mV and uncal_mV): cycle 1's reference and the mark. Its
' window closes before the unplug line is printed, so no reading in it can include the unplug.
'
' @returns nMeanMv - the mean of the getter's mV, 0 when no reading was PRESENT
' @returns nUncalMeanMv - the mean of the uncalibrated mV, 0 likewise

    nMeanMv := nUncalMeanMv := 0
    if pkPresentN > 0
        nMeanMv := pkSumMv / pkPresentN
        nUncalMeanMv := pkUncalSum / pkPresentN

PRI pkSettleRead() : ePackStatus, nMv, nEvN, nEvSum, bClean
' EV_SETTLE_MS after a step was seen: the getter, then the log drained. EV_PACK is queued on the event check within
' EV_CHECK_MS of the change, and no sooner than EV_RATE_GAP_MS after the last, so the wait holds it.
'
' @returns ePackStatus - the getter's status
' @returns nMv - its mV
' @returns nEvN - EV_PACK in the drain
' @returns nEvSum - their values summed (PACK_ABSENT 1, PACK_PRESENT 2 each)
' @returns bClean - the drain was clean

    waitBeat(EV_SETTLE_MS, CP_LOOP_REST)
    beat(CP_LIB_STEER_QUERY)
    ePackStatus, nMv := steering.getPackVoltage()
    beat(CP_LIB_STEER_QUERY)
    evDrain(EVSRC_STEER, EVST_PACK)
    nEvN := evCount(EVI_PLAT, wheelL.EV_PACK)
    nEvSum := evSum(EVI_PLAT, wheelL.EV_PACK)
    bClean := bEvdClean()

PRI bPkInReadsPack() : bReads
' Whether the replugged sensor reads the pack again: PACK_PRESENT, a voltage, and within PK_REPLUG_MV of this cycle's
' reference, taken before he was asked to unplug (bPkCycle()) -- the ABSENT cell's control, so a getter stuck at
' ABSENT, or one that comes back at another voltage, fails it.
'
' @returns bReads - TRUE when it does

    bReads := (pkInSt == wheelL.PACK_PRESENT) and (pkInMv > 0) and (abs(pkInMv - pkRefMv) <= PK_REPLUG_MV)

PRI pkFoldCycle()
' Judge one cycle into R20-PACK-ABSENT and R20-PACK-EV's PACK_UNPLUG_EV (bPkCycAbsOk, bPkCycEvOk, printed by
' BM-PKCYCLE): counted whenever it ran, since an unplug never seen is the D2 failure (this part's CON).
'  ABSENT: bad unless the unplug was seen and read PACK_ABSENT with 0 mV, and the replug was seen and read the pack
'   again (bPkInReadsPack()).
'  EV: bad unless both were seen, both drains were clean, and each held exactly one EV_PACK, valued PACK_ABSENT after
'   the unplug and PACK_PRESENT after the replug.

    bPkCycAbsOk := bPkOutSeen and (pkOutSt == wheelL.PACK_ABSENT) and (pkOutMv == 0) and bPkInSeen and bPkInReadsPack()
    bPkCycEvOk := bPkOutSeen and bPkInSeen and bPkCycClean
    bPkCycEvOk &= (pkOutEvN == 1) and (pkOutEvSum == wheelL.PACK_ABSENT) and (pkInEvN == 1) and (pkInEvSum == wheelL.PACK_PRESENT)
    pkCycN := (pkCycN + 1) <# LIM_SMALL
    if bPkCycAbsOk == FALSE
        pkAbsBad := (pkAbsBad + 1) <# LIM_SMALL
    if bPkCycEvOk == FALSE
        pkEvBad := (pkEvBad + 1) <# LIM_SMALL

PRI pkPairNums(ePair) : nMeterMv, nUncalMv
' A compiled pair's two numbers (this part's CON).
'
' @param ePair - PKP_CAL or PKP_SECOND
' @returns nMeterMv - the meter's mV, 0 while owed
' @returns nUncalMv - the P2's uncalibrated mV of the same moment, 0 while owed

    nMeterMv := nUncalMv := 0
    if ePair == PKP_CAL
        nMeterMv := PK_METER1_MV
        nUncalMv := PK_UNCAL1_MV
    elseif ePair == PKP_SECOND
        nMeterMv := PK_METER2_MV
        nUncalMv := PK_UNCAL2_MV

PRI bPkCalSet() : bSet
' Whether the one-time calibration is done: pair 1 (the meter reading and the P2's uncalibrated reading of that moment)
' is compiled in. Read from the pair, never from PACK_SENSE_CAL_PERMILLE's value, which carries the calibration only.
'
' @returns bSet - T/F where T means pair 1 is compiled in

    bSet := (PK_METER1_MV > 0) and (PK_UNCAL1_MV > 0)

PRI pkPairJudged(ePair) : bJudged, nDiffMv, nCalcMv, whyCode | nMeterMv, nUncalMv
' Whether a compiled pair can be judged, and its verdict's number: |uncal x CAL / 1000 - meter|. Pair 1 needs the
' calibration set and its numbers in; pair 2 needs pair 1 as well, and its meter reading at least PK_V2_SEP_MV from
' pair 1's.
'
' @param ePair - PKP_CAL or PKP_SECOND
' @returns bJudged - TRUE when it can be judged
' @returns nDiffMv - the calibrated reading's distance from the meter, mV (0 when not judged)
' @returns nCalcMv - the calibrated reading, uncal x CAL / 1000, mV (0 when not judged)
' @returns whyCode - why not, WHY_NONE when judged
'
' @local nMeterMv - the pair's meter reading, mV
' @local nUncalMv - its uncalibrated reading, mV

    bJudged := FALSE
    nDiffMv := nCalcMv := 0
    nMeterMv, nUncalMv := pkPairNums(ePair)
    if bPkCalSet() == FALSE
        whyCode := WHY_NOT_CALIBRATED
    elseif (nMeterMv <= 0) or (nUncalMv <= 0)
        whyCode := WHY_NO_METER_READING
    elseif (ePair == PKP_SECOND) and (abs(PK_METER2_MV - PK_METER1_MV) < PK_V2_SEP_MV)
        whyCode := WHY_SAME_PACK_VOLTAGE
    else
        whyCode := WHY_NONE
        bJudged := TRUE
        nCalcMv := (nUncalMv * user.PACK_SENSE_CAL_PERMILLE) / PK_PERMILLE
        nDiffMv := abs(nCalcMv - nMeterMv)

PRI emitPkBuild()
' BM-PKBUILD: the PACK part's compiled numbers, printed before anything is read -- the sensor as configured (fitted,
' pin, the calibration and whether it is set: pair 1 compiled in, bPkCalSet(), the absent threshold, the divider), the
' driver's own winding-check reading (its reads and their gap), and the part's bounds. Worst case 244 bytes.

    recBegin(@"BM-PKBUILD")
    benchLog.boolField(@"fitted", user.PACK_SENSOR_FITTED)
    benchLog.numField(@"pin", user.PACK_SENSE_PIN, LIM_TINY)
    benchLog.numField(@"cal_pm", user.PACK_SENSE_CAL_PERMILLE, LIM_SMALL)
    benchLog.boolField(@"calibrated", bPkCalSet())
    benchLog.numField(@"absent_mV", wheelL.PACK_ABSENT_MV, LIM_SMALL)
    benchLog.numField(@"div_x100", wheelL.PACK_DIVIDER_X100, LIM_TINY)
    benchLog.numField(@"steady_ms", PK_STEADY_MS, LIM_SMALL)
    benchLog.numField(@"read_ms", PK_READ_EVERY_MS, LIM_SMALL)
    benchLog.numField(@"cycles", PK_CYCLES, LIM_TINY)
    benchLog.numField(@"act_ms", PK_ACT_MS, LIM_SMALL)
    benchLog.numField(@"agree_mV", PK_AGREE_MV, LIM_TINY)
    benchLog.numField(@"sep_mV", PK_V2_SEP_MV, LIM_SMALL)
    benchLog.numField(@"replug_mV", PK_REPLUG_MV, LIM_TINY)
    benchLog.numField(@"chk_reads", wheelL.PACK_CHECK_READS, LIM_TINY)
    benchLog.numField(@"chk_gap_ms", wheelL.PACK_CHECK_GAP_MS, LIM_TINY)
    emitRecord()

PRI emitPkRead(readIdx, tMs, ePackStatus, nMv, nUncalMv, nPinMv)
' BM-PKREAD: one step-1 reading -- the getter's status and mV (0 unless PRESENT), the same average without the
' calibration (uncal_mV: what PACK_SENSE_CAL_PERMILLE divides a meter reading by), and the pin's own mV, one sample,
' before the divider. Worst case 107 bytes.
'
' @param readIdx - 1-based reading number
' @param tMs - ms into the window
' @param ePackStatus - the getter's PACK_*
' @param nMv - its mV
' @param nUncalMv - the uncalibrated mV
' @param nPinMv - the pin's own mV

    recBegin(@"BM-PKREAD")
    benchLog.numField(@"n", readIdx, LIM_TINY)
    benchLog.numField(@"t_ms", tMs, LIM_MID)
    benchLog.tokenField(@"pack", tokenAt(@tokPack, PACK_TOK_COUNT, ePackStatus), TOKMAX_PACK)
    benchLog.numField(@"mV", nMv, LIM_SMALL)
    benchLog.numField(@"uncal_mV", nUncalMv, LIM_SMALL)
    benchLog.numField(@"pin_mV", nPinMv, LIM_SMALL)
    emitRecord()

PRI emitPkSteady() | bAny
' BM-PKSTEADY: step 1 over its whole window -- whether it was judged (ran: the pack read PRESENT at its start), its
' readings and those PRESENT, the PRESENT readings' least, greatest, spread and mean (and the uncalibrated mean), the
' EV_PACK its drain held and whether the drain was clean, and the ADC's GIO and VIO readings at start. The spread
' bounds how far a meter reading taken any moment in the window can lie from the mark. Worst case 222 bytes.
'
' @local bAny - a PRESENT reading was taken

    bAny := pkPresentN > 0
    recBegin(@"BM-PKSTEADY")
    benchLog.boolField(@"ran", bPkSteadyRan)
    benchLog.numField(@"reads", pkReadN, LIM_TINY)
    benchLog.numField(@"present", pkPresentN, LIM_TINY)
    benchLog.naNumField(@"min_mV", pkMinMv, LIM_SMALL, bAny)
    benchLog.naNumField(@"max_mV", pkMaxMv, LIM_SMALL, bAny)
    benchLog.naNumField(@"spread_mV", pkMaxMv - pkMinMv, LIM_SMALL, bAny)
    if bAny
        benchLog.numField(@"mean_mV", pkSumMv / pkPresentN, LIM_SMALL)
        benchLog.numField(@"uncal_mV", pkUncalSum / pkPresentN, LIM_SMALL)
    else
        benchLog.textField(@"mean_mV", @sSfNa)
        benchLog.textField(@"uncal_mV", @sSfNa)
    benchLog.numField(@"ev_pack", pkSteadyEv, LIM_TINY)
    benchLog.boolField(@"clean", bPkSteadyClean)
    benchLog.numField(@"gio", pkGioRaw, LIM_BIG)
    benchLog.numField(@"vio", pkVioRaw, LIM_BIG)
    whyField(pkWhy)
    emitRecord()

PRI emitPkCycle(cycleIdx)
' BM-PKCYCLE: one unplug-and-replug cycle -- its reference, taken before the unplug line (ref_mV: step 1's mean in
' cycle 1, a reading just before the line after); per step (o_ the unplug, i_
' the replug) whether it was seen, ms from its line, the getter's status and mV EV_SETTLE_MS on, and the EV_PACK the
' drain held (count and summed value); whether both drains were clean, and the two cells' readings of it. Worst case
' 263 bytes.
'
' @param cycleIdx - 1..PK_CYCLES

    recBegin(@"BM-PKCYCLE")
    benchLog.numField(@"cycle", cycleIdx, LIM_TINY)
    benchLog.numField(@"ref_mV", pkRefMv, LIM_SMALL)
    benchLog.boolField(@"o_seen", bPkOutSeen)
    benchLog.numField(@"o_ms", pkOutMs, LIM_SMALL)
    pkStepFields(@"o_st", @"o_mV", @"o_ev", @"o_val", bPkOutSeen, pkOutSt, pkOutMv, pkOutEvN, pkOutEvSum)
    benchLog.boolField(@"i_seen", bPkInSeen)
    benchLog.naNumField(@"i_ms", pkInMs, LIM_SMALL, bPkOutSeen)
    pkStepFields(@"i_st", @"i_mV", @"i_ev", @"i_val", bPkInSeen, pkInSt, pkInMv, pkInEvN, pkInEvSum)
    benchLog.boolField(@"clean", bPkCycClean)
    benchLog.boolField(@"abs_ok", bPkCycAbsOk)
    benchLog.boolField(@"ev_ok", bPkCycEvOk)
    whyField(pkCycWhy)
    emitRecord()

PRI pkStepFields(pStName, pMvName, pEvName, pValName, bSeen, ePackStatus, nMv, nEvN, nEvSum)
' BM-PKCYCLE's four fields for one step, each NA when the step was not seen. Worst case 50 bytes.
'
' @param pStName - the status field's name
' @param pMvName - the mV field's name
' @param pEvName - the EV_PACK count field's name
' @param pValName - the summed value field's name
' @param bSeen - the step was seen
' @param ePackStatus - the getter's PACK_* after it
' @param nMv - its mV
' @param nEvN - EV_PACK drained
' @param nEvSum - their values summed

    if bSeen
        benchLog.tokenField(pStName, tokenAt(@tokPack, PACK_TOK_COUNT, ePackStatus), TOKMAX_PACK)
    else
        benchLog.textField(pStName, @sSfNa)
    benchLog.naNumField(pMvName, nMv, LIM_SMALL, bSeen)
    benchLog.naNumField(pEvName, nEvN, LIM_TINY, bSeen)
    benchLog.naNumField(pValName, nEvSum, LIM_TINY, bSeen)

PRI emitPkMark()
' BM-PKMARK: the P2's half of this run's meter pair -- which pair was owed (NONE when none: why says why), whether the
' meter was asked for, whether the mark was kept (step 2's unplug seen), the mark's calibrated and uncalibrated mV
' (step 1's means, SRC_REV 56),
' the calibration in force, step 1's spread, and the rule the agent sets PACK_SENSE_CAL_PERMILLE by from the meter
' reading he sends. Worst case 173 bytes.

    recBegin(@"BM-PKMARK")
    benchLog.tokenField(@"pair", tokenAt(@tokPkPair, PKP_COUNT, pkPairDue), TOKMAX_PKPAIR)
    benchLog.boolField(@"asked", pkPairDue <> PKP_NONE)
    benchLog.boolField(@"marked", bPkMarked)
    benchLog.naNumField(@"mark_mV", pkMarkMv, LIM_SMALL, bPkMarked)
    benchLog.naNumField(@"uncal_mV", pkMarkUncal, LIM_SMALL, bPkMarked)
    benchLog.numField(@"cal_pm", user.PACK_SENSE_CAL_PERMILLE, LIM_SMALL)
    benchLog.naNumField(@"spread_mV", pkMaxMv - pkMinMv, LIM_SMALL, pkPresentN > 0)
    benchLog.tokenField(@"rule", @sPkRule, TOKMAX_PKRULE)
    whyField(pkPairWhy)
    emitRecord()

PRI emitPkMeter(ePair) | bJudged, nDiffMv, nCalcMv, whyCode, nMeterMv, nUncalMv
' BM-PKMETER: one compiled meter pair -- its two numbers, the calibration, the calibrated reading and its distance
' from the meter, the separation from pair 1 (pair 2's), and why it is not judged. Worst case 156 bytes.
'
' @param ePair - PKP_CAL or PKP_SECOND
'
' @local bJudged - it can be judged
' @local nDiffMv - |calibrated - meter|, mV
' @local nCalcMv - the calibrated reading, mV
' @local whyCode - why not judged
' @local nMeterMv - the pair's meter reading, mV
' @local nUncalMv - its uncalibrated reading, mV

    bJudged, nDiffMv, nCalcMv, whyCode := pkPairJudged(ePair)
    nMeterMv, nUncalMv := pkPairNums(ePair)
    recBegin(@"BM-PKMETER")
    benchLog.tokenField(@"pair", tokenAt(@tokPkPair, PKP_COUNT, ePair), TOKMAX_PKPAIR)
    benchLog.numField(@"meter_mV", nMeterMv, LIM_SMALL)
    benchLog.numField(@"uncal_mV", nUncalMv, LIM_SMALL)
    benchLog.numField(@"cal_pm", user.PACK_SENSE_CAL_PERMILLE, LIM_SMALL)
    benchLog.naNumField(@"calc_mV", nCalcMv, LIM_SMALL, bJudged)
    benchLog.naNumField(@"diff_mV", nDiffMv, LIM_SMALL, bJudged)
    benchLog.numField(@"sep_mV", abs(PK_METER2_MV - PK_METER1_MV), LIM_SMALL)
    whyField(whyCode)
    emitRecord()

PRI emitPackCells() | bJudged, nDiffMv
' The PACK part's judged cells. Unfitted, every one NOT_BUILT (its BM-NOTBUILT, why PACK_NOT_FITTED, is in the
' header). Fitted, each NOMEAS when nothing measured it:
'
'  METER  - R20-PACK-METER, MV, twice: CAL_POINT_MV (pair 1) and SECOND_POINT_MV (pair 2), |uncal x CAL / 1000 -
'           meter| of the compiled pair, passing at 0 .. PK_AGREE_MV; NOMEAS until calibrated and the pair is in, and
'           pair 2 until it lies PK_V2_SEP_MV from pair 1 (BM-PKMETER says why)
'  ABSENT - R20-PACK-ABSENT, COUNT: cycles whose unplug did not read PACK_ABSENT with 0 mV (or was never seen), or whose
'           replug did not read the same pack again; NOMEAS when no cycle ran
'  EV     - R20-PACK-EV, COUNT, twice: PACK_STEADY_NO_EV, step 1's EV_PACK plus its readings not PRESENT plus 1 for an
'           unclean drain, NOMEAS unless the pack read PRESENT at its start; PACK_UNPLUG_EV, cycles whose two EV_PACK
'           were not exactly ABSENT then PRESENT on clean drains (or a step never seen); NOMEAS when no cycle ran
'
' @local bJudged - a pair can be judged
' @local nDiffMv - its distance from the meter, mV

    if user.PACK_SENSOR_FITTED == FALSE
        emitSignoffNotBuilt(@sSfCellPkMeter, SIDE_NONE, @sSfCritPkCal)
        emitSignoffNotBuilt(@sSfCellPkMeter, SIDE_NONE, @sSfCritPkSecond)
        emitSignoffNotBuilt(@sSfCellPkAbsent, SIDE_NONE, @sSfCritPkAbsent)
        emitSignoffNotBuilt(@sSfCellPackEv, SIDE_NONE, @sSfCritPackQ)
        emitSignoffNotBuilt(@sSfCellPackEv, SIDE_NONE, @sSfCritPackEv)
    else
        bJudged, nDiffMv, _, _ := pkPairJudged(PKP_CAL)
        emitSignoff(@sSfCellPkMeter, SIDE_NONE, @sSfCritPkCal, bJudged, nDiffMv, 0, PK_AGREE_MV, SIGNOFF_ONE_INSTANCE, @sSfUnitsMv)
        bJudged, nDiffMv, _, _ := pkPairJudged(PKP_SECOND)
        emitSignoff(@sSfCellPkMeter, SIDE_NONE, @sSfCritPkSecond, bJudged, nDiffMv, 0, PK_AGREE_MV, SIGNOFF_ONE_INSTANCE, @sSfUnitsMv)
        emitSignoff(@sSfCellPkAbsent, SIDE_NONE, @sSfCritPkAbsent, pkCycN > 0, pkAbsBad, R20_BAD_LO, R20_BAD_HI, pkCycN, @sSfUnitsCount)
        emitSignoff(@sSfCellPackEv, SIDE_NONE, @sSfCritPackQ, bPkSteadyRan, pkSteadyEv + (pkReadN - pkPresentN) + (bPkSteadyClean ? 0 : 1), R20_BAD_LO, R20_BAD_HI, pkReadN, @sSfUnitsCount)
        emitSignoff(@sSfCellPackEv, SIDE_NONE, @sSfCritPackEv, pkCycN > 0, pkEvBad, R20_BAD_LO, R20_BAD_HI, pkCycN, @sSfUnitsCount)

#endif

CON { --- SPIN: the spin-in-place floor tier, loaded and attended (task 3591, R18.2c tail, R19.8) --- }

  ' WHAT THIS PART IS FOR. The release's only LOADED measurement: attended, wheels down, the platform on the floor and
  '  free to turn (R20: nothing is attached to it). SRC_REV 62: it runs the FIVE FLOOR SITUATIONS Stephen chose (2026-09-27) -- OBSTACLE STOP, GRAB ONE SIDE,
  '  INCLINE, FAULT RETURN RUN, then these SPIN legs -- under his floor rules: only distance-controlled drives; a
  '  straight run at most 1 m out and 1 m back to its start; the incline at most 1 m up and 1 m down, with stops;
  '  spinning in place allowed. The four new ones are the section "the floor situations" below.
  '  SRC_REV 69 (Stephen 2026-09-30): THE IMAGE RUNS ONE ACTION, ONCE (-D FLOOR_ACT_*, the part chain's FLA_*), with no
  '  window: after the LEAD_IN_MS lead-in the platform does that one thing, prints its records, and prints one plain
  '  RESULT line last. A repeat is a rerun of the command, never a loop inside it (R4), and INCLINE is postponed. The
  '  SPIN legs' jobs (task 3591; archive/BENCH-READINESS-SPRINT-PLAN.md R19.8):
  '   1. confirm the commutation offsets under load: the confirmed pair (the shipped lead schedule, Visits 8 and 8b)
  '      against the legacy pair, the control that unloaded drew 15-26x the current and ~2x in one direction (Visit
  '      7b), and against today's fixed pair at the quarter, where the schedule moved the lead from 18 to 5 degrees;
  '   2. hold or falsify R18.3's loaded expectations (DOCs/plans/DRIVE-INTEGRATION-DESIGN.md 5.5, 5.6 item 2): A-1 and
  '      A-2 at the quarter's START, A-3 at rungs 1 and 2, A-4 at every confirmed-pair leg, A-8's following case.
  '  SRC_REV 62: X-5 under load (R19.2, PL-117) and PL-93's drive after a fault moved to the FAULT RETURN RUN, which
  '  judges both on a straight run, so the two FAULT legs and their re-drives are gone: ten legs, five pairs.
  '
  ' THE SAFETY ENVELOPE IS THE DESIGN (doctrine overlay P1; the runner's PRECONDITION says it again):
  '  - SRC_REV 69: nothing moves before the lead-in (LEAD_IN_MS) ends, and the steering object is not even started before
  '    it. There is no STOP on a screen and no window: a stop in the middle of a run is Stephen's own and physical -- he
  '    lifts the wheels and disconnects the battery (R13, 2026-09-29: "at the very least i lift the wheels and disconned
  '    the battery"). What stops a leg in the program is the harness: the 10 A abort, the travel guard and the bounds.
  '  - Every leg's travel limit is ARMED BEFORE IT IS DRIVEN: stopAfterDistance(SPIN_LEG_MM) resets the tracking and
  '    arms the steering front cog's platform limit as one request, and a leg whose limit is refused is never driven.
  '    The limit stops BOTH wheels at rest when EITHER has travelled the leg's ticks (spinLegTicks[speed]), each wheel's
  '    stop beginning early by its own stopping distance: the front cog's frontStopTicks() arithmetic that
  '    R16-DUAL-STOPLIM-B certifies.
  '  - The limit is ONE REVOLUTION of the platform for SLOW and MEDIUM, TWO for the quarter (SRC_REV 74, below). Spinning in
  '    place, each tyre rolls on a circle whose diameter is the track, TRACK_MM, so a revolution moves each tyre pi x 387 mm
  '    = 1_215.8 mm = 211.07 hall ticks at the 6.5in hub's 5.76 mm a tick. SPIN_LEG_TICKS is the whole ticks under it, 211
  '    (359.9 degrees); SPIN_FAST_LEG_TICKS, the quarter's, 422 (719.8 degrees).
  '  - Every leg ENDS at its limit, so every leg is also a live test of the limit (R19-DUAL-SPINSTOP-P). The harness
  '    watches both wheels on the instrument's mirror and e-stops a leg one electrical cycle past the limit
  '    (SPIN_OVERTRAVEL_TICKS); a leg still moving at SPIN_LEG_MS is stopped.
  '  - WHY THE QUARTER TURNS TWICE (SRC_REV 74, PL-168, PL-160's quarter-speed start; R20: the platform is not tied to
  '    anything, so a leg is no longer held to one turn). The quarter's START cells (SPINSTRT, SPINPEAK) read a steady
  '    reference A2_REF_DELAY_MS + A2_TAIL_SAMPLES x 2 ms (420 + 62 ms) after the first AT_SPEED sample, and the leg must still
  '    be AT_SPEED at its end (every sample from the first to the reference's end), so the leg must HOLD the quarter for 482
  '    ms; its steady window follows SPIN_SETTLE_MS after AT_SPEED. A ONE-turn quarter leg's whole travel was 211 ticks, of
  '    which the spin-up took 40.1 and the stop 31.2 + 1: (211 - 40.1 - 31.2 - 1) / 98.2 = 1.4 s at speed at 98.2 ticks
  '    a second, so the window had to be cut to 300 ms (SRC_REV 60) and nothing was left over for a leg that took longer to
  '    reach AT_SPEED (2026-09-30: leg 8 got no window). Two turns, 422 ticks, hold (422 - 40.1 - 31.2 - 1) / 98.2 = 3.6 s
  '    unloaded: the 1_000 ms settle (it holds the 482 ms reference) and the 500 ms window take 1.5 s of it, 2.1 s to spare.
  '    SLOW and MEDIUM hold their one turn as before (their windows are 2_000 and 1_000 ms).
  '  - Each leg is a run of its own (SRC_REV 69: a pair's two legs were one lifetime); a pair's RIGHT and LEFT legs turn
  '    the same number of turns opposite ways, so a pair leaves the platform facing where it began.
  '  - A fault on either wheel stops the other along its ramp (R19.2); the 10 A abort stops both at once; a leg that does
  '    not end at its limit prints its cause (BM-SPIN stop_by and why) and ends the run.
  '  - The speeds are the ladder's rungs 1 and 2 and the quarter: at most 36.7 x 10^6, 22 % of the ceiling, about 170
  '    degrees a second of platform rotation. Nothing here nears the top speed, so E5's margin is not judged here.
  '  - The panic procedure is the battery disconnect.
  '
  ' WHY THE STEERING OBJECT AND ITS PUBLIC CALLS. driveAtPower(+p, -p) is the call a user makes to spin a platform, and
  '  the path it takes -- the front cog's synchronized release, its distance stop, its path limiter and its platform
  '  fault policy -- is what a floor run exists to load. Speeds are POWERS through its map, not raw increments: 7, 13
  '  and 23 command 10.09, 20.09 and 36.74 x 10^6 (100_000 + 1_665_656 x (power - 1) at 18.5 V).
  '
  ' DIRECTIONS. RIGHT is clockwise seen from above: driveAtPower(+p, -p), the left wheel forward and the right back.
  '  The steering object reverses the right wheel (STEER_RIGHT_RAW_SIGN), so BOTH motors then run POSITIVE increments
  '  (offset_rev in both drivers), and in a LEFT leg both run negative. A pair of legs is therefore each motor once in
  '  each direction: the loaded current by direction. The direction each wheel RAN is measured from its raw travel and
  '  judged against the one commanded (R19-DUAL-SPINDIR-P).
  '
  ' WHAT A LEG READS, from one capture at decimation 1, frozen right after the leg's window so no leg outruns the ring
  '  (the mirror the guard and the waits read stays live while FROZEN): the START from the mark before the command to
  '  the first AT_SPEED sample (A-1, A-2: the quarter's confirmed-pair legs); then, SPIN_SETTLE_MS after AT_SPEED, with
  '  the rpm window refilled with steady running, a steady window per wheel -- sense_i, duty, err, the rate, and
  '  getCurrent() net of the rest zero every CURRENT_POLL_MS -- and at its end both following readings (A-8), the path
  '  limiter's scale and the pair each driver applied. The ring window is two instrument totals read with no new mark,
  '  so the START's mark stays where the trace needs it (floorRun()'s endTotal is the precedent).
    TRACK_MM              = 387                             ' STEPHEN 2026-09-19: 15.25 in, tyre centre to tyre centre
    SPIN_PI_NUM           = 355                             ' pi as 355 / 113, within 0.3 ppm
    SPIN_PI_DEN           = 113
    SPIN_X100             = 100
    SPIN_PM               = 1_000
    ' 0.01 mm of tyre travel per hall tick: pi x 165.1 mm / 90 ticks, the steering object's own figure (testGetTickInMM()).
    '  Every lifetime reads it back, and a lifetime reading any other value drives no leg (WHY_TICK_SIZE_DIFFERS).
    TICK_MM_X100          = 576
    SPIN_LEG_DEG          = 360                             ' THE TRAVEL LIMIT of SLOW and MEDIUM: one revolution of the platform per leg
    SPIN_FAST_LEG_DEG     = 720                             ' ...and the quarter's (SRC_REV 74, PL-168): two revolutions (the CON says why)
    SPIN_REV_MM_X100      = (TRACK_MM * SPIN_PI_NUM * SPIN_X100) / SPIN_PI_DEN                    ' 121_579: pi x 387 mm
    SPIN_LEG_TICKS        = (SPIN_REV_MM_X100 * SPIN_LEG_DEG) / (DEGREES_IN_TURN * TICK_MM_X100)  ' 211
    SPIN_FAST_LEG_TICKS   = (SPIN_REV_MM_X100 * SPIN_FAST_LEG_DEG) / (DEGREES_IN_TURN * TICK_MM_X100)  ' 422
    ' stopAfterDistance()'s argument, rounded UP so the steering object's own conversion (mm x 100 / 576, truncated)
    '  lands back on exactly the leg's ticks: 1_216 mm -> 211.1 -> 211; the quarter's 2_431 mm -> 422.05 -> 422. BM-SPINBUILD
    '  prints the round trips (tick_back, f_back).
    SPIN_LEG_MM           = ((SPIN_LEG_TICKS * TICK_MM_X100) + SPIN_X100 - 1) / SPIN_X100
    SPIN_FAST_LEG_MM      = ((SPIN_FAST_LEG_TICKS * TICK_MM_X100) + SPIN_X100 - 1) / SPIN_X100
    SPIN_OVERTRAVEL_TICKS = wheelL.HALL_TICKS_PER_CYCLE     ' 6: one electrical cycle, 35 mm, ~10 degrees of platform
    SPIN_STOP_TOL_TICKS   = STOP_LIMIT_HI                   ' 3: the distance stop's promise, at rest within about two ticks, and
                                                            '  one more short of it for DRIVER_REV 39's plan (STOP_LIMIT_EARLY)
    SPIN_DIR_MIN_TICKS    = wheelL.HALL_TICKS_PER_CYCLE     ' a leg that moved less than this is not judged for its direction
    SPIN_LEGS             = 10                              ' the leg table's rows: five pairs, RIGHT then LEFT (SRC_REV 62: the
                                                            '  fault pair moved to FAULTRUN). SRC_REV 69: no loop walks them; each
                                                            '  SPIN action is one row, named by its pair and direction
    SPIN_PAIRS            = SPIN_LEGS / 2

  ' SPIN_SPEED_*: a leg's speed class; its power, window and scheduled lead are spinPower, spinWinMs and spinSchedLead
    #0, SPIN_SPEED_SLOW, SPIN_SPEED_MED, SPIN_SPEED_BRISK
    SPIN_SPEEDS           = SPIN_SPEED_BRISK + 1
    TOKMAX_SPSPEED        = 6
  ' SPIN_DIR_*: RIGHT, clockwise from above (both motors positive), then LEFT (both negative); a pair's first leg is
  '  RIGHT. The order is load-bearing: gen_dual_assets.py's NXT_ / SPN_ state words are indexed by it
    #0, SPIN_DIR_RIGHT, SPIN_DIR_LEFT
    SPIN_DIRS             = SPIN_DIR_LEFT + 1
    TOKMAX_SPDIR          = 5
  ' SPOFF_*: the commutation pair a pair of legs runs
  '  SPOFF_SCHED  - the confirmed offsets: the shipped lead schedule (Z -4, L from the Visit 8 / 8b table), untouched
  '  SPOFF_LEGACY - the default pair in R18.2c's own words, 43 / 317 (Z 0, L 43; today's HUB_OFFSETS_LEGACY build),
  '                 written live: the CONTROL, expected to cost clearly more current and to split by direction
  '  SPOFF_FIXED  - today's fixed pair, 14 / 338 (Z -4, L 18), written live: what the schedule replaced at the quarter
    #0, SPOFF_SCHED, SPOFF_LEGACY, SPOFF_FIXED
    SPOFF_COUNT           = SPOFF_FIXED + 1
    TOKMAX_SPOFF          = 6
    SPIN_LEGACY_NEG       = 43                              ' the legacy pair, MIRRORED ON PURPOSE (this build compiles the
    SPIN_LEGACY_POS       = 317                             '  shipped one): offset_fwd, then offset_rev
  ' The pairs by role: rows of spinPairOffs / spinPairSpeed, run in this order, slowest first. SRC_REV 62: the FAULT
  '  pair (SLOW, one wheel forced to fault on each leg, X-5 and PL-93) is gone -- FAULTRUN judges both on a straight run
    SPIN_PAIR_SLOW        = 0                               ' SCHED, SLOW: A-3 rung 1, A-4
    SPIN_PAIR_MED         = 1                               ' SCHED, MEDIUM: A-3 rung 2, A-4, A-8, SPINSYM
    SPIN_PAIR_LEGACY      = 2                               ' LEGACY, MEDIUM: SPINCTL's control, beside the pair it controls
    SPIN_PAIR_BRISK       = 3                               ' SCHED, BRISK: A-1, A-2, A-4, A-8, SPINLEAD's numerator
    SPIN_PAIR_FIXED       = 4                               ' FIXED, BRISK: SPINLEAD's denominator
  ' SRC_REV 69: the one leg a SPIN action runs (FLOOR_ACT, the part chain's FLA_SPIN_*): its pair and direction are the
  '  action's offset from FLA_SPIN_SLOW_RIGHT -- the kind (/ 2) indexes spinActPair, the direction (// 2) is SPIN_DIR_*.
  '  "slow", "med" and "fast" are the SCHED pairs SPIN_PAIR_SLOW, SPIN_PAIR_MED and SPIN_PAIR_BRISK (the quarter); LEGACY and
  '  FIXED are the control pairs SPIN_PAIR_LEGACY and SPIN_PAIR_FIXED. The cells that compare pairs (SPINSYM, SPINCTL,
  '  SPINLEAD) need the legs of several runs, so one SINGLE-LEG run prints NOMEAS for them with why JUDGED_ACROSS_RUNS
  '  (BM-XRUN); the floor-auto SESSION holds the legs and judges them itself, and a NOMEAS there names the leg that did not
  '  measure (SRC_REV 74). Either prints every reading they need: each wheel's steady current and the pair it applied (BM-SPINW amps, off_neg, off_pos)
#ifdef DBP_SPIN
    FLOOR_SPIN_KIND       = (FLOOR_ACT - FLA_SPIN_SLOW_RIGHT) / SPIN_DIRS       ' index into spinActPair
    FLOOR_SPIN_DIR        = (FLOOR_ACT - FLA_SPIN_SLOW_RIGHT) // SPIN_DIRS      ' SPIN_DIR_*: RIGHT 0, LEFT 1
#endif
  ' SPSTOP_*: what ended a leg -- a spin leg, and (SRC_REV 62) every straight floor leg: FAULTRUN's legs and re-drive,
  '  a drive back to the start, the incline's climbs and its drive down (BM-SPIN, BM-RDRIVE, BM-FLLEG)
  '  SPSTOP_NOT_RUN    - it never ran; why names what stopped it
  '  SPSTOP_LIMIT      - its distance stop brought both wheels to rest (every leg's own good end)
  '  SPSTOP_OPERATOR   - STOP on the panel (SRC_REV 69: no longer produced, no window offers it; the value holds)
  '  SPSTOP_ABORT      - the 10 A abort, a stalled instrument, a refused drive, or the forced-fault guard
  '  SPSTOP_OVERTRAVEL - a wheel passed the limit by SPIN_OVERTRAVEL_TICKS and the harness e-stopped the platform
  '  SPSTOP_TIMEOUT    - still moving at its bound, so the harness stopped it
  '  SPSTOP_FAULT      - a wheel faulted: on FAULTRUN's return the event under test, anywhere else an end
  '  SPSTOP_HARNESS    - SRC_REV 58, the harness's own stop after a window (kept for the record's vocabulary)
  '  SPSTOP_BLOCKED    - SRC_REV 62: the protective stop latched (an incline climb the slope stalled)
    #0, SPSTOP_NOT_RUN, SPSTOP_LIMIT, SPSTOP_OPERATOR, SPSTOP_ABORT, SPSTOP_OVERTRAVEL, SPSTOP_TIMEOUT, SPSTOP_FAULT, ...
        SPSTOP_HARNESS, SPSTOP_BLOCKED
    SPSTOP_COUNT          = SPSTOP_BLOCKED + 1
    TOKMAX_SPSTOP         = 10
    SPIN_MIRROR_MS        = 10                              ' after an ARM, before the mirror is read: several instrument passes
    SPIN_ATSPEED_MS       = 4_000                           ' both wheels AT_SPEED after the command; the quarter's is about 1 s
    SPIN_SETTLE_MS        = 1_000                           ' after AT_SPEED: the rpm window refills with steady running (A-8)
    SPIN_WIN_MIN_MS       = 250                             ' a window the limit cut shorter than this measures nothing
    SPIN_LEG_MS           = 15_000                          ' from the command; the slow leg takes about 8.2 s unloaded, the quarter's two turns about 5.0 s
    SPIN_FAULT_SETTLE_MS  = 1_000                           ' FAULTRUN's steady windows: the pre-fault second, the second after
                                                            '  the recovery, and the forward run's reference (the floor rule's
                                                            '  "at least 1 s at steady speed"; FR_PRE_SAMPLES is 500 ms of it)
    SPIN_LEAD_SETTLE_MS   = 20                              ' two 8 ms slots: the schedule's first write once turned back on

  ' The pre-registered bands (BM-SPINPRE prints every one before anything moves). R18.3's are DRIVE-INTEGRATION-DESIGN.md
  '  5.5's loaded expectations, each "same" as unloaded unless stated; the offsets' are this tier's own.
  ' SRC_REV 60 (DRIVER_REV 38, PL-160): A-1 AND A-2 RE-CUT BY CONSTRUCTION FOR THE JERK-LIMITED RAMP. Their bounds come
  '  from DOCs/plans/servo-model (DRIVE-INTEGRATION-DESIGN.md 5.5), whose model ramp is the stepped one: ramp_min 1_500,
  '  growing by ramp_inc 22 every pass (sim_servo.py), so its acceleration RISES until arrival -- 1_761 passes (920 ms)
  '  and 40_220 a pass at 36.75 x 10^6 -- and start_metrics.py judges a 1.4 s trace: A-1 over the rise, A-2 against
  '  "the trace's last 60 ms", which lie 418-478 ms after the model's arrival, at constant speed. So:
  '  A-2's REFERENCE IS STEADY RUNNING, never the ramp. Until SRC_REV 60 this harness took the 60 ms just BEFORE the
  '   first AT_SPEED sample, which under DRIVER_REV 38's S-curve is the ramp-out, still carrying up to 24 % of the
  '   speed-up acceleration (115 passes x jerk 71 of 33_958), so a correct start with no spike could fail it. The
  '   reference is now A2_TAIL_SAMPLES starting A2_REF_DELAY_MS after the first AT_SPEED sample: the model's own
  '   placement (418 ms after its arrival, to the 2 ms sample), and past the ramp by more than RAMP_TAU_MS. It counts only
  '   when every sample from the first AT_SPEED to the reference's end reads DCS_AT_SPEED: that is the driver's own report
  '   that its acceleration is 0 -- jerkStep writes AT_SPEED only on the arrival pass (a <= one jerk step) and on every
  '   later pass at the target, where it zeroes drv_accel_now in the same step (.steady), while a held pass turns it to
  '   SPIN_UP (holdDecay) and a stop to SPIN_DN; every sample after the first is at least one 2 ms instrument period,
  '   four drive passes, past the arrival, so it reads a = 0. The window lies inside SPIN_SETTLE_MS (420 + 60 < 1_000).
  '   THE BOUND STAYS 1.8: its derivation (the model's 1.13-1.80 for the new servo, loaded "<= 1.8") WAS against steady
  '   running, and the S-curve only lowers the peak's acceleration term -- its limit, 33_958 a pass, is under the model's
  '   40_220 at arrival, and it eases in from 0 instead of starting at 1_500. NEGATIVE: the shipped servo's start spike,
  '   1.94-3.04 (design 5.5, MEASURED; 2.57 at the model's delta bracket edge).
  '  A-1's WINDOW ENDS WHERE THE RAMP-OUT BEGINS. The model's acceleration rose to arrival, so "a duty that climbs with
  '   the ramp keeps the drop near 0" (start_metrics.py). The S-curve, for a target above accel_up^2 / jerk_up (16.2 x
  '   10^6; the quarter is 36.7), holds accel_up and then removes it over accel_up / jerk_up passes, RAMP_TAU_MS exactly
  '   (the library sets each jerk to its limit over RAMP_TAU_MS), so the torque it asks for falls by design in the last
  '   RAMP_TAU_MS before arrival: duty may fall there with nothing hunting. The window now ends A1_RAMPOUT_SAMPLES before
  '   the first AT_SPEED sample (RAMP_TAU_MS at 2 ms, and one sample for that first AT_SPEED reading up to 2 ms after the
  '   arrival): the rise and the plateau, where the acceleration never falls, as the model's did. THE BOUND STAYS 0.10
  '   (model 0.01-0.04 over a rise). NEGATIVE: the shipped servo's hunting during the rise, 0.34-0.53 (design 5.5).
    ' SRC_REV 74 (PL-168): A-1 reads only the rise (to A1_RAMPOUT_SAMPLES before the first AT_SPEED sample), which any quarter
    '  leg's capture holds, but spStartStats() records A-1 and A-2 together (bSpStartOk needs A-2's all-AT_SPEED reference), so
    '  SPINSTRT is NOMEAS exactly when SPINPEAK is: the quarter's two-turn leg (A2_REF_DELAY_MS, below) is what lets both be read
    A1_DROP_PM_HI         = 100                             ' A-1: duty's largest fall from its running maximum, <= 0.10
    A1_RAMPOUT_SAMPLES    = (wheelL.RAMP_TAU_MS * INST_RATE_HZ) / MS_PER_SEC + 1                ' 126: RAMP_TAU_MS + one sample
    ' SRC_REV 78 (PL-183) PREMISE CHANGE: A-2 is the ARRIVAL's kick bound, so it reads the arrival, not the whole spin-up. It read the
    '  peak over the whole START (first sample to the first AT_SPEED sample), and on the floor that is the platform's own acceleration
    '  plateau: the 2026-10-02 trace (debug_261002-103332.log, BM-TS tid 7 LEFT) reads 59-68 at k 272-325 in SPIN_UP, a ~180 ms plateau,
    '  falling to 29 at the arrival (k 417, no spike), against a steady tail of 18.9 -- 374 / 406 / 339 / 325 (LEFT / RIGHT, legs 7 / 8)
    '  against the bound for a start with nothing wrong. The jerk-limited ramp-out (RAMP_TAU_MS, A1_RAMPOUT_SAMPLES samples before the
    '  arrival) takes the acceleration, and with it its current, to 0 BY THE ARRIVAL PASS, which jerkStep writes as the first AT_SPEED
    '  state (a <= one jerk step); the DRIVER_REV 34 kick was ONE drive pass at that arrival (the field not advanced), and the rotor's
    '  current answers within the winding's time constant, well inside a 2 ms sample. So the arrival window starts AT the first AT_SPEED
    '  sample (atJ, which reads up to one 2 ms period after the arrival pass: the sample before it is still the ramp-out's decaying
    '  current, 29 against a 12-19 tail on the 2026-10-02 legs, and is not the arrival) and runs A2_ARR_SAMPLES samples: the sample
    '  and the one after it, the two that can hold a one-pass event whose first sample falls either side of the instrument's edge.
    '  A2_ARR_SAMPLES = 2 is CHOSEN from that, not measured.
    ' SRC_REV 78 (PL-183), THE STATISTIC: A-2 is judged as the window's peak current ABOVE the steady reference's mean, in sense mV --
    '  TRKICK's statistic (tr_i_over) and TRKICK's bound, TRKICK_EXCESS_MV's 50 (about a third of an amp at 150 mV/A). A RATIO is the
    '  wrong statistic on the floor: the steady tail there is 12-19 mV, where one count is 5-8 %, and the 2026-10-02 legs read
    '  1.47 / 1.53 / 1.80 / 1.96 against 1.8 on single noisy samples (an excess of 7-13 mV). THE NEGATIVE is TRKICK's, on file and
    '  measured with the same statistic: the pre-fix driver's arrival kicks of 64-183 mV over steady (Visit 6a, the TRKICK CON's
    '  table; DRIVER_REV 34's kick fix), each of which FAILs 50. The ratio still prints in BM-SPINSTART (ratio_x100), for continuity
    A2_ARR_SAMPLES        = 2                               ' A-2: samples from the first AT_SPEED sample the arrival window covers
    A2_RATIO_X100_HI      = 180                             ' A-2's old bound (the ratio), printed in BM-SPINPRE a2_x100 for continuity; not judged
    A2_EXCESS_MV_HI       = 50                              ' A-2 (SRC_REV 78): the arrival window's peak over the steady mean, sense mV, <= 50 (TRKICK's)
    A2_TAIL_SAMPLES       = 31                              ' start_metrics.py's tail, 60 ms at 2 ms: 31 samples
    ' SRC_REV 74 (PL-168): the reference ends A2_REF_DELAY_MS + A2_TAIL_SAMPLES x 2 ms = 420 + 62 = 482 ms after the first
    '  AT_SPEED sample (A-1 and A-2 are both judged only if the leg is at AT_SPEED all that time), which the quarter's one-turn
    '  leg could not promise: it held the quarter about 1.4 s in all, and any leg whose AT_SPEED flickered inside the 482 ms
    '  printed SPINSTART NOT_REACHED. The quarter's leg is two turns (spinLegTicks), 3.6 s at speed unloaded, so a leg that
    '  prints NOT_REACHED now did so because its AT_SPEED did not hold (BM-TS shows the SPIN_UP samples), not because the
    '  turn ended: the reading is the driver's, not the harness's
    A2_REF_DELAY_MS       = 420                             ' the model's tail, 418 ms after its arrival, to the 2 ms sample
    A2_REF_DELAY_SAMPLES  = (A2_REF_DELAY_MS * INST_RATE_HZ) / MS_PER_SEC                       ' 210
    SPIN_DUTY_FLOOR       = 1_600                           ' where duty "leaves its floor" (start_metrics.py floor = duty_min)
    A3_SWING_HI           = 400                             ' A-3: duty_pk - duty over a steady window, rungs 1 and 2
    A3_ERR_PK_HI          = 76                              ' A-3: err_pk there
    A4_ERR_LO             = 47                              ' A-4: |mean err| in every window: a point, SERVO_SETPOINT 48
    A4_ERR_HI             = 49
    ' SPINSYM: the confirmed pair's larger direction current over its smaller, per wheel, at the MEDIUM rung. Unloaded
    '  Visit 7b read reverse over forward 0.91-1.01 at rungs 2-5 (101-110 by this measure); under load a common friction
    '  current dilutes any split further, so 1.25 is loose. The legacy pair read 1.88-2.06 unloaded.
    SPINSYM_LO            = 100
    SPINSYM_HI            = 125
    ' SPINCTL: THE OFFSETS' CONTROL. The legacy pair's mean current over the confirmed pair's, per wheel, same rung. It
    '  must show the offset's effect for SPINSYM's PASS to count (INS-14): unloaded it was 15-26x at rungs 3-5, and a
    '  load adds the same torque current to both, so the floor is set well under that at 1.25x.
    '  SRC_REV 75 (task 3657, HOLD-SPEED plan sec 6) RE-PREMISED: the ratio means "the offsets' cost" only when both pairs run
    '   the SAME speed, and the 2026-09-30 floor rerun (debug_260930-181811.log) showed they did not under the spinning load:
    '   the schedule's medium legs 3 and 4 followed 90 / 94 and 88 / 94 % (LEFT / RIGHT) against the legacy legs 5 and 6's 100 / 100,
    '   so its 1.89 and 2.40 (PASS) compared a slower wheel's current with a faster one's. The cell is now judged ONLY when this
    '   wheel read at least SPINRATE_FOL_LO % of its command (BM-SPINW fol_pct) on ALL FOUR legs, the schedule's two and the
    '   legacy pair's two; otherwise NOMEAS with BM-XRUN's why NOT_AT_CMD_SPEED (a leg whose reading was never taken names
    '   that leg's own cause first). UNFIXED VALUE: legs 3 / 5 and 4 / 6 -> NOMEAS, where it printed PASS 189 and 240.
    '   RIVAL EXPLANATION: the offsets' saving is real and the schedule is slow for another reason (the plan's R9, a second
    '   mechanism); the cell then stays NOMEAS and SPINRATE says which leg was slow, so neither reads the other's job
    SPINCTL_LO            = 125
    ' SPINLEAD: the schedule's quarter (lead 5.1) over the fixed pair's (lead 18), per wheel. The quarter's minimum was
    '  measured flat from -2 to 8 degrees (Visit 8b), so 18 sits outside it: the schedule must draw no more, 5 % for noise.
    '  SRC_REV 74 (PL-168): each pair's current is the mean of its two legs' 500 ms windows (spinWinMs), so both pairs are
    '  compared over the same length of the same two-turn leg at the same command; the cell needs all four legs' windows
    '  and prints NOMEAS naming the first leg that lacked one (emitAcrossRuns() in a session).
    '  SRC_REV 75 (task 3657): it assumed the two pairs DELIVER the same speed, which the 2026-09-30 rerun showed they did not
    '   under load (schedule 84-88 %, fixed 100 %, leg 7 against leg 9, BM-SPINW fol_pct), so it takes SPINCTL's precondition: judged
    '   only when this wheel read at least SPINRATE_FOL_LO % of its command on all four legs (the quarter's two and the fixed
    '   pair's two), else NOMEAS with why NOT_AT_CMD_SPEED. UNFIXED VALUE: legs 7 / 9 and 8 / 10 -> NOMEAS (leg 8 had no window at
    '   all there, which names it first); a ratio made of unequal speeds can no longer print a PASS or a FAIL
    SPINLEAD_LO           = 0
    SPINLEAD_HI           = 105
    ' SPINRATE (new, HOLD-SPEED plan sec 6; SRC_REV 75): EVERY spin leg, every pair, both wheels, the rpm window's following
    '  (BM-SPINW fol_pct, read at the steady window's end) at least SPINRATE_FOL_LO % of the command -- the hold-speed fix's
    '  own claim ("spins hold the commanded speed", all ten legs). Per wheel, the cell's value is the LOWEST reading over the
    '  legs judged. UNFIXED VALUE (the negative on disk, debug_260930-181811.log): the schedule legs read 57-94 % (LEFT 84, 57,
    '  90, 88, 84; RIGHT 88, 80, 94, 94, 88), so both wheels read FAIL at 57 and 80. 97 is the plan's bound: the legacy and fixed
    '  legs read 100-101 % in the same run, and the rpm window's own quantisation is under 2 points (A-8, FOLAGREE_HI).
    '  RIVAL EXPLANATION for a FAIL: a leg read short because the platform was held back from outside (a hand, an obstacle in the
    '  square) and not by the drive -- the run sheet's clear-floor rule is the guard, and the lag limiter's own reading (BM-SPINW
    '  short, err_pk) says which. PRECONDITION: judged only when every leg the run began took a reading (a leg that never ran, or
    '  whose window was cut, leaves the cell NOMEAS unless a leg already read under the bound, since a FAIL needs no other leg)
    SPINRATE_FOL_LO       = 97
    ' SPINHOLD (new; the plan's invariant I-1: in steady running under any load the drive can carry the field is never held):
    '  per wheel, the legs on which NO lag-limiter pass was counted while a command was in force (lag_held unchanged, read
    '  from the driver's own status run by limSample()) and the steering object's log held NO EV_PATH_LIMIT, over the leg's
    '  drain. The value is the count of legs that broke either. UNFIXED VALUE: every schedule leg of the rerun (legs 1-4, 7, 8)
    '  logged 2-18 EV_PATH_LIMIT events (18, 10, 6, 6, 2 and 4 on legs 1, 2, 3, 4, 7 and 8: the log's own BM-EV count), and the legacy and fixed legs
    '  logged none, so the cell reads 6 bad legs of 10 on each wheel (the path limiter is the platform's: it scales one wheel
    '  because the other fell behind, so a leg with any EV_PATH_LIMIT in either wheel's log is bad on both; a leg is also bad on
    '  a wheel whose own lag_held advanced). RIVAL EXPLANATION: a real obstacle held the wheel (the path limiter and the lag limiter then act
    '  rightly); that is the same floor-clear rule as SPINRATE, and the held pass count says whether the drive or the floor held it.
    '  PRECONDITION: the leg's event drain read to its end with nothing lost (bEvdClean()) and the driver's status run was
    '  readable; otherwise the leg is unjudged and the cell NOMEAS unless a bad leg has already settled it
    ' LIMGIVE (new; I-2 and I-3): the field gives way ONLY where a limiter has the duty. Two limbs, one count (BOTH wheels):
    '   (a) per sample (limSample(), every spinWatch() pass, the slot of the plan taken as the pass: front slot LG_SLOT_MS 8 ms,
    '       so a pass is under or about a slot) of each wheel with a command in force and no fault: when its lag limiter held
    '       in the interval (lag_held advanced) and its field speed is under LG_GIVE_NUM/LG_GIVE_DEN (98 %) of the driver's
    '       target, that is a GIVE-WAY SLOT; it is BAD unless duty_capped or foldback_frames advanced in it or in the
    '       LG_LOOK_MS (4 slots, SHORT_SLOTS) before it. SRC_REV 78 (PL-182) PREMISE CHANGE: a slot counts only after the wheel
    '       ARRIVED (its driver read DCS_AT_SPEED at some sample of the leg: the field had reached its target and then fell under
    '       98 % of it while held). The 2026-10-02 floor-auto log's two bad slots (debug_261002-103332.log: BM-LIMW seq 43 leg 2
    '       LEFT, seq 1_126 ramp leg 1 LEFT) were holds during SPIN_UP, the ramp not yet arrived -- the field is below the
    '       target there by design -- and are no longer counted. The held count (BM-LIMW held, SPINHOLD) is unchanged.
    '       STILL FAILS A DECAY AT SPEED WITH NO LIMITER. MUTATION (by reading): remove D-3's limiter test (holdDecay decays on
    '       every held pass, as before DRIVER_REV 47); a wheel at AT_SPEED on a load then has a held pass with duty_capped and
    '       foldback_frames unmoved, its drv_incr_now falls under 98 % while the state reads SPIN_UP; bLgArrived is already
    '       set, so bGive is true, no limiter advance is in LG_LOOK_MS, and lgBad / sfLgBad count it: LIMGIVE FAILs;
    '   (b) per leg (a spin leg, a ramp leg): path limiting in its log with no limiter anywhere -- no EV_FOLDBACK and no
    '       EV_CURRENT_LIMIT in its drain, and no duty_capped or foldback_frames advance on either wheel over the leg -- is BAD
    '       (I-3: every give-way is a limiter's, and the steering object's shortfall reads it).
    '  UNFIXED VALUE: limb (b) on the 2026-09-30 floor-auto log -- path limiting on six spin legs and all four ramp legs, and
    '  not one EV_FOLDBACK or EV_CUR_LIMIT in the whole session (the steady windows' duty_pk never past 8,238 of duty_max 27,648,
    '  so a duty ceiling is not indicated, though duty_capped itself was not logged there and is read as not advanced): 10 bad
    '  legs. Limb (a) has no floor2 data (the status run was not sampled): its negative is the plan's own, a decay with no
    '  limiter, and is shown by mutation.
    '  RIVAL EXPLANATION: a wheel at the duty ceiling logs no event of its own (EV_ has no duty-cap kind), so limb (b) licenses a
    '  leg by the sampler's duty_capped advance as well. PRECONDITION: the sampler took at least one sample on each wheel
    '  (a build or leg that never ran spinWatch() prints NOMEAS); a session in which nothing gave way is a PASS with n the
    '  samples read, not a NOMEAS: the claim is that no give-way went unlicensed, and none did
    LG_SLOT_MS            = 8                                 ' the plan's front slot (design sec 2.3: every front slot, 8 ms)
    LG_LOOK_MS            = wheelL.SHORT_SLOTS * LG_SLOT_MS   ' 32: "within its last 4 slots"
    LG_GIVE_NUM           = 49                                ' a field under 49/50 = 98 % of its target has given way ...
    LG_GIVE_DEN           = 50                                '  (the target is divided first: a quarter-speed increment x 49 would overflow a long)
    '  (the status run's indexes, LG_*_IDX, are with the ABI table, where its offsets are defined)
    ' RAMPARR (new; the plan's "speed-ups arrive when the ramp says"): on each of the four ramp legs, both wheels read AT_SPEED
    '  within RAMPARR_PCT % of the S-curve's predicted time (BM-RAMPLEG at_ms against p_at_ms) and the leg's log holds no
    '  EV_PATH_LIMIT. The value is the legs that failed either. UNFIXED VALUE: leg 1, 2,846 ms against 1,790 (59 % late) and
    '  leg 3, 696 against 320 (118 % late), each with the path limiter engaged on the LEFT (638; 756, 844, 871 in the rerun's
    '  own log) -- 2 bad legs of 4, legs 2 and 4 (565 against 558) passing. RIVAL EXPLANATION: the leg's start was slowed by
    '  the surface or the pack (a low battery) and not by the drive: the prediction is for the commanded rate, and the legs
    '  that match it (2 and 4, the same floor, 565 / 558) say the surface is not the cause. PRECONDITION: the leg's wheels left
    '  rest (rampSample()'s bRampMoved) and its drain was clean; a leg that never moved is not evidence about the ramp
    RAMPARR_PCT           = 10
    RAMPARR_PCT_SCALE     = 100                             ' the percentage's whole
    ' BLKLIMIT (new; the plan's obstacle claim): on the BRAKE trial, the solid object, the current fold-back ENGAGES (EV_FOLDBACK,
    '  value 0, either wheel) BEFORE the protective stop latches (the blocked wheel's EV_STOP with SR_BLOCKED), and the latch comes
    '  after the wheel stood still at least BLK_STAND_LO_MS with its blocked count run BLK_COUNT_LO_MS..BLK_COUNT_HI_MS -- the same
    '  bounds BLKSTOP holds a latch to (SRC_REV 76: the count's own start, not the last tick). BOOL. UNFIXED VALUE: it passes today (the 18:22
    '  BRAKE trial of debug_260930-182135.log: FOLDBACK on the RIGHT at 35,504 ms and the LEFT at 35,384, the BLOCKED stop on the RIGHT
    '  at 39,664, r_stand 1,097); its negative is a stand that latched with no limit before it, which no run on disk
    '  has, so it is shown by mutation. RIVAL EXPLANATION: the fold-back engaged for another reason (a start-up surge) before a
    '  stall the driver would have latched without it; the lowered limit (BLK_LIMIT_A) makes the surge the stall's own, and the
    '  harness runs this trial at that limit only. The COAST trial (a yielding stand) is not judged here
    ' BLKWIN (new, SRC_REV 77; PL-179 C4's invariant I-9): on each OBSTACLE trial, from the pass AFTER a wheel's first fold-back action
    '  with no hall tick since (SRC_REV 81, PL-189: the flag blkWinFold, kept by the rule of bFrontProtect()'s bLimSinceTick over
    '  foldback_frames ALONE) until its next tick or
    '  the latch, no pass of blockWatch() reads that wheel's |err| in BLK_WIN_LO_ERR..BLK_WIN_HI_ERR (82..88): a wheel at its limit
    '  is held at LAG_LIM (64), so a rotor ticked one sector against the field reads 64 + 42.7 k, never 82..88, and no tick against
    '  the field can fault. BOOL, ANDed over the trials that opened a window. The pass that sets the flag is not read: the status
    '  run it reads may precede that pass's set-back. UNFIXED VALUE (the 2026-10-02 COAST trace, DOCs/analyses/bench/2026-10-02/
    '  debug_261002-103634.log, tid 1): the fold-back engaged on both wheels (BM-EV FOLDBACK LEFT 12_116 ms, released 13_116, engaged
    '  again 14_244; RIGHT 14_236; neither released before 24_796), so foldback_frames advanced on every pass after; the LEFT wheel
    '  then sat at pos 62 with no tick, in SPIN_UP, reading e 83-86 at k 1_450-2_175 (84 at 1_450, 83 at 1_575, 82 at 1_600, 86 at
    '  2_000), and the RIGHT o_e -87 at k 675 and -83 at 750 -- every one inside the band, so the cell reads FAIL there. RIVAL
    '  EXPLANATION: a wheel whose field the driver legitimately walked back up past 80 on its way to a tick: the window closes
    '  at that tick (the flag clears), so only a wheel that went on standing is read. PRECONDITION: some wheel's window opened;
    '  else NOMEAS with BM-BLKWIN's why NO_LIMITER_ACTION (or NOT_BLOCKED when the leg's own stop fired first)
    '  SRC_REV 81 (PL-189), THE FLAG'S DERIVATION. DRIVER_REV 49's T-1 arms the limit hold on the current fold-back only
    '   (foldback_frames); a pass on which only duty_capped moved arms nothing, so a window opened by it would be one no hold
    '   guards (T-1's boundary, a stall that meets the duty ceiling first: HOLD-SPEED-UNDER-LOAD-DESIGN.md sec 4.11.7). BLKWIN reads
    '   foldback_frames alone, so it judges exactly the passes the hold guards. THIS IS BLKWIN'S WINDOW ONLY: the blocked-count
    '   mirror (blkLimTick, which BLKSTOP and BLKLIMIT's count bounds read) keeps duty_capped + foldback_frames, because the
    '   driver's own count, bFrontProtect(), is unchanged at DRIVER_REV 49 and still reads the sum -- a mirror that dropped
    '   duty_capped would miss a count the driver started. The two flags share the clears (a tick, or a state other than SPIN_UP /
    '   AT_SPEED) and differ only in the counter that sets them. On the second visit's two OBSTACLE trials the fold-back engaged on the
    '   RIGHT wheel before the latch (BM-EV FOLDBACK RIGHT 14_249 ms and 31_889 ms, value 0; the latches 15_506 and 33_401), the
    '   limiter of those windows: BM-BLKWIN seq 386 r_hit 1 r_emax 85 and seq 760 r_hit 1 r_emax 83 are read from them (DERIVED; the
    '   status run's duty_capped is not in those logs)
    BLK_WIN_LO_ERR        = 82                              ' I-9's band, as the design states it (integer readings of the -82 .. -88.3 side)
    BLK_WIN_HI_ERR        = 88
    ' BLKFLT (new, SRC_REV 77; PL-179 F-a, C4): the OBSTACLE trial met the obstacle (both wheels read AT_SPEED), LATCHED the
    '  protective stop, and its event drain (read after the latch and the API checks, before the drive back's) holds no EV_FAULT and no
    '  EV_FAULT_RESYNC on either wheel. BOOL, ANDed over the trials. A trial that met the obstacle and did not latch fails it
    '  (the COAST trial's 2026-10-02 TIMEOUT). UNFIXED VALUE (2026-10-02, the BRAKE trial of debug_261002-103634.log): EV_FAULT_RESYNC
    '  RIGHT at seq 336 (40_440 ms) and EV_FAULT RIGHT at seq 338 (40_571), one of each on a wheel stood against the obstacle, and
    '  the trial's own why FAULTED -- FAIL. RIVAL EXPLANATION: the fault was provoked by the trial's own stop (the shorted
    '  bridge) and not by the stall: the drain covers the whole lifetime up to it, the latch and the API checks included, so
    '  a fault there fails the cell too, which is the claim -- a protective stop that faults a wheel is not a clean stop.
    '  PRECONDITION: both wheels read AT_SPEED, and the drain read whole when the trial latched; else NOMEAS with BM-BLKWIN's
    '  why (NOT_REACHED, NOT_BLOCKED, EVENTS_LOST, or the trial's own cause when it never drove)
    SPIN_BAD_LO           = 0                               ' every SPIN count cell passes at zero bad instances
    SPIN_BAD_HI           = 0

  ' CREEP, THE INCLINE'S THREE STOPS (SRC_REV 62: segment INCLINE; until then segment CREEP, where he carried the platform
  '  onto the incline and let go of it for each trial). The platform now DRIVES up the measured incline in legs of
  '  INC_LEG_MM, each ended at rest by its own distance stop (the floor situations' section below has the incline's
  '  legs), and each of the first three stops is one trial, in this order, all in one steering lifetime:
  '   CRK_COAST   - holdAtStop(FALSE), the bridge floating at rest: THE INCLINE'S CONTROL. It must roll, or the incline
  '                 does not load the wheels past friction and cogging and no hold reading here is evidence (INS-14). It
  '                 is braked (emergencyCutoff(): the phases shorted) as soon as it has rolled CREEP_CTRL_TICKS.
  '   CRK_LOWCEIL - holdAtStop(TRUE) with the ceiling at CREEP_LOW_CEIL_PCT: THE HOLD'S CONTROL. That ceiling is under
  '                 duty_min, so the first tick of creep drops the spring below where it started: it must slip. A hold
  '                 that survives it says this incline never asks for more than duty_min, so the ceiling is not sized.
  '   CRK_HOLD    - holdAtStop(TRUE) at the PROVISIONAL limits (HOLD_CEILING_PCT, HOLD_RISE_MS, HOLD_LIMIT_MS): the
  '                 measurement. Pre-registered: ZERO ticks of creep while HOLDING, and HOLDING at the watch's end.
  '  Creep is counted on the instrument's own hall decode (hwPos) from the moment both wheels read DCS_STOPPED at the
  '  stop -- where the driver arms its hold (frontHold()), so the reference is the hold's own -- and the driver's own
  '  displacement (getHoldStatus()) is a second, independent reading. A hold trial that creeps CREEP_BOUND_TICKS is
  '  braked at once. What sizes the ceiling is recorded per wheel: the hold duty reached against the ceiling in force,
  '  the longest time at the ceiling, sense_i and getCurrent() at hold, and how the hold resolved (HS_HOLDING,
  '  HS_SLIPPED, HS_LIMITED). The incline's angle and the platform's mass cannot be known here: the run sheet records
  '  both, measured by him. WHEEL SLIP IS NOT SEEN: a tyre that slides on a loose surface moves the platform with no
  '  hall tick, and one that spins in place ticks with no motion, so to the halls either reads as rest or as creep.
    #0, CRK_COAST, CRK_LOWCEIL, CRK_HOLD
    CRK_COUNT             = CRK_HOLD + 1
    TOKMAX_CRK            = 7
    CREEP_CEIL_PCT        = wheelL.HOLD_CEILING_PCT         ' 10: the provisional ceiling under test
    CREEP_LOW_CEIL_PCT    = 1                               ' the control's: 1 % of duty_max, under duty_min (about 5.8 %)
    CREEP_WIN_MS          = 15_000                          ' HOLD_LIMIT_MS (10 s) at the ceiling plus its rise: LIMITED can show
    CREEP_CTRL_WIN_MS     = 5_000                           ' the coast control's longest watch
    CREEP_CTRL_TICKS      = 3                               ' the coast control has rolled this far (17 mm): it passes, and is braked
    CREEP_BOUND_TICKS     = 6                               ' a hold trial that creeps this far (35 mm) is braked at once
    CREEP_POLL_MS         = 50                              ' the hold getters' cadence inside the watch
    CREEP_DECIM           = 10                              ' 20 ms samples: a 15 s watch is 750 of them
    CREEP_ZERO_LO         = 0                               ' the pre-registered creep while HOLDING at the provisional ceiling
    CREEP_ZERO_HI         = 0
    CREEP_ONE_TRIAL       = 1
  ' CRSTOP_*: what ended a creep trial's watch
  '  CRSTOP_NOT_RUN  - the watch never began; why names what stopped it
  '  CRSTOP_TIMER    - it ran its window
  '  CRSTOP_BOUND    - the creep reached the trial's bound, and the phases were shorted
  '  CRSTOP_OPERATOR - STOP on the panel, and the phases were shorted
  '  CRSTOP_ABORT    - the 10 A abort or a stalled instrument
    #0, CRSTOP_NOT_RUN, CRSTOP_TIMER, CRSTOP_BOUND, CRSTOP_OPERATOR, CRSTOP_ABORT
    CRSTOP_COUNT          = CRSTOP_ABORT + 1
    TOKMAX_CRSTOP         = 8

CON { --- the floor situations (SRC_REV 62; the load cells since SRC_REV 58): OBSTACLE, GRAB, INCLINE, FAULTRUN --- }

  ' WHY THEY ARE HERE. The floor run is the last bench visit before 6.0: "the floor run keeps only claims about load"
  '  (Stephen, 2026-09-26, PUNCH-LIST.md's burn-down). So every release item a load decides is judged in this part, in
  '  one visit: PL-93 (the drive after a fault), PL-106 (the protective stop on a blocked wheel), PL-111's API half (the
  '  stop cleared through the API), PL-132 (the bridge that stop leaves), PL-150 and PL-144 (the path limiter and the
  '  overload hold under a real load), PL-95 (AT_SPEED reported at a held field) and X-5 (PL-117). Every criterion and
  '  its negative is fixed here, before the run (D2); a cell whose precondition did not arise prints NOMEAS and its
  '  record's why names it. SRC_REV 62 rebuilt them on the four situations Stephen chose (2026-09-27), which replace
  '  SRC_REV 58's chocked wheel and 2 m strap run: 1. OBSTACLE STOP, 2. GRAB ONE SIDE, 3. INCLINE, 4. FAULT RETURN RUN.
  '
  ' THE OWNER'S FLOOR RULES (Stephen, 2026-09-27, binding) ARE THE CONSTRUCTION, and every leg below keeps all of them:
  '  - ONLY DISTANCE-CONTROLLED DRIVES. Every straight leg's travel limit is ARMED BEFORE IT IS DRIVEN, through the
  '    steering object's own stopAfterDistance() / stopAfterRotation() -- a refused limit and the leg is never driven --
  '    and every leg ends at rest at that limit unless something ends it sooner. Spinning in place (SPIN) is allowed.
  '  - A STRAIGHT RUN IS AT MOST FL_LEG_MM OUT AND FL_LEG_MM BACK TO ITS START; the incline at most FL_LEG_MM up and the
  '    same back down, with stops. A drive back is armed with the travel the drive out actually made, never more.
  '  - THE HARNESS'S OWN HARD CAP. Every leg is watched on the instrument's mirror of each driver's own hall position,
  '    and the platform is e-stopped the moment either wheel is FL_OVER_TICKS past the leg's declared travel
  '    (bSpinGuardTripped(): the SPIN legs' guard, now given each leg's own travel). FL_OVER_TICKS is
  '    SPIN_OVERTRAVEL_TICKS, one electrical cycle (35 mm): the distance stop promises rest within STOP_LIMIT_HI (3
  '    ticks) of its limit, so twice that past it is a stop that did not happen. A leg still moving at its bound is
  '    stopped.
  '  - THE OPERATOR KNOWS WHICH TEST RUNS BEFORE IT MOVES. SRC_REV 69: the command he typed names it, the banner's action
  '    field and the BM-PLAN row say it, and the lead-in counts down before anything moves; FAULTRUN's two later drives
  '    each have their own STAND CLEAR count. The 10 A abort and the fold-back apply.
  '  - The speeds are low: SLOW (power 7, 0.16 m/s) everywhere but FAULTRUN's power 10 (0.23 m/s), derived below.
  '  Distances are hall ticks at the steering object's TICK_MM_X100 (5.76 mm a tick): FL_LEG_TICKS, 173, is 1 m.
  '  EVERY TRAVEL NUMBER BELOW comes from the run sheet's pass-by-pass model of the driver's jerkStep at the built-in rates
  '  (speed-up 33_958 a pass with jerk 71, slow-down 49_918 with jerk 104, 522.7 us a pass, 6 ticks per 2^32 of field
  '  angle), which gives the sheet's own stops to the tenth of a tick: at power 7 a start takes 0.39 s and 5.3 ticks
  '  and a stop 0.31 s and 4.4; at power 10, 0.48 s and 9.7, and 0.39 s and 8.0. The steady rate is the increment x 6
  '  / 2^32 x FR_PASSES_PER_SEC: 26.9 ticks a second at power 7, 40.3 at power 10.
    FL_LEG_MM             = 1_000                           ' the rule's 1 m; MUST match gen_dual_assets.py FL_LEG_M
    FL_LEG_TICKS          = (FL_LEG_MM * SPIN_X100) / TICK_MM_X100              ' 173: the steering object's own conversion
    FL_OVER_TICKS         = SPIN_OVERTRAVEL_TICKS           ' the harness's cap past a leg's declared travel (above)
    FL_LEG_MS             = 12_000                          ' a SLOW leg's bound: 1 m at 26.9 ticks/s is 6.4 s, plus its ramps
    FL_MOVE_MS            = 1_000                           ' a drive leaves DCS_STOPPED within a few passes of its command
    FL_SLOW_POWER         = 7                               ' the floor's slow walk (spinPower's SLOW); 0.16 m/s
    FL_SLOW_INCRE         = LIB_MIN_FWD_INCRE + (((LIB_MAX_FWD_INCRE - LIB_MIN_FWD_INCRE) / (POWER_FULL - POWER_MIN)) * (FL_SLOW_POWER - POWER_MIN))
    ' its field rate in ticks/s x10: the increment / 2^16 x 6 x FR_PASSES_PER_SEC / 2^16, split so no product passes 2^31
    FL_SLOW_RATE_X10      = ((FL_SLOW_INCRE >> 16) * wheelL.HALL_TICKS_PER_CYCLE * FR_PASSES_PER_SEC * X10) >> 16     ' 269
  ' FLL_*: a plain floor leg -- one armed, driven to its limit and watched, with nothing judged on it -- printed as
  '  BM-FLLEG (flLeg()): a drive back to the start, FAULTRUN's unfaulted leg out, an incline climb, the drive down. SRC_REV
  '  69: only FAULTRUN's leg out is run now -- GRAB's drive back is gone (he returns the platform by hand) and INCLINE is
  '  compiled out -- and the other kinds keep their values so a log reads as it did
    #0, FLL_BACK, FLL_FR_OUT, FLL_INC_UP, FLL_INC_DOWN
    FLL_COUNT             = FLL_INC_DOWN + 1
    TOKMAX_FLL            = 8

  ' SRC_REV 69, THE LEAD-IN AND THE PLAIN LINES (Stephen 2026-09-30, R3: "let's go ahead and add a 10-second lead-in. Nothing
  '  more."). The lead-in follows the banner and the build records, and ends before the steering object is started: nothing
  '  can move until it has. It replaces the first READY (there is no screen to click), and is a beat-keeping wait, so the
  '  watchdog (WD_STALL_MS, 4 s) is fed through all of it. FAULTRUN's two in-sequence counts stay: STAND CLEAR before the
  '  drive back and before the re-drive, each a beat-keeping wait that prints its line first (the board's 5 s steps).
  '  FLOOR_EST_S is BM-PLAN's est_s: the lead-in is in it.
    LEAD_IN_MS            = 10_000
    FR_CLEAR_MS           = 5_000
    TOKMAX_FLOORACT       = 17                              ' SPIN_LEGACY_RIGHT: the longest action token

  ' 4. FAULT RETURN RUN, PL-93 and X-5 (PL-117) on a straight run (segment FAULTRUN). One steering lifetime, and ONE
  '  SEQUENCE, not a repeat (SRC_REV 69): the lead-in, then
  '   a. OUT, unfaulted, straight after the lead-in: FL_LEG_MM forward at FLR_POWER, armed first; once both wheels read
  '      AT_SPEED, each wheel's getCurrent() over SPIN_FAULT_SETTLE_MS is the SECOND REFERENCE; then on to its limit.
  '   b. BACK, after FR_CLEAR_MS of STAND CLEAR: FL_LEG_MM back at the same power, armed first; SPIN_FAULT_SETTLE_MS at speed
  '      with getCurrent() polled -- the "before" -- then ONE wheel, FLR_SIDE (the LEFT), is forced to fault (frProvoke():
  '      testForceFault(), guarded) and the capture runs until both wheels rest (X-5, on the OTHER wheel).
  '   c. The recovery (steerRecoverFault(): testResetFault()); then, after FR_CLEAR_MS of STAND CLEAR, the SAME drive back
  '      again at the same power, armed with what is left of the leg (stopAfterRotation()), SPIN_FAULT_SETTLE_MS at
  '      speed with getCurrent() polled -- the "after" -- and on to its limit: the start.
  '  THE FAULT IS testForceFault(), NOT THE WRONG-OFFSET WRITE. The driver takes it at its own fault test on its next
  '   driven frame (FC_LAG, the halls legal) -- the path a real lag fault takes -- and it leaves no field 180 degrees off:
  '   the offset-shift provocation plugged the motor into the 10 A abort in 3 of its 5 uses on file (18-25 A, PL-119),
  '   which on the floor is a hard yaw beside a person. This part's fault legs have used it since SRC_REV 36. RULED
  '   (Stephen, 2026-09-28): the guarded test fault stands for the fault return run.
  '  THE FAULT RESPONSE IS THE SHIPPED DEFAULT, FR_GRADED (start() restores it): with the halls legal the faulted wheel
  '   re-seeds its field and ramps down at the slow-down limit (SR_FAULT_CONTROLLED) while the steering object ramps the
  '   other down at the same limit (frontPlatformFaultStop(), SR_PARTNER). THE ARC THE PLATFORM TURNS DURING THE
  '   PARTNER'S RAMP-DOWN: two equal ramps from one speed differ by the pass the fault is seen on and the re-seed's hall
  '   quantisation, about a tick -- 6 mm of tyre over the 387 mm track, under 1 degree. If the graded stop falls back to
  '   a coast (the halls lost, or a second fault), it is at most the partner's whole stop, 8.0 ticks (46 mm) at power 10:
  '   6.8 degrees, the platform pivoting about the faulted wheel; the ~0.66 m still to go then ends ~8 cm to one side.
  '  FLR_POWER, DERIVED so both steady seconds fit inside the 1 m back with room for the fault: the back leg is 9.7
  '   ticks up + 40.3 of "before" = 50.0 at the fault, 8.0 for both ramps down (58.0), then the re-drive's 9.7 up + 40.3
  '   of "after" + 8.0 down + STOP_PLAN_EARLY_TICKS = 59.0: 117 of FL_LEG_TICKS' 173, 56 spare. Power 13 (MEDIUM) would
  '   leave 10, too few for a fallback coast (a free wheel at 0.31 m/s rolls out ~40 ticks at a rolling resistance of
  '   0.02 g); power 10 leaves 56, over twice the ~24 such a coast takes at its 0.23 m/s. A faster power draws more
  '   current for PL-93's ratio, and this is the fastest that keeps that margin.
  '  R21-DUAL-POSTFLT-P, per motor, X100: the "after" over the "before", at most RD_RATIO_X100_HI. The OUT run's current
  '   is the SECOND REFERENCE, printed beside them (BM-RDRIVE l_fwd, r_fwd) and not judged: it runs the other way on the
  '   same floor, and SPINSYM allows a direction to differ by 25 %, so it cannot be held to 1.5 without a derivation of
  '   its own; it shows whether the "before" was itself ordinary.
  '   NEGATIVE, MEASURED (PL-93; dual-c, debug_260919-173537.log): after a real fault and recovery every next drive drew
  '   3_435-3_771 mV of sense against about 900 at half speed (3.8-4.2x), and the harness's 10 A abort stopped it during
  '   the drive-up. An absolute-current abort here scores RD_ABORT_X100 on the wheel that tripped it.
  '   NOMEAS: the fault did not latch (NO_FAULT), the recovery did not clear (MOTOR_RETIRED), too little of the leg is
  '   left (NO_ROOM), or the "before" is under RD_PRE_MIN (LOW_CURRENT).
  '  R19-DUAL-SPINPLAT-P (X-5 on the floor; the id is the SPIN legs' own since SRC_REV 36), PCT, the watched (RIGHT)
  '   wheel: its rate FR_PLAT_RAMP_MS after the fault, at most FR_PLAT_REST_PCT of its rate before it -- FLTPLAT's own
  '   criterion (R19-DUAL-PLATSTOP-X). NEGATIVE: a steering object with no platform fault policy leaves the other wheel
  '   driving at about 100 % (PL-117). NOMEAS unless the forced fault latched and the other wheel was turning before it.
    FLR_POWER             = 10                              ' 15_090_904: 40.3 ticks/s, 0.23 m/s (derived above)
    FLR_SIDE              = SIDE_LEFT                       ' the wheel faulted; the RIGHT is the one watched (X-5)
    RD_RATIO_X100_HI      = 150                             ' 1.5x: loose against measurement noise, far under the defect's 3.8x
    RD_ABORT_X100         = 9_999                           ' an abort's score: over any band
    ' RD_PRE_MIN, SRC_REV 62, RE-DERIVED (was 500, 0.05 A, "a divisor that is signal"). The "before" and the "after"
    '  share one lifetime and so one rest zero, and each is a mean of getCurrent() reads resolved to one mV of sense,
    '  6.7 mA at SENSE_MV_PER_A: each is good to half that, 3.3 mA. A true ratio of 1 reads at most (p + 3.3) / (p -
    '  3.3), under RD_RATIO_X100_HI's 1.5 for any p over 3.3 x (1.5 + 1) / (1.5 - 1) = 16.7 mA: 0.02 A is the least
    '  "before" whose quantisation alone cannot FAIL it, and the defect's 3.8x still reads over 2.9 there. A slow
    '  straight run draws far less than a spin, so the old 0.05 A floor could have held the cell NOMEAS.
    RD_PRE_MIN            = 200                             ' getCurrent() units, A x 10_000: 0.02 A (derived above)
    ' RD_MIN_TICKS, SRC_REV 62, RE-DERIVED for FLR_POWER on a straight leg (was 80, a spin's turn at SLOW): the re-drive
    '  needs 9.7 up + 40.3 of window + 8.0 down + the plan's early tick = 59.0; with a tick for the model's start (up to
    '  1 % short of the sheet's), a tick of hall quantisation in "what is left", and STOP_LIMIT_HI's 3, 64
    RD_MIN_TICKS          = 64
    RD_WIN_MIN_MS         = SPIN_FAULT_SETTLE_MS / 2        ' a window its limit cut shorter than this measures nothing
    RD_PCT_SCALE          = 100

  ' 1. OBSTACLE STOP, PL-106 / PL-111 / PL-132 / PL-95 (segment OBSTACLE; SRC_REV 58's BLOCK chocked the LEFT wheel and
  '  drove it alone). BOTH wheels are driven straight ahead at BLK_POWER (SLOW) into an obstacle -- he stands in front,
  '  or an object that cannot move -- OBS_NEAR_MM to OBS_FAR_MM ahead, the leg armed at FL_LEG_MM first, under current
  '  limits lowered to BLK_LIMIT_A: the stall then stays far under the harness's 10 A abort, which would otherwise stop
  '  the steering object before the protective stop could, and the push on the obstacle is gentle (the sheet's figure,
  '  about 14 N at each tyre at 2 A). Two kinds of trial, each its own steering lifetime and, since SRC_REV 69 (R4), each
  '  its own command and its own image -- one trial per run: BLK_COAST (holdAtStop(FALSE), SM_FLOAT), and BLK_BRAKE
  '  (holdAtStop(TRUE), SM_BRAKE, the control that shows the instrument can see a short). Each trial:
  '   1. the drive, watched every SAMPLE_MS: the travel guard; both wheels' protective codes, EVERY pass; each wheel's
  '      last hall tick (its driver's pos or the instrument's hwPos changing), stamped as it is seen; a wheel still for
  '      BLK_NOLATCH_MS with no latch ends it (NO_LATCH, the stop overdue), and the distance stop firing first -- getPower()
  '      0 unasked, every BLK_POLL_MS: a SPIN_DN reading cannot tell it from the path limiter scaling a wheel -- ends it
  '      NOT_BLOCKED (the obstacle was not met);
  '   2. once latched: BLK_PH_SETTLE_MS, then a BLK_PH_WIN_MS window of the ring -- each wheel's phase-sum mean at rest;
  '   3. getStopReason(); a drive, which must be refused with ERR_PLATFORM_BLOCKED (a drive it wrongly takes is stopped at
  '      once); clearEmergency(), which must NOT release it; clearProtectiveStop(), which must, both codes then NO_ERROR;
  '      then what is left of the leg armed (stopAfterRotation()) and a drive, which must be taken, and is stopped at once.
  '  SRC_REV 69: the run ends there. No step waits for him to pull it back (the wheels are off and roll freely): he
  '  returns the platform by hand before the next run.
  '  WHERE THE OBSTACLE STANDS (OBS_NEAR_MM .. OBS_FAR_MM, stated on the run sheet): the wheels must meet it AT SPEED
  '   and before the leg's stop begins. The start takes 5.3 ticks (31 mm), so 300 mm leaves ten times that for AT_SPEED
  '   and a steady field; the stop begins 4.4 + STOP_PLAN_EARLY_TICKS before the limit (31 mm), so 800 mm leaves 0.17 m
  '   for the platform's own reach ahead of its wheels.
  '  R21-DUAL-BLKSTOP-P (PL-106), COUNT of bad trials over the judged ones (latched, or a wheel still BLK_NOLATCH_MS): bad
  '   unless both codes read ERR_PLATFORM_BLOCKED, at least one wheel's stop reason is SR_BLOCKED and the other's
  '   SR_BLOCKED or SR_PARTNER (frontRecordBlocked(): the wheel blocked first, and its partner stopped for it), and
  '   EVERY SR_BLOCKED wheel had stood still -- no hall tick -- at least BLK_STAND_LO_MS, and its blocked count had run
  '   BLK_COUNT_LO_MS to BLK_COUNT_HI_MS, when the latch was read. THE BOUNDS ARE THE DRIVER'S OWN TEST (bFrontProtect():
  '   a commanded wheel with no hall tick whose |err| is at least LAG_SOFT or on which a limiter has acted since the wheel's
  '   last tick (PL-179 F-a, SRC_REV 77: sticky, in SPIN_UP or AT_SPEED), for BLOCKED_PASSES front passes in a row at 1 kHz).
  '   The latch cannot come before BLOCKED_PASSES
  '   after the last tick (BLK_STAND_LO_MS), and it lands BLOCKED_PASSES after the count began, which blockWatch()
  '   mirrors from the driver's status run (BLK_COUNT_LO_MS's CON). Each end carries BLK_STAMP_MS, the stamps' own
  '   lateness (a watch pass, under 2 x SAMPLE_MS with its reads, and one instrument period). SRC_REV 76 replaced the
  '   upper bound timed from the last tick (which assumed the field reached LAG_SOFT within a 156 ms travel):
  '   a rocking stand took ~430 ms (2026-09-30), so the harness gave up before the driver's count could finish. With
  '   D-5 a wheel stopped at its limit counts on its limiter, so the COAST trial against a yielding obstacle is expected
  '   to latch. NEGATIVE: a driver without the stop leaves a stalled wheel commanded -- Visit 6a's PL-93 wheel sat at
  '   duty_max reporting AT_SPEED until the harness's own abort -- so a wheel's count runs BLK_NOLATCH_MS unlatched; a
  '   latch under BLK_STAND_LO_MS, or one the mirrored count cannot explain, is a false fire (PL-116's class).
  '  R21-DUAL-PROTCLR-P (PL-111's API half: the path the serial protclear wraps), COUNT of bad latched trials: bad unless
  '   the drive while latched returns ERR_PLATFORM_BLOCKED, clearEmergency() leaves both codes latched,
  '   clearProtectiveStop() returns NO_ERROR with both codes NO_ERROR, the rest of the leg is armed, and the next drive
  '   returns NO_ERROR. NEGATIVE, in the run: the refused drive is the last step's own call before the clear, and
  '   clearEmergency() is the only release the serial host had before task 3606 (PL-111: emerclear), which must NOT
  '   release it.
  '  R21-DUAL-BLKCOAST-P (PL-132), MV, per motor: the COAST trial's phase-sum mean at rest, at least BLK_PH_SPLIT_MV.
  '  R21-DUAL-BLKSHORT-P, MV, per motor: the BRAKE trial's, under BLK_PH_SPLIT_MV (shorted) -- BLKCOAST's CONTROL: a
  '   wheel's BLKCOAST PASS counts only when its BLKSHORT passed, which shows this instrument tells a short from a coast
  '   on that wheel. SRC_REV 69: the two trials are two runs, so each log prints its own cell and NOMEAS for the other,
  '   and the pairing is judged in the analysis across the two logs. THE SPLIT IS MEASURED ON BOTH SIDES
  '   (debug_260923-192848.log, the LEFT wheel at rest after a forced
  '   fault): coasting (X-3, tid 1) the phase sum read 160-174 mV; shorted (X-2, tid 2) 11-25 mV. The START part's
  '   floated coast floor reads 55-64 mV per phase on BOTH boards (Visit 10 pass 7, BM-SKPROBE fl_*), so the right
  '   wheel's coasting sum sits where the left's does. 80 sits half the coast and three times the short. NEGATIVE:
  '   before DRIVER_REV 20 the protective stop shorted whatever the stop mode (PL-132), so COAST read the short's 11-25.
    BLK_POWER             = FL_SLOW_POWER                   ' 7, 0.16 m/s into the obstacle (was 13 on a chocked wheel)
    BLK_LIMIT_A           = 2                               ' peak and continuous: gentle on the obstacle, far under the abort;
                                                            '  MUST match gen_dual_assets.py BLK_LIMIT_A
    OBS_NEAR_MM           = 300                             ' where the obstacle stands (above); MUST match gen_dual_assets.py
    OBS_FAR_MM            = 800                             '  OBS_NEAR_M and OBS_FAR_M
    BLK_LATCH_MIN_MS      = (wheelL.BLOCKED_PASSES * MS_PER_SEC) / wheelL.FRONT_LOOP_HZ     ' 1_000
    BLK_STAMP_MS          = (2 * SAMPLE_MS) + (MS_PER_SEC / INST_RATE_HZ)                   ' 12
    BLK_STAND_LO_MS       = BLK_LATCH_MIN_MS - BLK_STAMP_MS                                 ' 988
    ' SRC_REV 76 (PL-168 item 1; D-5 ruled, STEPHEN 2026-10-02): THE BLOCKED COUNT IS TIMED FROM ITS OWN START, not from the
    '  last tick. The driver counts a pass when a commanded, driving wheel has no hall tick AND either |err| >= LAG_SOFT or a
    '  limiter has acted since the wheel's last tick (bFrontProtect(), PL-179 F-a; SRC_REV 77: the limiter half is the sticky
    '  flag bLimSinceTick, set by a limiter action in SPIN_UP / AT_SPEED and cleared by a tick or a state outside them), and
    '  latches after BLOCKED_PASSES such passes in a row.
    '  blockWatch() mirrors that rule from the driver's own status run each pass (the count begins the first pass after the
    '  last tick that shows either condition, and a pass showing neither -- no limiter since the tick and |err| under
    '  LAG_SOFT -- restarts it), so the latch must land BLOCKED_PASSES
    '  after the count began, within one stamp each way: BLK_COUNT_LO_MS .. BLK_COUNT_HI_MS. The old upper bound timed it
    '  from the last tick and assumed the field reached LAG_SOFT within BLK_LAG_MS; on the 2026-09-30 rocking stand it took
    '  ~430 ms, so the harness called NO_LATCH at 1,180 ms after the tick with the driver's count only ~750 ms in (PL-168).
    '  That bound (1,000 + a 156 ms field travel + a stamp, timed from the tick) and its inputs are deleted.
    BLK_COUNT_LO_MS       = BLK_LATCH_MIN_MS - BLK_STAMP_MS                                 ' 988
    BLK_COUNT_HI_MS       = BLK_LATCH_MIN_MS + BLK_STAMP_MS                                 ' 1_012
    BLK_NOLATCH_MS        = BLK_COUNT_HI_MS + BLK_STAMP_MS  ' a wheel's count run this long, no latch: the stop is overdue (1_024)
    BLK_POLL_MS           = 50                              ' getPower(), for the distance stop firing
    BLK_PH_SETTLE_MS      = 200
    BLK_PH_WIN_MS         = 500
    BLK_PH_SPLIT_MV       = 80
    BLK_DECIM             = 2                               ' 4 ms samples: the ring holds 16 s, the whole leg
  ' BLK_*: the trial kind, in order; BM_STATE_OBS_COAST + kind is its state word
    #0, BLK_COAST, BLK_BRAKE
    BLK_KINDS             = BLK_BRAKE + 1                   ' SRC_REV 69: was BLK_TRIALS, a loop bound; a run is one kind
#ifdef DBP_SPIN
    FLOOR_BLK_KIND        = FLOOR_ACT - FLA_OBST_COAST      ' the kind an OBSTACLE image runs: FLA_OBST_COAST is BLK_COAST, _SHORT BLK_BRAKE
#endif
    TOKMAX_BLK            = 5
  ' BLKSTOP_*: what ended an OBSTACLE trial's drive
  '  BLKSTOP_NOT_RUN    - it never drove; why names what stopped it
  '  BLKSTOP_LATCHED    - the protective stop latched (the event under test)
  '  BLKSTOP_NO_LATCH   - a wheel stood still BLK_NOLATCH_MS with no latch, and the harness stopped the drive
  '  BLKSTOP_LIMIT      - the leg's distance stop fired first: the obstacle was not met (NOMEAS, why NOT_BLOCKED)
  '  BLKSTOP_OPERATOR   - STOP on the panel (SRC_REV 69: no longer produced; the value holds)
  '  BLKSTOP_ABORT      - the 10 A abort, a stalled instrument, a fault flag, or a refused drive
  '  BLKSTOP_OVERTRAVEL - a wheel passed the leg by FL_OVER_TICKS and the harness e-stopped the platform
  '  BLKSTOP_TIMEOUT    - still driving at FL_LEG_MS, and the harness stopped it
    #0, BLKSTOP_NOT_RUN, BLKSTOP_LATCHED, BLKSTOP_NO_LATCH, BLKSTOP_LIMIT, BLKSTOP_OPERATOR, BLKSTOP_ABORT, ...
        BLKSTOP_OVERTRAVEL, BLKSTOP_TIMEOUT
    BLKSTOP_COUNT         = BLKSTOP_TIMEOUT + 1
    TOKMAX_BLKSTOP        = 10
  ' the bridge a phase window reads (BM-BLKCLR's bridge): COAST at or above BLK_PH_SPLIT_MV, SHORT under it
    #0, BRIDGE_NA, BRIDGE_COAST, BRIDGE_SHORT
    BRIDGE_COUNT          = BRIDGE_SHORT + 1
    TOKMAX_BRIDGE         = 5

  ' HELDATSPD, PL-95: the drive must not report AT_SPEED while its field is held. Over every OBSTACLE drive (command to
  '  latch) and every loaded window (GRAB's; SRC_REV 63: the incline's overloaded climb removed), on BOTH wheels
  '  (SRC_REV 62: was the chocked or dragged LEFT only; the obstacle blocks both), a stored up-sample is HELD when |err| >=
  '  LAG_SOFT, and BAD when it and the stored sample before it both read DCS_AT_SPEED with |err| >= LAG_HOLD (two in a
  '  row, so one sample whose state and err were read across a status copy cannot fail it).
  '  R21-DUAL-HELDATSPD-P, COUNT, BOTH: BAD samples, PASS at 0; n is the HELD samples, NOMEAS with none.
  '   NEGATIVE, MEASURED (PL-93's samples, debug_260919-173537.log tid 16 k 64-71): eight consecutive samples read
  '   AT_SPEED at e -101 and duty_max -- seven BAD -- and PL-95's ladder read AT_SPEED at duty_max from rung 7 up. The
  '   fixed driver turns AT_SPEED to SPIN_UP on every pass its field is held (holdDecay), and the ramp waits for a
  '   trailing rotor, so a held wheel never reaches it.
    HELD_BAD_LO           = 0
    HELD_BAD_HI           = 0

  ' 2. GRAB ONE SIDE, PL-150 / PL-144 / PL-95 (segment GRAB; SRC_REV 58's LOAD dragged the left side by a strap over
  '  2 m at power 13). A straight drive, driveAtPower(LOAD_POWER, LOAD_POWER), its distance stop armed at FL_LEG_MM
  '  before it moves, both wheels' current limits lowered to LOAD_LIMIT_A so his hand on the frame is more than a wheel
  '  can drive at its command. He walks beside its LEFT side. SRC_REV 69 (Stephen 2026-09-30, R4, R5, R14: "time it";
  '  hold "until it stops"): ONE trial and one cue, which is the run sheet's, not a screen's: about 3 s after it starts
  '  rolling he takes hold of the frame's left side and KEEPS HOLDING until it stops by itself at 1 m -- there is no let-go
  '  count. The program times the judged window from the start of the drive: it opens LOAD_PULL_LEAD_MS after the farther
  '  wheel passes LOAD_GRAB_TICKS (LOAD_GRAB_MM, about 2.6 s after it starts rolling) and lasts LOAD_WIN_MS, so it lies
  '  inside any hold taken between about 2.5 s and 3.5 s, and prints no cue. The run ends at its limit: no drive back (he
  '  returns the platform by hand). The trial ends as one LDO_*: OVERLOAD and FAULT are judged, LIGHT asks for a harder
  '  hold and STALLED (the protective stop latched: more than any speed could sustain) for a lighter one, in the RESULT
  '  line, for the next run.
  '  THE SPEED AND THE POINT FIT THE JUDGED WINDOW INSIDE THE HALF METRE AFTER THE GRAB (the old LOAD, at power 13 over
  '   2 m, spent about 1.2 m on its window). At SLOW the platform is at speed by 5.3 ticks; the GRAB prompt comes at
  '   LOAD_GRAB_TICKS (69, 0.4 m), so he takes hold within the lead, at 0.4-0.55 m; the lead at up to full speed is 27
  '   ticks and the window at up to 88 % (the held wheel under LOAD_OVL_PCT, the other within LDPATH's band of it) 59.4:
  '   155.4 in all, against the stop's start at 173 - 4.4 - STOP_PLAN_EARLY_TICKS = 167.6, 12 ticks spare. A trial he
  '   hardly slows (100 % throughout) still ends its window at 163.5, before the stop begins. At power 13 the window
  '   alone would cover 134 ticks, most of the leg.
  '  R21-DUAL-LDPATH-P (PL-150, the path limiter), PERMILLE, platform: over the judged window, |left - right| hall ticks
  '   (the instrument's own decode) over the larger, at most LOAD_LINE_PM: both wheels slowed together and the platform
  '   kept its line. NEGATIVE: with no path limiter the free wheel keeps its whole command while the held one runs under
  '   LOAD_OVL_PCT of its own, so the precondition alone guarantees a true mismatch of at least 1000 - 10 x LOAD_OVL_PCT
  '   = 200 thousandths. NOMEAS without a judged trial, or when the larger travel is under LOAD_MIN_TICKS.
  '   LOAD_MIN_TICKS, SRC_REV 62, RE-DERIVED for the shorter window (was 20): each wheel's count over a window is good to
  '   a tick at either end, so their difference to 2, and a follower delayed along the S-curve adds about 1 (SRC_REV
  '   60's note): 3 ticks must stay inside LOAD_LINE_PM, so the larger travel is at least 30, and the negative's 200 then
  '   still reads over (200 x 30 / 1_000 - 2) / 30 = 133 thousandths. At about half speed the window covers 34 ticks.
  '  R21-DUAL-LDHUNT-P (PL-144, the path limiter's hunting), COUNT, platform: the EV_PATH_LIMIT TRANSITIONS (engages,
  '   value under full scale, AND releases, full scale) stamped inside the judged window (the one LDPATH and LDHOLD judge:
  '   LOAD_PULL_LEAD_MS after the grab point, for LOAD_WIN_MS), exactly LOAD_HUNT_LO = LOAD_HUNT_HI = 0: a limiter that
  '   engaged and held through a sustained hold does not change state. SRC_REV 70 (arbiter): it counted the engages of
  '   the whole lifetime, so the free start-up's, the limiter matching two wheels that start unevenly on the floor, FAILed
  '   it; they are BM-LOADW's engages_pre, printed and not judged. PRECONDITION, else NOMEAS: the limiter is engaged over
  '   the window -- a wheel's last EV_PATH_LIMIT before it was an engage, or an engage occurs inside it (BM-LOADW engaged).
  '   NEGATIVE, DERIVED from what was MEASURED (Visit 10 pass 6, dual-d's BLOCK step, the pre-fix limiter under a wheel
  '   that could not keep up): an engage-and-release cycle every 720-790 ms, so a transition about every 360-395 ms and
  '   at least 3 inside LOAD_WIN_MS (2_500 ms), against the bound 0. NOMEAS without a judged trial.
  '   PRECONDITION: the limiter engaged over the window (engaged before it, or an onset inside it).
  '   BOUND: 0 transitions, counted after each wheel's onset (SRC_REV 82, PL-192).
  '   CORRECT CASE: one engage inside the window held to the stop (2026-10-02c, 15_588 ms) reads 0: inside the bound.
  '  R21-DUAL-LDHOLD-P (PL-150, the overload hold), MS, the gripped wheel (LOAD_GRIP_SLOT, the LEFT; one instance):
  '   over the judged window, the longest gap between that wheel's hall ticks, at most LOAD_GAP_HI_MS -- it kept turning,
  '   at the speed it could sustain -- with no fault (a fault scores LOAD_GAP_FAULT_MS). SRC_REV 63 (Stephen, 2026-09-28):
  '   THIS RUN IS THE OVERLOAD HOLD'S ONLY PROOF -- the incline's overloaded climb, which also judged it, is removed.
  '   PRECONDITION: the grip actually held the wheel below its command -- in the window it read SHORT (its lag limiter
  '   held) and ran under LOAD_OVL_PCT of its command's rate, with no latch (LDO_OVERLOAD); or a wheel faulted (LDO_FAULT,
  '   the negative). Otherwise NOMEAS for that trial: LIGHT (NOT_OVERLOADED) and the RESULT line asks for a firmer grip
  '   next run, STALLED and it asks for a lighter one. The bound is
  '   BLK_LATCH_MIN_MS: a held wheel still that long latches the protective stop (STALLED, not judged), so a longer gap
  '   with no latch is a field that stopped without being held.
  '   NEGATIVE: a driver with no lag limiter faults FC_LAG when |err| reaches 125 (task 3558's reason); one whose hold
  '   decays the field to zero stands still, unheld and unlatched (the decay fix of DRIVER_REV 3): each fails the band.
  '  SRC_REV 81 (PL-189), THREE CHANGES TO WHAT GRAB JUDGES (HOLD-SPEED-UNDER-LOAD-DESIGN.md sec 4.12.8). Each is a premise the
  '   second visit's grab (debug_261002-143538.log: BM-LOADW l_pct 19, r_pct 57, l_gap 544, mis_pm 666; EV_FAULT_RESYNC seq 16 at
  '   19_234 ms, EV_FAULT seq 19 at 19_360; BM-EV FOLDBACK LEFT 15_030 ms value 0, not released until 20_342) or the model showed:
  '   1. LDHOLD is judged only when the gripped wheel ran LDHOLD_PCT_LO (15) % or more of its command (BM-LOADW l_pct), else NOMEAS
  '      with BM-LDFLT's hold_why NEAR_STOP. A hold that leaves a wheel near a stop gives tick gaps of 1_127-1_142 ms on a CORRECT
  '      drive (the model's steady hold under both drives, sec 4.12.8), so a gap over LOAD_GAP_HI_MS there is the hand, not the
  '      drive, and a cell that read it could fail a correct drive. At 15 % of the SLOW walk's 26.9 ticks/s a tick comes about
  '      every 250 ms, a quarter of the bound. On 2026-10-02 l_pct is 19: judged, and the fault scores LOAD_GAP_FAULT_MS (FAIL, as before).
  '   2. LDPATH is NOMEAS with BM-LDFLT's path_why LIMIT_HELD when the gripped wheel's fold-back was engaged in the judged
  '      window (loadEvents(): an EV_FOLDBACK engage before the window and not released, or any EV_FOLDBACK inside it). A PREMISE
  '      CHANGE (S-b, sec 4.12.7): while a wheel is held at its current limit drv_incr is not the field's speed, and the steering
  '      object's shortfall (shortfallNow()), which the path limiter reads, takes it as the field's speed, so the path limiter does not
  '      engage for a wheel held at its limit and the other wheel is not slowed to keep the platform's line. LDPATH's criterion (the hall-tick mismatch, 100
  '      thousandths) is unchanged and still judges a hold that slowed the wheel with no fold-back acting (a drag under the
  '      limit), where the premise holds; at LOAD_LIMIT_A a grab that overloads the wheel always engages the fold-back, so on this
  '      trial LDPATH reads NOMEAS and the line on a grab is recorded as the design's known limit (S-b, the rejected U-3), not
  '      certified. On 2026-10-02 the LEFT fold-back engaged at 15_030 ms and held through the window: NOMEAS in place of FAIL 666.
  '   3. R22-DUAL-LDFLT-P (new; I-9'): from the grab point to the leg's end no EV_FAULT and no EV_FAULT_RESYNC on either wheel
  '      (evDrain()'s EV_FAULT / EV_FAULT_RESYNC counts stamped at or after the grab, ldGrabAtMs), BOOL. PRECONDITION, else NOMEAS
  '      with BM-LDFLT's flt_why: the grip held the gripped wheel slowed but still moving -- BM-LOADW l_pct LDFLT_PCT_LO .. LDFLT_PCT_HI
  '      (5-60; NEAR_STOP under it, NOT_SLOWED over it) -- the window read (NO_SAMPLES), the drain read whole (EVENTS_LOST) and the grab
  '      reached (NOT_REACHED). NEGATIVE, on disk (debug_261002-143538.log): EV_FAULT_RESYNC LEFT seq 16 (19_234 ms) and EV_FAULT LEFT
  '      seq 19 (19_360) after the grab (grab_ms 2_778 into the drive) with l_pct 19 -- FAIL. A fault under a wheel held near a stop
  '      (l_pct under 5) is not this cell's: the RESULT line and BM-LOAD's outcome FAULT still say it. RIVAL EXPLANATION: the hand
  '      stopped the wheel outright, so any drive would fault it; the l_pct band excludes the wheel that stopped, and a wheel at 5 % or
  '      more was still driven by the field (a tick about every 750 ms at SLOW) and is the case the hold must keep from faulting.
    LDHOLD_PCT_LO         = 15                              ' LDHOLD's least l_pct (above, 1.)
    LDFLT_PCT_LO          = 5                               ' LDFLT: the gripped wheel ran at least this % of its command (slowed, but moving)...
    LDFLT_PCT_HI          = 60                              ' ...and no more than this % (the grab did slow it)
    LOAD_POWER            = FL_SLOW_POWER                   ' 7 (was 13 over 2 m): the window fits the half metre (above)
    ' LOAD_LIMIT_A, SRC_REV 78 (PL-185), 4 -> 2: THE LIMIT A HAND CAN REACH. DERIVED from the 2026-10-02 obstacle trials, MEASURED: at
    '  2 A the platform drove to the obstacle at power 7 on both trials (debug_261002-103634.log, contact at about 373 mm), so 2 A
    '  carries the slow walk (LOAD_POWER is that power). At 4 A the hand reached the fold-back only briefly -- EV_FOLDBACK 53 and 44
    '  frames on run 1, 25 on run 2 (debug_261002-103814.log, debug_261002-103915.log) -- and the wheels held 98-101 % of their
    '  command, so the hold did not overload them; at half that limit the same hand is past it for most of the hold. The cells' criteria are unchanged
    LOAD_LIMIT_A          = 2                               ' peak and continuous; MUST match gen_dual_assets.py LOAD_LIMIT_A
    LOAD_TRAVEL_MM        = FL_LEG_MM                       ' 1 m (was 2 m)
    LOAD_TRAVEL_TICKS     = FL_LEG_TICKS                    ' 173
    LOAD_GRAB_MM          = 400                             ' the grab point (above): the judged window is timed from it
    LOAD_GRAB_TICKS       = (LOAD_GRAB_MM * SPIN_X100) / TICK_MM_X100                       ' 69
    LOAD_ATSPEED_MS       = 4_000
    LOAD_GRAB_WAIT_MS     = 6_000                           ' to the grab point: 0.4 m at 0.16 m/s is 2.6 s after the start
    LOAD_PULL_LEAD_MS     = 1_000                           ' was 1_500 (a strap to take up); 27 ticks at full speed
    LOAD_WIN_MS           = 2_500
    LOAD_PULL_MS          = LOAD_PULL_LEAD_MS + LOAD_WIN_MS                                  ' the judged window's end, from the grab point
    ' LOAD_LEG_MS, SRC_REV 69 (Stephen 2026-09-30, R14: "he holds until it stops"): THE GRAB DRIVE'S TIME BOUND, raised from
    '  FL_LEG_MS. A held drive is slower than a free one: the first LOAD_GRAB_TICKS run free, the last LOAD_TRAVEL_TICKS -
    '  LOAD_GRAB_TICKS (104, 0.6 m) run at the speed his hold lets the platform keep. DERIVED, at the SLOW walk's
    '  FL_SLOW_RATE_X10 (26.9 ticks/s; the run sheet's model of the jerk-limited start: 0.39 s and 5.3 ticks, of the stop:
    '  0.31 s): the free part is LOAD_FREE_MS = 390 + (69 - 5.3) / 26.9 = 2_758 ms; the stop LOAD_STOP_MS 310 ms; the held
    '  part at half speed 104 / 13.45 = 7_732 ms, so a held run ends at about 10_800 ms. FL_LEG_MS (12_000) is only 1_200
    '  over that, and a hold that keeps the platform under about 43 % of its speed (104 ticks in the 8_932 ms it leaves) would outlast it and be cut (a
    '  LDSTOP_TIMEOUT, ended by the harness). The bound now covers a hold down to LOAD_HELD_MIN_PCT, a quarter of the
    '  speed (LOAD_HELD_MS, 15_464 ms; slower than that and the wheel is near still, and stalls into the protective stop
    '  after BLK_LATCH_MIN_MS), plus both ramps: 18_532 ms, to whole seconds (18) and LOAD_LEG_ROUND_S more: 20_000. The judged window's timing
    '  (LOAD_GRAB_MM, LOAD_PULL_LEAD_MS, LOAD_WIN_MS) is unchanged. The bound stops nothing that moves on purpose: the leg
    '  is armed at FL_LEG_MM and the travel guard stays live.
    LOAD_PCT_SCALE        = 100                             ' a percentage's scale (the window's ticks over the command's rate)
    LOAD_START_MS         = 390                             ' the SLOW start (jerk-limited): its time ...
    LOAD_START_TICKS_X10  = 53                              ' ... and its travel, 5.3 ticks x10
    LOAD_FREE_MS          = LOAD_START_MS + ((((LOAD_GRAB_TICKS * X10) - LOAD_START_TICKS_X10) * MS_PER_SEC) / FL_SLOW_RATE_X10)     ' 2_758
    LOAD_STOP_MS          = 310                             ' the SLOW stop (jerk-limited)
    LOAD_HELD_MIN_PCT     = 25                              ' the slowest hold the bound covers, % of the command's speed
    LOAD_HELD_MS          = ((LOAD_TRAVEL_TICKS - LOAD_GRAB_TICKS) * X10 * LOAD_PCT_SCALE * MS_PER_SEC) / (FL_SLOW_RATE_X10 * LOAD_HELD_MIN_PCT)   ' 15_464
    LOAD_LEG_ROUND_S      = 2                               ' the sum is rounded down to whole seconds and this many more are added
    LOAD_LEG_MS           = (((LOAD_FREE_MS + LOAD_HELD_MS + LOAD_STOP_MS) / MS_PER_SEC) + LOAD_LEG_ROUND_S) * MS_PER_SEC               ' 20_000
    LOAD_OVL_PCT          = 80
    LOAD_LINE_PM          = 100
    LOAD_MIN_TICKS        = 30                              ' re-derived above (was 20)
    LOAD_GAP_HI_MS        = BLK_LATCH_MIN_MS
    LOAD_GAP_FAULT_MS     = 99_999
    LOAD_GRIP_SLOT        = SLOT_LEFT                       ' the wheel he holds back (the frame's LEFT side): LDHOLD's
    LOAD_HUNT_LO          = 0                               ' LDHUNT: no path-limiter transition inside the window (derivation above)
    LOAD_HUNT_HI          = 0
    LOAD_DECIM            = 2
    LOAD_POLL_MS          = 50
  ' LDO_*: how a loaded trial ended
  '  LDO_NOT_RUN  - it never drove; why names what stopped it
  '  LDO_OVERLOAD - the loaded wheel read SHORT in the window and ran under LOAD_OVL_PCT: judged
  '  LDO_FAULT    - a wheel faulted: judged (LDHOLD's negative)
  '  LDO_LIGHT    - the load did not overload the wheel (NOT_OVERLOADED)
  '  LDO_STALLED  - the protective stop latched (STALLED)
  '  LDO_ABORT    - STOP, the abort, the travel guard or an instrument stall ended it, or its window was cut short
    #0, LDO_NOT_RUN, LDO_OVERLOAD, LDO_FAULT, LDO_LIGHT, LDO_STALLED, LDO_ABORT
    LDO_COUNT             = LDO_ABORT + 1
    TOKMAX_LDO            = 8
  ' LDSTOP_*: what ended a loaded trial's drive
  '  LDSTOP_NOT_RUN    - it never drove
  '  LDSTOP_LIMIT      - its distance stop brought it to rest (its good end)
  '  LDSTOP_OPERATOR   - STOP on the panel (SRC_REV 69: no longer produced; the value holds)
  '  LDSTOP_ABORT      - the 10 A abort, a stalled instrument or a refused drive
  '  LDSTOP_OVERTRAVEL - a wheel passed the distance stop by FL_OVER_TICKS and the harness e-stopped it
  '  LDSTOP_FAULT      - a wheel faulted (the platform policy stopped the other)
  '  LDSTOP_BLOCKED    - the protective stop latched
  '  LDSTOP_TIMEOUT    - still moving at LOAD_LEG_MS, and the harness stopped it
    #0, LDSTOP_NOT_RUN, LDSTOP_LIMIT, LDSTOP_OPERATOR, LDSTOP_ABORT, LDSTOP_OVERTRAVEL, LDSTOP_FAULT, LDSTOP_BLOCKED, ...
        LDSTOP_TIMEOUT
    LDSTOP_COUNT          = LDSTOP_TIMEOUT + 1
    TOKMAX_LDSTOP         = 10

  ' 3. INCLINE (segment INCLINE; SRC_REV 36's CREEP, where he carried the platform onto the incline for each trial). Up
  '  about FL_LEG_MM of a ~10 degree slope in INC_LEGS legs of INC_LEG_MM at SLOW, one steering lifetime started on the
  '  flat at the slope's foot (the start checks float the bridge, so it must not start on the slope), every leg armed
  '  first and ended at rest by its own limit, then FL_LEG_MM back down to the start -- one START for the whole sequence,
  '  which the READY screen states, so the platform never waits on a screen while on the slope:
  '   each leg ends at one of the three creep stops (CRK_COAST, CRK_LOWCEIL, CRK_HOLD above): each stop's hold setting
  '     is made before its leg, the platform comes to rest ON the slope, and the watch runs from there (creepWatch());
  '     the third leg's stop, the hold's, is at the top;
  '   then down: the net climb on the drivers' own hall positions from where the lifetime began, armed first.
  '  SRC_REV 63 (Stephen, 2026-09-28): THE INCLINE PROVES ONLY THE HOLD ON A SLOPE. SRC_REV 62's fourth leg, an
  '   overloaded climb to the top at 2 A judged for LDHOLD, is removed: whether a slope overloads a wheel on its start
  '   depended on the platform's mass, and GRAB ONE SIDE alone proves the overload hold (its CON, 2.). The three legs
  '   now share the whole metre, so the hold's stop is where the overloaded climb ended.
  '  THE ENVELOPE, RE-DERIVED: INC_LEGS legs of INC_LEG_TICKS (57, 328 mm) at SLOW, 171 ticks up at most, inside the
  '   rule's metre; each leg is 5.3 ticks up to speed, 4.4 + STOP_PLAN_EARLY_TICKS to stop, and 46.3 at 26.9 ticks/s:
  '   about 2.4 s, against its FL_LEG_MS bound. The coast control rolls back CREEP_CTRL_TICKS (3) and a little more
  '   before the harness brakes it, and the low ceiling creeps back up to CREEP_BOUND_TICKS (6), so the stops rest at
  '   about 53, 104-108 and 161-165 ticks up, and the net climb is 171 less those two. The drive down is armed with it
  '   (clamped to FL_LEG_TICKS + FL_OVER_TICKS): at most 171 ticks, about 6.7 s at SLOW. The slope must run a metre past
  '   the drive wheels plus the platform's length, as before.
  '  The travel guard and the watches read the halls: a tyre that slips on a loose surface is not seen (CREEP, above).
    INC_LEGS              = 3                               ' three stops, the hold's at the top (SRC_REV 63: was 4)
    INC_LEG_MM            = FL_LEG_MM / INC_LEGS            ' 333
    INC_LEG_TICKS         = (INC_LEG_MM * SPIN_X100) / TICK_MM_X100                         ' 57 (was 43)
    INC_POWER             = FL_SLOW_POWER

CON { --- the floor sessions: FLOOR_ACT_AUTO and FLOOR_ACT_OBSTACLE (SRC_REV 70; Stephen 2026-09-30: R15, R16, R17) --- }

  ' WHAT A SESSION IS (Plan A sec 10). R15 (Stephen 2026-09-30: "As long as you don't need me interceding, running multiple checks
  '  per command is just fine. The only reason we did that single check per command is because you needed me at each one.") refines
  '  R4: one command chains every check that needs no hand between them. Two sessions, each from the single actions' own code:
  '   FLOOR_ACT_AUTO     (tier floor-auto): (1) the ten spin legs, alternating direction (each RIGHT leg followed by its LEFT pair, so
  '                      the platform ends each pair facing where it began), each in its own pair lifetime with the driver's event log
  '                      drained after it; (2) the fault run, whole, with its two STAND CLEAR waits; (3) the ramp legs.
  '   FLOOR_ACT_OBSTACLE (tier floor-obstacle): the COAST trial, an armed drive back to its start, the BRAKE trial, back again.
  '  He stands by and does nothing. Every session starts at his fixed start point and ends there; he resets it by hand between
  '  sessions. A FAILED STRAIGHT (a drive the harness could not complete: a fault not recovered, an abort, an overtravel, a drive
  '  the fence refused, a platform not back at its start) skips the session's remaining straight actions and prints why
  '  (saySkipped(), WHY_STRAIGHTS_SKIPPED); a spin is in place, so the spins go on after a failed spin.
  '
  ' THE FENCE (R17, Stephen 2026-09-30: "As long as you keep the robot in a 2 m by 2 m square area, it can run independently.").
  '  The run stays inside a 2 m x 2 m square. The fixed start point is FENCE_REAR_MM in from the square's rear edge, centred
  '  across, the platform facing across the square. The platform's position in the START FRAME -- the origin at the start point, x
  '  along its start heading, y to its left -- is dead-reckoned from both wheels' hall counts, which the instrument's mirror of
  '  each driver's own pos gives (fenceAdvance(), at the end of every leg): the mean of the two wheels' forward travel along the
  '  heading at the leg's middle, and the heading from their difference over the track (a full platform turn is the two tyres
  '  rolling 2 x pi x TRACK_MM apart, 2 x SPIN_LEG_TICKS ticks of difference; the quarter's legs turn twice). A SPIN changes the heading and, by the mean, hardly
  '  the position. A right wheel's forward is its raw pos NEGATIVE (the steering object reverses it: l_trav 173, r_trav -168 on
  '  every forward leg), so its forward travel is the negated change. Before EVERY straight leg bFenceAllows() computes where the
  '  leg's planned travel could end and REFUSES it (BM-FENCE, a plain FENCE line, WHY_FENCE_REFUSED) when that point would put
  '  the platform past the square. THE WORST-CASE END of a leg armed at its declared travel of nLegTicks is nLegTicks +
  '  FL_OVER_TICKS ticks along the heading: the distance stop's planned travel is INSIDE the declared travel (the front cog
  '  begins the stop early by its own stopping distance and the platform comes to rest at the limit, STOP_LIMIT_HI of it), so
  '  the planned stop is not added again; FL_OVER_TICKS, 6 ticks (35 mm), is the harness's own guard, which e-stops a leg that far
  '  past its declared travel. The square's edges are then pulled in by FENCE_ENV_MM, the platform's half-length and the slack.
  '  Nothing here runs inside a timed wait: the fence is checked before a leg is armed and updated after it has come to rest.
  '  FENCE_HALF_LEN_MM is AN ASSUMPTION TO CONFIRM: no document in this tree gives the platform's length. The run sheet's lane,
  '  1.5 m long and 0.5 m wide for a 1 m leg, leaves 0.5 m for the platform's length and width, so its half-length is taken as
  '  250 mm, and the envelope as a circle of that radius about the wheel axle's midpoint (every heading, every edge). FENCE_SLACK_MM
  '  is ASSUMED too: the dead reckoning's error (tyre slip, the heading's own error across a metre: 5 degrees is 87 mm) and what a
  '  short-circuited e-stop rolls on from walking speed (v^2 / 2a: about 16 mm at 0.31 m/s and 0.3 g). Both are named so they can
  '  be changed.
    FENCE_SQUARE_MM       = 2_000                           ' R17: the square's side
    FENCE_REAR_MM         = 500                             ' R17 (Plan A sec 10): the start point about 0.5 m in from the rear edge
    FENCE_HALF_LEN_MM     = 250                             ' ASSUMPTION TO CONFIRM (above): the platform's half-length
    FENCE_SLACK_MM        = 100                             ' ASSUMED (above): dead-reckoning error and an e-stop's roll
    FENCE_ENV_MM          = FENCE_HALF_LEN_MM + FENCE_SLACK_MM                  ' 350: the envelope about the axle's midpoint
    FENCE_X_LO_MM         = 0 - FENCE_REAR_MM + FENCE_ENV_MM                    ' -150: the axle midpoint's rearmost allowed x
    FENCE_X_HI_MM         = FENCE_SQUARE_MM - FENCE_REAR_MM - FENCE_ENV_MM      ' 1_150: ...and its farthest
    FENCE_Y_HI_MM         = (FENCE_SQUARE_MM / 2) - FENCE_ENV_MM                ' 650: ...and to either side
    FENCE_Y_LO_MM         = 0 - FENCE_Y_HI_MM
    ' FENCE_HOME_MM: a straight action ends "where it started" when the platform's estimate is within this of the start point. A
    '  leg back that follows a fault turns the platform a few degrees (the graded partner stop, under 7 degrees: 6.8 at the
    '  worst, the floor situations' CON, 4.), so a metre on the same heading ends up to 1_000 x sin(7 degrees) = 122 mm to one
    '  side; twice that is the tolerance. Within it the next leg's own fence check still holds the square
    FENCE_HOME_MM         = 250
    ' FENCE_ANGLE_PER_TICK: the heading change, in the CORDIC's angle units (2^32 to a turn), for ONE tick of difference between
    '  the wheels' forward travel. One turn is 2 x SPIN_REV_MM_X100 / TICK_MM_X100 = 422.15 ticks of difference, so a tick is
    '  2^32 x TICK_MM_X100 / (2 x SPIN_REV_MM_X100) = 2^31 / SPIN_REV_MM_X100 x TICK_MM_X100 = 10_173_888 (the divide truncates
    '  the quotient's 0.3: 0.0016 %, 0.006 degrees in a turn). Multiplied by a difference of up to 845 ticks (SRC_REV 74: the
    '  quarter's legs turn twice, 2 x 422; 423 for one turn) the product wraps past 2^32 once or twice, each exactly a turn
    '  more, so the 32-bit product is the heading change modulo a turn
    FENCE_ANGLE_PER_TICK  = ($8000_0000 +/ SPIN_REV_MM_X100) * TICK_MM_X100
    FENCE_TENTHS_PER_TURN = 3_600                           ' a heading is printed in tenths of a degree
    FENCE_TOP_SHIFT       = 16                              ' its top 16 bits, signed: a turn is 65_536 of them
    FENCE_TOP_SCALE       = 65_536
    SESS_BACK_MIN_TICKS   = 2                               ' a drive back under this is not made: the trial moved the platform less

  ' THE RAMP LEGS (Plan A sec 10, R16: acceleration 200-3_000 and deceleration 1_000-3_000 mm/s^2, "the ends and middle of the
  '  FlySky knob ranges"). Four straight legs of FL_LEG_MM, out and back in pairs, in one steering lifetime, each at its own
  '  setAcceleration() / setDeceleration() (mm/s^2 at the rim); the ranges' ends and middle are LO, the built-in (MID) and HI:
  '    leg 1 OUT  (200, 1_000)   leg 2 BACK (1_000, 1_470)   leg 3 OUT (3_000, 3_000)   leg 4 BACK (1_000, 1_470)
  '  so the three accelerations and the three decelerations each run once or more and each out-and-back returns to the start. The
  '  built-in rates are restored before the lifetime stops (the setters are kept across stop() and start(), PL-160).
  '  THE POWER, DERIVED. The S-curve's rise to speed v at acceleration A (and the same shape down) takes v / A + TAU when v is at
  '   least A x TAU (the acceleration reaches A and holds), TAU = RAMP_TAU_MS, and 2 sqrt(v TAU / A) when it is not; it covers v x
  '   time / 2 either way (the velocity profile is antisymmetric about its middle). The slowest rise is A = RAMP_ACCEL_LO, and
  '   the slowest stop RAMP_DECEL_LO, which follow it on leg 1 -- and the leg must hold both with room to spare, or the platform
  '   never reaches AT_SPEED and its peak is a fiction. The rule: the rise at A = 200 plus the stop at D = 1_000 take at most half
  '   the leg (RAMP_ROOM_LIMIT_MM, 500 mm), so at least half is left at speed. Of the harness's own named powers (SLOW 7, FLR 10,
  '   MEDIUM 13, BRISK 23) the fastest that keeps the rule is MEDIUM, RAMP_POWER 13: 308 mm/s, a rise of 1_790 ms over 275 mm
  '   and a stop of 558 ms over 85 mm, 360 mm in all (BRISK, 566 mm/s, would take 871 mm for the rise alone). The ramp is VISIBLE
  '   there: the rise at 200 mm/s^2 takes 1.79 s, at the built-in 1_000 0.56 s, and at 3_000 (308 < 3_000 x TAU = 750 mm/s, so a
  '   triangle, 2 sqrt(308 x 250 / 3_000) = 0.32 s) 0.32 s. At 3_000 the platform never holds its limit at this speed: its
  '   peak acceleration is sqrt(v A / TAU) = 1_922 mm/s^2, and BM-RAMPLEG prints that prediction (p_up, p_dn) beside what was
  '   read, so a difference from the setting is never read as a defect. A stop at 1_470 holds its limit only above 1_470 x TAU =
  '   367 mm/s, so it too is a triangle here (peak 1_345); the records say so
    RAMP_LEGS             = 4
    RAMP_POWER            = 13                              ' MEDIUM's (spinPower): derived above
    RAMP_INCRE            = LIB_MIN_FWD_INCRE + (((LIB_MAX_FWD_INCRE - LIB_MIN_FWD_INCRE) / (POWER_FULL - POWER_MIN)) * (RAMP_POWER - POWER_MIN))
    RAMP_RATE_X10         = ((RAMP_INCRE / PRED_INCRE_DIV) * PRED_MUL) / PRED_DIV          ' ticks/s x10 (C-1's law): 536
    RAMP_V_MM_S           = (RAMP_RATE_X10 * TICK_MM_X100) / 1_000                        ' mm/s: 308
    RAMP_TAU_MS           = wheelL.RAMP_TAU_MS              ' 250: every ramp eases its acceleration in and out over this
    RAMP_ACCEL_LO         = 200                             ' R16: the bottom of VRA's range
    RAMP_ACCEL_MID        = RAMP_DEF_ACCEL_MM_S2            ' 1_000: the built-in rate, the middle of the range
    RAMP_ACCEL_HI         = 3_000                           ' R16: the top of VRA's range
    RAMP_DECEL_LO         = 1_000                           ' R16: the bottom of VRB's range
    RAMP_DECEL_MID        = RAMP_DEF_DECEL_MM_S2            ' 1_470: the built-in rate
    RAMP_DECEL_HI         = 3_000                           ' R16: the top of VRB's range
    RAMP_SLOW_UP_MS       = ((RAMP_V_MM_S * MS_PER_SEC) / RAMP_ACCEL_LO) + RAMP_TAU_MS      ' 1_790: leg 1's rise
    RAMP_SLOW_UP_MM       = (RAMP_V_MM_S * RAMP_SLOW_UP_MS) / (2 * MS_PER_SEC)              ' 275
    RAMP_SLOW_STOP_MS     = ((RAMP_V_MM_S * MS_PER_SEC) / RAMP_DECEL_LO) + RAMP_TAU_MS      ' 558: leg 1's stop
    RAMP_SLOW_STOP_MM     = (RAMP_V_MM_S * RAMP_SLOW_STOP_MS) / (2 * MS_PER_SEC)            ' 85
    RAMP_ROOM_MM          = RAMP_SLOW_UP_MM + RAMP_SLOW_STOP_MM                              ' 360: the rise and the stop
    RAMP_ROOM_LIMIT_MM    = FL_LEG_MM / 2                   ' 500: the rule, at most half the leg
    RAMP_ACCEL_IDX        = wheelL.DRVR_STATUS_ACCEL_NOW_IDX                                 ' drv_accel_now in the driver's status run
    RAMP_DECIM            = INST_DECIM_MAX                  ' the capture is armed for its mirror only: the legs read no ring sample
    TOKMAX_RSET           = 7
  ' RSET_*: what a BM-RAMPSET is: a leg's own setting, or the built-in rates' restore
    #0, RSET_LEG, RSET_RESTORE
    RSET_COUNT            = RSET_RESTORE + 1

  ' FEN_*: which drive a BM-FENCE is about; FENEV_*: its plan (before the leg) or its estimate (after it)
    #0, FEN_SPIN, FEN_FR_OUT, FEN_FR_BACK, FEN_FR_REDRIVE, FEN_OBST, FEN_OBST_BACK, FEN_RAMP
    FEN_COUNT             = FEN_RAMP + 1
    TOKMAX_FENWHAT        = 9
    #0, FENEV_PLAN, FENEV_DONE
    FENEV_COUNT           = FENEV_DONE + 1
    TOKMAX_FENEV          = 4

  ' SBK_*: what became of an obstacle trial's drive back (sessBackState)
  '  SBK_NONE     - none was attempted: the trial never drove, or it moved the platform under SESS_BACK_MIN_TICKS
  '  SBK_RETURNED - it was made and came to rest at its limit
  '  SBK_FAILED   - it was not made (the fence, or the platform not clear to move) or did not come to rest at its limit
    #0, SBK_NONE, SBK_RETURNED, SBK_FAILED

  ' The RESULT line of a session is composed in one buffer (resCat(), resCatNum()) and printed by sayResult() as its one line
    RES_BUF_BYTES         = 600
    RES_RADIX             = 10

#ifdef DBP_SPIN
DAT ' ---- SPIN tables ----

' per SPIN_SPEED_*: the power driveAtPower() is given; the steady window's length; and the lead the schedule gives at the
'  commanded increment, in tenths -- MIRRORED ON PURPOSE from isp_bldc_motor.spin2's leadTenthsTbl (205 up to the
'  eighth, 50 at the quarter, the step between truncated by leadTenthsForIncrement()) as SPINOFF's independent
'  expectation: reading it back from the driver would judge the driver against itself.
' THE WINDOWS MUST END BEFORE THE LEG'S LIMIT FIRES: the limit fires where the travel plus the stop's own plan reaches
'  the leg's ticks (spinLegTicks), and a window cut by it reads its end values (spinReads(): A-8, the path scale, the
'  pair) on the ramp-down. SRC_REV 60 (DRIVER_REV 38 / 39, PL-160 / PL-161), RE-DERIVED for the jerk-limited ramp, field
'  ticks at the built-in rates (the S-curve, v / A + A / J passes at an average of v / 2 -- or 2 sqrt(v / J) below
'  A^2 / J -- a pass-by-pass model of jerkStep): the QUARTER spins up in 1_561 passes, 40.1 ticks (the stepped ramp's
'  was 31), holds 98.2 ticks a second, and stops in 1_216 passes, 31.2 ticks (was 19), so its limit fires at
'  (the leg's ticks) - 31.2 - the plan's early tick (STOP_PLAN_EARLY_TICKS). Spin-up, SPIN_SETTLE_MS and a window of W ms
'  reach 40.1 + 98.2 + 0.0982 W ticks.
'  SRC_REV 74 (PL-168; R20, the platform turns freely): THE QUARTER'S LEG IS TWO TURNS, 422 ticks, so its limit fires at
'  422 - 31.2 - 1 = 389.8. The window is 500 ms, as before SRC_REV 60: it ends at 40.1 + 98.2 + 49.1 = 187.4 ticks, 202.4
'  ticks (2.06 s) short of the limit. Loaded, a wheel at 57 % of the command (the slowest the floor rerun saw) covers
'  fewer ticks in the same time, so the margin only grows. WHAT THE 500 ms IS FOR: SPINSTRT and SPINPEAK need the leg at
'  AT_SPEED for A2_REF_DELAY_MS + A2_TAIL_SAMPLES x 2 ms (420 + 62 = 482 ms) after its first AT_SPEED sample, and that is inside
'  SPIN_SETTLE_MS (1_000), so the window itself adds the A-4 and A-8 readings' statistics (250 ms is the least that counts,
'  SPIN_WIN_MIN_MS) and SPINLEAD's numerator current. The ONE-turn quarter's 300 ms (limit at 178.8, window end 167.8,
'  11 ticks spare) is gone with the one-turn leg. SLOW (5.3 + 27.0 + 54.0 + 4.4 ticks) and MEDIUM (15.0 + 53.7 + 53.7 +
'  12.3) fit far inside 211 and are unchanged.
spinPower       LONG    7, 13, 23                           ' 10_093_936 / 20_087_872 / 36_744_432
spinWinMs       LONG    2_000, 1_000, 500                   ' the quarter's 500: derived above (it was 300 for the one-turn leg)
spinSchedLead   LONG    205, 191, 51
' per SPIN_SPEED_*: the leg's travel limit -- the ticks the harness's guard and the distance stop's judgement use, and the
'  millimetres stopAfterDistance() is armed with (the round trip is BM-SPINBUILD's tick_back / f_back)
spinLegTicks    LONG    SPIN_LEG_TICKS, SPIN_LEG_TICKS, SPIN_FAST_LEG_TICKS
spinLegMm       LONG    SPIN_LEG_MM, SPIN_LEG_MM, SPIN_FAST_LEG_MM
' per pair (SPIN_PAIR_*): its commutation pair and speed; each pair's two legs run RIGHT, then LEFT (SRC_REV 62: the
'  SLOW fault pair, and with it the kind column, moved to FAULTRUN)
spinPairOffs    LONG    SPOFF_SCHED, SPOFF_SCHED, SPOFF_LEGACY, SPOFF_SCHED, SPOFF_FIXED
spinPairSpeed   LONG    SPIN_SPEED_SLOW, SPIN_SPEED_MED, SPIN_SPEED_MED, SPIN_SPEED_BRISK, SPIN_SPEED_BRISK
tokSpOff        BYTE    "SCHED", 0, "LEGACY", 0, "FIXED", 0, TOK_END
tokSpSpeed      BYTE    "SLOW", 0, "MEDIUM", 0, "BRISK", 0, TOK_END
tokSpDir        BYTE    "RIGHT", 0, "LEFT", 0, TOK_END
tokSpStop       BYTE    "NOT_RUN", 0, "LIMIT", 0, "OPERATOR", 0, "ABORT", 0, "OVERTRAVEL", 0, "TIMEOUT", 0, "FAULT", 0
                BYTE    "HARNESS", 0, "BLOCKED", 0, TOK_END
tokCrk          BYTE    "COAST", 0, "LOWCEIL", 0, "HOLD", 0, TOK_END
tokCrStop       BYTE    "NOT_RUN", 0, "TIMER", 0, "BOUND", 0, "OPERATOR", 0, "ABORT", 0, TOK_END
' SRC_REV 58, the floor run's load cells (SRC_REV 62, the floor situations): each table follows its CON enum
tokBlk          BYTE    "COAST", 0, "BRAKE", 0, TOK_END
tokBlkStop      BYTE    "NOT_RUN", 0, "LATCHED", 0, "NO_LATCH", 0, "LIMIT", 0, "OPERATOR", 0, "ABORT", 0, "OVERTRAVEL", 0
                BYTE    "TIMEOUT", 0, TOK_END
tokBridge       BYTE    "NA", 0, "COAST", 0, "SHORT", 0, TOK_END
tokLdo          BYTE    "NOT_RUN", 0, "OVERLOAD", 0, "FAULT", 0, "LIGHT", 0, "STALLED", 0, "ABORT", 0, TOK_END
tokLdStop       BYTE    "NOT_RUN", 0, "LIMIT", 0, "OPERATOR", 0, "ABORT", 0, "OVERTRAVEL", 0, "FAULT", 0, "BLOCKED", 0
                BYTE    "TIMEOUT", 0, TOK_END
' SRC_REV 62: which leg a BM-FLLEG is (FLL_*)
tokFll          BYTE    "BACK", 0, "FR_OUT", 0, "INC_UP", 0, "INC_DOWN", 0, TOK_END

' SRC_REV 69: the floor actions, each table in FLA_* order. tokFloorAct is BM-BANNER's and BM-PLAN's action token (at most
'  TOKMAX_FLOORACT bytes); sFloorWords is what the RESULT line calls the action, in plain words.
tokFloorAct     BYTE    "NONE", 0, "OBST_COAST", 0, "OBST_SHORT", 0, "GRAB", 0, "FAULTRUN", 0, "SPIN_SLOW_RIGHT", 0
                BYTE    "SPIN_SLOW_LEFT", 0, "SPIN_MED_RIGHT", 0, "SPIN_MED_LEFT", 0, "SPIN_FAST_RIGHT", 0
                BYTE    "SPIN_FAST_LEFT", 0, "SPIN_LEGACY_RIGHT", 0, "SPIN_LEGACY_LEFT", 0, "SPIN_FIXED_RIGHT", 0
                BYTE    "SPIN_FIXED_LEFT", 0, "AUTO", 0, "OBSTACLE", 0, "AUTO_SPINS", 0, "AUTO_FAULT", 0, "AUTO_RAMP", 0, TOK_END
sFloorWords     BYTE    "NO ACTION", 0, "OBSTACLE COAST", 0, "OBSTACLE SHORT", 0, "GRAB", 0, "FAULT RUN", 0
                BYTE    "SPIN SLOW RIGHT", 0, "SPIN SLOW LEFT", 0, "SPIN MEDIUM RIGHT", 0, "SPIN MEDIUM LEFT", 0
                BYTE    "SPIN FAST RIGHT", 0, "SPIN FAST LEFT", 0, "SPIN LEGACY RIGHT", 0, "SPIN LEGACY LEFT", 0
                BYTE    "SPIN FIXED RIGHT", 0, "SPIN FIXED LEFT", 0, "AUTO SESSION", 0, "OBSTACLE SESSION", 0
                BYTE    "AUTO SPINS", 0, "AUTO FAULT RUN", 0, "AUTO RAMP LEGS", 0, TOK_END
' the pair each SPIN action's kind runs (FLOOR_SPIN_KIND indexes it): SLOW, MEDIUM and BRISK (the quarter) on the SCHED
'  offsets, then the LEGACY control (MEDIUM) and the FIXED control (BRISK)
spinActPair     LONG    SPIN_PAIR_SLOW, SPIN_PAIR_MED, SPIN_PAIR_BRISK, SPIN_PAIR_LEGACY, SPIN_PAIR_FIXED

' The RESULT line's bodies: one plain sentence each, worded from what the run's own verdict logic decided. The line is
'  "RESULT: <action> -- <body>". No internal id appears in any of them (Stephen's reading is the terminal's text).
sResNoAction    BYTE    "no floor action was selected when this image was built, so nothing ran", 0
sResEmpty       BYTE    0
' A body that takes a cause (sResNothing, sResEarly, sResFrNoRedrive, sResFrNotRun) ends without the colon: sayResult()
'  puts ": " between it and the cause when there is one, and nothing after it when there is none (SRC_REV 70, H7)
sResNothing     BYTE    "the run did nothing", 0
sResEarly       BYTE    "ended early, nothing more was judged", 0
sResObstLatched BYTE    "the platform stopped itself on the obstacle (the protective stop latched)", 0
sResObstBad     BYTE    "the protective stop latched, but a check of the stop or of clearing it failed: read the log's verdicts", 0
sResObstNoLatch BYTE    "met the obstacle, but the protective stop did not latch in time", 0
sResObstMissed  BYTE    "never met the obstacle and drove its whole metre: stand it 0.3 to 0.8 m ahead next run", 0
sResGrabJudged  BYTE    "judged: the hold was read", 0
sResGrabFault   BYTE    "a wheel faulted under the hold", 0
' SRC_REV 70: the body was chosen from the outcome alone, so a hold that slowed the wheels below LOAD_MIN_TICKS of
'  travel (the line check unjudged) or a path limiter that engaged other than once read "judged"
sResGrabFirm    BYTE    "the hold was too firm to judge the line, so hold less next run", 0
sResGrabHuntBad BYTE    "the hold was read, but the path limiter changed state during the hold, so that check failed", 0
sResGrabHuntWhy BYTE    "the path limiter also changed state during the hold, so that check failed", 0
sResGrabNoEng   BYTE    "the hold was read, but the path limiter was not engaged during the window, so that check was not judged", 0
sResGrabNoEngWhy BYTE   "the path limiter was not engaged during the window, so its check was not judged", 0
sResGrabLight   BYTE    "too light: hold harder next run (take hold about 3 s after it starts rolling)", 0
sResGrabStalled BYTE    "stalled: hold less next run", 0
sResFrRecovered BYTE    "fault seen and recovered: the drive on to the start drew normal current", 0
sResFrHigh      BYTE    "fault seen and recovered, but the drive on to the start drew too much current", 0
sResFrNoRatio   BYTE    "fault seen and recovered, and the drive on to the start ran, but its current could not be compared", 0
sResFrNoRedrive BYTE    "fault seen, but the drive on to the start did not run", 0
sResFrNoFault   BYTE    "the forced fault did not latch: nothing was judged", 0
sResFrNotRun    BYTE    "the fault was not requested, so nothing was judged", 0
sResWhyStopBgn  BYTE    "the leg's distance stop began before the steady window could run", 0
sResSpinLimit   BYTE    "ended at its turn limit", 0
sResSpinOffLim  BYTE    "ended, but not within the allowed distance of its turn limit", 0
sResSpinPast    BYTE    "went past its turn limit and the harness stopped it", 0
sResSpinAborted BYTE    "was stopped by the 10 A abort or a refused drive", 0
sResSpinTimeout BYTE    "did not reach its turn limit in time and the harness stopped it", 0
sResSpinFault   BYTE    "a wheel faulted before it reached its turn limit", 0
sResWhyNoCog    BYTE    "the steering object did not start", 0
sResWhyLimit    BYTE    "the travel limit was refused", 0
sResWhyDrive    BYTE    "the drive was refused", 0
sResWhyNoAck    BYTE    "the recording instrument did not answer", 0
sResWhyTick     BYTE    "the wheel size read back was not the one the limit assumes", 0
sResWhyAbort    BYTE    "the 10 A abort or the run's time cap stopped it", 0
sResWhyOver     BYTE    "a wheel went past its travel limit and the harness stopped it", 0
sResWhyTimeout  BYTE    "it did not come to rest in time and the harness stopped it", 0
sResWhyStalled  BYTE    "a wheel stalled into the protective stop", 0
sResWhyFaulted  BYTE    "a wheel faulted", 0
sResWhyStall    BYTE    "the recording instrument stalled", 0
sResWhyNoSettle BYTE    "the wheels never settled at speed before the bound", 0
sResWhyOther    BYTE    "the reason is in the log", 0
' SRC_REV 70, the floor sessions
sResWhyFence    BYTE    "a drive's worst-case end lay outside the 2 m square, so the fence refused it", 0
sResWhyNotClear BYTE    "the platform was not known clear to move", 0
sResWhySkipped  BYTE    "an earlier straight action did not finish", 0
sResWhyNotHome  BYTE    "the platform was not back at its start", 0
sResWhyRate     BYTE    "the platform refused an acceleration or deceleration setting", 0
sResWhyRetired  BYTE    "a wheel's fault was not cleared", 0
sResWhyNoFault  BYTE    "the forced fault did not latch", 0
sResWhyNoRoom   BYTE    "too little of the leg was left for the drive on to the start", 0
sResWhyNoMove   BYTE    "the drive never left rest", 0

VAR { SPIN part state -- cog 0 only }

    ' one leg (spLegReset())
    LONG    spLeg                                           ' 0..SPIN_LEGS-1
    LONG    spSid                                           ' the steering lifetime it ran in, 0 when none
    LONG    spStopBy                                        ' SPSTOP_*
    LONG    spWhy                                           ' the first cause of the leg's NA fields
    LONG    spLeftPwr                                       ' the powers commanded
    LONG    spRightPwr
    LONG    bSpDriven                                       ' driveAtPower() was called
    LONG    spDriveErr                                      ' ...and its return
    LONG    spLimErr                                        ' stopAfterDistance()'s return
    LONG    bSpReached                                      ' both wheels read AT_SPEED
    LONG    spAtMs                                          ' ms from the command to that
    LONG    bSpWinValid                                     ' the steady window ran at least SPIN_WIN_MIN_MS, uninterrupted
    LONG    spWinMs                                         ' its length
    LONG    spWinStart                                      ' ring totals delimiting it, -1 when none
    LONG    spWinEnd
    LONG    spCmdMs                                         ' getms() at the command
    LONG    bSpStopBegan                                    ' a wheel's target went to zero or its mirror reads STOPPED: the limit fired
    LONG    bSpOvertravel                                   ' the travel guard e-stopped the leg
    LONG    spPathPm                                        ' testGetPathScale() at the window's end
    LONG    bSpReadsValid                                   ' the window-end reads were taken
    LONG    bSpTravelValid                                  ' each wheel's raw travel was read at rest
    LONG    bSpTrkValid                                     ' ...and the steering object's tracked ticks
    LONG    spAmpsN                                         ' getCurrent() reads over the window
    LONG    spFaultSide                                     ' FAULTRUN's wheel forced to fault, SIDE_NONE otherwise
    LONG    spGuardTicks                                    ' SRC_REV 62: the leg's declared travel, ticks -- the guard's limit
    LONG    spTravelMark                                    ' ...and UNTIL_TRAVEL's mark, ticks from spPos0
    LONG    spPos0[INST_MOTORS]                             ' each wheel's raw pos (mirror) when its leg began: the guard's zero
    LONG    spLaunchPtr[INST_MOTORS]                        ' SRC_REV 70: each driver's @pinbase (flLegBegin()), 0 before the first leg: bSpinStopBegun() reads targetIncre there
    LONG    spTravel[INST_MOTORS]                           ' raw pos at rest less spPos0, signed
    LONG    spTrk[INST_MOTORS]                              ' the tracked ticks at rest: what the distance stop counts
    LONG    spAmpsSum[INST_MOTORS]                          ' getCurrent() over the window, A x 10_000
    LONG    spOffNeg[INST_MOTORS]                           ' the pair each driver applied, read at the window's end
    LONG    spOffPos[INST_MOTORS]
    LONG    spFolPm[INST_MOTORS]                            ' the path limiter's achieved fraction there
    LONG    spFolPct[INST_MOTORS]                           ' the rpm window's following percentage there
    LONG    bSpFolOk[INST_MOTORS]                           ' ...valid
    LONG    bSpShort[INST_MOTORS]                           ' the lag limiter held within the last few slots
    ' the START, per wheel (spStartStats())
    LONG    bSpStartOk[INST_MOTORS]
    LONG    spAtK[INST_MOTORS]                              ' trace k of the first AT_SPEED sample
    LONG    spLeaveK[INST_MOTORS]                           ' k where duty left its floor for good
    LONG    spRunMax[INST_MOTORS]                           ' the running maximum of duty before AT_SPEED
    LONG    spDropPm[INST_MOTORS]                           ' duty's largest fall from it, per mille
    LONG    spPeakI[INST_MOTORS]                            ' the START's current peak, mV
    LONG    spTailX10[INST_MOTORS]                          ' the last A2_TAIL_SAMPLES' mean current, mV x10
    LONG    spRatioX100[INST_MOTORS]                        ' the peak over it, x100
    LONG    spExcessMv[INST_MOTORS]                         ' SRC_REV 78: the peak above it, mV, never negative (A-2's judged value)
    LONG    spTailN[INST_MOTORS]                            ' the tail's samples
    ' the lifetime (spinOpenLifetime())
    LONG    spLifeSid                                       ' the lifetime's sid, 0 when none is up
    LONG    spLifeTick                                      ' its travel per tick, read back; 0 when not read
    LONG    bSpOffWritten                                   ' it wrote a fixed pair (restore owed, I11)
    ' kept per leg for the cells that compare legs, [leg * INST_MOTORS + slot]
    LONG    spLegAmps[SPIN_LEGS * INST_MOTORS]              ' getCurrent() mean over the leg's window, A x 10_000
    LONG    bSpLegAmps[SPIN_LEGS * INST_MOTORS]
    LONG    spLegWhy[SPIN_LEGS * INST_MOTORS]               ' SRC_REV 74: why the leg's window printed NA (WHY_NONE when it did not), for BM-XRUN
    LONG    spLegFol[SPIN_LEGS * INST_MOTORS]               ' SRC_REV 75: the leg's rpm-window following, % (BM-SPINW fol_pct): SPINCTL's and SPINLEAD's precondition
    LONG    bSpLegFol[SPIN_LEGS * INST_MOTORS]              ' ...it was read
    ' the limiter sampler (SRC_REV 75, limSample()): each driver's status run, read in place on every spinWatch() pass of a floor leg
    LONG    spStatusPtr[INST_MOTORS]                        ' each driver's @drive_u (flLegBegin()), 0 before the first leg
    LONG    lgHeldBase[INST_MOTORS]                         ' lag_held when the leg began
    LONG    lgHeldPrev[INST_MOTORS]                         ' ...at the last sample (an interval's held pass is a change)
    LONG    lgHeldCmd[INST_MOTORS]                          ' ...at the last sample with a command in force: the leg's held passes end there
    LONG    lgLimPrev[INST_MOTORS]                          ' duty_capped + foldback_frames at the last sample
    LONG    lgLimMs[INST_MOTORS]                            ' getms() of the last sample at which that sum had advanced
    LONG    bLgLimSeen[INST_MOTORS]                         ' ...it has advanced since the leg began
    LONG    bLgArrived[INST_MOTORS]                         ' SRC_REV 78: a sample read the wheel's driver at DCS_AT_SPEED since the leg began (a give-way needs an arrival first)
    LONG    lgLimAdv[INST_MOTORS]                           ' samples at which it advanced, over the leg
    LONG    lgSamples[INST_MOTORS]                          ' samples read over the leg
    LONG    lgGive[INST_MOTORS]                             ' give-way slots over the leg
    LONG    lgBad[INST_MOTORS]                              ' ...with no limiter advance in LG_LOOK_MS
    ' the segments
    LONG    bSpSegRan                                       ' segSpin() ran
    LONG    spSegWhy                                        ' why SPIN ended short, WHY_NONE when every leg ran
    LONG    crSegWhy                                        ' why INCLINE ended short
    LONG    frSegWhy                                        ' why FAULTRUN ended short
    LONG    planAction                                      ' SRC_REV 70: the FLA_* the next BM-PLAN row names (emitHeaderRecords())
    ' SRC_REV 62: one plain floor leg (flLeg(), BM-FLLEG) -- a drive back, FAULTRUN's leg out, an incline climb or descent
    LONG    fllKind                                         ' FLL_*
    LONG    fllSeg                                          ' the SEG_* it ran in
    LONG    fllTicks                                        ' its declared travel, ticks
    LONG    fllArmErr                                       ' the limit's return
    LONG    fllDriveErr                                     ' driveAtPower()'s return
    LONG    fllStopBy                                       ' SPSTOP_*
    LONG    fllWhy                                          ' the first cause of its NA fields
    LONG    bFllDriven                                      ' driveAtPower() was called
    LONG    fllMs                                           ' command to both wheels at rest at its end
    LONG    fllTravel[INST_MOTORS]                          ' each wheel's travel on its driver's pos, from the leg's start
    LONG    bFllPack                                        ' SRC_REV 64: the pack was read after the leg's steady window
    LONG    fllPackMv                                       ' SRC_REV 64: getPackVoltage() there, mV (PACK_PRESENT only)
    ' the cells' accumulators (spResetCells())
    LONG    sfSpStopN                                       ' SPINSTOP: legs that ended at the limit or past it
    LONG    sfSpStopBad                                     ' ...not at rest within SPIN_STOP_TOL_TICKS of it
    LONG    sfSpOffN                                        ' SPINOFF: legs whose applied pair was judged
    LONG    sfSpOffBad                                      ' ...not the pair under test
    LONG    sfSpDirN                                        ' SPINDIR: legs whose travel was judged
    LONG    sfSpDirBad                                      ' ...a wheel ran the other way
    LONG    sfSpHuntN[INST_MOTORS]                          ' SPINHUNT: confirmed-pair windows at SLOW and MEDIUM
    LONG    sfSpHuntBad[INST_MOTORS]
    LONG    sfSpErrN[INST_MOTORS]                           ' SPINERR: every confirmed-pair window
    LONG    sfSpErrBad[INST_MOTORS]
    LONG    sfSpA1N[INST_MOTORS]                            ' SPINSTRT: the quarter's START traces
    LONG    sfSpA1Max[INST_MOTORS]                          ' ...the worst drop, per mille
    LONG    sfSpA2N[INST_MOTORS]                            ' SPINPEAK: the same traces
    LONG    sfSpA2Max[INST_MOTORS]                          ' ...the worst ratio, x100
    LONG    sfSpFolN[INST_MOTORS]                           ' SPINFOL: confirmed-pair reads at MEDIUM and BRISK
    LONG    sfSpFolMax[INST_MOTORS]                         ' ...the widest gap, points
    ' SRC_REV 75 (task 3657): the hold-speed fix's cells
    LONG    sfSpLegsTried                                   ' SPINRATE, SPINHOLD: spin legs begun (spLegReset()): the count every wheel's judged legs are held to
    LONG    sfSpRateN[INST_MOTORS]                          ' SPINRATE: legs whose following was read on this wheel
    LONG    sfSpRateMin[INST_MOTORS]                        ' ...the lowest, % (LIM_BIG until one is read)
    LONG    sfSpHoldN[INST_MOTORS]                          ' SPINHOLD: legs judged on this wheel (status run read, drain clean)
    LONG    sfSpHoldBad[INST_MOTORS]                        ' ...with a held pass or an EV_PATH_LIMIT
    LONG    sfLgSamples[INST_MOTORS]                        ' LIMGIVE limb (a): samples read, over every floor leg
    LONG    sfLgBad[INST_MOTORS]                            ' ...give-way slots with no limiter advance in LG_LOOK_MS (BM-LIMW prints the leg's own give-way count)
    LONG    sfLgLegBad                                      ' LIMGIVE limb (b): legs (spin, ramp) with path limiting in their log and no limiter of any kind
    LONG    sfRampN                                         ' RAMPARR: ramp legs judged (the wheels left rest, the drain clean), of RAMP_LEGS
    LONG    sfRampBad                                       ' ...late or with path limiting
    LONG    bSfBlkLimRan                                    ' BLKLIMIT: the BRAKE trial met the obstacle and its drain read clean
    LONG    bSfBlkLimOk                                     ' ...the fold-back engaged first and the latch came inside the stand band
    LONG    bSfBlkWinRan                                    ' BLKWIN (SRC_REV 77): an OBSTACLE trial's wheel had a limiter act with no hall tick since, so a window opened
    LONG    bSfBlkWinOk                                     ' ...and no pass read |err| in BLK_WIN_LO_ERR..BLK_WIN_HI_ERR, over every trial that opened one
    LONG    bSfBlkFltRan                                    ' BLKFLT (SRC_REV 77): an OBSTACLE trial met the obstacle and its event drain read whole (or it failed to latch)
    LONG    bSfBlkFltOk                                     ' ...and every such trial latched with no EV_FAULT and no EV_FAULT_RESYNC on either wheel

VAR { INCLINE state (SRC_REV 36's CREEP; SRC_REV 62, the incline's stops) -- cog 0 only }

    ' the segment (segIncline())
    LONG    incSid                                          ' its steering lifetime, 0 when none
    LONG    bIncStarted                                     ' the lifetime was started (the platform is off the flat once it drives)
    LONG    bIncOnSlope                                     ' a climb has moved it: an early end asks him to hold it (CREEP_CATCH)
    LONG    incPos0[INST_MOTORS]                            ' each driver's pos when the lifetime began: the net climb's zero
    ' one stop (crReset())
    LONG    crKind                                          ' CRK_*
    LONG    crSid                                           ' its steering lifetime, 0 when none
    LONG    crStopBy                                        ' CRSTOP_*
    LONG    crWhy                                           ' the first cause of its NA fields
    LONG    crSetErr                                        ' setHoldLimits()'s return
    LONG    bCrReleased                                     ' SRC_REV 62: the climb came to rest at its stop (was: he let go)
    LONG    crReleaseMs                                     ' ...ms from the climb's command to that rest
    LONG    crWinMs                                         ' the watch's length
    LONG    crBoundTicks                                    ' the watch's creep bound
    LONG    crWinStart                                      ' ring totals delimiting the watch, -1 when none
    LONG    crWinEnd
    LONG    bCrFrozen                                       ' the capture was frozen (drain legal, I10)
    LONG    bCrBraked                                       ' SRC_REV 62: the watch e-stopped the wheels (incSecure() clears it)
    LONG    bCrPolled                                       ' a hold poll was taken
    LONG    crAmpsN                                         ' getCurrent() reads over the watch
    LONG    crRelHw[INST_MOTORS]                            ' hwPos (mirror) at rest at the stop: the watch's reference
    LONG    crCreep[INST_MOTORS]                            ' the largest |hwPos - crRelHw| over the watch, ticks
    LONG    crHoldCreep[INST_MOTORS]                        ' ...while the last hold poll read HS_HOLDING
    LONG    crState[INST_MOTORS]                            ' getHoldStatus() at the last poll (HS_*)
    LONG    crDisp[INST_MOTORS]                             ' ...the driver's own displacement there, signed
    LONG    crCeilDuty[INST_MOTORS]                         ' testGetHold(): the ceiling in force, duty counts
    LONG    crDutyPk[INST_MOTORS]                           ' ...the largest hold duty polled
    LONG    crDutyEnd[INST_MOTORS]                          ' ...the hold duty at the last poll
    LONG    crCeilMs[INST_MOTORS]                           ' ...the longest run at the ceiling, front passes (ms)
    LONG    crSlips0[INST_MOTORS]                           ' ...slip and limit events at the first poll
    LONG    crLimits0[INST_MOTORS]
    LONG    crSlips[INST_MOTORS]                            ' ...and how many more by the last
    LONG    crLimits[INST_MOTORS]
    LONG    crAmpsSum[INST_MOTORS]                          ' getCurrent() over the watch, A x 10_000
    ' the cells
    LONG    bSfCrCoastRan                                   ' CRPCOAST: the coast control came to rest at its stop
    LONG    sfCrCoastTicks                                  ' ...how far it rolled, the farther wheel
    LONG    bSfCrLowRan                                     ' CRPLOW: the low-ceiling control came to rest at its stop
    LONG    sfCrLowTicks                                    ' ...how far it crept, the farther wheel
    LONG    bSfCreepRan[INST_MOTORS]                        ' CREEP / CRPHOLD: the hold trial came to rest at its stop
    LONG    sfCreepTicks[INST_MOTORS]                       ' ...its creep while HOLDING
    LONG    bSfCrHoldOk[INST_MOTORS]                        ' ...HOLDING when its watch ran out

VAR { FAULTRUN: the fault on the way back and the drive after it (SRC_REV 58's re-drive, SRC_REV 62) -- cog 0 only }

    ' the run (frunReset()): the leg out and the leg back with its fault
    LONG    frunSid                                         ' its steering lifetime, 0 when none
    LONG    frunTid                                         ' the fault's trace id, 0 when none
    LONG    frunBackErr                                     ' the leg back's limit (stopAfterDistance())
    LONG    frunBackDrvErr                                  ' ...and its driveAtPower()
    LONG    frunStopBy                                      ' SPSTOP_* of the leg back up to its fault
    LONG    frunWhy                                         ' the first cause of the leg back's NA fields
    LONG    bFrunDriven                                     ' the leg back was driven
    LONG    bFrunReached                                    ' ...and both wheels read AT_SPEED
    LONG    frunLeftSr                                      ' getStopReason() as the fault left the platform
    LONG    frunRightSr
    LONG    bFrunSrRead
    LONG    rdFwd[INST_MOTORS]                              ' the leg out's getCurrent() mean over its window: the SECOND REFERENCE
    LONG    bRdFwd                                          ' ...measured
    ' the re-drive (rdReset())
    LONG    rdLeg                                           ' SRC_REV 58's fault leg; SRC_REV 62: 0, the one run
    LONG    rdSide                                          ' the wheel faulted
    LONG    rdRemain                                        ' ticks of the leg back left when it was armed
    LONG    rdLimErr                                        ' stopAfterRotation()'s return
    LONG    rdDriveErr                                      ' driveAtPower()'s return
    LONG    rdStopBy                                        ' SPSTOP_*
    LONG    rdWhy                                           ' the first cause of its NA fields
    LONG    bRdDriven                                       ' driveAtPower() was called
    LONG    bRdReached                                      ' both wheels read AT_SPEED
    LONG    rdAtMs                                          ' ms from the command to that
    LONG    rdWinMs                                         ' the window's length
    LONG    bRdWinValid                                     ' it ran at least RD_WIN_MIN_MS with no event
    LONG    bRdAborted[INST_MOTORS]                         ' this wheel tripped the absolute-current abort
    LONG    rdPre[INST_MOTORS]                              ' getCurrent() mean before the fault, A x 10_000
    LONG    bRdPre[INST_MOTORS]                             ' ...measured and at least RD_PRE_MIN
    LONG    rdPost[INST_MOTORS]                             ' ...and after it, over the same window
    LONG    rdRatio[INST_MOTORS]                            ' post over pre, x100 (RD_ABORT_X100 after an abort)
    LONG    bRdRatio[INST_MOTORS]                           ' ...judged
    ' the cell
    LONG    sfRdN[INST_MOTORS]                              ' POSTFLT: re-drives judged
    LONG    sfRdMax[INST_MOTORS]                            ' ...the worst ratio, x100

VAR { OBSTACLE state (SRC_REV 58's BLOCK; SRC_REV 62, PL-106 / PL-111 / PL-132) -- cog 0 only }

    ' one trial (blkReset())
    LONG    blkKind                                         ' BLK_*
    LONG    blkSid                                          ' its steering lifetime, 0 when none
    LONG    blkWhy                                          ' the first cause of its NA fields
    LONG    blkStopBy                                       ' BLKSTOP_*
    LONG    blkLimErr                                       ' testSetCurrentLimits()'s return
    LONG    blkArmErr                                       ' the leg's stopAfterDistance()
    LONG    blkDriveErr                                     ' driveAtPower()'s return
    LONG    bBlkDriven                                      ' driveAtPower() was called
    LONG    bBlkReached                                     ' both wheels read AT_SPEED
    LONG    blkAtMs                                         ' ms from the command to that
    LONG    bBlkLatched                                     ' a protective code read set
    LONG    blkLatchMs                                      ' ms from the command to that read
    LONG    blkMarkTotal                                    ' ring total at the command's mark, -1 when none
    LONG    blkLatchTotal                                   ' ring total at the latch, -1 when none
    LONG    blkWinStart                                     ' ring totals delimiting the phase window, -1 when none
    LONG    blkWinEnd
    LONG    blkLeftCode                                     ' getProtectiveStop() at the latch
    LONG    blkRightCode
    LONG    blkLeftSr                                       ' getStopReason() after the latch
    LONG    blkRightSr
    LONG    bBlkSrRead                                      ' ...read
    LONG    blkRefuseErr                                    ' a drive while latched
    LONG    blkEstClrErr                                    ' clearEmergency() while latched
    LONG    bBlkEstHeld                                     ' ...both codes still set after it
    LONG    blkClrErr                                       ' clearProtectiveStop()
    LONG    bBlkClrOk                                       ' ...both codes NO_ERROR after it
    LONG    blkArm2Err                                      ' the rest of the leg armed after the clear
    LONG    blkAgainErr                                     ' a drive after the clear
    LONG    bBlkApiRan                                      ' the API sequence ran
    LONG    bBlkFrozen                                      ' the capture was frozen (drain legal, I10)
    LONG    blkLastPos[INST_MOTORS]                         ' each wheel's driver pos and hwPos (mirror) last seen...
    LONG    blkLastHw[INST_MOTORS]
    LONG    blkTickMs[INST_MOTORS]                          ' ...and getms() when either last changed: its last hall tick
    LONG    blkStandMs[INST_MOTORS]                         ' each wheel's stand still, last tick to the latch (or the end), ms
    LONG    blkCountMs[INST_MOTORS]                         ' SRC_REV 76: getms() when the driver's blocked count began (0: not counting)
    LONG    blkCountRunMs[INST_MOTORS]                      ' ...and how long it had run at the latch (or the end), ms; 0 if never
    LONG    blkLimPrev[INST_MOTORS]                         ' ...duty_capped + foldback_frames at the last pass, to see a limiter act
    LONG    blkLimTick[INST_MOTORS]                         ' SRC_REV 77: the driver's bLimSinceTick (PL-179 F-a), mirrored: a limiter acted since this wheel's last tick (T/F)
    LONG    blkWinFold[INST_MOTORS]                         ' SRC_REV 81 (PL-189): BLKWIN's own flag -- the fold-back (foldback_frames ALONE) acted since this wheel's last tick (T/F)
    LONG    blkFoldPrev[INST_MOTORS]                        ' ...foldback_frames at the last pass, to see it act
    LONG    blkWinN[INST_MOTORS]                            ' BLKWIN: passes read in the wheel's window (the fold-back had acted, no tick since, still driving)
    LONG    blkWinHit[INST_MOTORS]                          ' ...of them, passes with |err| in BLK_WIN_LO_ERR..BLK_WIN_HI_ERR
    LONG    blkWinMax[INST_MOTORS]                          ' ...and the largest |err| any of them read
    LONG    blkFltN[INST_MOTORS]                            ' BLKFLT: this wheel's EV_FAULT events in the trial's drain
    LONG    blkRsyN[INST_MOTORS]                            ' ...and its EV_FAULT_RESYNC events
    LONG    bBlkEvRead                                      ' ...the drain that counted them read whole (bEvdClean())
    LONG    blkWinWhy                                       ' WHY_NONE when BLKWIN measured this trial, else the cause it did not (blockFold())
    LONG    blkFltWhy                                       ' ...and BLKFLT's
    LONG    blkPhX10[INST_MOTORS]                           ' each wheel's phase-sum mean over the window, mV x10
    LONG    blkPhN[INST_MOTORS]                             ' ...its samples
    LONG    blkHeldN                                        ' HELDATSPD over the drive, both wheels: held samples
    LONG    blkHeldBad                                      ' ...and bad ones
    ' the segment and the cells
    LONG    blkSegWhy                                       ' why OBSTACLE ended short
    LONG    bBlkStopJudged                                  ' SRC_REV 74: THIS trial was folded into BLKSTOP (blockFold() sets it, blkReset() clears it)...
    LONG    bBlkStopBad                                     ' ...and failed it: this trial's own flag, the one its RESULT line reads (never the session's count)
    LONG    bBlkClrBad                                      ' ...and, when its API sequence ran, failed PROTCLR (blockFold()'s own test, kept per trial)
    LONG    bBlkLimJudged                                   ' SRC_REV 75 (BLKLIMIT): this is the BRAKE trial, it met the obstacle, and its drain read whole (blockLimit())
    LONG    bBlkFoldFirst                                   ' ...a wheel's EV_FOLDBACK engage is stamped before the blocked wheel's EV_STOP
    LONG    sfBlkN                                         ' BLKSTOP: judged trials (latched, or a wheel still unlatched)
    LONG    sfBlkBad                                        ' ...that did not latch as the stop must
    LONG    sfClrN                                          ' PROTCLR: latched trials
    LONG    sfClrBad                                        ' ...whose API sequence did not hold
    LONG    bSfBlkCoast[INST_MOTORS]                        ' BLKCOAST: the COAST trial's window was read, per wheel
    LONG    sfBlkCoastMv[INST_MOTORS]                       ' ...its phase-sum mean, mV
    LONG    bSfBlkShort[INST_MOTORS]                        ' BLKSHORT: the BRAKE trial's
    LONG    sfBlkShortMv[INST_MOTORS]
    LONG    sfHeldN                                         ' HELDATSPD: held samples, OBSTACLE and every loaded window
    LONG    sfHeldBad                                       ' ...bad ones

VAR { GRAB ONE SIDE (SRC_REV 58's LOAD; PL-150 / PL-144; SRC_REV 63: the overload hold's only proof) -- cog 0 only }

    ' the one trial (ldReset())
    LONG    ldSid                                           ' its steering lifetime, 0 when none
    LONG    ldWhy                                           ' the first cause of its NA fields, or why it was not judged
    LONG    ldOutcome                                       ' LDO_*
    LONG    ldStopBy                                        ' LDSTOP_*
    LONG    ldLimErr                                        ' testSetCurrentLimits()'s return
    LONG    ldArmErr                                        ' the leg's distance limit's return
    LONG    ldDriveErr                                      ' driveAtPower()'s return
    LONG    bLdDriven                                       ' driveAtPower() was called
    LONG    bLdReached                                      ' both wheels read AT_SPEED
    LONG    ldAtMs                                          ' ms from the command to that
    LONG    bLdGrabbed                                      ' GRAB: the grab point was reached and GRAB shown
    LONG    ldGrabMs                                        ' ...ms from the command to it
    LONG    bLdOvertravel                                   ' the travel guard e-stopped it (bSpOvertravel, copied)
    LONG    bLdStopBegan                                    ' a wheel's getPower() read 0 unasked: the distance stop fired
    LONG    bLdLatched                                      ' a protective code read set
    LONG    bLdFault                                        ' a wheel's fault flag was seen
    LONG    ldWinStart                                      ' ring totals delimiting the judged window, -1 when none
    LONG    ldWinEnd
    LONG    ldWinMs                                         ' its length
    LONG    bLdWinValid                                     ' it ran at least its least length with no event
    LONG    ldPolls                                         ' polls of the path limiter over the window
    LONG    ldPathMin                                       ' testGetPathScale()'s least there, thousandths
    LONG    ldShort[INST_MOTORS]                            ' polls reading that wheel SHORT (its lag limiter held)
    LONG    ldPredX10                                       ' the command's predicted ticks/s x10
    LONG    ldLeftCode                                      ' getProtectiveStop() and getFaultCause() after the drive
    LONG    ldRightCode
    LONG    ldLeftCause
    LONG    ldRightCause
    LONG    ldLeftSr                                        ' getStopReason() after the drive
    LONG    ldRightSr
    LONG    bLdSrRead                                       ' ...read
    LONG    ldFlips                                         ' EV_PATH_LIMIT transitions (engages and releases) inside the judged window: LDHUNT's value
    LONG    ldEngPre                                        ' ...the engages before the window (the free start-up's, printed, not judged)
    LONG    bLdEngaged                                      ' ...the limiter was engaged over the window (LDHUNT's precondition)
    LONG    ldWinAtMs                                       ' getms() at the window's start
    LONG    ldWinEndMs                                      ' ...and at its end
    LONG    bLdFrozen                                       ' the capture was frozen (drain legal, I10)
    LONG    ldTicks[INST_MOTORS]                            ' hall ticks (the instrument's decode) over the window
    LONG    ldPct[INST_MOTORS]                              ' ...as a percentage of the command's predicted rate
    LONG    ldMisPm                                         ' |left - right| over the larger, thousandths
    LONG    ldGapMs[INST_MOTORS]                            ' each wheel's longest gap between hall ticks, ms
    LONG    ldHeldN                                         ' HELDATSPD over the window, both wheels: held samples
    LONG    ldHeldBad                                       ' ...and bad ones
    ' the segment and the cells
    LONG    bLdJudged                                       ' the GRAB trial was judged
    LONG    ldSegWhy                                        ' why GRAB ended short
    LONG    bSfLdPath                                       ' LDPATH: the judged window's travel was read
    LONG    sfLdPathPm                                      ' ...its mismatch, thousandths
    LONG    bSfLdHunt                                       ' LDHUNT: a GRAB trial was judged
    LONG    sfLdHunt                                        ' ...its path limiter's transitions inside the window
    LONG    sfLdHoldN                                       ' LDHOLD: judged windows, the gripped wheel's (SRC_REV 63: GRAB's only)
    LONG    sfLdHoldMs                                      ' ...the longest tick gap (LOAD_GAP_FAULT_MS after a fault)
    ' SRC_REV 81 (PL-189): LDFLT, and the premises LDHOLD and LDPATH now carry (ldReset(), loadEvents(), loadFold())
    LONG    ldGrabAtMs                                      ' getms() at the grab point: LDFLT counts faults from here
    LONG    ldFltN[INST_MOTORS]                             ' EV_FAULT events each wheel's log held, stamped at or after the grab
    LONG    ldRsyN[INST_MOTORS]                             ' ...and its EV_FAULT_RESYNC events
    LONG    bLdEvRead                                       ' ...the drain that counted them read whole (bEvdClean()), and ran
    LONG    bLdFoldHeld                                     ' the gripped wheel's fold-back was engaged in the judged window (LDPATH's premise)
    LONG    ldFoldIn                                        ' ...EV_FOLDBACK events its log stamped inside the window
    LONG    bLdFoldPre                                      ' ...its last EV_FOLDBACK before the window was an engage (not released)
    LONG    ldFltWhy                                        ' WHY_NONE when LDFLT measured the trial, else why not (loadFold())
    LONG    ldHoldWhy                                       ' ...LDHOLD's (NEAR_STOP), and
    LONG    ldPathWhy                                       ' ...LDPATH's (TOO_FEW_TICKS, EVENTS_LOST or LIMIT_HELD)
    LONG    bSfLdFltRan                                     ' LDFLT: the GRAB trial was judged for it
    LONG    bSfLdFltOk                                      ' ...and no wheel logged an EV_FAULT or an EV_FAULT_RESYNC from the grab on

#ifdef DBG_FENCE
DAT ' ---- floor session tables ----

' BM-FENCE's ev and what tokens, in FENEV_* and FEN_* order; sFenWords is what the plain FENCE line calls the drive
tokFenEv        BYTE    "PLAN", 0, "DONE", 0, TOK_END
tokFenWhat      BYTE    "SPIN", 0, "FR_OUT", 0, "FR_BACK", 0, "FR_REDRV", 0, "OBST", 0, "OBST_BACK", 0, "RAMP", 0, TOK_END
sFenWords       BYTE    "the spin", 0, "the fault run's leg out", 0, "the fault run's leg back", 0
                BYTE    "the fault run's drive on to its start", 0, "the drive into the obstacle", 0
                BYTE    "the drive back from the obstacle", 0, "the ramp leg", 0, TOK_END

VAR { the floor sessions' state (SRC_REV 70: FLOOR_ACT_AUTO, FLOOR_ACT_OBSTACLE) -- cog 0 only }

    ' the fence (sessReset(), fenceAdvance())
    LONG    fenX100                                         ' the platform's x in the start frame, 0.01 mm (x along the start heading)
    LONG    fenY100                                         ' ...and y, to its left
    LONG    fenHead                                         ' its heading: angle units, 2^32 to a turn, 0 the start heading, left positive
    LONG    fenBase[INST_MOTORS]                            ' each wheel's raw pos (mirror) where the estimate last took it
    LONG    fenRefused                                      ' straight legs the fence refused
    LONG    fenDoneLegs                                     ' estimates taken
    ' the straight actions (bSessStraightsMayGo(), sessStraightEnd())
    LONG    bStraightsOk                                    ' the session's straight actions may go on
    LONG    sessSkipWhy                                     ' the WHY_* that stopped them
    LONG    sessSkipCount                                   ' straight actions not run for it
    ' the spin legs and the fault run (segSpin(), segFaultRun())
    LONG    sessSpinDriven                                  ' spin legs whose drive was commanded
    LONG    sessSpinLimit                                   ' ...and that ended at their turn limit
    LONG    sessSpinWhy                                     ' the first cause a spin leg ended short
    LONG    bSessFrRan                                      ' the fault run was begun (not skipped)
    LONG    bSessFrOk                                       ' ...and was completed: the fault recovered and the drive on to the start made
    ' the obstacle session's two trials, in BLK_* order (blockTrial())
    LONG    bSessObstRan[BLK_KINDS]                         ' the trial was run
    LONG    sessTrialWhy[BLK_KINDS]                         ' why it was not, or what blockTrial() returned
    LONG    sessOwedTicks                                   ' what the trial just run moved the platform: the drive back's travel
    LONG    sessObstBody[BLK_KINDS]                         ' its RESULT body, resultObstacle()'s
    LONG    sessObstWhy[BLK_KINDS]                          ' ...and cause
    LONG    sessBackState[BLK_KINDS]                        ' SBK_*: what became of its drive back
    LONG    sessBackWhy[BLK_KINDS]                          ' ...and, when it did not finish, why
    ' the RESULT line's composition (resCat())
    LONG    resLen
    BYTE    resBuf[RES_BUF_BYTES]
#endif

#ifdef DBF_RAMP
