    LONG    drStored                                        ' samples readable in the ring
    LONG    drLostHead                                      ' samples overwritten before the freeze
    LONG    drOldest                                        ' ring index of logical sample 0
    LONG    drMarkJ                                         ' logical index of the first sample at or after the mark
    LONG    bDrMarkFound
