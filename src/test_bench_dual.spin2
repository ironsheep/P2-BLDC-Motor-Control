    TOKEN_SCAN_MAX = 32                                     ' longest packed token is 24 bytes

  ' What a watched wait ends on, besides its time bound and a safety event:
  '  UNTIL_TIME     - only the time bound
  '  UNTIL_STOPPED  - every watched motor's mirrored state reads DCS_STOPPED
  '  UNTIL_AT_SPEED - every watched motor's mirrored state reads DCS_AT_SPEED
  '  UNTIL_MOVING   - every watched motor is up and its mirrored state is not DCS_STOPPED
    #0, UNTIL_TIME, UNTIL_STOPPED, UNTIL_AT_SPEED, UNTIL_MOVING

  ' The event a wheel trace marks (eventCapture()):
  '  EVT_STOPMOTOR - stopMotor(): cause STOPCMD
  '  EVT_STOPCOG   - stop(): cause STOPCOG; the driver cog ends and only hwPos sees the coast
  '  EVT_ESTOP     - emergencyCutoff(): cause ESTOP
  '  EVT_OFFSET    - testSetFwdRevIndep(FAULT_PROVOKE_NEG_DEG, want_pos): cause FAULT
    #0, EVT_STOPMOTOR, EVT_STOPCOG, EVT_ESTOP, EVT_OFFSET

VAR { run-wide state -- cog 0 only }

    LONG    logSeq                                          ' seq of the last cog-0 record (I8), saturates at LIM_MID
    LONG    runStartMs                                      ' getms() at run start
    LONG    bRunAborted                                     ' TRUE once a run-scope abort was recorded
    LONG    bRunReturned                                    ' TRUE once runPart() reached its end
    LONG    runTrapCode                                     ' the top-level trap's value, printed every run
    LONG    runFaults                                       ' faults seen run-wide (RUN_FAULT_CAP)
    LONG    unrecovTotal                                    ' BM-UNRECOV records run-wide
    LONG    segsRun                                         ' segments that emitted BEGIN
    LONG    lastSeg                                         ' SEG_* of the last BEGIN
    LONG    curSeg                                          ' SEG_* in progress, SEG_NONE between segments
    LONG    curTid                                          ' trace id in progress, 0 when none
    LONG    curIncre                                        ' last commanded increment, for BM-ABORT
    LONG    segStartMs
    LONG    segItems
    LONG    segFaults
    LONG    segUnrecov
    LONG    lastStartMs                                     ' getms() of the last wheel or steering start
    LONG    bAnyStart
    LONG    lifeSeq                                         ' driver lifetimes started, run-wide
    LONG    traceSeq                                        ' tid source
    LONG    rungSeq                                         ' rid source
    LONG    steerSeq                                        ' sid source
    LONG    instBusyRefusals                                ' wrapper refusals because the instrument was busy (I10)
    LONG    slotLife[INST_MOTORS]                           ' lifeSeq of each wheel's current lifetime
    LONG    bSlotRetired[INST_MOTORS]                       ' MOTOR_RETIRED by recovery step 4
    LONG    lifeZeroX10[INST_MOTORS]                        ' this lifetime's floated zero-command sense_i mean x10
    LONG    lifePhX10[INST_MOTORS]                          ' this lifetime's floated phase-sum mean x10
    LONG    bLifeZeroValid[INST_MOTORS]
    LONG    bBrakeRequested[INST_MOTORS]                    ' holdAtStop(TRUE) issued and not yet released (I6)
    LONG    steerLife                                       ' lifeSeq of the steering object's current lifetime
    LONG    bSteerUp                                        ' steering.start() succeeded and stop() not yet called
    LONG    safeAbsCount[INST_MOTORS]                       ' consecutive mirror reads at or above ABS_ABORT_MV
    LONG    safeLastHeartbeat
    LONG    safeLastHeartbeatMs
    LONG    bQuietMasks                                     ' the compiled masks are the quiet set (sec 12.6)

VAR { instrument shared memory -- ownership table, design sec 2.4 }

    ' written by cog 0, read by the instrument
    LONG    instCmd
    LONG    instArg0
    LONG    instArg1
    LONG    instArg2
    LONG    instCmdSeq
    LONG    instSrc
    LONG    instDecimate
