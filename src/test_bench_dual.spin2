VAR { sign-off accumulators (design sec 5.2) -- cog 0 only; index = motor slot }

    LONG    sfStarts[INST_MOTORS]                           ' REVB/INTEG: wheel starts
    LONG    sfNotRevb[INST_MOTORS]
    LONG    sfIntegSum[INST_MOTORS]                         ' saturates at LIM_BIG
    LONG    sfIntegN[INST_MOTORS]                           ' rungs folded into sfIntegSum
    LONG    bSfLiveRan[INST_MOTORS]                         ' INSTLIVE: the QTR rung reached AT_SPEED
    LONG    bSfLiveOk[INST_MOTORS]
