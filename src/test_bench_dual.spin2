  '                 is opened by the floor tiers (Stephen 2026-09-30, R1), so no panel routine, PLOT, PC_KEY or PC_MOUSE
  '                 is compiled into a PART_SPIN image and the compiler, not a guard, proves that no call remains
#ifdef DBP_BRAKE
#define DBG_PANEL
#elseifdef DBP_FLOOR
#define DBG_PANEL
#elseifdef DBP_UICHECK
#define DBG_PANEL
#endif
