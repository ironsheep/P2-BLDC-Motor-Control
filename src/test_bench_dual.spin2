    LONG    uiStepCount                                     ' BM-UISTEP records emitted

VAR { operator panel and attended-segment staging -- cog 0 only }

    LONG    panelKey                                        ' PC_KEY's reading, 0 when no key is latched
    LONG    panelMouse[MOUSE_LONGS]                         ' PC_MOUSE's seven longs: one array, so adjacent by construction
    LONG    bPanelKeyArmed                                  ' a 0 key reading was seen since the last key taken
    LONG    bPanelMouseArmed                                ' a released left button was seen since the last click taken
    LONG    pnlPrompt                                       ' BM_PROMPT_* on screen
    LONG    pnlState                                        ' BM_STATE_* on screen
    LONG    pnlLive                                         ' PNL_LIVE_* mask of the live buttons
    LONG    pnlPressed                                      ' BM_BTN_* drawn highlighted, PNL_BTN_NONE when none
    LONG    pnlSeconds                                      ' countdown on screen, PNL_NO_COUNTDOWN when blank
    LONG    operShownMs                                     ' getms() when the prompt now on screen was shown
    LONG    operQueue[OPER_QUEUE_MAX * OQ_LONGS]            ' BM-OPER records noted and not yet emitted
    LONG    operQueueCount
    LONG    bOutMarked                                      ' OUTSIDE: the fault mark was written, so the trace has a mark
    LONG    flRunMs                                         ' BM-FLOOR
    LONG    flAnswer
    LONG    flInput
    LONG    flLeftRateX10
    LONG    flRightRateX10
    LONG    bFlRates
    LONG    flSlower
    LONG    flStopBy
    LONG    flLeftPwr                                       ' BM-STRACE: getPower() read back after driveDirection()
    LONG    flRightPwr
    LONG    bFlDrove                                        ' driveDirection() was called

VAR { watchdog cog }

    LONG    wdStack[WD_STACK_LONGS]
    LONG    wdStackSentinel                                 ' MUST abut wdStack (P2AN006); checked on the stall path
    LONG    wdCogId
    LONG    wdSeq                                           ' the watchdog's record seq, from logSeq at declaration
    LONG    wdSnapCheckpoint
    LONG    wdSnapLeftCog
    LONG    wdSnapRightCog
    LONG    wdSnapSteerUp
    LONG    wdSnapInstState
    LONG    wdSnapDuty[INST_MOTORS]
    LONG    wdSnapErr[INST_MOTORS]
    LONG    wdSnapSenseI[INST_MOTORS]
    LONG    wdSnapState[INST_MOTORS]
    LONG    wdSnapFault[INST_MOTORS]
    LONG    wdSnapPos[INST_MOTORS]

PUB main() | trapCode
'' Run this build's part of the motion harness, then stop every cog it started and end the session.
''

' Local Variables:
' @local trapCode - value delivered by the one top-level trap around runPart() (I9)

    initRunState()
    wdStackSentinel := WD_STACK_SENTINEL                    ' in place before the cog that could overrun it
    wdCogId := cogspin(NEWCOG, watchdog(), @wdStack)
    emitWdStart(wdCogId >= 0, wdCogId)
    emitHeaderRecords()
    instStart()
    bRunReturned := FALSE
    trapCode := \runPart()                                  ' the ONLY trap in this file (I9)
    runTrapCode := trapCode
    instIdleForShutdown()                                   ' I10: no wheel is stopped under a reading instrument
    shutdownAll()
    instStop()
    ' The watchdog is stopped only when it is not declaring (test_bench_scan.spin2 main()); if it is,
    '  its records are the session's end and cog 0 parks without emitting.
    if wdDeclaring == FALSE
        if wdCogId >= 0
            cogstop(wdCogId)
        emitSignoffs()
        emitTrap(trapCode, bRunReturned)
        emitEnd(bRunAborted ? EXIT_ABORTED : EXIT_COMPLETE)
        ' QUOTED, not backticked: a backtick makes it a display command and the marker is missed
        debug("DEBUG_END_SESSION")
    else
        repeat
            waitms(WD_IDLE_MS)

PRI initRunState() | slotIdx
' Reset every run-wide counter, lifetime slot and sign-off accumulator before anything is emitted.
'
' @local slotIdx - motor slot

    beat(CP_INIT)
    logSeq := 0
    runStartMs := getms()
    bRunAborted := FALSE
    bRunReturned := FALSE
    runTrapCode := 0
    runFaults := 0
    unrecovTotal := 0
    segsRun := 0
    lastSeg := SEG_NONE
    curSeg := SEG_NONE
    curTid := 0
    curIncre := 0
    lastStartMs := runStartMs
    bAnyStart := FALSE
    lifeSeq := 0
    traceSeq := 0
    rungSeq := 0
    steerSeq := 0
    steerLife := 0
    bSteerUp := FALSE
    instBusyRefusals := 0
    instCogId := -1
    instCmdSeq := 0
    instAckSeq := 0
    instState := INST_ST_IDLE
    instSrc := INST_SRC_NONE
    instDecimate := 1
    sfTraces := 0
    sfTraceLost := 0
    bSfBrakeRan := FALSE
    bSfBrakeSeen := FALSE
    bSfFloorRan := FALSE
    bSfFloorAnswered := FALSE
    bSfUiRan := FALSE
    bSfUiOk := FALSE
    uiStepCount := 0
    outCount := 0
    operQueueCount := 0
    pnlPressed := PNL_BTN_NONE
    pnlSeconds := PNL_NO_COUNTDOWN
    bOutMarked := FALSE
    bFlDrove := FALSE
    bQuietMasks := (user.MOTOR_DBG_MASK == QUIET_DBG_MASK) and (user.STEER_DBG_MASK == QUIET_DBG_MASK)
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        slotLife[slotIdx] := 0
        bSlotRetired[slotIdx] := FALSE
        lifeZeroX10[slotIdx] := 0
        lifePhX10[slotIdx] := 0
        bLifeZeroValid[slotIdx] := FALSE
        bBrakeRequested[slotIdx] := FALSE
        safeAbsCount[slotIdx] := 0
        sfStarts[slotIdx] := 0
        sfNotRevb[slotIdx] := 0
        sfIntegSum[slotIdx] := 0
        sfIntegN[slotIdx] := 0
        bSfLiveRan[slotIdx] := FALSE
        bSfLiveOk[slotIdx] := FALSE
        sfFrameCaps[slotIdx] := 0
        sfIdleUp[slotIdx] := 0
        bSfClkRan[slotIdx] := FALSE
        bSfClkOk[slotIdx] := FALSE
        sfFaults[slotIdx] := 0
        sfResetUncleared[slotIdx] := 0
        bSfRampRan[slotIdx] := FALSE
        bSfRampOk[slotIdx] := FALSE
        bSfOffRan[slotIdx] := FALSE
        bSfOffOk[slotIdx] := TRUE                           ' ANDed over every restore; NOMEAS until one ran

PRI runPart()
' Run this build's segments in the design's sec 4.1 order. Every segment after a run abort is emitted
' as BM-SEG SKIP ABORTED and not run. No part flag: nothing runs.
'
' Returns no value, so the top-level trap in main() carries only an abort code (0 when none), and
' bRunReturned alone says whether runPart() reached its end (I9: one value, one meaning).

    case PART_ID
        PART_A:
            runSegment(SEG_PREFLT)
            runSegment(SEG_STOPMODE)
            runSegment(SEG_LIVE)
            runSegment(SEG_LADDER)
        PART_CLOCK:
            runSegment(SEG_PREFLT)
            runSegment(SEG_CLOCK)
        PART_B:
            runSegment(SEG_PREFLT)
            runSegment(SEG_FAULTB)
            runSegment(SEG_OVERSHT)
        PART_BRAKE:
            runSegment(SEG_OUTSIDE)
        PART_C:
            runSegment(SEG_PREFLT)
            runSegment(SEG_BASELINE)
            runSegment(SEG_POSTFLT)
        PART_FLOOR:
            runSegment(SEG_FLOOR)
        PART_UICHECK:
            runSegment(SEG_UICHECK)
    bRunReturned := TRUE                                    ' before the return, or main() reads a library abort

PRI runSegment(seg)
' Run one segment when the run caps allow it; otherwise record that it was skipped.
'
' @param seg - SEG_* to run

    if runContinue(seg)
        case seg
            SEG_PREFLT:
                if segPreflight() == FALSE
                    bRunAborted := TRUE
            SEG_STOPMODE:
                segStopMode()
            SEG_LIVE:
                segLive()
            SEG_LADDER:
                segLadder()
            SEG_CLOCK:
                segClock()
            SEG_FAULTB:
                segFaultBoundary()
            SEG_OVERSHT:
                segOvershoot()
            SEG_OUTSIDE:
                segOutside()
            SEG_BASELINE:
                segBaseline()
            SEG_POSTFLT:
                segPostFault()
            SEG_FLOOR:
                segFloor()
            SEG_UICHECK:
                segUiCheck()
    else
        emitSeg(seg, SEGEV_SKIP, segAttended(seg), 0, 0, 0, 0, WHY_ABORTED)

PRI runContinue(seg) : bContinue | elapsedS
' Check the run caps (design sec 4.2 item 6) before a segment or trial; the first cap hit records a
' run-scope BM-ABORT once.
'
' @param seg - SEG_* about to run, for the abort record
' @returns bContinue - TRUE when the run has not aborted
'
' @local elapsedS - seconds since run start

    if bRunAborted == FALSE
        elapsedS := (getms() - runStartMs) / MS_PER_SEC
        if elapsedS >= RUN_TIME_CAP_S
            emitAbort(seg, curTid, SIDE_NONE, curIncre, ABR_TIME_CAP, elapsedS, SCOPE_RUN)
            bRunAborted := TRUE
        elseif runFaults >= RUN_FAULT_CAP
            emitAbort(seg, curTid, SIDE_NONE, curIncre, ABR_FAULT_CAP, runFaults, SCOPE_RUN)
            bRunAborted := TRUE
    bContinue := (bRunAborted == FALSE)

PRI segAttended(seg) : bAttended
' Report whether a segment needs a person at the rig (OUTSIDE, FLOOR and UICHECK).
'
' @param seg - SEG_* value
' @returns bAttended - TRUE for an attended segment

    bAttended := (seg == SEG_OUTSIDE) or (seg == SEG_FLOOR) or (seg == SEG_UICHECK)

PRI segBegin(seg)
' Open a segment: reset its counters and emit BM-SEG BEGIN.
'
' @param seg - SEG_* value

    curSeg := seg
    lastSeg := seg
    segsRun := (segsRun + 1) <# LIM_TINY
    segStartMs := getms()
    segItems := 0
    segFaults := 0
    segUnrecov := 0
    emitSeg(seg, SEGEV_BEGIN, segAttended(seg), 0, 0, 0, 0, WHY_NONE)

PRI segEnd(whyCode)
' Close the segment in progress with BM-SEG END and its counts.
'
' @param whyCode - WHY_* naming why the segment ended short, or WHY_NONE

    emitSeg(curSeg, SEGEV_END, segAttended(curSeg), segItems, segFaults, segUnrecov, getms() - segStartMs, whyCode)
    curSeg := SEG_NONE
    curTid := 0

PRI segStopMode() | side, speedIdx, signMul
' STOPMODE (part A, T1-1): C-4 deceleration data and the S-9a FLOAT / BRAKE / pins-cleared baselines.
' Per motor x speed (QTR, HALF) x sign (NEG, POS) x STOPMODE_REPS: one driver lifetime, three traces.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local speedIdx - 0 QTR, 1 HALF
' @local signMul - SIGN_NEG then SIGN_POS

    segBegin(SEG_STOPMODE)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat speedIdx from 0 to STOPMODE_SPEEDS - 1
            repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
                repeat STOPMODE_REPS
                    beat(CP_LOOP_POLL)
                    stopModeLifetime(SEG_STOPMODE, side, lookupz(speedIdx: QTR_SPEED_INCRE, HALF_SPEED_INCRE) * signMul, TRUE)
    segEnd(segWhy())

PRI segLive() | side, rungNum, whyCode
' LIVE (part A, T1-2, W): telemetry liveness beside testGetRpm(). Per motor one lifetime with
' startSenseCog() (its debug compiled out, I5); positive rungs QTR, HALF, LIVE_TOP_INCRE.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local rungNum - 0 QTR, 1 HALF, 2 LIVE_TOP_INCRE
' @local whyCode - why the remaining rungs are skipped, WHY_NONE while they run

    segBegin(SEG_LIVE)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        whyCode := WHY_NONE
        if runContinue(SEG_LIVE) == FALSE
            whyCode := WHY_ABORTED
        elseif wheelStart(SEG_LIVE, side) == FALSE
            whyCode := stWhy
        else
            wheelStartSense(side)
        repeat rungNum from 0 to LIVE_RUNGS - 1
            beat(CP_LOOP_POLL)
            whyCode := trialSkipWhy(SEG_LIVE, side, whyCode)
            whyCode := liveRung(side, nextRungId(), rungNum, lookupz(rungNum: QTR_SPEED_INCRE, HALF_SPEED_INCRE, LIVE_TOP_INCRE), whyCode)
        zeroAndWaitStopped(side)
        instIdle()
        wheelStop(side)
    segEnd(segWhy())

PRI segLadder() | side, signMul
' LADDER (part A, T1-3): C-1 speed law, C-5 duty question, S-3 linearity, C-6 data. Per motor x sign
' (NEG then POS) one lifetime over every ladderIncre rung; the BM-LADDER table is in the header records.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS

    segBegin(SEG_LADDER)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            beat(CP_LOOP_POLL)
            ladderSign(SEG_LADDER, side, signMul, @ladderAllIdx, LADDER_RUNGS)
    segEnd(segWhy())

PRI segClock() | side, signMul
' CLOCK (the three clock loads, T1-4): frame count and net current at 75_000_000, per motor x sign.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS

    segBegin(SEG_CLOCK)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            beat(CP_LOOP_POLL)
            clockLifetime(side, signMul)
    segEnd(segWhy())

PRI segFaultBoundary() | side, signMul, trialIdx, whyCode
' FAULTB (part B, T1-7): the ramp_inc fault-boundary sweep (C-5, Z; S-1 not measured). Per motor x sign
' one lifetime and FB_TRIALS trials, ramp_inc ascending.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS
' @local trialIdx - 0-based trial
' @local whyCode - why the lifetime did not start, WHY_NONE when it did

    segBegin(SEG_FAULTB)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            whyCode := WHY_NONE
            if runContinue(SEG_FAULTB) == FALSE
                whyCode := WHY_ABORTED
            elseif wheelStart(SEG_FAULTB, side) == FALSE
                whyCode := stWhy
            repeat trialIdx from 0 to FB_TRIALS - 1
                beat(CP_LOOP_POLL)
                faultbTrial(side, signMul, trialIdx, whyCode)
            zeroAndWaitStopped(side)
            instIdle()
            wheelStop(side)
    segEnd(segWhy())

PRI segOvershoot() | distIdx, whyCode, sid
' OVERSHT (part B, T1-8): C-3 distance overshoot through the steering object. Both wheel objects are
' stopped first (shared pin claims, PL-18); steerStart() sets holdAtStop(FALSE); the distance power is
' set once to OVERSHT_POWER, the value every trial prints (sec 12.8: never read back through the
' steering getter, PL-51); 2 ft and 10 ft x OVERSHT_REPS; steering.stop() at the end.
'
' @local distIdx - 0 short, 1 long
' @local whyCode - why the remaining trials are skipped, WHY_NONE while they run
' @local sid - the steering start's life, 0 when it did not start

    segBegin(SEG_OVERSHT)
    wheelStop(SIDE_LEFT)
    wheelStop(SIDE_RIGHT)
    whyCode := WHY_NONE
    sid := 0
    if runContinue(SEG_OVERSHT) == FALSE
        whyCode := WHY_ABORTED
    elseif steerStart(SEG_OVERSHT) == FALSE
        whyCode := WHY_NO_COG
    else
        sid := steerLife
        beat(CP_LIB_STEER_DRIVE)
        steering.setMaxSpeedForDistance(OVERSHT_POWER)
        beat(CP_LIB_STEER_DRIVE)
    repeat distIdx from 0 to OVERSHT_DISTS - 1
        repeat OVERSHT_REPS
            beat(CP_LOOP_POLL)
            whyCode := overshootTrial(sid, lookupz(distIdx: OVERSHT_FT_SHORT, OVERSHT_FT_LONG), lookupz(distIdx: OVERSHT_TGT_SHORT, OVERSHT_TGT_LONG), whyCode)
    instIdle()
    steerStop()
    segEnd(segWhy())

PRI segOutside() | whyCode
' OUTSIDE (attended load 6, T1-9): M, AF, S-5, Z. The panel asks for START and nothing moves before it
' (sec 8.3); a START timeout ends the segment with no motion. outsideRun() then drives both wheels at
' STEER_POWER_HALF, asks for the LEFT hand-brake and polls the public API through the fault and both Z
' steps.
'
' @local whyCode - why the segment ended short, WHY_NONE when it ran through

    segBegin(SEG_OUTSIDE)
    panelSetup()
    whyCode := operStartPrompt(PROMPT_BRAKE_L, BM_PROMPT_BRAKE_START)
    if whyCode == WHY_NONE
        whyCode := outsideRun()
    operFlush()
    segEnd((whyCode <> WHY_NONE) ? whyCode : segWhy())

PRI segBaseline() | side, signMul
' BASELINE (part C, before POSTFLT, I7): STOPMODE conditions (1) and (2) at HALF, per motor x sign, one
' lifetime each. Shares stopModeLifetime() with STOPMODE.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS

    segBegin(SEG_BASELINE)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            beat(CP_LOOP_POLL)
            stopModeLifetime(SEG_BASELINE, side, HALF_SPEED_INCRE * signMul, FALSE)
    segEnd(segWhy())

PRI segPostFault() | side, signMul, reqMode, whyCode
' POSTFLT (part C, T1-1 d and e; S-9a): coast after a provoked fault (NEG, HALF, FLOAT then BRAKE) and
' after an e-stop (both signs, HALF, FLOAT then BRAKE), per motor in one lifetime. No outcome is
' labelled (I7): BASELINE's traces in this load are the comparison.
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS
' @local reqMode - MODE_FLOAT then MODE_BRAKE
' @local whyCode - why the lifetime did not start, WHY_NONE when it did

    segBegin(SEG_POSTFLT)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        whyCode := WHY_NONE
        if runContinue(SEG_POSTFLT) == FALSE
            whyCode := WHY_ABORTED
        elseif wheelStart(SEG_POSTFLT, side) == FALSE
            whyCode := stWhy
        repeat reqMode from MODE_FLOAT to MODE_BRAKE
            beat(CP_LOOP_POLL)
            eventTrace(SEG_POSTFLT, side, HALF_SPEED_INCRE * SIGN_NEG, CAUSE_FAULT, EVT_OFFSET, reqMode, whyCode)
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            repeat reqMode from MODE_FLOAT to MODE_BRAKE
                beat(CP_LOOP_POLL)
                eventTrace(SEG_POSTFLT, side, HALF_SPEED_INCRE * signMul, CAUSE_ESTOP, EVT_ESTOP, reqMode, whyCode)
        instIdle()
        wheelStop(side)
    segEnd(segWhy())

PRI segFloor() | whyCode
' FLOOR (attended load 9, T2-1; AC). The panel asks for START and nothing moves before it (sec 8.3); a
' START timeout ends the segment with no motion. floorRun() then drives driveDirection(FLOOR_POWER,
' FLOOR_DIRECTION) for FLOOR_RUN_MS with STOP always live, and asks which way the platform turned.
'
' @local whyCode - why the segment ended short, WHY_NONE when it ran through

    segBegin(SEG_FLOOR)
    panelSetup()
    whyCode := operStartPrompt(PROMPT_FLOOR, BM_PROMPT_FLOOR_START)
    if whyCode == WHY_NONE
        whyCode := floorRun()
    operFlush()
    segEnd((whyCode <> WHY_NONE) ? whyCode : segWhy())

PRI segUiCheck() | stepIdx
' UICHECK (tier dual-ui; STEPHEN 2026-09-15: "a no-motor-control test form of run that takes me thru the
' series of UI controls to make sure they work"): no wheel or steering object is ever started. Every panel
' button is taken once as a mouse click and once as its key, one live button at a time; then every attended
' screen is drawn as the attended parts draw it, START when it reads right and SKIP when it does not.
' Each step is a BM-UISTEP; R14-DUAL-UICHECK-U is TRUE only when every step was OK. The result screen
' waits for START so the operator reads it before the session ends.
'
' @local stepIdx - button or screen index

    segBegin(SEG_UICHECK)
    panelSetup()
    bSfUiRan := TRUE
    bSfUiOk := TRUE
    repeat stepIdx from 0 to BM_BTN_COUNT - 1
        uiCheckButton(BM_PROMPT_UI_CLICK, UIK_CLICK, INPUT_MOUSE, stepIdx)
    repeat stepIdx from 0 to BM_BTN_COUNT - 1
        uiCheckButton(BM_PROMPT_UI_KEY, UIK_KEY, INPUT_KEY, stepIdx)
    panelShow(BM_PROMPT_UI_PREVIEW, BM_STATE_UI_CHECK, PNL_LIVE_START, PNL_BTN_NONE)
    operWait(PNL_LIVE_START, UI_STEP_TIMEOUT_MS, SIDE_NONE, FALSE)
    repeat stepIdx from 0 to UI_PREVIEWS - 1
        uiCheckScreen(stepIdx)
    panelShow(BM_PROMPT_UI_END, bSfUiOk ? BM_STATE_UI_PASSED : BM_STATE_UI_FAILED, PNL_LIVE_START, PNL_BTN_NONE)
    operWait(PNL_LIVE_START, UI_STEP_TIMEOUT_MS, SIDE_NONE, FALSE)
    segEnd(segWhy())

PRI uiCheckButton(promptIdx, kindCode, inputWanted, btnIdx) | startMs, remainMs, buttonIdx, inputCode, resultCode
' One UICHECK control step: only btnIdx is live, and the step is OK only when that button arrives through
' the one input this step checks, so a working key cannot pass a broken mouse. A received button is drawn
' highlighted for UI_HILITE_MS.
'
' @param promptIdx - BM_PROMPT_UI_CLICK or BM_PROMPT_UI_KEY
' @param kindCode - UIK_CLICK or UIK_KEY
' @param inputWanted - INPUT_MOUSE or INPUT_KEY
' @param btnIdx - BM_BTN_* under test
'
' @local startMs - getms() when the step was shown
' @local remainMs - ms left in the step
' @local buttonIdx - BM_BTN_* received, PNL_BTN_NONE on timeout
' @local inputCode - INPUT_* of the button received
' @local resultCode - UIR_OK or UIR_TIMEOUT

    panelShow(promptIdx, BM_STATE_UI_CHECK, DECOD btnIdx, PNL_BTN_NONE)
    startMs := getms()
    resultCode := UIR_TIMEOUT
    inputCode := INPUT_NONE
    repeat
        remainMs := UI_STEP_TIMEOUT_MS - (getms() - startMs)
        if remainMs <= 0
            quit
        buttonIdx, inputCode, _ := operWait(DECOD btnIdx, remainMs, SIDE_NONE, FALSE)
        if buttonIdx == PNL_BTN_NONE
            quit
        if inputCode == inputWanted
            resultCode := UIR_OK
            quit
    if resultCode == UIR_OK
        panelShow(promptIdx, BM_STATE_UI_CHECK, PNL_LIVE_NONE, btnIdx)
        waitBeat(UI_HILITE_MS, CP_LOOP_OPER)
        emitUiStep(kindCode, btnIdx, btnIdx, promptIdx, resultCode, inputCode, getms() - startMs)
    else
        bSfUiOk := FALSE
        emitUiStep(kindCode, btnIdx, PNL_BTN_NONE, promptIdx, resultCode, INPUT_NONE, getms() - startMs)

PRI uiCheckScreen(screenIdx) | promptIdx, stateIdx, startMs, buttonIdx, inputCode, resultCode
' One UICHECK screen: an attended screen's prompt and state word exactly as the attended parts draw them,
' with START and SKIP live. START means it reads right; SKIP means something is wrong.
'
' @param screenIdx - 0..UI_PREVIEWS-1, in the order the attended parts show their screens
'
' @local promptIdx - BM_PROMPT_* drawn
' @local stateIdx - BM_STATE_* drawn
' @local startMs - getms() when the screen was shown
' @local buttonIdx - BM_BTN_START, BM_BTN_SKIP, or PNL_BTN_NONE on timeout
' @local inputCode - INPUT_* of the button received
' @local resultCode - UIR_* of the step

    promptIdx := lookupz(screenIdx: BM_PROMPT_BRAKE_START, BM_PROMPT_BRAKE_NOW, BM_PROMPT_BRAKE_RELEASE, BM_PROMPT_BRAKE_RUNNING, BM_PROMPT_FLOOR_START, BM_PROMPT_FLOOR_START, BM_PROMPT_FLOOR_ASK)
    stateIdx := lookupz(screenIdx: BM_STATE_WAITING, BM_STATE_BRAKE_NOW, BM_STATE_RELEASE, BM_STATE_WHEELS_AGAIN, BM_STATE_WAITING, BM_STATE_OBSERVING, BM_STATE_ASK)
    panelShow(promptIdx, stateIdx, PNL_LIVE_START | PNL_LIVE_SKIP, PNL_BTN_NONE)
    startMs := getms()
    buttonIdx, inputCode, _ := operWait(PNL_LIVE_START | PNL_LIVE_SKIP, UI_STEP_TIMEOUT_MS, SIDE_NONE, FALSE)
    if buttonIdx == BM_BTN_START
        resultCode := UIR_OK
    elseif buttonIdx == BM_BTN_SKIP
        resultCode := UIR_WRONG
        bSfUiOk := FALSE
    else
        resultCode := UIR_TIMEOUT
        bSfUiOk := FALSE
    if buttonIdx <> PNL_BTN_NONE
        panelShow(promptIdx, stateIdx, PNL_LIVE_NONE, buttonIdx)
        waitBeat(UI_HILITE_MS, CP_LOOP_OPER)
    emitUiStep(UIK_PREVIEW, PNL_BTN_NONE, buttonIdx, promptIdx, resultCode, inputCode, getms() - startMs)

PRI segPreflight() : bAllMoved | side, bMoved
' PREFLT (every motion load, design sec 4.4): prove each wheel turns before anything is measured. A
' wheel that moves 0 ticks ends the run with BM-ABORT scope RUN reason NO_MOTION.
'
' @returns bAllMoved - TRUE when both wheels moved
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local bMoved - this wheel moved

    segBegin(SEG_PREFLT)
    bAllMoved := TRUE
    repeat side from SIDE_LEFT to SIDE_RIGHT
        beat(CP_LOOP_POLL)
        bMoved := preflightWheel(side)
        if bMoved == FALSE
            bAllMoved := FALSE
        segItems += 1
    if bAllMoved == FALSE
        emitAbort(SEG_PREFLT, 0, SIDE_NONE, PREFLIGHT_INCRE, ABR_NO_MOTION, 0, SCOPE_RUN)
    segEnd(bAllMoved ? WHY_NONE : WHY_ABORTED)

PRI preflightWheel(side) : bMoved | slotIdx, safeEvent, ticksMoved, hwMoved, bMeasured, whyCode, lastJ
' One wheel's preflight: start it alone (I6), arm the instrument on it, PREFLIGHT_INCRE for
' PREFLIGHT_MS, zero, wait stopped, freeze, and measure the driver tick and hwPos deltas from the ring.
' Emits BM-START (inside wheelStart()) and BM-PREFLT. A fault is recovered per sec 4.2.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bMoved - TRUE when the driver's tick count changed across the nudge
'
' @local slotIdx - motor slot
' @local safeEvent - SAFE_* from the watched waits
' @local ticksMoved - driver pos delta over the capture
' @local hwMoved - hwPos delta over the capture
' @local bMeasured - the deltas are measurements
' @local whyCode - first cause of any NA in BM-PREFLT
' @local lastJ - logical index of the last drained sample

    slotIdx := side - SIDE_LEFT
    bMoved := FALSE
    bMeasured := FALSE
    ticksMoved := 0
    hwMoved := 0
    whyCode := WHY_NONE
    safeEvent := SAFE_NONE
    curTid := 0
    if wheelStart(SEG_PREFLT, side) == FALSE
        whyCode := stWhy
    elseif instArm(INST_SRC_WHEELS, 1) == FALSE
        whyCode := WHY_INST_NOACK
    else
        instMark()
        wheelCommand(side, PREFLIGHT_INCRE)
        safeEvent, _ := waitWatched(side, PREFLIGHT_MS, CP_LOOP_CAPTURE, UNTIL_TIME)
        if safeEvent == SAFE_NONE
            wheelCommand(side, 0)
            safeEvent, _ := waitWatched(side, STOP_TIMEOUT_MS, CP_LOOP_STOPPED, UNTIL_STOPPED)
        else
            wheelCommand(side, 0)
        if instFreeze(0)
            drainBegin()
            if drStored > 1
                lastJ := drStored - 1
                ticksMoved := smpPos(lastJ, slotIdx) - smpPos(0, slotIdx)
                hwMoved := smpHw(lastJ, slotIdx) - smpHw(0, slotIdx)
                bMeasured := TRUE
            else
                whyCode := WHY_NO_SAMPLES
        else
            whyCode := WHY_INST_NOACK
        if safeEvent == SAFE_INST_STALL
            emitAbort(SEG_PREFLT, 0, side, PREFLIGHT_INCRE, ABR_INST_STALLED, INST_STALL_MS, SCOPE_SEG)
        if safeEvent == SAFE_FAULT
            recoverFault(SEG_PREFLT, 0, side, PREFLIGHT_INCRE, FAULT_COOL_MS)
    bMoved := bMeasured and (ticksMoved <> 0)
    emitPreflt(side, PREFLIGHT_INCRE, ticksMoved, hwMoved, bMeasured, whyCode)
    instIdle()
    wheelStop(side)

CON { --- segment routines: traces (STOPMODE, BASELINE, POSTFLT, FAULTB), rungs (LADDER, LIVE, CLOCK), OVERSHT --- }

PRI stopModeLifetime(seg, side, motorIncre, bWithStopCog) | whyCode
' One stop-mode driver lifetime, the routine STOPMODE and BASELINE share: start the wheel under test
' alone (I6; the lifetime zero is read inside wheelStart()), then condition (1) STOPCMD FLOAT, (2)
' STOPCMD BRAKE and, when asked, (3) STOPCOG FLOAT, which ends the lifetime.
'
' @param seg - SEG_STOPMODE or SEG_BASELINE
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param bWithStopCog - TRUE to trace condition (3)
'
' @local whyCode - why the lifetime did not start, WHY_NONE when it did

    whyCode := WHY_NONE
    if runContinue(seg) == FALSE
        whyCode := WHY_ABORTED
    elseif wheelStart(seg, side) == FALSE
        whyCode := stWhy
    eventTrace(seg, side, motorIncre, CAUSE_STOPCMD, EVT_STOPMOTOR, MODE_FLOAT, whyCode)
    eventTrace(seg, side, motorIncre, CAUSE_STOPCMD, EVT_STOPMOTOR, MODE_BRAKE, whyCode)
    if bWithStopCog
        eventTrace(seg, side, motorIncre, CAUSE_STOPCOG, EVT_STOPCOG, MODE_FLOAT, whyCode)
    instIdle()
    wheelStop(side)

PRI eventTrace(seg, side, motorIncre, causeCode, eventCode, reqMode, skipWhy) | tid, whyCode, rampInc
' One wheel trace, the trace routine STOPMODE, BASELINE and POSTFLT share: BRAKE requested before
' spin-up, on the wheel under test only (I6); eventCapture(); every side effect restored and read back,
' then BM-TRACE, BM-TS and BM-TRACE-END (traceEmitCapture()); recovery per sec 4.2, zero and wait
' stopped (traceRecover()). A trial the caps, a retired motor or a stopped driver prevent is emitted as
' its header and an empty end naming the cause.
'
' @param seg - SEG_STOPMODE, SEG_BASELINE or SEG_POSTFLT
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param causeCode - CAUSE_* the header names (what was done, I7)
' @param eventCode - EVT_* the trial issues
' @param reqMode - MODE_FLOAT or MODE_BRAKE (what was requested, I7)
' @param skipWhy - WHY_NONE to run, else why the lifetime could not start
'
' @local tid - trace id
' @local whyCode - why the trial is skipped, WHY_NONE when it runs
' @local rampInc - ramp_inc read back for the header

    tid := nextTraceId()
    cpReset()
    whyCode := trialSkipWhy(seg, side, skipWhy)
    rampInc := wheelRampInc(side)
    if whyCode <> WHY_NONE
        cpWantNeg, cpWantPos := wheelGetOffsets(side)
        traceSkip(tid, seg, side, causeCode, motorIncre, reqMode, rampInc, whyCode)
    else
        if reqMode == MODE_BRAKE
            wheelHold(side, TRUE)
        eventCapture(side, motorIncre, eventCode)
        traceEmitCapture(seg, side, tid, causeCode, motorIncre, reqMode, rampInc)
        traceRecover(seg, side, tid, motorIncre, FAULT_COOL_MS)
    segItems := (segItems + 1) <# LIM_SMALL

PRI eventCapture(side, motorIncre, eventCode) | safeEvent, bReached, bRest, markMs, captureLeftMs
' Run one wheel trace's motion and capture (design sec 4.4): arm; command; AT_SPEED (<=
' STEADY_TIMEOUT_MS); settle SETTLE_MS; read the offsets; mark; the event; capture until rest or
' traceCaptureMs(1); freeze. EVT_OFFSET first waits POSTFLT_NO_FAULT_MS for the provoked fault and, when
' none comes, restores the offsets and stops the motor at once (why NO_FAULT). EVT_STOPCOG calls stop()
' while the instrument runs, because the cog stop IS the event under capture (condition 3): the one I10
' exception besides the absolute-current abort; a straddled sample is gated by up (I3). Fills the cp*
' staging; the remaining restores are traceEmitCapture()'s.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param eventCode - EVT_* value
'
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - AT_SPEED was reached
' @local bRest - rest was confirmed
' @local markMs - getms() at the mark
' @local captureLeftMs - capture bound still owed after the no-fault wait

    safeEvent := SAFE_NONE
    bReached := FALSE
    cpWantNeg, cpWantPos := wheelGetOffsets(side)
    if instArm(INST_SRC_WHEELS, 1) == FALSE
        cpWhy := WHY_INST_NOACK
    else
        wheelCommand(side, motorIncre)
        safeEvent, bReached := waitWatched(side, STEADY_TIMEOUT_MS, CP_LOOP_ATSPEED, UNTIL_AT_SPEED)
        if (safeEvent == SAFE_NONE) and bReached
            safeEvent, _ := waitWatched(side, SETTLE_MS, CP_LOOP_SETTLE, UNTIL_TIME)
        if safeEvent <> SAFE_NONE
            cpWhy := safeWhy(safeEvent)
            cpEnd := safeEnd(safeEvent)
            bCpFaultSeen := (safeEvent == SAFE_FAULT)
        elseif bReached == FALSE
            cpWhy := WHY_STEADY_TIMEOUT
        else
            cpWantNeg, cpWantPos := wheelGetOffsets(side)    ' the pair read immediately before the event
            instMark()
            markMs := getms()
            case eventCode
                EVT_STOPMOTOR:
                    wheelStopMotor(side)
                EVT_STOPCOG:
                    wheelStopRaw(side)
                EVT_ESTOP:
                    wheelEstop(side)
                    bCpEstopSet := TRUE
                EVT_OFFSET:
                    wheelSetOffsets(side, FAULT_PROVOKE_NEG_DEG, cpWantPos)
                    bCpOffWritten := TRUE
            if eventCode == EVT_OFFSET
                safeEvent, _ := waitWatched(side, POSTFLT_NO_FAULT_MS, CP_LOOP_CAPTURE, UNTIL_TIME)
                if safeEvent == SAFE_FAULT
                    bCpFaultSeen := TRUE
                    safeEvent := SAFE_NONE                  ' the provoked fault is the event, not the capture's end
                elseif safeEvent == SAFE_NONE
                    restoreOffsets(side, cpWantNeg, cpWantPos)
                    bCpOffRestored := TRUE
                    wheelStopMotor(side)
                    cpWhy := WHY_NO_FAULT
            if safeEvent == SAFE_NONE
                captureLeftMs := (traceCaptureMs(1) - (getms() - markMs)) #> 0
                safeEvent, bRest := waitRest(side, captureLeftMs, eventCode <> EVT_OFFSET)
                cpEnd := bRest ? TEND_REST : TEND_TIMEOUT
            if safeEvent <> SAFE_NONE
                cpEnd := safeEnd(safeEvent)
                if safeEvent == SAFE_FAULT
                    bCpFaultSeen := TRUE
        bCpFrozen := instFreeze(0)
        if (bCpFrozen == FALSE) and (cpWhy == WHY_NONE)
            cpWhy := WHY_INST_NOACK

PRI rungMeasure(side, motorIncre, steadyBoundMs, settleMs, bPollCurrent) : safeEvent | slotIdx, otherIdx, startMs, bReached, missedStart, illegalStart, missedEnd, illegalEnd
' One measured rung, the routine LADDER, LIVE and CLOCK share (design sec 4.4): read the offsets,
' duty_max and integrity counts; arm; command; AT_SPEED (<= steadyBoundMs); settle; a WINDOW_MS window
' delimited by two ring totals (rungWindow(), sec 12.7); freeze; window statistics and the capture's
' idle-wheel check; integrity deltas. Fills the rg* staging and the rs* statistics; emits nothing.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param steadyBoundMs - the AT_SPEED bound
' @param settleMs - settle after AT_SPEED
' @param bPollCurrent - TRUE to read getCurrent() every CURRENT_POLL_MS in the window
' @returns safeEvent - SAFE_* that ended the rung early, SAFE_NONE otherwise
'
' @local slotIdx - motor slot
' @local otherIdx - the idle motor slot
' @local startMs - getms() at the command
' @local bReached - AT_SPEED was reached
' @local missedStart - missed transitions before the rung
' @local illegalStart - illegal codes before the rung
' @local missedEnd - missed transitions after the rung
' @local illegalEnd - illegal codes after the rung

    slotIdx := side - SIDE_LEFT
    otherIdx := SLOT_RIGHT - slotIdx
    rgResult := RES_OK
    rgWhy := WHY_NONE
    rgSteadyMs := 0
    bRgSteadyValid := FALSE
    bRgWindowValid := FALSE
    rgAmpsX10k := 0
    bRgAmpsValid := FALSE
    bRgHbOk := FALSE
    bRgCaptured := FALSE
    bRgIdleUp := FALSE
    rgWinStart := -1
    rgWinEnd := -1
    safeEvent := SAFE_NONE
    bReached := FALSE
    rsOffNeg, rsOffPos := wheelGetOffsets(side)
    _, rgDutyMax, _, _ := wheelDriveConstants(side)
    missedStart, illegalStart := wheelIntegrity(side)
    if instArm(INST_SRC_WHEELS, 1) == FALSE
        windowStats(slotIdx, otherIdx, -1, -1)              ' resets the rs* staging; reads no ring long
        rgResult := RES_SKIPPED
        rgWhy := WHY_INST_NOACK
    else
        startMs := getms()
        wheelCommand(side, motorIncre)
        ' from a previous rung the mirror still reads AT_SPEED until the driver takes the new command
        safeEvent, _ := waitWatched(side, COMMAND_SEEN_MS, CP_LOOP_ATSPEED, UNTIL_TIME)
        if safeEvent == SAFE_NONE
            safeEvent, bReached := waitWatched(side, steadyBoundMs, CP_LOOP_ATSPEED, UNTIL_AT_SPEED)
        rgSteadyMs := getms() - startMs
        if (safeEvent == SAFE_NONE) and bReached
            bRgSteadyValid := TRUE
            safeEvent, _ := waitWatched(side, settleMs, CP_LOOP_SETTLE, UNTIL_TIME)
            if safeEvent == SAFE_NONE
                safeEvent := rungWindow(side, bPollCurrent)
        bRgCaptured := instFreeze(0)
        if bRgCaptured
            bRgIdleUp := captureIdleUp(otherIdx)
            windowStats(slotIdx, otherIdx, rgWinStart, rgWinEnd)
        else
            windowStats(slotIdx, otherIdx, -1, -1)          ' I10: an unfrozen ring is never read
        case safeEvent
            SAFE_FAULT:
                rgResult := RES_FAULT
                rgWhy := WHY_FAULTED
            SAFE_ABS_ABORT:
                rgResult := RES_ABORT_I
                rgWhy := WHY_ABORTED
            SAFE_INST_STALL:
                rgResult := RES_WINDOW_TIMEOUT
                rgWhy := WHY_INST_STALLED
            other:
                if bReached == FALSE
                    rgResult := RES_STEADY_TIMEOUT
                    rgWhy := WHY_STEADY_TIMEOUT
                elseif bRgCaptured == FALSE
                    rgResult := RES_WINDOW_TIMEOUT
                    rgWhy := WHY_INST_NOACK
                elseif rsN == 0
                    rgResult := RES_WINDOW_TIMEOUT
                    rgWhy := WHY_NO_SAMPLES
                else
                    bRgWindowValid := TRUE
    missedEnd, illegalEnd := wheelIntegrity(side)
    rgMissedD := (missedEnd - missedStart) #> 0
    rgIllegalD := (illegalEnd - illegalStart) #> 0

PRI rungWindow(side, bPollCurrent) : safeEvent | startMs, lastPollMs, ampsSum, ampsCount, hbStart, bComplete
' The rung's measurement window: a start mark (ring total), WINDOW_MS of beat-polled safety reads with
' getCurrent() every CURRENT_POLL_MS when asked, and an end mark. The window is delimited by the two
' instrument-recorded totals, never by time (sec 12.7). An interrupted window records no end total.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param bPollCurrent - TRUE to read getCurrent()
' @returns safeEvent - SAFE_* that ended the window early, SAFE_NONE otherwise
'
' @local startMs - getms() at the start mark
' @local lastPollMs - getms() of the last getCurrent()
' @local ampsSum - sum of clamped readings, |sum| <= 51 x LIM_MID
' @local ampsCount - readings taken
' @local hbStart - instrument heartbeat at the window start
' @local bComplete - the window ran its full WINDOW_MS

    safetyReset()
    safeEvent := SAFE_NONE
    ampsSum := 0
    ampsCount := 0
    bComplete := FALSE
    hbStart := instHeartbeat
    rgWinStart := instMarkIndex()
    startMs := getms()
    lastPollMs := startMs
    repeat
        beat(CP_LOOP_WINDOW)
        if bPollCurrent and ((ampsCount == 0) or ((getms() - lastPollMs) >= CURRENT_POLL_MS))
            lastPollMs := getms()
            ampsSum += (wheelCurrent(side) #> (0 - LIM_MID)) <# LIM_MID
            ampsCount += 1
        waitms(SAMPLE_MS)
        safeEvent := safetyPoll(side)
        if safeEvent <> SAFE_NONE
            quit
        if (getms() - startMs) >= WINDOW_MS
            bComplete := TRUE
            quit
    if bComplete
        rgWinEnd := instMarkIndex()
    bRgHbOk := (instHeartbeat <> hbStart)
    if ampsCount > 0
        rgAmpsX10k := ampsSum / ampsCount
        bRgAmpsValid := bComplete

PRI rungEmitAll(seg, rid, rungIdx, side, motorIncre) | slotIdx, rung2Why
' Emit a measured rung's BM-RUNG, BM-RUNG2 and BM-RUNG3 from the rg* / rs* staging, and fold it into
' R14-DUAL-INTEG-A (its integrity deltas) and R14-DUAL-IDLEFLT-A (one motor-frame capture).
'
' @param seg - SEG_* in progress
' @param rid - rung id
' @param rungIdx - index into ladderIncre (or the segment's rung number)
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
'
' @local slotIdx - motor slot
' @local rung2Why - BM-RUNG2's why: the rung's, or NO_SAMPLES when only this lifetime's zero is missing

    slotIdx := side - SIDE_LEFT
    emitRung(seg, rid, rungIdx, side, motorIncre, rgResult, rgSteadyMs, bRgSteadyValid, bRgWindowValid, rgWhy)
    rung2Why := rgWhy
    if (rung2Why == WHY_NONE) and (bLifeZeroValid[slotIdx] == FALSE)
        rung2Why := WHY_NO_SAMPLES
    emitRung2(rid, side, motorIncre, rgDutyMax, bRgWindowValid, rung2Why)
    emitRung3(rid, side, motorIncre, rgMissedD, rgIllegalD, rgAmpsX10k, bRgAmpsValid, bRgWindowValid, rgWhy)
    foldIntegrity(slotIdx, rgMissedD, rgIllegalD)
    sfIntegN[slotIdx] := (sfIntegN[slotIdx] + 1) <# LIM_BIG
    if bRgCaptured
        foldIdleWheel(slotIdx, bRgIdleUp)
    segItems := (segItems + 1) <# LIM_SMALL

PRI rungSkip(seg, rid, rungIdx, side, motorIncre, whyCode)
' Emit a rung that did not run: BM-RUNG result SKIPPED with the applied offsets and why.
'
' @param seg - SEG_* in progress
' @param rid - rung id
' @param rungIdx - index into ladderIncre (or the segment's rung number)
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param whyCode - WHY_* naming why it did not run

    rsOffNeg, rsOffPos := wheelGetOffsets(side)
    emitRung(seg, rid, rungIdx, side, motorIncre, RES_SKIPPED, 0, FALSE, FALSE, whyCode)
    segItems := (segItems + 1) <# LIM_SMALL

PRI rungFaultRecover(seg, side, motorIncre, safeEvent) : bFaulted | bFaultSig
' Recover a rung's fault once its records are out (sec 4.2): a fault that ended the rung, or a fault
' flag set now.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - the rung's command
' @param safeEvent - SAFE_* that ended the rung
' @returns bFaulted - TRUE when a fault was found and recovery ran
'
' @local bFaultSig - the fault flag now

    bFaulted := (safeEvent == SAFE_FAULT)
    if (bFaulted == FALSE) and wheelIsUp(side)
        _, _, bFaultSig := wheelClearedState(side)
        bFaulted := (bFaultSig <> FALSE)
    if bFaulted
        recoverFault(seg, 0, side, motorIncre, FAULT_COOL_MS)

PRI ladderSign(seg, side, signMul, pRungTable, rungCount) | orderIdx, rungIdx, motorIncre, rid, whyCode, consecFaults, safeEvent
' One motor x sign of the ladder, driven by an index table into ladderIncre (LADDER passes
' ladderAllIdx): one lifetime (zero read inside wheelStart()), then the rungs in table order, each
' BM-RUNG / BM-RUNG2 / BM-RUNG3, faults recovered per sec 4.2. LADDER_FAULT_STOP consecutive faulted
' rungs, an absolute-current abort or a stalled instrument end the sign: the rest print SKIPPED why
' LADDER_STOPPED.
'
' @param seg - SEG_LADDER
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signMul - SIGN_NEG or SIGN_POS
' @param pRungTable - address of a LONG table of indices into ladderIncre
' @param rungCount - entries in that table
'
' @local orderIdx - position in the table
' @local rungIdx - index into ladderIncre
' @local motorIncre - signed increment
' @local rid - rung id
' @local whyCode - why the remaining rungs are skipped, WHY_NONE while they run
' @local consecFaults - consecutive faulted rungs
' @local safeEvent - SAFE_* that ended the last rung

    consecFaults := 0
    whyCode := WHY_NONE
    if runContinue(seg) == FALSE
        whyCode := WHY_ABORTED
    elseif wheelStart(seg, side) == FALSE
        whyCode := stWhy
    repeat orderIdx from 0 to rungCount - 1
        beat(CP_LOOP_POLL)
        rungIdx := LONG[pRungTable][orderIdx]
        motorIncre := ladderIncre[rungIdx] * signMul
        rid := nextRungId()
        whyCode := trialSkipWhy(seg, side, whyCode)
        if whyCode <> WHY_NONE
            rungSkip(seg, rid, rungIdx, side, motorIncre, whyCode)
        else
            safeEvent := rungMeasure(side, motorIncre, LADDER_STEADY_MS, LADDER_SETTLE_MS, TRUE)
            rungEmitAll(seg, rid, rungIdx, side, motorIncre)
            if rungFaultRecover(seg, side, motorIncre, safeEvent)
                consecFaults += 1
                if consecFaults >= LADDER_FAULT_STOP
                    whyCode := WHY_LADDER_STOPPED
            else
                consecFaults := 0
            if (safeEvent == SAFE_ABS_ABORT) or (safeEvent == SAFE_INST_STALL)
                whyCode := WHY_LADDER_STOPPED
    zeroAndWaitStopped(side)
    instIdle()
    wheelStop(side)

PRI liveRung(side, rid, rungNum, motorIncre, skipWhy) : whyNext | slotIdx, safeEvent, rpmRead
' One LIVE rung (design sec 4.4, T1-2): AT_SPEED, settle LIVE_SETTLE_MS so the rpm window fills, a
' WINDOW_MS instrument window, then testGetRpm(); BM-LIVE. The QTR rung folds R14-DUAL-INSTLIVE-A: every
' sample up, |ticks| >= LIVE_MIN_TICKS, i_min <> i_max, heartbeat advanced, |ticks - hw_ticks| <= 2.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param rid - rung id
' @param rungNum - 0 QTR, 1 HALF, 2 LIVE_TOP_INCRE
' @param motorIncre - signed increment
' @param skipWhy - WHY_NONE to run, else why it is skipped
' @returns whyNext - skip cause for the next rung, WHY_NONE while rungs may run
'
' @local slotIdx - motor slot
' @local safeEvent - SAFE_* that ended the rung
' @local rpmRead - testGetRpm() after the window

    slotIdx := side - SIDE_LEFT
    whyNext := skipWhy
    rpmRead := 0
    if skipWhy <> WHY_NONE
        windowStats(slotIdx, SLOT_RIGHT - slotIdx, -1, -1)  ' resets the rs* staging; reads no ring long
        emitLive(rid, side, motorIncre, rpmRead, FALSE, FALSE, skipWhy)
    else
        safeEvent := rungMeasure(side, motorIncre, STEADY_TIMEOUT_MS, LIVE_SETTLE_MS, FALSE)
        if bRgWindowValid
            rpmRead := wheelRpm(side)
        emitLive(rid, side, motorIncre, rpmRead, bRgHbOk, bRgWindowValid, rgWhy)
        if rungNum == LIVE_INSTLIVE_RUNG
            bSfLiveRan[slotIdx] := bRgSteadyValid
            bSfLiveOk[slotIdx] := bRgWindowValid and bRsAllUp and (abs(rsTicks) >= LIVE_MIN_TICKS) and (rsIMin <> rsIMax) and bRgHbOk and (abs(rsTicks - rsHwTicks) <= LIVE_HW_TOLERANCE)
        if rungFaultRecover(SEG_LIVE, side, motorIncre, safeEvent)
            whyNext := WHY_FAULTED                          ' a recovery restart ends the sense cog testGetRpm() needs
        elseif (safeEvent == SAFE_ABS_ABORT) or (safeEvent == SAFE_INST_STALL)
            whyNext := safeWhy(safeEvent)
    segItems := (segItems + 1) <# LIM_SMALL

PRI clockLifetime(side, signMul) | slotIdx, whyCode, deadGap, adcFrame, frameCnt, bFrameOk, rid, motorIncre, safeEvent
' One CLOCK lifetime (design sec 4.4, T1-4): start; testGetDriveConstants() -> BM-CLOCK, folded into
' this clock's R14-DUAL-CLKFRM-K200 / -K270 / -K300 cell (ANDed over the motor's lifetimes; judged only at a
' swept clock, SF_JUDGES_CELLS); zero (inside wheelStart()); one rung at
' CLOCK_RUNG_INCRE -> BM-RUNG / BM-RUNG2 / BM-RUNG3.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signMul - SIGN_NEG or SIGN_POS
'
' @local slotIdx - motor slot
' @local whyCode - why the rung is skipped, WHY_NONE when it runs
' @local deadGap - dead_gap
' @local adcFrame - adc_fram
' @local frameCnt - frame_cnt
' @local bFrameOk - adc_fram equals the compiled clock's expected frame count
' @local rid - rung id
' @local motorIncre - signed increment
' @local safeEvent - SAFE_* that ended the rung

    slotIdx := side - SIDE_LEFT
    motorIncre := CLOCK_RUNG_INCRE * signMul
    whyCode := WHY_NONE
    if runContinue(SEG_CLOCK) == FALSE
        whyCode := WHY_ABORTED
    elseif wheelStart(SEG_CLOCK, side) == FALSE
        whyCode := stWhy
    else
        deadGap, _, adcFrame, frameCnt := wheelDriveConstants(side)
        bFrameOk := emitClock(side, adcFrame, frameCnt, deadGap)
        if bSfClkRan[slotIdx]
            bSfClkOk[slotIdx] := (bSfClkOk[slotIdx] <> FALSE) and bFrameOk
        else
            bSfClkOk[slotIdx] := bFrameOk
        bSfClkRan[slotIdx] := TRUE
    rid := nextRungId()
    whyCode := trialSkipWhy(SEG_CLOCK, side, whyCode)
    if whyCode <> WHY_NONE
        rungSkip(SEG_CLOCK, rid, CLOCK_RUNG_IDX, side, motorIncre, whyCode)
    else
        safeEvent := rungMeasure(side, motorIncre, LADDER_STEADY_MS, LADDER_SETTLE_MS, TRUE)
        rungEmitAll(SEG_CLOCK, rid, CLOCK_RUNG_IDX, side, motorIncre)
        rungFaultRecover(SEG_CLOCK, side, motorIncre, safeEvent)
    zeroAndWaitStopped(side)
    instIdle()
    wheelStop(side)

PRI faultbTrial(side, signMul, trialIdx, skipWhy) | slotIdx, tid, motorIncre, rampInc, safeEvent, bReached, startMs
' One FAULTB trial (design sec 4.4, T1-7): wheel stopped; setRampingValues(1_500, 200_000, inc, 50_000)
' read back; arm; mark; FB_INCRE from standstill; capture until AT_SPEED + FB_AT_SPEED_HOLD_MS, a fault,
' or FB_TIMEOUT_MS; freeze; restore the ramp defaults and read them back (BM-RAMPREST, I11) BEFORE any
' check; BM-TRACE cause RAMP, BM-TS, BM-TRACE-END; peaks and dsat from the trace; recovery (sec 4.2);
' BM-FBTRIAL; zero, wait stopped; cool FAULT_TRIAL_COOL_MS.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param signMul - SIGN_NEG or SIGN_POS
' @param trialIdx - 0-based trial, index into fbRampIncs
' @param skipWhy - WHY_NONE to run, else why the lifetime could not start
'
' @local slotIdx - motor slot
' @local tid - trace id
' @local motorIncre - signed increment
' @local rampInc - ramp_inc read back for the header
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - AT_SPEED was reached
' @local startMs - getms() at the command

    slotIdx := side - SIDE_LEFT
    tid := nextTraceId()
    motorIncre := FB_INCRE * signMul
    cpReset()
    fbTrial := trialIdx + 1
    fbRampInc := fbRampIncs[trialIdx]
    fbIncre := motorIncre
    fbResult := RES_OK
    fbTMs := 0
    bFbTValid := FALSE
    fbIPk := 0
    fbDutyPk := 0
    bFbDsat := FALSE
    fbRst := RST_NONE
    fbRstMs := 0
    safeEvent := SAFE_NONE
    bReached := FALSE
    _, fbDutyMax, _, _ := wheelDriveConstants(side)
    cpWantNeg, cpWantPos := wheelGetOffsets(side)
    fbOffNeg := cpWantNeg
    fbOffPos := cpWantPos
    fbWhy := trialSkipWhy(SEG_FAULTB, side, skipWhy)
    if fbWhy <> WHY_NONE
        rampInc := wheelRampInc(side)
        fbResult := RES_SKIPPED
        traceSkip(tid, SEG_FAULTB, side, CAUSE_RAMP, motorIncre, MODE_FLOAT, rampInc, fbWhy)
    else
        rampInc := wheelSetRamp(side, fbRampInc)
        if instArm(INST_SRC_WHEELS, 1) == FALSE
            cpWhy := WHY_INST_NOACK
        else
            safeEvent, _ := waitWatched(side, STOP_TIMEOUT_MS, CP_LOOP_STOPPED, UNTIL_STOPPED)
            if safeEvent == SAFE_NONE
                instMark()
                startMs := getms()
                wheelCommand(side, motorIncre)
                safeEvent, bReached := waitWatched(side, FB_TIMEOUT_MS, CP_LOOP_CAPTURE, UNTIL_AT_SPEED)
                fbTMs := getms() - startMs
                bFbTValid := bReached or (safeEvent == SAFE_FAULT)
                if (safeEvent == SAFE_NONE) and bReached
                    safeEvent, _ := waitWatched(side, FB_AT_SPEED_HOLD_MS, CP_LOOP_CAPTURE, UNTIL_TIME)
            bCpFaultSeen := (safeEvent == SAFE_FAULT)
            if safeEvent <> SAFE_NONE
                cpEnd := safeEnd(safeEvent)
            else
                cpEnd := bReached ? TEND_FROZEN : TEND_TIMEOUT
            bCpFrozen := instFreeze(0)
            if bCpFrozen == FALSE
                cpWhy := WHY_INST_NOACK
        restoreRamp(side)                                   ' I11: before any check, on every path that set the ramp
        case safeEvent
            SAFE_FAULT:
                fbResult := RES_FAULT
                if bFbTValid == FALSE
                    cpWhy := WHY_FAULTED                    ' faulted before the command
            SAFE_ABS_ABORT:
                fbResult := RES_ABORT_I
                cpWhy := WHY_ABORTED
            SAFE_INST_STALL:
                fbResult := RES_WINDOW_TIMEOUT
                cpWhy := WHY_INST_STALLED
            other:
                if cpWhy <> WHY_NONE
                    fbResult := RES_SKIPPED
                elseif bReached == FALSE
                    fbResult := RES_STEADY_TIMEOUT
                    cpWhy := WHY_STEADY_TIMEOUT
        traceEmitCapture(SEG_FAULTB, side, tid, CAUSE_RAMP, motorIncre, MODE_FLOAT, rampInc)
        if bCpFrozen
            traceFaultStats(slotIdx)
        fbRst, fbRstMs := traceRecover(SEG_FAULTB, side, tid, motorIncre, FAULT_TRIAL_COOL_MS)
        if bFbTValid == FALSE
            fbWhy := (cpWhy <> WHY_NONE) ? cpWhy : WHY_NOT_REACHED
        if fbRst == RST_NONE
            waitBeat(FAULT_TRIAL_COOL_MS, CP_LOOP_COOL)
    emitFbTrial(tid, side)
    segItems := (segItems + 1) <# LIM_SMALL

PRI traceFaultStats(slotIdx) | sampleIdx, bFirstFlt
' BM-FBTRIAL's peaks from the drained trace: the largest i and duty over up samples, and dsat, whether
' duty had reached duty_max at the first sample whose fault flag is set. Legal only while FROZEN (I10).
'
' @param slotIdx - motor slot under test
'
' @local sampleIdx - logical index
' @local bFirstFlt - the first faulted sample has been seen

    fbIPk := 0
    fbDutyPk := 0
    bFbDsat := FALSE
    bFirstFlt := FALSE
    if (drStored > 0) and (drEndJ >= drStartJ)
        repeat sampleIdx from drStartJ to drEndJ
            beat(CP_LOOP_DRAIN)
            if smpUp(sampleIdx, slotIdx)
                fbIPk #>= smpI(sampleIdx, slotIdx)
                fbDutyPk #>= smpDuty(sampleIdx, slotIdx)
                if (bFirstFlt == FALSE) and smpFault(sampleIdx, slotIdx)
                    bFirstFlt := TRUE
                    bFbDsat := (smpDuty(sampleIdx, slotIdx) >= fbDutyMax)

PRI overshootTrial(sid, distFt, tgtTicks, skipWhy) : whyNext | tid, safeEvent, bReached, recoverWhy
' One OVERSHT trial (design sec 4.4, T1-8): arm on the steering source (OVERSHT_DECIM); the SYNC_PRECOND
' check before the drive call (sec 4.3); mark; driveForDistance(d, d, DDU_FT); wait both wheels moving,
' then both STOPPED + OVERSHT_HOLD_MS (<= OVERSHT_WAIT_MS); freeze; BM-STRACE, BM-TS, BM-TRACE-END,
' BM-OVERSHOOT; stopMotors(); a fault recovered through the pass-throughs. power prints OVERSHT_POWER,
' the value segOvershoot() set (sec 12.8).
'
' @param sid - the steering start's life
' @param distFt - commanded distance, feet
' @param tgtTicks - DERIVED target ticks
' @param skipWhy - WHY_NONE to run, else why it is skipped
' @returns whyNext - skip cause for the next trial, WHY_NONE while trials may run
'
' @local tid - trace id
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - the awaited state was reached
' @local recoverWhy - steerRecoverFault()'s result

    tid := nextTraceId()
    cpReset()
    whyNext := skipWhy
    safeEvent := SAFE_NONE
    bReached := FALSE
    ovLeftStop := 0
    ovRightStop := 0
    ovLeftRest := 0
    ovRightRest := 0
    ovLeftTrk := 0
    ovRightTrk := 0
    ovTStopMs := 0
    ovLeftIg := 0
    ovRightIg := 0
    ovWhy := WHY_NONE
    if (whyNext == WHY_NONE) and (runContinue(SEG_OVERSHT) == FALSE)
        whyNext := WHY_ABORTED
    if whyNext <> WHY_NONE
        cpWhy := whyNext
    elseif instArm(INST_SRC_STEER, OVERSHT_DECIM) == FALSE
        cpWhy := WHY_INST_NOACK
    elseif steerDrivePrecondition(SEG_OVERSHT, tid) == FALSE
        cpWhy := WHY_SYNC_PRECOND
    else
        instMark()
        beat(CP_LIB_STEER_DRIVE)
        steering.driveForDistance(distFt, distFt, steering.DDU_FT)
        beat(CP_LIB_STEER_DRIVE)
        ' both wheels still read STOPPED at the call's return, so the stop wait follows a moving wait
        safeEvent, bReached := waitWatched(SIDE_BOTH, OVERSHT_MOVE_MS, CP_LOOP_CAPTURE, UNTIL_MOVING)
        if (safeEvent == SAFE_NONE) and bReached
            safeEvent, bReached := waitWatched(SIDE_BOTH, OVERSHT_WAIT_MS, CP_LOOP_CAPTURE, UNTIL_STOPPED)
            if (safeEvent == SAFE_NONE) and bReached
                safeEvent, _ := waitWatched(SIDE_BOTH, OVERSHT_HOLD_MS, CP_LOOP_CAPTURE, UNTIL_TIME)
        if safeEvent <> SAFE_NONE
            cpEnd := safeEnd(safeEvent)
            bCpFaultSeen := (safeEvent == SAFE_FAULT)
        else
            cpEnd := bReached ? TEND_REST : TEND_TIMEOUT
    bCpFrozen := instFreeze(0)
    if bSteerUp
        ovLeftTrk, ovRightTrk := steerTrackTicks()
    emitSTrace(tid, SEG_OVERSHT, CAUSE_DISTANCE, OVERSHT_POWER, OVERSHT_POWER, TRUE, 0, MODE_FLOAT, cpWhy)
    if bCpFrozen and (cpWhy == WHY_NONE)
        traceDrain(tid, SLOT_LEFT, SLOT_RIGHT, cpEnd)
        overshootStats()
    else
        if cpWhy == WHY_NONE
            cpWhy := WHY_INST_NOACK
        traceEmptyEnd(tid, TEND_ABORT, cpWhy)
        ovWhy := cpWhy
    emitOvershoot(tid, sid, OVERSHT_POWER, distFt, tgtTicks)
    if bSteerUp
        steerStopMotors()
        recoverWhy := steerRecoverFault(tid)
        if recoverWhy <> WHY_NONE
            whyNext := recoverWhy
        if bCpFrozen
            waitWatched(SIDE_BOTH, STOP_TIMEOUT_MS, CP_LOOP_STOPPED, UNTIL_STOPPED)
    elseif whyNext == WHY_NONE
        whyNext := WHY_NO_COG
    segItems := (segItems + 1) <# LIM_SMALL

PRI overshootStats() | sampleIdx, leftStopJ, rightStopJ
' BM-OVERSHOOT's measurements from the drained steering trace, located by ring index (sec 12.7): each
' wheel's pos delta from the mark to its first DCS_SPIN_DN sample and to the last sample, and the time to
' the left wheel's first SPIN_DN as sample count x period (never a getct() difference across the capture).
'
' @local sampleIdx - logical index
' @local leftStopJ - first left SPIN_DN sample, -1 when none
' @local rightStopJ - first right SPIN_DN sample, -1 when none

    ovWhy := WHY_NOT_REACHED
    ovLeftIg := drIgSum
    ovRightIg := drOIgSum
    leftStopJ := -1
    rightStopJ := -1
    if bDrMarkFound and (drEndJ >= drMarkJ)
        repeat sampleIdx from drMarkJ to drEndJ
            beat(CP_LOOP_DRAIN)
            if (leftStopJ < 0) and (smpState(sampleIdx, SLOT_LEFT) == DCS_SPIN_DN)
                leftStopJ := sampleIdx
            if (rightStopJ < 0) and (smpState(sampleIdx, SLOT_RIGHT) == DCS_SPIN_DN)
                rightStopJ := sampleIdx
            if (leftStopJ >= 0) and (rightStopJ >= 0)
                quit
        if (leftStopJ >= 0) and (rightStopJ >= 0)
            ovLeftStop := smpPos(leftStopJ, SLOT_LEFT) - smpPos(drMarkJ, SLOT_LEFT)
            ovRightStop := smpPos(rightStopJ, SLOT_RIGHT) - smpPos(drMarkJ, SLOT_RIGHT)
            ovLeftRest := smpPos(drEndJ, SLOT_LEFT) - smpPos(drMarkJ, SLOT_LEFT)
            ovRightRest := smpPos(drEndJ, SLOT_RIGHT) - smpPos(drMarkJ, SLOT_RIGHT)
            ovTStopMs := ((leftStopJ - drMarkJ) * INST_PERIOD_US * instDecimate) / US_PER_MS
            ovWhy := WHY_NONE

CON { --- attended segments: OUTSIDE and FLOOR (design sec 4.4) and the operator panel (sec 8) --- }

PRI outsideRun() : whyCode | tid, sid, safeEvent, bReached, rowIdx
' The OUTSIDE body after START (design sec 4.4): steering start (holdAtStop(FALSE) inside steerStart());
' arm on the steering source at FLOOR_DECIM; SYNC_PRECOND then driveAtPower(50, 50); both AT_SPEED (<=
' LADDER_STEADY_MS); settle SETTLE_MS; outsideBrake(); stopMotors(); both stopped; freeze; steering.stop().
' Then BM-OPER, BM-STRACE cause BRAKEHAND, BM-TS / BM-TRACE-END (drained only when the fault mark exists)
' and the BM-OUT rows.
'
' @returns whyCode - WHY_NONE when the brake, the untouched window and both Z steps ran, else the cause
'
' @local tid - trace id
' @local sid - the steering start's life, 0 when it did not start
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - both wheels reached AT_SPEED
' @local rowIdx - BM-OUT row

    tid := nextTraceId()
    cpReset()
    sid := 0
    outCount := 0
    bOutMarked := FALSE
    if steerStart(SEG_OUTSIDE) == FALSE
        cpWhy := WHY_NO_COG
        cpEnd := TEND_ABORT
    else
        sid := steerLife
        if instArm(INST_SRC_STEER, FLOOR_DECIM) == FALSE
            cpWhy := WHY_INST_NOACK
            cpEnd := TEND_ABORT
        elseif steerDriveBoth(SEG_OUTSIDE, tid, STEER_POWER_HALF) == FALSE
            cpWhy := WHY_SYNC_PRECOND
            cpEnd := TEND_ABORT
        else
            safeEvent, bReached := waitWatched(SIDE_BOTH, LADDER_STEADY_MS, CP_LOOP_ATSPEED, UNTIL_AT_SPEED)
            if (safeEvent == SAFE_NONE) and bReached
                safeEvent, _ := waitWatched(SIDE_BOTH, SETTLE_MS, CP_LOOP_SETTLE, UNTIL_TIME)
            if safeEvent <> SAFE_NONE
                cpWhy := safeWhy(safeEvent)
                cpEnd := safeEnd(safeEvent)
            elseif bReached == FALSE
                cpWhy := WHY_STEADY_TIMEOUT
                cpEnd := TEND_TIMEOUT
            else
                outsideBrake(tid)
            if bSteerUp
                steerStopMotors()
                steerPollPhase(0, getms(), STOP_TIMEOUT_MS, TRUE, FALSE, FALSE)
    bCpFrozen := instFreeze(0)
    if (bCpFrozen == FALSE) and (cpWhy == WHY_NONE)
        cpWhy := WHY_INST_NOACK
        cpEnd := TEND_ABORT
    steerStop()
    panelEnd(PROMPT_BRAKE_L, ANS_NONE, cpWhy)
    operFlush()
    emitSTrace(tid, SEG_OUTSIDE, CAUSE_BRAKEHAND, STEER_POWER_HALF, STEER_POWER_HALF, TRUE, 0, MODE_FLOAT, cpWhy)
    if bCpFrozen and bOutMarked
        traceDrain(tid, SLOT_LEFT, SLOT_RIGHT, cpEnd)
    else
        traceEmptyEnd(tid, cpEnd, (cpWhy == WHY_NONE) ? WHY_INST_NOACK : cpWhy)
    if outCount > 0
        repeat rowIdx from 0 to outCount - 1
            beat(CP_LOOP_DRAIN)
            emitOut(tid, sid, rowIdx)
    segItems := (segItems + 1) <# LIM_SMALL
    whyCode := cpWhy

PRI outsideBrake(tid) | buttonIdx, inputCode, safeEvent, markMs
' Ask for the LEFT hand-brake and wait for the instrument to see a fault (<= BRAKE_WAIT_MS, SKIP live, the
' absolute-current abort live). Folds R14-DUAL-BRAKEFLT-H: it ran when a fault or the absolute-current
' abort ended the wait, and the fault was seen when the LEFT fault flag is set. On a fault: mark, panel
' RELEASE, then outsideZSteps(). An absolute-current abort also shows RELEASE, since the operator is still
' holding the wheel. Fills cpWhy and cpEnd.
'
' @param tid - trace id
'
' @local buttonIdx - BM_BTN_SKIP when the operator skipped, else PNL_BTN_NONE
' @local inputCode - INPUT_* of the skip
' @local safeEvent - SAFE_* that ended the wait
' @local markMs - getms() at the fault mark

    panelShow(BM_PROMPT_BRAKE_NOW, BM_STATE_BRAKE_NOW, PNL_LIVE_SKIP, PNL_BTN_NONE)
    operShown(PROMPT_BRAKE_L)
    buttonIdx, inputCode, safeEvent := operWait(PNL_LIVE_SKIP, BRAKE_WAIT_MS, SIDE_BOTH, TRUE)
    if (safeEvent == SAFE_FAULT) or (safeEvent == SAFE_ABS_ABORT)
        bSfBrakeRan := TRUE
        bSfBrakeSeen := (instLastFault[SLOT_LEFT] <> FALSE)
    if safeEvent == SAFE_FAULT
        instMark()
        markMs := getms()
        bOutMarked := TRUE
        panelShow(BM_PROMPT_BRAKE_RELEASE, BM_STATE_RELEASE, PNL_LIVE_NONE, PNL_BTN_NONE)
        operShown(PROMPT_BRAKE_L)
        cpWhy := outsideZSteps(tid, markMs)
        cpEnd := (cpWhy == WHY_NONE) ? TEND_FROZEN : TEND_ABORT
    elseif buttonIdx == BM_BTN_SKIP
        pnlPressed := BM_BTN_SKIP
        operNote(PROMPT_BRAKE_L, OPEV_SKIP, ANS_NONE, inputCode, getms() - operShownMs, WHY_OPERATOR_SKIP)
        cpWhy := WHY_OPERATOR_SKIP
        cpEnd := TEND_ABORT
    elseif safeEvent <> SAFE_NONE
        if safeEvent == SAFE_ABS_ABORT
            panelShow(BM_PROMPT_BRAKE_RELEASE, BM_STATE_RELEASE, PNL_LIVE_NONE, PNL_BTN_NONE)
            operShown(PROMPT_BRAKE_L)
        cpWhy := safeWhy(safeEvent)
        cpEnd := safeEnd(safeEvent)
    else
        operNote(PROMPT_BRAKE_L, OPEV_TIMEOUT, ANS_NONE, INPUT_NONE, getms() - operShownMs, WHY_OPERATOR_TIMEOUT)
        cpWhy := WHY_OPERATOR_TIMEOUT
        cpEnd := TEND_TIMEOUT

PRI outsideZSteps(tid, markMs) : whyCode | phaseStartMs
' After the hand-brake fault (design sec 4.4 OUTSIDE): S5_UNTOUCHED_MS untouched; Z step 1, the same
' driveAtPower(50, 50) again (a request equal to the last is not a new request, sec 12.8), Z_STEP_MS; Z
' step 2, stopMotors(), both STOPPED (<= STOP_TIMEOUT_MS), driveAtPower(50, 50), Z_STEP_MS. The public API
' is polled into outBuf every OUT_POLL_MS throughout, and every drive call is preceded by the SYNC_PRECOND
' check (steerDriveBoth()). The operator is told before the harness drives the wheels again: the RELEASE
' screen counts the untouched window down, and the HANDS CLEAR screen is drawn before the first re-command.
'
' @param tid - trace id
' @param markMs - getms() at the fault mark: the t_ms origin
' @returns whyCode - WHY_NONE when every step ran, else WHY_SYNC_PRECOND, WHY_ABORTED or WHY_INST_STALLED
'
' @local phaseStartMs - getms() at a step's command

    whyCode := safeWhy(steerPollPhase(markMs, markMs, S5_UNTOUCHED_MS, FALSE, TRUE, TRUE))
    if whyCode == WHY_NONE
        panelShow(BM_PROMPT_BRAKE_RUNNING, BM_STATE_WHEELS_AGAIN, PNL_LIVE_NONE, PNL_BTN_NONE)
        phaseStartMs := getms()
        if steerDriveBoth(SEG_OUTSIDE, tid, STEER_POWER_HALF)
            whyCode := safeWhy(steerPollPhase(markMs, phaseStartMs, Z_STEP_MS, FALSE, TRUE, FALSE))
        else
            whyCode := WHY_SYNC_PRECOND
    if whyCode == WHY_NONE
        steerStopMotors()
        whyCode := safeWhy(steerPollPhase(markMs, getms(), STOP_TIMEOUT_MS, TRUE, TRUE, FALSE))
    if whyCode == WHY_NONE
        phaseStartMs := getms()
        if steerDriveBoth(SEG_OUTSIDE, tid, STEER_POWER_HALF)
            whyCode := safeWhy(steerPollPhase(markMs, phaseStartMs, Z_STEP_MS, FALSE, TRUE, FALSE))
        else
            whyCode := WHY_SYNC_PRECOND

PRI steerPollPhase(markMs, phaseStartMs, durationMs, bUntilStopped, bPoll, bCountdown) : safeEvent | safeNow, secondsLeft
' One beat-polled steering step: every SAMPLE_MS a safety read of the instrument mirror (sec 2.8) that
' acts on the absolute-current abort and a stalled instrument, but not on a fault flag (a braked or
' faulted wheel's flag is what the step observes); when asked, one public-API row every OUT_POLL_MS since
' the mark, and the step's whole seconds left on the panel countdown. Ends durationMs after phaseStartMs,
' or once both wheels read DCS_STOPPED when asked.
'
' @param markMs - getms() at the fault mark: the t_ms origin (read only when bPoll is TRUE)
' @param phaseStartMs - getms() the step's duration is measured from
' @param durationMs - the step's bound
' @param bUntilStopped - TRUE to end early once both wheels read DCS_STOPPED
' @param bPoll - TRUE to poll the public API into outBuf
' @param bCountdown - TRUE to show the seconds left in this step on the panel
' @returns safeEvent - SAFE_ABS_ABORT or SAFE_INST_STALL when one ended the step, else SAFE_NONE
'
' @local safeNow - this pass's safety read
' @local secondsLeft - whole seconds left in this step, rounded up

    safetyReset()
    safeEvent := SAFE_NONE
    repeat
        beat(CP_LOOP_POLL)
        if bPoll and (outCount < OUT_POLLS) and ((getms() - markMs) >= (outCount * OUT_POLL_MS))
            outPoll(getms() - markMs)
        if bCountdown
            secondsLeft := (((durationMs - (getms() - phaseStartMs)) + (MS_PER_SEC - 1)) / MS_PER_SEC) #> 0
            if secondsLeft <> pnlSeconds
                pnlSeconds := secondsLeft
                panelRender()
        waitms(SAMPLE_MS)
        safeNow := safetyPoll(SIDE_BOTH)
        if (safeNow == SAFE_ABS_ABORT) or (safeNow == SAFE_INST_STALL)
            safeEvent := safeNow
            quit
        if bUntilStopped and mirrorAllInState(SIDE_BOTH, DCS_STOPPED)
            quit
        if (getms() - phaseStartMs) >= durationMs
            quit

PRI outPoll(tMs) | rowBase
' One BM-OUT row: the public API as a user sees it -- getStatus(), testGetDriverState(),
' testGetFaultStatus() (no side effect), isTurning(), getPower() -- stored in outBuf and emitted after
' the window (design sec 3.6).
'
' @param tMs - ms since the fault mark
'
' @local rowBase - first long of the row

    rowBase := outCount * OUT_LONGS
    outBuf[rowBase + OUT_T_MS] := tMs
    beat(CP_LIB_STEER_QUERY)
    outBuf[rowBase + OUT_L_STAT], outBuf[rowBase + OUT_R_STAT] := steering.getStatus()
    outBuf[rowBase + OUT_L_ST], outBuf[rowBase + OUT_R_ST] := steering.testGetDriverState()
    outBuf[rowBase + OUT_L_FLT], outBuf[rowBase + OUT_L_SIG], outBuf[rowBase + OUT_R_FLT], outBuf[rowBase + OUT_R_SIG] := steering.testGetFaultStatus()
    outBuf[rowBase + OUT_TURNING] := steering.isTurning()
    outBuf[rowBase + OUT_L_PWR], outBuf[rowBase + OUT_R_PWR] := steering.getPower()
    beat(CP_LIB_STEER_QUERY)
    outCount += 1

PRI floorRun() : whyCode | tid, sid, buttonIdx, inputCode, safeEvent, driveStartMs, startTotal, endTotal
' The FLOOR body after START (design sec 4.4): steering start (holdAtStop(FALSE) inside steerStart()); arm
' at FLOOR_DECIM; SYNC_PRECOND; mark (the trace mark and the rate window's first ring total, sec 12.7);
' driveDirection(FLOOR_POWER, FLOOR_DIRECTION); OBSERVING with STOP live for FLOOR_RUN_MS (brief
' wheels-down observation) and the absolute-current abort live; stopMotors(); both stopped; freeze; the
' rates from the frozen ring; the which-way question (floorAsk()); steering.stop(). Then BM-OPER,
' BM-STRACE cause FLOOR, BM-TS / BM-TRACE-END and BM-FLOOR.
'
' @returns whyCode - WHY_NONE when the run and the answer completed, else the first cause
'
' @local tid - trace id
' @local sid - the steering start's life, 0 when it did not start
' @local buttonIdx - BM_BTN_STOP when the operator stopped the run, else PNL_BTN_NONE
' @local inputCode - INPUT_* of the STOP
' @local safeEvent - SAFE_* that ended the run early
' @local driveStartMs - getms() at the drive call
' @local startTotal - ring total at the mark, -1 when not recorded
' @local endTotal - samples stored before the stop command, -1 when the run did not happen

    tid := nextTraceId()
    cpReset()
    sid := 0
    flRunMs := 0
    flAnswer := ANS_NONE
    flInput := INPUT_NONE
    flStopBy := STOPBY_ABORT
    flLeftPwr := 0
    flRightPwr := 0
    bFlDrove := FALSE
    startTotal := -1
    endTotal := -1
    if steerStart(SEG_FLOOR) == FALSE
        cpWhy := WHY_NO_COG
        cpEnd := TEND_ABORT
    else
        sid := steerLife
        if instArm(INST_SRC_STEER, FLOOR_DECIM) == FALSE
            cpWhy := WHY_INST_NOACK
            cpEnd := TEND_ABORT
        elseif steerDrivePrecondition(SEG_FLOOR, tid) == FALSE
            cpWhy := WHY_SYNC_PRECOND
            cpEnd := TEND_ABORT
        else
            startTotal := instMarkIndex()
            driveStartMs := getms()
            curIncre := 0
            beat(CP_LIB_STEER_DRIVE)
            steering.driveDirection(FLOOR_POWER, FLOOR_DIRECTION)
            beat(CP_LIB_STEER_DRIVE)
            bFlDrove := TRUE
            beat(CP_LIB_STEER_QUERY)
            flLeftPwr, flRightPwr := steering.getPower()
            beat(CP_LIB_STEER_QUERY)
            panelShow(BM_PROMPT_FLOOR_START, BM_STATE_OBSERVING, PNL_LIVE_STOP, PNL_BTN_NONE)
            buttonIdx, inputCode, safeEvent := operWait(PNL_LIVE_STOP, FLOOR_RUN_MS, SIDE_BOTH, TRUE)
            endTotal := instTotal                           ' an index, never a time (sec 12.7): the instrument's own count
            flRunMs := getms() - driveStartMs
            if bSteerUp
                steerStopMotors()
            cpEnd := TEND_FROZEN
            if buttonIdx == BM_BTN_STOP
                flStopBy := STOPBY_OPERATOR
                pnlPressed := BM_BTN_STOP
                operNote(PROMPT_FLOOR, OPEV_STOP, ANS_NONE, inputCode, flRunMs, WHY_NONE)
            elseif safeEvent <> SAFE_NONE
                cpWhy := safeWhy(safeEvent)
                cpEnd := safeEnd(safeEvent)
            else
                flStopBy := STOPBY_TIMER
            if bSteerUp
                steerPollPhase(0, getms(), STOP_TIMEOUT_MS, TRUE, FALSE, FALSE)
    bCpFrozen := instFreeze(0)
    if (bCpFrozen == FALSE) and (cpWhy == WHY_NONE)
        cpWhy := WHY_INST_NOACK
        cpEnd := TEND_ABORT
    floorRates(startTotal, endTotal)
    if bFlDrove
        floorAsk()
    steerStop()
    whyCode := cpWhy
    if (whyCode == WHY_NONE) and (flAnswer == ANS_NONE)
        whyCode := WHY_OPERATOR_TIMEOUT
    panelEnd(PROMPT_FLOOR, flAnswer, whyCode)
    operFlush()
    emitSTrace(tid, SEG_FLOOR, CAUSE_FLOOR, flLeftPwr, flRightPwr, bFlDrove, FLOOR_DIRECTION, MODE_FLOAT, cpWhy)
    if bCpFrozen and bFlDrove
        traceDrain(tid, SLOT_LEFT, SLOT_RIGHT, cpEnd)
    else
        traceEmptyEnd(tid, cpEnd, (cpWhy == WHY_NONE) ? WHY_INST_NOACK : cpWhy)
    emitFloor(tid, sid, flRunMs, flAnswer, flInput, flLeftRateX10, flRightRateX10, bFlRates, flSlower, flStopBy, floorWhy())
    segItems := (segItems + 1) <# LIM_SMALL

PRI floorAsk() | buttonIdx, inputCode
' Ask which way the platform turned (design sec 8.3): the four answer buttons live (keys L R T N), <=
' OPER_ANSWER_TIMEOUT_MS, the absolute-current abort still live. Folds R14-DUAL-FLOORANS-F: an answer was
' recorded. Fills flAnswer and flInput.
'
' @local buttonIdx - BM_BTN_* answered, PNL_BTN_NONE on timeout
' @local inputCode - INPUT_* of the answer

    operFlush()                                             ' the instrument no longer stores: the run's notes go out now
    panelShow(BM_PROMPT_FLOOR_ASK, BM_STATE_ASK, PNL_LIVE_ANSWERS, PNL_BTN_NONE)
    operShown(PROMPT_FLOOR)
    buttonIdx, inputCode, _ := operWait(PNL_LIVE_ANSWERS, OPER_ANSWER_TIMEOUT_MS, SIDE_BOTH, FALSE)
    if buttonIdx <> PNL_BTN_NONE
        flAnswer := buttonAnswer(buttonIdx)
        flInput := inputCode
        pnlPressed := buttonIdx
        bSfFloorRan := TRUE
        bSfFloorAnswered := TRUE
        operNote(PROMPT_FLOOR, OPEV_ANSWER, flAnswer, inputCode, getms() - operShownMs, WHY_NONE)
    else
        operNote(PROMPT_FLOOR, OPEV_TIMEOUT, ANS_NONE, INPUT_NONE, getms() - operShownMs, WHY_OPERATOR_TIMEOUT)

PRI floorRates(startTotal, endTotal) | startJ, endJ, spanMs
' BM-FLOOR's rates from the frozen ring, over the samples stored from the mark up to the stop command,
' located by ring index (sec 12.7). The span is samples x period x decimation, never a getct() difference.
' Both ends must have both drivers up (I3). slower is the wheel with the smaller |rate|. Legal only
' while the instrument is FROZEN (I10). Fills flLeftRateX10, flRightRateX10, bFlRates and flSlower.
'
' @param startTotal - ring total at the mark, -1 when not recorded
' @param endTotal - samples stored before the stop command, -1 when the run did not happen
'
' @local startJ - logical index of the first window sample
' @local endJ - logical index of the last window sample
' @local spanMs - the window's span, ms

    bFlRates := FALSE
    flLeftRateX10 := 0
    flRightRateX10 := 0
    flSlower := SLOWER_EQUAL
    if bCpFrozen and (startTotal >= 0) and (endTotal > startTotal)
        drainBegin()
        startJ := startTotal - drLostHead
        endJ := (endTotal - 1 - drLostHead) <# (drStored - 1)
        if (startJ >= 0) and (endJ > startJ)
            if smpUp(startJ, SLOT_LEFT) and smpUp(endJ, SLOT_LEFT) and smpUp(startJ, SLOT_RIGHT) and smpUp(endJ, SLOT_RIGHT)
                spanMs := ((endJ - startJ) * INST_PERIOD_US * instDecimate) / US_PER_MS
                if spanMs > 0
                    flLeftRateX10 := ((smpPos(endJ, SLOT_LEFT) - smpPos(startJ, SLOT_LEFT)) * RATE_X10_SCALE) / spanMs
                    flRightRateX10 := ((smpPos(endJ, SLOT_RIGHT) - smpPos(startJ, SLOT_RIGHT)) * RATE_X10_SCALE) / spanMs
                    bFlRates := TRUE
                    if abs(flLeftRateX10) < abs(flRightRateX10)
                        flSlower := SLOWER_LEFT
                    elseif abs(flRightRateX10) < abs(flLeftRateX10)
                        flSlower := SLOWER_RIGHT

PRI floorWhy() : whyCode
' BM-FLOOR's why: the cause of NA rates first, then an unanswered question (answer NONE).
'
' @returns whyCode - WHY_* value

    if bFlRates == FALSE
        whyCode := (cpWhy <> WHY_NONE) ? cpWhy : WHY_NO_SAMPLES
    elseif flAnswer == ANS_NONE
        whyCode := WHY_OPERATOR_TIMEOUT
    else
        whyCode := WHY_NONE

PRI buttonAnswer(buttonIdx) : answerCode
' The BM-FLOOR / BM-OPER answer of an answer button.
'
' @param buttonIdx - BM_BTN_* value
' @returns answerCode - ANS_LEFT, ANS_RIGHT, ANS_STRAIGHT, ANS_NOMOVE, or ANS_NONE for any other button

    case buttonIdx
        BM_BTN_LEFT:
            answerCode := ANS_LEFT
        BM_BTN_RIGHT:
            answerCode := ANS_RIGHT
        BM_BTN_STRAIGHT:
            answerCode := ANS_STRAIGHT
        BM_BTN_NOMOVE:
            answerCode := ANS_NOMOVE
        other:
            answerCode := ANS_NONE

PRI operStartPrompt(promptCode, promptIdx) : whyCode | buttonIdx, inputCode
' Draw an attended segment's first prompt with START live and wait for START (<= OPER_START_TIMEOUT_MS)
' before anything moves (sec 8.3: no motion before START). No motor runs, so no safety read is owed.
'
' @param promptCode - PROMPT_* value
' @param promptIdx - BM_PROMPT_* cell to draw
' @returns whyCode - WHY_NONE on START, WHY_OPERATOR_TIMEOUT otherwise
'
' @local buttonIdx - BM_BTN_START, or PNL_BTN_NONE on timeout
' @local inputCode - INPUT_* of the START

    panelShow(promptIdx, BM_STATE_WAITING, PNL_LIVE_START, PNL_BTN_NONE)
    operShown(promptCode)
    buttonIdx, inputCode, _ := operWait(PNL_LIVE_START, OPER_START_TIMEOUT_MS, SIDE_NONE, FALSE)
    if buttonIdx == BM_BTN_START
        panelShow(promptIdx, BM_STATE_STARTING, PNL_LIVE_NONE, BM_BTN_START)
        operNote(promptCode, OPEV_START, ANS_NONE, inputCode, getms() - operShownMs, WHY_NONE)
        whyCode := WHY_NONE
    else
        panelShow(promptIdx, BM_STATE_TIMED_OUT, PNL_LIVE_NONE, PNL_BTN_NONE)
        operNote(promptCode, OPEV_TIMEOUT, ANS_NONE, INPUT_NONE, getms() - operShownMs, WHY_OPERATOR_TIMEOUT)
        whyCode := WHY_OPERATOR_TIMEOUT
    operFlush()

PRI operWait(liveMask, timeoutMs, watchSide, bEndOnSafety) : buttonIdx, inputCode, safeEvent | startMs, lastInputMs, elapsedMs, secondsLeft, safeNow
' The operator wait every attended step shares: a beat-polled loop that polls the panel input every
' OPER_POLL_MS (under PC_KEY's ~100 ms latch), redraws only when the countdown second changes (the dirty
' rule, DISPLAY-PATTERNS-builders-guide.md sec 7), and ends on a live button, the timeout or, when asked,
' a safety event. With a watched side the loop runs every SAMPLE_MS and reads only the instrument mirror
' (sec 2.8), so the absolute-current abort stays live whether or not the wait ends on it.
'
' @param liveMask - PNL_LIVE_* mask of the buttons that may be chosen
' @param timeoutMs - the wait's bound
' @param watchSide - SIDE_BOTH to read the safety mirror, SIDE_NONE when no motor can run
' @param bEndOnSafety - TRUE to end the wait on any safety event, a fault flag included
' @returns buttonIdx - BM_BTN_* chosen, PNL_BTN_NONE when none
' @returns inputCode - INPUT_KEY, INPUT_MOUSE or INPUT_NONE
' @returns safeEvent - SAFE_* that ended the wait, SAFE_NONE otherwise
'
' @local startMs - getms() when the wait began
' @local lastInputMs - getms() of the last input poll
' @local elapsedMs - ms since the wait began
' @local secondsLeft - whole seconds left, rounded up
' @local safeNow - this pass's safety read

    buttonIdx := PNL_BTN_NONE
    inputCode := INPUT_NONE
    safeEvent := SAFE_NONE
    bPanelKeyArmed := FALSE                                 ' a key or click still latched from the last step is never taken
    bPanelMouseArmed := FALSE
    if watchSide <> SIDE_NONE
        safetyReset()
    startMs := getms()
    lastInputMs := startMs - OPER_POLL_MS
    repeat
        beat(CP_LOOP_OPER)
        elapsedMs := getms() - startMs
        secondsLeft := (((timeoutMs - elapsedMs) + (MS_PER_SEC - 1)) / MS_PER_SEC) #> 0
        if secondsLeft <> pnlSeconds
            pnlSeconds := secondsLeft
            panelRender()
        if watchSide <> SIDE_NONE
            safeNow := safetyPoll(watchSide)
            if bEndOnSafety and (safeNow <> SAFE_NONE)
                safeEvent := safeNow
                quit
        if (getms() - lastInputMs) >= OPER_POLL_MS
            lastInputMs := getms()
            buttonIdx, inputCode := panelReadInput(liveMask)
            if buttonIdx <> PNL_BTN_NONE
                quit
        if elapsedMs >= timeoutMs
            quit
        if watchSide <> SIDE_NONE
            waitms(SAMPLE_MS)
        else
            waitms(OPER_POLL_MS)

PRI operShown(promptCode)
' Start timing a prompt the operator now sees, and note BM-OPER SHOWN.
'
' @param promptCode - PROMPT_* value

    operShownMs := getms()
    operNote(promptCode, OPEV_SHOWN, ANS_NONE, INPUT_NONE, 0, WHY_NONE)

PRI operNote(promptCode, eventCode, answerCode, inputCode, waitedMs, whyCode) | rowBase
' Note one BM-OPER event. operFlush() emits the notes where the instrument is not storing, so no record is
' emitted inside a capture (design sec 2.6); a full queue is flushed first, so no note is ever dropped.
'
' @param promptCode - PROMPT_* value
' @param eventCode - OPEV_* value
' @param answerCode - ANS_* value
' @param inputCode - INPUT_* value
' @param waitedMs - ms since the prompt was shown
' @param whyCode - WHY_* value
'
' @local rowBase - first long of the queue row

    if operQueueCount >= OPER_QUEUE_MAX
        operFlush()
    rowBase := operQueueCount * OQ_LONGS
    operQueue[rowBase + OQ_PROMPT] := promptCode
    operQueue[rowBase + OQ_EVENT] := eventCode
    operQueue[rowBase + OQ_ANSWER] := answerCode
    operQueue[rowBase + OQ_INPUT] := inputCode
    operQueue[rowBase + OQ_WAIT] := waitedMs
    operQueue[rowBase + OQ_WHY] := whyCode
    operQueueCount += 1

PRI operFlush() | rowIdx, rowBase
' Emit every noted BM-OPER record in the order noted, then empty the queue.
'
' @local rowIdx - queue row
' @local rowBase - first long of the row

    if operQueueCount > 0
        repeat rowIdx from 0 to operQueueCount - 1
            beat(CP_LOOP_OPER)
            rowBase := rowIdx * OQ_LONGS
            emitOper(operQueue[rowBase + OQ_PROMPT], operQueue[rowBase + OQ_EVENT], operQueue[rowBase + OQ_ANSWER], operQueue[rowBase + OQ_INPUT], operQueue[rowBase + OQ_WAIT], operQueue[rowBase + OQ_WHY])
    operQueueCount := 0

PRI panelEnd(promptCode, answerCode, whyCode) | stateIdx
' Draw an attended sequence's closing state and note BM-OPER DONE: DONE when it ran through, TIMED OUT
' after an operator timeout, SKIPPED for a skip or any harness-side cause (named by why).
'
' @param promptCode - PROMPT_* value
' @param answerCode - ANS_* value
' @param whyCode - WHY_* naming why the sequence ended short, WHY_NONE when it ran through
'
' @local stateIdx - BM_STATE_* drawn

    if whyCode == WHY_NONE
        stateIdx := BM_STATE_DONE
    elseif whyCode == WHY_OPERATOR_TIMEOUT
        stateIdx := BM_STATE_TIMED_OUT
    else
        stateIdx := BM_STATE_SKIPPED
    panelShow(pnlPrompt, stateIdx, PNL_LIVE_NONE, pnlPressed)
    operNote(promptCode, OPEV_DONE, answerCode, INPUT_NONE, getms() - operShownMs, whyCode)

PRI panelSetup()
' Create the bmpanel window and load its five layers, in src/test_bench_t0.spin2 t0hSetupPanel()'s form
' (crop-and-overlay, DISPLAY-PATTERNS-builders-guide.md sec 2 and 6): PLOT with HIDEXY UPDATE, one LAYER
' per BMP, CROP 1, UPDATE. SIZE 480 260 and POS 60 80 are BM_PANEL_W / BM_PANEL_H / BM_PANEL_POS_X /
' BM_PANEL_POS_Y, and the layer numbers are BM_LYR_*, written as text as t0hSetupPanel() writes its own.
' Display text arguments use single quotes. A panel that fails to draw costs a START timeout, never motion.

    pnlPrompt := BM_PROMPT_BRAKE_START
    pnlState := BM_STATE_WAITING
    pnlLive := PNL_LIVE_NONE
    pnlPressed := PNL_BTN_NONE
    pnlSeconds := PNL_NO_COUNTDOWN
    bPanelKeyArmed := FALSE
    bPanelMouseArmed := FALSE
    beat(CP_PANEL)
    debug(`PLOT bmpanel TITLE 'Motion harness operator panel' SIZE 480 260 POS 60 80 HIDEXY UPDATE)
    debug(`bmpanel LAYER 1 'bm_bg.bmp')
    debug(`bmpanel LAYER 2 'bm_prompt.bmp')
    debug(`bmpanel LAYER 3 'bm_state.bmp')
    debug(`bmpanel LAYER 4 'bm_buttons.bmp')
    debug(`bmpanel LAYER 5 'bm_digits.bmp')
    debug(`bmpanel crop 1)
    debug(`bmpanel update)
    beat(CP_PANEL)

PRI panelShow(promptIdx, stateIdx, liveMask, pressedIdx)
' Set the panel's prompt, state, live buttons and highlighted button, blank the countdown, and draw.
'
' @param promptIdx - BM_PROMPT_* cell
' @param stateIdx - BM_STATE_* cell
' @param liveMask - PNL_LIVE_* mask of the buttons that may be chosen
' @param pressedIdx - BM_BTN_* drawn highlighted, PNL_BTN_NONE when none

    pnlPrompt := promptIdx
    pnlState := stateIdx
    pnlLive := liveMask
    pnlPressed := pressedIdx
    pnlSeconds := PNL_NO_COUNTDOWN
    panelRender()

PRI panelRender() | btnIdx, slotX, slotY, cellCol, divisor, colIdx, digitCell
' Compose one frame from the pnl* state -- the prompt cell, the state cell, every button slot (normal when
' live, highlighted when pressed, otherwise restored from the background), the countdown digits (blank
' when there is none, leading zeros blank) -- then one UPDATE (DISPLAY-PATTERNS-builders-guide.md sec 2).
' In src/test_bench_t0.spin2 t0hDrawPanel()'s form.
'
' @local btnIdx - BM_BTN_* slot
' @local slotX - the slot's left edge
' @local slotY - the slot's top edge
' @local cellCol - BM_BTN_NORMAL or BM_BTN_HILITE
' @local divisor - place value of the countdown column being drawn
' @local colIdx - countdown column, most significant first
' @local digitCell - bm_digits.bmp cell: 0..9, or BM_DGT_BLANK

    beat(CP_PANEL)
    debug(`bmpanel crop 2 `(0, pnlPrompt * BM_PROMPT_H, BM_PROMPT_W, BM_PROMPT_H, BM_PROMPT_X, BM_PROMPT_Y))
    debug(`bmpanel crop 3 `(0, pnlState * BM_STATE_H, BM_STATE_W, BM_STATE_H, BM_STATE_X, BM_STATE_Y))
    repeat btnIdx from 0 to BM_BTN_COUNT - 1
        slotX, slotY := buttonSlot(btnIdx)
        if (btnIdx == pnlPressed) or ((pnlLive & (DECOD btnIdx)) <> 0)
            cellCol := (btnIdx == pnlPressed) ? BM_BTN_HILITE : BM_BTN_NORMAL
            debug(`bmpanel crop 4 `(cellCol * BM_BTN_W, btnIdx * BM_BTN_H, BM_BTN_W, BM_BTN_H, slotX, slotY))
        else
            debug(`bmpanel crop 1 `(slotX, slotY, BM_BTN_W, BM_BTN_H))
    divisor := BM_CD_TOP_DIV
    repeat colIdx from 0 to BM_CD_COUNT - 1
        digitCell := BM_DGT_BLANK
        if pnlSeconds >= 0
            if (divisor == 1) or (pnlSeconds >= divisor)
                digitCell := (pnlSeconds / divisor) // PNL_DEC_RADIX
        debug(`bmpanel crop 5 `(digitCell * BM_DGT_W, 0, BM_DGT_W, BM_DGT_H, BM_CD_X + (colIdx * BM_DGT_W), BM_CD_Y))
        divisor /= PNL_DEC_RADIX
    debug(`bmpanel update)
    beat(CP_PANEL)

PRI buttonSlot(btnIdx) : slotX, slotY
' Top-left of a button's slot: buttons 0..BM_BTN_ROW2_FIRST-1 on row 1, the rest on row 2, at a fixed
' pitch (tools/gen_dual_assets.py slot() draws the frames at the same place).
'
' @param btnIdx - BM_BTN_* value
' @returns slotX - the slot's left edge
' @returns slotY - the slot's top edge

    if btnIdx >= BM_BTN_ROW2_FIRST
        slotX := BM_BTN_COL0_X + ((btnIdx - BM_BTN_ROW2_FIRST) * BM_BTN_PITCH)
        slotY := BM_BTN_ROW2_Y
    else
        slotX := BM_BTN_COL0_X + (btnIdx * BM_BTN_PITCH)
        slotY := BM_BTN_ROW1_Y

PRI panelReadInput(liveMask) : buttonIdx, inputCode
' Poll the keyboard, then the mouse, once each (design sec 8.2). PC_KEY and PC_MOUSE each carry their own
' backtick and end their debug() statement (p2kbSpin2DbgPcKey, p2kbSpin2DbgPcMouse). A key or a click is
' taken only after a released reading (src/test_bench_t0.spin2 testT0_12()'s arming), and only for a live
' button: keys S START, K SKIP, space STOP, L R T N the answers; a click by the button's bounding box.
'
' @param liveMask - PNL_LIVE_* mask of the buttons that may be chosen
' @returns buttonIdx - BM_BTN_* chosen, PNL_BTN_NONE when none
' @returns inputCode - INPUT_KEY, INPUT_MOUSE or INPUT_NONE

    buttonIdx := PNL_BTN_NONE
    inputCode := INPUT_NONE
    beat(CP_PANEL)
    debug(`bmpanel `pc_key(@panelKey))
    beat(CP_PANEL)
    if panelKey == 0
        bPanelKeyArmed := TRUE
    elseif bPanelKeyArmed
        bPanelKeyArmed := FALSE
        buttonIdx := keyButton(panelKey, liveMask)
        if buttonIdx <> PNL_BTN_NONE
            inputCode := INPUT_KEY
    if buttonIdx == PNL_BTN_NONE
        beat(CP_PANEL)
        debug(`bmpanel `pc_mouse(@panelMouse))
        beat(CP_PANEL)
        if panelMouse[MOUSE_LBTN] == 0
            bPanelMouseArmed := TRUE
        elseif bPanelMouseArmed
            bPanelMouseArmed := FALSE
            buttonIdx := mouseButton(panelMouse[MOUSE_XPOS], panelMouse[MOUSE_YPOS], liveMask)
            if buttonIdx <> PNL_BTN_NONE
                inputCode := INPUT_MOUSE

PRI keyButton(keyValue, liveMask) : buttonIdx
' The live button a key names (either letter case): S START, K SKIP, space STOP, L LEFT, R RIGHT,
' T STRAIGHT, N DID NOT MOVE.
'
' @param keyValue - PC_KEY's reading
' @param liveMask - PNL_LIVE_* mask of the buttons that may be chosen
' @returns buttonIdx - BM_BTN_* named and live, PNL_BTN_NONE otherwise

    case keyValue
        "S", "s":
            buttonIdx := BM_BTN_START
        "K", "k":
            buttonIdx := BM_BTN_SKIP
        " ":
            buttonIdx := BM_BTN_STOP
        "L", "l":
            buttonIdx := BM_BTN_LEFT
        "R", "r":
            buttonIdx := BM_BTN_RIGHT
        "T", "t":
            buttonIdx := BM_BTN_STRAIGHT
        "N", "n":
            buttonIdx := BM_BTN_NOMOVE
        other:
            buttonIdx := PNL_BTN_NONE
    if buttonIdx <> PNL_BTN_NONE
        if (liveMask & (DECOD buttonIdx)) == 0
            buttonIdx := PNL_BTN_NONE

PRI mouseButton(xPos, yPos, liveMask) : buttonIdx | btnIdx, slotX, slotY
' The live button whose slot holds the pointer; a pointer outside the window reads negative and hits none.
'
' @param xPos - PC_MOUSE x, window pixels
' @param yPos - PC_MOUSE y, window pixels
' @param liveMask - PNL_LIVE_* mask of the buttons that may be chosen
' @returns buttonIdx - BM_BTN_* under the pointer and live, PNL_BTN_NONE otherwise
'
' @local btnIdx - BM_BTN_* slot tested
' @local slotX - the slot's left edge
' @local slotY - the slot's top edge

    buttonIdx := PNL_BTN_NONE
    repeat btnIdx from 0 to BM_BTN_COUNT - 1
        slotX, slotY := buttonSlot(btnIdx)
        if ((liveMask & (DECOD btnIdx)) <> 0) and (xPos >= slotX) and (xPos < slotX + BM_BTN_W) and (yPos >= slotY) and (yPos < slotY + BM_BTN_H)
            buttonIdx := btnIdx
            quit

CON { --- instrument cog: runs in its own cog; no debug() anywhere below it (I1) --- }

PRI instrument() | dueCt, slackTicks, seenSeq
' The instrument cog (design sec 2). Paces itself on an absolute getct() schedule and never calls
' waitct() without positive slack; services cog 0's commands once per pass; reads both motors and the
' hall pins whenever it is not IDLE; stores one sample in instDecimate while RUN or FREEZE. Holds no
' lock, emits nothing, commands no motor. After EXIT it parks until cog 0 stops it (I4).
'
' @local dueCt - getct() the next sample is due at
' @local slackTicks - dueCt - getct(), signed (a GETCT difference is wrap-safe)
' @local seenSeq - instCmdSeq read once this pass

    isDecimCount := 0
    isFreezeLeft := 0
    isFreezeSeq := 0
    instState := INST_ST_IDLE
    dueCt := getct() + INST_PERIOD_TICKS
    repeat
        instHeartbeat += 1
        if instState == INST_ST_EXITED
            waitms(INST_EXIT_POLL_MS)
        else
            seenSeq := instCmdSeq
            if (seenSeq <> instAckSeq) and ((instState <> INST_ST_FREEZE) or (seenSeq <> isFreezeSeq))
                instExecute(seenSeq)
            if instState <> INST_ST_EXITED
                slackTicks := dueCt - getct()
                if slackTicks > INST_MIN_SLACK_US * TICKS_PER_US
                    waitct(dueCt)
                    dueCt += INST_PERIOD_TICKS
                elseif slackTicks > 0
                    dueCt += INST_PERIOD_TICKS              ' on time, too close to the target to wait on
                else
                    instCountLate(0 - slackTicks)
                    if (0 - slackTicks) >= INST_PERIOD_TICKS
                        dueCt := getct() + INST_PERIOD_TICKS  ' re-base; the skipped periods were counted
                    else
                        dueCt += INST_PERIOD_TICKS
                if instState <> INST_ST_IDLE
                    instSample()

PRI instExecute(seenSeq) | motorIdx
' Execute one cog-0 command, write the resulting state, then the ack (instrument cog). A FREEZE with
' post-samples is acked later, by instSample(), when they are stored. A command not legal from the
' current state is acked with the state unchanged; cog 0 checks the state it asked for.
'
' @param seenSeq - the instCmdSeq this command was read under
'
' @local motorIdx - motor slot

    case instCmd
        INST_CMD_ARM:
            if (instState == INST_ST_IDLE) or (instState == INST_ST_FROZEN)
                instW := 0
                instTotal := 0
                instMarkTotal := -1                         ' no mark belongs to this capture until cog 0 marks
                instMarkAckSeq := instMarkSeq
                instLate := 0
                instSkipped := 0
                instMaxLateTicks := 0
                instClamps := 0
                instIntegSat := 0
                repeat motorIdx from SLOT_LEFT to SLOT_RIGHT
                    instHwSkip[motorIdx] := 0
                    isHwPos[motorIdx] := 0
                    isHallCode[motorIdx] := pinread(instMotorBase(motorIdx) + HALL_PIN_OFFSET addpins HALL_PIN_SPAN)
                    isIgPrev[motorIdx] := -1                ' seeded by the first stored sample
                isDecimCount := 0
                instState := INST_ST_RUN
        INST_CMD_FREEZE:
            if instState == INST_ST_RUN
                isFreezeLeft := instArg0
                isFreezeSeq := seenSeq
                instState := (isFreezeLeft > 0) ? INST_ST_FREEZE : INST_ST_FROZEN
        INST_CMD_IDLE:
            if instState <> INST_ST_EXITED
                instState := INST_ST_IDLE
        INST_CMD_EXIT:
            instState := INST_ST_EXITED
    if instState <> INST_ST_FREEZE
        instAckSeq := seenSeq

PRI instCountLate(lateTicks)
' Count one sample that started after its due time (instrument cog): late only past INST_LATE_TICKS,
' the largest lateness, and whole periods with no sample. Every counter saturates at LIM_BIG (I2).
'
' @param lateTicks - how far past its due time the sample starts, in ticks (> 0)

    if instState <> INST_ST_IDLE
        if lateTicks > INST_LATE_TICKS
            instLate := (instLate + 1) <# LIM_BIG
            instRunLate := (instRunLate + 1) <# LIM_BIG
        instMaxLateTicks #>= lateTicks
        instRunMaxLateTicks #>= lateTicks
        if lateTicks >= INST_PERIOD_TICKS
            instSkipped := (instSkipped + (lateTicks / INST_PERIOD_TICKS)) <# LIM_BIG
            instRunSkipped := (instRunSkipped + (lateTicks / INST_PERIOD_TICKS)) <# LIM_BIG

PRI instSample() | motorIdx, sampleCt, seenMarkSeq
' Record a new mark's ring total, read the hall pins and the source once, refresh the last-sample
' mirror, and store a decimated sample while RUN or FREEZE (instrument cog). The mark check comes first,
' before this pass reads or stores anything, so instMarkTotal is the total index of the first stored
' sample taken at or after the mark (sec 12.7: the mark is located by ring index, never by time).
'
' @local motorIdx - motor slot
' @local sampleCt - getct() at the start of the sample, stored as t
' @local seenMarkSeq - instMarkSeq read once this pass

    seenMarkSeq := instMarkSeq
    if seenMarkSeq <> instMarkAckSeq
        instMarkTotal := instTotal                          ' total first, then the ack cog 0 waits on
        instMarkAckSeq := seenMarkSeq
    sampleCt := getct()
    repeat motorIdx from SLOT_LEFT to SLOT_RIGHT
        instReadHall(motorIdx)
    instReadSource()
    repeat motorIdx from SLOT_LEFT to SLOT_RIGHT
        instLastUp[motorIdx] := isUp[motorIdx]
        instLastI[motorIdx] := isUp[motorIdx] ? isSenseI[motorIdx] : 0
        instLastState[motorIdx] := isUp[motorIdx] ? isState[motorIdx] : DCS_UNKNOWN
        instLastFault[motorIdx] := isUp[motorIdx] ? isFault[motorIdx] : FALSE
        instLastPos[motorIdx] := isPos[motorIdx]
        instLastHw[motorIdx] := isHwPos[motorIdx]
    if (instState == INST_ST_RUN) or (instState == INST_ST_FREEZE)
        if isDecimCount == 0
            instStore(sampleCt)
            if instState == INST_ST_FREEZE
                isFreezeLeft -= 1
                if isFreezeLeft <= 0
                    instState := INST_ST_FROZEN
                    instAckSeq := isFreezeSeq
        isDecimCount += 1
        if isDecimCount >= instDecimate
            isDecimCount := 0

PRI instReadHall(motorIdx) | hallCode, hallDelta
' Decode one motor's hall inputs into hwPos with the local deltas65 copy (instrument cog). PINREAD reads
' the IN register and changes no pin configuration, so a running driver is not disturbed (Q4). A code
' change with a zero delta that touches no illegal code is a transition the poll could not resolve:
' counted in instHwSkip, never silent.
'
' @param motorIdx - motor slot
'
' @local hallCode - the 3-bit hall code just read
' @local hallDelta - signed tick delta from hallDeltas65

    hallCode := pinread(instMotorBase(motorIdx) + HALL_PIN_OFFSET addpins HALL_PIN_SPAN)
    if hallCode <> isHallCode[motorIdx]
        hallDelta := hallDeltas65[(isHallCode[motorIdx] << HALL_CODE_BITS) | hallCode] SIGNX FIELD_ERR_SIGNBIT
        if (hallDelta == 0) and (hallCodeLegal(hallCode) == TRUE) and (hallCodeLegal(isHallCode[motorIdx]) == TRUE)
            instHwSkip[motorIdx] := (instHwSkip[motorIdx] + 1) <# LIM_BIG
        isHwPos[motorIdx] += hallDelta
        isHallCode[motorIdx] := hallCode

PRI hallCodeLegal(hallCode) : bLegal
' Report whether a 3-bit hall code is one a working sensor set can produce.
'
' @param hallCode - 3-bit hall code
' @returns bLegal - FALSE for %000 and %111

    bLegal := (hallCode <> HALL_CODE_ILLEGAL_LO) and (hallCode <> HALL_CODE_ILLEGAL_HI)

PRI instReadSource()
' Read the status block of the source latched at ARM, per motor, gated on the driver running (I3):
' WHEELS by testGetMotorCog() <> 0, STEER by the driver state <> DCS_Unknown (stop() writes it after
' its cogstop). Every call here is debug-free (I1, design sec 1 citations). Instrument cog.

    case instSrc
        INST_SRC_WHEELS:
            isUp[SLOT_LEFT] := (wheelL.testGetMotorCog() <> 0)
            if isUp[SLOT_LEFT]
                isDuty[SLOT_LEFT], isErr[SLOT_LEFT], isSenseI[SLOT_LEFT], isSenseU[SLOT_LEFT], isSenseV[SLOT_LEFT], isSenseW[SLOT_LEFT], isState[SLOT_LEFT], isFault[SLOT_LEFT] := wheelL.testGetTelemetry()
                isPos[SLOT_LEFT] := wheelL.getRawHallTicks()
                isMissed[SLOT_LEFT], isIllegal[SLOT_LEFT] := wheelL.getHallIntegrityCounts()
            isUp[SLOT_RIGHT] := (wheelR.testGetMotorCog() <> 0)
            if isUp[SLOT_RIGHT]
                isDuty[SLOT_RIGHT], isErr[SLOT_RIGHT], isSenseI[SLOT_RIGHT], isSenseU[SLOT_RIGHT], isSenseV[SLOT_RIGHT], isSenseW[SLOT_RIGHT], isState[SLOT_RIGHT], isFault[SLOT_RIGHT] := wheelR.testGetTelemetry()
                isPos[SLOT_RIGHT] := wheelR.getRawHallTicks()
                isMissed[SLOT_RIGHT], isIllegal[SLOT_RIGHT] := wheelR.getHallIntegrityCounts()
        INST_SRC_STEER:
            isState[SLOT_LEFT], isState[SLOT_RIGHT] := steering.testGetDriverState()
            isUp[SLOT_LEFT] := (isState[SLOT_LEFT] <> DCS_UNKNOWN)
            isUp[SLOT_RIGHT] := (isState[SLOT_RIGHT] <> DCS_UNKNOWN)
            if isUp[SLOT_LEFT]
                isDuty[SLOT_LEFT], isErr[SLOT_LEFT], isSenseI[SLOT_LEFT], isSenseU[SLOT_LEFT], isSenseV[SLOT_LEFT], isSenseW[SLOT_LEFT], isState[SLOT_LEFT], isFault[SLOT_LEFT] := steering.testLeftGetTelemetry()
            if isUp[SLOT_RIGHT]
                isDuty[SLOT_RIGHT], isErr[SLOT_RIGHT], isSenseI[SLOT_RIGHT], isSenseU[SLOT_RIGHT], isSenseV[SLOT_RIGHT], isSenseW[SLOT_RIGHT], isState[SLOT_RIGHT], isFault[SLOT_RIGHT] := steering.testRightGetTelemetry()
            if isUp[SLOT_LEFT] or isUp[SLOT_RIGHT]
                isPos[SLOT_LEFT], isPos[SLOT_RIGHT] := steering.testGetRawHallTicks()
                isMissed[SLOT_LEFT], isIllegal[SLOT_LEFT], isMissed[SLOT_RIGHT], isIllegal[SLOT_RIGHT] := steering.getHallIntegrityCounts()
        other:
            isUp[SLOT_LEFT] := FALSE
            isUp[SLOT_RIGHT] := FALSE

PRI instStore(sampleCt) | ringBase, motorIdx, motorOff
' Store one sample at the next ring index (instrument cog). The ring is circular: past
' INST_RING_SAMPLES the oldest sample is overwritten, and cog 0 reports the excess as lost_head.
'
' @param sampleCt - getct() at the start of this sample
'
' @local ringBase - first long of this sample in ring[]
' @local motorIdx - motor slot
' @local motorOff - first long of this motor's four longs

    instW := instTotal +// INST_RING_SAMPLES
    ringBase := instW * INST_SAMPLE_LONGS
    ring[ringBase + SMP_T] := sampleCt
    repeat motorIdx from SLOT_LEFT to SLOT_RIGHT
        motorOff := ringBase + SMP_MOTOR_BASE + (motorIdx * SMP_MOTOR_LONGS)
        ring[motorOff + SMP_POS] := isUp[motorIdx] ? isPos[motorIdx] : 0
        ring[motorOff + SMP_SENSE] := instPackSense(motorIdx)
        ring[motorOff + SMP_FLAGS] := instPackFlags(motorIdx)
        ring[motorOff + SMP_HW] := isHwPos[motorIdx]
    instTotal := (instTotal + 1) <# LIM_BIG
    instRunSamples := (instRunSamples + 1) <# LIM_BIG

PRI instClamp(fieldValue, lowLimit, highLimit) : clampedValue
' Clamp one stored field to its width, counting the clamp (instrument cog; I2).
'
' @param fieldValue - the reading
' @param lowLimit - smallest storable value
' @param highLimit - largest storable value
' @returns clampedValue - fieldValue inside lowLimit..highLimit

    clampedValue := (fieldValue #> lowLimit) <# highLimit
    if clampedValue <> fieldValue
        instClamps := (instClamps + 1) <# LIM_BIG
        instRunClamps := (instRunClamps + 1) <# LIM_BIG

PRI instPackSense(motorIdx) : senseLong | senseMv, phaseMv
' Pack i (i16) and the phase sum u+v+w (i16) into one long (instrument cog).
'
' @param motorIdx - motor slot
' @returns senseLong - i << 16 | phase sum & $FFFF; 0 when the driver is not up
'
' @local senseMv - clamped sense_i
' @local phaseMv - clamped phase sum

    senseLong := 0
    if isUp[motorIdx]
        senseMv := instClamp(isSenseI[motorIdx], 0 - FIELD_I16_MAX, FIELD_I16_MAX)
        phaseMv := instClamp(isSenseU[motorIdx] + isSenseV[motorIdx] + isSenseW[motorIdx], 0 - FIELD_I16_MAX, FIELD_I16_MAX)
        senseLong := (senseMv << SENSE_I_SHIFT) | (phaseMv & SENSE_PH_MASK)

PRI instPackFlags(motorIdx) : flagsLong | dutyVal, errVal, igNow, igDelta
' Pack duty, err, state, fault, up and the integrity delta since the previous stored sample into one
' long (instrument cog). The delta saturates at INTEG_DELTA_MAX; a saturation is counted.
'
' @param motorIdx - motor slot
' @returns flagsLong - duty << 16 | err << 8 | state << 5 | fault << 4 | up << 3 | integDelta
'
' @local dutyVal - clamped duty
' @local errVal - clamped err
' @local igNow - missed + illegal now
' @local igDelta - events since the previous stored sample

    flagsLong := 0
    if isUp[motorIdx]
        dutyVal := instClamp(isDuty[motorIdx], 0, FIELD_DUTY_MAX)
        errVal := instClamp(isErr[motorIdx], FIELD_ERR_MIN, FIELD_ERR_MAX)
        igNow := isMissed[motorIdx] + isIllegal[motorIdx]
        igDelta := 0
        if isIgPrev[motorIdx] >= 0
            igDelta := (igNow - isIgPrev[motorIdx]) #> 0
            if igDelta > INTEG_DELTA_MAX
                igDelta := INTEG_DELTA_MAX
                instIntegSat := (instIntegSat + 1) <# LIM_BIG
        isIgPrev[motorIdx] := igNow
        flagsLong := (dutyVal << FLAG_DUTY_SHIFT) | ((errVal & FIELD_BYTE_MASK) << FLAG_ERR_SHIFT)
        flagsLong |= ((isState[motorIdx] & FLAG_STATE_MASK) << FLAG_STATE_SHIFT)
        flagsLong |= ((isFault[motorIdx] <> FALSE) ? (1 << FLAG_FAULT_BIT) : 0)
        flagsLong |= (1 << FLAG_UP_BIT) | igDelta

PRI instMotorBase(motorIdx) : basePin
' Base pin of a motor slot's board (shared by both cogs; reads only constants).
'
' @param motorIdx - motor slot
' @returns basePin - LEFT_TEST_BASE or RIGHT_TEST_BASE

    basePin := (motorIdx == SLOT_RIGHT) ? RIGHT_TEST_BASE : LEFT_TEST_BASE

CON { --- instrument control, cog 0 side (design sec 2.4, 2.5) --- }

PRI instStart() | startMs, bAcked
' Start the instrument cog once for the run (I4), prove it answers a command, and emit BM-INST.
'
' @local startMs - getms() before the first command
' @local bAcked - the first IDLE command was acknowledged

    instCogId := cogspin(NEWCOG, instrument(), @instStack)
    if instCogId < 0
        emitInst(INST_EV_NOSTART, 0, FALSE, WHY_NO_COG)
    else
        startMs := getms()
        bAcked := instCommand(INST_CMD_IDLE, 0, 0, INST_ACK_TIMEOUT_MS)
        if bAcked
            emitInst(INST_EV_START, getms() - startMs, TRUE, WHY_NONE)
        else
            emitInst(INST_EV_NOACK, 0, FALSE, WHY_INST_NOACK)

PRI instStop() | startMs, bAcked
' Stop the instrument cooperatively at run end: EXIT, bounded wait for the ack, then cogstop (I4).
' Without an ack the cogstop still runs: the instrument holds no lock and emits no debug (I1, I4).
'
' @local startMs - getms() before the EXIT command
' @local bAcked - the EXIT command was acknowledged

    if instCogId >= 0
        startMs := getms()
        bAcked := instCommand(INST_CMD_EXIT, 0, 0, INST_ACK_TIMEOUT_MS)
        cogstop(instCogId)
        emitInst(INST_EV_STOP, getms() - startMs, bAcked, bAcked ? WHY_NONE : WHY_INST_NOACK)
        instCogId := -1

PRI instCommand(cmdCode, argFirst, argSecond, timeoutMs) : bAcked | startMs
' Send one command and wait, bounded and beating CP_INST_ACK every SAMPLE_MS, for its ack. The
' arguments are written first, then the command, then the sequence number the instrument watches.
'
' @param cmdCode - INST_CMD_* value
' @param argFirst - instArg0
' @param argSecond - instArg1
' @param timeoutMs - the longest wait for the ack
' @returns bAcked - TRUE when instAckSeq reached this command's sequence number
'
' @local startMs - getms() when the command was sent

    bAcked := FALSE
    if instCogId >= 0
        instArg0 := argFirst
        instArg1 := argSecond
        instArg2 := 0
        instCmd := cmdCode
        instCmdSeq += 1
        startMs := getms()
        repeat
            beat(CP_INST_ACK)
            if instAckSeq == instCmdSeq
                bAcked := TRUE
                quit
            if (getms() - startMs) >= timeoutMs
                quit
            waitms(SAMPLE_MS)

PRI instQuiet() : bQuiet
' Report whether the instrument has acknowledged IDLE or FROZEN (or is not running): the only states in
' which cog 0 may start, stop or switch a wheel, or drain the ring (I10).
'
' @returns bQuiet - TRUE when a wheel may be touched

    bQuiet := (instCogId < 0) or ((instAckSeq == instCmdSeq) and ((instState == INST_ST_IDLE) or (instState == INST_ST_FROZEN)))

PRI instArm(eSource, decimation) : bArmed
' Arm a capture on a source, legal only from IDLE or FROZEN. A missing ack emits BM-INST NOACK.
'
' @param eSource - INST_SRC_* value
' @param decimation - store one sample in this many (1..INST_DECIM_MAX)
' @returns bArmed - TRUE when the instrument acknowledged RUN

    bArmed := FALSE
    if (instCogId >= 0) and instQuiet()
        instSrc := eSource
        instDecimate := (decimation #> 1) <# INST_DECIM_MAX
        if instCommand(INST_CMD_ARM, eSource, instDecimate, INST_ACK_TIMEOUT_MS)
            bArmed := (instState == INST_ST_RUN)
        else
            emitInst(INST_EV_NOACK, INST_ACK_TIMEOUT_MS, FALSE, WHY_INST_NOACK)

PRI instFreeze(postSamples) : bFrozen | timeoutMs
' Freeze the capture after postSamples more stored samples. The ack bound covers the post samples.
'
' @param postSamples - samples to store after the command (0: freeze now)
' @returns bFrozen - TRUE when the instrument acknowledged FROZEN
'
' @local timeoutMs - ack bound: INST_ACK_TIMEOUT_MS plus the post samples' own duration

    bFrozen := (instCogId >= 0) and (instAckSeq == instCmdSeq) and (instState == INST_ST_FROZEN)
    if (bFrozen == FALSE) and (instCogId >= 0) and (instState == INST_ST_RUN)
        timeoutMs := INST_ACK_TIMEOUT_MS + ((postSamples #> 0) * instDecimate * MS_PER_SEC) / INST_RATE_HZ
        if instCommand(INST_CMD_FREEZE, postSamples #> 0, 0, timeoutMs)
            bFrozen := (instState == INST_ST_FROZEN)
        else
            emitInst(INST_EV_NOACK, timeoutMs, FALSE, WHY_INST_NOACK)

PRI instIdle() : bIdle
' Return the instrument to IDLE: it stops storing and stops reading any wheel.
'
' @returns bIdle - TRUE when IDLE is acknowledged (or no instrument runs)

    bIdle := (instCogId < 0) or ((instAckSeq == instCmdSeq) and (instState == INST_ST_IDLE))
    if bIdle == FALSE
        if instCommand(INST_CMD_IDLE, 0, 0, INST_ACK_TIMEOUT_MS)
            bIdle := (instState == INST_ST_IDLE)
        else
            emitInst(INST_EV_NOACK, INST_ACK_TIMEOUT_MS, FALSE, WHY_INST_NOACK)

PRI instIdleForShutdown()
' Before the end-of-run stops, return the instrument to IDLE so no wheel is stopped under it (I10).

    instIdle()

PRI instMark()
' Mark an event immediately before its library call. The instrument records the ring total on its
' next pass (instMarkTotal); instMarkCt is kept only for timing within one sample period (sec 12.7).

    instMarkCt := getct()
    instMarkSeq += 1

PRI instMarkIndex() : markTotal | startMs
' Mark a window boundary and wait, bounded and beating CP_INST_ACK every SAMPLE_MS, for the instrument
' to record the ring total at the mark (sec 12.7). A window is delimited by two of these totals.
'
' @returns markTotal - total index of the first sample stored at or after the mark, -1 when not recorded
'
' @local startMs - getms() when the mark was written

    markTotal := -1
    instMark()
    startMs := getms()
    repeat
        beat(CP_INST_ACK)
        if instMarkAckSeq == instMarkSeq
            markTotal := instMarkTotal
            quit
        if (getms() - startMs) >= INST_ACK_TIMEOUT_MS
            quit
        waitms(SAMPLE_MS)

CON { --- cog-0 safety monitor and watched waits (design sec 2.8) --- }

PRI safetyReset() | slotIdx
' Start a watched wait: clear the consecutive-current counts and take the heartbeat baseline.
'
' @local slotIdx - motor slot

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        safeAbsCount[slotIdx] := 0
    safeLastHeartbeat := instHeartbeat
    safeLastHeartbeatMs := getms()

PRI safetyPoll(side) : safeEvent | slotIdx
' One safety read of the instrument's last-sample mirror (no library getter). An absolute current at or
' above ABS_ABORT_MV on ABS_ABORT_SAMPLES consecutive reads stops that wheel FIRST, then emits BM-ABORT.
' Precedence: ABS_ABORT, then INST_STALL, then FAULT.
'
' @param side - SIDE_LEFT, SIDE_RIGHT or SIDE_BOTH: which motors are watched
' @returns safeEvent - SAFE_* value
'
' @local slotIdx - motor slot

    safeEvent := SAFE_NONE
    if instHeartbeat <> safeLastHeartbeat
        safeLastHeartbeat := instHeartbeat
        safeLastHeartbeatMs := getms()
    elseif (getms() - safeLastHeartbeatMs) >= INST_STALL_MS
        safeEvent := SAFE_INST_STALL
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        if sideWatches(side, slotIdx) and (instLastUp[slotIdx] <> FALSE)
            if instLastI[slotIdx] >= ABS_ABORT_MV
                safeAbsCount[slotIdx] += 1
                if (safeAbsCount[slotIdx] >= ABS_ABORT_SAMPLES) and (safeEvent <> SAFE_ABS_ABORT)
                    abortStopMotor(side, slotIdx)
                    emitAbort(curSeg, curTid, (side == SIDE_BOTH) ? SIDE_BOTH : side, curIncre, ABR_ABS_CURRENT, ...
                        instLastI[slotIdx], SCOPE_TRIAL)
                    safeEvent := SAFE_ABS_ABORT
            else
                safeAbsCount[slotIdx] := 0
            if (instLastFault[slotIdx] <> FALSE) and (safeEvent == SAFE_NONE)
                safeEvent := SAFE_FAULT

PRI sideWatches(side, slotIdx) : bWatched
' Report whether a motor slot belongs to a side.
'
' @param side - SIDE_* value
' @param slotIdx - motor slot
' @returns bWatched - TRUE when the side covers the slot

    bWatched := (side == SIDE_BOTH) or ((side - SIDE_LEFT) == slotIdx)

PRI abortStopMotor(side, slotIdx)
' The absolute-current abort's stop: the one place a wheel is stopped while the instrument may be
' reading it. Safety outranks I10; a straddled sample is gated by up (I3) on its next read.
'
' @param side - SIDE_BOTH stops the steering object; otherwise the slot's wheel
' @param slotIdx - motor slot over the limit

    beat(CP_LIB_STOP)
    if side == SIDE_BOTH
        steering.stop()
        bSteerUp := FALSE
    elseif slotIdx == SLOT_RIGHT
        wheelR.stop()
    else
        wheelL.stop()
    beat(CP_LIB_STOP)

PRI waitWatched(side, durationMs, cpId, untilKind) : safeEvent, bReached | startMs
' A beat-polled wait of at most durationMs that reads only the instrument mirror every SAMPLE_MS, and
' ends early on a safety event or when every watched motor reaches the requested state.
'
' @param side - SIDE_LEFT, SIDE_RIGHT or SIDE_BOTH
' @param durationMs - the wait's bound
' @param cpId - CP_LOOP_* beaten every pass
' @param untilKind - UNTIL_TIME, UNTIL_STOPPED, UNTIL_AT_SPEED or UNTIL_MOVING
' @returns safeEvent - SAFE_* that ended the wait, SAFE_NONE otherwise
' @returns bReached - TRUE when the requested state (or, for UNTIL_TIME, the full duration) was reached
'
' @local startMs - getms() when the wait began

    safetyReset()
    safeEvent := SAFE_NONE
    bReached := FALSE
    startMs := getms()
    repeat
        beat(cpId)
        waitms(SAMPLE_MS)
        safeEvent := safetyPoll(side)
        if untilKind == UNTIL_STOPPED
            bReached := mirrorAllInState(side, DCS_STOPPED)
        elseif untilKind == UNTIL_AT_SPEED
            bReached := mirrorAllInState(side, DCS_AT_SPEED)
        elseif untilKind == UNTIL_MOVING
            bReached := mirrorNoneInState(side, DCS_STOPPED)
        if (safeEvent <> SAFE_NONE) or bReached or ((getms() - startMs) >= durationMs)
            quit
    if untilKind == UNTIL_TIME
        bReached := (safeEvent == SAFE_NONE)

PRI mirrorAllInState(side, eState) : bAll | slotIdx
' Report whether every watched motor's mirror shows the driver up and in one state.
'
' @param side - SIDE_LEFT, SIDE_RIGHT or SIDE_BOTH
' @param eState - DCS_* value
' @returns bAll - TRUE when every watched motor is up and in eState
'
' @local slotIdx - motor slot

    bAll := TRUE
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        if sideWatches(side, slotIdx)
            if (instLastUp[slotIdx] == FALSE) or (instLastState[slotIdx] <> eState)
                bAll := FALSE

PRI mirrorNoneInState(side, eState) : bNone | slotIdx
' Report whether every watched motor's mirror shows the driver up and outside one state.
'
' @param side - SIDE_LEFT, SIDE_RIGHT or SIDE_BOTH
' @param eState - DCS_* value
' @returns bNone - TRUE when every watched motor is up and not in eState
'
' @local slotIdx - motor slot

    bNone := TRUE
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        if sideWatches(side, slotIdx)
            if (instLastUp[slotIdx] == FALSE) or (instLastState[slotIdx] == eState)
                bNone := FALSE

PRI waitRest(side, durationMs, bEndOnFault) : safeEvent, bRest | slotIdx, startMs, stillStartMs, lastPos, lastHw
' A beat-polled capture wait after an event that reads only the instrument mirror (sec 2.8): ends when
' the watched motor's pos and hwPos have both been unchanged for REST_CONFIRM_MS, on a safety event, or
' after durationMs. After stop() pos is frozen, so hwPos alone decides.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param durationMs - the capture bound
' @param bEndOnFault - FALSE when the fault is the event under capture, so its flag does not end the wait
' @returns safeEvent - SAFE_* that ended the wait, SAFE_NONE otherwise
' @returns bRest - TRUE when rest was confirmed
'
' @local slotIdx - motor slot
' @local startMs - getms() when the wait began
' @local stillStartMs - getms() when pos or hwPos last changed
' @local lastPos - mirrored pos at the last change
' @local lastHw - mirrored hwPos at the last change

    safetyReset()
    slotIdx := side - SIDE_LEFT
    safeEvent := SAFE_NONE
    bRest := FALSE
    startMs := getms()
    stillStartMs := startMs
    lastPos := instLastPos[slotIdx]
    lastHw := instLastHw[slotIdx]
    repeat
        beat(CP_LOOP_CAPTURE)
        waitms(SAMPLE_MS)
        safeEvent := safetyPoll(side)
        if (safeEvent == SAFE_FAULT) and (bEndOnFault == FALSE)
            safeEvent := SAFE_NONE
        if (instLastPos[slotIdx] <> lastPos) or (instLastHw[slotIdx] <> lastHw)
            lastPos := instLastPos[slotIdx]
            lastHw := instLastHw[slotIdx]
            stillStartMs := getms()
        elseif (getms() - stillStartMs) >= REST_CONFIRM_MS
            bRest := TRUE
        if (safeEvent <> SAFE_NONE) or bRest or ((getms() - startMs) >= durationMs)
            quit

PRI waitBeat(durationMs, cpId) | startMs
' A beat-polled wait with no motor watched (rests, cool-downs): no single waitms() exceeds SAMPLE_MS.
'
' @param durationMs - the wait's length
' @param cpId - CP_LOOP_* beaten every pass
'
' @local startMs - getms() when the wait began

    startMs := getms()
    repeat
        beat(cpId)
        if (getms() - startMs) >= durationMs
            quit
        waitms(SAMPLE_MS)

CON { --- ring drain accessors, cog 0, legal only while the instrument is IDLE or FROZEN (I10) --- }

PRI drainBegin()
' Snapshot the ring geometry for a drain: how many samples are readable, how many were overwritten,
' and where logical sample 0 sits.

    beat(CP_LOOP_DRAIN)
    drStored := instTotal <# INST_RING_SAMPLES
    drLostHead := instTotal - drStored
    drOldest := 0
    if instTotal > INST_RING_SAMPLES
        drOldest := (instW + 1) +// INST_RING_SAMPLES

PRI smpBase(sampleIdx) : ringBase
' First long in ring[] of a logical sample.
'
' @param sampleIdx - logical index 0..drStored-1, oldest first
' @returns ringBase - index of its t long

    ringBase := ((drOldest + sampleIdx) +// INST_RING_SAMPLES) * INST_SAMPLE_LONGS

PRI smpMotorLong(sampleIdx, slotIdx, fieldOff) : fieldLong
' One motor long of a logical sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @param fieldOff - SMP_POS, SMP_SENSE, SMP_FLAGS or SMP_HW
' @returns fieldLong - the stored long

    fieldLong := ring[smpBase(sampleIdx) + SMP_MOTOR_BASE + (slotIdx * SMP_MOTOR_LONGS) + fieldOff]

PRI smpT(sampleIdx) : sampleCt
' getct() at the start of a logical sample.
'
' @param sampleIdx - logical index
' @returns sampleCt - the stored t

    sampleCt := ring[smpBase(sampleIdx) + SMP_T]

PRI smpPos(sampleIdx, slotIdx) : nPos
' Driver pos of a logical sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns nPos - stored pos (0 when the driver was not up)

    nPos := smpMotorLong(sampleIdx, slotIdx, SMP_POS)

PRI smpHw(sampleIdx, slotIdx) : nHwPos
' Hall-decoded hwPos of a logical sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns nHwPos - stored hwPos

    nHwPos := smpMotorLong(sampleIdx, slotIdx, SMP_HW)

PRI smpI(sampleIdx, slotIdx) : senseMv
' sense_i of a logical sample, sign-extended from 16 bits.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns senseMv - mV

    senseMv := smpMotorLong(sampleIdx, slotIdx, SMP_SENSE) SAR SENSE_I_SHIFT

PRI smpPh(sampleIdx, slotIdx) : phaseMv
' Phase sum u+v+w of a logical sample, sign-extended from 16 bits.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns phaseMv - mV

    phaseMv := (smpMotorLong(sampleIdx, slotIdx, SMP_SENSE) & SENSE_PH_MASK) SIGNX SENSE_PH_SIGNBIT

PRI smpDuty(sampleIdx, slotIdx) : dutyVal
' Duty of a logical sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns dutyVal - 0..65535

    dutyVal := smpMotorLong(sampleIdx, slotIdx, SMP_FLAGS) >> FLAG_DUTY_SHIFT

PRI smpErr(sampleIdx, slotIdx) : errVal
' Position error of a logical sample, sign-extended from 8 bits.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns errVal - -128..127

    errVal := ((smpMotorLong(sampleIdx, slotIdx, SMP_FLAGS) >> FLAG_ERR_SHIFT) & FIELD_BYTE_MASK) SIGNX FIELD_ERR_SIGNBIT

PRI smpState(sampleIdx, slotIdx) : eDrvrState
' Driver state of a logical sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns eDrvrState - DCS_* 0..7

    eDrvrState := (smpMotorLong(sampleIdx, slotIdx, SMP_FLAGS) >> FLAG_STATE_SHIFT) & FLAG_STATE_MASK

PRI smpFault(sampleIdx, slotIdx) : bFaulted
' Fault flag of a logical sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns bFaulted - TRUE when the fault flag was set

    bFaulted := ((smpMotorLong(sampleIdx, slotIdx, SMP_FLAGS) >> FLAG_FAULT_BIT) & 1) <> 0

PRI smpUp(sampleIdx, slotIdx) : bUp
' Driver-running flag of a logical sample (I3).
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns bUp - TRUE when the driver was up

    bUp := ((smpMotorLong(sampleIdx, slotIdx, SMP_FLAGS) >> FLAG_UP_BIT) & 1) <> 0

PRI smpIg(sampleIdx, slotIdx) : igDelta
' Hall integrity events since the previous stored sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns igDelta - 0..INTEG_DELTA_MAX

    igDelta := smpMotorLong(sampleIdx, slotIdx, SMP_FLAGS) & FLAG_IG_MASK

PRI drainFindMark() | markIdx
' Locate the event mark by ring index (sec 12.7): its logical index is instMarkTotal - drLostHead, valid
' when the instrument recorded it for the latest mark and it lies in 0..drStored-1. Below 0 the mark
' sample was overwritten, so lost_head reaches the mark. Sets drMarkJ and bDrMarkFound.
'
' @local markIdx - the mark's logical index

    drMarkJ := drStored
    bDrMarkFound := FALSE
    if (instMarkAckSeq == instMarkSeq) and (instMarkTotal >= 0)
        markIdx := instMarkTotal - drLostHead
        if (markIdx >= 0) and (markIdx < drStored)
            drMarkJ := markIdx
            bDrMarkFound := TRUE

CON { --- trace emission (design sec 3.5, sec 12.4) and window statistics (I2) --- }

PRI traceDrain(tid, slotPri, slotOth, endCode) : bLost
' Drain a frozen capture as one trace: locate the mark by ring index, bound the trace to
' TRACE_MAX_SAMPLES from TRACE_PRE_SAMPLES before it, find rest, choose the dense window and stride that
' fit TRACE_EMIT_MAX (dense 250, then 100, then stride 1, 2, 4, 8), emit the BM-TS lines, then
' BM-TRACE-END. The caller has emitted BM-TRACE or BM-STRACE, and folds nothing: this method folds the
' trace into R14-DUAL-TRACES-*.
'
' @param tid - trace id from nextTraceId()
' @param slotPri - primary motor slot (the o_ fields are the other slot)
' @param slotOth - the other motor slot
' @param endCode - TEND_* naming why the capture ended
' @returns bLost - TRUE when the capture lost data at or before its mark, or dropped samples

    drainBegin()
    drPri := slotPri
    drOth := slotOth
    drainFindMark()
    drStartJ := 0
    if bDrMarkFound
        drStartJ := (drMarkJ - TRACE_PRE_SAMPLES) #> 0
    drEndJ := drStored - 1
    drDropped := 0
    if (drStored > 0) and ((drEndJ - drStartJ + 1) > TRACE_MAX_SAMPLES)
        drDropped := (drEndJ - drStartJ + 1) - TRACE_MAX_SAMPLES
        drEndJ := drStartJ + TRACE_MAX_SAMPLES - 1
    traceFindRest()
    traceIntegritySums()
    trTid := tid
    trDense := TRACE_DENSE_SAMPLES
    trStride := 1
    traceWalk(FALSE)
    if trLines > TRACE_EMIT_MAX
        trDense := TRACE_DENSE_MIN
        traceWalk(FALSE)
        repeat while (trLines > TRACE_EMIT_MAX) and (trStride < TRACE_STRIDE_MAX)
            trStride *= TRACE_STRIDE_GROWTH
            traceWalk(FALSE)
    traceWalk(TRUE)
    ' lost_head reaches the mark: samples were overwritten and none survives before the mark
    bLost := (drDropped > 0) or ((drLostHead > 0) and ((bDrMarkFound == FALSE) or (drMarkJ == 0)))
    sfTraces := (sfTraces + 1) <# LIM_BIG
    if bLost
        sfTraceLost := (sfTraceLost + 1) <# LIM_BIG
    emitTraceEnd(tid, endCode, WHY_NO_SAMPLES)

PRI traceFindRest() | restSamples, stillCount, runStartJ, sampleIdx
' Find rest after the mark: pos and hwPos of the primary motor unchanged for REST_CONFIRM_MS. Sets
' drRestK (k where the still run began) and bDrRestFound.
'
' @local restSamples - stored samples spanning REST_CONFIRM_MS at this capture's decimation
' @local stillCount - consecutive unchanged samples so far
' @local runStartJ - logical index where the current still run began
' @local sampleIdx - logical index

    bDrRestFound := FALSE
    drRestK := 0
    restSamples := ((REST_CONFIRM_MS * INST_RATE_HZ) / MS_PER_SEC / instDecimate) #> 1
    if bDrMarkFound and (drMarkJ < drEndJ)
        stillCount := 0
        runStartJ := drMarkJ
        repeat sampleIdx from drMarkJ + 1 to drEndJ
            beat(CP_LOOP_DRAIN)
            if (smpPos(sampleIdx, drPri) == smpPos(sampleIdx - 1, drPri)) and (smpHw(sampleIdx, drPri) == smpHw(sampleIdx - 1, drPri))
                stillCount += 1
                if stillCount >= restSamples
                    drRestK := runStartJ - drStartJ
                    bDrRestFound := TRUE
                    quit
            else
                stillCount := 0
                runStartJ := sampleIdx

PRI traceIntegritySums() | sampleIdx
' Integrity events over the trace for both motors, and the primary motor's unresolved hall transitions.
'
' @local sampleIdx - logical index

    drIgSum := 0
    drOIgSum := 0
    drHwSkip := instHwSkip[drPri]
    if (drStored > 0) and (drStartJ < drEndJ)
        repeat sampleIdx from drStartJ + 1 to drEndJ
            beat(CP_LOOP_DRAIN)
            drIgSum := (drIgSum + smpIg(sampleIdx, drPri)) <# LIM_BIG
            drOIgSum := (drOIgSum + smpIg(sampleIdx, drOth)) <# LIM_BIG

PRI traceWalk(bEmit) | sampleIdx, kIdx, markK, posRel, hwRel, stNow, bFltNow, bUpNow, bWant, bChanged
' Walk the trace applying the emission rule. With bEmit FALSE it only counts the lines the rule wants
' (trLines), so traceDrain() can pick a dense window and stride; with bEmit TRUE it emits them, never
' more than TRACE_EMIT_MAX (the last sample is always kept), and leaves trLines / trKSum as emitted.
' Rule: k below mark_k + dense; or, on every stride-th k, a change of pos, hw, st, flt or up from the
' last emitted line, or k a multiple of TRACE_SPARSE_EVERY x stride; or the first or last sample.
'
' @param bEmit - TRUE to emit BM-TS lines, FALSE to count only
'
' @local sampleIdx - logical index
' @local kIdx - trace index k
' @local markK - k of the mark (0 when the mark was not found)
' @local posRel - primary pos relative to k = 0
' @local hwRel - primary hwPos relative to k = 0
' @local stNow - primary state
' @local bFltNow - primary fault flag
' @local bUpNow - primary up flag
' @local bWant - the rule wants this line
' @local bChanged - a watched field differs from the last emitted line

    trLines := 0
    trKSum := 0
    trIgRun := 0
    bTrEmitted := FALSE
    markK := bDrMarkFound ? (drMarkJ - drStartJ) : 0
    if drStored > 0
        repeat sampleIdx from drStartJ to drEndJ
            beat(CP_LOOP_DRAIN)
            kIdx := sampleIdx - drStartJ
            if kIdx > 0
                trIgRun := (trIgRun + smpIg(sampleIdx, drPri)) <# LIM_BIG
            posRel := smpPos(sampleIdx, drPri) - smpPos(drStartJ, drPri)
            hwRel := smpHw(sampleIdx, drPri) - smpHw(drStartJ, drPri)
            stNow := smpState(sampleIdx, drPri)
            bFltNow := smpFault(sampleIdx, drPri)
            bUpNow := smpUp(sampleIdx, drPri)
            bWant := (sampleIdx == drStartJ) or (sampleIdx == drEndJ) or (kIdx < markK + trDense)
            if (kIdx +// trStride) == 0
                bChanged := (bTrEmitted == FALSE) or (posRel <> trLastPos) or (hwRel <> trLastHw)
                bChanged := bChanged or (stNow <> trLastSt) or (bFltNow <> trLastFlt) or (bUpNow <> trLastUp)
                if bChanged or ((kIdx +// (TRACE_SPARSE_EVERY * trStride)) == 0)
                    bWant := TRUE
            if bWant and ((bEmit == FALSE) or (trLines < TRACE_EMIT_MAX - 1) or (sampleIdx == drEndJ))
                trLines += 1
                trKSum := (trKSum + kIdx) <# LIM_MID
                trLastPos := posRel
                trLastHw := hwRel
                trLastSt := stNow
                trLastFlt := bFltNow
                trLastUp := bUpNow
                bTrEmitted := TRUE
                if bEmit
                    emitTs(sampleIdx, kIdx, posRel, hwRel)

PRI windowStats(slotIdx, otherIdx, winStartTotal, winEndTotal) | sampleIdx, startJ, endJ, firstJ, lastJ, iSum, phSum, dutySum, errSum, sampleI
' Compute a measurement window's statistics from drained samples (I2). The window is delimited by ring
' index, never by time (sec 12.7): only samples whose total index lies in winStartTotal..winEndTotal-1
' count (each bound is an instMarkIndex() total, the first sample at or after its mark). Sums run over
' at most INST_RING_SAMPLES clamped fields, and i / phase / duty / err statistics use only samples whose
' driver was up (I3). A bound below 0 selects no sample and reads no ring long. Fills the rs* staging.
'
' @param slotIdx - motor slot under test
' @param otherIdx - the idle motor slot (bRsIdleUp / rsIdleIMax, I6)
' @param winStartTotal - total index at the window start, -1 when not recorded
' @param winEndTotal - total index at the window end, -1 when not recorded
'
' @local sampleIdx - logical index
' @local startJ - logical index of the first sample in the window
' @local endJ - logical index of the last sample in the window
' @local firstJ - first sample inside the window, -1 when none
' @local lastJ - last sample inside the window
' @local iSum - sum of i over up samples, |sum| <= 32_767 x 4_096
' @local phSum - sum of the phase sum over up samples, same bound
' @local dutySum - sum of duty over up samples, <= 65_535 x 4_096
' @local errSum - sum of err over up samples
' @local sampleI - this sample's i

    drainBegin()
    rsN := 0
    iSum := 0
    phSum := 0
    dutySum := 0
    errSum := 0
    rsIMin := POSX
    rsIMax := NEGX
    rsDutyPk := 0
    rsErrPk := 0
    rsIgSum := 0
    rsIMeanX10 := 0
    rsPhMeanX10 := 0
    rsDutyMean := 0
    rsErrMean := 0
    rsTicks := 0
    rsHwTicks := 0
    rsWinMs := 0
    rsRateX10 := 0
    bRsAllUp := TRUE
    bRsIdleUp := FALSE
    rsIdleIMax := 0
    firstJ := -1
    lastJ := -1
    startJ := 0
    endJ := -1
    if (winStartTotal >= 0) and (winEndTotal > winStartTotal) and (drStored > 0)
        startJ := (winStartTotal - drLostHead) #> 0
        endJ := (winEndTotal - 1 - drLostHead) <# (drStored - 1)
    if endJ >= startJ
        repeat sampleIdx from startJ to endJ
            beat(CP_LOOP_DRAIN)
            if firstJ < 0
                firstJ := sampleIdx
            elseif smpUp(sampleIdx, slotIdx)
                rsIgSum := (rsIgSum + smpIg(sampleIdx, slotIdx)) <# LIM_BIG
            lastJ := sampleIdx
            if smpUp(sampleIdx, slotIdx)
                sampleI := smpI(sampleIdx, slotIdx)
                rsN += 1
                iSum += sampleI
                phSum += smpPh(sampleIdx, slotIdx)
                dutySum += smpDuty(sampleIdx, slotIdx)
                errSum += smpErr(sampleIdx, slotIdx)
                rsIMin <#= sampleI
                rsIMax #>= sampleI
                rsDutyPk #>= smpDuty(sampleIdx, slotIdx)
                rsErrPk #>= abs(smpErr(sampleIdx, slotIdx))
            else
                bRsAllUp := FALSE
            if smpUp(sampleIdx, otherIdx)
                bRsIdleUp := TRUE
                rsIdleIMax #>= abs(smpI(sampleIdx, otherIdx))
    if rsN > 0
        rsIMeanX10 := (iSum * X10) / rsN
        rsPhMeanX10 := (phSum * X10) / rsN
        rsDutyMean := dutySum / rsN
        rsErrMean := errSum / rsN
    else
        rsIMin := 0
        rsIMax := 0
        bRsAllUp := FALSE
    if (firstJ >= 0) and (lastJ > firstJ)
        rsTicks := smpPos(lastJ, slotIdx) - smpPos(firstJ, slotIdx)
        rsHwTicks := smpHw(lastJ, slotIdx) - smpHw(firstJ, slotIdx)
        rsWinMs := (smpT(lastJ) - smpT(firstJ)) / TICKS_PER_MS
        if rsWinMs > 0
            rsRateX10 := (rsTicks * RATE_X10_SCALE) / rsWinMs
    rsLate := instLate
    rsSkipped := instSkipped
    rsClamps := instClamps
    rsHwSkip := instHwSkip[slotIdx]

PRI predictX10(motorIncre) : predX10
' C-1's predicted hall ticks per second x10 for an increment (design sec 3.2), signed like the increment.
'
' @param motorIncre - signed increment
' @returns predX10 - (|incre| / 1_000) x 120 / 4_295, with the increment's sign

    predX10 := ((abs(motorIncre) / PRED_INCRE_DIV) * PRED_MUL) / PRED_DIV
    if motorIncre < 0
        predX10 := 0 - predX10

PRI foldIdleWheel(slotIdx, bIdleUp)
' Fold one motor-frame capture into R14-DUAL-IDLEFLT-A: one capture on this motor, and whether any of its
' samples showed the idle wheel up (captureIdleUp()).
'
' @param slotIdx - motor slot under test
' @param bIdleUp - TRUE when any sample of the capture showed the idle wheel up

    sfFrameCaps[slotIdx] := (sfFrameCaps[slotIdx] + 1) <# LIM_BIG
    if bIdleUp
        sfIdleUp[slotIdx] := (sfIdleUp[slotIdx] + 1) <# LIM_BIG

PRI foldIntegrity(slotIdx, nMissed, nIllegal)
' Fold integrity counts into R14-DUAL-INTEG-A. Each count is clamped before abs() so a corrupt count
' still adds and abs() never sees NEGX; the sum saturates at LIM_BIG (scan addIntegritySum()).
'
' @param slotIdx - motor slot
' @param nMissed - missed hall transitions
' @param nIllegal - illegal hall codes

    sfIntegSum[slotIdx] := (sfIntegSum[slotIdx] + abs((nMissed #> (0 - LIM_MID)) <# LIM_MID) + abs((nIllegal #> (0 - LIM_MID)) <# LIM_MID)) <# LIM_BIG

PRI nextTraceId() : tid
' Allocate a run-wide trace id and make it the current one (BM-ABORT context).
'
' @returns tid - 1, 2, 3 ...

    traceSeq := (traceSeq + 1) <# LIM_SMALL
    tid := traceSeq
    curTid := tid

PRI nextRungId() : rid
' Allocate a run-wide rung id.
'
' @returns rid - 1, 2, 3 ...

    rungSeq := (rungSeq + 1) <# LIM_SMALL
    rid := rungSeq

PRI segWhy() : whyCode
' The BM-SEG END why of a segment body: ABORTED once the run has aborted, else NONE.
'
' @returns whyCode - WHY_ABORTED or WHY_NONE

    whyCode := bRunAborted ? WHY_ABORTED : WHY_NONE

PRI safeWhy(safeEvent) : whyCode
' The why token of a safety event that ended a trial before its event.
'
' @param safeEvent - SAFE_* value
' @returns whyCode - FAULTED, ABORTED, INST_STALLED, or NONE for SAFE_NONE

    case safeEvent
        SAFE_FAULT:
            whyCode := WHY_FAULTED
        SAFE_ABS_ABORT:
            whyCode := WHY_ABORTED
        SAFE_INST_STALL:
            whyCode := WHY_INST_STALLED
        other:
            whyCode := WHY_NONE

PRI safeEnd(safeEvent) : endCode
' The BM-TRACE-END end token of a safety event that ended a capture.
'
' @param safeEvent - SAFE_* value (not SAFE_NONE)
' @returns endCode - TEND_FAULT for a fault, TEND_ABORT for an abort or a stalled instrument

    endCode := (safeEvent == SAFE_FAULT) ? TEND_FAULT : TEND_ABORT

PRI trialSkipWhy(seg, side, skipWhy) : whyCode
' Decide whether one wheel trial may run: a cause already known first, then the run caps, a retired
' motor (sec 4.2 step 4) and a driver cog that is not running.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param skipWhy - WHY_* already known, WHY_NONE when none
' @returns whyCode - WHY_NONE when the trial may run, else its cause

    whyCode := skipWhy
    if whyCode == WHY_NONE
        if runContinue(seg) == FALSE
            whyCode := WHY_ABORTED
        elseif bSlotRetired[side - SIDE_LEFT]
            whyCode := WHY_MOTOR_RETIRED
        elseif wheelIsUp(side) == FALSE
            whyCode := WHY_NO_COG

PRI traceCaptureMs(decimation) : captureMs
' The post-mark capture bound: the samples TRACE_MAX_SAMPLES leaves after TRACE_PRE_SAMPLES and the
' freeze margin, as ms at a decimation. A capture held to it never drops samples, and its mark stays in
' the ring (the ring holds TRACE_MAX_SAMPLES plus the margin), so R14-DUAL-TRACES-* cannot fail on it.
'
' @param decimation - samples stored one in this many
' @returns captureMs - the longest post-mark capture, ms

    captureMs := ((TRACE_MAX_SAMPLES - TRACE_PRE_SAMPLES - TRACE_FREEZE_MARGIN) * decimation * MS_PER_SEC) / INST_RATE_HZ

PRI captureIdleUp(otherIdx) : bIdleUp | sampleIdx
' Report whether any sample of the frozen capture showed the idle wheel's driver up (R14-DUAL-IDLEFLT-A).
' Legal only while the instrument is FROZEN (I10).
'
' @param otherIdx - the idle motor slot
' @returns bIdleUp - TRUE when any stored sample has the idle wheel up
'
' @local sampleIdx - logical index

    drainBegin()
    bIdleUp := FALSE
    if drStored > 0
        repeat sampleIdx from 0 to drStored - 1
            beat(CP_LOOP_DRAIN)
            if smpUp(sampleIdx, otherIdx)
                bIdleUp := TRUE
                quit

PRI cpReset()
' Clear the trace capture staging before a trial.

    cpWhy := WHY_NONE
    cpEnd := TEND_TIMEOUT
    bCpFrozen := FALSE
    bCpFaultSeen := FALSE
    cpWantNeg := 0
    cpWantPos := 0
    bCpOffWritten := FALSE
    bCpOffRestored := FALSE
    bCpEstopSet := FALSE

PRI traceEmptyEnd(tid, endCode, whyCode)
' BM-TRACE-END for a trace with no drainable capture (skipped, or never frozen so never drained, I10):
' every drain field is reset so nothing stale prints, and why names the cause. Not folded into TRACES.
'
' @param tid - trace id
' @param endCode - TEND_* value
' @param whyCode - WHY_* naming why nothing was captured

    drStored := 0
    drLostHead := 0
    drDropped := 0
    drStartJ := 0
    drEndJ := -1
    drMarkJ := 0
    bDrMarkFound := FALSE
    drRestK := 0
    bDrRestFound := FALSE
    drIgSum := 0
    drOIgSum := 0
    drHwSkip := 0
    trLines := 0
    trKSum := 0
    trStride := 1
    emitTraceEnd(tid, endCode, whyCode)

PRI traceSkip(tid, seg, side, causeCode, motorIncre, reqMode, rampInc, whyCode)
' Emit a wheel trace that did not run: its header (offsets from cpWantNeg / cpWantPos) and an empty end
' whose why names the cause, so the analyser sees every planned trace.
'
' @param tid - trace id
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param causeCode - CAUSE_* the trace would have done
' @param motorIncre - signed increment
' @param reqMode - MODE_* requested
' @param rampInc - ramp_inc read back
' @param whyCode - WHY_* naming why it did not run

    emitTrace(tid, seg, side, causeCode, motorIncre, cpWantNeg, cpWantPos, reqMode, rampInc, WHY_NONE)
    traceEmptyEnd(tid, TEND_ABORT, whyCode)

PRI traceEmitCapture(seg, side, tid, causeCode, motorIncre, reqMode, rampInc) | slotIdx, otherIdx
' Finish a wheel trace's capture. First every side effect the trial created is undone and read back
' (I11: offsets with BM-OFFREST, the e-stop, the brake request, I6); only then BM-TRACE, and BM-TS /
' BM-TRACE-END from the frozen ring, folded into R14-DUAL-TRACES-* and R14-DUAL-IDLEFLT-A. An unfrozen
' capture is never drained (I10): its end is empty with why from cpWhy.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param tid - trace id
' @param causeCode - CAUSE_* done
' @param motorIncre - signed increment
' @param reqMode - MODE_* requested
' @param rampInc - ramp_inc read back
'
' @local slotIdx - motor slot
' @local otherIdx - the idle motor slot

    slotIdx := side - SIDE_LEFT
    otherIdx := SLOT_RIGHT - slotIdx
    if bCpOffWritten and (bCpOffRestored == FALSE)
        restoreOffsets(side, cpWantNeg, cpWantPos)
        bCpOffRestored := TRUE
    if bCpEstopSet
        restoreEmergency(side)
        bCpEstopSet := FALSE
    if bBrakeRequested[slotIdx]
        restoreStopMode(side)
    emitTrace(tid, seg, side, causeCode, motorIncre, cpWantNeg, cpWantPos, reqMode, rampInc, cpWhy)
    if bCpFrozen
        traceDrain(tid, slotIdx, otherIdx, cpEnd)
        foldIdleWheel(slotIdx, captureIdleUp(otherIdx))
    else
        traceEmptyEnd(tid, cpEnd, (cpWhy == WHY_NONE) ? WHY_INST_NOACK : cpWhy)

PRI traceRecover(seg, side, tid, motorIncre, coolMs) : rstCode, rstMs | slotIdx, uncBefore, startMs, bFaultNow, bCleared
' Close a wheel trial after its restores and records (sec 4.2): when a fault was seen, or the fault flag
' is set now, recover it (testResetFault() alone, then restart, then retire) and cool coolMs; then zero
' and wait stopped.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param tid - trace id of the trial
' @param motorIncre - the trial's command
' @param coolMs - cool-down after a fault
' @returns rstCode - RST_NONE (no fault), RST_RESET, RST_RESTART or RST_FAILED
' @returns rstMs - ms the recovery took, cool-down excluded
'
' @local slotIdx - motor slot
' @local uncBefore - R14-DUAL-RSTPROV count before the recovery (a change means step 2 did not clear)
' @local startMs - getms() before the recovery
' @local bFaultNow - the fault flag after the restores
' @local bCleared - recoverFault()'s result

    slotIdx := side - SIDE_LEFT
    rstCode := RST_NONE
    rstMs := 0
    bFaultNow := FALSE
    if wheelIsUp(side)
        _, _, bFaultNow := wheelClearedState(side)
    if bCpFaultSeen or (bFaultNow <> FALSE)
        uncBefore := sfResetUncleared[slotIdx]
        startMs := getms()
        bCleared := recoverFault(seg, tid, side, motorIncre, 0)
        rstMs := getms() - startMs
        if bCleared == FALSE
            rstCode := RST_FAILED
        elseif sfResetUncleared[slotIdx] == uncBefore
            rstCode := RST_RESET
        else
            rstCode := RST_RESTART
        waitBeat(coolMs, CP_LOOP_COOL)
    zeroAndWaitStopped(side)

CON { --- wheel and steering wrappers: every library call is bracketed by beat(CP_LIB_*) --- }

PRI wheelStart(seg, side) : bStarted | slotIdx, cogValue, startMs, restMs, nMissed, nIllegal
' Start one wheel alone and record its lifetime: refuse unless the instrument is IDLE or FROZEN (I10);
' stop the steering object and both wheels first (I6, shared pin claims PL-18); keep starts at least
' START_SPACING_MS apart; start with board detection never forced (I12); wait ready; read the cog,
' board, offsets and integrity counts; take this lifetime's floated zero-command sense mean through
' the instrument; emit BM-START. A retired motor is not started.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bStarted - TRUE when the cog is valid and the driver reported ready
'
' @local slotIdx - motor slot
' @local cogValue - testGetMotorCog() after the start
' @local startMs - getms() after start(), for the ready wait
' @local restMs - spacing still owed before this start
' @local nMissed - missed transitions at start
' @local nIllegal - illegal codes at start

    slotIdx := side - SIDE_LEFT
    bStarted := FALSE
    stWhy := WHY_NONE
    if instQuiet() == FALSE
        instRefused(seg)
        stWhy := WHY_INST_BUSY
    elseif bSlotRetired[slotIdx]
        stWhy := WHY_MOTOR_RETIRED
    else
        steerStop()
        wheelStopRaw(SIDE_LEFT)
        wheelStopRaw(SIDE_RIGHT)
        restMs := START_SPACING_MS - (getms() - lastStartMs)
        if bAnyStart and (restMs > 0)
            waitBeat(restMs, CP_LOOP_REST)
        beat(CP_LIB_START)
        if side == SIDE_RIGHT
            stCogRet := wheelR.start(RIGHT_TEST_BASE, TEST_VOLTAGE, TEST_DET_MODE)
        else
            stCogRet := wheelL.start(LEFT_TEST_BASE, TEST_VOLTAGE, TEST_DET_MODE)
        beat(CP_LIB_START)
        lastStartMs := getms()
        bAnyStart := TRUE
        lifeSeq := (lifeSeq + 1) <# LIM_SMALL
        slotLife[slotIdx] := lifeSeq
        bBrakeRequested[slotIdx] := FALSE                   ' init() sets SM_FLOAT
        startMs := getms()
        repeat
            bStReady := wheelIsReady(side)
            if bStReady or ((getms() - startMs) >= READY_TIMEOUT_MS)
                quit
            beat(CP_LOOP_READY)
            waitms(SAMPLE_MS)
        stReadyMs := getms() - startMs
        beat(CP_LIB_QUERY)
        if side == SIDE_RIGHT
            cogValue := wheelR.testGetMotorCog()
            stBoard := wheelR.getBoardType()
            nMissed, nIllegal := wheelR.getHallIntegrityCounts()
        else
            cogValue := wheelL.testGetMotorCog()
            stBoard := wheelL.getBoardType()
            nMissed, nIllegal := wheelL.getHallIntegrityCounts()
        beat(CP_LIB_QUERY)
        stOffNeg, stOffPos := wheelGetOffsets(side)
        stMissed := nMissed
        stIllegal := nIllegal
        bStCogOk := (stCogRet >= 0) and (stCogRet <= MAX_COG_ID) and (stCogRet == cogValue - 1)
        bStarted := bStCogOk and bStReady
        sfStarts[slotIdx] := (sfStarts[slotIdx] + 1) <# LIM_BIG
        if stBoard <> wheelL.REV_B
            sfNotRevb[slotIdx] := (sfNotRevb[slotIdx] + 1) <# LIM_BIG
        foldIntegrity(slotIdx, nMissed, nIllegal)
        bLifeZeroValid[slotIdx] := FALSE
        if bStarted
            stWhy := lifetimeZero(side)
        else
            stWhy := WHY_NO_COG
        emitStart(seg, side)

PRI lifetimeZero(side) : whyCode | slotIdx, winStartTotal, winEndTotal
' Take this driver lifetime's floated zero-command sense_i and phase-sum means: ZERO_WINDOW_MS through
' the instrument (no getter in a timed wait, sec 2.8), valid only within this lifetime (PL-32). The
' window is delimited by two instrument-recorded ring totals (sec 12.7).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns whyCode - WHY_NONE, or the cause of the missing zero
'
' @local slotIdx - motor slot
' @local winStartTotal - ring total at the window start
' @local winEndTotal - ring total at the window end

    slotIdx := side - SIDE_LEFT
    whyCode := WHY_INST_NOACK
    if instArm(INST_SRC_WHEELS, 1)
        winStartTotal := instMarkIndex()
        waitWatched(side, ZERO_WINDOW_MS, CP_LOOP_ZERO, UNTIL_TIME)
        winEndTotal := instMarkIndex()
        if instFreeze(0)
            windowStats(slotIdx, SLOT_RIGHT - slotIdx, winStartTotal, winEndTotal)
            if rsN > 0
                lifeZeroX10[slotIdx] := rsIMeanX10
                lifePhX10[slotIdx] := rsPhMeanX10
                bLifeZeroValid[slotIdx] := TRUE
                whyCode := WHY_NONE
            else
                whyCode := WHY_NO_SAMPLES
        instIdle()

PRI instRefused(seg)
' Record a wrapper refusal because the instrument had not acknowledged IDLE or FROZEN (I10).
'
' @param seg - SEG_* in progress

    instBusyRefusals := (instBusyRefusals + 1) <# LIM_BIG
    emitSeg(seg, SEGEV_SKIP, segAttended(seg), 0, 0, 0, 0, WHY_INST_BUSY)

PRI wheelStop(side)
' Stop one wheel. The instrument is first returned to IDLE (I10). A stop is never refused: if the
' instrument does not acknowledge, the refusal is recorded and the wheel is stopped anyway, because
' stopping is the safe direction and a straddled sample is gated by up (I3).
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    if instQuiet() == FALSE
        instIdle()
        if instQuiet() == FALSE
            instRefused(curSeg)
    wheelStopRaw(side)

PRI wheelStopRaw(side)
' stop() one wheel (cogstop + pinclear, which floats it) and forget any brake request (I6).
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    beat(CP_LIB_STOP)
    if side == SIDE_RIGHT
        wheelR.stop()
    else
        wheelL.stop()
    beat(CP_LIB_STOP)
    bBrakeRequested[side - SIDE_LEFT] := FALSE

PRI wheelCommand(side, motorIncre) | safeIncre
' Command one wheel's raw increment. Nothing above LADDER_MAX_INCRE is ever sent.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
'
' @local safeIncre - the increment actually sent

    safeIncre := motorIncre
    if abs(motorIncre) > LADDER_MAX_INCRE
        safeIncre := 0
    curIncre := safeIncre
    beat(CP_LIB_COMMAND)
    if side == SIDE_RIGHT
        wheelR.testDriveAtMotorIncrement(safeIncre)
    else
        wheelL.testDriveAtMotorIncrement(safeIncre)
    beat(CP_LIB_COMMAND)

PRI wheelHold(side, bBrake)
' Request BRAKE or FLOAT at stop on the wheel under test only (I6); every exit path of a BRAKE trial
' calls restoreStopMode() before the next command.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param bBrake - TRUE for holdAtStop(TRUE)

    beat(CP_LIB_HOLD)
    if side == SIDE_RIGHT
        wheelR.holdAtStop(bBrake)
    else
        wheelL.holdAtStop(bBrake)
    beat(CP_LIB_HOLD)
    bBrakeRequested[side - SIDE_LEFT] := (bBrake <> FALSE)

PRI wheelIsReady(side) : bReady
' isReady() of one wheel.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bReady - TRUE when its driver reports a state

    beat(CP_LIB_QUERY)
    bReady := (side == SIDE_RIGHT) ? wheelR.isReady() : wheelL.isReady()
    beat(CP_LIB_QUERY)

PRI wheelGetOffsets(side) : offNeg, offPos
' Read back the applied commutation offsets (logged beside every wheel measurement).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns offNeg - offset_fwd degrees (negative increments)
' @returns offPos - offset_rev degrees (positive increments)

    beat(CP_LIB_OFFSETS)
    if side == SIDE_RIGHT
        offNeg, offPos := wheelR.testGetFwdRevIndep()
    else
        offNeg, offPos := wheelL.testGetFwdRevIndep()
    beat(CP_LIB_OFFSETS)

PRI wheelIntegrity(side) : nMissed, nIllegal
' Hall integrity counts of one wheel since its start.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns nMissed - missed transitions
' @returns nIllegal - illegal codes

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        nMissed, nIllegal := wheelR.getHallIntegrityCounts()
    else
        nMissed, nIllegal := wheelL.getHallIntegrityCounts()
    beat(CP_LIB_QUERY)

PRI wheelClearedState(side) : bCleared, eDrvrState, bFaultSig
' Recovery's cleared test (design sec 4.2): isStopped() AND NOT isFaultSignal().
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bCleared - stopped and not faulted
' @returns eDrvrState - DCS_* now
' @returns bFaultSig - the fault flag now

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        bCleared := wheelR.isStopped()
        bFaultSig := wheelR.isFaultSignal()
        eDrvrState := wheelR.getDriverState()
    else
        bCleared := wheelL.isStopped()
        bFaultSig := wheelL.isFaultSignal()
        eDrvrState := wheelL.getDriverState()
    beat(CP_LIB_QUERY)
    bCleared := (bCleared <> FALSE) and (bFaultSig == FALSE)

PRI wheelIsUp(side) : bUp
' Report whether a wheel's driver cog is running (testGetMotorCog() <> 0, the I3 gate).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bUp - TRUE when the driver cog runs

    beat(CP_LIB_QUERY)
    bUp := ((side == SIDE_RIGHT) ? wheelR.testGetMotorCog() : wheelL.testGetMotorCog()) <> 0
    beat(CP_LIB_QUERY)

PRI wheelStopMotor(side)
' stopMotor() one wheel: the zero command, under whatever stop mode was requested.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    curIncre := 0
    beat(CP_LIB_COMMAND)
    if side == SIDE_RIGHT
        wheelR.stopMotor()
    else
        wheelL.stopMotor()
    beat(CP_LIB_COMMAND)

PRI wheelEstop(side)
' emergencyCutoff() one wheel. Every caller clears it with restoreEmergency() after its freeze (I11).
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    curIncre := 0
    beat(CP_LIB_ESTOP)
    if side == SIDE_RIGHT
        wheelR.emergencyCutoff()
    else
        wheelL.emergencyCutoff()
    beat(CP_LIB_ESTOP)

PRI wheelRampInc(side) : incRamp
' Read back one wheel's ramp_inc.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns incRamp - ramp_inc read back

    beat(CP_LIB_RAMP)
    if side == SIDE_RIGHT
        _, _, incRamp, _ := wheelR.getRampingValues()
    else
        _, _, incRamp, _ := wheelL.getRampingValues()
    beat(CP_LIB_RAMP)

PRI wheelSetRamp(side, incWant) : incReadBack
' Set a FAULTB trial's ramp (the defaults with ramp_inc replaced) and read ramp_inc back. Every caller
' restores the defaults with restoreRamp() after its freeze (I11).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param incWant - the trial's ramp_inc
' @returns incReadBack - ramp_inc read back

    beat(CP_LIB_RAMP)
    if side == SIDE_RIGHT
        wheelR.setRampingValues(RAMP_DEF_MIN, RAMP_DEF_MAX, incWant, RAMP_DEF_DOWN)
        _, _, incReadBack, _ := wheelR.getRampingValues()
    else
        wheelL.setRampingValues(RAMP_DEF_MIN, RAMP_DEF_MAX, incWant, RAMP_DEF_DOWN)
        _, _, incReadBack, _ := wheelL.getRampingValues()
    beat(CP_LIB_RAMP)

PRI wheelSetOffsets(side, negDegrees, posDegrees)
' Write one wheel's commutation offsets (POSTFLT's fault-provoking write). The pair read before it is
' restored and read back with restoreOffsets() on every exit path (I11).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param negDegrees - offset_fwd degrees (negative increments)
' @param posDegrees - offset_rev degrees (positive increments)

    beat(CP_LIB_OFFSETS)
    if side == SIDE_RIGHT
        wheelR.testSetFwdRevIndep(negDegrees, posDegrees)
    else
        wheelL.testSetFwdRevIndep(negDegrees, posDegrees)
    beat(CP_LIB_OFFSETS)

PRI wheelCurrent(side) : ampsX10k
' getCurrent() of one wheel (debug-free, the only library call inside a ladder window).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns ampsX10k - motor current, A x 10_000

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        ampsX10k, _ := wheelR.getCurrent()
    else
        ampsX10k, _ := wheelL.getCurrent()
    beat(CP_LIB_QUERY)

PRI wheelDriveConstants(side) : deadGap, dutyMax, adcFrame, frameCnt
' The drive constants init() derived for one wheel (testGetDriveConstants()).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns deadGap - dead_gap, system ticks
' @returns dutyMax - duty_max, 1/16ths
' @returns adcFrame - adc_fram
' @returns frameCnt - frame_cnt

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        deadGap, _, _, dutyMax, adcFrame, frameCnt := wheelR.testGetDriveConstants()
    else
        deadGap, _, _, dutyMax, adcFrame, frameCnt := wheelL.testGetDriveConstants()
    beat(CP_LIB_QUERY)

PRI wheelStartSense(side)
' startSenseCog() for one wheel (LIVE: testGetRpm() needs it). Its debug is compiled out in the quiet
' build (I5), and the wheel's stop() ends it.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    beat(CP_LIB_START)
    if side == SIDE_RIGHT
        wheelR.startSenseCog()
    else
        wheelL.startSenseCog()
    beat(CP_LIB_START)

PRI wheelRpm(side) : rpmRead
' testGetRpm() of one wheel.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns rpmRead - rpm averaged over the ~1 s window

    beat(CP_LIB_QUERY)
    rpmRead := (side == SIDE_RIGHT) ? wheelR.testGetRpm() : wheelL.testGetRpm()
    beat(CP_LIB_QUERY)

PRI zeroAndWaitStopped(side) : bStopped | bArmedHere
' Command zero to a running wheel and wait, beat-polled, for DCS_STOPPED. The mirror is current only
' while the instrument is not IDLE, so an IDLE instrument is armed for the wait and frozen after it
' (callers drain before calling this). A wheel whose driver cog is not running is left alone.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bStopped - TRUE when the mirror showed DCS_STOPPED within STOP_TIMEOUT_MS
'
' @local bArmedHere - this call armed the instrument, so it freezes it

    bStopped := FALSE
    if wheelIsUp(side)
        wheelCommand(side, 0)
        bArmedHere := FALSE
        if instQuiet() and (instState == INST_ST_IDLE)
            bArmedHere := instArm(INST_SRC_WHEELS, 1)
        _, bStopped := waitWatched(side, STOP_TIMEOUT_MS, CP_LOOP_STOPPED, UNTIL_STOPPED)
        if bArmedHere
            instFreeze(0)

PRI steerStart(seg) : bStarted | startMs, restMs, leftMissed, leftIllegal, rightMissed, rightIllegal
' Start the steering object: refuse unless the instrument is IDLE or FROZEN (I10); stop both wheel
' instances first (shared pin claims, PL-18); detection never forced (I12); wait ready; read both
' drivers' states, offsets, integrity counts and detected boards (testGetBoardTypes(), sec 12.1 Q8);
' set holdAtStop(FALSE); emit BM-SSTART. The steering start's life is the sid its records carry.
'
' @param seg - SEG_* in progress
' @returns bStarted - TRUE when start() returned a cog id and both drivers reported ready
'
' @local startMs - getms() after start(), for the ready wait
' @local restMs - spacing still owed before this start
' @local leftMissed - left missed transitions
' @local leftIllegal - left illegal codes
' @local rightMissed - right missed transitions
' @local rightIllegal - right illegal codes

    bStarted := FALSE
    ssWhy := WHY_NONE
    if instQuiet() == FALSE
        instRefused(seg)
    else
        wheelStopRaw(SIDE_LEFT)
        wheelStopRaw(SIDE_RIGHT)
        restMs := START_SPACING_MS - (getms() - lastStartMs)
        if bAnyStart and (restMs > 0)
            waitBeat(restMs, CP_LOOP_REST)
        beat(CP_LIB_STEER_START)
        ssRet := steering.start(LEFT_TEST_BASE, RIGHT_TEST_BASE, TEST_VOLTAGE, TEST_DET_MODE, TEST_DET_MODE)
        beat(CP_LIB_STEER_START)
        lastStartMs := getms()
        bAnyStart := TRUE
        lifeSeq := (lifeSeq + 1) <# LIM_SMALL
        steerLife := lifeSeq
        bSsRetOk := (ssRet >= 0) and (ssRet <= MAX_COG_ID)
        bSteerUp := (ssRet >= 0)
        startMs := getms()
        repeat
            beat(CP_LIB_STEER_QUERY)
            bStarted := steering.isReady()
            beat(CP_LIB_STEER_QUERY)
            if bStarted or ((getms() - startMs) >= READY_TIMEOUT_MS)
                quit
            beat(CP_LOOP_READY)
            waitms(SAMPLE_MS)
        ssReadyMs := getms() - startMs
        beat(CP_LIB_STEER_QUERY)
        ssLeftState, ssRightState := steering.testGetDriverState()
        ssLeftNeg, ssLeftPos := steering.testLeftGetFwdRevIndep()
        ssRightNeg, ssRightPos := steering.testRightGetFwdRevIndep()
        leftMissed, leftIllegal, rightMissed, rightIllegal := steering.getHallIntegrityCounts()
        ssLeftBoard, ssRightBoard := steering.testGetBoardTypes()
        beat(CP_LIB_STEER_QUERY)
        ssLeftIg := leftMissed + leftIllegal
        ssRightIg := rightMissed + rightIllegal
        bStarted := bSsRetOk and (bStarted <> FALSE)
        if bSteerUp
            steerHold(FALSE)
        emitSStart(seg)

PRI steerStop()
' Stop the steering object (both drivers and its sense cog), returning the instrument to IDLE first
' (I10). Like wheelStop(), never refused.

    if instQuiet() == FALSE
        instIdle()
        if instQuiet() == FALSE
            instRefused(curSeg)
    beat(CP_LIB_STEER_STOP)
    steering.stop()
    beat(CP_LIB_STEER_STOP)
    bSteerUp := FALSE

PRI steerHold(bBrake)
' holdAtStop() on both steering wheels; steering segments set FALSE at start (I6).
'
' @param bBrake - TRUE for holdAtStop(TRUE)

    beat(CP_LIB_HOLD)
    steering.holdAtStop(bBrake)
    beat(CP_LIB_HOLD)

PRI steerTrackTicks() : leftTicks, rightTicks
' The steering object's own tracking count, in hall ticks, per wheel.
'
' @returns leftTicks - left getRotationCount(DRU_HALL_TICKS)
' @returns rightTicks - right getRotationCount(DRU_HALL_TICKS)

    beat(CP_LIB_STEER_QUERY)
    leftTicks, rightTicks := steering.getRotationCount(steering.DRU_HALL_TICKS)
    beat(CP_LIB_STEER_QUERY)

PRI steerStopMotors()
' stopMotors() on the steering object (no sync wait, so no SYNC_PRECOND check is owed).

    curIncre := 0
    beat(CP_LIB_STEER_STOP)
    steering.stopMotors()
    beat(CP_LIB_STEER_STOP)

PRI steerDriveBoth(seg, tid, powerValue) : bDriven
' driveAtPower(powerValue, powerValue) on the steering object, always preceded by the SYNC_PRECOND check
' (design sec 4.3): a driver in DCS_ESTOP would hang the call's SyncStatus() wait. A failed check emits
' BM-ABORT SYNC_PRECOND and drives nothing; a stopped steering object is never driven.
'
' @param seg - SEG_* in progress
' @param tid - trace id in progress, 0 when none
' @param powerValue - power [-100..100] for both wheels
' @returns bDriven - TRUE when the drive call was made

    bDriven := FALSE
    if bSteerUp
        if steerDrivePrecondition(seg, tid)
            curIncre := 0
            beat(CP_LIB_STEER_DRIVE)
            steering.driveAtPower(powerValue, powerValue)
            beat(CP_LIB_STEER_DRIVE)
            bDriven := TRUE

PRI steerRecoverFault(tid) : whyCode | slotIdx, side, startMs, bLtFlt, bLtSig, bRtFlt, bRtSig, eLeftState, eRightState, eDrvrState, bFaultSig, bCleared, offNeg, offPos
' Recover a steering-segment fault per motor through the TEST-USE pass-throughs (sec 4.2 step 2:
' testResetFault() alone, which issues the zero command itself). The steering object has no per-wheel
' restart, so a fault reset does not clear is BM-UNRECOV MOTOR_RETIRED and ends the segment's trials.
' Folds R14-DUAL-RSTPROV-* and cools FAULT_COOL_MS after any fault.
'
' @param tid - trace id of the trial
' @returns whyCode - WHY_MOTOR_RETIRED when a fault stayed uncleared, else WHY_NONE
'
' @local slotIdx - motor slot
' @local side - SIDE_LEFT or SIDE_RIGHT
' @local startMs - getms() before the reset
' @local bLtFlt - left isFaulted()
' @local bLtSig - left isFaultSignal()
' @local bRtFlt - right isFaulted()
' @local bRtSig - right isFaultSignal()
' @local eLeftState - left driver state after the reset
' @local eRightState - right driver state after the reset
' @local eDrvrState - this motor's driver state after the reset
' @local bFaultSig - this motor's fault flag
' @local bCleared - stopped and not faulted after the reset
' @local offNeg - offset_fwd read back
' @local offPos - offset_rev read back

    whyCode := WHY_NONE
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        beat(CP_LOOP_POLL)
        side := SIDE_LEFT + slotIdx
        beat(CP_LIB_STEER_QUERY)
        bLtFlt, bLtSig, bRtFlt, bRtSig := steering.testGetFaultStatus()
        beat(CP_LIB_STEER_QUERY)
        bFaultSig := (slotIdx == SLOT_RIGHT) ? (bRtFlt or bRtSig) : (bLtFlt or bLtSig)
        if bFaultSig
            runFaults := (runFaults + 1) <# LIM_BIG
            segFaults := (segFaults + 1) <# LIM_SMALL
            sfFaults[slotIdx] := (sfFaults[slotIdx] + 1) <# LIM_BIG
            startMs := getms()
            beat(CP_LIB_RESETFAULT)
            if slotIdx == SLOT_RIGHT
                steering.testRightResetFault()
            else
                steering.testLeftResetFault()
            beat(CP_LIB_RESETFAULT)
            beat(CP_LIB_STEER_QUERY)
            eLeftState, eRightState := steering.testGetDriverState()
            bLtFlt, bLtSig, bRtFlt, bRtSig := steering.testGetFaultStatus()
            if slotIdx == SLOT_RIGHT
                offNeg, offPos := steering.testRightGetFwdRevIndep()
            else
                offNeg, offPos := steering.testLeftGetFwdRevIndep()
            beat(CP_LIB_STEER_QUERY)
            eDrvrState := (slotIdx == SLOT_RIGHT) ? eRightState : eLeftState
            bFaultSig := (slotIdx == SLOT_RIGHT) ? bRtSig : bLtSig
            bCleared := (eDrvrState == DCS_STOPPED) and (bFaultSig == FALSE)
            emitRecover(curSeg, tid, side, 0, offNeg, offPos, RSTEP_RESET, bCleared, getms() - startMs, eDrvrState, bFaultSig)
            if bCleared == FALSE
                sfResetUncleared[slotIdx] := (sfResetUncleared[slotIdx] + 1) <# LIM_BIG
                unrecovTotal := (unrecovTotal + 1) <# LIM_TINY
                segUnrecov := (segUnrecov + 1) <# LIM_TINY
                emitUnrecov(curSeg, tid, side, 0, offNeg, offPos, eDrvrState, bFaultSig, eDrvrState <> DCS_UNKNOWN)
                whyCode := WHY_MOTOR_RETIRED
            waitBeat(FAULT_COOL_MS, CP_LOOP_COOL)

PRI steerDrivePrecondition(seg, tid) : bOk | eLeftState, eRightState
' The SYNC_PRECOND construction (design sec 4.3): steering.driveAtPower() ends in an unbounded
' SyncStatus() wait that never returns while a driver sits in DCS_ESTOP, so every steering drive call
' is preceded by this check. Both drivers up and neither in DCS_ESTOP, else BM-ABORT SYNC_PRECOND and
' the caller does not call.
'
' @param seg - SEG_* in progress
' @param tid - trace id in progress, 0 when none
' @returns bOk - TRUE when the drive call may be made
'
' @local eLeftState - left driver state
' @local eRightState - right driver state

    beat(CP_LIB_STEER_QUERY)
    eLeftState, eRightState := steering.testGetDriverState()
    beat(CP_LIB_STEER_QUERY)
    bOk := (eLeftState <> DCS_UNKNOWN) and (eRightState <> DCS_UNKNOWN) and (eLeftState <> DCS_ESTOP) and (eRightState <> DCS_ESTOP)
    if bOk == FALSE
        emitAbort(seg, tid, SIDE_BOTH, 0, ABR_SYNC_PRECOND, (eLeftState * X10) + eRightState, SCOPE_TRIAL)

PRI shutdownAll()
' Stop the steering object and both wheels unconditionally at run end. stop() on a never-started
' instance touches no pin.

    beat(CP_LIB_STOP)
    steering.stop()
    wheelL.stop()
    wheelR.stop()
    beat(CP_LIB_STOP)
    bSteerUp := FALSE

CON { --- recovery policy (design sec 4.2) and side-effect restores (I11) --- }

PRI recoverFault(seg, tid, side, motorIncre, coolMs) : bCleared | slotIdx, startMs, offNeg, offPos, eDrvrState, bFaultSig, bUp
' Recover a faulted wheel in-session. Step 2: testResetFault() alone (it issues the zero command
' itself). Step 3, if not cleared: stop, rest RESTART_REST_MS, start, wait ready. Step 4, if still not
' cleared: BM-UNRECOV MOTOR_RETIRED; that motor's remaining trials in this load are skipped; the run
' continues. Then the cool-down, beat-polled. Callers restore every trial side effect BEFORE calling.
'
' @param seg - SEG_* in progress
' @param tid - trace id of the faulted trial, 0 when none
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - the faulted command
' @param coolMs - FAULT_COOL_MS, or FAULT_TRIAL_COOL_MS for FAULTB
' @returns bCleared - TRUE when step 2 or step 3 cleared the fault
'
' @local slotIdx - motor slot
' @local startMs - getms() at the start of a step
' @local offNeg - offset_fwd read back
' @local offPos - offset_rev read back
' @local eDrvrState - driver state after a step
' @local bFaultSig - fault flag after a step
' @local bUp - the restart's start succeeded

    slotIdx := side - SIDE_LEFT
    runFaults := (runFaults + 1) <# LIM_BIG
    segFaults := (segFaults + 1) <# LIM_SMALL
    sfFaults[slotIdx] := (sfFaults[slotIdx] + 1) <# LIM_BIG
    startMs := getms()
    beat(CP_LIB_RESETFAULT)
    if side == SIDE_RIGHT
        wheelR.testResetFault()
    else
        wheelL.testResetFault()
    beat(CP_LIB_RESETFAULT)
    bCleared, eDrvrState, bFaultSig := wheelClearedState(side)
    offNeg, offPos := wheelGetOffsets(side)
    emitRecover(seg, tid, side, motorIncre, offNeg, offPos, RSTEP_RESET, bCleared, getms() - startMs, eDrvrState, bFaultSig)
    if bCleared == FALSE
        sfResetUncleared[slotIdx] := (sfResetUncleared[slotIdx] + 1) <# LIM_BIG
        startMs := getms()
        wheelStop(side)
        waitBeat(RESTART_REST_MS, CP_LOOP_REST)
        bUp := wheelStart(seg, side)
        bCleared, eDrvrState, bFaultSig := wheelClearedState(side)
        bCleared := bCleared and bUp
        offNeg, offPos := wheelGetOffsets(side)
        emitRecover(seg, tid, side, motorIncre, offNeg, offPos, RSTEP_RESTART, bCleared, getms() - startMs, eDrvrState, bFaultSig)
        if bCleared == FALSE
            bSlotRetired[slotIdx] := TRUE
            unrecovTotal := (unrecovTotal + 1) <# LIM_TINY
            segUnrecov := (segUnrecov + 1) <# LIM_TINY
            emitUnrecov(seg, tid, side, motorIncre, offNeg, offPos, eDrvrState, bFaultSig, bUp)
            wheelStop(side)
    waitBeat(coolMs, CP_LOOP_COOL)

PRI restoreRamp(side) : bOk | minRamp, maxRamp, incRamp, downRamp
' Restore the ramp defaults, read them back and emit BM-RAMPREST (I11). The last read-back of each
' motor is R14-DUAL-RAMPREST-B's measurement.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bOk - TRUE when 1_500 / 200_000 / 22 / 50_000 read back
'
' @local minRamp - ramp_min read back
' @local maxRamp - ramp_max read back
' @local incRamp - ramp_inc read back
' @local downRamp - ramp_down read back

    beat(CP_LIB_RAMP)
    if side == SIDE_RIGHT
        wheelR.setRampingValues(RAMP_DEF_MIN, RAMP_DEF_MAX, RAMP_DEF_INC, RAMP_DEF_DOWN)
        minRamp, maxRamp, incRamp, downRamp := wheelR.getRampingValues()
    else
        wheelL.setRampingValues(RAMP_DEF_MIN, RAMP_DEF_MAX, RAMP_DEF_INC, RAMP_DEF_DOWN)
        minRamp, maxRamp, incRamp, downRamp := wheelL.getRampingValues()
    beat(CP_LIB_RAMP)
    bOk := (minRamp == RAMP_DEF_MIN) and (maxRamp == RAMP_DEF_MAX) and (incRamp == RAMP_DEF_INC) and (downRamp == RAMP_DEF_DOWN)
    bSfRampRan[side - SIDE_LEFT] := TRUE
    bSfRampOk[side - SIDE_LEFT] := bOk
    emitRampRest(side, minRamp, maxRamp, incRamp, downRamp, bOk)

PRI restoreOffsets(side, wantNeg, wantPos) : bOk | offNeg, offPos
' Restore the offsets read at the trial's start, read them back and emit BM-OFFREST (I11). Every
' read-back of a motor is ANDed into R14-DUAL-OFFREST-C.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param wantNeg - offset_fwd degrees to restore
' @param wantPos - offset_rev degrees to restore
' @returns bOk - TRUE when both read back equal
'
' @local offNeg - offset_fwd read back
' @local offPos - offset_rev read back

    beat(CP_LIB_OFFSETS)
    if side == SIDE_RIGHT
        wheelR.testSetFwdRevIndep(wantNeg, wantPos)
    else
        wheelL.testSetFwdRevIndep(wantNeg, wantPos)
    beat(CP_LIB_OFFSETS)
    offNeg, offPos := wheelGetOffsets(side)
    bOk := (offNeg == wantNeg) and (offPos == wantPos)
    bSfOffRan[side - SIDE_LEFT] := TRUE
    bSfOffOk[side - SIDE_LEFT] := (bSfOffOk[side - SIDE_LEFT] <> FALSE) and bOk
    emitOffRest(side, wantNeg, wantPos, offNeg, offPos, bOk)

PRI restoreStopMode(side)
' Return the wheel under test to FLOAT at stop (I6, I11). The library has no stop-mode getter, so this
' restore cannot be read back; bBrakeRequested records that it was issued.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    wheelHold(side, FALSE)

PRI restoreEmergency(side)
' Clear an e-stop issued by a trial (I11). The library has no e_stop getter; the driver state leaving
' DCS_ESTOP on a later instrument sample is the evidence.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    beat(CP_LIB_ESTOP)
    if side == SIDE_RIGHT
        wheelR.clearEmergency()
    else
        wheelL.clearEmergency()
    beat(CP_LIB_ESTOP)

CON { --- record emission, cog 0 (design sec 3). Byte counts: each field is 2 + len(name) + width --- }

PRI recBegin(pTag)
' Start a BM- record: tag first, then the run-wide seq (I8).
'
' @param pTag - pointer to the record tag

    benchLog.begin(pTag)
    logSeq := (logSeq + 1) <# LIM_MID
    benchLog.numField(@"seq", logSeq, LIM_MID)

PRI emitRecord() | pRecord
' Emit the assembled record: the one cog-0 debug() statement in this file, bracketed by CP_EMIT.
'
' @local pRecord - pointer to the zero-terminated record

    pRecord := benchLog.pLine()
    beat(CP_EMIT)
    debug(zstr_(pRecord))
    beat(CP_EMIT)

PRI tokenAt(pTable, tokenCount, tokenIdx) : pTok | skipCount
' Look up a token in a packed zero-separated DAT table; an index outside the table returns "?".
' Reads only DAT, so it is safe from any cog.
'
' @param pTable - pointer to the packed table
' @param tokenCount - tokens in the table
' @param tokenIdx - 0-based token index
' @returns pTok - pointer to the token text
'
' @local skipCount - bytes skipped inside one token (bounded)

    pTok := @sUnknownTok
    if (tokenIdx >= 0) and (tokenIdx < tokenCount)
        pTok := pTable
        repeat tokenIdx
            repeat skipCount from 0 to TOKEN_SCAN_MAX
                if BYTE[pTok] == 0
                    quit
                pTok += 1
            pTok += 1

PRI whyField(whyCode)
' Append the why field (always last in a measurement record).
'
' @param whyCode - WHY_* value

    benchLog.tokenField(@"why", tokenAt(@tokWhy, WHY_COUNT, whyCode), TOKMAX_WHY)

PRI sideToken(side) : pTok
' Motor token for a side.
'
' @param side - SIDE_* value
' @returns pTok - NONE, LEFT, RIGHT or BOTH

    pTok := tokenAt(@tokSide, SIDE_BOTH + 1, side)

PRI segToken(seg) : pTok
' Segment token.
'
' @param seg - SEG_* value
' @returns pTok - segment token

    pTok := tokenAt(@tokSeg, SEG_COUNT, seg)

PRI dcsToken(eDrvrState) : pTok
' Driver-state token.
'
' @param eDrvrState - DCS_* value
' @returns pTok - state token, "?" outside 0..7

    pTok := tokenAt(@tokDcs, DCS_MAX + 1, eDrvrState)

PRI boardToken(eBoardRev) : pTok
' Board-revision token.
'
' @param eBoardRev - REV_* value
' @returns pTok - REV_A, REV_B or UNKNOWN

    if eBoardRev == wheelL.REV_A
        pTok := @sBoardRevA
    elseif eBoardRev == wheelL.REV_B
        pTok := @sBoardRevB
    else
        pTok := @sBoardUnknown

PRI statusToken(eStatus) : pTok
' getStatus() token for BM-OUT.
'
' @param eStatus - DS_* value
' @returns pTok - MOVING, HOLDING, OFF or UNKNOWN

    if eStatus == wheelL.DS_MOVING
        pTok := tokenAt(@tokStat, STAT_COUNT, STAT_MOVING)
    elseif eStatus == wheelL.DS_HOLDING
        pTok := tokenAt(@tokStat, STAT_COUNT, STAT_HOLDING)
    elseif eStatus == wheelL.DS_OFF
        pTok := tokenAt(@tokStat, STAT_COUNT, STAT_OFF)
    else
        pTok := tokenAt(@tokStat, STAT_COUNT, STAT_UNKNOWN)

PRI emitHeaderRecords() | orderIdx
' Emit the header before anything moves: BM-BANNER, BM-BUILD, one SIGNOFF-DECL per judged cell, one
' BM-PLAN per segment of this part, the BM-LADDER table when the part ladders, and the panic line.
'
' @local orderIdx - rung index

    emitBanner()
    emitBuild()
    emitSignoffDecls()
    case PART_ID
        PART_A:
            emitPlan(SEG_PREFLT, 1)
            emitPlan(SEG_STOPMODE, 2)
            emitPlan(SEG_LIVE, 3)
            emitPlan(SEG_LADDER, 4)
        PART_CLOCK:
            emitPlan(SEG_PREFLT, 1)
            emitPlan(SEG_CLOCK, 2)
        PART_B:
            emitPlan(SEG_PREFLT, 1)
            emitPlan(SEG_FAULTB, 2)
            emitPlan(SEG_OVERSHT, 3)
        PART_BRAKE:
            emitPlan(SEG_OUTSIDE, 1)
        PART_C:
            emitPlan(SEG_PREFLT, 1)
            emitPlan(SEG_BASELINE, 2)
            emitPlan(SEG_POSTFLT, 3)
        PART_FLOOR:
            emitPlan(SEG_FLOOR, 1)
        PART_UICHECK:
            emitPlan(SEG_UICHECK, 1)
    if PART_ID == PART_A
        repeat orderIdx from 0 to LADDER_RUNGS - 1
            emitLadder(orderIdx)
    beat(CP_EMIT)
    debug(zstr_(@sPanicLine))
    beat(CP_EMIT)

PRI emitWdStart(bStarted, cogIdRead)
' BM-WDSTART: whether the watchdog cog started. Worst case 48 bytes.
'
' @param bStarted - TRUE when cogspin() returned a cog id
' @param cogIdRead - cogspin()'s raw return

    recBegin(@"BM-WDSTART")
    benchLog.boolField(@"started", bStarted)
    benchLog.numField(@"cog", cogIdRead, LIM_TINY)
    emitRecord()

PRI emitBanner()
' BM-BANNER. part and cfg_id come from #ifdef-selected constants; quiet, mdbg and sdbg print the
' compiled masks. Worst case 241 bytes (design sec 3.2's 256 less the removed cables field, 2+6+7).

    recBegin(@"BM-BANNER")
    benchLog.numField(@"src_rev", SRC_REV, LIM_SMALL)
    benchLog.numField(@"fmt", FMT_VERSION, LIM_SMALL)
    benchLog.tokenField(@"part", tokenAt(@tokPart, PART_COUNT, PART_ID), TOKMAX_PART)
#ifdef BENCH_CFG
    benchLog.tokenField(@"cfg_id", @sCfgBench, TOKMAX_CFG)
#else
    benchLog.tokenField(@"cfg_id", @sCfgUser, TOKMAX_CFG)
#endif
    benchLog.tokenField(@"frame", @sFrameMotor, TOKMAX_FRAME)
    benchLog.numField(@"clkfreq", CLKFREQ, LIM_BIG)
    benchLog.numField(@"left_base", LEFT_TEST_BASE, LIM_SMALL)
    benchLog.numField(@"right_base", RIGHT_TEST_BASE, LIM_SMALL)
    benchLog.numField(@"voltage_enum", TEST_VOLTAGE, LIM_SMALL)
    benchLog.numField(@"det_mode", TEST_DET_MODE, LIM_SMALL)
    benchLog.numField(@"motor_type", user.MOTOR_TYPE, LIM_SMALL)
    benchLog.boolField(@"quiet", bQuietMasks)
    benchLog.numField(@"mdbg", user.MOTOR_DBG_MASK, LIM_SMALL)
    benchLog.numField(@"sdbg", user.STEER_DBG_MASK, LIM_SMALL)
    emitRecord()

PRI emitBuild()
' BM-BUILD: the compiled instrument, limits and C-6 constants. Worst case 237 bytes.

    recBegin(@"BM-BUILD")
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.numField(@"inst_hz", INST_RATE_HZ, LIM_SMALL)
    benchLog.numField(@"inst_ticks", INST_PERIOD_TICKS, LIM_BIG)
    benchLog.numField(@"ring", INST_RING_SAMPLES, LIM_SMALL)
    benchLog.numField(@"slongs", INST_SAMPLE_LONGS, LIM_TINY)
    benchLog.numField(@"waitms_max", WAITMS_MAX_MS, LIM_SMALL)
    benchLog.numField(@"wd_stall_ms", WD_STALL_MS, LIM_SMALL)
    benchLog.numField(@"abs_abort_mV", ABS_ABORT_MV, LIM_SMALL)
    benchLog.numField(@"ladder_max", LADDER_MAX_INCRE, LIM_BIG)
    benchLog.numField(@"rwire_mohm", RWIRE_MOHM, LIM_SMALL)
    benchLog.numField(@"pack_mV", PACK_MV, LIM_SMALL)
    benchLog.numField(@"fault_cool_ms", FAULT_COOL_MS, LIM_SMALL)
    emitRecord()

PRI emitInst(eventCode, ackMs, bAckValid, whyCode)
' BM-INST: instrument lifecycle event with its run-wide counters. Worst case 198 bytes.
'
' @param eventCode - INST_EV_* value
' @param ackMs - ms the acknowledged command took
' @param bAckValid - TRUE when ackMs is a measurement
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-INST")
    benchLog.tokenField(@"event", tokenAt(@tokInstEv, INST_EV_COUNT, eventCode), TOKMAX_INSTEV)
    benchLog.naNumField(@"cog", instCogId, LIM_TINY, instCogId >= 0)
    benchLog.tokenField(@"state", tokenAt(@tokInstSt, INST_ST_COUNT, instState), TOKMAX_INSTST)
    benchLog.naNumField(@"ack_ms", ackMs, LIM_SMALL, bAckValid)
    benchLog.numField(@"samples", instRunSamples, LIM_BIG)
    benchLog.numField(@"late", instRunLate, LIM_BIG)
    benchLog.numField(@"skipped", instRunSkipped, LIM_BIG)
    benchLog.numField(@"max_late_us", instRunMaxLateTicks / TICKS_PER_US, LIM_MID)
    benchLog.numField(@"clamps", instRunClamps, LIM_MID)
    whyField(whyCode)
    emitRecord()

PRI emitPlan(seg, orderIdx) | bAttended, estS, estKb
' BM-PLAN: one segment of this load, its findings and its planned size (sec 12.4 est_kb).
' Worst case: 117 + est_kb(2+6+7=15) = 132 bytes.
'
' @param seg - SEG_* value
' @param orderIdx - 1-based position in this load
'
' @local bAttended - the segment needs a person
' @local estS - planned seconds (design sec 4.4)
' @local estKb - worst-case log KB: traces x (TRACE_EMIT_MAX x 241 B + headers) plus records

    bAttended := segAttended(seg)
    estS := lookupz(seg: 0, 5, 540, 60, 240, 60, 420, 120, 120, 120, 120, 180, 120, 600)
    estKb := lookupz(seg: 0, 2, 4_700, 3, 45, 8, 1_960, 400, 130, 16, 790, 1_180, 100, 10)
    recBegin(@"BM-PLAN")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"order", orderIdx, LIM_TINY)
    benchLog.boolField(@"attended", bAttended)
    benchLog.tokenField(@"part", tokenAt(@tokPart, PART_COUNT, PART_ID), TOKMAX_PART)
    benchLog.tokenField(@"finds", tokenAt(@tokFinds, SEG_COUNT, seg), TOKMAX_FINDS)
    benchLog.numField(@"est_s", estS, LIM_SMALL)
    benchLog.numField(@"est_kb", estKb, LIM_SMALL)
    emitRecord()

PRI emitLadder(rungIdx) | motorIncre
' BM-LADDER: one row of the LADDER table. Worst case 85 bytes.
'
' @param rungIdx - 0-based rung
'
' @local motorIncre - the rung's increment

    motorIncre := ladderIncre[rungIdx]
    recBegin(@"BM-LADDER")
    benchLog.numField(@"rung", rungIdx, LIM_TINY)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"pred_x10", predictX10(motorIncre), LIM_MID)
    benchLog.boolField(@"probe", rungIdx >= LADDER_BASE_RUNGS)
    emitRecord()

PRI emitStart(seg, side) | slotIdx, bZero
' BM-START from the st* staging and this lifetime's zero. Worst case 264 bytes.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
'
' @local slotIdx - motor slot
' @local bZero - the lifetime zero is a measurement

    slotIdx := side - SIDE_LEFT
    bZero := bLifeZeroValid[slotIdx] <> FALSE
    recBegin(@"BM-START")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"life", slotLife[slotIdx], LIM_SMALL)
    benchLog.numField(@"cog_ret", stCogRet, LIM_TINY)
    benchLog.boolField(@"cog_ok", bStCogOk)
    benchLog.tokenField(@"board", boardToken(stBoard), TOKMAX_BOARD)
    benchLog.numField(@"board_enum", stBoard, LIM_TINY)
    benchLog.boolField(@"ready", bStReady)
    benchLog.numField(@"ready_ms", stReadyMs, LIM_SMALL)
    benchLog.numField(@"off_neg", stOffNeg, LIM_TINY)
    benchLog.numField(@"off_pos", stOffPos, LIM_TINY)
    benchLog.numField(@"missed", stMissed, LIM_SMALL)
    benchLog.numField(@"illegal", stIllegal, LIM_SMALL)
    benchLog.naNumField(@"zero_x10", lifeZeroX10[slotIdx], LIM_MID, bZero)
    benchLog.naNumField(@"ph_x10", lifePhX10[slotIdx], LIM_MID, bZero)
    whyField(bZero ? WHY_NONE : stWhy)
    emitRecord()

PRI emitSStart(seg)
' BM-SSTART from the ss* staging (sec 12.1 Q8: l_board / r_board replace board NA).
' Worst case: tag(9) + seq(15) + seg(13) + life(13) + motor(12) + ret(9) + ret_ok(13) + l_st(16) +
' r_st(16) + ready_ms(17) + l_neg(11) + l_pos(11) + r_neg(11) + r_pos(11) + l_ig(13) + r_ig(13) +
' l_board(16) + r_board(16) + why(23) = 258 bytes.
'
' @param seg - SEG_* in progress

    recBegin(@"BM-SSTART")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"life", steerLife, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(SIDE_BOTH), TOKMAX_MOTOR)
    benchLog.numField(@"ret", ssRet, LIM_TINY)
    benchLog.boolField(@"ret_ok", bSsRetOk)
    benchLog.tokenField(@"l_st", dcsToken(ssLeftState), TOKMAX_STATE)
    benchLog.tokenField(@"r_st", dcsToken(ssRightState), TOKMAX_STATE)
    benchLog.numField(@"ready_ms", ssReadyMs, LIM_SMALL)
    benchLog.numField(@"l_neg", ssLeftNeg, LIM_TINY)
    benchLog.numField(@"l_pos", ssLeftPos, LIM_TINY)
    benchLog.numField(@"r_neg", ssRightNeg, LIM_TINY)
    benchLog.numField(@"r_pos", ssRightPos, LIM_TINY)
    benchLog.numField(@"l_ig", ssLeftIg, LIM_SMALL)
    benchLog.numField(@"r_ig", ssRightIg, LIM_SMALL)
    benchLog.tokenField(@"l_board", boardToken(ssLeftBoard), TOKMAX_BOARD)
    benchLog.tokenField(@"r_board", boardToken(ssRightBoard), TOKMAX_BOARD)
    whyField(ssWhy)
    emitRecord()

PRI emitRung(seg, rid, rungIdx, side, motorIncre, resultCode, steadyMs, bSteadyValid, bWindowValid, whyCode)
' BM-RUNG from the caller's result and the rs* window statistics. Worst case 262 bytes.
'
' @param seg - SEG_* in progress
' @param rid - rung id from nextRungId()
' @param rungIdx - rung index into ladderIncre (or the segment's own rung number)
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param resultCode - RES_* value
' @param steadyMs - ms from command to AT_SPEED
' @param bSteadyValid - TRUE when steadyMs is a measurement
' @param bWindowValid - TRUE when the window statistics are a measurement
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-RUNG")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"life", slotLife[side - SIDE_LEFT], LIM_SMALL)
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.numField(@"rung", rungIdx, LIM_TINY)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.tokenField(@"result", tokenAt(@tokRes, RES_COUNT, resultCode), TOKMAX_RESULT)
    benchLog.numField(@"off_neg", rsOffNeg, LIM_TINY)
    benchLog.numField(@"off_pos", rsOffPos, LIM_TINY)
    benchLog.naNumField(@"steady_ms", steadyMs, LIM_SMALL, bSteadyValid)
    benchLog.naNumField(@"win_ms", rsWinMs, LIM_SMALL, bWindowValid)
    benchLog.naNumField(@"ticks", rsTicks, LIM_MID, bWindowValid)
    benchLog.naNumField(@"rate_x10", rsRateX10, LIM_MID, bWindowValid)
    benchLog.numField(@"pred_x10", predictX10(motorIncre), LIM_MID)
    whyField(whyCode)
    emitRecord()

PRI emitRung2(rid, side, motorIncre, dutyMax, bWindowValid, whyCode) | slotIdx, bZero
' BM-RUNG2: currents, phase sum and duty over the window; inet uses this lifetime's zero (PL-32).
' Worst case 269 bytes.
'
' @param rid - rung id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param dutyMax - duty_max from testGetDriveConstants()
' @param bWindowValid - TRUE when the window statistics are a measurement
' @param whyCode - WHY_* naming the cause of every NA
'
' @local slotIdx - motor slot
' @local bZero - this lifetime's zero is a measurement

    slotIdx := side - SIDE_LEFT
    bZero := bLifeZeroValid[slotIdx] <> FALSE
    recBegin(@"BM-RUNG2")
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.naNumField(@"zero_x10", lifeZeroX10[slotIdx], LIM_MID, bZero)
    benchLog.naNumField(@"i_x10", rsIMeanX10, LIM_MID, bWindowValid)
    benchLog.naNumField(@"inet_x10", rsIMeanX10 - lifeZeroX10[slotIdx], LIM_MID, bWindowValid and bZero)
    benchLog.naNumField(@"i_min", rsIMin, LIM_SMALL, bWindowValid)
    benchLog.naNumField(@"i_max", rsIMax, LIM_SMALL, bWindowValid)
    benchLog.naNumField(@"ph_x10", rsPhMeanX10, LIM_MID, bWindowValid)
    benchLog.naNumField(@"duty", rsDutyMean, LIM_SMALL, bWindowValid)
    benchLog.naNumField(@"duty_pk", rsDutyPk, LIM_SMALL, bWindowValid)
    benchLog.numField(@"duty_max", dutyMax, LIM_SMALL)
    benchLog.naNumField(@"err", rsErrMean, LIM_TINY, bWindowValid)
    benchLog.naNumField(@"err_pk", rsErrPk, LIM_TINY, bWindowValid)
    benchLog.numField(@"n", rsN, LIM_SMALL)
    whyField(whyCode)
    emitRecord()

PRI emitRung3(rid, side, motorIncre, missedD, illegalD, ampsX10k, bAmpsValid, bWindowValid, whyCode) | rsImpl
' BM-RUNG3: integrity deltas, hwPos, getCurrent() mean and the capture's counters. Worst case 270 bytes.
'
' @param rid - rung id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param missedD - missed transitions over the rung (read before arm and after freeze)
' @param illegalD - illegal codes over the rung
' @param ampsX10k - mean getCurrent() over the window, A x 10_000
' @param bAmpsValid - TRUE when ampsX10k is a measurement
' @param bWindowValid - TRUE when the window statistics are a measurement
' @param whyCode - WHY_* naming the cause of every NA
'
' @local rsImpl - implied sense scale i_x10 x 1_000 / amps_x10k

    rsImpl := 0
    if bAmpsValid and (ampsX10k > 0)
        rsImpl := (rsIMeanX10 * MS_PER_SEC) / ampsX10k
    recBegin(@"BM-RUNG3")
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"missed_d", missedD, LIM_SMALL)
    benchLog.numField(@"illegal_d", illegalD, LIM_SMALL)
    benchLog.naNumField(@"hw_ticks", rsHwTicks, LIM_MID, bWindowValid)
    benchLog.numField(@"hw_skip", rsHwSkip, LIM_SMALL)
    benchLog.naNumField(@"amps_x10k", ampsX10k, LIM_MID, bAmpsValid)
    benchLog.naNumField(@"rs_impl", rsImpl, LIM_SMALL, bAmpsValid and bWindowValid and (ampsX10k > 0))
    benchLog.numField(@"late", rsLate, LIM_SMALL)
    benchLog.numField(@"skipped", rsSkipped, LIM_SMALL)
    benchLog.numField(@"clamps", rsClamps, LIM_SMALL)
    benchLog.boolField(@"idle_up", bRsIdleUp)
    benchLog.numField(@"idle_i", rsIdleIMax, LIM_SMALL)
    whyField(whyCode)
    emitRecord()

PRI emitLive(rid, side, motorIncre, rpmRead, bHeartbeatOk, bWindowValid, whyCode)
' BM-LIVE: instrument liveness beside testGetRpm(). Worst case 203 bytes.
'
' @param rid - rung id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param rpmRead - testGetRpm() after the window
' @param bHeartbeatOk - the instrument heartbeat advanced over the window
' @param bWindowValid - TRUE when the window statistics are a measurement
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-LIVE")
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.boolField(@"up_all", bRsAllUp)
    benchLog.naNumField(@"ticks", rsTicks, LIM_MID, bWindowValid)
    benchLog.naNumField(@"i_min", rsIMin, LIM_SMALL, bWindowValid)
    benchLog.naNumField(@"i_max", rsIMax, LIM_SMALL, bWindowValid)
    benchLog.boolField(@"frozen", bWindowValid and (rsIMin == rsIMax))
    benchLog.naNumField(@"rpm", rpmRead, LIM_SMALL, bWindowValid)
    benchLog.naNumField(@"rate_x10", rsRateX10, LIM_MID, bWindowValid)
    benchLog.boolField(@"hb_ok", bHeartbeatOk)
    whyField(whyCode)
    emitRecord()

PRI emitClock(side, adcFram, frameCnt, deadGap) : bFrameOk | expFrame, bSwept
' BM-CLOCK: the driver's frame count against the compiled clock's expected value. Also returns the
' comparison this clock's R14-DUAL-CLKFRM-K200 / -K270 / -K300 cell folds. Worst case 159 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param adcFram - adc_fram from testGetDriveConstants()
' @param frameCnt - frame_cnt from testGetDriveConstants()
' @param deadGap - dead_gap from testGetDriveConstants()
' @returns bFrameOk - adc_fram equals the expected frame count at a swept clock
'
' @local expFrame - expected frame count at CLK_FREQ
' @local bSwept - CLK_FREQ is 200, 270 or 300 MHz

    bSwept := TRUE
    case CLK_FREQ
        CLK_SWEEP_200:
            expFrame := EXP_FRAME_200
        CLK_SWEEP_270:
            expFrame := EXP_FRAME_270
        CLK_SWEEP_300:
            expFrame := EXP_FRAME_300
        other:
            expFrame := 0
            bSwept := FALSE
    bFrameOk := bSwept and (adcFram == expFrame)
    recBegin(@"BM-CLOCK")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"clkfreq", CLKFREQ, LIM_BIG)
    benchLog.numField(@"adc_fram", adcFram, LIM_SMALL)
    benchLog.numField(@"frame_cnt", frameCnt, LIM_SMALL)
    benchLog.numField(@"dead_gap", deadGap, LIM_TINY)
    benchLog.naNumField(@"exp_fram", expFrame, LIM_SMALL, bSwept)
    benchLog.boolField(@"fram_ok", bFrameOk)
    whyField(bSwept ? WHY_NONE : WHY_UNSWEPT_CLOCK)
    emitRecord()

PRI emitTrace(tid, seg, side, causeCode, motorIncre, offNeg, offPos, reqMode, rampInc, whyCode)
' BM-TRACE: a wheel trace header naming what was requested and what was done, never the outcome (I7).
' Worst case 233 bytes.
'
' @param tid - trace id
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param causeCode - CAUSE_* value
' @param motorIncre - signed increment
' @param offNeg - offset_fwd read back before the measurement
' @param offPos - offset_rev read back before the measurement
' @param reqMode - MODE_* requested
' @param rampInc - ramp_inc read back
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-TRACE")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"life", slotLife[side - SIDE_LEFT], LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"cause", tokenAt(@tokCause, CAUSE_COUNT, causeCode), TOKMAX_CAUSE)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"off_neg", offNeg, LIM_TINY)
    benchLog.numField(@"off_pos", offPos, LIM_TINY)
    benchLog.tokenField(@"req_mode", tokenAt(@tokMode, MODE_COUNT, reqMode), TOKMAX_REQMODE)
    benchLog.numField(@"ramp_inc", rampInc, LIM_MID)
    benchLog.numField(@"period_us", INST_PERIOD_US, LIM_SMALL)
    benchLog.numField(@"decim", instDecimate, LIM_TINY)
    benchLog.numField(@"pre", TRACE_PRE_SAMPLES, LIM_SMALL)
    whyField(whyCode)
    emitRecord()

PRI emitSTrace(tid, seg, causeCode, leftPower, rightPower, bPowersValid, dirValue, reqMode, whyCode)
' BM-STRACE: a steering trace header; primary motor LEFT, o_ fields RIGHT. Worst case 200 bytes (an NA
' power is shorter than a number).
'
' @param tid - trace id
' @param seg - SEG_* in progress
' @param causeCode - CAUSE_* value
' @param leftPower - requested left power, or FLOOR's getPower() read-back
' @param rightPower - requested right power, or FLOOR's getPower() read-back
' @param bPowersValid - TRUE when the powers are a request or a read-back; FALSE prints NA
' @param dirValue - commanded direction (0 when not driveDirection())
' @param reqMode - MODE_* requested
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-STRACE")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"life", steerLife, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(SIDE_BOTH), TOKMAX_MOTOR)
    benchLog.tokenField(@"cause", tokenAt(@tokCause, CAUSE_COUNT, causeCode), TOKMAX_CAUSE)
    benchLog.naNumField(@"l_pwr", leftPower, LIM_TINY, bPowersValid)
    benchLog.naNumField(@"r_pwr", rightPower, LIM_TINY, bPowersValid)
    benchLog.numField(@"dir", dirValue, LIM_TINY)
    benchLog.tokenField(@"req_mode", tokenAt(@tokMode, MODE_COUNT, reqMode), TOKMAX_REQMODE)
    benchLog.numField(@"period_us", INST_PERIOD_US, LIM_SMALL)
    benchLog.numField(@"decim", instDecimate, LIM_TINY)
    benchLog.numField(@"pre", TRACE_PRE_SAMPLES, LIM_SMALL)
    whyField(whyCode)
    emitRecord()

PRI emitTs(sampleIdx, kIdx, posRel, hwRel) | bUp, bOtherUp, bLate
' BM-TS: one stored sample of the trace in drain (drPri primary, drOth other). lt is computed from the
' stored t of the previous sample. Worst case 241 bytes.
'
' @param sampleIdx - logical index
' @param kIdx - trace index k
' @param posRel - primary pos relative to k = 0
' @param hwRel - primary hwPos relative to k = 0
'
' @local bUp - primary driver up
' @local bOtherUp - other driver up
' @local bLate - this sample started late relative to the previous stored one

    bUp := smpUp(sampleIdx, drPri)
    bOtherUp := smpUp(sampleIdx, drOth)
    bLate := FALSE
    if kIdx > 0
        bLate := (smpT(sampleIdx) - smpT(sampleIdx - 1)) > ((INST_PERIOD_TICKS * instDecimate) + INST_LATE_TICKS)
    recBegin(@"BM-TS")
    benchLog.numField(@"tid", trTid, LIM_SMALL)
    benchLog.numField(@"k", kIdx, LIM_SMALL)
    benchLog.boolField(@"lt", bLate)
    benchLog.numField(@"pos", posRel, LIM_MID)
    benchLog.numField(@"hw", hwRel, LIM_MID)
    benchLog.naNumField(@"i", smpI(sampleIdx, drPri), LIM_SMALL, bUp)
    benchLog.naNumField(@"ph", smpPh(sampleIdx, drPri), LIM_SMALL, bUp)
    benchLog.naNumField(@"d", smpDuty(sampleIdx, drPri), LIM_SMALL, bUp)
    benchLog.naNumField(@"e", smpErr(sampleIdx, drPri), LIM_TINY, bUp)
    benchLog.tokenField(@"st", dcsToken(smpState(sampleIdx, drPri)), TOKMAX_STATE)
    benchLog.boolField(@"flt", smpFault(sampleIdx, drPri))
    benchLog.boolField(@"up", bUp)
    benchLog.numField(@"ig", trIgRun, LIM_SMALL)
    benchLog.numField(@"o_pos", smpPos(sampleIdx, drOth) - smpPos(drStartJ, drOth), LIM_MID)
    benchLog.numField(@"o_hw", smpHw(sampleIdx, drOth) - smpHw(drStartJ, drOth), LIM_MID)
    benchLog.naNumField(@"o_i", smpI(sampleIdx, drOth), LIM_SMALL, bOtherUp)
    benchLog.boolField(@"o_up", bOtherUp)
    whyField((bUp and bOtherUp) ? WHY_NONE : WHY_NO_COG)
    emitRecord()

PRI emitTraceEnd(tid, endCode, emptyWhy) | traceSamples, markK, whyCode
' BM-TRACE-END from the drain state, with sec 12.4's stride before why. Worst case: 265 + stride
' (2+6+4=12) = 277 bytes.
'
' @param tid - trace id
' @param endCode - TEND_* value
' @param emptyWhy - WHY_* printed when no sample was stored (NO_SAMPLES, or why the trial never ran)
'
' @local traceSamples - samples in the trace (drStartJ..drEndJ)
' @local markK - k of the mark
' @local whyCode - emptyWhy, NOT_REACHED (mark or rest not found) or NONE

    traceSamples := 0
    if drStored > 0
        traceSamples := drEndJ - drStartJ + 1
    markK := drMarkJ - drStartJ
    if drStored == 0
        whyCode := emptyWhy
    elseif (bDrMarkFound == FALSE) or (bDrRestFound == FALSE)
        whyCode := WHY_NOT_REACHED
    else
        whyCode := WHY_NONE
    recBegin(@"BM-TRACE-END")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.numField(@"stored", traceSamples, LIM_SMALL)
    benchLog.numField(@"emitted", trLines, LIM_SMALL)
    benchLog.numField(@"ksum", trKSum, LIM_MID)
    benchLog.naNumField(@"mark_k", markK, LIM_SMALL, bDrMarkFound)
    benchLog.naNumField(@"late", instLate, LIM_SMALL, drStored > 0)
    benchLog.naNumField(@"skipped", instSkipped, LIM_SMALL, drStored > 0)
    benchLog.numField(@"lost_head", drLostHead, LIM_SMALL)
    benchLog.numField(@"dropped", drDropped, LIM_SMALL)
    benchLog.tokenField(@"end", tokenAt(@tokTend, TEND_COUNT, endCode), TOKMAX_TEND)
    benchLog.naNumField(@"rest_k", drRestK, LIM_SMALL, bDrRestFound)
    benchLog.numField(@"ig_sum", drIgSum, LIM_SMALL)
    benchLog.numField(@"o_ig_sum", drOIgSum, LIM_SMALL)
    benchLog.numField(@"hw_skip", drHwSkip, LIM_SMALL)
    benchLog.numField(@"stride", trStride, LIM_TINY)
    whyField(whyCode)
    emitRecord()

PRI emitFbTrial(tid, side)
' BM-FBTRIAL from the fb* staging. Worst case 269 bytes.
'
' @param tid - trace id of the trial
' @param side - SIDE_LEFT or SIDE_RIGHT

    recBegin(@"BM-FBTRIAL")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"trial", fbTrial, LIM_TINY)
    benchLog.numField(@"ramp_inc", fbRampInc, LIM_MID)
    benchLog.numField(@"incre", fbIncre, LIM_BIG)
    benchLog.numField(@"off_neg", fbOffNeg, LIM_TINY)
    benchLog.numField(@"off_pos", fbOffPos, LIM_TINY)
    benchLog.tokenField(@"result", tokenAt(@tokRes, RES_COUNT, fbResult), TOKMAX_RESULT)
    benchLog.naNumField(@"t_ms", fbTMs, LIM_SMALL, bFbTValid)
    benchLog.numField(@"i_pk", fbIPk, LIM_SMALL)
    benchLog.numField(@"duty_pk", fbDutyPk, LIM_SMALL)
    benchLog.numField(@"duty_max", fbDutyMax, LIM_SMALL)
    benchLog.boolField(@"dsat", bFbDsat)
    benchLog.tokenField(@"rst", tokenAt(@tokRst, RST_COUNT, fbRst), TOKMAX_RST)
    benchLog.numField(@"rst_ms", fbRstMs, LIM_SMALL)
    whyField(fbWhy)
    emitRecord()

PRI emitRampRest(side, minRamp, maxRamp, incRamp, downRamp, bOk)
' BM-RAMPREST: the ramp restore read back (I11). Worst case 131 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param minRamp - ramp_min read back
' @param maxRamp - ramp_max read back
' @param incRamp - ramp_inc read back
' @param downRamp - ramp_down read back
' @param bOk - TRUE when the defaults read back

    recBegin(@"BM-RAMPREST")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"min", minRamp, LIM_MID)
    benchLog.numField(@"max", maxRamp, LIM_MID)
    benchLog.numField(@"inc", incRamp, LIM_MID)
    benchLog.numField(@"down", downRamp, LIM_MID)
    benchLog.boolField(@"ok", bOk)
    whyField(WHY_NONE)
    emitRecord()

PRI emitOffRest(side, wantNeg, wantPos, offNeg, offPos, bOk)
' BM-OFFREST: the offset restore read back (I11). Worst case 123 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param wantNeg - offset_fwd restored
' @param wantPos - offset_rev restored
' @param offNeg - offset_fwd read back
' @param offPos - offset_rev read back
' @param bOk - TRUE when both read back equal

    recBegin(@"BM-OFFREST")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"want_neg", wantNeg, LIM_TINY)
    benchLog.numField(@"want_pos", wantPos, LIM_TINY)
    benchLog.numField(@"off_neg", offNeg, LIM_TINY)
    benchLog.numField(@"off_pos", offPos, LIM_TINY)
    benchLog.boolField(@"ok", bOk)
    whyField(WHY_NONE)
    emitRecord()

PRI emitRecover(seg, tid, side, motorIncre, offNeg, offPos, stepCode, bCleared, stepMs, eDrvrState, bFaultSig)
' BM-RECOVER: one recovery step. Worst case 193 bytes.
'
' @param seg - SEG_* in progress
' @param tid - trace id, 0 when none
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - the faulted command
' @param offNeg - offset_fwd read back
' @param offPos - offset_rev read back
' @param stepCode - RSTEP_* value
' @param bCleared - stopped and not faulted
' @param stepMs - ms the step took
' @param eDrvrState - driver state after the step
' @param bFaultSig - fault flag after the step

    recBegin(@"BM-RECOVER")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"off_neg", offNeg, LIM_TINY)
    benchLog.numField(@"off_pos", offPos, LIM_TINY)
    benchLog.tokenField(@"step", tokenAt(@tokRstep, RSTEP_COUNT, stepCode), TOKMAX_STEP)
    benchLog.boolField(@"cleared", bCleared)
    benchLog.numField(@"ms", stepMs, LIM_SMALL)
    benchLog.tokenField(@"st", dcsToken(eDrvrState), TOKMAX_STATE)
    benchLog.boolField(@"flt", bFaultSig)
    whyField(WHY_NONE)
    emitRecord()

PRI emitUnrecov(seg, tid, side, motorIncre, offNeg, offPos, eDrvrState, bFaultSig, bUp)
' BM-UNRECOV: recovery step 4, the motor is retired for this load. Worst case 184 bytes.
'
' @param seg - SEG_* in progress
' @param tid - trace id, 0 when none
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - the faulted command
' @param offNeg - offset_fwd read back
' @param offPos - offset_rev read back
' @param eDrvrState - driver state after the restart
' @param bFaultSig - fault flag after the restart
' @param bUp - the restart's start succeeded

    recBegin(@"BM-UNRECOV")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"off_neg", offNeg, LIM_TINY)
    benchLog.numField(@"off_pos", offPos, LIM_TINY)
    benchLog.tokenField(@"st", dcsToken(eDrvrState), TOKMAX_STATE)
    benchLog.boolField(@"flt", bFaultSig)
    benchLog.boolField(@"up", bUp)
    benchLog.tokenField(@"action", @sActionRetired, TOKMAX_ACTION)
    whyField(WHY_MOTOR_RETIRED)
    emitRecord()

PRI emitAbort(seg, tid, side, motorIncre, reasonCode, detailValue, scopeCode)
' BM-ABORT. Worst case 153 bytes.
'
' @param seg - SEG_* in progress
' @param tid - trace id, 0 when none
' @param side - SIDE_* affected
' @param motorIncre - the command in force
' @param reasonCode - ABR_* value
' @param detailValue - the reading or count that triggered it
' @param scopeCode - SCOPE_* value

    recBegin(@"BM-ABORT")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.tokenField(@"reason", tokenAt(@tokAbr, ABR_COUNT, reasonCode), TOKMAX_REASON)
    benchLog.numField(@"value", detailValue, LIM_BIG)
    benchLog.tokenField(@"scope", tokenAt(@tokScope, SCOPE_COUNT, scopeCode), TOKMAX_SCOPE)
    whyField(WHY_NONE)
    emitRecord()

PRI emitOvershoot(tid, sid, powerValue, distFt, tgtTicks) | bValid
' BM-OVERSHOOT from the ov* staging. Worst case 271 bytes.
'
' @param tid - trace id
' @param sid - the steering start's life
' @param powerValue - commanded power
' @param distFt - commanded distance, feet
' @param tgtTicks - DERIVED target ticks
'
' @local bValid - the stop/rest fields are measurements (ovWhy is WHY_NONE)

    bValid := (ovWhy == WHY_NONE)
    recBegin(@"BM-OVERSHOOT")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.numField(@"sid", sid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(SIDE_BOTH), TOKMAX_MOTOR)
    benchLog.numField(@"power", powerValue, LIM_TINY)
    benchLog.numField(@"dist_ft", distFt, LIM_TINY)
    benchLog.numField(@"tgt", tgtTicks, LIM_MID)
    benchLog.naNumField(@"l_stop", ovLeftStop, LIM_MID, bValid)
    benchLog.naNumField(@"r_stop", ovRightStop, LIM_MID, bValid)
    benchLog.naNumField(@"l_rest", ovLeftRest, LIM_MID, bValid)
    benchLog.naNumField(@"r_rest", ovRightRest, LIM_MID, bValid)
    benchLog.numField(@"l_trk", ovLeftTrk, LIM_MID)
    benchLog.numField(@"r_trk", ovRightTrk, LIM_MID)
    benchLog.naNumField(@"t_stop", ovTStopMs, LIM_SMALL, bValid)
    benchLog.numField(@"l_ig", ovLeftIg, LIM_SMALL)
    benchLog.numField(@"r_ig", ovRightIg, LIM_SMALL)
    whyField(ovWhy)
    emitRecord()

PRI emitOut(tid, sid, rowIdx) | rowBase
' BM-OUT: one 100 ms poll of the public API from outBuf. Worst case 239 bytes.
'
' @param tid - trace id
' @param sid - the steering start's life
' @param rowIdx - 0-based poll row
'
' @local rowBase - first long of the row

    rowBase := rowIdx * OUT_LONGS
    recBegin(@"BM-OUT")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.numField(@"sid", sid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(SIDE_BOTH), TOKMAX_MOTOR)
    benchLog.numField(@"t_ms", outBuf[rowBase + OUT_T_MS], LIM_SMALL)
    benchLog.tokenField(@"l_stat", statusToken(outBuf[rowBase + OUT_L_STAT]), TOKMAX_STAT)
    benchLog.tokenField(@"r_stat", statusToken(outBuf[rowBase + OUT_R_STAT]), TOKMAX_STAT)
    benchLog.tokenField(@"l_st", dcsToken(outBuf[rowBase + OUT_L_ST]), TOKMAX_STATE)
    benchLog.tokenField(@"r_st", dcsToken(outBuf[rowBase + OUT_R_ST]), TOKMAX_STATE)
    benchLog.boolField(@"l_flt", outBuf[rowBase + OUT_L_FLT])
    benchLog.boolField(@"l_sig", outBuf[rowBase + OUT_L_SIG])
    benchLog.boolField(@"r_flt", outBuf[rowBase + OUT_R_FLT])
    benchLog.boolField(@"r_sig", outBuf[rowBase + OUT_R_SIG])
    benchLog.boolField(@"turning", outBuf[rowBase + OUT_TURNING])
    benchLog.numField(@"l_pwr", outBuf[rowBase + OUT_L_PWR], LIM_TINY)
    benchLog.numField(@"r_pwr", outBuf[rowBase + OUT_R_PWR], LIM_TINY)
    whyField(WHY_NONE)
    emitRecord()

PRI emitFloor(tid, sid, runMs, answerCode, inputCode, leftRateX10, rightRateX10, bRatesValid, slowerCode, stopByCode, whyCode)
' BM-FLOOR. The rates and slower print NA together when the rates were not measured. Worst case 219 bytes.
'
' @param tid - trace id
' @param sid - the steering start's life
' @param runMs - ms driven
' @param answerCode - ANS_* value
' @param inputCode - INPUT_* value
' @param leftRateX10 - left ticks per second x10 over the run
' @param rightRateX10 - right ticks per second x10 over the run
' @param bRatesValid - TRUE when the rates (and so slower) are measurements
' @param slowerCode - SLOWER_* value
' @param stopByCode - STOPBY_* value
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-FLOOR")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.numField(@"sid", sid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(SIDE_BOTH), TOKMAX_MOTOR)
    benchLog.numField(@"power", FLOOR_POWER, LIM_TINY)
    benchLog.numField(@"dir", FLOOR_DIRECTION, LIM_TINY)
    benchLog.numField(@"run_ms", runMs, LIM_SMALL)
    benchLog.tokenField(@"answer", tokenAt(@tokAns, ANS_COUNT, answerCode), TOKMAX_ANSWER)
    benchLog.tokenField(@"input", tokenAt(@tokInput, INPUT_COUNT, inputCode), TOKMAX_INPUT)
    benchLog.naNumField(@"l_rate_x10", leftRateX10, LIM_MID, bRatesValid)
    benchLog.naNumField(@"r_rate_x10", rightRateX10, LIM_MID, bRatesValid)
    if bRatesValid
        benchLog.tokenField(@"slower", tokenAt(@tokSlower, SLOWER_COUNT, slowerCode), TOKMAX_SLOWER)
    else
        benchLog.textField(@"slower", @sSfNa)
    benchLog.tokenField(@"stop_by", tokenAt(@tokStopBy, STOPBY_COUNT, stopByCode), TOKMAX_STOPBY)
    whyField(whyCode)
    emitRecord()

PRI emitUiStep(kindCode, testedIdx, gotIdx, promptIdx, resultCode, inputCode, waitedMs)
' BM-UISTEP: one UICHECK step, what was shown and what arrived. tested is the one live button a control step
' checks (NA on a screen step); got is the button that arrived (NA when none did). Worst case: tag(9) +
' seq(15) + step(10) + kind(13) + tested(16) + got(13) + prompt(12) + result(15) + input(12) + wait_ms(19)
' + why(23) = 157 bytes.
'
' @param kindCode - UIK_* value
' @param testedIdx - BM_BTN_* under test, PNL_BTN_NONE on a screen step
' @param gotIdx - BM_BTN_* that arrived, PNL_BTN_NONE when none did
' @param promptIdx - BM_PROMPT_* on screen
' @param resultCode - UIR_* value
' @param inputCode - INPUT_* of the button that arrived
' @param waitedMs - ms the step took

    uiStepCount := (uiStepCount + 1) <# LIM_SMALL
    recBegin(@"BM-UISTEP")
    benchLog.numField(@"step", uiStepCount, LIM_TINY)
    benchLog.tokenField(@"kind", tokenAt(@tokUiKind, UIK_COUNT, kindCode), TOKMAX_UIKIND)
    uiButtonField(@"tested", testedIdx)
    uiButtonField(@"got", gotIdx)
    benchLog.numField(@"prompt", promptIdx, LIM_TINY)
    benchLog.tokenField(@"result", tokenAt(@tokUiRes, UIR_COUNT, resultCode), TOKMAX_UIRES)
    benchLog.tokenField(@"input", tokenAt(@tokInput, INPUT_COUNT, inputCode), TOKMAX_INPUT)
    benchLog.numField(@"wait_ms", waitedMs, LIM_MID)
    whyField(lookupz(resultCode: WHY_NONE, WHY_OPERATOR_SKIP, WHY_OPERATOR_TIMEOUT))
    emitRecord()

PRI uiButtonField(pName, btnIdx)
' Append a button field: its token, or NA when no button applies.
'
' @param pName - pointer to the field name
' @param btnIdx - BM_BTN_* value, PNL_BTN_NONE for none

    if (btnIdx >= 0) and (btnIdx < BM_BTN_COUNT)
        benchLog.tokenField(pName, tokenAt(@tokButton, BM_BTN_COUNT, btnIdx), TOKMAX_BUTTON)
    else
        benchLog.textField(pName, @sSfNa)

PRI emitOper(promptCode, eventCode, answerCode, inputCode, waitedMs, whyCode)
' BM-OPER: what the operator was shown and did. Worst case 125 bytes.
'
' @param promptCode - PROMPT_* value
' @param eventCode - OPEV_* value
' @param answerCode - ANS_* value
' @param inputCode - INPUT_* value
' @param waitedMs - ms since the prompt was shown
' @param whyCode - WHY_* value

    recBegin(@"BM-OPER")
    benchLog.tokenField(@"prompt", tokenAt(@tokPrompt, PROMPT_COUNT, promptCode), TOKMAX_PROMPT)
    benchLog.tokenField(@"event", tokenAt(@tokOpEv, OPEV_COUNT, eventCode), TOKMAX_OPEREV)
    benchLog.tokenField(@"answer", tokenAt(@tokAns, ANS_COUNT, answerCode), TOKMAX_ANSWER)
    benchLog.tokenField(@"input", tokenAt(@tokInput, INPUT_COUNT, inputCode), TOKMAX_INPUT)
    benchLog.numField(@"wait_ms", waitedMs, LIM_MID)
    whyField(whyCode)
    emitRecord()

PRI emitSeg(seg, eventCode, bAttended, itemCount, faultCount, unrecovCount, elapsedMs, whyCode)
' BM-SEG. Worst case 140 bytes.
'
' @param seg - SEG_* value
' @param eventCode - SEGEV_* value
' @param bAttended - the segment needs a person
' @param itemCount - trials, rungs or traces done
' @param faultCount - faults in the segment
' @param unrecovCount - motors retired in the segment
' @param elapsedMs - segment duration
' @param whyCode - WHY_* value

    recBegin(@"BM-SEG")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.tokenField(@"event", tokenAt(@tokSegEv, SEGEV_COUNT, eventCode), TOKMAX_SEGEV)
    benchLog.boolField(@"attended", bAttended)
    benchLog.numField(@"items", itemCount, LIM_SMALL)
    benchLog.numField(@"faults", faultCount, LIM_SMALL)
    benchLog.numField(@"unrecov", unrecovCount, LIM_TINY)
    benchLog.numField(@"ms", elapsedMs, LIM_MID)
    whyField(whyCode)
    emitRecord()

PRI emitPreflt(side, motorIncre, ticksMoved, hwMoved, bMeasured, whyCode)
' BM-PREFLT. Worst case 124 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - the nudge increment
' @param ticksMoved - driver pos delta
' @param hwMoved - hwPos delta
' @param bMeasured - the deltas are measurements
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-PREFLT")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.naNumField(@"ticks", ticksMoved, LIM_SMALL, bMeasured)
    benchLog.naNumField(@"hw_ticks", hwMoved, LIM_MID, bMeasured)
    benchLog.boolField(@"moved", bMeasured and (ticksMoved <> 0))
    whyField(bMeasured ? WHY_NONE : whyCode)
    emitRecord()

PRI emitTrap(trapCode, bReturned)
' BM-TRAP: the one top-level trap's value, every run (I9). Worst case 55 bytes.
'
' @param trapCode - the value \runPart() delivered
' @param bReturned - runPart() reached its end

    recBegin(@"BM-TRAP")
    benchLog.numField(@"code", trapCode, LIM_BIG)
    benchLog.boolField(@"returned", bReturned)
    emitRecord()

PRI emitEnd(exitCode)
' BM-END: the last record before the marker; records is the seq this record carries (I8).
' Worst case 152 bytes.
'
' @param exitCode - EXIT_* value

    recBegin(@"BM-END")
    benchLog.tokenField(@"exit", tokenAt(@tokExit, EXIT_COUNT, exitCode), TOKMAX_EXIT)
    benchLog.tokenField(@"part", tokenAt(@tokPart, PART_COUNT, PART_ID), TOKMAX_PART)
    benchLog.numField(@"segs", segsRun, LIM_TINY)
    benchLog.tokenField(@"last_seg", segToken(lastSeg), TOKMAX_SEG)
    benchLog.numField(@"records", logSeq, LIM_MID)
    benchLog.numField(@"trap_code", runTrapCode, LIM_BIG)
    benchLog.numField(@"unrecov", unrecovTotal, LIM_TINY)
    whyField(WHY_NONE)
    emitRecord()

CON { --- sign-off verdicts (design sec 5.2; record contract VISIT-SIGNOFF-DESIGN.md sec B.1) --- }

PRI partNoStallCell() : pCell
' This part's R14-DUAL-NOSTALL-* cell id, and for the CLOCK part this clock's (shared by cog 0 and the
' watchdog; reads only DAT).
'
' @returns pCell - pointer to the cell id, "?" for PART_NONE and for a CLOCK build at an unswept clock

    case PART_ID
        PART_A:
            pCell := @sSfCellNoStallA
        PART_CLOCK:
            pCell := clockCell(@sSfCellNoStallK200, @sSfCellNoStallK270, @sSfCellNoStallK300)
        PART_B:
            pCell := @sSfCellNoStallB
        PART_BRAKE:
            pCell := @sSfCellNoStallH
        PART_C:
            pCell := @sSfCellNoStallC
        PART_FLOOR:
            pCell := @sSfCellNoStallF
        PART_UICHECK:
            pCell := @sSfCellNoStallU
        other:
            pCell := @sUnknownTok

PRI partDbgMaskCell() : pCell
' This part's R14-DUAL-DBGMASK-* cell id, and for the CLOCK part this clock's.
'
' @returns pCell - pointer to the cell id, "?" for PART_NONE and for a CLOCK build at an unswept clock

    case PART_ID
        PART_A:
            pCell := @sSfCellDbgMaskA
        PART_CLOCK:
            pCell := clockCell(@sSfCellDbgMaskK200, @sSfCellDbgMaskK270, @sSfCellDbgMaskK300)
        PART_B:
            pCell := @sSfCellDbgMaskB
        PART_BRAKE:
            pCell := @sSfCellDbgMaskH
        PART_C:
            pCell := @sSfCellDbgMaskC
        PART_FLOOR:
            pCell := @sSfCellDbgMaskF
        PART_UICHECK:
            pCell := @sSfCellDbgMaskU
        other:
            pCell := @sUnknownTok

PRI clockCell(pCell200, pCell270, pCell300) : pCell
' The compiled clock's cell id, chosen from a cell's three per-clock ids by SF_CLOCK_SLOT (design sec 12.10;
' reads only DAT, so it is safe from any cog).
'
' @param pCell200 - pointer to the cell's 200 MHz id
' @param pCell270 - pointer to the cell's 270 MHz id
' @param pCell300 - pointer to the cell's 300 MHz id
' @returns pCell - pointer to this clock's id, "?" at an unswept clock

    case SF_CLOCK_SLOT
        SF_CLOCK_200:
            pCell := pCell200
        SF_CLOCK_270:
            pCell := pCell270
        SF_CLOCK_300:
            pCell := pCell300
        other:
            pCell := @sUnknownTok

PRI emitSignoffDecls()
' One SIGNOFF-DECL per cell this build judges, before anything moves. A build that judges no cell (PART_NONE,
' or a CLOCK build at an unswept clock: SF_JUDGES_CELLS) declares nothing. Each cell id is a DAT string passed
' by @label on the emitter's own line, so the CLOCK part names each clock's labels under its SF_CLOCK_SLOT.

    if SF_JUDGES_CELLS
        case PART_ID
            PART_A:
                emitSignoffDecl(@sSfCellNoStallA)
                emitSignoffDecl(@sSfCellDbgMaskA)
                emitSignoffDecl(@sSfCellInstLive)
                emitSignoffDecl(@sSfCellIdleFlt)
                emitSignoffDecl(@sSfCellRevB)
                emitSignoffDecl(@sSfCellInteg)
                emitSignoffDecl(@sSfCellTracesA)
            PART_CLOCK:
                case SF_CLOCK_SLOT
                    SF_CLOCK_200:
                        emitSignoffDecl(@sSfCellNoStallK200)
                        emitSignoffDecl(@sSfCellDbgMaskK200)
                        emitSignoffDecl(@sSfCellClkFrameK200)
                    SF_CLOCK_270:
                        emitSignoffDecl(@sSfCellNoStallK270)
                        emitSignoffDecl(@sSfCellDbgMaskK270)
                        emitSignoffDecl(@sSfCellClkFrameK270)
                    SF_CLOCK_300:
                        emitSignoffDecl(@sSfCellNoStallK300)
                        emitSignoffDecl(@sSfCellDbgMaskK300)
                        emitSignoffDecl(@sSfCellClkFrameK300)
            PART_B:
                emitSignoffDecl(@sSfCellNoStallB)
                emitSignoffDecl(@sSfCellDbgMaskB)
                emitSignoffDecl(@sSfCellTracesB)
                emitSignoffDecl(@sSfCellRstProvB)
                emitSignoffDecl(@sSfCellRampRest)
            PART_BRAKE:
                emitSignoffDecl(@sSfCellNoStallH)
                emitSignoffDecl(@sSfCellDbgMaskH)
                emitSignoffDecl(@sSfCellBrakeFlt)
            PART_C:
                emitSignoffDecl(@sSfCellNoStallC)
                emitSignoffDecl(@sSfCellDbgMaskC)
                emitSignoffDecl(@sSfCellTracesC)
                emitSignoffDecl(@sSfCellRstProvC)
                emitSignoffDecl(@sSfCellOffRest)
            PART_FLOOR:
                emitSignoffDecl(@sSfCellNoStallF)
                emitSignoffDecl(@sSfCellDbgMaskF)
                emitSignoffDecl(@sSfCellFloorAns)
            PART_UICHECK:
                emitSignoffDecl(@sSfCellNoStallU)
                emitSignoffDecl(@sSfCellDbgMaskU)
                emitSignoffDecl(@sSfCellUiCheck)

PRI emitSignoffDecl(pCell)
' SIGNOFF-DECL for one cell: sf, bin, cell, task only (no seq: the collation reads exactly these
' fields). Worst case: tag(12) + sf(8) + bin(11) + cell(26) + task(11) = 68 bytes.
'
' @param pCell - pointer to the cell id

    benchLog.begin(@"SIGNOFF-DECL")
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.tokenField(@"bin", @sSfBin, TOKMAX_BIN)
    benchLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    benchLog.tokenField(@"task", @sSfTask, TOKMAX_TASK)
    emitRecord()

PRI emitSignoffs() | slotIdx, side
' Every declared cell's SIGNOFF instances, once, on cog 0's end path after the wheels, the steering
' object and the instrument are stopped. A build that judges no cell (SF_JUDGES_CELLS FALSE) emits none.
' A cell whose segment did not run prints NOMEAS, measured NA, n 0. Per part:
'  A      NOSTALL BOOL; DBGMASK BOOL; INSTLIVE BOOL per motor; IDLEFLT / REVB / INTEG COUNT per motor;
'         TRACES COUNT
'  CLOCK  this clock's NOSTALL BOOL, DBGMASK BOOL and CLKFRAME BOOL per motor (-K200 / -K270 / -K300)
'  B      NOSTALL BOOL; DBGMASK BOOL; TRACES COUNT; RSTPROV COUNT per motor; RAMPREST BOOL per motor
'  BRAKE  NOSTALL BOOL; DBGMASK BOOL; BRAKEFLT BOOL (LEFT)
'  C      NOSTALL BOOL; DBGMASK BOOL; TRACES COUNT; RSTPROV COUNT per motor; OFFREST BOOL per motor
'  FLOOR  NOSTALL BOOL; DBGMASK BOOL; FLOORANS BOOL
'  UI     NOSTALL BOOL; DBGMASK BOOL; UICHECK BOOL (every BM-UISTEP OK)
'
' @local slotIdx - motor slot
' @local side - SIDE_LEFT or SIDE_RIGHT

    beat(CP_EMIT)
    if SF_JUDGES_CELLS
        emitSignoffBool(partNoStallCell(), SIDE_NONE, @sSfCritCog0End, TRUE, TRUE, SIGNOFF_ONE_INSTANCE)
        emitSignoffBool(partDbgMaskCell(), SIDE_NONE, @sSfCritQuiet, TRUE, bQuietMasks, SIGNOFF_ONE_INSTANCE)
        case PART_ID
            PART_A:
                repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                    side := SIDE_LEFT + slotIdx
                    emitSignoffBool(@sSfCellInstLive, side, @sSfCritInstLive, bSfLiveRan[slotIdx], bSfLiveOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    emitSignoff(@sSfCellIdleFlt, side, @sSfCritIdleUp, sfFrameCaps[slotIdx] > 0, sfIdleUp[slotIdx], IDLE_UP_LO, IDLE_UP_HI, sfFrameCaps[slotIdx])
                    emitSignoff(@sSfCellRevB, side, @sSfCritNotRevB, sfStarts[slotIdx] > 0, sfNotRevb[slotIdx], NOT_REVB_LO, NOT_REVB_HI, sfStarts[slotIdx])
                    emitSignoff(@sSfCellInteg, side, @sSfCritInteg, sfStarts[slotIdx] > 0, sfIntegSum[slotIdx], INTEG_SUM_LO, INTEG_SUM_HI, sfStarts[slotIdx] + sfIntegN[slotIdx])
                emitSignoff(@sSfCellTracesA, SIDE_NONE, @sSfCritTraces, sfTraces > 0, sfTraceLost, TRACE_LOST_LO, TRACE_LOST_HI, sfTraces)
            PART_CLOCK:
                repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                    emitSignoffBool(clockCell(@sSfCellClkFrameK200, @sSfCellClkFrameK270, @sSfCellClkFrameK300), SIDE_LEFT + slotIdx, @sSfCritClkFrame, bSfClkRan[slotIdx], bSfClkOk[slotIdx], SIGNOFF_ONE_INSTANCE)
            PART_B:
                emitSignoff(@sSfCellTracesB, SIDE_NONE, @sSfCritTraces, sfTraces > 0, sfTraceLost, TRACE_LOST_LO, TRACE_LOST_HI, sfTraces)
                repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                    side := SIDE_LEFT + slotIdx
                    emitSignoff(@sSfCellRstProvB, side, @sSfCritRstProv, sfFaults[slotIdx] > 0, sfResetUncleared[slotIdx], RESET_UNCLEAR_LO, RESET_UNCLEAR_HI, sfFaults[slotIdx])
                    emitSignoffBool(@sSfCellRampRest, side, @sSfCritRampRest, bSfRampRan[slotIdx], bSfRampOk[slotIdx], SIGNOFF_ONE_INSTANCE)
            PART_BRAKE:
                emitSignoffBool(@sSfCellBrakeFlt, SIDE_LEFT, @sSfCritBrakeFlt, bSfBrakeRan, bSfBrakeSeen, SIGNOFF_ONE_INSTANCE)
            PART_C:
                emitSignoff(@sSfCellTracesC, SIDE_NONE, @sSfCritTraces, sfTraces > 0, sfTraceLost, TRACE_LOST_LO, TRACE_LOST_HI, sfTraces)
                repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                    side := SIDE_LEFT + slotIdx
                    emitSignoff(@sSfCellRstProvC, side, @sSfCritRstProv, sfFaults[slotIdx] > 0, sfResetUncleared[slotIdx], RESET_UNCLEAR_LO, RESET_UNCLEAR_HI, sfFaults[slotIdx])
                    emitSignoffBool(@sSfCellOffRest, side, @sSfCritOffRest, bSfOffRan[slotIdx], bSfOffOk[slotIdx], SIGNOFF_ONE_INSTANCE)
            PART_FLOOR:
                emitSignoffBool(@sSfCellFloorAns, SIDE_NONE, @sSfCritFloorAns, bSfFloorRan, bSfFloorAnswered, SIGNOFF_ONE_INSTANCE)
            PART_UICHECK:
                emitSignoffBool(@sSfCellUiCheck, SIDE_NONE, @sSfCritUiCheck, bSfUiRan, bSfUiOk, uiStepCount)

PRI emitSignoff(pCell, side, pCrit, bMeasured, measuredVal, loLimit, hiLimit, instCount) | boundedVal, pVerdict
' One COUNT SIGNOFF verdict (test_bench_scan.spin2 emitSignoff(), units fixed to COUNT). Judged on the
' clamped printed value; PASS only when measured and in range; NOMEAS with measured NA and n 0 when not
' measured. Worst case 196 bytes.
'
' @param pCell - pointer to the cell id
' @param side - SIDE_NONE, SIDE_LEFT or SIDE_RIGHT
' @param pCrit - pointer to the criterion token
' @param bMeasured - TRUE when the instance was measured
' @param measuredVal - the measured count
' @param loLimit - lowest passing value
' @param hiLimit - highest passing value
' @param instCount - starts, captures, traces or faults behind measuredVal
'
' @local boundedVal - measuredVal clamped to +/-LIM_BIG
' @local pVerdict - PASS, FAIL or NOMEAS

    boundedVal := (measuredVal #> (0 - LIM_BIG)) <# LIM_BIG
    if bMeasured == FALSE
        pVerdict := @sSfNomeas
    elseif (boundedVal >= loLimit) and (boundedVal <= hiLimit)
        pVerdict := @sSfPass
    else
        pVerdict := @sSfFail
    benchLog.begin(@"SIGNOFF")
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.tokenField(@"bin", @sSfBin, TOKMAX_BIN)
    benchLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    benchLog.tokenField(@"task", @sSfTask, TOKMAX_TASK)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"crit", pCrit, TOKMAX_CRIT)
    benchLog.naNumField(@"measured", boundedVal, LIM_BIG, bMeasured)
    benchLog.numField(@"lo", loLimit, LIM_BIG)
    benchLog.numField(@"hi", hiLimit, LIM_BIG)
    benchLog.tokenField(@"units", @sSfUnitsCount, TOKMAX_UNITS)
    benchLog.numField(@"n", bMeasured ? instCount : 0, LIM_SMALL)
    benchLog.tokenField(@"verdict", pVerdict, TOKMAX_SFVERDICT)
    emitRecord()

PRI emitSignoffBool(pCell, side, pCrit, bMeasured, bCriterionMet, instCount) | pVerdict
' One BOOL SIGNOFF verdict: measured TRUE/FALSE (NA when not measured), lo TRUE, hi TRUE. PASS only
' when measured and TRUE. Worst case 173 bytes.
'
' @param pCell - pointer to the cell id
' @param side - SIDE_NONE, SIDE_LEFT or SIDE_RIGHT
' @param pCrit - pointer to the criterion token
' @param bMeasured - TRUE when the instance was measured
' @param bCriterionMet - TRUE when the whole criterion held
' @param instCount - instances behind the result
'
' @local pVerdict - PASS, FAIL or NOMEAS

    if bMeasured == FALSE
        pVerdict := @sSfNomeas
    elseif bCriterionMet <> FALSE
        pVerdict := @sSfPass
    else
        pVerdict := @sSfFail
    benchLog.begin(@"SIGNOFF")
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.tokenField(@"bin", @sSfBin, TOKMAX_BIN)
    benchLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    benchLog.tokenField(@"task", @sSfTask, TOKMAX_TASK)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"crit", pCrit, TOKMAX_CRIT)
    if bMeasured
        benchLog.boolField(@"measured", bCriterionMet)
    else
        benchLog.textField(@"measured", @sSfNa)
    benchLog.textField(@"lo", @sSfTrue)
    benchLog.textField(@"hi", @sSfTrue)
    benchLog.tokenField(@"units", @sSfUnitsBool, TOKMAX_UNITS)
    benchLog.numField(@"n", bMeasured ? instCount : 0, LIM_SMALL)
    benchLog.tokenField(@"verdict", pVerdict, TOKMAX_SFVERDICT)
    emitRecord()

CON { --- watchdog cog (test_bench_scan.spin2 pattern, design sec 4.3): runs in its own cog --- }

PRI watchdog() | lastSeenBeat, lastChangeMs, msSinceBeat
' Watch cog 0's heartbeat every WD_POLL_MS; declare a stall once it has not advanced for WD_STALL_MS.
' Runs forever: declareStall() never returns.
'
' @local lastSeenBeat - wdHeartbeat at the previous sample
' @local lastChangeMs - getms() when wdHeartbeat last changed
' @local msSinceBeat - ms since wdHeartbeat last changed

    lastSeenBeat := wdHeartbeat
    lastChangeMs := getms()
    repeat
        waitms(WD_POLL_MS)
        if wdHeartbeat <> lastSeenBeat
            lastSeenBeat := wdHeartbeat
            lastChangeMs := getms()
        else
            msSinceBeat := getms() - lastChangeMs
            if msSinceBeat >= WD_STALL_MS
                declareStall(msSinceBeat)

PRI declareStall(msSinceBeat)
' Cog 0 has stalled: set wdDeclaring first, snapshot, stop wheelL, wheelR and the steering object
' (never through a beat() wrapper), then emit BM-WATCHDOG, BM-WATCHDOG2, this part's NOSTALL FAIL,
' BM-END exit WATCHDOG and the marker through the watchdog's own builder, and idle forever. It never
' commands the instrument (not its value to write, sec 2.4). Its seq continues from logSeq.
'
' @param msSinceBeat - ms since wdHeartbeat last changed

    wdDeclaring := TRUE
    wdSeq := logSeq
    wdSnapshotStall()
    wheelL.stop()
    wheelR.stop()
    steering.stop()
    wdEmitWatchdog(msSinceBeat)
    wdEmitWatchdog2()
    if SF_JUDGES_CELLS
        wdEmitNoStall()
    wdEmitEnd()
    ' QUOTED, not backticked: matches main()'s marker exactly
    debug("DEBUG_END_SESSION")
    repeat
        waitms(WD_IDLE_MS)

PRI wdSnapshotStall()
' Snapshot, before the stops, every value the watchdog records report (watchdog cog). The source is the
' steering object when either of its drivers is up, else the two wheel instances. Direct getters only.

    wdSnapCheckpoint := wdCheckpoint
    wdSnapInstState := instState
    wdSnapLeftCog := wheelL.testGetMotorCog()
    wdSnapRightCog := wheelR.testGetMotorCog()
    wdSnapState[SLOT_LEFT], wdSnapState[SLOT_RIGHT] := steering.testGetDriverState()
    wdSnapSteerUp := (wdSnapState[SLOT_LEFT] <> DCS_UNKNOWN) or (wdSnapState[SLOT_RIGHT] <> DCS_UNKNOWN)
    if wdSnapSteerUp
        wdSnapDuty[SLOT_LEFT], wdSnapErr[SLOT_LEFT], wdSnapSenseI[SLOT_LEFT], _, _, _, wdSnapState[SLOT_LEFT], wdSnapFault[SLOT_LEFT] := steering.testLeftGetTelemetry()
        wdSnapDuty[SLOT_RIGHT], wdSnapErr[SLOT_RIGHT], wdSnapSenseI[SLOT_RIGHT], _, _, _, wdSnapState[SLOT_RIGHT], wdSnapFault[SLOT_RIGHT] := steering.testRightGetTelemetry()
        wdSnapPos[SLOT_LEFT], wdSnapPos[SLOT_RIGHT] := steering.testGetRawHallTicks()
    else
        wdSnapDuty[SLOT_LEFT], wdSnapErr[SLOT_LEFT], wdSnapSenseI[SLOT_LEFT], _, _, _, wdSnapState[SLOT_LEFT], wdSnapFault[SLOT_LEFT] := wheelL.testGetTelemetry()
        wdSnapDuty[SLOT_RIGHT], wdSnapErr[SLOT_RIGHT], wdSnapSenseI[SLOT_RIGHT], _, _, _, wdSnapState[SLOT_RIGHT], wdSnapFault[SLOT_RIGHT] := wheelR.testGetTelemetry()
        wdSnapPos[SLOT_LEFT] := wheelL.getRawHallTicks()
        wdSnapPos[SLOT_RIGHT] := wheelR.getRawHallTicks()

PRI wdRecBegin(pTag)
' Start a watchdog record in wdLog (never cog 0's builder) with the watchdog's own seq.
'
' @param pTag - pointer to the record tag

    wdLog.begin(pTag)
    wdSeq := (wdSeq + 1) <# LIM_MID
    wdLog.numField(@"seq", wdSeq, LIM_MID)

PRI wdEmitRecord() | pRecord
' Emit the watchdog's assembled record: the watchdog's one record debug() statement. No beat().
'
' @local pRecord - pointer to the zero-terminated record

    pRecord := wdLog.pLine()
    debug(zstr_(pRecord))

PRI wdEmitWatchdog(msSinceBeat)
' BM-WATCHDOG. Worst case 142 bytes.
'
' @param msSinceBeat - ms since wdHeartbeat last changed

    wdRecBegin(@"BM-WATCHDOG")
    wdLog.numField(@"ms", msSinceBeat, LIM_SMALL)
    wdLog.numField(@"checkpoint", wdSnapCheckpoint, LIM_TINY)
    wdLog.tokenField(@"cp_tok", tokenAt(@tokCp, CP_COUNT, wdSnapCheckpoint), TOKMAX_CP)
    wdLog.numField(@"l_cog", wdSnapLeftCog, LIM_TINY)
    wdLog.numField(@"r_cog", wdSnapRightCog, LIM_TINY)
    wdLog.boolField(@"steer_up", wdSnapSteerUp)
    wdLog.tokenField(@"inst_state", tokenAt(@tokInstSt, INST_ST_COUNT, wdSnapInstState), TOKMAX_INSTST)
    wdLog.boolField(@"stack_ok", wdStackSentinel == WD_STACK_SENTINEL)
    wdEmitRecord()

PRI wdEmitWatchdog2()
' BM-WATCHDOG2: both motors' pre-stop telemetry. Worst case 193 bytes.

    wdRecBegin(@"BM-WATCHDOG2")
    wdLog.tokenField(@"l_st", dcsToken(wdSnapState[SLOT_LEFT]), TOKMAX_STATE)
    wdLog.boolField(@"l_flt", wdSnapFault[SLOT_LEFT])
    wdLog.numField(@"l_duty", wdSnapDuty[SLOT_LEFT], LIM_SMALL)
    wdLog.numField(@"l_err", wdSnapErr[SLOT_LEFT], LIM_TINY)
    wdLog.numField(@"l_i", wdSnapSenseI[SLOT_LEFT], LIM_SMALL)
    wdLog.numField(@"l_pos", wdSnapPos[SLOT_LEFT], LIM_MID)
    wdLog.tokenField(@"r_st", dcsToken(wdSnapState[SLOT_RIGHT]), TOKMAX_STATE)
    wdLog.boolField(@"r_flt", wdSnapFault[SLOT_RIGHT])
    wdLog.numField(@"r_duty", wdSnapDuty[SLOT_RIGHT], LIM_SMALL)
    wdLog.numField(@"r_err", wdSnapErr[SLOT_RIGHT], LIM_TINY)
    wdLog.numField(@"r_i", wdSnapSenseI[SLOT_RIGHT], LIM_SMALL)
    wdLog.numField(@"r_pos", wdSnapPos[SLOT_RIGHT], LIM_MID)
    wdEmitRecord()

PRI wdEmitNoStall()
' This part's R14-DUAL-NOSTALL-* as FAIL from the watchdog cog: measured FALSE, n 1. Worst case 173 bytes.

    wdLog.begin(@"SIGNOFF")
    wdLog.numField(@"sf", SF_VERSION, LIM_TINY)
    wdLog.tokenField(@"bin", @sSfBin, TOKMAX_BIN)
    wdLog.tokenField(@"cell", partNoStallCell(), TOKMAX_CELL)
    wdLog.tokenField(@"task", @sSfTask, TOKMAX_TASK)
    wdLog.tokenField(@"motor", sideToken(SIDE_NONE), TOKMAX_MOTOR)
    wdLog.tokenField(@"crit", @sSfCritCog0End, TOKMAX_CRIT)
    wdLog.boolField(@"measured", FALSE)
    wdLog.textField(@"lo", @sSfTrue)
    wdLog.textField(@"hi", @sSfTrue)
    wdLog.tokenField(@"units", @sSfUnitsBool, TOKMAX_UNITS)
    wdLog.numField(@"n", SIGNOFF_ONE_INSTANCE, LIM_SMALL)
    wdLog.tokenField(@"verdict", @sSfFail, TOKMAX_SFVERDICT)
    wdEmitRecord()

PRI wdEmitEnd()
' BM-END exit WATCHDOG from the watchdog cog; trap_code NA because runPart() never returned to main().
' Worst case 152 bytes.

    wdRecBegin(@"BM-END")
    wdLog.tokenField(@"exit", tokenAt(@tokExit, EXIT_COUNT, EXIT_WATCHDOG), TOKMAX_EXIT)
    wdLog.tokenField(@"part", tokenAt(@tokPart, PART_COUNT, PART_ID), TOKMAX_PART)
    wdLog.numField(@"segs", segsRun, LIM_TINY)
    wdLog.tokenField(@"last_seg", segToken(lastSeg), TOKMAX_SEG)
    wdLog.numField(@"records", wdSeq, LIM_MID)
    wdLog.naNumField(@"trap_code", 0, LIM_BIG, FALSE)
    wdLog.numField(@"unrecov", unrecovTotal, LIM_TINY)
    wdLog.tokenField(@"why", tokenAt(@tokWhy, WHY_COUNT, WHY_NOT_REACHED), TOKMAX_WHY)
    wdEmitRecord()

CON { --- cog-0 heartbeat --- }

PRI beat(checkpointId)
' Advance cog 0's heartbeat and record its checkpoint (cog 0 only; the watchdog and the instrument must
' never call this). Once the watchdog has declared, beat() never returns: a slow cog 0 that resumes
' parks here and cannot command a motor the watchdog already stopped (test_bench_scan.spin2 beat()).
'
' @param checkpointId - CP_* naming the statement group cog 0 is now inside

    if wdDeclaring
        repeat
            waitms(WD_IDLE_MS)
    wdCheckpoint := checkpointId
    wdHeartbeat += 1

