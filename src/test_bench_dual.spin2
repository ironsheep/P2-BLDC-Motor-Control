' THE END OF THE SIGN-OFF STRING RUN (SRC_REV 71). Every string from sSfBin to here is one zero-terminated string after
'  another, and tokenTablesSelfTest() reads them in order to this sentinel, holding each cell id (R, two digits and a hyphen
'  begin it) to TOKMAX_CELL and every other string to TOKMAX_CRIT. A cell or criterion string goes ABOVE this line.
                BYTE    TOK_END

CON { token-table geometry and wait kinds }

    ' tokenAt() steps over at most TOKEN_SCAN_MAX bytes of each token before the one it returns, so a token longer than
    '  that misplaces every token after it; the self-check holds every packed token to it. 40, since SRC_REV 71: the longest
    '  is sFenWords' fourth word, 37 bytes (32 read it as a 32-byte token and landed inside it).
    TOKEN_SCAN_MAX = 40
    ' The sentinel that closes every packed token table: the byte after the last token's terminator. A table is its tokens, then
    '  TOK_END, so the self-check finds a table's end, and counts its tokens, without trusting the enum count it checks against.
    TOK_END = 0
    ' estPlan (BM-PLAN's est_s and est_kb, one row per SEG_*): a row is EST_ROW_WORDS words, EST_SECS then EST_KB, and the row
    '  after the last is EST_END in both (a value no plan reaches), so the self-check counts rows without trusting SEG_COUNT
    EST_SECS = 0
    EST_KB = 1
    EST_ROW_WORDS = 2
    EST_END = $FFFF
    ' The self-check's own limits: TOKMAX_TABNAME is the longest table name BM-TOKCHK's first_bad prints (tokAbiLaunch, 12,
    '  is the longest there is); SF_RUN_MAX_STRINGS bounds the walk of the sign-off string run (about 320 strings today),
    '  so a run that lost its TOK_END is found, not read to the end of the hub
    TOKMAX_TABNAME = 16
    SF_RUN_MAX_STRINGS = 600

  ' What a watched wait ends on, besides its time bound and a safety event:
  '  UNTIL_TIME     - only the time bound
  '  UNTIL_STOPPED  - every watched motor's mirrored state reads DCS_STOPPED
  '  UNTIL_AT_SPEED - every watched motor's mirrored state reads DCS_AT_SPEED
  '  UNTIL_MOVING   - every watched motor is up and its mirrored state is not DCS_STOPPED
  '  UNTIL_TRAVEL   - SRC_REV 62, part SPIN's floor legs only: the farther wheel's travel since its leg began (the driver's
  '                   own pos on the mirror) reaches the leg's mark (spinWatch(), loadWatch())
    #0, UNTIL_TIME, UNTIL_STOPPED, UNTIL_AT_SPEED, UNTIL_MOVING, UNTIL_TRAVEL

  ' The event a wheel trace marks (eventCapture()):
  '  EVT_STOPMOTOR - stopMotor(): cause STOPCMD
  '  EVT_STOPCOG   - stop(): cause STOPCOG; the driver cog ends and only hwPos sees the coast
  '  EVT_ESTOP     - emergencyCutoff(): cause ESTOP
  '  EVT_OFFSET    - testSetFwdRevIndep() shifted by faultShiftDeg() at speed: cause FAULT (task 3572, PL-59)
  '  EVT_START     - the command FROM REST: cause START (task 3593, R18.2d). The only event whose mark
  '                  precedes the motion instead of following it, so it has its own capture routine
  '  EVT_SLOWER    - a slower command from a running speed: cause SLOWER (task 3604, E3's ramp_down). The
  '                  capture ends at AT_SPEED on the new speed, not at rest
    #0, EVT_STOPMOTOR, EVT_STOPCOG, EVT_ESTOP, EVT_OFFSET, EVT_START, EVT_SLOWER

VAR { run-wide state -- cog 0 only }

    LONG    logSeq                                          ' seq of the last cog-0 record (I8), saturates at LIM_MID
    LONG    runStartMs                                      ' getms() at run start
    LONG    bRunAborted                                     ' TRUE once a run-scope abort was recorded
    LONG    bRunReturned                                    ' TRUE once runPart() reached its end
    LONG    runTrapCode                                     ' the top-level trap's value, printed every run
    LONG    runFaults                                       ' faults seen run-wide (RUN_FAULT_CAP)
    LONG    unrecovTotal                                    ' BM-UNRECOV records run-wide
    LONG    segsRun                                         ' segments that emitted BEGIN
    LONG    lastSeg                                         ' SEG_* of the last BEGIN
    LONG    curSeg                                          ' SEG_* in progress, SEG_NONE between segments
    LONG    curTid                                          ' trace id in progress, 0 when none
    LONG    curIncre                                        ' last commanded increment, for BM-ABORT
    LONG    segStartMs
    LONG    segItems
    LONG    segFaults
    LONG    segUnrecov
    LONG    lastStartMs                                     ' getms() of the last wheel or steering start
    LONG    bAnyStart
    LONG    lifeSeq                                         ' driver lifetimes started, run-wide
    LONG    traceSeq                                        ' tid source
    LONG    rungSeq                                         ' rid source
    LONG    steerSeq                                        ' sid source
    LONG    instBusyRefusals                                ' wrapper refusals because the instrument was busy (I10)
    LONG    slotLife[INST_MOTORS]                           ' lifeSeq of each wheel's current lifetime
    LONG    bSlotRetired[INST_MOTORS]                       ' MOTOR_RETIRED by recovery step 4
    LONG    lifeZeroX10[INST_MOTORS]                        ' this lifetime's floated zero-command sense_i mean x10
    LONG    lifePhX10[INST_MOTORS]                          ' this lifetime's floated phase-sum mean x10
    LONG    bLifeZeroValid[INST_MOTORS]
    LONG    bBrakeRequested[INST_MOTORS]                    ' holdAtStop(TRUE) issued and not yet released (I6)
    LONG    steerLife                                       ' lifeSeq of the steering object's current lifetime
    LONG    bSteerUp                                        ' steering.start() succeeded and stop() not yet called
    LONG    safeAbsCount[INST_MOTORS]                       ' consecutive mirror reads at or above ABS_ABORT_MV
    LONG    safeLastHeartbeat
    LONG    safeLastHeartbeatMs
    LONG    bQuietMasks                                     ' the compiled masks are the quiet set (sec 12.6)

VAR { instrument shared memory -- ownership table, design sec 2.4 }

    ' written by cog 0, read by the instrument
    LONG    instCmd
    LONG    instArg0
    LONG    instArg1
    LONG    instArg2
    LONG    instCmdSeq
    LONG    instSrc
    LONG    instDecimate
    LONG    instMarkCt                                      ' getct() written immediately before the event's library call
    LONG    instMarkSeq
    ' LAGBOUND (task 3558): cog 0 raises this while a step provokes the lag on purpose -- a commutation
    '  offset written 180 degrees from the default, or a limit lowered until the rotor cannot follow --
    '  so a deliberate provocation is never folded into the run's maximum
    LONG    bInstLagExempt
    ' written by the instrument, read by cog 0 (and the watchdog: instHeartbeat, instState only)
    LONG    instAckSeq
    LONG    instState
    LONG    instHeartbeat
    LONG    instW                                           ' ring index of the last stored sample
    LONG    instTotal                                       ' samples stored since ARM, saturates at LIM_BIG
    LONG    instMarkTotal                                   ' instTotal on the first pass that saw the latest mark, -1 at ARM (sec 12.7)
    LONG    instMarkAckSeq                                  ' the instMarkSeq instMarkTotal belongs to; written after instMarkTotal
    LONG    instLate                                        ' per capture, cleared at ARM
    LONG    instSkipped
    LONG    instMaxLateTicks
    LONG    instClamps
    LONG    instIntegSat
    LONG    instHwSkip[INST_MOTORS]
    LONG    instLastI[INST_MOTORS]                          ' last-sample mirror (sec 2.8)
    LONG    instLastState[INST_MOTORS]
    LONG    instLastFault[INST_MOTORS]
    LONG    instLastUp[INST_MOTORS]
    LONG    instLastPos[INST_MOTORS]
    LONG    instLastHw[INST_MOTORS]
    ' LAGBOUND: the run's largest |err| per motor over stored samples with the driver up, not faulted and
    '  not exempt, and how many samples were folded. Run-wide: never cleared by ARM, so one reading covers
    '  every capture the part took.
    LONG    instLagMax[INST_MOTORS]
    LONG    instLagN[INST_MOTORS]
    ' PWMCLIP (task 3604, LIMITS build only): the least and greatest high-side PWM level the driver wrote,
    '  per motor, over the capture's stored samples with the driver up and not faulted, and how many were
    '  folded. Per capture: cleared at ARM, so a rung's reading covers its transition and its window.
    LONG    instLvlMin[INST_MOTORS]
    LONG    instLvlMax[INST_MOTORS]
    LONG    instLvlN[INST_MOTORS]
    LONG    instRunSamples                                  ' run-wide, never cleared, saturate at LIM_BIG
    LONG    instRunLate
    LONG    instRunSkipped
    LONG    instRunMaxLateTicks
    LONG    instRunClamps
    LONG    ring[INST_RING_LONGS]
    ' owned by cog 0
    LONG    instStack[INST_STACK_LONGS]
    LONG    instCogId                                       ' cogspin()'s return; < 0 when it failed

VAR { instrument scratch -- written and read by the instrument cog only (keeps its stack small) }

    LONG    isDuty[INST_MOTORS]
    LONG    isErr[INST_MOTORS]
    LONG    isSenseI[INST_MOTORS]
    LONG    isSenseU[INST_MOTORS]
    LONG    isSenseV[INST_MOTORS]
    LONG    isSenseW[INST_MOTORS]
    LONG    isState[INST_MOTORS]
    LONG    isFault[INST_MOTORS]
    LONG    isUp[INST_MOTORS]
    LONG    isPos[INST_MOTORS]
