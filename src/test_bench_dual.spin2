    LONG    bSfLiveRan[INST_MOTORS]                         ' INSTLIVE: the QTR rung reached AT_SPEED
    LONG    bSfLiveOk[INST_MOTORS]
    LONG    sfFrameCaps[INST_MOTORS]                        ' IDLEFLT: motor-frame captures
    LONG    sfIdleUp[INST_MOTORS]
    LONG    sfTraces                                        ' TRACES: traces in this load
    LONG    sfTraceLost
    LONG    bSfClkRan[INST_MOTORS]                          ' CLKFRAME
    LONG    bSfClkOk[INST_MOTORS]
    LONG    sfFaults[INST_MOTORS]                           ' RSTPROV: faults
    LONG    sfResetUncleared[INST_MOTORS]
    LONG    bSfRampRan[INST_MOTORS]                         ' RAMPREST: the last restore's read-back
    LONG    bSfRampOk[INST_MOTORS]
    LONG    bSfOffRan[INST_MOTORS]                          ' OFFREST: every restore's read-back, ANDed
    LONG    bSfOffOk[INST_MOTORS]
    LONG    bSfFltApiRan                                    ' FLTAPI: the provocation faulted, so the API could be judged
    LONG    bSfFltApiOk
    LONG    bSfBrakeRan                                     ' BRAKEFLT
    LONG    bSfBrakeSeen
    LONG    bSfFloorRan                                     ' FLOORANS
    LONG    bSfFloorAnswered
    LONG    bSfUiRan                                        ' UICHECK
    LONG    bSfUiOk                                         ' every UICHECK step was OK
    LONG    uiStepCount                                     ' BM-UISTEP records emitted

    ' task 3560 accumulators. Each pair is (ran, ok): a cell whose step never ran prints NOMEAS, which is
    '  how a criterion this rig cannot provoke stays visible instead of passing by silence.
    LONG    bSfNoFoldRan[INST_MOTORS]                       ' NOFOLD: no derate at any of the ladder's base rungs
    LONG    bSfNoFoldOk[INST_MOTORS]
    LONG    bSfRateLawRan[INST_MOTORS]                      ' RATELAW (PL-79): the same rungs' rate against the law
    LONG    bSfRateLawOk[INST_MOTORS]
