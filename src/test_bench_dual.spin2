    LONG    cpWhy                                           ' WHY_* the trace is not the requested event, NONE when it is
    LONG    cpEnd                                           ' TEND_* naming why the capture ended
    LONG    bCpFrozen                                       ' the capture was frozen (drain legal, I10)
    LONG    bCpFaultSeen                                    ' a fault flag was seen during the trial
    LONG    cpWantNeg                                       ' offsets read immediately before the measurement
