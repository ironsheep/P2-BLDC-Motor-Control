  ' PL-152: the DBG_* group symbols -- code two or more parts share, compiled into exactly those parts' images. Each is
  '  an #ifdef/#elseifdef list of the DBP_* symbols above (the preprocessor has no OR and no expression), and each
  '  names its members in its comment. Code every part needs (the instrument, the safety monitor, the watched waits,
  '  the wheel and steering wrappers, the record emitters of the shared records, the sign-off emitters) is not gated.
  '  DBG_PREFLT   - the PREFLT segment and its PL-136 retry: A CLOCK B C D LEAD LIMITS FAULTRESP REG KICK
#ifdef DBP_A
#define DBG_PREFLT
#elseifdef DBP_CLOCK
#define DBG_PREFLT
#elseifdef DBP_B
#define DBG_PREFLT
#elseifdef DBP_C
#define DBG_PREFLT
#elseifdef DBP_D
#define DBG_PREFLT
#elseifdef DBP_LEAD
#define DBG_PREFLT
#elseifdef DBP_LIMITS
#define DBG_PREFLT
#elseifdef DBP_FAULTRESP
#define DBG_PREFLT
#elseifdef DBP_REG
#define DBG_PREFLT
#elseifdef DBP_KICK
#define DBG_PREFLT
#endif
