    LONG    rampPowerCmd                                    ' the power commanded, signed: positive out, negative back
    LONG    rampDirCmd                                      ' ...and its sign, SIGN_POS or SIGN_NEG
    LONG    rampAccelSet                                    ' the settings the leg was given, mm/s^2
    LONG    rampDecelSet
    LONG    rampAccelRd                                     ' ...and read back from the steering object
    LONG    rampDecelRd
    LONG    rampSetErr                                      ' setAcceleration()'s or setDeceleration()'s return
    LONG    rampArmErr                                      ' the leg's distance limit's return
    LONG    rampDriveErr                                    ' driveAtPower()'s return
    LONG    rampStopBy                                      ' SPSTOP_*
    LONG    rampWhy                                         ' why the leg ended short
    LONG    bRampDriven                                     ' driveAtPower() was called
    LONG    bRampOn                                         ' spinWatch() samples the drivers' acceleration (rampSample())
    LONG    bRampMoved                                      ' both wheels have left DCS_STOPPED since the command
    LONG    bRampAt                                         ' both wheels have read AT_SPEED
    LONG    bRampStopSeen                                   ' the leg's distance stop has begun (a target at zero)
    LONG    bRampRest                                       ' both wheels read STOPPED at the leg's end
    LONG    rampCmdMs                                       ' getms() at the command
    LONG    rampAtMs                                        ' command to both AT_SPEED, ms
    LONG    rampStopMs                                      ' getms() when the stop was seen to begin
    LONG    rampRestMs                                      ' ...and when both wheels read STOPPED
    LONG    rampStopTicks                                   ' the farther wheel's travel from the stop's beginning to rest, ticks
    LONG    rampStatusPtr[INST_MOTORS]                      ' each driver's status run (drv_accel_now is read there, no library call)
    LONG    rampDirSign[INST_MOTORS]                        ' +1 where the commanded direction is the increment's positive one
    LONG    rampPeakUp[INST_MOTORS]                         ' the largest speed-up acceleration seen before the stop began, mm/s^2
    LONG    rampPeakDn[INST_MOTORS]                         ' ...and the largest slow-down seen after
    LONG    rampStopPos[INST_MOTORS]                        ' each wheel's raw pos when the stop was seen to begin
    LONG    rampTravel[INST_MOTORS]                         ' each wheel's raw travel over the leg
    LONG    rampPredAtMs                                    ' the S-curve's prediction: command to AT_SPEED, ms
    LONG    rampPredUp                                      ' ...its peak speed-up acceleration, mm/s^2
    LONG    rampPredDn                                      ' ...its peak slow-down acceleration
    LONG    rampPredStopTk                                  ' ...and the stop's travel, ticks
    LONG    bRampChanged                                    ' a setting was made: the built-in rates are owed back
    ' the legs' results (the session's RESULT line)
    LONG    sessRampTried                                   ' legs commanded
    LONG    sessRampLimit                                   ' ...that ended at their limit
#endif

#ifdef DBG_FENCE
PRI sessReset() | trialIdx
' Clear the floor session's state (initRunState()): the platform at its start point, facing across the square, every straight
' action allowed, every count 0, the RESULT buffer empty.
'
' @local trialIdx - BLK_* trial index

    fenX100 := 0
    fenY100 := 0
    fenHead := 0
    fenBase[SLOT_LEFT] := 0
    fenBase[SLOT_RIGHT] := 0
    fenRefused := 0
    fenDoneLegs := 0
    bStraightsOk := TRUE
    sessSkipWhy := WHY_NONE
    sessSkipCount := 0
    sessSpinDriven := 0
    sessSpinLimit := 0
    sessSpinWhy := WHY_NONE
    bSessFrRan := FALSE
    bSessFrOk := FALSE
    sessOwedTicks := 0
    repeat trialIdx from 0 to BLK_KINDS - 1
        bSessObstRan[trialIdx] := FALSE
        sessTrialWhy[trialIdx] := WHY_NONE
        sessObstBody[trialIdx] := @sResEmpty
        sessObstWhy[trialIdx] := @sResEmpty
        sessBackState[trialIdx] := SBK_NONE
        sessBackWhy[trialIdx] := WHY_NONE
#ifdef DBF_RAMP
    sessRampTried := 0
    sessRampLimit := 0
    bRampChanged := FALSE
    bRampOn := FALSE
#endif
    resReset()

PRI fenceMark() | slotIdx
' Take each wheel's raw pos, from the instrument's mirror, as the zero the next estimate counts from. flLegBegin() calls it
' once the capture is armed (the mirror is live only then), so every leg's travel is counted from where the leg began: a fresh
' lifetime's drivers restart their pos, and the mirror follows them.
'
' @local slotIdx - motor slot

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        fenBase[slotIdx] := instLastPos[slotIdx]

PRI fenceAdvance(eWhat, nLegNum) | slotIdx, nLeftFwd, nRightFwd, nMeanX100, nTurn, nMidHead, nPartX, nPartY
' The fence's estimate after a leg has come to rest (this section's CON): each wheel's FORWARD travel since the mark -- the left
' wheel's raw change, the right's negated -- the heading turned by their difference (a tick of it is FENCE_ANGLE_PER_TICK), and
' the mean travel along the heading at the leg's middle. The mark moves to where the wheels are, so a second call counts only
' what came after. Prints BM-FENCE (DONE).
'
' @param eWhat - FEN_*: the drive that ended
' @param nLegNum - the leg's number within its part, 0 when it has none
'
' @local slotIdx - motor slot
' @local nLeftFwd - the left wheel's forward travel, ticks
' @local nRightFwd - the right wheel's
' @local nMeanX100 - the mean travel, 0.01 mm, forward positive
' @local nTurn - the heading turned, angle units (modulo a turn)
' @local nMidHead - the heading at the leg's middle
' @local nPartX - the travel's x part, 0.01 mm
' @local nPartY - its y part

    nLeftFwd := instLastPos[SLOT_LEFT] - fenBase[SLOT_LEFT]
    nRightFwd := fenBase[SLOT_RIGHT] - instLastPos[SLOT_RIGHT]
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        fenBase[slotIdx] := instLastPos[slotIdx]
    nMeanX100 := ((nLeftFwd + nRightFwd) * TICK_MM_X100) / 2
    nTurn := (nRightFwd - nLeftFwd) * FENCE_ANGLE_PER_TICK
    nMidHead := fenHead + (nTurn SAR 1)
    nPartX, nPartY := polxy(abs(nMeanX100), nMidHead)
    if nMeanX100 < 0
        nPartX := 0 - nPartX
        nPartY := 0 - nPartY
    fenX100 += nPartX
    fenY100 += nPartY
    fenHead += nTurn
    fenDoneLegs += 1
    emitFence(FENEV_DONE, eWhat, nLegNum, 0, 0, 0, fenceHomeMm() <= FENCE_HOME_MM)

PRI bFenceAllows(nLegTicks, eWhat, nLegNum) : bAllowed | nReachX100, nPartX, nPartY, nEndX, nEndY, nMarginX100
' THE FENCE CHECK, before a straight leg is armed (this section's CON): where the leg could end if it ran to its declared
' travel and the harness's guard had to stop it -- nLegTicks and FL_OVER_TICKS more, along the heading, backward for a
' negative nLegTicks -- against the square pulled in by the platform's half-length and the slack. Prints BM-FENCE (PLAN), and, when
' the leg would leave the square, a plain FENCE line: the leg is then not run.
'
' @param nLegTicks - the leg's declared travel, hall ticks, forward positive
' @param eWhat - FEN_*: the drive about to be armed
' @param nLegNum - the leg's number within its part, 0 when it has none
' @returns bAllowed - TRUE when the leg's worst-case end is inside the square
'
' @local nReachX100 - the worst-case travel, 0.01 mm
' @local nPartX - its x part
' @local nPartY - its y part
' @local nEndX - the worst-case end's x, 0.01 mm
' @local nEndY - its y
' @local nMarginX100 - the least distance to the pulled-in edges, 0.01 mm; negative when past one

    nReachX100 := (abs(nLegTicks) + FL_OVER_TICKS) * TICK_MM_X100
    nPartX, nPartY := polxy(nReachX100, fenHead)
    if nLegTicks < 0
        nPartX := 0 - nPartX
        nPartY := 0 - nPartY
    nEndX := fenX100 + nPartX
    nEndY := fenY100 + nPartY
    nMarginX100 := (nEndX - (FENCE_X_LO_MM * SPIN_X100)) <# ((FENCE_X_HI_MM * SPIN_X100) - nEndX)
    nMarginX100 <#= nEndY - (FENCE_Y_LO_MM * SPIN_X100)
    nMarginX100 <#= (FENCE_Y_HI_MM * SPIN_X100) - nEndY
    bAllowed := (nMarginX100 >= 0)
    emitFence(FENEV_PLAN, eWhat, nLegNum, nEndX, nEndY, nMarginX100 / SPIN_X100, bAllowed)
    if bAllowed == FALSE
        fenRefused += 1
        sayFenceRefusal(tokenAt(@sFenWords, FEN_COUNT, eWhat), (0 - nMarginX100) / SPIN_X100)

PRI fenceHomeMm() : nHomeMm | nXmm, nYmm
' How far the platform's estimate is from its start point.
'
' @returns nHomeMm - millimetres
'
' @local nXmm - x, millimetres
' @local nYmm - y

    nXmm := fenX100 / SPIN_X100
    nYmm := fenY100 / SPIN_X100
    nHomeMm := sqrt((nXmm * nXmm) + (nYmm * nYmm))

PRI bSessStraightsMayGo(pWords) : bMayGo
' Whether the session's straight actions may go on; when they may not, a plain line says which action was skipped and why.
'
' @param pWords - pointer to the action's name in plain words
' @returns bMayGo - TRUE until a straight action has failed

    bMayGo := (bStraightsOk <> FALSE)
    if bMayGo == FALSE
        sessSkipCount += 1
        saySkipped(pWords, whyWords(sessSkipWhy))

PRI sessStraightEnd(bRanOk, whyCode)
' A straight action has ended: the session's straight actions go on only when it ran to its end AND the platform is back at
' its start (FENCE_HOME_MM); otherwise they stop, with the cause, and a plain line says so once.
'
' @param bRanOk - the action ran to its end
' @param whyCode - WHY_* the action ended on, WHY_NONE when it did not say

    if bStraightsOk
        if bRanOk == FALSE
            bStraightsOk := FALSE
            sessSkipWhy := whyCode
            if whyCode == WHY_NONE
                sessSkipWhy := WHY_NOT_CLEAR
        elseif fenceHomeMm() > FENCE_HOME_MM
            bStraightsOk := FALSE
            sessSkipWhy := WHY_NOT_AT_START
        if bStraightsOk == FALSE
            saySkipped(@"the remaining straight actions", whyWords(sessSkipWhy))

PRI emitFenceBuild()
' BM-FENCEBUILD: the fence's compiled numbers, printed before anything moves -- the square, the start point's distance from the
' rear edge, the assumed half-length and slack, the guard's ticks, the pulled-in edges (x from / to, y to either side), the
' tolerance for "back at the start", the tick in mm x 100 and in heading units. Worst case 214 bytes.

    recBegin(@"BM-FENCEBUILD")
    benchLog.numField(@"square_mm", FENCE_SQUARE_MM, LIM_SMALL)
    benchLog.numField(@"rear_mm", FENCE_REAR_MM, LIM_SMALL)
    benchLog.numField(@"half_len_mm", FENCE_HALF_LEN_MM, LIM_SMALL)
    benchLog.numField(@"slack_mm", FENCE_SLACK_MM, LIM_SMALL)
    benchLog.numField(@"over_tk", FL_OVER_TICKS, LIM_TINY)
    benchLog.numField(@"x_lo_mm", FENCE_X_LO_MM, LIM_SMALL)
    benchLog.numField(@"x_hi_mm", FENCE_X_HI_MM, LIM_SMALL)
    benchLog.numField(@"y_hi_mm", FENCE_Y_HI_MM, LIM_SMALL)
    benchLog.numField(@"home_mm", FENCE_HOME_MM, LIM_SMALL)
    benchLog.numField(@"tick_x100", TICK_MM_X100, LIM_SMALL)
    benchLog.numField(@"ang_tk", FENCE_ANGLE_PER_TICK, LIM_BIG)
    emitRecord()

PRI emitFence(eEvent, eWhat, nLegNum, nEndX100, nEndY100, nMarginMm, bOk)
' BM-FENCE: the fence at one drive -- its plan (FENEV_PLAN, before the leg is armed: where the worst case could end and how far
' inside the pulled-in square that is, negative when outside; ok is whether the leg may run) or its estimate (FENEV_DONE, after
' the leg has come to rest: the platform's position in the start frame, mm, and heading, tenths of a degree, left positive; ok
' is whether it is within FENCE_HOME_MM of the start). x_mm, y_mm, hdg_d10 and home_mm are the platform's position NOW (before
' the leg, for a plan). Worst case 174 bytes.
'
' @param eEvent - FENEV_PLAN or FENEV_DONE
' @param eWhat - FEN_*
' @param nLegNum - the leg's number within its part, 0 when it has none
' @param nEndX100 - a plan's worst-case end x, 0.01 mm
' @param nEndY100 - its y
' @param nMarginMm - a plan's margin inside the pulled-in square, mm
' @param bOk - the plan allows the leg, or the estimate is home

    recBegin(@"BM-FENCE")
    benchLog.tokenField(@"ev", tokenAt(@tokFenEv, FENEV_COUNT, eEvent), TOKMAX_FENEV)
    benchLog.tokenField(@"what", tokenAt(@tokFenWhat, FEN_COUNT, eWhat), TOKMAX_FENWHAT)
    benchLog.numField(@"leg", nLegNum, LIM_TINY)
    benchLog.numField(@"x_mm", fenX100 / SPIN_X100, LIM_SMALL)
    benchLog.numField(@"y_mm", fenY100 / SPIN_X100, LIM_SMALL)
    benchLog.numField(@"hdg_d10", ((fenHead SAR FENCE_TOP_SHIFT) * FENCE_TENTHS_PER_TURN) / FENCE_TOP_SCALE, LIM_SMALL)
    benchLog.numField(@"home_mm", fenceHomeMm(), LIM_SMALL)
    benchLog.naNumField(@"end_x_mm", nEndX100 / SPIN_X100, LIM_SMALL, eEvent == FENEV_PLAN)
    benchLog.naNumField(@"end_y_mm", nEndY100 / SPIN_X100, LIM_SMALL, eEvent == FENEV_PLAN)
    benchLog.naNumField(@"margin_mm", nMarginMm, LIM_SMALL, eEvent == FENEV_PLAN)
    benchLog.boolField(@"ok", bOk)
    emitRecord()

PRI sayFenceRefusal(pWords, nPastMm)
' One plain line for Stephen, printed when the fence refuses a leg: the drive, in words, and how far past the pulled-in square its
' worst-case end would be. A literal stands beside every formatted item (DEBUG puts ", " between two adjacent ones).
'
' @param pWords - pointer to the drive in plain words
' @param nPastMm - how far past the pulled-in square, mm

    beat(CP_EMIT)
    debug("FENCE: ", zstr_(pWords), " not run -- its worst case ends ", udec_(nPastMm), " mm outside the 2 m square's allowed area")
    beat(CP_EMIT)

PRI saySkipped(pWords, pWhy)
' One plain line for Stephen: an action, or the rest of the straight actions, that will not run, and why.
'
' @param pWords - pointer to what is skipped, in plain words
' @param pWhy - pointer to the cause in plain words

    beat(CP_EMIT)
    debug("SKIPPED: ", zstr_(pWords), " -- ", zstr_(pWhy))
    beat(CP_EMIT)

PRI resReset()
' Empty the RESULT line's buffer.

    resLen := 0
    resBuf[0] := 0

PRI resCatChar(nChar)
' Append one character to the RESULT line's buffer, and the terminator after it; a character that would not fit is dropped.
'
' @param nChar - the character

    if resLen < (RES_BUF_BYTES - 1)
        resBuf[resLen] := nChar
        resLen += 1
        resBuf[resLen] := 0

PRI resCat(pText) | nTextIdx
' Append a zero-terminated text to the RESULT line's buffer; what does not fit is dropped.
'
' @param pText - pointer to the text
'
' @local nTextIdx - the next character's index

    nTextIdx := 0
    repeat while byte[pText][nTextIdx] <> 0
        resCatChar(byte[pText][nTextIdx])
        nTextIdx += 1

PRI resCatDigits(nMagnitude)
' Append a non-negative number's decimal digits to the RESULT line's buffer.
'
' @param nMagnitude - the number, at least 0

    if nMagnitude >= RES_RADIX
        resCatDigits(nMagnitude / RES_RADIX)
    resCatChar("0" + (nMagnitude // RES_RADIX))

PRI resCatNum(nNumber)
' Append a signed number in decimal to the RESULT line's buffer.
'
' @param nNumber - the number

    if nNumber < 0
        resCatChar("-")
        resCatDigits(0 - nNumber)
    else
        resCatDigits(nNumber)

PRI resCatPosition()
' Append where the fence's dead reckoning puts the platform, in the start frame, to the RESULT line's buffer.

    resCat(@"; the platform ended at x ")
    resCatNum(fenX100 / SPIN_X100)
    resCat(@" mm, y ")
    resCatNum(fenY100 / SPIN_X100)
    resCat(@" mm, heading ")
    resCatNum((((fenHead SAR FENCE_TOP_SHIFT) * FENCE_TENTHS_PER_TURN) / FENCE_TOP_SCALE) / X10)
    resCat(@" degrees, from where it began (estimated from the wheels)")
#endif

PRI spResetCells() | slotIdx, arrIdx
' Clear the SPIN part's segment state and cell accumulators (initRunState()): every count 0 and every ran FALSE, so a
' cell no leg or trial reached prints NOMEAS.
'
' @local slotIdx - motor slot
' @local arrIdx - [leg * INST_MOTORS + slot] index

    bSpSegRan := FALSE
    spSegWhy := WHY_NONE
    crSegWhy := WHY_NONE
    frSegWhy := WHY_NONE
    spLifeSid := 0
    spLifeTick := 0
    bSpOffWritten := FALSE
    spGuardTicks := SPIN_LEG_TICKS
    spTravelMark := 0
    sfSpStopN := 0
    sfSpStopBad := 0
    sfSpOffN := 0
    sfSpOffBad := 0
    sfSpDirN := 0
    sfSpDirBad := 0
    bSfCrCoastRan := FALSE
    sfCrCoastTicks := 0
    bSfCrLowRan := FALSE
    sfCrLowTicks := 0
    blkSegWhy := WHY_NONE                                   ' SRC_REV 58/62: OBSTACLE's and GRAB's segments and cells
    ldSegWhy := WHY_NONE
    sfBlkN := 0
    sfBlkBad := 0
    sfClrN := 0
    sfClrBad := 0
    sfHeldN := 0
    sfHeldBad := 0
    bLdJudged := FALSE
    bSfLdPath := FALSE
    sfLdPathPm := 0
    bSfLdHunt := FALSE
    sfLdHunt := 0
    sfLdHoldN := 0
    sfLdHoldMs := 0
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        bSfBlkCoast[slotIdx] := FALSE                       ' SRC_REV 62: per wheel (both are blocked now)
        sfBlkCoastMv[slotIdx] := 0
        bSfBlkShort[slotIdx] := FALSE
        sfBlkShortMv[slotIdx] := 0
        sfRdN[slotIdx] := 0                                 ' SRC_REV 58: POSTFLT
        sfRdMax[slotIdx] := 0
        sfSpHuntN[slotIdx] := 0
        sfSpHuntBad[slotIdx] := 0
        sfSpErrN[slotIdx] := 0
        sfSpErrBad[slotIdx] := 0
        sfSpA1N[slotIdx] := 0
        sfSpA1Max[slotIdx] := 0
        sfSpA2N[slotIdx] := 0
        sfSpA2Max[slotIdx] := 0
        sfSpFolN[slotIdx] := 0
        sfSpFolMax[slotIdx] := 0
        sfSpRateN[slotIdx] := 0                             ' SRC_REV 75: the hold-speed fix's cells
        sfSpRateMin[slotIdx] := LIM_BIG
        sfSpHoldN[slotIdx] := 0
        sfSpHoldBad[slotIdx] := 0
        sfLgSamples[slotIdx] := 0
        sfLgBad[slotIdx] := 0
        spStatusPtr[slotIdx] := 0
        lgHeldBase[slotIdx] := 0
        lgHeldPrev[slotIdx] := 0
        lgHeldCmd[slotIdx] := 0
        lgLimPrev[slotIdx] := 0
        lgLimMs[slotIdx] := 0
        bLgLimSeen[slotIdx] := FALSE
        lgLimAdv[slotIdx] := 0
        lgSamples[slotIdx] := 0
        lgGive[slotIdx] := 0
        lgBad[slotIdx] := 0
        bSfCreepRan[slotIdx] := FALSE
        sfCreepTicks[slotIdx] := 0
        bSfCrHoldOk[slotIdx] := FALSE
    sfSpLegsTried := 0                                      ' SRC_REV 75: the hold-speed fix's cells
    sfLgLegBad := 0
    sfRampN := 0
    sfRampBad := 0
    bSfBlkLimRan := FALSE
    bSfBlkLimOk := FALSE
    bSfBlkWinRan := FALSE                                   ' SRC_REV 77
    bSfBlkWinOk := FALSE
    bSfBlkFltRan := FALSE
    bSfBlkFltOk := FALSE
    bSfLdFltRan := FALSE                                    ' SRC_REV 81
    bSfLdFltOk := FALSE
    repeat arrIdx from 0 to (SPIN_LEGS * INST_MOTORS) - 1
        spLegAmps[arrIdx] := 0
        bSpLegAmps[arrIdx] := FALSE
        spLegFol[arrIdx] := 0
        bSpLegFol[arrIdx] := FALSE
        spLegWhy[arrIdx] := WHY_NOT_REACHED                 ' a leg never recorded: it did not run (spinRecords() overwrites it)

#ifdef DBF_SPINLEG
PRI segSpin() | legIdx, whyCode
' SPIN (part SPIN, task 3591; SRC_REV 62: the fifth floor situation, ten legs; SRC_REV 69: ONE leg, once). The leg is
' the image's action (FLOOR_SPIN_KIND and FLOOR_SPIN_DIR: the pair -- SCHED at SLOW, MEDIUM or BRISK, or the LEGACY or
' FIXED control -- and clockwise or counter-clockwise), run straight after the lead-in. A leg that does not end at its
' limit prints its cause in BM-SPIN.
'
' @local legIdx - the action's row of the leg table, 0..SPIN_LEGS-1
' @local whyCode - why the segment ended short, WHY_NONE when the leg ended as it should

    segBegin(SEG_SPIN)
    bSpSegRan := TRUE
#ifdef DBF_AUTO
    whyCode := spinSession()                                ' SRC_REV 70, SESSION 2 part 1: all ten legs, each its own lifetime
#else
    legIdx := (spinActPair[FLOOR_SPIN_KIND] * SPIN_DIRS) + FLOOR_SPIN_DIR
    whyCode := spinLeg(legIdx)
#endif
    spSegWhy := whyCode
    ' if/else, never `? :` (PL-29): segWhy() is a call
    if whyCode <> WHY_NONE
        segEnd(whyCode)
    else
        segEnd(segWhy())

#ifdef DBF_AUTO
PRI spinSession() : whyCode | legIdx, legWhy
' SESSION 2, part 1 (R15; this section's CON, "the floor sessions"): the ten spin legs back to back, in the leg table's own
' order -- SLOW, MEDIUM, the LEGACY control, the quarter, the FIXED control, each RIGHT (clockwise) and then its LEFT pair, so the
' platform ends each pair facing where it began -- each through spinLeg(): its own pair lifetime, opened, driven, recorded, its
' event log drained, closed. SRC_REV 74: the quarter's two pairs turn TWO platform turns a leg (spinLegTicks). A spin is in place, so the legs go on after a failed leg; only a run that has aborted (its time or
' fault cap), a steering object that would not start and a wheel size the limit does not assume end the part early. The
' cells that compare pairs (SPINSYM, SPINCTL, SPINLEAD) are judged here, from all ten legs.
'
' @returns whyCode - WHY_NONE when every leg ran to its turn limit, else the first cause a leg ended short
'
' @local legIdx - 0..SPIN_LEGS-1
' @local legWhy - one leg's cause

    whyCode := WHY_NONE
    alignSay(@"PART 1 OF 3: ten spins in place, one turn each (two at the quarter), turning one way and then the other")
    repeat legIdx from 0 to SPIN_LEGS - 1
        beat(CP_LOOP_POLL)
        legWhy := spinLeg(legIdx)
        if bSpDriven
            sessSpinDriven += 1
            if spStopBy == SPSTOP_LIMIT
                sessSpinLimit += 1
        if (legWhy <> WHY_NONE) and (whyCode == WHY_NONE)
            whyCode := legWhy
        if bRunAborted or (legWhy == WHY_NO_COG) or (legWhy == WHY_TICK_SIZE_DIFFERS)
            quit
    sessSpinWhy := whyCode

#endif
PRI spinLeg(legIdx) : whyCode | pairIdx, dirIdx, speedIdx, tid
' The one leg (see the section's CON): its pair's steering lifetime, opened (spinOpenLifetime()); the motion to the
' limit (spinDrive()); the records (spinRecords()); a fault's recovery (a fault here is an END, never the event:
' SRC_REV 62 moved the FAULT legs to FAULTRUN); the lifetime closed, whatever the leg's end. SRC_REV 70, SESSION 2: the
' fence's estimate after the drive (fenceAdvance()) and the driver's event log, drained EV_SETTLE_MS after the leg and before its
' lifetime closes (EVST_SPIN): the spin logs printed no BM-EV, so the path limiter's engages there were invisible. SRC_REV 75: the
' drain is made in every SPIN image, and the leg's limiter facts are folded after it (limFoldSpinLeg(): BM-LIMW, SPINHOLD, LIMGIVE).
'
' @param legIdx - 0..SPIN_LEGS-1
' @returns whyCode - WHY_NONE when the leg ended at its limit, else why it did not
'
' @local pairIdx - the leg's pair
' @local dirIdx - SPIN_DIR_*
' @local speedIdx - SPIN_SPEED_*
' @local tid - trace id

    pairIdx := legIdx / SPIN_DIRS
    dirIdx := legIdx // SPIN_DIRS
    speedIdx := spinPairSpeed[pairIdx]
    spLegReset(legIdx)
    tid := nextTraceId()
    cpReset()
    whyCode := spinOpenLifetime(pairIdx)
    spSid := spLifeSid                                      ' so a lifetime that refused to drive still names what it read
    if whyCode == WHY_NONE
        whyCode := spinDrive(tid, dirIdx, speedIdx)
    else
        spWhy := whyCode
#ifdef DBG_FENCE
    if bSpDriven
        fenceAdvance(FEN_SPIN, legIdx + 1)                  ' SRC_REV 70: the leg's turn, into the heading, before its lifetime ends
#endif
    spinRecords(tid, legIdx, pairIdx, dirIdx, speedIdx)
    if bSteerUp and (spStopBy == SPSTOP_FAULT)
        steerRecoverFault(tid)                              ' counts it and cools; the leg's own why already ends the run
    if bSteerUp and bSpDriven
        waitBeat(EV_SETTLE_MS, CP_LOOP_REST)                ' SRC_REV 70: the event log, outside every timed wait
        evDrain(EVSRC_STEER, EVST_SPIN)                     ' SRC_REV 75: in EVERY SPIN image (it was the session's only): SPINHOLD and LIMGIVE judge the log
        limFoldSpinLeg(legIdx)
    if bSteerUp
        spinCloseLifetime()
    segItems := (segItems + 1) <# LIM_SMALL

PRI spLegReset(legIdx) | slotIdx
' Clear one leg's staging.
'
' @param legIdx - 0..SPIN_LEGS-1
'
' @local slotIdx - motor slot

    spLeg := legIdx
    sfSpLegsTried := (sfSpLegsTried + 1) <# LIM_SMALL         ' SRC_REV 75: SPINRATE and SPINHOLD hold every wheel to the legs begun
    spSid := 0
    spStopBy := SPSTOP_NOT_RUN
    spWhy := WHY_NONE
    spLeftPwr := 0
    spRightPwr := 0
    bSpDriven := FALSE
    spDriveErr := NO_ERROR
    spLimErr := NO_ERROR
    bSpReached := FALSE
    spAtMs := 0
    bSpWinValid := FALSE
    spWinMs := 0
    spWinStart := -1
    spWinEnd := -1
    spCmdMs := getms()
    bSpStopBegan := FALSE
    bSpOvertravel := FALSE
    spPathPm := 0
    bSpReadsValid := FALSE
    bSpTravelValid := FALSE
    bSpTrkValid := FALSE
    spAmpsN := 0
    spFaultSide := SIDE_NONE
    spGuardTicks := spinLegTicks[spinPairSpeed[legIdx / SPIN_DIRS]]   ' a spin leg's own travel; a floor leg sets its own (flLegBegin())
    spTravelMark := 0
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        spPos0[slotIdx] := 0
        spTravel[slotIdx] := 0
        spTrk[slotIdx] := 0
        spAmpsSum[slotIdx] := 0
        spOffNeg[slotIdx] := 0
        spOffPos[slotIdx] := 0
        spFolPm[slotIdx] := 0
        spFolPct[slotIdx] := 0
        bSpFolOk[slotIdx] := FALSE
        bSpShort[slotIdx] := FALSE
        bSpStartOk[slotIdx] := FALSE
        spAtK[slotIdx] := 0
        spLeaveK[slotIdx] := 0
        spRunMax[slotIdx] := 0
        spDropPm[slotIdx] := 0
        spPeakI[slotIdx] := 0
        spTailX10[slotIdx] := 0
        spRatioX100[slotIdx] := 0
        spExcessMv[slotIdx] := 0
        spTailN[slotIdx] := 0

PRI limFoldSpinLeg(legIdx) | slotIdx, nHeld, nPathAll, nLimAll, bJudged
' SRC_REV 75 (task 3657): one spin leg's limiter facts, right after its event drain (evDrain(), EVST_SPIN): BM-LIMW per wheel,
' SPINHOLD's instance per wheel, and LIMGIVE's limb (b). The leg is JUDGED only when the drain ended on EV_NONE with nothing
' lost (an event log that may have dropped a path-limiter event cannot show there was none) and both wheels' status runs were
' sampled (limSample()); otherwise it is neither counted nor can it settle either cell. A leg is BAD on a wheel when that
' wheel's lag limiter held while a command was in force (lgHeldCmd - lgHeldBase) or when the leg's log held any EV_PATH_LIMIT
' (the path limiter is the platform's: it scales one wheel because the other fell behind, so the leg is bad on both).
'
' @param legIdx - 0..SPIN_LEGS-1
'
' @local slotIdx - motor slot
' @local nHeld - the wheel's held passes over the leg
' @local nPathAll - EV_PATH_LIMIT events in the leg's log, both wheels
' @local nLimAll - EV_FOLDBACK and EV_CURRENT_LIMIT events in it, both wheels
' @local bJudged - T/F where T means the leg's drain and sampling were whole

    bJudged := bEvdClean() and (lgSamples[SLOT_LEFT] > 0) and (lgSamples[SLOT_RIGHT] > 0)
    nPathAll := evCount(EVI_LEFT, wheelL.EV_PATH_LIMIT) + evCount(EVI_RIGHT, wheelL.EV_PATH_LIMIT)
    nLimAll := evCount(EVI_LEFT, wheelL.EV_FOLDBACK) + evCount(EVI_RIGHT, wheelL.EV_FOLDBACK)
    nLimAll += evCount(EVI_LEFT, wheelL.EV_CURRENT_LIMIT) + evCount(EVI_RIGHT, wheelL.EV_CURRENT_LIMIT)
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        nHeld := lgHeldCmd[slotIdx] - lgHeldBase[slotIdx]
        if bJudged
            sfSpHoldN[slotIdx] := (sfSpHoldN[slotIdx] + 1) <# LIM_SMALL
            if (nHeld > 0) or (nPathAll > 0)
                sfSpHoldBad[slotIdx] := (sfSpHoldBad[slotIdx] + 1) <# LIM_SMALL
        emitLimW(SEG_SPIN, legIdx + 1, slotIdx, nHeld, evCount(EVI_LEFT + slotIdx, wheelL.EV_PATH_LIMIT), evCount(EVI_LEFT + slotIdx, wheelL.EV_FOLDBACK) + evCount(EVI_LEFT + slotIdx, wheelL.EV_CURRENT_LIMIT))
    if bJudged
        limFoldLegLimb(nPathAll, nLimAll)

PRI limFoldLegLimb(nPathAll, nLimAll)
' LIMGIVE's limb (b), one leg (a spin leg's or a ramp leg's, after its drain): when the leg's log holds path limiting it holds
' a claim -- some wheel was at its limit -- and the claim is BAD unless a limiter shows anywhere on the leg: an EV_FOLDBACK or
' EV_CURRENT_LIMIT in the log, or a duty_capped / foldback_frames advance the sampler saw on either wheel (the duty ceiling logs no
' event of its own). A leg with no path limiting makes no claim and is not counted.
'
' @param nPathAll - EV_PATH_LIMIT events in the leg's log, both wheels
' @param nLimAll - EV_FOLDBACK and EV_CURRENT_LIMIT events in it, both wheels

    if nPathAll > 0
        if (nLimAll == 0) and (lgLimAdv[SLOT_LEFT] == 0) and (lgLimAdv[SLOT_RIGHT] == 0)
            sfLgLegBad := (sfLgLegBad + 1) <# LIM_SMALL

PRI emitLimW(segCode, legNo, slotIdx, nHeld, nPathEv, nLimEv)
' BM-LIMW (SRC_REV 75, FMT 50): one wheel's limiter sample over one floor leg -- the segment (SPIN or RAMP) and leg number (1-based,
' BM-SPIN's leg or BM-RAMPLEG's), the wheel, the samples limSample() took, the passes its lag limiter held while a command was in
' force (held), the give-way slots (give), those with no limiter in the last LG_LOOK_MS (bad), the samples at which duty_capped or
' foldback_frames advanced (lim_adv), and this wheel's EV_PATH_LIMIT and EV_FOLDBACK + EV_CURRENT_LIMIT events in the leg's drain.
' Worst case 157 bytes: BM-LIMW 7 + ,seq, 5 + 10, then seg 13, leg 9, motor 12, samples 16, held 13, give 13, bad 12, lim_adv 16,
' path_ev 16, lim_ev 15 (a name, its two commas, and its widest value: a token at its TOKMAX, a number at its LIM).
'
' @param segCode - SEG_SPIN or SEG_RAMP
' @param legNo - the leg, 1-based
' @param slotIdx - motor slot
' @param nHeld - the wheel's held passes over the leg
' @param nPathEv - EV_PATH_LIMIT events in this wheel's log
' @param nLimEv - EV_FOLDBACK and EV_CURRENT_LIMIT events in this wheel's log

    recBegin(@"BM-LIMW")
    benchLog.tokenField(@"seg", segToken(segCode), TOKMAX_SEG)
    benchLog.numField(@"leg", legNo, LIM_TINY)
    benchLog.tokenField(@"motor", sideToken(SIDE_LEFT + slotIdx), TOKMAX_MOTOR)
    benchLog.numField(@"samples", lgSamples[slotIdx], LIM_SMALL)
    benchLog.numField(@"held", nHeld, LIM_SMALL)
    benchLog.numField(@"give", lgGive[slotIdx], LIM_SMALL)
    benchLog.numField(@"bad", lgBad[slotIdx], LIM_SMALL)
    benchLog.numField(@"lim_adv", lgLimAdv[slotIdx], LIM_SMALL)
    benchLog.numField(@"path_ev", nPathEv, LIM_SMALL)
    benchLog.numField(@"lim_ev", nLimEv, LIM_SMALL)
    emitRecord()

PRI spinOpenLifetime(pairIdx) : whyCode | offNeg, offPos
' Open a pair's steering lifetime: start (bSteerStart(): holdAtStop(FALSE), BM-SSTART); read the steering object's
' travel per tick and drive no leg unless it is TICK_MM_X100, since the limit in ticks would then not be the one derived
' and stated; write the pair's commutation pair unless it is the schedule (restored by spinCloseLifetime(), I11).
'
' @param pairIdx - the pair
' @returns whyCode - WHY_NONE when the lifetime is up with the pair applied, else the cause
'
' @local offNeg - a fixed pair's offset_fwd, degrees
' @local offPos - its offset_rev

    whyCode := WHY_NONE
    bSpOffWritten := FALSE
    spLifeSid := 0
    spLifeTick := 0
    if bRunContinue(SEG_SPIN) == FALSE
        whyCode := WHY_ABORTED
    elseif bSteerStart(SEG_SPIN) == FALSE
        whyCode := WHY_NO_COG
    else
        spLifeSid := steerLife
        spLifeTick := steerTickInMM()
        if spLifeTick <> TICK_MM_X100
            whyCode := WHY_TICK_SIZE_DIFFERS
        else
            case spinPairOffs[pairIdx]
                SPOFF_LEGACY:
                    steerSetPair(SPIN_LEGACY_NEG, SPIN_LEGACY_POS)
                SPOFF_FIXED:
                    offNeg, offPos := expectedOffsets()
                    steerSetPair(offNeg, offPos)

PRI spinCloseLifetime() | slotIdx, wantNeg, wantPos, offNeg, offPos
' Close the pair's lifetime: a stop (the platform is at rest after a leg, so it costs nothing); when this lifetime wrote
' a fixed pair, the schedule turned back on and the pair read back at rest against the schedule's first point
' (BM-OFFREST per wheel, I11); then the steering object stopped, the instrument idled first (I10).
'
' @local slotIdx - motor slot
' @local wantNeg - the schedule's offset_fwd at rest (its lead below the eighth, as SLOW's)
' @local wantPos - its offset_rev
' @local offNeg - offset_fwd read back
' @local offPos - offset_rev read back

    if bSteerUp
        steerStopMotors()
        if bSpOffWritten
            beat(CP_LIB_OFFSETS)
            steering.testSetLeadScheduled(TRUE)
            beat(CP_LIB_OFFSETS)
            waitBeat(SPIN_LEAD_SETTLE_MS, CP_LOOP_REST)
            wantNeg, wantPos := spinExpectedPair(SPOFF_SCHED, SPIN_SPEED_SLOW)
            repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                offNeg, offPos := steerGetPair(SIDE_LEFT + slotIdx)
                emitOffRest(SIDE_LEFT + slotIdx, wantNeg, wantPos, offNeg, offPos, (offNeg == wantNeg) and (offPos == wantPos))
    bSpOffWritten := FALSE
    spLifeSid := 0
    bInstIdle()
    steerStop()

PRI spinDrive(tid, dirIdx, speedIdx) : whyCode | power, safeEvent, bReached, remainMs
' One leg's motion and capture (see the section's CON): arm the capture; each wheel's position before anything moves
' (flLegBegin()); the travel limit ARMED BEFORE THE DRIVE (a refused limit and the leg is never driven); SYNC_PRECOND;
' the mark, driveAtPower(); both AT_SPEED; the settle and the steady window (spinWindow()); freeze;
' then the leg's own end -- its limit and both wheels STOPPED -- and rest, the travel guard live throughout
' (spinWatch()). Fills the sp* staging; emits nothing.
'
' @param tid - trace id
' @param dirIdx - SPIN_DIR_*
' @param speedIdx - SPIN_SPEED_*
' @returns whyCode - WHY_NONE when the leg ended as it should, else why SPIN must end
'
' @local power - the leg's power, magnitude
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - the watched wait reached what it waited for
' @local remainMs - SPIN_LEG_MS still owed when the leg's end is awaited

    whyCode := WHY_NONE
    safeEvent := SAFE_NONE
    power := spinPower[speedIdx]
    if dirIdx == SPIN_DIR_RIGHT
        spLeftPwr := power
        spRightPwr := 0 - power
    else
        spLeftPwr := 0 - power
        spRightPwr := power
    if bInstArm(INST_SRC_STEER, 1) == FALSE
        whyCode := WHY_INST_NOACK
    else
        waitBeat(SPIN_MIRROR_MS, CP_LOOP_READY)            ' the mirror refreshes on the instrument's next passes
        flLegBegin(spinLegTicks[speedIdx])                  ' each wheel's pos: the guard's zero, the leg's turns its limit
        spLimErr := steerArmLimit(spinLegMm[speedIdx])
        if spLimErr <> NO_ERROR
            whyCode := WHY_LIMIT_REFUSED
        elseif bSteerDrivePrecondition(SEG_SPIN, tid) == FALSE
            whyCode := WHY_SYNC_PRECOND
        else
            instMarkIndex()                                  ' the START's mark PRECEDES the command (startCapture()'s rule)
            spCmdMs := getms()
            curIncre := 0
            beat(CP_LIB_STEER_DRIVE)
            spDriveErr := steering.driveAtPower(spLeftPwr, spRightPwr)
            beat(CP_LIB_STEER_DRIVE)
            bSpDriven := TRUE
            bReached := FALSE
            if spDriveErr <> NO_ERROR
                ' refused (ERR_SYNC_TIMEOUT stops both, ERR_EMERGENCY_STOPPED writes nothing): never read as a stop at the limit
                spStopBy := SPSTOP_ABORT
                whyCode := WHY_SYNC_PRECOND
                steerStopMotors()
            else
                safeEvent, bReached := spinWatch(UNTIL_AT_SPEED, SPIN_ATSPEED_MS, FALSE)
                if (bReached == FALSE) and (safeEvent == SAFE_NONE) and (bSpOvertravel == FALSE) and bSpinStopBegun()
                    bSpStopBegan := TRUE                    ' SRC_REV 74: the leg's own stop came before both wheels held AT_SPEED (emitSpinW() says so)
            if (whyCode == WHY_NONE) and (safeEvent == SAFE_NONE) and (bSpOvertravel == FALSE) and bReached
                bSpReached := TRUE
                spAtMs := getms() - spCmdMs
                safeEvent, _ := spinWatch(UNTIL_TIME, SPIN_SETTLE_MS, FALSE)
                if (safeEvent == SAFE_NONE) and (bSpOvertravel == FALSE) and (bSpStopBegan == FALSE)
                    safeEvent := spinWindow(spinWinMs[speedIdx])
            bCpFrozen := bInstFreeze(0)
            if whyCode == WHY_NONE
                whyCode := spinEnd(safeEvent, FALSE)
            if (whyCode == WHY_NONE) and (spStopBy == SPSTOP_NOT_RUN)
                ' the leg now ends at its limit: both wheels STOPPED, then at rest, the guard still live
                remainMs := (SPIN_LEG_MS - (getms() - spCmdMs)) #> SAMPLE_MS
                safeEvent, bReached := spinWatch(UNTIL_STOPPED, remainMs, FALSE)
                whyCode := spinEnd(safeEvent, FALSE)
                if (whyCode == WHY_NONE) and (spStopBy == SPSTOP_NOT_RUN)
                    if bReached
                        spStopBy := SPSTOP_LIMIT
                    else
                        spStopBy := SPSTOP_TIMEOUT
                        whyCode := WHY_STOP_TIMEOUT
                        steerStopMotors()
            waitRest(SIDE_BOTH, STOP_TIMEOUT_MS, FALSE)
            spinTravel()
    spWhy := whyCode
    if (bCpFrozen == FALSE) and (whyCode == WHY_NONE)
        spWhy := WHY_INST_NOACK
#endif

PRI spinEnd(safeEvent, bForced) : whyCode
' Classify how a leg's watched phase ended and take the stop it calls for. The travel guard first (it has already
' shorted the phases), then the current abort or a stalled instrument (the abort has stopped the steering object; a
' stall is stopped here), a fault (the platform policy is stopping the other wheel), and, on FAULTRUN's leg back, its
' own forced fault. Leaves spStopBy SPSTOP_NOT_RUN when nothing ended the leg yet. SRC_REV 69: no window offers a STOP,
' so there is no operator branch.
'
' @param safeEvent - SAFE_* the phase ended on
' @param bForced - TRUE on FAULTRUN's leg back, whose forced fault (frOutcome) is the event under test
' @returns whyCode - WHY_NONE unless the leg ended short

    whyCode := WHY_NONE
    if bSpOvertravel
        spStopBy := SPSTOP_OVERTRAVEL
        whyCode := WHY_OVERTRAVEL
    elseif (safeEvent == SAFE_ABS_ABORT) or (safeEvent == SAFE_INST_STALL)
        spStopBy := SPSTOP_ABORT
        whyCode := safeWhy(safeEvent)
        if bSteerUp
            steerStopMotors()
    elseif safeEvent == SAFE_FAULT
        spStopBy := SPSTOP_FAULT
        whyCode := WHY_FAULTED
    elseif bForced
        if frOutcome == FRO_FAULT
            spStopBy := SPSTOP_FAULT                        ' the event under test: the leg ended as it should
        elseif frOutcome == FRO_NOT_RUN
            spStopBy := SPSTOP_TIMEOUT                      ' AT_SPEED or the settle never came
            whyCode := WHY_STEADY_TIMEOUT
            if bSpStopBegan
                whyCode := WHY_STOP_BEGAN                   ' SRC_REV 70: AT_SPEED came; the settle was cut by the stop
            if bSteerUp
                steerStopMotors()
        else
            spStopBy := SPSTOP_ABORT                        ' the guard stopped the steering object (BM-ABORT names why)
            whyCode := WHY_NO_FAULT
            if frOutcome == FRO_ABORT_I
                whyCode := WHY_ABORTED
    ' otherwise nothing has ended the leg: a leg whose AT_SPEED or window never came still ends at its limit, which the
    '  caller waits for, and its window prints NA with the cause (emitSpinW())

PRI spinWatch(untilKind, boundMs, bPollCurrent) : safeEvent, bReached | startMs, lastPollMs, nLtAmps, nRtAmps
' A floor leg's watched wait -- a spin leg's, and (SRC_REV 62) every straight leg's but GRAB's and the obstacle's, which
' have their own: waitWatched()'s beat and safety read on both wheels (SRC_REV 69: no panel tick, no STOP), plus the
' leg's own two watches. THE TRAVEL GUARD (bSpinGuardTripped()) e-stops the platform the moment either wheel's mirrored
' position is past the leg's declared travel by SPIN_OVERTRAVEL_TICKS. THE STOP BEGINNING: a wheel's target at zero (SRC_REV 70; not DCS_SPIN_DN,
' which a lowered target also reads) or its mirror reading DCS_STOPPED means the limit has fired, which ends an UNTIL_TIME wait early (bSpStopBegan). With bPollCurrent,
' getCurrent() every CURRENT_POLL_MS into spAmpsSum -- the only library call inside the wait, as rungWindow()'s is. SRC_REV 70:
' with bRampOn (the ramp legs, DBF_RAMP) each pass also takes rampSample(): a hub read of each driver's acceleration, no library call.
' SRC_REV 75: every pass also takes limSample(), a hub read of each driver's limiter counters and field speed (no library call).
'
' @param untilKind - UNTIL_TIME, UNTIL_AT_SPEED, UNTIL_STOPPED, UNTIL_MOVING, or UNTIL_TRAVEL (spTravelMark)
' @param boundMs - the wait's bound
' @param bPollCurrent - TRUE to read getCurrent()
' @returns safeEvent - SAFE_* that ended the wait, SAFE_NONE otherwise (the guard firing is bSpOvertravel)
' @returns bReached - TRUE when the state was reached; for UNTIL_TIME, when the whole bound ran uncut
'
' @local startMs - getms() when the wait began
' @local lastPollMs - getms() of the last getCurrent()
' @local nLtAmps - the left wheel's getCurrent(), A x 10_000
' @local nRtAmps - the right wheel's

    safetyReset()
    safeEvent := SAFE_NONE
    bReached := FALSE
    startMs := getms()
    lastPollMs := startMs - CURRENT_POLL_MS
    repeat
        beat(CP_LOOP_POLL)
        if bPollCurrent and ((getms() - lastPollMs) >= CURRENT_POLL_MS)
            lastPollMs := getms()
            beat(CP_LIB_STEER_QUERY)
            nLtAmps, _, nRtAmps, _ := steering.getCurrent()
            beat(CP_LIB_STEER_QUERY)
            spAmpsSum[SLOT_LEFT] += (nLtAmps #> (0 - LIM_MID)) <# LIM_MID
            spAmpsSum[SLOT_RIGHT] += (nRtAmps #> (0 - LIM_MID)) <# LIM_MID
            spAmpsN += 1
        waitms(SAMPLE_MS)
        safeEvent := safetyPoll(SIDE_BOTH)
        limSample()                                         ' SRC_REV 75: the limiters, a hub read of each driver's status run (SPINHOLD, LIMGIVE)
#ifdef DBF_RAMP
        if bRampOn
            rampSample()                                    ' SRC_REV 70: the ramp legs read the drivers' acceleration, a hub read
#endif
        if bSpinGuardTripped()
            quit
        if untilKind == UNTIL_AT_SPEED
            bReached := bMirrorAllInState(SIDE_BOTH, DCS_AT_SPEED)
        elseif untilKind == UNTIL_STOPPED
            bReached := bMirrorAllInState(SIDE_BOTH, DCS_STOPPED)
        elseif untilKind == UNTIL_MOVING
            bReached := bMirrorNoneInState(SIDE_BOTH, DCS_STOPPED)
        elseif untilKind == UNTIL_TRAVEL
            bReached := (flTravelMax() >= spTravelMark)
        elseif bSpinStopBegun()
            bSpStopBegan := TRUE
            quit
        if (safeEvent <> SAFE_NONE) or bReached or ((getms() - startMs) >= boundMs)
            quit
    if untilKind == UNTIL_TIME
        bReached := (safeEvent == SAFE_NONE) and (bSpOvertravel == FALSE) and (bSpStopBegan == FALSE)

PRI bSpinGuardTripped() : bTripped | slotIdx
' THE TRAVEL GUARD, the harness's own hard cap on every floor leg: when either wheel's mirrored position has passed the
' leg's declared travel (spGuardTicks, set by flLegBegin()) by SPIN_OVERTRAVEL_TICKS -- the distance stop should have
' brought it to rest that far back -- e-stop the platform at once (both wheels' phases shorted, the latch set; the next
' lifetime, or clearEmergency(), clears it). Once tripped it stays tripped for the leg (bSpOvertravel).
'
' @returns bTripped - T/F where T means the guard has fired on this leg
'
' @local slotIdx - motor slot

    bTripped := bSpOvertravel
    if bTripped == FALSE
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            if abs(instLastPos[slotIdx] - spPos0[slotIdx]) > (spGuardTicks + SPIN_OVERTRAVEL_TICKS)
                bTripped := TRUE
        if bTripped
            bSpOvertravel := TRUE
            steerEstop()

PRI flLegBegin(legTicks) | slotIdx
' SRC_REV 62: open a floor leg's watch (a spin leg's too): each wheel's driver pos on the mirror is the travel guard's
' zero, legTicks its declared travel, and the watch flags and the current poll start clear. Call it after the capture is
' armed (the mirror is live only then) and before the leg's limit is armed.
'
' SRC_REV 70: it also takes each driver's launch-run address, which bSpinStopBegun() reads targetIncre through, and, in the
' session images (DBG_FENCE), marks the fence's zero (fenceMark()). SRC_REV 75: and each driver's status-run address, and the
' limiter sampler's zero for the leg (limSample()): lag_held now as the leg's baseline, the limiter counters as the first
' interval's, the leg's sample counts cleared.
'
' @param legTicks - the leg's declared travel, hall ticks
'
' @local slotIdx - motor slot

    beat(CP_LIB_STEER_QUERY)
    spLaunchPtr[SLOT_LEFT], spStatusPtr[SLOT_LEFT], _ := steering.testLeftGetAbiAddrs()
    spLaunchPtr[SLOT_RIGHT], spStatusPtr[SLOT_RIGHT], _ := steering.testRightGetAbiAddrs()
    beat(CP_LIB_STEER_QUERY)
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        spPos0[slotIdx] := instLastPos[slotIdx]
        spAmpsSum[slotIdx] := 0
        if spStatusPtr[slotIdx] <> 0
            lgHeldBase[slotIdx] := long[spStatusPtr[slotIdx]][LG_HELD_IDX]
            lgHeldPrev[slotIdx] := lgHeldBase[slotIdx]
            lgHeldCmd[slotIdx] := lgHeldBase[slotIdx]
            lgLimPrev[slotIdx] := long[spStatusPtr[slotIdx]][LG_CAPPED_IDX] + long[spStatusPtr[slotIdx]][LG_FOLD_IDX]
        bLgLimSeen[slotIdx] := FALSE
        bLgArrived[slotIdx] := FALSE
        lgLimMs[slotIdx] := 0
        lgLimAdv[slotIdx] := 0
        lgSamples[slotIdx] := 0
        lgGive[slotIdx] := 0
        lgBad[slotIdx] := 0
    spGuardTicks := legTicks
    spTravelMark := legTicks
    spAmpsN := 0
    bSpOvertravel := FALSE
    bSpStopBegan := FALSE
#ifdef DBG_FENCE
    fenceMark()                                             ' SRC_REV 70: the fence counts this leg's travel from here
#endif

PRI limSample() | slotIdx, pStatus, nowMs, nIncr, nTarget, nHeld, nLimiter, bHeld, bGive
' SRC_REV 75 (task 3657, HOLD-SPEED plan sec 6): ONE SAMPLE OF THE LIMITERS, taken inside spinWatch() every pass (SAMPLE_MS plus
' the pass's own work, under a front slot of LG_SLOT_MS a pass or a little over) of every floor leg, a hub read of each driver's
' status run with no library call (as rampSample() reads drv_accel_now). Per wheel with a command in force and no fault:
'  - HELD in the interval: lag_held changed since the last sample (the lag limiter withheld the field advance);
'  - the LIMITER advanced: duty_capped + foldback_frames changed (the duty ceiling or the current fold-back had the duty);
'  - a GIVE-WAY SLOT: the wheel has ARRIVED (a sample, this leg, read its drv_state at DCS_AT_SPEED: bLgArrived), held in the
'    interval AND the field's speed (drv_incr_now) under LG_GIVE_NUM / LG_GIVE_DEN of the driver's
'    own TARGET (targetIncre, which the path limiter lowers, so a scaled command is not a give-way); it is BAD unless the
'    limiter advanced in this sample or the LG_LOOK_MS before it (the plan's "within its last 4 slots"). SRC_REV 78: a held pass
'    before the arrival is the ramp not yet there, not a give-way; the latch, not the same sample's state, because a held pass
'    at speed turns the state to SPIN_UP (holdDecay) and the decay's own samples read it;
'  - the leg's held passes count only while a target is in force (lgHeldCmd): a stop that zeroes it is the drive's own end.
' A faulted wheel is skipped (a re-sync's controlled stop lowers the field on purpose). The counts go to the leg's lg* staging
' (BM-LIMW) and, the samples and the bad slots, to the session's sfLg* accumulators (LIMGIVE). A wheel whose launch or status
' address is not known is not read.
'
' @local slotIdx - motor slot
' @local pStatus - the wheel's status-run address
' @local nowMs - getms() at this sample
' @local nIncr - |drv_incr_now|
' @local nTarget - |targetIncre| (bit 31, the sync flag, dropped)
' @local nHeld - lag_held
' @local nLimiter - duty_capped + foldback_frames
' @local bHeld - T/F where T means lag_held changed since the last sample
' @local bGive - T/F where T means this sample is a give-way slot

    nowMs := getms()
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        pStatus := spStatusPtr[slotIdx]
        if (pStatus <> 0) and (spLaunchPtr[slotIdx] <> 0) and (long[pStatus][LG_FAULT_IDX] == FALSE)
            nIncr := abs(long[pStatus][LG_INCR_IDX])
            nHeld := long[pStatus][LG_HELD_IDX]
            nLimiter := long[pStatus][LG_CAPPED_IDX] + long[pStatus][LG_FOLD_IDX]
            nTarget := abs(long[spLaunchPtr[slotIdx]][ABI_TARGET_IDX] signx TARGET_SIGN_BIT)
            bHeld := (nHeld <> lgHeldPrev[slotIdx])
            if nLimiter <> lgLimPrev[slotIdx]
                lgLimMs[slotIdx] := nowMs
                bLgLimSeen[slotIdx] := TRUE
                lgLimAdv[slotIdx] := (lgLimAdv[slotIdx] + 1) <# LIM_SMALL
            if long[pStatus][LG_STATE_IDX] == DCS_AT_SPEED
                bLgArrived[slotIdx] := TRUE
            bGive := bLgArrived[slotIdx] and bHeld and (nTarget <> 0) and (nIncr < ((nTarget / LG_GIVE_DEN) * LG_GIVE_NUM))
            lgSamples[slotIdx] := (lgSamples[slotIdx] + 1) <# LIM_SMALL
            sfLgSamples[slotIdx] := (sfLgSamples[slotIdx] + 1) <# LIM_SMALL
            if bGive
                lgGive[slotIdx] := (lgGive[slotIdx] + 1) <# LIM_SMALL
                if (bLgLimSeen[slotIdx] == FALSE) or ((nowMs - lgLimMs[slotIdx]) > LG_LOOK_MS)
                    lgBad[slotIdx] := (lgBad[slotIdx] + 1) <# LIM_SMALL
                    sfLgBad[slotIdx] := (sfLgBad[slotIdx] + 1) <# LIM_SMALL
            lgHeldPrev[slotIdx] := nHeld
            lgLimPrev[slotIdx] := nLimiter
            if nTarget <> 0
                lgHeldCmd[slotIdx] := nHeld

PRI flTravelMax() : nTicks | slotIdx
' SRC_REV 62: the farther wheel's travel since its leg began, on its driver's own pos (the mirror).
'
' @returns nTicks - hall ticks, never negative
'
' @local slotIdx - motor slot

    nTicks := 0
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        nTicks #>= abs(instLastPos[slotIdx] - spPos0[slotIdx])

PRI bSpinStopBegun() : bBegun | slotIdx, nTarget
' Whether the distance stop has fired: a wheel's TARGET is zero (the front cog zeroes it at the limit) or its mirror reads
' DCS_STOPPED. SRC_REV 70: not DCS_SPIN_DN -- the driver reports that whenever |v| >= |target|, and on the floor the
' path limiter lowers a running target, so a wheel still driving reads it (FLOOR-VISIT-EVALUATION sec 2). The target is
' the launch run's targetIncre, read straight from the hub (no library call), bit 31 being the sync flag.
'
' @returns bBegun - T/F where T means a wheel is stopping or stopped
'
' @local slotIdx - motor slot
' @local nTarget - the wheel's targetIncre, signed

    bBegun := FALSE
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        if instLastUp[slotIdx] <> FALSE
            if instLastState[slotIdx] == DCS_STOPPED
                bBegun := TRUE
            if spLaunchPtr[slotIdx] <> 0
                nTarget := long[spLaunchPtr[slotIdx]][ABI_TARGET_IDX] signx TARGET_SIGN_BIT
                if nTarget == 0
                    bBegun := TRUE

#ifdef DBF_SPINLEG
PRI spinWindow(winMs) : safeEvent | winStartMs
' A NORMAL leg's steady window: two instrument totals read with no new mark (the START's mark stays in place), winMs of
' spinWatch() with getCurrent() polled, then the window-end reads (spinReads()). Valid when it ran at least
' SPIN_WIN_MIN_MS with no event and no guard -- a window the limit cut short is still valid past that.
'
' @param winMs - the window's length
' @returns safeEvent - SAFE_* that ended it early, SAFE_NONE otherwise
'
' @local winStartMs - getms() at its start

    spWinStart := instTotal
    winStartMs := getms()
    safeEvent, _ := spinWatch(UNTIL_TIME, winMs, TRUE)
    spWinEnd := instTotal
    spWinMs := getms() - winStartMs
    bSpWinValid := (safeEvent == SAFE_NONE) and (bSpOvertravel == FALSE) and (spWinMs >= SPIN_WIN_MIN_MS)
    if (safeEvent == SAFE_NONE) and (bSpOvertravel == FALSE)
        spinReads()
#endif

PRI spinReads() | slotIdx, side
' The reads at a leg's window end, while both wheels still run steady: each wheel's two following readings and whether
' its lag limiter held lately (testGetDriveFollow(), A-8), the path limiter's scale, and the pair each driver applied.
'
' @local slotIdx - motor slot
' @local side - SIDE_LEFT or SIDE_RIGHT

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        side := SIDE_LEFT + slotIdx
        beat(CP_LIB_STEER_QUERY)
        if side == SIDE_RIGHT
            _, _, bSpShort[slotIdx], spFolPm[slotIdx], spFolPct[slotIdx], bSpFolOk[slotIdx] := steering.testRightGetDriveFollow()
        else
            _, _, bSpShort[slotIdx], spFolPm[slotIdx], spFolPct[slotIdx], bSpFolOk[slotIdx] := steering.testLeftGetDriveFollow()
        beat(CP_LIB_STEER_QUERY)
        spOffNeg[slotIdx], spOffPos[slotIdx] := steerGetPair(side)
    beat(CP_LIB_STEER_QUERY)
    spPathPm := steering.testGetPathScale()
    beat(CP_LIB_STEER_QUERY)
    bSpReadsValid := TRUE

#ifdef DBF_FAULTRUN
PRI frunFaultReset()
' Clear FAULTRUN's X-5 staging -- the FAULTRESP part's, which frProvoke(), frPlatStats() and emitFrPlat() read and
' write -- and name the wheel to be faulted, FLR_SIDE. The fault response is the lifetime's default, FR_GRADED (start()
' restores it; the section's CON says what it does), which frMode records; nothing here changes it.

    frStagingReset(FRC_X3, FR_SPEED_X4, 0)                  ' frOutcome FRO_NOT_RUN, and every reading cleared
    frMode := wheelL.FAULT_RESPONSE_DEFAULT
    frReqMode := MODE_FLOAT
    frPlatReset()
    fltLeftCause := wheelL.FC_NONE
    fltRightCause := wheelL.FC_NONE
    spFaultSide := FLR_SIDE

PRI spinFault() : safeEvent | slotIdx, bRest
' FAULTRUN's event on its leg back, X-5 under load (R19.2): SPIN_FAULT_SETTLE_MS steady, with getCurrent() polled into
' spAmpsSum (PL-93's "before"), and the window-end reads; then the guarded forced fault on ONE wheel (frunFaultReset()
' named it) through the steering object -- frProvoke(): its mark, testLeftForceFault() or testRightForceFault(), and
' frGuard(), which stops the whole steering object if the fault does not latch in FR_PROVOKE_MS or the current reaches
' the abort; then the capture runs until both wheels rest or FR_PLAT_CAPTURE_MS, the fault not ending it
' (frPlatTrial()'s shape).
'
' @returns safeEvent - SAFE_* that ended the settle or the capture, SAFE_NONE otherwise
'
' @local slotIdx - the faulted wheel's slot
' @local bRest - both wheels were confirmed at rest

    slotIdx := spFaultSide - SIDE_LEFT
    safeEvent, _ := spinWatch(UNTIL_TIME, SPIN_FAULT_SETTLE_MS, TRUE)   ' getCurrent() polled: PL-93's "before"
    if (safeEvent == SAFE_NONE) and (bSpOvertravel == FALSE) and (bSpStopBegan == FALSE)
        spinReads()
        frOutcome := frProvoke(spFaultSide, slotIdx, TRUE)
        if frOutcome == FRO_FAULT
            bCpFaultSeen := TRUE
            safeEvent, bRest := waitRest(SIDE_BOTH, FR_PLAT_CAPTURE_MS, FALSE)
            frCaptureSafe := safeEvent
            cpEnd := TEND_TIMEOUT
            if bRest
                cpEnd := TEND_REST
            if safeEvent <> SAFE_NONE
                cpEnd := safeEnd(safeEvent)
#endif

#ifdef DBF_SPINLEG
PRI spinTravel() | slotIdx, leftTicks, rightTicks
' Each wheel's travel once the leg is at rest: the raw position against where it began (the mirror, live while FROZEN;
' after an abort's stop() the last running position), and the steering object's tracked ticks -- what the distance stop
' counts -- while it is up. A wheel that faulted or an e-stopped platform restarts its tracking every pass, so its
' tracked count reads 0 there and the raw travel carries the leg.
'
' @local slotIdx - motor slot
' @local leftTicks - the left wheel's tracked ticks
' @local rightTicks - the right wheel's

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        spTravel[slotIdx] := instLastPos[slotIdx] - spPos0[slotIdx]
    bSpTravelValid := bSpDriven
    if bSteerUp
        leftTicks, rightTicks := steerTrackTicks()
        spTrk[SLOT_LEFT] := abs(leftTicks)
        spTrk[SLOT_RIGHT] := abs(rightTicks)
        bSpTrkValid := TRUE

PRI bSpLegTraced(pairIdx, dirIdx) : bTraced
' Whether a spin leg drains its capture as a steering trace: the quarter's two schedule legs (SPIN_PAIR_BRISK, whose START
' feeds A-1 and A-2) and, SRC_REV 78 (PL-182), the slow schedule leg turning LEFT (spin leg 2), so a held pass at a slow start can
' be placed in time and state. BM-SPIN's traced field prints this.
'
' @param pairIdx - the leg's pair
' @param dirIdx - SPIN_DIR_*
' @returns bTraced - T/F where T means the leg's capture is drained as a trace

    bTraced := (pairIdx == SPIN_PAIR_BRISK) or ((pairIdx == SPIN_PAIR_SLOW) and (dirIdx == SPIN_DIR_LEFT))

PRI spinRecords(tid, legIdx, pairIdx, dirIdx, speedIdx) | slotIdx, otherIdx
' A leg's records and folds, the capture frozen (I10). The traced legs (bSpLegTraced()) drain their capture as a
' steering trace (BM-STRACE cause SPIN, BM-TS, BM-TRACE-END); the quarter's confirmed-pair legs also print each wheel's START
' (BM-SPINSTART, A-1 and A-2); then BM-SPIN, and per wheel its window's statistics (BM-SPINW). A leg that never ran prints
' BM-SPIN alone. (SRC_REV 62: a FAULT leg's X-5 trace is FAULTRUN's now, frunRecords().)
'
' @param tid - trace id
' @param legIdx - 0..SPIN_LEGS-1
' @param pairIdx - its pair
' @param dirIdx - SPIN_DIR_*
' @param speedIdx - SPIN_SPEED_*
'
' @local slotIdx - motor slot
' @local otherIdx - the other slot

    if bSpDriven == FALSE
        emitSpin(tid, legIdx)
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT         ' SRC_REV 74: BM-XRUN's cause for a leg that never ran
            if spWhy <> WHY_NONE
                spLegWhy[(legIdx * INST_MOTORS) + slotIdx] := spWhy
    else
        if bSpLegTraced(pairIdx, dirIdx)
            emitSTrace(tid, SEG_SPIN, CAUSE_SPIN, spLeftPwr, spRightPwr, TRUE, 0, MODE_FLOAT, spWhy)
            cpEnd := TEND_FROZEN                            ' frozen after its window, as designed: the trace ends running
            if spWhy <> WHY_NONE
                cpEnd := TEND_ABORT
            if bCpFrozen
                if pairIdx <> SPIN_PAIR_BRISK                   ' SRC_REV 80 (PL-182): the slow leg emits every sample, so a
                    trEmitMax := TRACE_MAX_SAMPLES              '  held pass at its start can be placed in time and state
                bTraceDrain(tid, SLOT_LEFT, SLOT_RIGHT, cpEnd)
                if pairIdx == SPIN_PAIR_BRISK               ' SRC_REV 78: the slow leg's trace has no START to judge
                    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                        spStartStats(slotIdx)
                        emitSpinStart(legIdx, slotIdx)
                        spinFoldStart(slotIdx)
            else
                traceEmptyEnd(tid, TEND_ABORT, spWhy)
        emitSpin(tid, legIdx)
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            otherIdx := SLOT_RIGHT - slotIdx
            if bCpFrozen and bSpWinValid
                windowStats(slotIdx, otherIdx, spWinStart, spWinEnd)
            else
                windowStats(slotIdx, otherIdx, -1, -1)      ' resets the rs* staging; reads no ring long (I10)
            emitSpinW(legIdx, slotIdx)
            spinFoldWheel(legIdx, pairIdx, speedIdx, slotIdx)
        spinFoldLeg(pairIdx, dirIdx, speedIdx)

PRI spStartStats(slotIdx) | sampleIdx, atJ, leaveJ, dutyNow, riseEndJ, tailJ, tailEndJ, tailSum, bSteady
' One wheel's START from the drained capture (bTraceDrain() located the mark and the trace's first sample), as
' DOCs/plans/servo-model/start_metrics.py defines A-1 and A-2, re-cut at SRC_REV 60 for DRIVER_REV 38's jerk-limited
' ramp (the section's CON, A1_/A2_ constants, says why): the START runs from the trace's first sample to this wheel's
' first AT_SPEED sample (atJ). A-1: from where duty last sat at or under SPIN_DUTY_FLOOR ("left its floor for good")
' up to the ramp-out, A1_RAMPOUT_SAMPLES before atJ, the largest fall of duty from its running maximum, per mille of
' that maximum. A-2 (SRC_REV 78): the ARRIVAL WINDOW's current peak -- A2_ARR_SAMPLES samples from atJ -- over the mean current of
' the STEADY REFERENCE -- A2_TAIL_SAMPLES (60 ms) starting A2_REF_DELAY_SAMPLES after atJ -- measured only when every sample from
' atJ to the reference's end reads DCS_AT_SPEED, the driver's own report that its acceleration is 0 (the CON). Every stored sample
' counts, where start_metrics.py sees only the emitted lines. Only samples with the driver up count (I3). Legal while FROZEN.
'
' @param slotIdx - motor slot
'
' @local sampleIdx - logical index
' @local atJ - the first AT_SPEED sample, -1 when none
' @local leaveJ - the first sample after duty's last visit to its floor
' @local dutyNow - this sample's duty
' @local riseEndJ - A-1's window ends before this sample: the ramp-out's first
' @local tailJ - the steady reference's first sample
' @local tailEndJ - its last
' @local tailSum - the reference's summed current, mV
' @local bSteady - T/F where T means the reference lies in the capture and every sample from atJ to its end read AT_SPEED

    atJ := -1
    if bDrMarkFound
        repeat sampleIdx from drMarkJ to drEndJ
            beat(CP_LOOP_DRAIN)
            if bSmpUp(sampleIdx, slotIdx) and (smpState(sampleIdx, slotIdx) == DCS_AT_SPEED)
                atJ := sampleIdx
                quit
    if atJ > drStartJ
        leaveJ := drStartJ
        repeat sampleIdx from drStartJ to atJ - 1
            beat(CP_LOOP_DRAIN)
            if bSmpUp(sampleIdx, slotIdx) and (smpDuty(sampleIdx, slotIdx) <= SPIN_DUTY_FLOOR)
                leaveJ := sampleIdx + 1
        riseEndJ := atJ - A1_RAMPOUT_SAMPLES
        spRunMax[slotIdx] := 0
        spDropPm[slotIdx] := 0
        if leaveJ < riseEndJ
            repeat sampleIdx from leaveJ to riseEndJ - 1
                beat(CP_LOOP_DRAIN)
                if bSmpUp(sampleIdx, slotIdx)
                    dutyNow := smpDuty(sampleIdx, slotIdx)
                    spRunMax[slotIdx] #>= dutyNow
                    if spRunMax[slotIdx] > 0
                        spDropPm[slotIdx] #>= ((spRunMax[slotIdx] - dutyNow) * SPIN_PM) / spRunMax[slotIdx]
        spPeakI[slotIdx] := NEGX
        repeat sampleIdx from atJ to atJ + A2_ARR_SAMPLES - 1       ' SRC_REV 78: the arrival window, not the whole spin-up
            beat(CP_LOOP_DRAIN)
            if bSmpUp(sampleIdx, slotIdx)
                spPeakI[slotIdx] #>= smpI(sampleIdx, slotIdx)
        tailJ := atJ + A2_REF_DELAY_SAMPLES
        tailEndJ := tailJ + A2_TAIL_SAMPLES - 1
        bSteady := (tailEndJ <= drEndJ)
        if bSteady
            repeat sampleIdx from atJ to tailEndJ
                beat(CP_LOOP_DRAIN)
                if (bSmpUp(sampleIdx, slotIdx) == FALSE) or (smpState(sampleIdx, slotIdx) <> DCS_AT_SPEED)
                    bSteady := FALSE
        tailSum := 0
        spTailN[slotIdx] := 0
        if bSteady
            repeat sampleIdx from tailJ to tailEndJ
                beat(CP_LOOP_DRAIN)
                tailSum += smpI(sampleIdx, slotIdx)
                spTailN[slotIdx] += 1
        spAtK[slotIdx] := atJ - drStartJ
        spLeaveK[slotIdx] := leaveJ - drStartJ
        if bSteady and (leaveJ < riseEndJ) and (spTailN[slotIdx] > 0) and (tailSum > 0) and (spPeakI[slotIdx] <> NEGX)
            spTailX10[slotIdx] := (tailSum * X10) / spTailN[slotIdx]
            spRatioX100[slotIdx] := (spPeakI[slotIdx] * SPIN_X100 * spTailN[slotIdx]) / tailSum
            spExcessMv[slotIdx] := ((spPeakI[slotIdx] * spTailN[slotIdx]) - tailSum) / spTailN[slotIdx] #> 0     ' SRC_REV 78: A-2's value
            bSpStartOk[slotIdx] := TRUE

PRI spinFoldStart(slotIdx)
' Fold one wheel's START into R19-DUAL-SPINSTRT-P (A-1, the worst drop) and R19-DUAL-SPINPEAK-P (A-2, the worst excess,
' SRC_REV 78: mV above the steady mean, no longer the ratio).
'
' @param slotIdx - motor slot

    if bSpStartOk[slotIdx]
        sfSpA1N[slotIdx] := (sfSpA1N[slotIdx] + 1) <# LIM_SMALL
        sfSpA1Max[slotIdx] #>= spDropPm[slotIdx]
        sfSpA2N[slotIdx] := (sfSpA2N[slotIdx] + 1) <# LIM_SMALL
        sfSpA2Max[slotIdx] #>= spExcessMv[slotIdx]

PRI spinFoldWheel(legIdx, pairIdx, speedIdx, slotIdx) | arrIdx
' Fold one wheel's window (the rs* staging windowStats() just filled) into the per-leg current the cross-leg cells
' compare, and, on a confirmed-pair leg, into A-4 (every speed), A-3 (SLOW and MEDIUM, rungs 1 and 2) and A-8's
' following case (MEDIUM and BRISK, the rpm window then holds at least a second of steady running). SRC_REV 75: and, on
' EVERY leg, the window-end following reading (bSpReadsValid, bSpFolOk) into the per-leg table SPINCTL and SPINLEAD gate on
' and into SPINRATE's lowest reading.
'
' @param legIdx - 0..SPIN_LEGS-1
' @param pairIdx - its pair
' @param speedIdx - SPIN_SPEED_*
' @param slotIdx - motor slot
'
' @local arrIdx - [leg * INST_MOTORS + slot] index

    arrIdx := (legIdx * INST_MOTORS) + slotIdx
    if bSpReadsValid and (bSpFolOk[slotIdx] <> FALSE)       ' SRC_REV 75: the leg's following, SPINRATE's reading and SPINCTL's and SPINLEAD's precondition
        spLegFol[arrIdx] := spFolPct[slotIdx]
        bSpLegFol[arrIdx] := TRUE
        sfSpRateN[slotIdx] := (sfSpRateN[slotIdx] + 1) <# LIM_SMALL
        sfSpRateMin[slotIdx] <#= spFolPct[slotIdx]
    if bSpWinValid and bCpFrozen and (rsN > 0)
        if spAmpsN > 0
            spLegAmps[arrIdx] := spAmpsSum[slotIdx] / spAmpsN
            bSpLegAmps[arrIdx] := TRUE
        if spinPairOffs[pairIdx] == SPOFF_SCHED
            sfSpErrN[slotIdx] := (sfSpErrN[slotIdx] + 1) <# LIM_SMALL
            if (abs(rsErrMean) < A4_ERR_LO) or (abs(rsErrMean) > A4_ERR_HI)
                sfSpErrBad[slotIdx] := (sfSpErrBad[slotIdx] + 1) <# LIM_SMALL
            if speedIdx <> SPIN_SPEED_BRISK
                sfSpHuntN[slotIdx] := (sfSpHuntN[slotIdx] + 1) <# LIM_SMALL
                if ((rsDutyPk - rsDutyMean) > A3_SWING_HI) or (rsErrPk > A3_ERR_PK_HI)
                    sfSpHuntBad[slotIdx] := (sfSpHuntBad[slotIdx] + 1) <# LIM_SMALL
            if (speedIdx <> SPIN_SPEED_SLOW) and bSpReadsValid and (bSpFolOk[slotIdx] <> FALSE)
                sfSpFolN[slotIdx] := (sfSpFolN[slotIdx] + 1) <# LIM_SMALL
                sfSpFolMax[slotIdx] #>= abs((spFolPm[slotIdx] / 10) - spFolPct[slotIdx])

PRI spinFoldLeg(pairIdx, dirIdx, speedIdx) | slotIdx, wantNeg, wantPos, bBad, bJudged, wantSign
' Fold one leg into the cells judged per leg on the platform:
'  SPINSTOP - a leg that ended at its limit or past it: bad when it was past it, or when the farther wheel's tracked
'             travel is not within SPIN_STOP_TOL_TICKS of the leg's own limit (spinLegTicks[speedIdx]: one turn, or two at
'             the quarter)
'  SPINOFF  - the pair each driver applied against the pair under test (spinExpectedPair()); a confirmed-pair leg is
'             judged only when the path limiter ran it unscaled and neither wheel was held, since the schedule keys its
'             lead on the field's speed
'  SPINDIR  - each wheel's raw travel against the direction commanded, when it moved at least SPIN_DIR_MIN_TICKS
'
' @param pairIdx - the leg's pair
' @param dirIdx - SPIN_DIR_*
' @param speedIdx - SPIN_SPEED_*
'
' @local slotIdx - motor slot
' @local wantNeg - the expected offset_fwd
' @local wantPos - the expected offset_rev
' @local bBad - T/F where T means the leg fails the cell
' @local bJudged - T/F where T means the leg counts toward the cell
' @local wantSign - the raw travel's expected sign: +1 RIGHT, -1 LEFT

    if (spStopBy == SPSTOP_LIMIT) or (spStopBy == SPSTOP_OVERTRAVEL)
        sfSpStopN := (sfSpStopN + 1) <# LIM_SMALL
        bBad := (spStopBy == SPSTOP_OVERTRAVEL) or (bSpTrkValid == FALSE)
        if bBad == FALSE
            bBad := abs((spTrk[SLOT_LEFT] #> spTrk[SLOT_RIGHT]) - spinLegTicks[speedIdx]) > SPIN_STOP_TOL_TICKS
        if bBad
            sfSpStopBad := (sfSpStopBad + 1) <# LIM_SMALL
    if bSpReadsValid
        bJudged := (spinPairOffs[pairIdx] <> SPOFF_SCHED)
        if bJudged == FALSE
            bJudged := (spPathPm == SPIN_PM) and (bSpShort[SLOT_LEFT] == FALSE) and (bSpShort[SLOT_RIGHT] == FALSE)
        if bJudged
            wantNeg, wantPos := spinExpectedPair(spinPairOffs[pairIdx], speedIdx)
            sfSpOffN := (sfSpOffN + 1) <# LIM_SMALL
            bBad := FALSE
            repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                if (spOffNeg[slotIdx] <> wantNeg) or (spOffPos[slotIdx] <> wantPos)
                    bBad := TRUE
            if bBad
                sfSpOffBad := (sfSpOffBad + 1) <# LIM_SMALL
    if bSpTravelValid and ((abs(spTravel[SLOT_LEFT]) #> abs(spTravel[SLOT_RIGHT])) >= SPIN_DIR_MIN_TICKS)
        wantSign := SIGN_POS
        if dirIdx == SPIN_DIR_LEFT
            wantSign := SIGN_NEG
        sfSpDirN := (sfSpDirN + 1) <# LIM_SMALL
        bBad := FALSE
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            if (spTravel[slotIdx] * wantSign) <= 0
                bBad := TRUE
        if bBad
            sfSpDirBad := (sfSpDirBad + 1) <# LIM_SMALL

PRI spinExpectedPair(offKind, speedIdx) : offNeg, offPos
' The commutation pair a leg must apply: the legacy pair, the compiled fixed pair, or the schedule's at the leg's
' commanded increment (spinSchedLead, rounded as the driver's writeOffsetsTenths() rounds, scheduledDegrees()).
'
' @param offKind - SPOFF_*
' @param speedIdx - SPIN_SPEED_*
' @returns offNeg - offset_fwd, degrees
' @returns offPos - offset_rev, degrees

    case offKind
        SPOFF_LEGACY:
            offNeg := SPIN_LEGACY_NEG
            offPos := SPIN_LEGACY_POS
        SPOFF_FIXED:
            offNeg, offPos := expectedOffsets()
        other:
            offNeg := scheduledDegrees((wheelL.HUB_HALL_ZERO_DEGR * TENTHS_PER_DEG) + spinSchedLead[speedIdx])
            offPos := scheduledDegrees((wheelL.HUB_HALL_ZERO_DEGR * TENTHS_PER_DEG) - spinSchedLead[speedIdx])
#endif

PRI spinIncre(power) : nIncre
' The increment a positive power commands on the 6.5in map at 18.5 V, by the motor object's own map() arithmetic
' (confgurePowerLimits(), incrementForPower()) on the harness's mirrored limits, LIB_MIN_FWD_INCRE and LIB_MAX_FWD_INCRE.
'
' @param power - power [1..100]
' @returns nIncre - the driver angle increment

    nIncre := LIB_MIN_FWD_INCRE + (((LIB_MAX_FWD_INCRE - LIB_MIN_FWD_INCRE) / (POWER_FULL - POWER_MIN)) * (power - POWER_MIN))

#ifdef DBF_SPINLEG
PRI steerArmLimit(legMm) : eError
' stopAfterDistance(legMm, DDU_MM) on the steering object: its tracking reset and its platform distance stop
' armed as one front-cog request (F-4), before the leg is driven. The driveAtPower() that follows disarms each wheel's
' own limit but not this one.
'
' @param legMm - the leg's travel limit, mm (spinLegMm[speed])
' @returns eError - the steering object's return; anything but NO_ERROR and the leg is never driven

    beat(CP_LIB_STEER_DRIVE)
    eError := steering.stopAfterDistance(legMm, steering.DDU_MM)
    beat(CP_LIB_STEER_DRIVE)

PRI steerSetPair(offNeg, offPos)
' testSetFwdRevIndep() on both steering wheels, which turns each wheel's lead schedule off; spinCloseLifetime() owes the
' restore (bSpOffWritten).
'
' @param offNeg - offset_fwd, degrees
' @param offPos - offset_rev, degrees

    beat(CP_LIB_OFFSETS)
    steering.testLeftSetFwdRevIndep(offNeg, offPos)
    steering.testRightSetFwdRevIndep(offNeg, offPos)
    beat(CP_LIB_OFFSETS)
    bSpOffWritten := TRUE
#endif

PRI steerGetPair(side) : offNeg, offPos
' The commutation pair one steering wheel applies now.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns offNeg - offset_fwd, degrees
' @returns offPos - offset_rev, degrees

    beat(CP_LIB_OFFSETS)
    if side == SIDE_RIGHT                                   ' if/else, never `? :` -- PL-29, PL-76
        offNeg, offPos := steering.testRightGetFwdRevIndep()
    else
        offNeg, offPos := steering.testLeftGetFwdRevIndep()
    beat(CP_LIB_OFFSETS)

PRI steerEstop()
' emergencyCutoff() on the steering object: both wheels' phases shorted at once and the latch set. It brakes a moving
' wheel hard and holds nothing still; the next lifetime's start() clears the latch (init()).

    beat(CP_LIB_ESTOP)
    steering.emergencyCutoff()
    beat(CP_LIB_ESTOP)

' INCLINE, THE REST OF THIS BLOCK -- COMPILED OUT (SRC_REV 69). It is postponed (Stephen, 2026-09-29: "postpone the incline
'  testing until we've returned all other results and have corrected the driver using them"), and its screens, its catch
'  step and its READY/BACK prompts were the operator panel's, which the floor tiers no longer have. DBG_INCLINE is defined
'  by no build, so nothing here compiles. It is kept as it stood at SRC_REV 68, to be the start of the incline's window-free
'  redesign: its calls to panelShow(), operShown(), operWait(), readyAsk() and flLeg()'s former screen arguments name what
'  must be replaced first. The constants, variables and cells it feeds stay, and print NOMEAS.
#ifdef DBG_INCLINE
PRI steerSetHoldLimits(ceilingPct) : eError
' setHoldLimits() on both steering wheels (public since R20.1): a creep trial's ceiling with the provisional rise and time limit.
'
' @param ceilingPct - the hold's duty ceiling, % of duty_max
' @returns eError - the steering object's return

    beat(CP_LIB_HOLD)
    eError := steering.setHoldLimits(ceilingPct, wheelL.HOLD_RISE_MS, wheelL.HOLD_LIMIT_MS)
    beat(CP_LIB_HOLD)

PRI segIncline() | kindIdx, whyCode, slotIdx
' INCLINE (part SPIN; SRC_REV 62, the third floor situation; SRC_REV 36's CREEP): the floor situations' CON, 3. Its
' READY screen states the whole sequence and one START runs it, so the platform never waits on a screen while on the
' slope: the lifetime started on the flat at the slope's foot; the three climbs to the creep stops and their watches
' (incStop()), the last at the top; the drive back down to the start (incDown()). A SKIP or a timeout on the READY
' screen, or anything that ends a leg short, ends the segment: every stop after it prints NOT_RUN, and when the platform
' may be on the slope the CATCH screen asks him to hold it before anything is switched off (incCatch()). SRC_REV 63:
' the overloaded climb (incClimbTop(), incClimbRecords()) is removed -- the incline proves only the hold on a slope.
'
' @local kindIdx - CRK_COAST..CRK_HOLD
' @local whyCode - why the segment ended short, WHY_NONE while it runs
' @local slotIdx - motor slot

    segBegin(SEG_INCLINE)
    if bPanelUp == FALSE
        panelSetup()
    incSid := 0
    bIncStarted := FALSE
    bIncOnSlope := FALSE
    whyCode := readyAsk(PROMPT_INCLINE, BM_SCR_INC_READY, BM_STATE_INC_NEXT, 0)
    if whyCode == WHY_NONE
        panelShow(BM_SCR_FLOOR_SETUP, BM_STATE_INC_NEXT, PNL_BTN_NONE)
        operShown(PROMPT_INCLINE)
        if bRunContinue(SEG_INCLINE) == FALSE
            whyCode := WHY_ABORTED
        elseif bSteerStart(SEG_INCLINE) == FALSE
            whyCode := WHY_NO_COG
            if bSteerUp
                steerStop()
        elseif bPanelStopPressed()                          ' a STOP made while the start blocked cancels it
            whyCode := WHY_OPERATOR_STOP
        elseif bInstArm(INST_SRC_STEER, CREEP_DECIM) == FALSE
            whyCode := WHY_INST_NOACK
        else
            incSid := steerLife
            bIncStarted := TRUE
            waitBeat(SPIN_MIRROR_MS, CP_LOOP_READY)        ' the mirror refreshes on the instrument's next passes
            repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                incPos0[slotIdx] := instLastPos[slotIdx]    ' the net climb's zero, on the flat
            bInstFreeze(0)                                  ' each stop arms its own capture from here
    repeat kindIdx from CRK_COAST to CRK_HOLD
        beat(CP_LOOP_POLL)
        if whyCode == WHY_NONE
            whyCode := incStop(kindIdx)
        else
            creepNotRun(kindIdx, whyCode)
    if whyCode == WHY_NONE
        whyCode := incDown()
    if bSteerUp
        if (whyCode <> WHY_NONE) and bIncOnSlope
            incCatch()                                      ' he holds it before anything is switched off
        else
            steerStop()                                     ' idles the instrument first (I10); the ring stays drainable
    operFlush()
    crSegWhy := whyCode
    ' if/else, never `? :` (PL-29): segWhy() is a call
    if whyCode <> WHY_NONE
        segEnd(whyCode)
    else
        segEnd(segWhy())

PRI incStop(kind) : whyCode | slotIdx
' One incline stop (the floor situations' CON, 3., and CREEP's): its hold setting -- the coast control floats; the
' low-ceiling control and the hold set their ceiling and holdAtStop(TRUE) -- made before its climb; the capture armed;
' the climb of INC_LEG_TICKS to rest ON the slope (flLeg(), FLL_INC_UP); the watch from that rest (creepWatch()); the
' capture frozen. Then the platform is re-secured for the next climb BEFORE anything is printed: the hold is set at the
' provisional ceiling and a braked stop (the coast control's roll, a bound) cleared, so the release goes into the hold.
' Then the stop's statistics, records and folds. STOP or an abort ends the segment.
'
' @param kind - CRK_*
' @returns whyCode - WHY_NONE when the next leg may run, else why INCLINE must end
'
' @local slotIdx - motor slot

    crReset(kind)
    whyCode := WHY_NONE
    crSid := incSid
    if bSteerUp
        case kind
            CRK_COAST:
                steerHold(FALSE)
            CRK_LOWCEIL:
                crSetErr := steerSetHoldLimits(CREEP_LOW_CEIL_PCT)
                steerHold(TRUE)
            other:
                crSetErr := steerSetHoldLimits(CREEP_CEIL_PCT)
                steerHold(TRUE)
    if bRunContinue(SEG_INCLINE) == FALSE
        whyCode := WHY_ABORTED
    elseif bInstArm(INST_SRC_STEER, CREEP_DECIM) == FALSE
        whyCode := WHY_INST_NOACK
    else
        waitBeat(SPIN_MIRROR_MS, CP_LOOP_READY)            ' the mirror refreshes on the instrument's next passes
        whyCode := flLeg(FLL_INC_UP, SEG_INCLINE, PROMPT_INCLINE, BM_SCR_INC_CLIMB, BM_STATE_CRP_COAST + kind, INC_POWER, INC_LEG_TICKS, TRUE, TRUE)
        bIncOnSlope := TRUE
        if whyCode == WHY_NONE
            bCrReleased := TRUE                             ' at rest on the slope: the hold (or the float) is on from here
            crReleaseMs := fllMs
            creepWatch(kind)
            if (crStopBy == CRSTOP_OPERATOR) or (crStopBy == CRSTOP_ABORT)
                whyCode := crWhy
        bCrFrozen := bInstFreeze(0)
    if crWhy == WHY_NONE
        crWhy := whyCode
    if (whyCode == WHY_NONE) and bSteerUp
        incSecure()
    emitCreep(kind)
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        if bCrFrozen
            windowStats(slotIdx, SLOT_RIGHT - slotIdx, crWinStart, crWinEnd)
        else
            windowStats(slotIdx, SLOT_RIGHT - slotIdx, -1, -1)
        emitCreepW(kind, slotIdx)
    crFold(kind)
    segItems := (segItems + 1) <# LIM_SMALL

PRI incSecure()
' Between the incline's legs: the hold at the provisional ceiling, then -- when a watch braked the wheels (the coast
' control's roll, a bound) -- the emergency stop cleared, which writes zero commands and releases into that hold at
' rest, so the platform is held, not shorted, while the next climb is set up.

    steerSetHoldLimits(CREEP_CEIL_PCT)
    steerHold(TRUE)
    if bCrBraked
        beat(CP_LIB_ESTOP)
        steering.clearEmergency()
        beat(CP_LIB_ESTOP)
        bCrBraked := FALSE

PRI incDown() : whyCode | slotIdx, netTicks
' The incline's drive down (the floor situations' CON, 3.): the net climb -- the mean of each wheel's displacement on its
' driver's own pos from where the lifetime began on the flat -- armed first and driven back at the SLOW command,
' watched on the hold stop's frozen capture's mirror (FLL_INC_DOWN; SRC_REV 63, was the overloaded climb's). A net
' climb under a tick drives nothing.
'
' @returns whyCode - WHY_NONE when the platform is back at its start, else why INCLINE must end
'
' @local slotIdx - motor slot
' @local netTicks - the net climb, hall ticks

    whyCode := WHY_NONE
    netTicks := 0
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        netTicks += abs(instLastPos[slotIdx] - incPos0[slotIdx])
    netTicks := (netTicks / INST_MOTORS) <# (FL_LEG_TICKS + FL_OVER_TICKS)
    if bRunContinue(SEG_INCLINE) == FALSE
        whyCode := WHY_ABORTED
    elseif netTicks > 0
        whyCode := flLeg(FLL_INC_DOWN, SEG_INCLINE, PROMPT_INCLINE, BM_SCR_INC_DOWN, BM_STATE_INC_DOWN, 0 - INC_POWER, netTicks, TRUE, TRUE)
        waitRest(SIDE_BOTH, STOP_TIMEOUT_MS, FALSE)
    if whyCode == WHY_NONE
        bIncOnSlope := FALSE                                ' back on the flat

PRI incCatch() | buttonIdx, inputCode, shownMs
' The incline ended short with the platform on the slope: CATCH -- he takes hold and clicks DONE, and only then are the
' wheels switched off (steerStop()). A CATCH he never answers leaves them shorted, never released (emergencyCutoff()).
'
' @local buttonIdx - BM_BTN_DONE, or PNL_BTN_NONE on timeout
' @local inputCode - INPUT_* of that choice
' @local shownMs - getms() when the screen was drawn

    panelShow(BM_SCR_CREEP_CATCH, crResultState(), PNL_BTN_NONE)
    operShown(PROMPT_INCLINE)
    shownMs := getms()
    buttonIdx, inputCode, _ := operWait(scrCdMs(BM_SCR_CREEP_CATCH), SIDE_NONE, FALSE)
    if buttonIdx == BM_BTN_DONE
        operNote(PROMPT_INCLINE, OPEV_CAUGHT, ANS_NONE, inputCode, getms() - shownMs, WHY_NONE)
        steerStop()                                         ' idles the instrument first (I10); the ring stays drainable
    else
        operNote(PROMPT_INCLINE, OPEV_TIMEOUT, ANS_NONE, INPUT_NONE, getms() - shownMs, WHY_OPERATOR_TIMEOUT)
        steerEstop()                                        ' shorted, never released while it may be on the slope
    operFlush()

PRI crReset(kind) | slotIdx
' Clear one creep trial's staging.
'
' @param kind - CRK_*
'
' @local slotIdx - motor slot

    crKind := kind
    crSid := 0
    crStopBy := CRSTOP_NOT_RUN
    crWhy := WHY_NONE
    crSetErr := NO_ERROR
    bCrReleased := FALSE
    crReleaseMs := 0
    crWinMs := 0
    crBoundTicks := 0
    crWinStart := -1
    crWinEnd := -1
    bCrFrozen := FALSE
    bCrBraked := FALSE                                      ' the stop before this one cleared its own (incSecure())
    bCrPolled := FALSE
    crAmpsN := 0
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        crRelHw[slotIdx] := 0
        crCreep[slotIdx] := 0
        crHoldCreep[slotIdx] := 0
        crState[slotIdx] := wheelL.HS_OFF
        crDisp[slotIdx] := 0
        crCeilDuty[slotIdx] := 0
        crDutyPk[slotIdx] := 0
        crDutyEnd[slotIdx] := 0
        crCeilMs[slotIdx] := 0
        crSlips0[slotIdx] := 0
        crLimits0[slotIdx] := 0
        crSlips[slotIdx] := 0
        crLimits[slotIdx] := 0
        crAmpsSum[slotIdx] := 0

PRI creepWatch(kind) | winMs, startMs, lastPollMs, slotIdx, safeNow, creepNow
' The watch at an incline stop, from the moment both wheels read DCS_STOPPED there (SRC_REV 62; until then from his
' letting go): the reference -- each wheel's hwPos on the instrument's own hall decode, and a first hold poll; then
' every SAMPLE_MS the safety read and each wheel's creep from that reference (crCreep, and crHoldCreep while the last
' poll read HS_HOLDING), and every CREEP_POLL_MS a hold poll (crPollHold()). It ends at the trial's window
' (CRSTOP_TIMER), at its bound of creep on either wheel (CRSTOP_BOUND, the phases shorted at once), on STOP
' (CRSTOP_OPERATOR, shorted), or on the current abort or a stalled instrument (CRSTOP_ABORT). The coast control's window
' and bound are its own: it is braked as soon as it has shown the roll it exists to show. A brake sets bCrBraked.
'
' @param kind - CRK_*
'
' @local winMs - the trial's window
' @local startMs - getms() at the release
' @local lastPollMs - getms() of the last hold poll
' @local slotIdx - motor slot
' @local safeNow - this pass's safety read
' @local creepNow - this pass's creep on one wheel, ticks

    winMs := CREEP_WIN_MS
    crBoundTicks := CREEP_BOUND_TICKS
    if kind == CRK_COAST
        winMs := CREEP_CTRL_WIN_MS
        crBoundTicks := CREEP_CTRL_TICKS
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        crRelHw[slotIdx] := instLastHw[slotIdx]
    crPollHold()
    crWinStart := instTotal
    panelShow(BM_SCR_CREEP_WATCH, BM_STATE_EXP_COAST + kind, PNL_BTN_NONE)
    operShown(PROMPT_INCLINE)
    safetyReset()
    startMs := getms()
    lastPollMs := startMs
    crStopBy := CRSTOP_TIMER
    repeat
        beat(CP_LOOP_CAPTURE)
        panelTick(startMs, winMs)
        waitms(SAMPLE_MS)
        safeNow := safetyPoll(SIDE_BOTH)
        if (safeNow == SAFE_ABS_ABORT) or (safeNow == SAFE_INST_STALL)
            crStopBy := CRSTOP_ABORT
            crWhy := safeWhy(safeNow)
            if bSteerUp
                steerEstop()
                bCrBraked := TRUE
            quit
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            creepNow := abs(instLastHw[slotIdx] - crRelHw[slotIdx])
            crCreep[slotIdx] #>= creepNow
            if crState[slotIdx] == wheelL.HS_HOLDING
                crHoldCreep[slotIdx] #>= creepNow
        if (crCreep[SLOT_LEFT] #> crCreep[SLOT_RIGHT]) >= crBoundTicks
            crStopBy := CRSTOP_BOUND
            steerEstop()
            bCrBraked := TRUE
            quit
        if bPanelStopPressed()
            crStopBy := CRSTOP_OPERATOR
            crWhy := WHY_OPERATOR_STOP
            steerEstop()
            bCrBraked := TRUE
            quit
        if (getms() - lastPollMs) >= CREEP_POLL_MS
            lastPollMs := getms()
            crPollHold()
        if (getms() - startMs) >= winMs
            quit
    if crStopBy == CRSTOP_TIMER
        crPollHold()                                        ' the hold as its window ends; a braked trial keeps its last poll
    crWinEnd := instTotal
    crWinMs := getms() - startMs

PRI crPollHold() | slotIdx, eLeftState, nLeftDisp, eRightState, nRightDisp, holdDuty, ceilDuty, ceilPasses, nSlips, nLimits, nLtAmps, nRtAmps
' One hold poll: each wheel's getHoldStatus() -- its state and the driver's own displacement -- and testGetHold() --
' the hold duty now, the ceiling in force, the passes at it, and the slip and limit events, counted from the first poll
' -- and getCurrent(), net of the rest zero.
'
' @local slotIdx - motor slot
' @local eLeftState - the left wheel's HS_*
' @local nLeftDisp - its displacement, ticks
' @local eRightState - the right wheel's HS_*
' @local nRightDisp - its displacement
' @local holdDuty - one wheel's hold duty now
' @local ceilDuty - its ceiling
' @local ceilPasses - its consecutive front passes (ms) at the ceiling
' @local nSlips - its holds ended by a slip since start
' @local nLimits - its holds ended by the time limit since start
' @local nLtAmps - the left wheel's getCurrent(), A x 10_000
' @local nRtAmps - the right wheel's

    beat(CP_LIB_STEER_QUERY)
    eLeftState, nLeftDisp, eRightState, nRightDisp := steering.getHoldStatus()
    nLtAmps, _, nRtAmps, _ := steering.getCurrent()
    beat(CP_LIB_STEER_QUERY)
    crState[SLOT_LEFT] := eLeftState
    crDisp[SLOT_LEFT] := nLeftDisp
    crState[SLOT_RIGHT] := eRightState
    crDisp[SLOT_RIGHT] := nRightDisp
    crAmpsSum[SLOT_LEFT] += (nLtAmps #> (0 - LIM_MID)) <# LIM_MID
    crAmpsSum[SLOT_RIGHT] += (nRtAmps #> (0 - LIM_MID)) <# LIM_MID
    crAmpsN += 1
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        beat(CP_LIB_STEER_QUERY)
        if slotIdx == SLOT_RIGHT                            ' if/else, never `? :` -- PL-29, PL-76
            holdDuty, ceilDuty, ceilPasses, nSlips, nLimits := steering.testRightGetHold()
        else
            holdDuty, ceilDuty, ceilPasses, nSlips, nLimits := steering.testLeftGetHold()
        beat(CP_LIB_STEER_QUERY)
        if bCrPolled == FALSE
            crSlips0[slotIdx] := nSlips
            crLimits0[slotIdx] := nLimits
            crDutyPk[slotIdx] := holdDuty
        crDutyPk[slotIdx] #>= holdDuty
        crDutyEnd[slotIdx] := holdDuty
        crCeilDuty[slotIdx] := ceilDuty
        crCeilMs[slotIdx] #>= ceilPasses
        crSlips[slotIdx] := nSlips - crSlips0[slotIdx]
        crLimits[slotIdx] := nLimits - crLimits0[slotIdx]
    bCrPolled := TRUE

PRI crResultState() : stateIdx | slotIdx, bSlip, bLimit, bCrept
' The CATCH screen's result line (rule 10.3: what he just saw, in the API's words for the hold): a released coast rolled
' or did not; a hold slipped, hit its time limit, crept while holding, or held still (the worst wheel's).
'
' @returns stateIdx - BM_STATE_RES_*
'
' @local slotIdx - motor slot
' @local bSlip - a wheel's hold read HS_SLIPPED
' @local bLimit - a wheel's hold read HS_LIMITED
' @local bCrept - a wheel crept at least a tick

    if bCrReleased == FALSE
        stateIdx := BM_STATE_RES_NOTRUN
    elseif crKind == CRK_COAST
        stateIdx := BM_STATE_RES_NOROLL
        if (crCreep[SLOT_LEFT] #> crCreep[SLOT_RIGHT]) >= CREEP_CTRL_TICKS
            stateIdx := BM_STATE_RES_ROLLED
    else
        bSlip := FALSE
        bLimit := FALSE
        bCrept := FALSE
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            if crState[slotIdx] == wheelL.HS_SLIPPED
                bSlip := TRUE
            elseif crState[slotIdx] == wheelL.HS_LIMITED
                bLimit := TRUE
            if crCreep[slotIdx] > 0
                bCrept := TRUE
        if bSlip
            stateIdx := BM_STATE_RES_SLIPPED
        elseif bLimit
            stateIdx := BM_STATE_RES_LIMITED
        elseif bCrept
            stateIdx := BM_STATE_RES_CREPT
        else
            stateIdx := BM_STATE_RES_HOLDING

PRI crFold(kind) | slotIdx
' Fold a released trial into its cells: the coast control's roll or the low-ceiling control's creep, each the farther
' wheel's; or, for the hold, each wheel's creep while HOLDING and whether it was HOLDING when its window ran out.
'
' @param kind - CRK_*
'
' @local slotIdx - motor slot

    if bCrReleased
        case kind
            CRK_COAST:
                bSfCrCoastRan := TRUE
                sfCrCoastTicks := crCreep[SLOT_LEFT] #> crCreep[SLOT_RIGHT]
            CRK_LOWCEIL:
                bSfCrLowRan := TRUE
                sfCrLowTicks := crCreep[SLOT_LEFT] #> crCreep[SLOT_RIGHT]
            other:
                repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                    bSfCreepRan[slotIdx] := TRUE
                    sfCreepTicks[slotIdx] := crHoldCreep[slotIdx]
                    bSfCrHoldOk[slotIdx] := (crStopBy == CRSTOP_TIMER) and (crState[slotIdx] == wheelL.HS_HOLDING)

#endif

PRI bCreepMeasured(slotIdx) : bMeasured
' Whether the hold's cells have an instance on a wheel: the hold trial was released AND the coast control rolled -- an
' incline that does not roll a floated platform does not load the hold, and a hold that "holds" there is no evidence.
'
' @param slotIdx - motor slot
' @returns bMeasured - T/F where T means R19-DUAL-CREEP-P and R19-DUAL-CRPHOLD-P judge this wheel

    bMeasured := bSfCreepRan[slotIdx] and bSfCrCoastRan and (sfCrCoastTicks >= CREEP_CTRL_TICKS)

#ifdef DBG_INCLINE
PRI creepNotRun(kind, whyCode) | slotIdx
' BM-CREEP and BM-CREEPW for a trial that never ran: the cause, every reading NA.
'
' @param kind - CRK_*
' @param whyCode - WHY_* naming why
'
' @local slotIdx - motor slot

    crReset(kind)
    crWhy := whyCode
    emitCreep(kind)
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        windowStats(slotIdx, SLOT_RIGHT - slotIdx, -1, -1)  ' resets the rs* staging; reads no ring long
        emitCreepW(kind, slotIdx)
#endif

PRI spinPairAmps(pairIdx, slotIdx) : bValid, nAmps | arrRight, arrLeft
' One wheel's mean window current over a pair's two legs (RIGHT and LEFT), net of the rest zero.
'
' @param pairIdx - SPIN_PAIR_*
' @param slotIdx - motor slot
' @returns bValid - T/F where T means both legs' windows were measured
' @returns nAmps - their mean, A x 10_000
'
' @local arrRight - the RIGHT leg's index into spLegAmps
' @local arrLeft - the LEFT leg's

    arrRight := (((pairIdx * SPIN_DIRS) + SPIN_DIR_RIGHT) * INST_MOTORS) + slotIdx
    arrLeft := (((pairIdx * SPIN_DIRS) + SPIN_DIR_LEFT) * INST_MOTORS) + slotIdx
    bValid := (bSpLegAmps[arrRight] <> FALSE) and (bSpLegAmps[arrLeft] <> FALSE)
    nAmps := (spLegAmps[arrRight] + spLegAmps[arrLeft]) / 2

PRI spinSymRatio(slotIdx) : bMeasured, nRatioX100 | arrRight, arrLeft, rightAmps, leftAmps
' R19-DUAL-SPINSYM-P's reading: at the MEDIUM rung on the confirmed pair, the wheel's larger direction current over its
' smaller, x100 (the RIGHT leg runs the motor's positive increments, the LEFT its negative).
'
' @param slotIdx - motor slot
' @returns bMeasured - T/F where T means both directions were measured with a positive current
' @returns nRatioX100 - the ratio, x100; 0 when not measured
'
' @local arrRight - the RIGHT leg's index into spLegAmps
' @local arrLeft - the LEFT leg's
' @local rightAmps - its current, A x 10_000
' @local leftAmps - the LEFT leg's

    arrRight := (((SPIN_PAIR_MED * SPIN_DIRS) + SPIN_DIR_RIGHT) * INST_MOTORS) + slotIdx
    arrLeft := (((SPIN_PAIR_MED * SPIN_DIRS) + SPIN_DIR_LEFT) * INST_MOTORS) + slotIdx
    rightAmps := spLegAmps[arrRight]
    leftAmps := spLegAmps[arrLeft]
    bMeasured := (bSpLegAmps[arrRight] <> FALSE) and (bSpLegAmps[arrLeft] <> FALSE) and (rightAmps > 0) and (leftAmps > 0)
    nRatioX100 := 0
    if bMeasured
        nRatioX100 := ((rightAmps #> leftAmps) * SPIN_X100) / (rightAmps <# leftAmps)

PRI spinOverRatio(pairNum, pairDen, slotIdx) : bMeasured, nRatioX100 | bNum, numAmps, bDen, denAmps
' One wheel's mean current over one pair's two legs against another's, x100: SPINCTL (the legacy control over the
' confirmed pair at MEDIUM) and SPINLEAD (the schedule's quarter over the fixed pair's).
'
' @param pairNum - the numerator's SPIN_PAIR_*
' @param pairDen - the denominator's SPIN_PAIR_*
' @param slotIdx - motor slot
' @returns bMeasured - T/F where T means all four legs were measured with a positive current
' @returns nRatioX100 - the ratio, x100; 0 when not measured
'
' @local bNum - the numerator pair was measured
' @local numAmps - its mean, A x 10_000
' @local bDen - the denominator pair was measured
' @local denAmps - its mean

    bNum, numAmps := spinPairAmps(pairNum, slotIdx)
    bDen, denAmps := spinPairAmps(pairDen, slotIdx)
    bMeasured := bNum and bDen and (numAmps > 0) and (denAmps > 0)
    nRatioX100 := 0
    if bMeasured
        nRatioX100 := (numAmps * SPIN_X100) / denAmps

PRI spinPairsAtRate(pairNum, pairDen, slotIdx) : bAtRate, whyCode | legSel, pairIdx, arrIdx
' SRC_REV 75 (task 3657): SPINCTL's and SPINLEAD's PRECONDITION -- whether one wheel read at least SPINRATE_FOL_LO % of its
' command (BM-SPINW fol_pct) on ALL FOUR legs of the two pairs being compared (each pair's RIGHT and LEFT), so that their
' currents are at one speed. The first leg that fails names itself: a leg whose reading was never taken gives that leg's own
' cause (spLegWhy, as BM-XRUN does for a missing current), a leg that read under the floor gives WHY_NOT_AT_CMD_SPEED.
'
' @param pairNum - the first pair, SPIN_PAIR_*
' @param pairDen - the second pair
' @param slotIdx - motor slot
' @returns bAtRate - T/F where T means all four legs read at least SPINRATE_FOL_LO %
' @returns whyCode - WHY_NONE when they did, else why not
'
' @local legSel - 0..3: the first pair's RIGHT and LEFT, then the second's
' @local pairIdx - the leg's pair
' @local arrIdx - the leg's [leg * INST_MOTORS + slot] index

    bAtRate := TRUE
    whyCode := WHY_NONE
    repeat legSel from 0 to (SPIN_DIRS * 2) - 1
        pairIdx := pairNum
        if legSel >= SPIN_DIRS
            pairIdx := pairDen
        arrIdx := (((pairIdx * SPIN_DIRS) + (legSel // SPIN_DIRS)) * INST_MOTORS) + slotIdx
        if bAtRate
            if bSpLegFol[arrIdx] == FALSE
                bAtRate := FALSE
                whyCode := spLegWhy[arrIdx]
                if whyCode == WHY_NONE
                    whyCode := WHY_NO_SAMPLES               ' its window ran but no following was read
            elseif spLegFol[arrIdx] < SPINRATE_FOL_LO
                bAtRate := FALSE
                whyCode := WHY_NOT_AT_CMD_SPEED

PRI bSpinCellSettled(nJudged, bAnyBad, nExpected) : bSettled
' SRC_REV 75 (task 3657): whether a cell that claims "every leg" has anything to say. A violation settles it at once (one bad leg
' is a FAIL whatever the others did, so it needs no other leg); a PASS needs every leg the run expects judged, because a leg that
' never ran, or whose reading was lost, may be the one that breaks the claim. Otherwise NOMEAS, never a PASS on the legs that happened
' to read: a cell whose precondition did not arise must not read as the claim holding.
'
' @param nJudged - the legs (or wheel-legs) that gave a reading
' @param bAnyBad - T/F where T means one of them broke the claim
' @param nExpected - how many the run was to judge
' @returns bSettled - T/F where T means the cell is measured

    bSettled := (nJudged > 0) and (bAnyBad or (nJudged >= nExpected))

PRI emitSpinCells() | slotIdx, side, bMeas, nRatio, bAtRate
' The SPIN part's judged cells, each NOMEAS when nothing measured it (NOSTALL, DBGMASK and LAGBND are the caller's). On
' the platform: TRACES, SPINSTOP, SPINOFF, SPINDIR COUNT. Per motor: RSTPROV, SPINHUNT (A-3) and SPINERR (A-4) COUNT,
' SPINSTRT PERMILLE (A-1's worst drop), SPINPEAK X100 (A-2's worst ratio), SPINFOL (A-8's widest gap, points), SPINSYM,
' SPINCTL and SPINLEAD X100 (SRC_REV 69: each compares the legs of several runs, so in a one-leg run it prints NOMEAS and,
' in a SPIN image, a BM-XRUN naming why -- emitAcrossRuns(); SRC_REV 74: a session judges its own pair, so there a NOMEAS
' names the leg that did not measure it). SRC_REV 75: SPINCTL and SPINLEAD are judged only when the wheel read SPINRATE_FOL_LO %
' on all four legs (spinPairsAtRate()). SPINPLAT PCT, X-5 on FAULTRUN's leg back: the wheel NOT faulted only (SRC_REV 62: one
' fault, on FLR_SIDE; the old pair of fault legs faulted each wheel once). Then the incline: its two controls, CRPCOAST
' and CRPLOW TICKS, before the hold they validate -- per motor CREEP TICKS and CRPHOLD BOOL, NOMEAS unless the coast
' control rolled (bCreepMeasured()). SRC_REV 75, the hold-speed fix's cells (the section's CON states each one's criterion, its
' unfixed value and its rival): per motor SPINRATE PCT (the lowest following) and SPINHOLD COUNT (legs that held or path-limited);
' on the platform LIMGIVE COUNT (give-way slots and legs with no limiter) and RAMPARR COUNT (ramp legs late or path-limited).
'
' @local slotIdx - motor slot
' @local side - SIDE_LEFT or SIDE_RIGHT
' @local bMeas - a ratio cell's instance was measured
' @local nRatio - its ratio, x100
' @local bAtRate - the wheel read SPINRATE_FOL_LO % of its command on every leg of the two pairs compared

    emitSignoff(@sSfCellTracesP, SIDE_NONE, @sSfCritTraces, sfTraces > 0, sfTraceLost, TRACE_LOST_LO, TRACE_LOST_HI, sfTraces, @sSfUnitsCount)
    emitSignoff(@sSfCellSpStop, SIDE_BOTH, @sSfCritSpStop, sfSpStopN > 0, sfSpStopBad, SPIN_BAD_LO, SPIN_BAD_HI, sfSpStopN, @sSfUnitsCount)
    emitSignoff(@sSfCellSpOff, SIDE_BOTH, @sSfCritSpOff, sfSpOffN > 0, sfSpOffBad, SPIN_BAD_LO, SPIN_BAD_HI, sfSpOffN, @sSfUnitsCount)
    emitSignoff(@sSfCellSpDir, SIDE_BOTH, @sSfCritSpDir, sfSpDirN > 0, sfSpDirBad, SPIN_BAD_LO, SPIN_BAD_HI, sfSpDirN, @sSfUnitsCount)
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        side := SIDE_LEFT + slotIdx
        emitSignoff(@sSfCellRstProvP, side, @sSfCritRstProv, sfFaults[slotIdx] > 0, sfResetUncleared[slotIdx], RESET_UNCLEAR_LO, RESET_UNCLEAR_HI, sfFaults[slotIdx], @sSfUnitsCount)
        emitSignoff(@sSfCellSpHunt, side, @sSfCritSpHunt, sfSpHuntN[slotIdx] > 0, sfSpHuntBad[slotIdx], SPIN_BAD_LO, SPIN_BAD_HI, sfSpHuntN[slotIdx], @sSfUnitsCount)
        emitSignoff(@sSfCellSpErr, side, @sSfCritSpErr, sfSpErrN[slotIdx] > 0, sfSpErrBad[slotIdx], SPIN_BAD_LO, SPIN_BAD_HI, sfSpErrN[slotIdx], @sSfUnitsCount)
        emitSignoff(@sSfCellSpStrt, side, @sSfCritSpStrt, sfSpA1N[slotIdx] > 0, sfSpA1Max[slotIdx], 0, A1_DROP_PM_HI, sfSpA1N[slotIdx], @sSfUnitsPm)
        emitSignoff(@sSfCellSpPeak, side, @sSfCritSpPeak, sfSpA2N[slotIdx] > 0, sfSpA2Max[slotIdx], 0, A2_EXCESS_MV_HI, sfSpA2N[slotIdx], @sSfUnitsMv)
        emitSignoff(@sSfCellSpFol, side, @sSfCritFolGap, sfSpFolN[slotIdx] > 0, sfSpFolMax[slotIdx], FOLAGREE_LO, FOLAGREE_HI, sfSpFolN[slotIdx], @sSfUnitsCount)
        bMeas, nRatio := spinSymRatio(slotIdx)
        emitSignoff(@sSfCellSpSym, side, @sSfCritSpSym, bMeas, nRatio, SPINSYM_LO, SPINSYM_HI, SPIN_DIRS, @sSfUnitsX100)
#ifdef DBF_SPINLEG
        if bMeas == FALSE
            emitAcrossRuns(@sSfCellSpSym, side, SPIN_PAIR_MED, SPIN_PAIR_MED)
#endif
        ' SRC_REV 75 (task 3657): SPINCTL and SPINLEAD compare two pairs' currents, which means the offsets' cost only at ONE speed:
        '  judged only when this wheel read SPINRATE_FOL_LO % of its command on all four legs (spinPairsAtRate()), else NOMEAS
        bMeas, nRatio := spinOverRatio(SPIN_PAIR_LEGACY, SPIN_PAIR_MED, slotIdx)
        bAtRate, _ := spinPairsAtRate(SPIN_PAIR_LEGACY, SPIN_PAIR_MED, slotIdx)
        bMeas := bMeas and bAtRate
        emitSignoff(@sSfCellSpCtl, side, @sSfCritSpCtl, bMeas, nRatio, SPINCTL_LO, LIM_BIG, SPIN_DIRS * 2, @sSfUnitsX100)
#ifdef DBF_SPINLEG
        if bMeas == FALSE
            emitAcrossRuns(@sSfCellSpCtl, side, SPIN_PAIR_LEGACY, SPIN_PAIR_MED)
#endif
        bMeas, nRatio := spinOverRatio(SPIN_PAIR_BRISK, SPIN_PAIR_FIXED, slotIdx)
        bAtRate, _ := spinPairsAtRate(SPIN_PAIR_BRISK, SPIN_PAIR_FIXED, slotIdx)
        bMeas := bMeas and bAtRate
        emitSignoff(@sSfCellSpLead, side, @sSfCritSpLead, bMeas, nRatio, SPINLEAD_LO, SPINLEAD_HI, SPIN_DIRS * 2, @sSfUnitsX100)
#ifdef DBF_SPINLEG
        if bMeas == FALSE
            emitAcrossRuns(@sSfCellSpLead, side, SPIN_PAIR_BRISK, SPIN_PAIR_FIXED)
#endif
        ' SRC_REV 75: the hold-speed fix's cells. SPINRATE: the lowest following any leg read, a FAIL as soon as one reads under
        '  SPINRATE_FOL_LO, a PASS only when every leg the run began read one; SPINHOLD: legs that held or path-limited
        emitSignoff(@sSfCellSpRate, side, @sSfCritSpRate, bSpinCellSettled(sfSpRateN[slotIdx], sfSpRateMin[slotIdx] < SPINRATE_FOL_LO, sfSpLegsTried), sfSpRateMin[slotIdx], SPINRATE_FOL_LO, LIM_BIG, sfSpRateN[slotIdx], @sSfUnitsPct)
        emitSignoff(@sSfCellSpHold, side, @sSfCritSpHold, bSpinCellSettled(sfSpHoldN[slotIdx], sfSpHoldBad[slotIdx] > 0, sfSpLegsTried), sfSpHoldBad[slotIdx], SPIN_BAD_LO, SPIN_BAD_HI, sfSpHoldN[slotIdx], @sSfUnitsCount)
    ' LIMGIVE: the sampler's give-way slots with no limiter, and the legs that path-limited with none; measured once each wheel was sampled
    emitSignoff(@sSfCellLimGive, SIDE_BOTH, @sSfCritLimGive, (sfLgSamples[SLOT_LEFT] > 0) and (sfLgSamples[SLOT_RIGHT] > 0), sfLgBad[SLOT_LEFT] + sfLgBad[SLOT_RIGHT] + sfLgLegBad, SPIN_BAD_LO, SPIN_BAD_HI, sfLgSamples[SLOT_LEFT] + sfLgSamples[SLOT_RIGHT], @sSfUnitsCount)
    ' RAMPARR: the ramp legs late or path-limited; a FAIL as soon as one is, a PASS only when all RAMP_LEGS were judged
    emitSignoff(@sSfCellRampArr, SIDE_BOTH, @sSfCritRampArr, bSpinCellSettled(sfRampN, sfRampBad > 0, RAMP_LEGS), sfRampBad, SPIN_BAD_LO, SPIN_BAD_HI, sfRampN, @sSfUnitsCount)
    slotIdx := SLOT_RIGHT - (FLR_SIDE - SIDE_LEFT)          ' X-5's watched wheel: the one FAULTRUN does not fault
    emitSignoff(@sSfCellSpPlat, SIDE_LEFT + slotIdx, @sSfCritPlatStop, bSfPlatRan[slotIdx], sfPlatPct[slotIdx], FR_PLAT_PCT_LO, FR_PLAT_REST_PCT, SIGNOFF_ONE_INSTANCE, @sSfUnitsPct)
    emitSignoff(@sSfCellCrCoast, SIDE_BOTH, @sSfCritCrCoast, bSfCrCoastRan, sfCrCoastTicks, CREEP_CTRL_TICKS, LIM_BIG, CREEP_ONE_TRIAL, @sSfUnitsTicks)
    emitSignoff(@sSfCellCrLow, SIDE_BOTH, @sSfCritCrLow, bSfCrLowRan, sfCrLowTicks, wheelL.HOLD_SLIP_TICKS, LIM_BIG, CREEP_ONE_TRIAL, @sSfUnitsTicks)
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        side := SIDE_LEFT + slotIdx
        emitSignoff(@sSfCellCreep, side, @sSfCritCreep, bCreepMeasured(slotIdx), sfCreepTicks[slotIdx], CREEP_ZERO_LO, CREEP_ZERO_HI, CREEP_ONE_TRIAL, @sSfUnitsTicks)
        emitSignoffBool(@sSfCellCrHold, side, @sSfCritCrHold, bCreepMeasured(slotIdx), bSfCrHoldOk[slotIdx], CREEP_ONE_TRIAL)

PRI emitSpinHeader() | legIdx
' The SPIN part's header, printed before anything moves, for this image's action only (SRC_REV 69; the image compiles
' only that action's records): a SPIN leg prints BM-SPINBUILD (the travel limit and its derivation from the track width),
' BM-SPINPRE (every pre-registered band) and its one BM-SPINLEG (what it will run and the pair it must apply); OBSTACLE,
' GRAB and FAULTRUN print SRC_REV 58's BM-BLKBUILD, BM-LDBUILD or BM-RDBUILD (the load cells' pre-registered numbers) and
' SRC_REV 62's BM-FLBUILD (the floor rules' own). BM-CRPBUILD, the incline's numbers, is not printed: INCLINE is compiled
' out. SRC_REV 70, the sessions: FLOOR_ACT_AUTO prints all ten BM-SPINLEG rows (legIdx), FAULTRUN's two build records, the ramp
' legs' BM-RAMPBUILD and the fence's BM-FENCEBUILD; FLOOR_ACT_OBSTACLE prints OBSTACLE's two and the fence's.
'
' @local legIdx - 0..SPIN_LEGS-1, a session's leg rows

#ifdef DBF_SPINLEG
    emitSpinBuild()
    emitSpinPre()
#ifdef DBF_AUTO
    repeat legIdx from 0 to SPIN_LEGS - 1
        emitSpinLegPlan(legIdx)
#else
    emitSpinLegPlan((spinActPair[FLOOR_SPIN_KIND] * SPIN_DIRS) + FLOOR_SPIN_DIR)
#endif
#endif
#ifdef DBF_OBST
    emitBlkBuild()
    emitFlBuild()
#endif
#ifdef DBF_GRAB
    emitLdBuild()
    emitFlBuild()
#endif
#ifdef DBF_FAULTRUN
    emitRdBuild()
    emitFlBuild()
#endif
#ifdef DBF_RAMP
    emitRampBuild()
#endif
#ifdef DBG_FENCE
    emitFenceBuild()
#endif

#ifdef DBF_SPINLEG
PRI emitSpinBuild()
' BM-SPINBUILD: the travel limit and its derivation -- the track width, pi as a ratio, the tyre travel per tick, one
' platform revolution in 0.01 mm, the limit in degrees and in ticks, the millimetres stopAfterDistance() is given and the
' ticks the steering object turns them back into (tick_back, which must equal leg_ticks), the over-travel guard's
' margin, the stop's tolerance, the leg bound and the leg count. SRC_REV 74 (FMT 49): the quarter's two-turn limit, the same
' four numbers as f_deg, f_ticks, f_mm and f_back (which must equal f_ticks). Worst case 267 bytes: the 212 it was, plus
' ",f_deg," + LIM_TINY's 4, ",f_ticks," + LIM_SMALL's 7, ",f_mm," + 7 and ",f_back," + 7 = 11 + 16 + 13 + 15 = 55.

    recBegin(@"BM-SPINBUILD")
    benchLog.numField(@"track_mm", TRACK_MM, LIM_SMALL)
    benchLog.numField(@"pi_num", SPIN_PI_NUM, LIM_TINY)
    benchLog.numField(@"pi_den", SPIN_PI_DEN, LIM_TINY)
    benchLog.numField(@"tick_x100", TICK_MM_X100, LIM_SMALL)
    benchLog.numField(@"rev_x100", SPIN_REV_MM_X100, LIM_MID)
    benchLog.numField(@"leg_deg", SPIN_LEG_DEG, LIM_TINY)
    benchLog.numField(@"leg_ticks", SPIN_LEG_TICKS, LIM_SMALL)
    benchLog.numField(@"leg_mm", SPIN_LEG_MM, LIM_SMALL)
    benchLog.numField(@"tick_back", (SPIN_LEG_MM * SPIN_X100) / TICK_MM_X100, LIM_SMALL)
    benchLog.numField(@"f_deg", SPIN_FAST_LEG_DEG, LIM_TINY)
    benchLog.numField(@"f_ticks", SPIN_FAST_LEG_TICKS, LIM_SMALL)
    benchLog.numField(@"f_mm", SPIN_FAST_LEG_MM, LIM_SMALL)
    benchLog.numField(@"f_back", (SPIN_FAST_LEG_MM * SPIN_X100) / TICK_MM_X100, LIM_SMALL)
    benchLog.numField(@"over", SPIN_OVERTRAVEL_TICKS, LIM_TINY)
    benchLog.numField(@"tol", SPIN_STOP_TOL_TICKS, LIM_TINY)
    benchLog.numField(@"leg_ms", SPIN_LEG_MS, LIM_SMALL)
    benchLog.numField(@"legs", SPIN_LEGS, LIM_TINY)
    emitRecord()

PRI emitSpinPre()
' BM-SPINPRE: every band the SPIN cells are judged against, pre-registered: A-1's drop and A-2's ratio with its tail and
' duty's floor, A-3's swing and err peak, A-4's point, SPINSYM's ceiling, SPINCTL's floor, SPINLEAD's ceiling, A-8's
' gap, X-5's rest percentage, and the settle and AT_SPEED bounds they are read after. SRC_REV 75 (FMT 50): SPINRATE's floor, rate_lo
' (also SPINCTL's and SPINLEAD's precondition), and the limiter sampler's look-back, look_ms (LIMGIVE). Worst case 263 bytes: the
' 237 it was plus ",rate_lo," + LIM_TINY's 4 and ",look_ms," + 4 = 13 + 13.

    recBegin(@"BM-SPINPRE")
    benchLog.numField(@"a1_pm", A1_DROP_PM_HI, LIM_TINY)
    benchLog.numField(@"a2_x100", A2_RATIO_X100_HI, LIM_TINY)
    benchLog.numField(@"a2_tail", A2_TAIL_SAMPLES, LIM_TINY)
    benchLog.numField(@"floor", SPIN_DUTY_FLOOR, LIM_SMALL)
    benchLog.numField(@"a3_swing", A3_SWING_HI, LIM_TINY)
    benchLog.numField(@"a3_err", A3_ERR_PK_HI, LIM_TINY)
    benchLog.numField(@"a4_lo", A4_ERR_LO, LIM_TINY)
    benchLog.numField(@"a4_hi", A4_ERR_HI, LIM_TINY)
    benchLog.numField(@"sym_hi", SPINSYM_HI, LIM_TINY)
    benchLog.numField(@"ctl_lo", SPINCTL_LO, LIM_TINY)
    benchLog.numField(@"lead_hi", SPINLEAD_HI, LIM_TINY)
    benchLog.numField(@"fol_hi", FOLAGREE_HI, LIM_TINY)
    benchLog.numField(@"plat_pct", FR_PLAT_REST_PCT, LIM_TINY)
    benchLog.numField(@"rate_lo", SPINRATE_FOL_LO, LIM_TINY)
    benchLog.numField(@"look_ms", LG_LOOK_MS, LIM_TINY)
    benchLog.numField(@"settle_ms", SPIN_SETTLE_MS, LIM_SMALL)
    benchLog.numField(@"atspd_ms", SPIN_ATSPEED_MS, LIM_SMALL)
    emitRecord()

PRI emitSpinLegPlan(legIdx) | pairIdx, dirIdx, speedIdx, leftPwr, nIncre, wantNeg, wantPos
' BM-SPINLEG: one row of the leg table, printed before anything moves -- the leg's number (1-based, as the run sheet
' numbers it), pair, commutation pair, speed and direction; the left wheel's power (the right's is its
' negation); the increment that power commands (spinIncre()) and C-1's predicted tick rate for it; the steady window;
' the pair each driver must apply (SPINOFF's expectation); and whether the leg is drained as a trace. SRC_REV 62: the
' kind field is gone with the FAULT legs. SRC_REV 74 (FMT 49): leg_tk, the leg's own travel limit in ticks (211, or 422 at
' the quarter). Worst case 215 bytes: the 200 it was plus ",leg_tk," (8) and LIM_SMALL's 7.
'
' @param legIdx - 0..SPIN_LEGS-1
'
' @local pairIdx - its pair
' @local dirIdx - SPIN_DIR_*
' @local speedIdx - SPIN_SPEED_*
' @local leftPwr - the left wheel's power
' @local nIncre - the increment the power commands
' @local wantNeg - the expected offset_fwd
' @local wantPos - the expected offset_rev

    pairIdx := legIdx / SPIN_DIRS
    dirIdx := legIdx // SPIN_DIRS
    speedIdx := spinPairSpeed[pairIdx]
    leftPwr := spinPower[speedIdx]
    if dirIdx == SPIN_DIR_LEFT
        leftPwr := 0 - leftPwr
    nIncre := spinIncre(spinPower[speedIdx])
    wantNeg, wantPos := spinExpectedPair(spinPairOffs[pairIdx], speedIdx)
    recBegin(@"BM-SPINLEG")
    benchLog.numField(@"leg", legIdx + 1, LIM_TINY)
    benchLog.numField(@"pair", pairIdx + 1, LIM_TINY)
    benchLog.tokenField(@"offs", tokenAt(@tokSpOff, SPOFF_COUNT, spinPairOffs[pairIdx]), TOKMAX_SPOFF)
    benchLog.tokenField(@"speed", tokenAt(@tokSpSpeed, SPIN_SPEEDS, speedIdx), TOKMAX_SPSPEED)
    benchLog.tokenField(@"dir", tokenAt(@tokSpDir, SPIN_DIRS, dirIdx), TOKMAX_SPDIR)
    benchLog.numField(@"l_pwr", leftPwr, LIM_TINY)
    benchLog.numField(@"incre", nIncre, LIM_BIG)
    benchLog.numField(@"pred_x10", predictX10(nIncre), LIM_MID)
    benchLog.numField(@"win_ms", spinWinMs[speedIdx], LIM_SMALL)
    benchLog.numField(@"leg_tk", spinLegTicks[speedIdx], LIM_SMALL)
    benchLog.numField(@"exp_neg", wantNeg, LIM_TINY)
    benchLog.numField(@"exp_pos", wantPos, LIM_TINY)
    benchLog.boolField(@"traced", bSpLegTraced(pairIdx, dirIdx))
    emitRecord()
#endif

#ifdef DBG_INCLINE
PRI emitCrpBuild()
' BM-CRPBUILD: the incline's compiled numbers -- the provisional ceiling under test and the control's, the rise and time
' limit both trials run with, the slip threshold the driver hands off at, the hold watch's window and the coast
' control's, the coast control's roll and the hold trials' bound, the poll cadence and the capture's decimation; and
' (SRC_REV 62) its legs: how many, each one's travel and their power (SRC_REV 63, FMT 40: ovl_a and ovl_ms gone with
' the overloaded climb). The incline's angle and the platform's mass are not here: the run sheet records both. Worst
' case 229 bytes.

    recBegin(@"BM-CRPBUILD")
    benchLog.numField(@"legs", INC_LEGS, LIM_TINY)
    benchLog.numField(@"leg_tk", INC_LEG_TICKS, LIM_TINY)
    benchLog.numField(@"power", INC_POWER, LIM_TINY)
    benchLog.numField(@"ceil_pct", CREEP_CEIL_PCT, LIM_TINY)
    benchLog.numField(@"low_pct", CREEP_LOW_CEIL_PCT, LIM_TINY)
    benchLog.numField(@"rise_ms", wheelL.HOLD_RISE_MS, LIM_SMALL)
    benchLog.numField(@"limit_ms", wheelL.HOLD_LIMIT_MS, LIM_SMALL)
    benchLog.numField(@"slip_ticks", wheelL.HOLD_SLIP_TICKS, LIM_TINY)
    benchLog.numField(@"win_ms", CREEP_WIN_MS, LIM_SMALL)
    benchLog.numField(@"ctrl_ms", CREEP_CTRL_WIN_MS, LIM_SMALL)
    benchLog.numField(@"ctrl_ticks", CREEP_CTRL_TICKS, LIM_TINY)
    benchLog.numField(@"bound", CREEP_BOUND_TICKS, LIM_TINY)
    benchLog.numField(@"poll_ms", CREEP_POLL_MS, LIM_TINY)
    benchLog.numField(@"decim", CREEP_DECIM, LIM_TINY)
    emitRecord()
#endif

#ifdef DBF_SPINLEG
PRI emitSpin(tid, legIdx) | pairIdx
' BM-SPIN: one leg -- its trace id when it was drained, its number (1-based, as the run sheet numbers it),
' pair, commutation pair, speed and direction; the lifetime and the travel per tick that lifetime read back; the
' powers; what ended it (stop_by); command to both AT_SPEED; the window's length; each wheel's tracked ticks at rest --
' what the distance stop counts, against BM-SPINLEG's leg_tk (BM-SPINBUILD's leg_ticks, or f_ticks at the quarter); and the
' path limiter's scale at the window's end.
' SRC_REV 62: the kind field is gone with the FAULT legs. Worst case 258 bytes.
'
' @param tid - trace id, 0 when none was drained
' @param legIdx - 0..SPIN_LEGS-1
'
' @local pairIdx - its pair

    pairIdx := legIdx / SPIN_DIRS
    recBegin(@"BM-SPIN")
    benchLog.naNumField(@"tid", tid, LIM_SMALL, tid > 0)
    benchLog.numField(@"leg", legIdx + 1, LIM_TINY)
    benchLog.numField(@"pair", pairIdx + 1, LIM_TINY)
    benchLog.tokenField(@"offs", tokenAt(@tokSpOff, SPOFF_COUNT, spinPairOffs[pairIdx]), TOKMAX_SPOFF)
    benchLog.tokenField(@"speed", tokenAt(@tokSpSpeed, SPIN_SPEEDS, spinPairSpeed[pairIdx]), TOKMAX_SPSPEED)
    benchLog.tokenField(@"dir", tokenAt(@tokSpDir, SPIN_DIRS, legIdx // SPIN_DIRS), TOKMAX_SPDIR)
    benchLog.naNumField(@"sid", spSid, LIM_SMALL, spSid > 0)
    benchLog.naNumField(@"tick", spLifeTick, LIM_SMALL, (spSid > 0) and (spLifeTick > 0))
    benchLog.naNumField(@"l_pwr", spLeftPwr, LIM_TINY, bSpDriven)
    benchLog.naNumField(@"r_pwr", spRightPwr, LIM_TINY, bSpDriven)
    benchLog.tokenField(@"stop_by", tokenAt(@tokSpStop, SPSTOP_COUNT, spStopBy), TOKMAX_SPSTOP)
    benchLog.naNumField(@"at_ms", spAtMs, LIM_SMALL, bSpReached)
    benchLog.naNumField(@"win_ms", spWinMs, LIM_SMALL, bSpWinValid)
    benchLog.naNumField(@"l_trk", spTrk[SLOT_LEFT], LIM_SMALL, bSpTrkValid)
    benchLog.naNumField(@"r_trk", spTrk[SLOT_RIGHT], LIM_SMALL, bSpTrkValid)
    benchLog.naNumField(@"path_pm", spPathPm, LIM_SMALL, bSpReadsValid)
    whyField(spWhy)
    emitRecord()

PRI emitSpinW(legIdx, slotIdx) | bWin, mSign, whyCode
' BM-SPINW: one wheel's leg -- THE LOADED CURRENT BY DIRECTION. The direction it RAN (m_sign, from its raw travel: +1 is
' the positive increments a RIGHT leg commands) and that travel; over the steady window its mean sense_i (mV x10) and
' peak, its mean getCurrent() net of the rest zero (A x 10_000), duty and its peak, the signed mean err and the |err|
' peak, and its rate (ticks/s x10); at the window's end its two following readings, whether its lag limiter held lately,
' and the pair it applied. Worst case 277 bytes.
'
' @param legIdx - 0..SPIN_LEGS-1
' @param slotIdx - motor slot
'
' @local bWin - the window's statistics are a measurement
' @local mSign - the raw travel's sign
' @local whyCode - the first cause of the record's NA fields

    bWin := bSpWinValid and bCpFrozen and (rsN > 0)
    mSign := 0
    if spTravel[slotIdx] > 0
        mSign := SIGN_POS
    elseif spTravel[slotIdx] < 0
        mSign := SIGN_NEG
    whyCode := spWhy
    if (whyCode == WHY_NONE) and (bWin == FALSE)
        ' SRC_REV 74 (PL-168): what happened, not a catch-all. STOP_BEGAN -- the leg's own distance stop came first, whether
        '  before both wheels held AT_SPEED (spinDrive() marks it) or before the window ran its length; STEADY_TIMEOUT only
        '  when SPIN_ATSPEED_MS ran out with the leg still driving and AT_SPEED never held
        if bSpStopBegan
            whyCode := WHY_STOP_BEGAN
        elseif bSpReached == FALSE
            whyCode := WHY_STEADY_TIMEOUT
        else
            whyCode := WHY_NO_SAMPLES
    spLegWhy[(legIdx * INST_MOTORS) + slotIdx] := whyCode   ' for BM-XRUN: why this leg's window printed NA, WHY_NONE when it did not
    recBegin(@"BM-SPINW")
    benchLog.numField(@"leg", legIdx + 1, LIM_TINY)
    benchLog.tokenField(@"motor", sideToken(SIDE_LEFT + slotIdx), TOKMAX_MOTOR)
    benchLog.naNumField(@"m_sign", mSign, LIM_TINY, bSpTravelValid)
    benchLog.naNumField(@"raw", spTravel[slotIdx], LIM_SMALL, bSpTravelValid)
    benchLog.naNumField(@"i_x10", rsIMeanX10, LIM_MID, bWin)
    benchLog.naNumField(@"i_max", rsIMax, LIM_SMALL, bWin)
    benchLog.naNumField(@"amps", spAmpsSum[slotIdx] / (spAmpsN #> 1), LIM_MID, bWin and (spAmpsN > 0))
    benchLog.naNumField(@"duty", rsDutyMean, LIM_SMALL, bWin)
    benchLog.naNumField(@"duty_pk", rsDutyPk, LIM_SMALL, bWin)
    benchLog.naNumField(@"err", rsErrMean, LIM_TINY, bWin)
    benchLog.naNumField(@"err_pk", rsErrPk, LIM_TINY, bWin)
    benchLog.naNumField(@"rate_x10", rsRateX10, LIM_MID, bWin)
    benchLog.naNumField(@"fol_pct", spFolPct[slotIdx], LIM_SMALL, bSpReadsValid and (bSpFolOk[slotIdx] <> FALSE))
    benchLog.naNumField(@"fol_pm", spFolPm[slotIdx], LIM_SMALL, bSpReadsValid)
    benchLog.boolField(@"short", bSpShort[slotIdx])
    benchLog.naNumField(@"off_neg", spOffNeg[slotIdx], LIM_TINY, bSpReadsValid)
    benchLog.naNumField(@"off_pos", spOffPos[slotIdx], LIM_TINY, bSpReadsValid)
    whyField(whyCode)
    emitRecord()

PRI emitSpinStart(legIdx, slotIdx) | whyCode
' BM-SPINSTART: one wheel's START on a quarter-speed confirmed-pair leg (spStartStats()) -- trace k of its first
' AT_SPEED sample and of duty leaving its floor for good, duty's running maximum and largest fall from it (A-1, per
' mille), the current peak, the tail's mean (mV x10) and samples, and their ratio (A-2, x100). Worst case 199 bytes.
' SRC_REV 60: A-1's fall is over the rise only (to the ramp-out), and tail_x10 / tail_n are the STEADY REFERENCE's,
' A2_REF_DELAY_MS after the first AT_SPEED sample, every sample reading AT_SPEED (spStartStats()); why NOT_REACHED also
' when that reference did not lie in the capture or was not all AT_SPEED. The record's shape is unchanged. SRC_REV 78: pk_i is the
' peak over the ARRIVAL WINDOW (A2_ARR_SAMPLES samples from at_k), no longer over the whole spin-up; its name and place stay.
'
' @param legIdx - 0..SPIN_LEGS-1
' @param slotIdx - motor slot
'
' @local whyCode - NOT_REACHED when the capture held no AT_SPEED sample or no positive tail

    whyCode := WHY_NONE
    if bSpStartOk[slotIdx] == FALSE
        whyCode := WHY_NOT_REACHED
    recBegin(@"BM-SPINSTART")
    benchLog.numField(@"leg", legIdx + 1, LIM_TINY)
    benchLog.tokenField(@"motor", sideToken(SIDE_LEFT + slotIdx), TOKMAX_MOTOR)
    benchLog.naNumField(@"at_k", spAtK[slotIdx], LIM_SMALL, bSpStartOk[slotIdx])
    benchLog.naNumField(@"leave_k", spLeaveK[slotIdx], LIM_SMALL, bSpStartOk[slotIdx])
    benchLog.naNumField(@"run_max", spRunMax[slotIdx], LIM_SMALL, bSpStartOk[slotIdx])
    benchLog.naNumField(@"drop_pm", spDropPm[slotIdx], LIM_SMALL, bSpStartOk[slotIdx])
    benchLog.naNumField(@"pk_i", spPeakI[slotIdx], LIM_SMALL, bSpStartOk[slotIdx])
    benchLog.naNumField(@"tail_x10", spTailX10[slotIdx], LIM_MID, bSpStartOk[slotIdx])
    benchLog.naNumField(@"ratio_x100", spRatioX100[slotIdx], LIM_SMALL, bSpStartOk[slotIdx])
    benchLog.naNumField(@"tail_n", spTailN[slotIdx], LIM_SMALL, bSpStartOk[slotIdx])
    whyField(whyCode)
    emitRecord()

PRI emitAcrossRuns(pCell, side, pairNum, pairDen) | whyCode, arrIdx, legSel, pairIdx, bFound, bAtRate, rateWhy
' BM-XRUN (SRC_REV 69, FMT 43): why one of the pair-comparing cells (SPINSYM, SPINCTL, SPINLEAD) printed NOMEAS. In a ONE-leg
' run they compare the legs of several runs -- a run is one leg -- so a run whose own leg measured its wheel's current prints
' JUDGED_ACROSS_RUNS: the analysis takes each wheel's current from BM-SPINW amps (A x 10_000) and the pair it applied
' from off_neg and off_pos in every log of the legs, and forms the ratio there. A run whose own leg measured nothing names
' the leg's own cause instead. SRC_REV 74 (PL-168): a SESSION (FLOOR_ACT_AUTO) runs all ten legs itself and judges the pair
' in the same run, so it never prints JUDGED_ACROSS_RUNS: it names the first of the cell's four legs (the numerator pair's
' RIGHT and LEFT, then the denominator's; both legs of one pair for SPINSYM) that did not measure this wheel's current, with
' the cause BM-SPINW printed for it (spLegWhy), or LOW_CURRENT when all four measured and a current was not above zero. SRC_REV 75
' (task 3657): a cell of two DIFFERENT pairs (SPINCTL, SPINLEAD) is also unjudged unless this wheel read SPINRATE_FOL_LO % of its
' command on all four legs, and says so with NOT_AT_CMD_SPEED (the first leg that read short; a leg with no reading names its own
' cause first); the ONE-leg run's analysis takes the same gate from BM-SPINW fol_pct in every log. Worst
' case about 90 bytes: the cell 28, the motor 12 and the why 23, with the tag and seq.
'
' @param pCell - pointer to the cell id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param pairNum - the cell's first pair, SPIN_PAIR_*
' @param pairDen - its second pair (the same one for SPINSYM)
'
' @local whyCode - the why printed
' @local arrIdx - the leg's [leg * INST_MOTORS + slot] index into spLegAmps
' @local legSel - 0..3: the cell's legs, the first pair's RIGHT and LEFT then the second's (a session)
' @local pairIdx - the leg's pair (a session)
' @local bFound - a leg that did not measure this wheel was found (a session)
' @local bAtRate - the wheel read SPINRATE_FOL_LO % of its command on all four legs (a session)
' @local rateWhy - why it did not (a session)

#ifdef DBF_AUTO
    whyCode := WHY_LOW_CURRENT
    bFound := FALSE
    repeat legSel from 0 to (SPIN_DIRS * 2) - 1
        pairIdx := pairNum
        if legSel >= SPIN_DIRS
            pairIdx := pairDen
        arrIdx := (((pairIdx * SPIN_DIRS) + (legSel // SPIN_DIRS)) * INST_MOTORS) + (side - SIDE_LEFT)
        if (bFound == FALSE) and (bSpLegAmps[arrIdx] == FALSE)
            bFound := TRUE
            whyCode := spLegWhy[arrIdx]
            if whyCode == WHY_NONE
                whyCode := WHY_NO_SAMPLES                   ' its window was valid but getCurrent() was never read inside it
    if (bFound == FALSE) and (pairNum <> pairDen)           ' SRC_REV 75: all four currents read; a cell of two pairs also needs one speed
        bAtRate, rateWhy := spinPairsAtRate(pairNum, pairDen, side - SIDE_LEFT)
        if bAtRate == FALSE
            whyCode := rateWhy
#else
    arrIdx := (spLeg * INST_MOTORS) + (side - SIDE_LEFT)
    whyCode := WHY_JUDGED_ACROSS_RUNS
    if bSpLegAmps[arrIdx] == FALSE
        whyCode := WHY_NO_SAMPLES
        if spWhy <> WHY_NONE
            whyCode := spWhy
#endif
    recBegin(@"BM-XRUN")
    benchLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    whyField(whyCode)
    emitRecord()
#endif

#ifdef DBG_INCLINE
PRI emitCreep(kind) | ceilPct
' BM-CREEP: one incline stop -- its number (1-based) and kind, the lifetime, the ceiling it set and setHoldLimits()'s
' return (NA for the coast, which sets none), the watch's length and creep bound, what ended the watch (stop_by),
' whether the climb came to rest at its stop and how long after its command (SRC_REV 62: rested, rest_ms; were
' released, rel_ms, his letting go). Worst case 185 bytes.
'
' @param kind - CRK_*
'
' @local ceilPct - the ceiling the trial set, % of duty_max

    ceilPct := CREEP_CEIL_PCT
    if kind == CRK_LOWCEIL
        ceilPct := CREEP_LOW_CEIL_PCT
    recBegin(@"BM-CREEP")
    benchLog.numField(@"trial", kind + 1, LIM_TINY)
    benchLog.tokenField(@"kind", tokenAt(@tokCrk, CRK_COUNT, kind), TOKMAX_CRK)
    benchLog.naNumField(@"sid", crSid, LIM_SMALL, crSid > 0)
    benchLog.naNumField(@"ceil_pct", ceilPct, LIM_TINY, kind <> CRK_COAST)
    benchLog.naNumField(@"set_err", crSetErr, LIM_SMALL, (kind <> CRK_COAST) and (crSid > 0))
    benchLog.naNumField(@"win_ms", crWinMs, LIM_SMALL, bCrReleased)
    benchLog.naNumField(@"bound", crBoundTicks, LIM_TINY, bCrReleased)
    benchLog.tokenField(@"stop_by", tokenAt(@tokCrStop, CRSTOP_COUNT, crStopBy), TOKMAX_CRSTOP)
    benchLog.boolField(@"rested", bCrReleased)
    benchLog.naNumField(@"rest_ms", crReleaseMs, LIM_SMALL, bCrReleased)
    whyField(crWhy)
    emitRecord()

PRI emitCreepW(kind, slotIdx) | bWin, whyCode
' BM-CREEPW: one wheel of a creep trial -- WHAT SIZES HOLD_CEILING_PCT UNDER LOAD. How the hold resolved (state, HS_*)
' and the driver's own displacement; the creep on the instrument's hall decode since the release (creep) and while
' HOLDING (h_creep); the ceiling in force, the largest and the last hold duty, the longest time at the ceiling (ms), the
' slip and limit events; over the watch its mean sense_i (mV x10), its mean getCurrent() net of the rest zero (A x
' 10_000), and the samples behind the sense mean. Worst case 274 bytes.
'
' @param kind - CRK_*
' @param slotIdx - motor slot
'
' @local bWin - the watch's ring statistics are a measurement
' @local whyCode - the first cause of the record's NA fields, or of a hold reading that judges nothing

    bWin := bCrFrozen and (rsN > 0)
    whyCode := crWhy
    if (whyCode == WHY_NONE) and (kind == CRK_HOLD) and bCrReleased and (bCreepMeasured(slotIdx) == FALSE)
        whyCode := WHY_NOT_REACHED                          ' the coast control never came to rest at its stop
        if bSfCrCoastRan
            whyCode := WHY_NO_INCLINE_LOAD                  ' it ran and did not roll: the incline does not load the hold
    recBegin(@"BM-CREEPW")
    benchLog.numField(@"trial", kind + 1, LIM_TINY)
    benchLog.tokenField(@"motor", sideToken(SIDE_LEFT + slotIdx), TOKMAX_MOTOR)
    benchLog.tokenField(@"state", tokenAt(@tokHold, HS_COUNT, crState[slotIdx]), TOKMAX_HOLD)
    benchLog.naNumField(@"disp", crDisp[slotIdx], LIM_SMALL, bCrPolled)
    benchLog.naNumField(@"creep", crCreep[slotIdx], LIM_TINY, bCrReleased)
    benchLog.naNumField(@"h_creep", crHoldCreep[slotIdx], LIM_TINY, bCrReleased)
    benchLog.naNumField(@"ceil_duty", crCeilDuty[slotIdx], LIM_SMALL, bCrPolled)
    benchLog.naNumField(@"duty_pk", crDutyPk[slotIdx], LIM_SMALL, bCrPolled)
    benchLog.naNumField(@"duty_end", crDutyEnd[slotIdx], LIM_SMALL, bCrPolled)
    benchLog.naNumField(@"ceil_ms", crCeilMs[slotIdx], LIM_SMALL, bCrPolled)
    benchLog.naNumField(@"slips", crSlips[slotIdx], LIM_TINY, bCrPolled)
    benchLog.naNumField(@"limits", crLimits[slotIdx], LIM_TINY, bCrPolled)
    benchLog.naNumField(@"i_x10", rsIMeanX10, LIM_MID, bWin)
    benchLog.naNumField(@"amps", crAmpsSum[slotIdx] / (crAmpsN #> 1), LIM_MID, crAmpsN > 0)
    benchLog.naNumField(@"n", rsN, LIM_SMALL, bWin)
    whyField(whyCode)
    emitRecord()
#endif

PRI steerSetLimits(peakAmps, contAmps) : eError
' testSetCurrentLimits() on both steering wheels: BLOCK and LOAD lower them for a trial and restore the library's own
' (I_PEAK_A, I_CONT_A) before the lifetime is stopped (I11); start() also restores them.
'
' @param peakAmps - the peak limit, amps
' @param contAmps - the continuous limit, amps
' @returns eError - NO_ERROR, or the code the library returned

    beat(CP_LIB_COMMAND)
    eError := steering.testSetCurrentLimits(peakAmps, contAmps)
    beat(CP_LIB_COMMAND)

PRI steerProtCodes() : eLeftCode, eRightCode
' getProtectiveStop() on the steering object: each wheel's latched protective cause, NO_ERROR when none.
'
' @returns eLeftCode - the left wheel's
' @returns eRightCode - the right wheel's

    beat(CP_LIB_STEER_QUERY)
    eLeftCode, eRightCode := steering.getProtectiveStop()
    beat(CP_LIB_STEER_QUERY)

PRI ringIndex(ringTotal) : sampleIdx
' The logical index of the sample a ring total names, after drainBegin() (legal while IDLE or FROZEN, I10): clamped into
' the stored samples, so a total whose sample was overwritten reads the oldest one kept.
'
' @param ringTotal - an instrument total (instTotal, or an instMarkIndex() total)
' @returns sampleIdx - 0..drStored-1, or -1 when the total was never recorded or nothing is stored

    sampleIdx := -1
    if (ringTotal >= 0) and (drStored > 0)
        sampleIdx := ((ringTotal - drLostHead) #> 0) <# (drStored - 1)

PRI heldAtSpeed(slotIdx, startJ, endJ) : nHeld, nBad | sampleIdx, errAbs, bBadNow, bPrevBad
' HELDATSPD (PL-95) over one wheel's drained samples startJ..endJ (this section's CON): HELD up-samples, |err| at least
' LAG_SOFT, and BAD ones, DCS_AT_SPEED at |err| at least LAG_HOLD with the stored sample before it likewise (I3: up
' samples only; a sample whose driver is down breaks a run).
'
' @param slotIdx - motor slot
' @param startJ - first logical index
' @param endJ - last logical index
' @returns nHeld - the held samples
' @returns nBad - the bad ones
'
' @local sampleIdx - logical index
' @local errAbs - one sample's |err|
' @local bBadNow - this sample reads AT_SPEED at a held field
' @local bPrevBad - the sample before it did

    nHeld := 0
    nBad := 0
    bPrevBad := FALSE
    if (startJ >= 0) and (endJ >= startJ) and (endJ < drStored)
        repeat sampleIdx from startJ to endJ
            beat(CP_LOOP_DRAIN)
            bBadNow := FALSE
            if bSmpUp(sampleIdx, slotIdx)
                errAbs := abs(smpErr(sampleIdx, slotIdx))
                if errAbs >= wheelL.LAG_SOFT
                    nHeld += 1
                bBadNow := (errAbs >= wheelL.LAG_HOLD) and (smpState(sampleIdx, slotIdx) == DCS_AT_SPEED)
                if bBadNow and bPrevBad
                    nBad += 1
            bPrevBad := bBadNow

#ifdef DBF_GRAB
PRI longestTickGap(slotIdx, startJ, endJ) : gapMs | sampleIdx, lastT, lastHw, hwNow
' LDHOLD (PL-150): the longest time one wheel's halls stood still across drained samples startJ..endJ, on the
' instrument's own hall decode (hwPos), counting the stretch from the last tick to the window's end.
'
' @param slotIdx - motor slot
' @param startJ - first logical index
' @param endJ - last logical index
' @returns gapMs - the longest gap, ms; 0 when the window holds no two samples
'
' @local sampleIdx - logical index
' @local lastT - the sample time of the last tick (or of the window's start)
' @local lastHw - hwPos there
' @local hwNow - this sample's hwPos

    gapMs := 0
    if (startJ >= 0) and (endJ > startJ) and (endJ < drStored)
        lastT := smpT(startJ)
        lastHw := smpHw(startJ, slotIdx)
        repeat sampleIdx from startJ + 1 to endJ
            beat(CP_LOOP_DRAIN)
            hwNow := smpHw(sampleIdx, slotIdx)
            if hwNow <> lastHw
                gapMs #>= (smpT(sampleIdx) - lastT) / TICKS_PER_MS
                lastT := smpT(sampleIdx)
                lastHw := hwNow
        gapMs #>= (smpT(endJ) - lastT) / TICKS_PER_MS
#endif

#ifdef DBF_FAULTRUN
PRI segFaultRun() | whyCode, recoverWhy, endWhy
' FAULTRUN (part SPIN; SRC_REV 62, the fourth floor situation): the floor situations' CON, 4. SRC_REV 69: ONE SEQUENCE,
' straight after the lead-in, in one steering lifetime: the leg out, unfaulted, its window the SECOND REFERENCE
' (frunOut()); FR_CLEAR_MS of STAND CLEAR; the leg back, with the forced fault after its steady second (frunBack()); the
' fault's trace, X-5 and the stop reasons (frunRecords()); the recovery; FR_CLEAR_MS of STAND CLEAR; and the drive after
' it on to the start (frunRedrive(), PL-93). A leg that must end the run ends it; the re-drive then prints NOT_RUN with
' the cause. SRC_REV 70, SESSION 2 part 2 (DBG_FENCE): it is a STRAIGHT action, so it is skipped when an earlier one failed,
' the fence checks each of its three drives before it is armed, and its end is reported to the session (sessStraightEnd()).
'
' @local whyCode - why the segment ended short, WHY_NONE while it runs
' @local recoverWhy - steerRecoverFault()'s cause, WHY_NO_FAULT when nothing faulted
' @local endWhy - the cause the session is told when the fault run did not complete (SESSION 2)

    segBegin(SEG_FAULTRUN)
#ifdef DBG_FENCE
    bSessFrRan := bSessStraightsMayGo(@"the fault run")
    if bSessFrRan
        alignSay(@"PART 2 OF 3: the fault run -- 1 m out, 1 m back with a wheel faulted on purpose, and the drive on to the start")
#endif
    frunReset()
    recoverWhy := WHY_NO_FAULT
    if bRunContinue(SEG_FAULTRUN) == FALSE
        whyCode := WHY_ABORTED
#ifdef DBG_FENCE
    elseif bSessFrRan == FALSE
        whyCode := WHY_STRAIGHTS_SKIPPED
#endif
    elseif bSteerStart(SEG_FAULTRUN) == FALSE
        whyCode := WHY_NO_COG
        if bSteerUp
            steerStop()
    else
        frunSid := steerLife
        whyCode := frunOut()
        if whyCode == WHY_NONE
            frunStandClear(@"STAND CLEAR: the platform drives back in")
            whyCode := frunBack()
        else
            frunWhy := whyCode                              ' the leg back never drove: X-5's record says why
        frunRecords()
        if bSteerUp and (spStopBy == SPSTOP_FAULT)
            recoverWhy := steerRecoverFault(frunTid)        ' counts it (R14-DUAL-RSTPROV-P) and cools
    if whyCode == WHY_NONE
        whyCode := frunRedrive(recoverWhy)
    else
        rdNotRun(0, FLR_SIDE - SIDE_LEFT, whyCode)
    if bSteerUp
        bInstIdle()
        steerStop()
    frSegWhy := whyCode
#ifdef DBG_FENCE
    bSessFrOk := (whyCode == WHY_NONE) and bRdDriven and (rdStopBy == SPSTOP_LIMIT)     ' the fault recovered, the drive on made
    endWhy := whyCode
    if (whyCode == WHY_NONE) and (bSessFrOk == FALSE)
        endWhy := rdWhy                                     ' the run ended clean but the drive on did not run: its own cause says why
    if bSessFrRan
        sessStraightEnd(bSessFrOk, endWhy)
#endif
    ' if/else, never `? :` (PL-29): segWhy() is a call
    if whyCode <> WHY_NONE
        segEnd(whyCode)
    else
        segEnd(segWhy())

PRI frunReset() | slotIdx
' Clear FAULTRUN's staging: the run's own, the X-5 staging (frunFaultReset()) and the re-drive's (rdReset()), so a run
' that never starts prints every record NA with its cause.
'
' @local slotIdx - motor slot

    frunSid := 0
    frunTid := 0
    frunBackErr := NO_ERROR
    frunBackDrvErr := NO_ERROR
    frunStopBy := SPSTOP_NOT_RUN
    frunWhy := WHY_NONE
    bFrunDriven := FALSE
    bFrunReached := FALSE
    frunLeftSr := wheelL.SR_NONE
    frunRightSr := wheelL.SR_NONE
    bFrunSrRead := FALSE
    bRdFwd := FALSE
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        rdFwd[slotIdx] := 0
    bSpDriven := FALSE
    spStopBy := SPSTOP_NOT_RUN
    spAmpsN := 0                                            ' no earlier segment's polls can pass for the "before"
    frunFaultReset()
    rdReset(0, FLR_SIDE - SIDE_LEFT)

PRI frunOut() : whyCode | slotIdx
' FAULTRUN's leg out, unfaulted: its capture armed (the mirror the guard reads), then flLeg() FLL_FR_OUT -- FL_LEG_MM at
' FLR_POWER, armed first, its SPIN_FAULT_SETTLE_MS window after AT_SPEED polling getCurrent() -- the SECOND REFERENCE,
' rdFwd -- and on to its limit; the capture frozen, so the leg back can arm its own.
'
' @returns whyCode - WHY_NONE when the leg back may follow, else why FAULTRUN must end
'
' @local slotIdx - motor slot

#ifdef DBG_FENCE
    if bFenceAllows(FL_LEG_TICKS, FEN_FR_OUT, 0) == FALSE
        whyCode := WHY_FENCE_REFUSED
    elseif bInstArm(INST_SRC_STEER, 1) == FALSE
#else
    if bInstArm(INST_SRC_STEER, 1) == FALSE
#endif
        whyCode := WHY_INST_NOACK
    else
        waitBeat(SPIN_MIRROR_MS, CP_LOOP_READY)            ' the mirror refreshes on the instrument's next passes
        whyCode := flLeg(FLL_FR_OUT, SEG_FAULTRUN, FLR_POWER, FL_LEG_TICKS, FALSE, TRUE)
        if spAmpsN > 0
            repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                rdFwd[slotIdx] := spAmpsSum[slotIdx] / spAmpsN
            bRdFwd := TRUE
        waitRest(SIDE_BOTH, STOP_TIMEOUT_MS, FALSE)
#ifdef DBG_FENCE
        fenceAdvance(FEN_FR_OUT, 0)                         ' SRC_REV 70: where the leg out left the platform
#endif
        bInstFreeze(0)

PRI frunBack() : whyCode | safeEvent, bReached
' FAULTRUN's leg back (the floor situations' CON, 4. b): its X-5 staging cleared; its capture armed at decimation 1;
' FL_LEG_MM back armed first (stopAfterDistance()); SYNC_PRECOND; the drive at -FLR_POWER on both wheels; both AT_SPEED;
' then spinFault() -- the "before" second polled, the window-end reads, the guarded forced fault on FLR_SIDE, and the
' capture to rest -- the travel guard live throughout; freeze; the leg's end classified (spinEnd(), the forced fault the
' event under test); rest.
'
' @returns whyCode - WHY_NONE when the fault latched and the re-drive may follow, else why FAULTRUN must end
'
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - both wheels read AT_SPEED

    whyCode := WHY_NONE
    safeEvent := SAFE_NONE
    frunFaultReset()
    frunTid := nextTraceId()
    cpReset()
    spLeftPwr := 0 - FLR_POWER
    spRightPwr := 0 - FLR_POWER
    if bRunContinue(SEG_FAULTRUN) == FALSE
        whyCode := WHY_ABORTED
#ifdef DBG_FENCE
    elseif bFenceAllows(0 - FL_LEG_TICKS, FEN_FR_BACK, 0) == FALSE
        whyCode := WHY_FENCE_REFUSED
#endif
    elseif bInstArm(INST_SRC_STEER, 1) == FALSE
        whyCode := WHY_INST_NOACK
    else
        waitBeat(SPIN_MIRROR_MS, CP_LOOP_READY)            ' the mirror refreshes on the instrument's next passes
        flLegBegin(FL_LEG_TICKS)
        beat(CP_LIB_STEER_DRIVE)
        frunBackErr := steering.stopAfterDistance(FL_LEG_MM, steering.DDU_MM)
        beat(CP_LIB_STEER_DRIVE)
        if frunBackErr <> NO_ERROR
            whyCode := WHY_LIMIT_REFUSED
        elseif bSteerDrivePrecondition(SEG_FAULTRUN, frunTid) == FALSE
            whyCode := WHY_SYNC_PRECOND
        else
            curIncre := 0
            spCmdMs := getms()
            beat(CP_LIB_STEER_DRIVE)
            frunBackDrvErr := steering.driveAtPower(spLeftPwr, spRightPwr)
            beat(CP_LIB_STEER_DRIVE)
            bFrunDriven := TRUE
            bSpDriven := TRUE
            if frunBackDrvErr <> NO_ERROR
                spStopBy := SPSTOP_ABORT
                whyCode := WHY_SYNC_PRECOND
                steerStopMotors()
            else
                safeEvent, bReached := spinWatch(UNTIL_AT_SPEED, SPIN_ATSPEED_MS, FALSE)
                if (safeEvent == SAFE_NONE) and (bSpOvertravel == FALSE) and bReached
                    bFrunReached := TRUE
                    safeEvent := spinFault()
            bCpFrozen := bInstFreeze(0)
            if whyCode == WHY_NONE
                whyCode := spinEnd(safeEvent, TRUE)
            waitRest(SIDE_BOTH, STOP_TIMEOUT_MS, FALSE)
#ifdef DBG_FENCE
        fenceAdvance(FEN_FR_BACK, 0)                        ' SRC_REV 70: where the fault left the platform, and the heading it turned
#endif
    frunStopBy := spStopBy
    frunWhy := whyCode
    if (bCpFrozen == FALSE) and (whyCode == WHY_NONE)
        frunWhy := WHY_INST_NOACK

PRI frunRecords() | faultIdx, otherIdx
' FAULTRUN's X-5 records, the capture frozen (I10) and the lifetime still up so the driver's own reports are read as the
' fault left them: the trace (BM-STRACE cause FAULT, BM-TS, BM-TRACE-END) and frPlatStats() on the watched wheel; each
' wheel's fault cause and stop reason (BM-SR, stage FAULTRUN; recorded, not judged: the faulted wheel's own reason, the
' other SR_PARTNER); BM-FRPLAT; R19-DUAL-SPINPLAT-P's fold. A leg back that never drove prints BM-FRPLAT alone.
'
' @local faultIdx - the faulted wheel's slot
' @local otherIdx - the watched wheel's

    faultIdx := FLR_SIDE - SIDE_LEFT
    otherIdx := SLOT_RIGHT - faultIdx
    if bFrunDriven
        emitSTrace(frunTid, SEG_FAULTRUN, CAUSE_FAULT, spLeftPwr, spRightPwr, TRUE, 0, MODE_FLOAT, frunWhy)
        if bCpFrozen
            bTraceDrain(frunTid, SLOT_LEFT, SLOT_RIGHT, cpEnd)
            frPlatStats(faultIdx, otherIdx)
        else
            traceEmptyEnd(frunTid, TEND_ABORT, frunWhy)
    if bSteerUp
        beat(CP_LIB_STEER_QUERY)
        fltLeftCause, fltRightCause := steering.getFaultCause()
        frunLeftSr, frunRightSr := steering.getStopReason()
        beat(CP_LIB_STEER_QUERY)
        bFrunSrRead := TRUE
        emitSr(EVST_FAULTRUN, FLR_SIDE, frunLeftSr, frunRightSr, TRUE, TRUE)
    frWhy := frPlatWhy(frunWhy)
    emitFrPlat(frunTid, frunSid, spFaultSide)
    frPlatFold(otherIdx)
    segItems := (segItems + 1) <# LIM_SMALL

PRI frunRedrive(recoverWhy) : whyCode | travelMax
' RD (PL-93, the floor situations' CON, 4. c): after the fault and its recovery, the same drive back again at the same
' power, in the same lifetime. What is left of the leg back on the farther wheel's mirrored position bounds it
' (RD_MIN_TICKS or it does not run); FR_CLEAR_MS of STAND CLEAR says what runs next; the travel limit is armed before the
' drive (stopAfterRotation(), hall ticks), then rdDrive(), on to the start. The leg back's guard stays in force: its zero
' and its FL_LEG_TICKS cover the re-drive too. Always prints BM-RDRIVE and folds R21-DUAL-POSTFLT-P.
'
' @param recoverWhy - steerRecoverFault()'s cause: WHY_NONE when the fault was cleared, WHY_NO_FAULT when none came
' @returns whyCode - WHY_NONE, or why FAULTRUN must end (an abort, the travel guard)
'
' @local travelMax - the farther wheel's travel since the leg back began, ticks

    rdReset(0, FLR_SIDE - SIDE_LEFT)
    whyCode := WHY_NONE
    travelMax := flTravelMax()
    rdRemain := FL_LEG_TICKS - travelMax
    if recoverWhy <> WHY_NONE
        rdWhy := recoverWhy
    elseif bSteerUp == FALSE
        rdWhy := WHY_NO_COG
    elseif rdRemain < RD_MIN_TICKS
        rdWhy := WHY_NO_ROOM
#ifdef DBG_FENCE
    elseif bFenceAllows(0 - rdRemain, FEN_FR_REDRIVE, 0) == FALSE
        rdWhy := WHY_FENCE_REFUSED
#endif
    else
        frunStandClear(@"STAND CLEAR: the platform drives on to its start in")
        beat(CP_LIB_STEER_DRIVE)
        rdLimErr := steering.stopAfterRotation(rdRemain, steering.DRU_HALL_TICKS)
        beat(CP_LIB_STEER_DRIVE)
        if rdLimErr <> NO_ERROR
            rdWhy := WHY_LIMIT_REFUSED
        elseif bSteerDrivePrecondition(SEG_FAULTRUN, frunTid) == FALSE
            rdWhy := WHY_SYNC_PRECOND
        else
            whyCode := rdDrive()
#ifdef DBG_FENCE
            fenceAdvance(FEN_FR_REDRIVE, 0)                 ' SRC_REV 70: where the drive on to the start left the platform
#endif
    rdFold()
    emitRedrive()
#endif

#ifdef DBG_FLLEG
PRI frunStandClear(pLine)
' The in-sequence count before a drive (SRC_REV 69; it was the board's 5 s STAND CLEAR step): one plain line saying what drives
' next and in how many seconds, then FR_CLEAR_MS as a beat-keeping wait (the watchdog is fed through it, WD_STALL_MS 4 s).
' Nothing moves during it: the drive it announces starts after it returns. FAULTRUN's two drives use it; SRC_REV 70: so does
' OBSTACLE's session before its drive back.
'
' @param pLine - pointer to the line's text, which ends in a word: "STAND CLEAR: the platform drives back in"

    sayCountdown(pLine, FR_CLEAR_MS / MS_PER_SEC)
    waitBeat(FR_CLEAR_MS, CP_LOOP_READY)

PRI flLeg(kind, seg, power, legTicks, bByTicks, bRefWin) : whyCode | safeEvent, bReached, startMs
' SRC_REV 62: ONE PLAIN FLOOR LEG -- FAULTRUN's leg out (SRC_REV 69: the only one run; a drive back and an incline climb
' or drive down were the others; SRC_REV 70: OBSTACLE's session runs its drive back, FLL_BACK, through it too) -- under the floor rules (the floor situations' CON): the guard's zero and the leg's
' travel (flLegBegin()); the leg's own distance limit ARMED BEFORE IT MOVES (stopAfterRotation(legTicks) or, for a whole
' FL_LEG_MM leg, stopAfterDistance()); a refused limit and it is never driven; SYNC_PRECOND; driveAtPower(power, power);
' the drive leaving rest; with bRefWin, AT_SPEED and a SPIN_FAULT_SETTLE_MS window polling getCurrent() into spAmpsSum;
' then on to its limit, both wheels STOPPED -- the guard live throughout (spinWatch()). No rest wait. The capture must
' already be armed or frozen (the mirror live); this arms nothing. Prints BM-FLLEG.
'
' @param kind - FLL_*
' @param seg - SEG_* it runs in
' @param power - the power both wheels are driven at, signed
' @param legTicks - its declared travel, hall ticks
' @param bByTicks - TRUE to arm stopAfterRotation(legTicks); FALSE for a whole FL_LEG_MM leg, stopAfterDistance()
' @param bRefWin - TRUE to read a steady getCurrent() window after AT_SPEED, and the pack after it (SRC_REV 64: every
'                  plain leg)
' @returns whyCode - WHY_NONE when it came to rest at its limit, else why its segment must end
'
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - the watched wait reached what it waited for
' @local startMs - getms() at the command

    fllKind := kind
    fllSeg := seg
    fllTicks := legTicks
    fllArmErr := NO_ERROR
    fllDriveErr := NO_ERROR
    fllStopBy := SPSTOP_NOT_RUN
    bFllDriven := FALSE
    fllMs := 0
    bFllPack := FALSE
    fllPackMv := 0
    whyCode := WHY_NONE
    safeEvent := SAFE_NONE
    bReached := FALSE
    flLegBegin(legTicks)
    beat(CP_LIB_STEER_DRIVE)
    if bByTicks
        fllArmErr := steering.stopAfterRotation(legTicks, steering.DRU_HALL_TICKS)
    else
        fllArmErr := steering.stopAfterDistance(FL_LEG_MM, steering.DDU_MM)
    beat(CP_LIB_STEER_DRIVE)
    if fllArmErr <> NO_ERROR
        whyCode := WHY_LIMIT_REFUSED
    elseif bSteerDrivePrecondition(seg, curTid) == FALSE
        whyCode := WHY_SYNC_PRECOND
    else
        curIncre := 0
        startMs := getms()
        beat(CP_LIB_STEER_DRIVE)
        fllDriveErr := steering.driveAtPower(power, power)
        beat(CP_LIB_STEER_DRIVE)
        bFllDriven := TRUE
        if fllDriveErr <> NO_ERROR
            fllStopBy := SPSTOP_ABORT
            whyCode := WHY_SYNC_PRECOND
            steerStopMotors()
        else
            safeEvent, bReached := spinWatch(UNTIL_MOVING, FL_MOVE_MS, FALSE)
            if (safeEvent == SAFE_NONE) and (bSpOvertravel == FALSE) and (bReached == FALSE)
                fllStopBy := SPSTOP_TIMEOUT                 ' taken, but the drive never left rest: not its limit
                whyCode := WHY_NOT_REACHED
                steerStopMotors()
            else
                if bRefWin and (safeEvent == SAFE_NONE) and (bSpOvertravel == FALSE)
                    safeEvent, bReached := spinWatch(UNTIL_AT_SPEED, SPIN_ATSPEED_MS, FALSE)
                    if (safeEvent == SAFE_NONE) and (bSpOvertravel == FALSE) and bReached
                        safeEvent, bReached := spinWatch(UNTIL_TIME, SPIN_FAULT_SETTLE_MS, TRUE)
                        if bReached == FALSE
                            spAmpsN := 0                    ' cut short (an event, the guard or the stop begun): no reference
                        else
                            flLegPack()                     ' SRC_REV 64: the pack under that load, between the two waits
                if (safeEvent == SAFE_NONE) and (bSpOvertravel == FALSE)
                    safeEvent, bReached := spinWatch(UNTIL_STOPPED, FL_LEG_MS, FALSE)
                whyCode := flLegEnd(safeEvent, bReached)
            fllMs := getms() - startMs
    fllWhy := whyCode
    emitFlLeg()

PRI flLegPack() | ePackStatus, nPackMv
' SRC_REV 64: read the pack voltage once, just after a floor leg's steady window and outside every timed wait, so the
' window's current can be read as power at the platform's size (the rig's mass is a rig fact). Recorded only when the
' sensor reads PACK_PRESENT.
'
' @local ePackStatus - getPackVoltage()'s status
' @local nPackMv - its reading, mV

    beat(CP_LIB_STEER_QUERY)
    ePackStatus, nPackMv := steering.getPackVoltage()
    beat(CP_LIB_STEER_QUERY)
    if ePackStatus == steering.PACK_PRESENT
        bFllPack := TRUE
        fllPackMv := nPackMv

PRI flLegEnd(safeEvent, bReached) : whyCode | eLeftCode, eRightCode
' Classify how a plain floor leg ended and take the stop it calls for, as spinEnd() does for a spin leg: the travel
' guard (already shorted), the current abort or a stalled instrument, a fault, the protective stop latched, its limit
' (both wheels STOPPED), or its bound. SRC_REV 69: no operator branch -- no window offers a STOP.
'
' @param safeEvent - SAFE_* its last watch ended on
' @param bReached - both wheels read DCS_STOPPED
' @returns whyCode - WHY_NONE when it came to rest at its limit, else why its segment must end
'
' @local eLeftCode - the left wheel's protective code
' @local eRightCode - the right wheel's

    whyCode := WHY_NONE
    eLeftCode, eRightCode := steerProtCodes()
    if bSpOvertravel
        fllStopBy := SPSTOP_OVERTRAVEL
        whyCode := WHY_OVERTRAVEL
    elseif (safeEvent == SAFE_ABS_ABORT) or (safeEvent == SAFE_INST_STALL)
        fllStopBy := SPSTOP_ABORT
        whyCode := safeWhy(safeEvent)
        if bSteerUp
            steerStopMotors()
    elseif safeEvent == SAFE_FAULT
        fllStopBy := SPSTOP_FAULT
        whyCode := WHY_FAULTED
    elseif (eLeftCode <> NO_ERROR) or (eRightCode <> NO_ERROR)
        fllStopBy := SPSTOP_BLOCKED
        whyCode := WHY_STALLED
    elseif bReached
        fllStopBy := SPSTOP_LIMIT
    else
        fllStopBy := SPSTOP_TIMEOUT
        whyCode := WHY_STOP_TIMEOUT
        steerStopMotors()

PRI emitFlLeg() | slotIdx
' BM-FLLEG (SRC_REV 62): one plain floor leg -- its segment and kind, its declared travel, the limit's and the drive's
' returns, what ended it, command to rest at its end, each wheel's travel on its driver's pos from the leg's start
' (signed, raw), and why. SRC_REV 64: its steady window at speed -- the getCurrent() reads (n), each wheel's mean
' (A x 10_000, NA without a whole window) -- and the pack voltage just after it (mV, NA unless PACK_PRESENT): with the
' rig's mass and the incline angle, a climb's current against a flat leg's is the force the slope asks, as power.
' Worst case 225 bytes.
'
' @local slotIdx - motor slot

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        fllTravel[slotIdx] := instLastPos[slotIdx] - spPos0[slotIdx]
    recBegin(@"BM-FLLEG")
    benchLog.tokenField(@"seg", segToken(fllSeg), TOKMAX_SEG)
    benchLog.tokenField(@"kind", tokenAt(@tokFll, FLL_COUNT, fllKind), TOKMAX_FLL)
    benchLog.numField(@"ticks", fllTicks, LIM_SMALL)
    benchLog.numField(@"arm_err", fllArmErr, LIM_SMALL)
    benchLog.naNumField(@"drv_err", fllDriveErr, LIM_SMALL, bFllDriven)
    benchLog.tokenField(@"stop_by", tokenAt(@tokSpStop, SPSTOP_COUNT, fllStopBy), TOKMAX_SPSTOP)
    benchLog.naNumField(@"ms", fllMs, LIM_SMALL, bFllDriven)
    benchLog.naNumField(@"l_trav", fllTravel[SLOT_LEFT], LIM_SMALL, bFllDriven)
    benchLog.naNumField(@"r_trav", fllTravel[SLOT_RIGHT], LIM_SMALL, bFllDriven)
    benchLog.numField(@"n", spAmpsN, LIM_SMALL)
    benchLog.naNumField(@"l_amps", spAmpsSum[SLOT_LEFT] / (spAmpsN #> 1), LIM_MID, spAmpsN > 0)
    benchLog.naNumField(@"r_amps", spAmpsSum[SLOT_RIGHT] / (spAmpsN #> 1), LIM_MID, spAmpsN > 0)
    benchLog.naNumField(@"pack_mv", fllPackMv, LIM_MID, bFllPack)
    whyField(fllWhy)
    emitRecord()
#endif

#ifdef DBF_FAULTRUN
PRI rdReset(legIdx, dirIdx) | slotIdx
' Clear the re-drive's staging and take its "before": each wheel's getCurrent() mean over the leg back's steady second,
' which spinFault() polled into spAmpsSum, as the leg's staging still holds it (none when it never polled).
'
' @param legIdx - SRC_REV 58's fault leg; SRC_REV 62: 0, FAULTRUN's one run
' @param dirIdx - the faulted wheel's slot
'
' @local slotIdx - motor slot

    rdLeg := legIdx
    rdSide := SIDE_LEFT + dirIdx
    rdRemain := 0
    rdLimErr := NO_ERROR
    rdDriveErr := NO_ERROR
    rdStopBy := SPSTOP_NOT_RUN
    rdWhy := WHY_NONE
    bRdDriven := FALSE
    bRdReached := FALSE
    rdAtMs := 0
    rdWinMs := 0
    bRdWinValid := FALSE
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        bRdAborted[slotIdx] := FALSE
        rdPre[slotIdx] := 0
        bRdPre[slotIdx] := FALSE
        rdPost[slotIdx] := 0
        rdRatio[slotIdx] := 0
        bRdRatio[slotIdx] := FALSE
        if spAmpsN > 0
            rdPre[slotIdx] := spAmpsSum[slotIdx] / spAmpsN
            bRdPre[slotIdx] := (rdPre[slotIdx] >= RD_PRE_MIN)

PRI rdDrive() : whyCode | slotIdx, safeEvent, bReached, bAtLimit, startMs, winStartMs
' The re-drive's motion (FAULTRUN, SRC_REV 62): the leg back's own powers, both AT_SPEED, then
' SPIN_FAULT_SETTLE_MS with getCurrent() polled (the leg back's own "before" window, spinWatch(), its travel guard live),
' then on to its limit -- the start -- and rest (SRC_REV 58's re-drive was stopped by the harness after its window). An
' absolute-current abort on either wheel is PL-93's own signature and is recorded per wheel (rdAbortSeen()).
'
' @returns whyCode - WHY_NONE, or why FAULTRUN must end
'
' @local slotIdx - motor slot
' @local safeEvent - SAFE_* that ended a watch
' @local bReached - both wheels read AT_SPEED
' @local bAtLimit - both wheels read STOPPED at its limit
' @local startMs - getms() at the command
' @local winStartMs - getms() at the window's start

    bSpStopBegan := FALSE                                   ' the leg's records are out: the watch's flags are this drive's now
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        spAmpsSum[slotIdx] := 0
    spAmpsN := 0
    curIncre := 0
    startMs := getms()
    beat(CP_LIB_STEER_DRIVE)
    rdDriveErr := steering.driveAtPower(spLeftPwr, spRightPwr)
    beat(CP_LIB_STEER_DRIVE)
    bRdDriven := TRUE
    safeEvent := SAFE_NONE
    bReached := FALSE
    bAtLimit := FALSE
    if rdDriveErr <> NO_ERROR
        rdWhy := WHY_SYNC_PRECOND
        steerStopMotors()
    else
        safeEvent, bReached := spinWatch(UNTIL_AT_SPEED, SPIN_ATSPEED_MS, FALSE)
        rdAbortSeen(safeEvent)
        if (safeEvent == SAFE_NONE) and (bSpOvertravel == FALSE) and bReached
            bRdReached := TRUE
            rdAtMs := getms() - startMs
            winStartMs := getms()
            safeEvent, _ := spinWatch(UNTIL_TIME, SPIN_FAULT_SETTLE_MS, TRUE)
            rdAbortSeen(safeEvent)
            rdWinMs := getms() - winStartMs
            bRdWinValid := (safeEvent == SAFE_NONE) and (bSpOvertravel == FALSE) and (rdWinMs >= RD_WIN_MIN_MS) and (spAmpsN > 0)
            if bRdWinValid
                repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                    rdPost[slotIdx] := spAmpsSum[slotIdx] / spAmpsN
        if (safeEvent == SAFE_NONE) and (bSpOvertravel == FALSE)
            safeEvent, bAtLimit := spinWatch(UNTIL_STOPPED, FL_LEG_MS, FALSE)   ' on to the start
            rdAbortSeen(safeEvent)
    whyCode := rdEnd(safeEvent, bReached, bAtLimit)
    waitRest(SIDE_BOTH, STOP_TIMEOUT_MS, FALSE)

PRI rdAbortSeen(safeEvent) | slotIdx
' After a re-drive watch that ended on the absolute-current abort: mark each wheel whose consecutive-over count reached
' ABS_ABORT_SAMPLES (safetyPoll() leaves it there until the next watch resets it).
'
' @param safeEvent - SAFE_* the watch ended on
'
' @local slotIdx - motor slot

    if safeEvent == SAFE_ABS_ABORT
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            if safeAbsCount[slotIdx] >= ABS_ABORT_SAMPLES
                bRdAborted[slotIdx] := TRUE

PRI rdEnd(safeEvent, bReached, bAtLimit) : whyCode
' Classify how a re-drive ended and take the stop it calls for, as spinEnd() does for a leg: the travel guard, the abort
' or a stalled instrument, a fault, no AT_SPEED (recorded), its limit -- the start, its good end -- or its bound
' (TIMEOUT).
'
' @param safeEvent - SAFE_* its last watch ended on
' @param bReached - both wheels read AT_SPEED
' @param bAtLimit - both wheels read STOPPED at its limit
' @returns whyCode - WHY_NONE, or why FAULTRUN must end

    whyCode := WHY_NONE
    if bRdDriven == FALSE
        rdStopBy := SPSTOP_NOT_RUN
    elseif rdDriveErr <> NO_ERROR
        rdStopBy := SPSTOP_ABORT
    elseif bSpOvertravel
        rdStopBy := SPSTOP_OVERTRAVEL
        whyCode := WHY_OVERTRAVEL
    elseif (safeEvent == SAFE_ABS_ABORT) or (safeEvent == SAFE_INST_STALL)
        rdStopBy := SPSTOP_ABORT
        whyCode := safeWhy(safeEvent)
    elseif safeEvent == SAFE_FAULT
        rdStopBy := SPSTOP_FAULT
        whyCode := WHY_FAULTED
    elseif bAtLimit
        rdStopBy := SPSTOP_LIMIT                            ' at the start (a re-drive that never reached AT_SPEED names it)
        if bReached == FALSE
            rdWhy := WHY_STEADY_TIMEOUT
    else
        rdStopBy := SPSTOP_TIMEOUT
        whyCode := WHY_STOP_TIMEOUT
    if (rdWhy == WHY_NONE) and (whyCode <> WHY_NONE)
        rdWhy := whyCode
    if bSteerUp and (rdStopBy <> SPSTOP_LIMIT)
        steerStopMotors()

PRI rdNotRun(legIdx, dirIdx, whyCode)
' BM-RDRIVE for FAULTRUN's re-drive when the run ended short before it: the cause, every reading NA, nothing folded.
'
' @param legIdx - SRC_REV 62: 0, the one run
' @param dirIdx - the faulted wheel's slot
' @param whyCode - WHY_* naming why

    rdReset(legIdx, dirIdx)
    rdWhy := whyCode
    emitRedrive()

PRI rdFold() | slotIdx
' Fold one re-drive into R21-DUAL-POSTFLT-P per wheel: a wheel that tripped the abort scores RD_ABORT_X100; otherwise a
' valid window over a pre-fault current of at least RD_PRE_MIN gives post x 100 / pre. A window read over too small a
' "before" names LOW_CURRENT.
'
' @local slotIdx - motor slot

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        if bRdAborted[slotIdx]
            rdRatio[slotIdx] := RD_ABORT_X100
            bRdRatio[slotIdx] := TRUE
        elseif bRdWinValid and bRdPre[slotIdx]
            rdRatio[slotIdx] := (rdPost[slotIdx] * RD_PCT_SCALE) / rdPre[slotIdx]
            bRdRatio[slotIdx] := TRUE
        elseif bRdWinValid and (rdWhy == WHY_NONE)
            rdWhy := WHY_LOW_CURRENT
        if bRdRatio[slotIdx]
            sfRdN[slotIdx] := (sfRdN[slotIdx] + 1) <# LIM_SMALL
            sfRdMax[slotIdx] #>= rdRatio[slotIdx]
#endif

#ifdef DBF_RAMP
DAT ' ---- ramp leg tables ----

' the four legs (RAMP_LEGS), in run order, out and back in pairs: the power commanded (positive out, negative back) and the two
'  settings, mm/s^2 at the rim -- the ends and middle of the knobs' ranges (the section's CON)
rampPower       LONG    RAMP_POWER, 0 - RAMP_POWER, RAMP_POWER, 0 - RAMP_POWER
rampDir         LONG    SIGN_POS, SIGN_NEG, SIGN_POS, SIGN_NEG                  ' ...and the sign of that power
rampAccel       LONG    RAMP_ACCEL_LO, RAMP_ACCEL_MID, RAMP_ACCEL_HI, RAMP_ACCEL_MID
rampDecel       LONG    RAMP_DECEL_LO, RAMP_DECEL_MID, RAMP_DECEL_HI, RAMP_DECEL_MID
tokRampSet      BYTE    "LEG", 0, "RESTORE", 0, TOK_END

PRI segRamp() | whyCode
' RAMP (part SPIN, SRC_REV 70; SESSION 2 part 3, the section's CON, "the ramp legs"): four straight legs of FL_LEG_MM, out and back
' in pairs, in one steering lifetime, each at its own acceleration and deceleration, each recording what the ramp achieved
' against the setting (BM-RAMPLEG). A STRAIGHT action: skipped, with a plain line, when an earlier one failed; the fence checks
' every leg before it is armed.
'
' @local whyCode - why the segment ended short, WHY_NONE when every leg ran

    segBegin(SEG_RAMP)
    whyCode := WHY_STRAIGHTS_SKIPPED
    if bSessStraightsMayGo(@"the ramp legs")
        alignSay(@"PART 3 OF 3: the ramp legs -- four straight 1 m legs, out and back twice, at three accelerations and three decelerations")
        whyCode := rampLifetime()
    ' if/else, never `? :` (PL-29): segWhy() is a call
    if whyCode <> WHY_NONE
        segEnd(whyCode)
    else
        segEnd(segWhy())

PRI rampLifetime() : whyCode | legIdx, legWhy
' The ramp legs' one steering lifetime: the start, the wheel size the limits assume, the capture armed for its mirror only, the four
' legs in order (a leg that does not come to rest at its limit ends the part: it is a straight action that failed, and
' the platform is not known to be at its start), a fault's recovery, the built-in rates restored (the setters are kept across
' stop() and start()), and the lifetime closed.
'
' @returns whyCode - WHY_NONE when all four legs came to rest at their limits, else the cause the first that did not
'
' @local legIdx - 0..RAMP_LEGS-1
' @local legWhy - one leg's cause

    whyCode := WHY_NONE
    if bRunContinue(SEG_RAMP) == FALSE
        whyCode := WHY_ABORTED
    elseif bSteerStart(SEG_RAMP) == FALSE
        whyCode := WHY_NO_COG
    elseif steerTickInMM() <> TICK_MM_X100
        whyCode := WHY_TICK_SIZE_DIFFERS
    elseif bInstArm(INST_SRC_STEER, RAMP_DECIM) == FALSE
        whyCode := WHY_INST_NOACK
    else
        repeat legIdx from 0 to RAMP_LEGS - 1
            beat(CP_LOOP_POLL)
            legWhy := rampLeg(legIdx)
            if legWhy <> WHY_NONE
                whyCode := legWhy
                quit
        if bSteerUp and (rampStopBy == SPSTOP_FAULT)
            steerRecoverFault(curTid)                       ' counts it and cools; the leg's own why already ends the part
    sessStraightEnd(whyCode == WHY_NONE, whyCode)
    if bRampChanged
        rampSetRates(RSET_RESTORE, RAMP_ACCEL_MID, RAMP_DECEL_MID)      ' I11: the built-in rates back before the lifetime stops
        bRampChanged := FALSE
    if bSteerUp
        bInstIdle()
        steerStop()

PRI rampLeg(legIdx) : whyCode
' One ramp leg: its settings made and read back (rampSetRates(), BM-RAMPSET), the fence's check of its worst-case end, the drive
' (rampDrive()), the fence's estimate of where it left the platform, its record (BM-RAMPLEG), and the driver's event log
' drained EV_SETTLE_MS after it (EVST_RAMP) -- the second's rest between legs.
'
' @param legIdx - 0..RAMP_LEGS-1
' @returns whyCode - WHY_NONE when the leg came to rest at its limit, else why it did not

    rampLegReset(legIdx)
    whyCode := WHY_NONE
    if bRunContinue(SEG_RAMP) == FALSE
        whyCode := WHY_ABORTED
    else
        rampSetErr := rampSetRates(RSET_LEG, rampAccelSet, rampDecelSet)
        if rampSetErr <> NO_ERROR
            whyCode := WHY_RATE_REFUSED
        elseif bFenceAllows(FL_LEG_TICKS * rampDirCmd, FEN_RAMP, legIdx + 1) == FALSE
            whyCode := WHY_FENCE_REFUSED
        else
            whyCode := rampDrive()
    rampWhy := whyCode
    if bRampDriven
        fenceAdvance(FEN_RAMP, legIdx + 1)
        sessRampTried += 1
        if rampStopBy == SPSTOP_LIMIT
            sessRampLimit += 1
    emitRampLeg(legIdx)
    if bRampDriven and bSteerUp
        waitBeat(EV_SETTLE_MS, CP_LOOP_REST)
        evDrain(EVSRC_STEER, EVST_RAMP)
        rampFold(legIdx)
    segItems := (segItems + 1) <# LIM_SMALL

PRI rampFold(legIdx) | slotIdx, nPathAll, nLimAll, bJudged, bBad
' SRC_REV 75 (task 3657): one ramp leg's drain into RAMPARR and LIMGIVE's limb (b), and BM-LIMW per wheel. The leg is JUDGED only
' when its drain read whole (bEvdClean()) and its wheels left rest (bRampMoved: a drive that never moved says nothing about the
' ramp). It is BAD when its log holds any EV_PATH_LIMIT, or its wheels never read AT_SPEED, or they arrived (rampAtMs) more than
' RAMPARR_PCT % from the S-curve's prediction (rampPredAtMs), early or late.
'
' @param legIdx - 0..RAMP_LEGS-1
'
' @local slotIdx - motor slot
' @local nPathAll - EV_PATH_LIMIT events in the leg's log, both wheels
' @local nLimAll - EV_FOLDBACK and EV_CURRENT_LIMIT events in it, both wheels
' @local bJudged - T/F where T means the leg counts toward RAMPARR
' @local bBad - T/F where T means the leg fails it

    nPathAll := evCount(EVI_LEFT, wheelL.EV_PATH_LIMIT) + evCount(EVI_RIGHT, wheelL.EV_PATH_LIMIT)
    nLimAll := evCount(EVI_LEFT, wheelL.EV_FOLDBACK) + evCount(EVI_RIGHT, wheelL.EV_FOLDBACK)
    nLimAll += evCount(EVI_LEFT, wheelL.EV_CURRENT_LIMIT) + evCount(EVI_RIGHT, wheelL.EV_CURRENT_LIMIT)
    bJudged := bEvdClean() and bRampMoved
    if bJudged
        sfRampN := (sfRampN + 1) <# LIM_SMALL
        bBad := (nPathAll > 0) or (bRampAt == FALSE)
        if bBad == FALSE
            bBad := (abs(rampAtMs - rampPredAtMs) * RAMPARR_PCT_SCALE) > (RAMPARR_PCT * rampPredAtMs)
        if bBad
            sfRampBad := (sfRampBad + 1) <# LIM_SMALL
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        emitLimW(SEG_RAMP, legIdx + 1, slotIdx, lgHeldCmd[slotIdx] - lgHeldBase[slotIdx], evCount(EVI_LEFT + slotIdx, wheelL.EV_PATH_LIMIT), evCount(EVI_LEFT + slotIdx, wheelL.EV_FOLDBACK) + evCount(EVI_LEFT + slotIdx, wheelL.EV_CURRENT_LIMIT))
    if bEvdClean() and (lgSamples[SLOT_LEFT] > 0) and (lgSamples[SLOT_RIGHT] > 0)     ' the same test as a spin leg's (limFoldSpinLeg())
        limFoldLegLimb(nPathAll, nLimAll)

PRI rampLegReset(legIdx) | slotIdx
' Clear one ramp leg's staging, take its row of the tables, and predict what the S-curve gives (sCurve()) for it: the time to
' speed, the peak speed-up and slow-down, and the stop's travel in ticks, all at RAMP_V_MM_S.
'
' @param legIdx - 0..RAMP_LEGS-1
'
' @local slotIdx - motor slot

    rampIdx := legIdx
    rampPowerCmd := rampPower[legIdx]
    rampDirCmd := rampDir[legIdx]
    rampAccelSet := rampAccel[legIdx]
    rampDecelSet := rampDecel[legIdx]
    rampAccelRd := 0
    rampDecelRd := 0
    rampSetErr := NO_ERROR
    rampArmErr := NO_ERROR
    rampDriveErr := NO_ERROR
    rampStopBy := SPSTOP_NOT_RUN
    rampWhy := WHY_NONE
    bRampDriven := FALSE
    bRampOn := FALSE
    bRampMoved := FALSE
    bRampAt := FALSE
    bRampStopSeen := FALSE
    bRampRest := FALSE
    rampCmdMs := 0
    rampAtMs := 0
    rampStopMs := 0
    rampRestMs := 0
    rampStopTicks := 0
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        rampStatusPtr[slotIdx] := 0
        rampDirSign[slotIdx] := 1
        rampPeakUp[slotIdx] := 0
        rampPeakDn[slotIdx] := 0
        rampStopPos[slotIdx] := 0
        rampTravel[slotIdx] := 0
    rampPredAtMs, rampPredUp, _ := sCurve(RAMP_V_MM_S, rampAccelSet)
    _, rampPredDn, rampPredStopTk := sCurve(RAMP_V_MM_S, rampDecelSet)
    rampPredStopTk := (rampPredStopTk * SPIN_X100) / TICK_MM_X100       ' the stop's travel, mm to ticks

PRI rampDrive() : whyCode | safeEvent, bReached
' One ramp leg's motion: the guard's zero and the leg's FL_LEG_TICKS (flLegBegin(), which marks the fence), the leg's distance stop
' ARMED BEFORE IT MOVES (stopAfterDistance(): a refused one and it is never driven), SYNC_PRECOND, the drivers' status runs and
' the leg's staging (rampStageBegin()), the command, then spinWatch() until the wheels leave rest and again until both are
' STOPPED -- the travel guard live throughout, and the drivers' acceleration sampled every pass (rampSample(), a hub read) --
' the end classified (flLegEnd()) and rest. The stop's travel is read at rest (rampStageEnd()).
'
' @returns whyCode - WHY_NONE when it came to rest at its limit, else why not
'
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - the watched wait reached what it waited for

    whyCode := WHY_NONE
    safeEvent := SAFE_NONE
    bReached := FALSE
    waitBeat(SPIN_MIRROR_MS, CP_LOOP_READY)                 ' the mirror refreshes on the instrument's next passes
    flLegBegin(FL_LEG_TICKS)
    beat(CP_LIB_STEER_DRIVE)
    rampArmErr := steering.stopAfterDistance(FL_LEG_MM, steering.DDU_MM)
    beat(CP_LIB_STEER_DRIVE)
    if rampArmErr <> NO_ERROR
        whyCode := WHY_LIMIT_REFUSED
    elseif bSteerDrivePrecondition(SEG_RAMP, curTid) == FALSE
        whyCode := WHY_SYNC_PRECOND
    else
        rampStageBegin()
        curIncre := 0
        rampCmdMs := getms()
        beat(CP_LIB_STEER_DRIVE)
        rampDriveErr := steering.driveAtPower(rampPowerCmd, rampPowerCmd)
        beat(CP_LIB_STEER_DRIVE)
        bRampDriven := TRUE
        if rampDriveErr <> NO_ERROR
            rampStopBy := SPSTOP_ABORT
            whyCode := WHY_SYNC_PRECOND
            steerStopMotors()
        else
            bRampOn := TRUE
            safeEvent, bReached := spinWatch(UNTIL_MOVING, FL_MOVE_MS, FALSE)
            if (safeEvent == SAFE_NONE) and (bSpOvertravel == FALSE) and (bReached == FALSE)
                rampStopBy := SPSTOP_TIMEOUT                ' taken, but the drive never left rest: not its limit
                whyCode := WHY_NOT_REACHED
                steerStopMotors()
            else
                if (safeEvent == SAFE_NONE) and (bSpOvertravel == FALSE)
                    safeEvent, bReached := spinWatch(UNTIL_STOPPED, FL_LEG_MS, FALSE)
                    if bReached
                        bRampRest := TRUE
                        rampRestMs := getms()
                whyCode := flLegEnd(safeEvent, bReached)
                rampStopBy := fllStopBy
            bRampOn := FALSE
        waitRest(SIDE_BOTH, STOP_TIMEOUT_MS, FALSE)
        rampStageEnd()

PRI rampStageBegin() | slotIdx
' Before the command: each driver's status run (its address, from the steering object: drv_accel_now is read there with no
' library call, as the travel guard reads targetIncre), and each wheel's sign -- a positive power drives the left motor's
' increments positive and the right's negative (the steering object reverses it), so a speed-up reads positive on the left
' and negative on the right and the sign makes both positive. The ramp sampler's state cleared.
'
' @local slotIdx - motor slot

    beat(CP_LIB_STEER_QUERY)
    _, rampStatusPtr[SLOT_LEFT], _ := steering.testLeftGetAbiAddrs()
    _, rampStatusPtr[SLOT_RIGHT], _ := steering.testRightGetAbiAddrs()
    beat(CP_LIB_STEER_QUERY)
    rampDirSign[SLOT_LEFT] := rampDirCmd
    rampDirSign[SLOT_RIGHT] := 0 - rampDirCmd
    bRampMoved := FALSE
    bRampAt := FALSE
    bRampStopSeen := FALSE
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        rampPeakUp[slotIdx] := 0
        rampPeakDn[slotIdx] := 0

PRI rampStageEnd() | slotIdx, nBack
' At rest: each wheel's raw travel over the leg, and, when the stop was seen to begin, the farther wheel's travel from there to
' rest, in ticks.
'
' @local slotIdx - motor slot
' @local nBack - one wheel's travel from the stop's beginning to rest

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        rampTravel[slotIdx] := instLastPos[slotIdx] - spPos0[slotIdx]
        if bRampStopSeen
            nBack := abs(instLastPos[slotIdx] - rampStopPos[slotIdx])
            rampStopTicks #>= nBack

PRI rampSample() | slotIdx, nAccelMm
' One sample of the ramp, taken inside spinWatch() every pass while bRampOn: the first pass both wheels read AT_SPEED (the time to
' speed), the pass the leg's distance stop is first seen to begin -- a wheel's target zero, bSpinStopBegun(), only once both wheels
' have left rest -- with each wheel's raw pos then, and each driver's acceleration drv_accel_now, a hub read, converted to
' mm/s^2 and kept as the largest speed-up before the stop began and the largest slow-down after it. No library call is made.
'
' @local slotIdx - motor slot
' @local nAccelMm - one driver's acceleration in the commanded direction, mm/s^2: positive while it speeds up

    if bRampMoved == FALSE
        bRampMoved := bMirrorNoneInState(SIDE_BOTH, DCS_STOPPED)
    if bRampMoved
        if (bRampAt == FALSE) and bMirrorAllInState(SIDE_BOTH, DCS_AT_SPEED)
            bRampAt := TRUE
            rampAtMs := getms() - rampCmdMs
        if (bRampStopSeen == FALSE) and bSpinStopBegun()
            bRampStopSeen := TRUE
            rampStopMs := getms()
            repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                rampStopPos[slotIdx] := instLastPos[slotIdx]
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        if rampStatusPtr[slotIdx] <> 0
            nAccelMm := ((long[rampStatusPtr[slotIdx]][RAMP_ACCEL_IDX] * rampDirSign[slotIdx]) * RAMP_DEF_ACCEL_MM_S2) / RAMP_DEF_ACCEL_UP
            if bRampStopSeen
                rampPeakDn[slotIdx] #>= (0 - nAccelMm)
            else
                rampPeakUp[slotIdx] #>= nAccelMm

PRI sCurve(nSpeed, nRate) : nMs, nPeak, nMm | nThreshold
' The jerk-limited ramp's shape for a change of nSpeed at the limit nRate, the jerk being nRate / RAMP_TAU_MS (the section's CON
' derives it): when nSpeed reaches nRate x RAMP_TAU_MS the acceleration holds nRate for a while, and the change takes nSpeed /
' nRate + RAMP_TAU_MS; below that it is a triangle, 2 sqrt(nSpeed x RAMP_TAU_MS / nRate), and the acceleration peaks at sqrt(nSpeed
' x nRate / RAMP_TAU_MS), under nRate. The change covers nSpeed x time / 2 either way. Integer, the products held under 2^31.
'
' @param nSpeed - the change of speed, mm/s
' @param nRate - the acceleration or deceleration limit, mm/s^2
' @returns nMs - how long the change takes, ms
' @returns nPeak - the peak acceleration it reaches, mm/s^2
' @returns nMm - the distance it covers, mm
'
' @local nThreshold - the speed at which the acceleration just reaches the limit, mm/s

    nThreshold := (nRate * RAMP_TAU_MS) / MS_PER_SEC
    if nSpeed >= nThreshold
        nMs := ((nSpeed * MS_PER_SEC) / nRate) + RAMP_TAU_MS
        nPeak := nRate
    else
        nMs := 2 * sqrt((nSpeed * RAMP_TAU_MS * MS_PER_SEC) / nRate)
        nPeak := sqrt((nSpeed * nRate * MS_PER_SEC) / RAMP_TAU_MS)
    nMm := (nSpeed * nMs) / (2 * MS_PER_SEC)

PRI rampSetRates(eEvent, nAccel, nDecel) : eError | nRdAccel, nRdDecel
' Make a ramp leg's two settings through the steering object (mm/s^2 at the rim), read both back, and print BM-RAMPSET. Also the
' restore of the built-in rates before the lifetime ends (RSET_RESTORE). Outside every timed wait.
'
' @param eEvent - RSET_LEG or RSET_RESTORE
' @param nAccel - the acceleration, mm/s^2
' @param nDecel - the deceleration, mm/s^2
' @returns eError - NO_ERROR, or the first refusal's code
'
' @local nRdAccel - getAcceleration()'s reading
' @local nRdDecel - getDeceleration()'s

    beat(CP_LIB_RAMP)
    eError := steering.setAcceleration(nAccel)
    if eError == NO_ERROR
        eError := steering.setDeceleration(nDecel)
    nRdAccel := steering.getAcceleration()
    nRdDecel := steering.getDeceleration()
    beat(CP_LIB_RAMP)
    bRampChanged := TRUE
    rampAccelRd := nRdAccel
    rampDecelRd := nRdDecel
    emitRampSet(eEvent, nAccel, nDecel, eError, nRdAccel, nRdDecel)

PRI emitRampBuild()
' BM-RAMPBUILD: the ramp legs' compiled numbers and derivations, printed before anything moves -- the power and the speed it
' commands (mm/s and ticks/s x10), the ramp's easing time, the leg in ticks, the room the slowest rise and stop take (leg 1)
' against the half-leg the rule allows, the capture's decimation, and the four legs' settings, acceleration then deceleration,
' in run order (the section's CON has the derivation). SRC_REV 75 (FMT 50): RAMPARR's band, arr_pct. Worst case 240 bytes: the 227 it
' was plus ",arr_pct," + LIM_TINY's 4.

    recBegin(@"BM-RAMPBUILD")
    benchLog.numField(@"arr_pct", RAMPARR_PCT, LIM_TINY)
    benchLog.numField(@"power", RAMP_POWER, LIM_TINY)
    benchLog.numField(@"v_mm_s", RAMP_V_MM_S, LIM_SMALL)
    benchLog.numField(@"rate_x10", RAMP_RATE_X10, LIM_SMALL)
    benchLog.numField(@"tau_ms", RAMP_TAU_MS, LIM_TINY)
    benchLog.numField(@"leg_tk", FL_LEG_TICKS, LIM_TINY)
    benchLog.numField(@"room_mm", RAMP_ROOM_MM, LIM_SMALL)
    benchLog.numField(@"room_max", RAMP_ROOM_LIMIT_MM, LIM_SMALL)
    benchLog.numField(@"decim", RAMP_DECIM, LIM_TINY)
    benchLog.numField(@"a1", rampAccel[0], LIM_SMALL)
    benchLog.numField(@"d1", rampDecel[0], LIM_SMALL)
    benchLog.numField(@"a2", rampAccel[1], LIM_SMALL)
    benchLog.numField(@"d2", rampDecel[1], LIM_SMALL)
    benchLog.numField(@"a3", rampAccel[2], LIM_SMALL)
    benchLog.numField(@"d3", rampDecel[2], LIM_SMALL)
    benchLog.numField(@"a4", rampAccel[3], LIM_SMALL)
    benchLog.numField(@"d4", rampDecel[3], LIM_SMALL)
    emitRecord()

PRI emitRampSet(eEvent, nAccel, nDecel, eError, nRdAccel, nRdDecel)
' BM-RAMPSET: one setting of the ramp -- a leg's, or the restore of the built-in rates (RSET_*): what was asked (acc, dec,
' mm/s^2), what setAcceleration() / setDeceleration() returned, what getAcceleration() / getDeceleration() read back, and whether
' they agree. Worst case 120 bytes.
'
' @param eEvent - RSET_LEG or RSET_RESTORE
' @param nAccel - the acceleration asked, mm/s^2
' @param nDecel - the deceleration asked
' @param eError - the setter's return
' @param nRdAccel - the acceleration read back
' @param nRdDecel - the deceleration read back

    recBegin(@"BM-RAMPSET")
    benchLog.tokenField(@"ev", tokenAt(@tokRampSet, RSET_COUNT, eEvent), TOKMAX_RSET)
    benchLog.numField(@"leg", (eEvent == RSET_LEG) ? rampIdx + 1 : 0, LIM_TINY)     ' the restore belongs to no leg
    benchLog.numField(@"acc", nAccel, LIM_SMALL)
    benchLog.numField(@"dec", nDecel, LIM_SMALL)
    benchLog.numField(@"err", eError, LIM_SMALL)
    benchLog.numField(@"rd_acc", nRdAccel, LIM_SMALL)
    benchLog.numField(@"rd_dec", nRdDecel, LIM_SMALL)
    benchLog.boolField(@"ok", (eError == NO_ERROR) and (nRdAccel == nAccel) and (nRdDecel == nDecel))
    emitRecord()

PRI emitRampLeg(legIdx)
' BM-RAMPLEG: one ramp leg -- its number (1-based), the power commanded (negative is back), the acceleration and deceleration it ran
' at (read back from the steering object), the leg in ticks, what ended it; command to both AT_SPEED against the S-curve's
' prediction; the peak speed-up each wheel's driver reported (drv_accel_now, mm/s^2, before the stop began) and its prediction,
' and the peak slow-down (after) and its prediction; the stop's travel, the farther wheel's hall ticks from the stop's beginning to
' rest, against its prediction, and the time from the stop's beginning to both wheels STOPPED (ms). The predictions are the
' S-curve's (sCurve()) at RAMP_V_MM_S: a rate over speed x TAU is a triangle and never reaches its setting. Worst case 269 bytes.
'
' @param legIdx - 0..RAMP_LEGS-1

    recBegin(@"BM-RAMPLEG")
    benchLog.numField(@"leg", legIdx + 1, LIM_TINY)
    benchLog.numField(@"pwr", rampPowerCmd, LIM_TINY)
    benchLog.numField(@"acc", rampAccelRd, LIM_SMALL)
    benchLog.numField(@"dec", rampDecelRd, LIM_SMALL)
    benchLog.numField(@"ticks", FL_LEG_TICKS, LIM_TINY)
    benchLog.tokenField(@"stop_by", tokenAt(@tokSpStop, SPSTOP_COUNT, rampStopBy), TOKMAX_SPSTOP)
    benchLog.naNumField(@"at_ms", rampAtMs, LIM_SMALL, bRampAt)
    benchLog.numField(@"p_at_ms", rampPredAtMs, LIM_SMALL)
    benchLog.naNumField(@"up_l", rampPeakUp[SLOT_LEFT], LIM_SMALL, bRampDriven)
    benchLog.naNumField(@"up_r", rampPeakUp[SLOT_RIGHT], LIM_SMALL, bRampDriven)
    benchLog.numField(@"p_up", rampPredUp, LIM_SMALL)
    benchLog.naNumField(@"dn_l", rampPeakDn[SLOT_LEFT], LIM_SMALL, bRampStopSeen)
    benchLog.naNumField(@"dn_r", rampPeakDn[SLOT_RIGHT], LIM_SMALL, bRampStopSeen)
    benchLog.numField(@"p_dn", rampPredDn, LIM_SMALL)
    benchLog.naNumField(@"stp_tk", rampStopTicks, LIM_TINY, bRampStopSeen)
    benchLog.numField(@"p_stp_tk", rampPredStopTk, LIM_TINY)
    benchLog.naNumField(@"stp_ms", rampRestMs - rampStopMs, LIM_SMALL, bRampStopSeen and bRampRest)
    whyField(rampWhy)
    emitRecord()
#endif

#ifdef DBF_OBST
PRI segBlock() | whyCode
' OBSTACLE (part SPIN; SRC_REV 62, the first floor situation; SRC_REV 58's BLOCK): the floor situations' CON, 1. SRC_REV 69:
' ONE trial, straight after the lead-in, in its own steering lifetime (blockTrial()): the COAST trial or the BRAKE trial,
' whichever the image was built for (FLOOR_BLK_KIND). SRC_REV 70, SESSION 3 (DBF_OBSTSESS): BOTH trials, COAST then BRAKE, each
' with an armed drive back to the start (blockSession()).
'
' @local whyCode - why the segment ended short, WHY_NONE when the trial ran

    segBegin(SEG_OBSTACLE)
#ifdef DBF_OBSTSESS
    whyCode := blockSession()
#else
    whyCode := blockTrial(FLOOR_BLK_KIND)
#endif
    blkSegWhy := whyCode
    ' if/else, never `? :` (PL-29): segWhy() is a call
    if whyCode <> WHY_NONE
        segEnd(whyCode)
    else
        segEnd(segWhy())

PRI blockTrial(kind) : whyCode | tid, reqMode
' The OBSTACLE trial (the floor situations' CON, 1.): the steering start, the stop mode, the lowered limits and the
' capture; the drive into the obstacle, its watch and, once latched, its phase window and the API sequence
' (blockDrive()); the capture frozen, the limits restored, the event log drained EV_SETTLE_MS on, the lifetime stopped;
' then its judgement from the ring, its trace, BM-BLOCK, BM-BLKCLR and BM-SR, and its folds. SRC_REV 69: the run ends
' there; no READY screen precedes it and no BACK step follows it -- he pulls the platform back by hand. SRC_REV 70, SESSION 3
' (DBF_OBSTSESS): the fence checks the drive first, and an ARMED drive back to the start (blockBack()) follows the event drain,
' in the same lifetime, before it is stopped.
'
' @param kind - BLK_*
' @returns whyCode - WHY_NONE when the trial ran, else why it did not
'
' @local tid - trace id
' @local reqMode - MODE_FLOAT for the COAST trial, MODE_BRAKE for the BRAKE trial

    blkReset(kind)
    tid := nextTraceId()
    cpReset()
    reqMode := MODE_FLOAT
    if kind == BLK_BRAKE
        reqMode := MODE_BRAKE
    if bRunContinue(SEG_OBSTACLE) == FALSE
        whyCode := WHY_ABORTED
#ifdef DBF_OBSTSESS
    elseif bFenceAllows(FL_LEG_TICKS, FEN_OBST, kind + 1) == FALSE
        whyCode := WHY_FENCE_REFUSED                        ' SRC_REV 70: the drive at the obstacle is armed for 1 m: the fence checks that
#endif
    elseif bSteerStart(SEG_OBSTACLE) == FALSE
        whyCode := WHY_NO_COG
        if bSteerUp
            steerStop()
    else
        whyCode := WHY_NONE
        blkSid := steerLife
        if kind == BLK_BRAKE
            steerHold(TRUE)
        blkLimErr := steerSetLimits(BLK_LIMIT_A, BLK_LIMIT_A)
        if blkLimErr <> NO_ERROR
            whyCode := WHY_LIMIT_REFUSED
        elseif bInstArm(INST_SRC_STEER, BLK_DECIM) == FALSE
            whyCode := WHY_INST_NOACK
        else
            whyCode := blockDrive(tid)
            bBlkFrozen := bInstFreeze(0)
        if bSteerUp
            steerSetLimits(wheelL.I_PEAK_A, wheelL.I_CONT_A)    ' I11: the library's own, before the stop
            if bBlkDriven
                waitBeat(EV_SETTLE_MS, CP_LOOP_REST)
                evDrain(EVSRC_STEER, EVST_OBSTACLE)
                blockLimit()                                ' SRC_REV 75: BLKLIMIT's two stamps, before the drive back's drain replaces them
                blockFault()                                ' SRC_REV 77: BLKFLT's fault counts, from the same drain
#ifdef DBF_OBSTSESS
                blockBack(tid, kind)                        ' SRC_REV 70: the armed drive back to the start, in the same lifetime
#endif
            steerStop()
    if blkWhy == WHY_NONE
        blkWhy := whyCode
    blockJudge()
    if bBlkDriven
        emitSTrace(tid, SEG_OBSTACLE, CAUSE_BLOCK, BLK_POWER, BLK_POWER, TRUE, 0, reqMode, blkWhy)
        if bBlkFrozen
            bTraceDrain(tid, SLOT_LEFT, SLOT_RIGHT, TEND_FROZEN)
        else
            traceEmptyEnd(tid, TEND_ABORT, blkWhy)
    emitBlock()
    emitBlkClr()
    if bBlkDriven
        emitSr(EVST_OBSTACLE, SIDE_BOTH, blkLeftSr, blkRightSr, bBlkSrRead, bBlkSrRead)
    blockFold()
    emitBlkWin()                                            ' SRC_REV 77: after the fold, which settles the two cells' whys it prints
    bInstLagExempt := FALSE
    segItems := (segItems + 1) <# LIM_SMALL

#ifdef DBF_OBSTSESS
PRI blockSession() : whyCode | kindIdx, trialWhy, endWhy, pWords
' SESSION 3 (R15; this section's CON, "the floor sessions"): both OBSTACLE trials in one command, COAST then BRAKE, each in its own
' lifetime (blockTrial()), each with an ARMED drive back to its start inside that lifetime (blockBack()). The obstacle stands
' OBS_NEAR_MM to OBS_FAR_MM ahead. A trial is a straight action: one that could not be completed -- the platform not clear to
' move after it, a drive back the fence refused or that did not come to rest -- stops the session's straight actions, and the
' other trial is skipped with a plain line saying why; a fault the platform recovered from is not a failure. Each trial's
' RESULT body is taken right after it, before the other's staging replaces it.
'
' @returns whyCode - WHY_NONE when both trials ran, else the first cause one did not
'
' @local kindIdx - BLK_COAST, BLK_BRAKE
' @local trialWhy - blockTrial()'s return, or WHY_STRAIGHTS_SKIPPED for a trial not run
' @local endWhy - the cause a failed trial reports to sessStraightEnd()
' @local pWords - pointer to the trial's name in plain words

    whyCode := WHY_NONE
    repeat kindIdx from BLK_COAST to BLK_BRAKE
        beat(CP_LOOP_POLL)
        pWords := @"the BRAKE trial"
        if kindIdx == BLK_COAST
            pWords := @"the COAST trial"
        trialWhy := WHY_STRAIGHTS_SKIPPED
        if bSessStraightsMayGo(pWords)
            if kindIdx == BLK_COAST
                alignSay(@"TRIAL 1 OF 2: COAST -- drives at the obstacle and stops on it, then drives back to its start")
            else
                alignSay(@"TRIAL 2 OF 2: BRAKE -- the same drive, the stop shorting the motors, then back to its start")
            trialWhy := blockTrial(kindIdx)
            bSessObstRan[kindIdx] := TRUE
            sessObstBody[kindIdx], sessObstWhy[kindIdx] := resultObstacle()
            if bBlkDriven and (sessOwedTicks >= SESS_BACK_MIN_TICKS) and (sessBackState[kindIdx] == SBK_NONE)
                sessBackState[kindIdx] := SBK_FAILED        ' a drive back was owed and blockBack() never ran: the steering object was gone
                sessBackWhy[kindIdx] := WHY_NOT_CLEAR
            endWhy := trialWhy
            if sessBackState[kindIdx] == SBK_FAILED
                endWhy := sessBackWhy[kindIdx]
            sessStraightEnd(sessBackState[kindIdx] <> SBK_FAILED, endWhy)
        sessTrialWhy[kindIdx] := trialWhy
        if (trialWhy <> WHY_NONE) and (whyCode == WHY_NONE)
            whyCode := trialWhy
        if bRunAborted
            quit

PRI blockBack(tid, kindIdx) | whyCode
' The session's drive back to the start, inside the trial's own lifetime, after its events are drained (SRC_REV 70). Owed only
' when the trial moved the platform SESS_BACK_MIN_TICKS or more (sessOwedTicks: the farther wheel's travel, measured, at most
' FL_LEG_TICKS: 1 m, never more). It is made only when the platform is KNOWN CLEAR TO MOVE (bBlkClearToMove()) and the fence
' allows it; after FR_CLEAR_MS of STAND CLEAR it is armed first with that travel (flLeg(): stopAfterRotation()) and driven at
' -BLK_POWER (SLOW) with the library's own current limits, then its events drained (EVST_BACK). Records sessBackState /
' sessBackWhy for the RESULT line and the session's straight-action rule.
'
' @param tid - the trial's trace id
' @param kindIdx - BLK_*
'
' @local whyCode - why the drive back was not made or did not finish, WHY_NONE when it came to rest at its limit

    sessBackState[kindIdx] := SBK_NONE
    sessBackWhy[kindIdx] := WHY_NONE
    if sessOwedTicks >= SESS_BACK_MIN_TICKS
        whyCode := WHY_NONE
        if bBlkClearToMove(tid) == FALSE
            whyCode := WHY_NOT_CLEAR
        elseif bFenceAllows(0 - sessOwedTicks, FEN_OBST_BACK, kindIdx + 1) == FALSE
            whyCode := WHY_FENCE_REFUSED
        else
            frunStandClear(@"STAND CLEAR: the platform drives back to its start in")
            bInstLagExempt := FALSE                         ' the stall was the trial's; the drive back is an ordinary drive
            whyCode := flLeg(FLL_BACK, SEG_OBSTACLE, 0 - BLK_POWER, sessOwedTicks, TRUE, FALSE)
            waitRest(SIDE_BOTH, STOP_TIMEOUT_MS, FALSE)
            fenceAdvance(FEN_OBST_BACK, kindIdx + 1)
            waitBeat(EV_SETTLE_MS, CP_LOOP_REST)
            evDrain(EVSRC_STEER, EVST_BACK)
        if whyCode == WHY_NONE
            sessBackState[kindIdx] := SBK_RETURNED
        else
            sessBackState[kindIdx] := SBK_FAILED
            sessBackWhy[kindIdx] := whyCode

PRI bBlkClearToMove(tid) : bClear | eLeftCode, eRightCode, bLtFlt, bLtSig, bRtFlt, bRtSig
' Whether the platform is known clear to move after a trial (SRC_REV 70): the steering object is up with its capture's mirror live,
' no wheel is faulted (a fault is recovered first, steerRecoverFault(): reset, cooled FAULT_COOL_MS, then read again), neither
' protective code is latched, and both wheels are at rest (DCS_STOPPED on the mirror). Anything else and the platform is left
' where it is, and the session says so.
'
' @param tid - the trial's trace id, carried by the recovery's records
' @returns bClear - TRUE when every condition holds
'
' @local eLeftCode - the left wheel's protective code
' @local eRightCode - the right wheel's
' @local bLtFlt - the left wheel's fault flag
' @local bLtSig - its fault signal
' @local bRtFlt - the right wheel's fault flag
' @local bRtSig - its fault signal

    bClear := FALSE
    if bSteerUp and bBlkFrozen
        beat(CP_LIB_STEER_QUERY)
        bLtFlt, bLtSig, bRtFlt, bRtSig := steering.testGetFaultStatus()
        beat(CP_LIB_STEER_QUERY)
        if bLtFlt or bLtSig or bRtFlt or bRtSig
            steerRecoverFault(tid)
            beat(CP_LIB_STEER_QUERY)
            bLtFlt, bLtSig, bRtFlt, bRtSig := steering.testGetFaultStatus()
            beat(CP_LIB_STEER_QUERY)
        eLeftCode, eRightCode := steerProtCodes()
        bClear := (bLtFlt == FALSE) and (bLtSig == FALSE) and (bRtFlt == FALSE) and (bRtSig == FALSE)
        bClear := bClear and (eLeftCode == NO_ERROR) and (eRightCode == NO_ERROR) and bMirrorAllInState(SIDE_BOTH, DCS_STOPPED)
#endif

PRI blkReset(kind) | slotIdx
' Clear one OBSTACLE trial's staging.
'
' @param kind - BLK_*
'
' @local slotIdx - motor slot

    blkKind := kind
    blkSid := 0
    blkWhy := WHY_NONE
    blkStopBy := BLKSTOP_NOT_RUN
    blkLimErr := NO_ERROR
    blkArmErr := NO_ERROR
    blkDriveErr := NO_ERROR
    bBlkDriven := FALSE
    bBlkReached := FALSE
    blkAtMs := 0
    bBlkLatched := FALSE
    blkLatchMs := 0
    blkArm2Err := NO_ERROR
    blkMarkTotal := -1
    blkLatchTotal := -1
    blkWinStart := -1
    blkWinEnd := -1
    blkLeftCode := NO_ERROR
    blkRightCode := NO_ERROR
    blkLeftSr := wheelL.SR_NONE
    blkRightSr := wheelL.SR_NONE
    bBlkSrRead := FALSE
    blkRefuseErr := NO_ERROR
    blkEstClrErr := NO_ERROR
    bBlkEstHeld := FALSE
    blkClrErr := NO_ERROR
    bBlkClrOk := FALSE
    blkAgainErr := NO_ERROR
    bBlkApiRan := FALSE
    bBlkFrozen := FALSE
    bBlkStopJudged := FALSE
    bBlkStopBad := FALSE
    bBlkClrBad := FALSE
    bBlkLimJudged := FALSE
    bBlkFoldFirst := FALSE
    bBlkEvRead := FALSE
    blkWinWhy := WHY_NOT_REACHED
    blkFltWhy := WHY_NOT_REACHED
    blkHeldN := 0
    blkHeldBad := 0
#ifdef DBF_OBSTSESS
    sessOwedTicks := 0
#endif
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        blkLastPos[slotIdx] := 0
        blkLastHw[slotIdx] := 0
        blkTickMs[slotIdx] := 0
        blkStandMs[slotIdx] := 0
        blkCountMs[slotIdx] := 0
        blkCountRunMs[slotIdx] := 0
        blkLimPrev[slotIdx] := 0
        blkLimTick[slotIdx] := FALSE                        ' SRC_REV 77: no limiter has acted yet, and no window has opened
        blkWinFold[slotIdx] := FALSE                        ' SRC_REV 81: nor has the fold-back
        blkFoldPrev[slotIdx] := 0
        blkWinN[slotIdx] := 0
        blkWinHit[slotIdx] := 0
        blkWinMax[slotIdx] := 0
        blkFltN[slotIdx] := 0
        blkRsyN[slotIdx] := 0
        blkPhX10[slotIdx] := 0
        blkPhN[slotIdx] := 0

PRI blockDrive(tid) : whyCode | startMs
' An OBSTACLE trial's motion (the floor situations' CON, 1.): the lag exemption (the stall is provoked on purpose); the
' guard's zero and the leg's FL_LEG_TICKS (flLegBegin()); the leg's distance stop ARMED BEFORE IT MOVES (a refused one
' and it is never driven); SYNC_PRECOND; the mark, driveAtPower(BLK_POWER, BLK_POWER); the watch (blockWatch()); once
' latched, the checks (blockChecks()); then rest.
'
' @param tid - trace id
' @returns whyCode - WHY_NONE, or why OBSTACLE must end
'
' @local startMs - getms() at the command

    whyCode := WHY_NONE
    bInstLagExempt := TRUE
    waitBeat(SPIN_MIRROR_MS, CP_LOOP_READY)                 ' the mirror refreshes on the instrument's next passes
    flLegBegin(FL_LEG_TICKS)
    beat(CP_LIB_STEER_DRIVE)
    blkArmErr := steering.stopAfterDistance(FL_LEG_MM, steering.DDU_MM)
    beat(CP_LIB_STEER_DRIVE)
    if blkArmErr <> NO_ERROR
        whyCode := WHY_LIMIT_REFUSED
    elseif bSteerDrivePrecondition(SEG_OBSTACLE, tid) == FALSE
        whyCode := WHY_SYNC_PRECOND
    else
        blkMarkTotal := instMarkIndex()                     ' the mark PRECEDES the command
        curIncre := 0
        startMs := getms()
        beat(CP_LIB_STEER_DRIVE)
        blkDriveErr := steering.driveAtPower(BLK_POWER, BLK_POWER)    ' both wheels, straight at the obstacle
        beat(CP_LIB_STEER_DRIVE)
        bBlkDriven := TRUE
        if blkDriveErr <> NO_ERROR
            blkStopBy := BLKSTOP_ABORT
            whyCode := WHY_SYNC_PRECOND
            steerStopMotors()
        else
            whyCode := blockWatch(startMs)
            if bBlkLatched
                blockChecks()
        waitRest(SIDE_BOTH, STOP_TIMEOUT_MS, FALSE)
#ifdef DBF_OBSTSESS
        sessOwedTicks := flTravelMax() <# FL_LEG_TICKS      ' SRC_REV 70: the travel the trial made, measured: what a drive back owes, never over 1 m
        fenceAdvance(FEN_OBST, blkKind + 1)                 ' ...and the fence's estimate of where that left the platform
#endif

PRI blockWatch(startMs) : whyCode | lastPollMs, nowMs, safeEvent, eLeftCode, eRightCode, leftPower, rightPower, slotIdx, countMax, pStatus, nLimiter, bLimited, bTick, bRunning, eAbsNow, nFold, bFolded, bWasFold
' The drive into the obstacle, watched every SAMPLE_MS (the floor situations' CON, 1.): the safety read, the travel
' guard; each wheel's last hall tick, stamped the pass its driver's pos or its hwPos is
' seen to change (and whether that tick came after both wheels read AT_SPEED); each wheel's blocked count, mirrored from
' its driver's status run by the driver's own rule (SRC_REV 77 at DRIVER_REV 48, BLK_COUNT_LO_MS's CON), statement for
' statement as bFrontProtect() runs it: a flag (blkLimTick, the driver's bLimSinceTick) is cleared by a tick or a state other
' than SPIN_UP / AT_SPEED, else set by a pass on which duty_capped + foldback_frames moved; the count begins the first pass
' after the last tick whose |err| is at least LAG_SOFT or whose flag is set (the driver's SPIN_DN state counts the |err| half
' too), and a tick, or a pass showing neither, restarts it. The driver's zero-command clear has no mirror: the watch
' ends at the latch, and the drive is commanded until then. BLKWIN (SRC_REV 81, PL-189): its flag is its OWN (blkWinFold), kept
' by the same rule over foldback_frames ALONE -- T-1 arms the limit hold on the fold-back only, so a pass on which only duty_capped
' moved opens no window -- and the count's flag (blkLimTick) is unchanged, since bFrontProtect() still counts both; every pass after
' the one that set a wheel's BLKWIN flag, while it stays set (no tick, still driving), that wheel's |err| is read against
' BLK_WIN_LO_ERR..BLK_WIN_HI_ERR (the pass that sets the flag is not read); both protective codes, EVERY pass -- either set
' is the latch, and each wheel's stand still and
' count run are taken there; getPower() every BLK_POLL_MS -- 0 unasked is the distance stop firing, the obstacle not met.
' A wheel whose count has run BLK_NOLATCH_MS after AT_SPEED with no latch ends it (NO_LATCH: the stop is overdue by the
' driver's own rule); FL_LEG_MS ends it too (TIMEOUT).
'
' @param startMs - getms() at the command
' @returns whyCode - WHY_NONE (latched, not latched in time, or not met: a reading either way), else why OBSTACLE must end
'
' @local lastPollMs - getms() of the last getPower()
' @local nowMs - this pass's getms()
' @local safeEvent - this pass's safety read
' @local eLeftCode - the left wheel's protective code
' @local eRightCode - the right wheel's
' @local leftPower - the left wheel's getPower()
' @local rightPower - the right wheel's
' @local slotIdx - motor slot
' @local countMax - the longer blocked count run, ms
' @local pStatus - the wheel's status-run address (0: not known, and its count is not mirrored)
' @local nLimiter - duty_capped + foldback_frames this pass
' @local bLimited - a limiter acted since the last pass
' @local bTick - the wheel's driver pos or hwPos changed since the last pass
' @local bRunning - the wheel's mirrored state is SPIN_UP or AT_SPEED, the states the driver's limiter half counts in
' @local eAbsNow - the wheel's |err| this pass
' @local nFold - foldback_frames this pass
' @local bFolded - the fold-back acted since the last pass
' @local bWasFold - the wheel's blkWinFold as the previous pass left it

    whyCode := WHY_NONE
    safetyReset()
    lastPollMs := startMs
    beat(CP_LIB_STEER_QUERY)
    spLaunchPtr[SLOT_LEFT], spStatusPtr[SLOT_LEFT], _ := steering.testLeftGetAbiAddrs()
    spLaunchPtr[SLOT_RIGHT], spStatusPtr[SLOT_RIGHT], _ := steering.testRightGetAbiAddrs()
    beat(CP_LIB_STEER_QUERY)
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        blkLastPos[slotIdx] := instLastPos[slotIdx]
        blkLastHw[slotIdx] := instLastHw[slotIdx]
        blkTickMs[slotIdx] := startMs
        blkCountMs[slotIdx] := 0
        blkLimTick[slotIdx] := FALSE
        blkWinFold[slotIdx] := FALSE
        pStatus := spStatusPtr[slotIdx]
        if pStatus <> 0
            blkLimPrev[slotIdx] := long[pStatus][LG_CAPPED_IDX] + long[pStatus][LG_FOLD_IDX]
            blkFoldPrev[slotIdx] := long[pStatus][LG_FOLD_IDX]
    repeat
        beat(CP_LOOP_POLL)
        waitms(SAMPLE_MS)
        safeEvent := safetyPoll(SIDE_BOTH)
        nowMs := getms()
        countMax := 0
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            pStatus := spStatusPtr[slotIdx]
            bTick := (instLastPos[slotIdx] <> blkLastPos[slotIdx]) or (instLastHw[slotIdx] <> blkLastHw[slotIdx])
            bRunning := (instLastState[slotIdx] == wheelL.DCS_SPIN_UP) or (instLastState[slotIdx] == DCS_AT_SPEED)
            bWasFold := blkWinFold[slotIdx]
            bLimited := FALSE
            bFolded := FALSE
            if pStatus <> 0
                nLimiter := long[pStatus][LG_CAPPED_IDX] + long[pStatus][LG_FOLD_IDX]
                bLimited := (nLimiter <> blkLimPrev[slotIdx])       ' duty_capped + foldback_frames moved since the last pass
                blkLimPrev[slotIdx] := nLimiter
                nFold := long[pStatus][LG_FOLD_IDX]
                bFolded := (nFold <> blkFoldPrev[slotIdx])          ' SRC_REV 81: foldback_frames alone moved (BLKWIN's flag)
                blkFoldPrev[slotIdx] := nFold
            ' bFrontProtect()'s order: a tick, or a state that is not SPIN_UP / AT_SPEED, clears the flag; else a limiter action sets it.
            '  The count's flag takes either limiter; BLKWIN's (T-1's arming) takes the fold-back alone
            if bTick or (bRunning == FALSE)
                blkLimTick[slotIdx] := FALSE
                blkWinFold[slotIdx] := FALSE
            else
                if bLimited
                    blkLimTick[slotIdx] := TRUE
                if bFolded
                    blkWinFold[slotIdx] := TRUE
            if bTick
                blkLastPos[slotIdx] := instLastPos[slotIdx]
                blkLastHw[slotIdx] := instLastHw[slotIdx]
                blkTickMs[slotIdx] := nowMs
                blkCountMs[slotIdx] := 0                    ' a tick restarts the driver's count
            elseif (pStatus <> 0) and ((abs(long[pStatus][LG_ERR_IDX]) >= wheelL.LAG_SOFT) or blkLimTick[slotIdx]) and (bRunning or (instLastState[slotIdx] == DCS_SPIN_DN))
                if blkCountMs[slotIdx] == 0
                    blkCountMs[slotIdx] := nowMs            ' the count's first pass, as the driver would see it
            elseif instLastState[slotIdx] <> DCS_ESTOP
                blkCountMs[slotIdx] := 0                    ' neither condition: the driver's count restarts too
            ' SRC_REV 80 (PL-188): a wheel reading DCS_ESTOP has just been latched, and this pass sees it before the latch
            '  check below: its count is kept as it stood, so blkStandCounts() reads the count that latched (it read 0)
            if blkCountMs[slotIdx] <> 0
                countMax #>= nowMs - blkCountMs[slotIdx]
            if (pStatus <> 0) and bWasFold and blkWinFold[slotIdx]  ' BLKWIN: the fold-back acted a pass ago, and since then no tick
                eAbsNow := abs(long[pStatus][LG_ERR_IDX])
                blkWinN[slotIdx] += 1
                blkWinMax[slotIdx] #>= eAbsNow
                if (eAbsNow >= BLK_WIN_LO_ERR) and (eAbsNow <= BLK_WIN_HI_ERR)
                    blkWinHit[slotIdx] += 1
        if (bBlkReached == FALSE) and bMirrorAllInState(SIDE_BOTH, DCS_AT_SPEED)
            bBlkReached := TRUE
            blkAtMs := nowMs - startMs
        if bSpinGuardTripped()
            blkStopBy := BLKSTOP_OVERTRAVEL                 ' already e-stopped
            whyCode := WHY_OVERTRAVEL
            quit
        if safeEvent <> SAFE_NONE
            blkStopBy := BLKSTOP_ABORT
            whyCode := safeWhy(safeEvent)
            if bSteerUp
                steerStopMotors()
            quit
        eLeftCode, eRightCode := steerProtCodes()
        if (eLeftCode <> NO_ERROR) or (eRightCode <> NO_ERROR)
            bBlkLatched := TRUE
            blkLatchMs := nowMs - startMs
            blkLatchTotal := instTotal
            blkLeftCode := eLeftCode
            blkRightCode := eRightCode
            blkStandCounts(nowMs)
            blkStopBy := BLKSTOP_LATCHED
            quit
        if (nowMs - lastPollMs) >= BLK_POLL_MS
            lastPollMs := nowMs
            beat(CP_LIB_STEER_QUERY)
            leftPower, rightPower := steering.getPower()
            beat(CP_LIB_STEER_QUERY)
            if (leftPower == 0) or (rightPower == 0)
                eLeftCode, eRightCode := steerProtCodes()   ' a latch zeroes getPower() too: it is the next pass's
                if (eLeftCode == NO_ERROR) and (eRightCode == NO_ERROR)
                    blkStopBy := BLKSTOP_LIMIT              ' the leg's own stop fired: the obstacle was not met
                    blkWhy := WHY_NOT_BLOCKED
                    quit
        if bBlkReached and (countMax >= BLK_NOLATCH_MS)
            blkStandCounts(nowMs)
            blkStopBy := BLKSTOP_NO_LATCH
            steerStopMotors()                               ' not latched: the harness ends the stall itself
            quit
        if (nowMs - startMs) >= FL_LEG_MS
            blkStopBy := BLKSTOP_TIMEOUT
            blkWhy := WHY_STOP_TIMEOUT
            steerStopMotors()
            quit

PRI blkStandCounts(nowMs) | slotIdx
' Take each wheel's two readings at the latch, or at the harness's stop: its stand still (last hall tick to now) and its
' blocked count's run (the count's first pass to now; 0 when no count was running).
'
' @param nowMs - getms() of the pass that saw the latch or ended the drive
'
' @local slotIdx - motor slot

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        blkStandMs[slotIdx] := nowMs - blkTickMs[slotIdx]
        blkCountRunMs[slotIdx] := 0
        if blkCountMs[slotIdx] <> 0
            blkCountRunMs[slotIdx] := nowMs - blkCountMs[slotIdx]

PRI blockChecks() | eLeftCode, eRightCode, remainTicks
' Once latched (the floor situations' CON, 1., steps 2 and 3): BLK_PH_SETTLE_MS, then the phase window's two ring
' totals; the stop reasons; a drive while latched (one wrongly taken is stopped at once); clearEmergency(), which must
' not release it, and the codes after it; clearProtectiveStop(), which must, and the codes after it; what is left of the
' leg armed (stopAfterRotation()), then a drive after the clear, stopped at once.
'
' @local eLeftCode - the left wheel's protective code
' @local eRightCode - the right wheel's
' @local remainTicks - what is left of the leg on the farther wheel, ticks, at least one

    waitBeat(BLK_PH_SETTLE_MS, CP_LOOP_REST)
    blkWinStart := instTotal
    waitBeat(BLK_PH_WIN_MS, CP_LOOP_WINDOW)
    blkWinEnd := instTotal
    beat(CP_LIB_STEER_QUERY)
    blkLeftSr, blkRightSr := steering.getStopReason()
    beat(CP_LIB_STEER_QUERY)
    bBlkSrRead := TRUE
    beat(CP_LIB_STEER_DRIVE)                                ' 1. refused while latched: nothing is written
    blkRefuseErr := steering.driveAtPower(BLK_POWER, BLK_POWER)
    beat(CP_LIB_STEER_DRIVE)
    if blkRefuseErr == NO_ERROR
        steerStopMotors()                                   ' taken when it must not be: stopped at once
    beat(CP_LIB_ESTOP)                                      ' 2. the e-stop clear must NOT release it
    blkEstClrErr := steering.clearEmergency()
    beat(CP_LIB_ESTOP)
    eLeftCode, eRightCode := steerProtCodes()
    bBlkEstHeld := (eLeftCode <> NO_ERROR) and (eRightCode <> NO_ERROR)
    beat(CP_LIB_ESTOP)                                      ' 3. the protective clear must
    blkClrErr := steering.clearProtectiveStop()
    beat(CP_LIB_ESTOP)
    eLeftCode, eRightCode := steerProtCodes()
    bBlkClrOk := (eLeftCode == NO_ERROR) and (eRightCode == NO_ERROR)
    remainTicks := (FL_LEG_TICKS - flTravelMax()) #> 1      ' 4. the rest of the leg armed, then a drive is taken again:
    beat(CP_LIB_STEER_DRIVE)                                '  stopped at once, the obstacle still there
    blkArm2Err := steering.stopAfterRotation(remainTicks, steering.DRU_HALL_TICKS)
    beat(CP_LIB_STEER_DRIVE)
    blkAgainErr := blkArm2Err
    if blkArm2Err == NO_ERROR
        beat(CP_LIB_STEER_DRIVE)
        blkAgainErr := steering.driveAtPower(BLK_POWER, BLK_POWER)
        beat(CP_LIB_STEER_DRIVE)
    steerStopMotors()
    bBlkApiRan := TRUE

PRI blockJudge() | slotIdx, startJ, endJ, nHeld, nBad
' An OBSTACLE trial's readings from the frozen ring (I10): each wheel's phase-sum mean over the phase window
' (windowStats()); HELDATSPD over BOTH wheels' drive, from the command's mark to the latch (to the capture's end when it
' did not latch).
'
' @local slotIdx - motor slot
' @local startJ - the mark's logical index
' @local endJ - the latch's, or the capture's last
' @local nHeld - one wheel's held samples
' @local nBad - one wheel's bad ones

    if bBlkFrozen and bBlkDriven
        if bBlkLatched
            repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                windowStats(slotIdx, SLOT_RIGHT - slotIdx, blkWinStart, blkWinEnd)
                blkPhX10[slotIdx] := rsPhMeanX10
                blkPhN[slotIdx] := rsN
        drainBegin()
        startJ := ringIndex(blkMarkTotal)
        endJ := drStored - 1
        if bBlkLatched
            endJ := ringIndex(blkLatchTotal - 1)
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            nHeld, nBad := heldAtSpeed(slotIdx, startJ, endJ)
            blkHeldN += nHeld
            blkHeldBad += nBad

PRI blockLimit() | logIdx, nBlockedMs, bBlockedSeen
' SRC_REV 75 (BLKLIMIT): right after the OBSTACLE drain, which the drive back's drain would replace, whether the BRAKE trial's
' fold-back engaged BEFORE its protective stop latched. Judged only on the BRAKE trial (the solid object; the COAST trial's
' stand yields), once it met the obstacle (it latched, or its count ran BLK_NOLATCH_MS without), with a drain
' that read whole (bEvdClean()): a drain that may have dropped the engage cannot show it absent. The latch is the EARLIEST
' EV_STOP with reason SR_BLOCKED in either wheel's log; the engage is any wheel's first EV_FOLDBACK with value 0, stamped before it
' (getms() differences, wrap-safe). A trial that never latched has no such stop, so its engage is not "before" anything: FALSE.
'
' @local logIdx - EVI_LEFT or EVI_RIGHT
' @local nBlockedMs - the earliest blocked stop's stamp
' @local bBlockedSeen - an SR_BLOCKED stop was read

    bBlkLimJudged := FALSE
    bBlkFoldFirst := FALSE
    if (blkKind == BLK_BRAKE) and ((blkStopBy == BLKSTOP_LATCHED) or (blkStopBy == BLKSTOP_NO_LATCH)) and bEvdClean()
        bBlkLimJudged := TRUE
        bBlockedSeen := FALSE
        nBlockedMs := 0
        repeat logIdx from EVI_LEFT to EVI_RIGHT
            if bEvdBlocked[logIdx]
                if (bBlockedSeen == FALSE) or ((evdBlockedMs[logIdx] - nBlockedMs) < 0)
                    nBlockedMs := evdBlockedMs[logIdx]
                bBlockedSeen := TRUE
        if bBlockedSeen
            repeat logIdx from EVI_LEFT to EVI_RIGHT
                if bEvdFold[logIdx] and ((evdFoldMs[logIdx] - nBlockedMs) < 0)
                    bBlkFoldFirst := TRUE

PRI blockFault() | logIdx
' SRC_REV 77 (BLKFLT): right after the OBSTACLE drain, which the drive back's drain would replace, each wheel's EV_FAULT and
' EV_FAULT_RESYNC counts over the trial's lifetime, and whether the drain read whole (bEvdClean(): a drain that may have
' dropped an event cannot show a fault absent). A log's index is its wheel's slot (EVI_LEFT is SLOT_LEFT, EVI_RIGHT SLOT_RIGHT).
'
' @local logIdx - EVI_LEFT or EVI_RIGHT

    bBlkEvRead := bEvdClean()
    repeat logIdx from EVI_LEFT to EVI_RIGHT
        blkFltN[logIdx] := evCount(logIdx, wheelL.EV_FAULT)
        blkRsyN[logIdx] := evCount(logIdx, wheelL.EV_FAULT_RESYNC)

PRI blockFold() | bBad, slotIdx, eReason, nBlocked, bWinOpen, bFltJudged, bFltBad
' Fold one OBSTACLE trial into its cells (the floor situations' CON, 1.): BLKSTOP when it latched or a wheel stood
' BLK_NOLATCH_MS unlatched; PROTCLR when the API sequence ran; BLKCOAST or BLKSHORT per wheel by the trial's kind when
' its phase window was read; HELDATSPD's two counts from its drive. SRC_REV 77: BLKWIN when a wheel's window opened (a
' limiter acted with no tick since, blockWatch()) and BLKFLT when the trial met the obstacle, each with the why it is
' not measured for (blkWinWhy, blkFltWhy: BM-BLKWIN prints them). A stand is judged against its upper bound only when
' its wheel's last tick came after both read AT_SPEED (the bound assumes the commanded field rate). SRC_REV 81: a BLKWIN window is
' a fold-back's (blkWinFold), not any limiter's. SRC_REV 75: and BLKLIMIT
' (blockLimit() staged its events): bad unless the trial latched, the fold-back engaged first, and every SR_BLOCKED wheel's stand
' lay inside BLKSTOP's own band (BLK_STAND_LO_MS .. BLK_STAND_HI_MS, the upper end only when its last tick followed AT_SPEED), one at least.
'
' @local bBad - T/F where T means the trial fails the cell
' @local slotIdx - motor slot
' @local eReason - one wheel's SR_*
' @local nBlocked - wheels reading SR_BLOCKED
' @local bWinOpen - a wheel's BLKWIN window opened
' @local bFltJudged - the trial is judged for BLKFLT
' @local bFltBad - ...and it failed: it did not latch, or a wheel logged a fault or a resync

    ' SRC_REV 77 (PL-179): BLKSTOP also judges a trial that met the obstacle at AT_SPEED and then neither latched nor stood
    '  BLK_NOLATCH_MS -- the harness's timeout or an abort (a fault) -- as a FAIL: that is the 2026-10-02 COAST trial
    '  (stop_by TIMEOUT after 9.2 s), the cell's own negative, which it read as NOMEAS before. A trial whose leg ended on
    '  its own limit or overtravel never met the obstacle, and an operator's stop is not the drive's: both stay unjudged
    if bBlkDriven and ((blkStopBy == BLKSTOP_LATCHED) or (blkStopBy == BLKSTOP_NO_LATCH) or (bBlkReached and (blkStopBy <> BLKSTOP_LIMIT) and (blkStopBy <> BLKSTOP_OVERTRAVEL) and (blkStopBy <> BLKSTOP_OPERATOR)))
        sfBlkN := (sfBlkN + 1) <# LIM_SMALL
        bBlkStopJudged := TRUE
        bBad := (blkStopBy <> BLKSTOP_LATCHED) or (bBlkSrRead == FALSE)
        bBad := bBad or (blkLeftCode <> ERR_PLATFORM_BLOCKED) or (blkRightCode <> ERR_PLATFORM_BLOCKED)
        nBlocked := 0
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            eReason := blkLeftSr
            if slotIdx == SLOT_RIGHT                        ' if/else, never `? :` -- PL-29, PL-76
                eReason := blkRightSr
            if eReason == wheelL.SR_BLOCKED
                nBlocked += 1
                ' SRC_REV 76: the stand still can be no shorter than the count, and the count must have run
                '  BLOCKED_PASSES, one stamp each way (BLK_COUNT_LO_MS's CON) -- a count the harness never saw begin
                '  reads 0 and fails, as a latch the driver's own rule cannot explain must
                bBad := bBad or (blkStandMs[slotIdx] < BLK_STAND_LO_MS)
                bBad := bBad or (blkCountRunMs[slotIdx] < BLK_COUNT_LO_MS) or (blkCountRunMs[slotIdx] > BLK_COUNT_HI_MS)
            elseif eReason <> wheelL.SR_PARTNER
                bBad := TRUE
        bBad := bBad or (nBlocked == 0)
        bBlkStopBad := bBad                                ' SRC_REV 74: this trial's own verdict, for its RESULT line
        if bBad
            sfBlkBad := (sfBlkBad + 1) <# LIM_SMALL
    if bBlkLimJudged                                        ' SRC_REV 75: BLKLIMIT, the BRAKE trial's own
        bSfBlkLimRan := TRUE
        bBad := (bBlkFoldFirst == FALSE) or (blkStopBy <> BLKSTOP_LATCHED) or (bBlkSrRead == FALSE)
        nBlocked := 0
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            eReason := blkLeftSr
            if slotIdx == SLOT_RIGHT                        ' if/else, never `? :` -- PL-29, PL-76
                eReason := blkRightSr
            if eReason == wheelL.SR_BLOCKED
                nBlocked += 1
                bBad := bBad or (blkStandMs[slotIdx] < BLK_STAND_LO_MS)
                bBad := bBad or (blkCountRunMs[slotIdx] < BLK_COUNT_LO_MS) or (blkCountRunMs[slotIdx] > BLK_COUNT_HI_MS)
        bBad := bBad or (nBlocked == 0)
        bSfBlkLimOk := (bBad == FALSE)
    ' SRC_REV 77: BLKWIN (I-9). Measured when a wheel's window opened; the verdict ANDs over the trials of the run
    blkWinWhy := WHY_NONE
    bWinOpen := (blkWinN[SLOT_LEFT] > 0) or (blkWinN[SLOT_RIGHT] > 0)
    if bBlkDriven == FALSE
        blkWinWhy := blkWhy
    elseif bWinOpen == FALSE
        blkWinWhy := WHY_NO_LIMITER
        if blkStopBy == BLKSTOP_LIMIT                       ' the leg's own stop fired first: the obstacle was not met
            blkWinWhy := WHY_NOT_BLOCKED
    else
        if bSfBlkWinRan == FALSE
            bSfBlkWinOk := TRUE
        bSfBlkWinRan := TRUE
        bSfBlkWinOk := bSfBlkWinOk and (blkWinHit[SLOT_LEFT] == 0) and (blkWinHit[SLOT_RIGHT] == 0)
    ' SRC_REV 77: BLKFLT. Measured when both wheels met the obstacle at AT_SPEED: the trial that did not latch fails, one that
    '  latched fails on any EV_FAULT or EV_FAULT_RESYNC of either wheel, and its drain must have read whole to say none
    blkFltWhy := WHY_NONE
    bFltJudged := FALSE
    bFltBad := FALSE
    if bBlkDriven == FALSE
        blkFltWhy := blkWhy
    elseif (blkStopBy == BLKSTOP_LIMIT) or (blkStopBy == BLKSTOP_OVERTRAVEL)
        blkFltWhy := WHY_NOT_BLOCKED
    elseif bBlkReached == FALSE
        blkFltWhy := WHY_NOT_REACHED
    elseif blkStopBy <> BLKSTOP_LATCHED
        bFltJudged := TRUE
        bFltBad := TRUE
    elseif bBlkEvRead == FALSE
        blkFltWhy := WHY_EVENTS_LOST
    else
        bFltJudged := TRUE
        bFltBad := (blkFltN[SLOT_LEFT] + blkFltN[SLOT_RIGHT] + blkRsyN[SLOT_LEFT] + blkRsyN[SLOT_RIGHT]) > 0
    if bFltJudged
        if bSfBlkFltRan == FALSE
            bSfBlkFltOk := TRUE
        bSfBlkFltRan := TRUE
        bSfBlkFltOk := bSfBlkFltOk and (bFltBad == FALSE)
    if bBlkApiRan
        sfClrN := (sfClrN + 1) <# LIM_SMALL
        bBad := (blkRefuseErr <> ERR_PLATFORM_BLOCKED) or (bBlkEstHeld == FALSE)
        bBad := bBad or (blkClrErr <> NO_ERROR) or (bBlkClrOk == FALSE) or (blkAgainErr <> NO_ERROR)
        bBlkClrBad := bBad                                  ' SRC_REV 74: this trial's own verdict, for its RESULT line
        if bBad
            sfClrBad := (sfClrBad + 1) <# LIM_SMALL
    if bBlkLatched and bBlkFrozen
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            if blkPhN[slotIdx] > 0
                if blkKind == BLK_COAST
                    bSfBlkCoast[slotIdx] := TRUE
                    sfBlkCoastMv[slotIdx] := blkPhX10[slotIdx] / X10
                else
                    bSfBlkShort[slotIdx] := TRUE
                    sfBlkShortMv[slotIdx] := blkPhX10[slotIdx] / X10
    if bBlkFrozen and bBlkDriven
        sfHeldN := (sfHeldN + blkHeldN) <# LIM_SMALL
        sfHeldBad := (sfHeldBad + blkHeldBad) <# LIM_SMALL

#endif

#ifdef DBF_GRAB
PRI segLoad() | whyCode
' GRAB ONE SIDE (part SPIN; SRC_REV 62, the second floor situation; SRC_REV 58's LOAD): the floor situations' CON, 2.
' SRC_REV 69: ONE trial, straight after the lead-in (R4: a repeat is a rerun, never a loop inside the test). The trial
' prints its own BM-LOAD with its outcome or its cause, and the RESULT line says what to do next run.
'
' @local whyCode - why the segment ended short, WHY_NONE when the trial ran

    segBegin(SEG_GRAB)
    whyCode := loadTrial()
    ldSegWhy := whyCode
    ' if/else, never `? :` (PL-29): segWhy() is a call
    if whyCode <> WHY_NONE
        segEnd(whyCode)
    else
        segEnd(segWhy())

PRI loadTrial() : whyCode | tid
' The GRAB trial (the floor situations' CON, 2.): the steering start, the lowered limits and the capture; the drive out,
' the grab and on to the limit (loadDrive()); the capture frozen, what the driver reports read, the limits restored,
' the event log drained EV_SETTLE_MS on (the path limiter's engages, LDHUNT); the lifetime stopped; its judgement and
' fold, its trace, BM-LOAD, BM-LOADW and BM-SR. SRC_REV 69: the run ends at the 1 m stop -- no drive back and no
' BACK step; he returns the platform by hand.
'
' @returns whyCode - WHY_NONE when the trial ran, else why it did not
'
' @local tid - trace id

    ldReset()
    tid := nextTraceId()
    cpReset()
    if bRunContinue(SEG_GRAB) == FALSE
        whyCode := WHY_ABORTED
    elseif bSteerStart(SEG_GRAB) == FALSE
        whyCode := WHY_NO_COG
        if bSteerUp
            steerStop()
    else
        whyCode := WHY_NONE
        ldSid := steerLife
        ldLimErr := steerSetLimits(LOAD_LIMIT_A, LOAD_LIMIT_A)
        if ldLimErr <> NO_ERROR
            whyCode := WHY_LIMIT_REFUSED
        elseif bInstArm(INST_SRC_STEER, LOAD_DECIM) == FALSE
            whyCode := WHY_INST_NOACK
        else
            whyCode := loadDrive(tid)
            bLdFrozen := bInstFreeze(0)
        if bSteerUp
            loadReadAfter()
            steerSetLimits(wheelL.I_PEAK_A, wheelL.I_CONT_A)    ' I11: the library's own, before the stop
            if bLdDriven
                waitBeat(EV_SETTLE_MS, CP_LOOP_REST)
                evdSinceMs := ldWinAtMs
                evdUntilMs := ldWinEndMs
                evdFltSinceMs := ldGrabAtMs                 ' SRC_REV 81: LDFLT's faults are counted from the grab point
                evDrain(EVSRC_STEER, EVST_GRAB)
                ldFlips, ldEngPre, bLdEngaged := loadEngages()
                loadEvents()
            steerStop()
    if ldWhy == WHY_NONE
        ldWhy := whyCode
    loadJudge()
    loadFold()
    if bLdDriven
        emitSTrace(tid, SEG_GRAB, CAUSE_DRAG, LOAD_POWER, LOAD_POWER, TRUE, 0, MODE_FLOAT, ldWhy)
        if bLdFrozen
            bTraceDrain(tid, SLOT_LEFT, SLOT_RIGHT, TEND_FROZEN)
        else
            traceEmptyEnd(tid, TEND_ABORT, ldWhy)
    emitLoad()
    emitLoadW()
    emitLdFlt()                                             ' SRC_REV 81: after the fold, which settles the three cells' whys it prints
    if bLdDriven
        emitSr(EVST_GRAB, SIDE_LEFT, ldLeftSr, ldRightSr, bLdSrRead, bLdSrRead)
    bInstLagExempt := FALSE
    segItems := (segItems + 1) <# LIM_SMALL

PRI ldReset() | slotIdx
' Clear the GRAB trial's staging.
'
' @local slotIdx - motor slot

    ldSid := 0
    ldWhy := WHY_NONE
    ldOutcome := LDO_NOT_RUN
    ldStopBy := LDSTOP_NOT_RUN
    ldLimErr := NO_ERROR
    ldArmErr := NO_ERROR
    ldDriveErr := NO_ERROR
    bLdDriven := FALSE
    bLdReached := FALSE
    ldAtMs := 0
    bLdGrabbed := FALSE
    ldGrabMs := 0
    bLdOvertravel := FALSE
    bLdStopBegan := FALSE
    bLdLatched := FALSE
    bLdFault := FALSE
    ldWinStart := -1
    ldWinEnd := -1
    ldWinMs := 0
    bLdWinValid := FALSE
    ldPolls := 0
    ldPathMin := wheelL.PERMILLE_FULL
    ldPredX10 := 1
    ldLeftCode := NO_ERROR
    ldRightCode := NO_ERROR
    ldLeftCause := wheelL.FC_NONE
    ldRightCause := wheelL.FC_NONE
    ldLeftSr := wheelL.SR_NONE
    ldRightSr := wheelL.SR_NONE
    bLdSrRead := FALSE
    ldFlips := 0
    ldEngPre := 0
    bLdEngaged := FALSE
    ldWinAtMs := 0
    ldWinEndMs := 0
    bLdFrozen := FALSE
    ldMisPm := 0
    ldHeldN := 0
    ldHeldBad := 0
    ldGrabAtMs := 0                                         ' SRC_REV 81 (PL-189)
    bLdEvRead := FALSE
    bLdFoldHeld := FALSE
    ldFoldIn := 0
    bLdFoldPre := FALSE
    ldFltWhy := WHY_NOT_REACHED
    ldHoldWhy := WHY_NOT_REACHED
    ldPathWhy := WHY_NOT_REACHED
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        ldShort[slotIdx] := 0
        ldTicks[slotIdx] := 0
        ldPct[slotIdx] := 0
        ldGapMs[slotIdx] := 0
        ldFltN[slotIdx] := 0
        ldRsyN[slotIdx] := 0

PRI loadDrive(tid) : whyCode | startMs, winStartMs, safeEvent, bReached
' A GRAB trial's motion (the floor situations' CON, 2.; SRC_REV 63: GRAB's alone, the incline's overloaded climb
' removed): the guard's zero and the leg's travel (flLegBegin()); the leg's own distance stop ARMED BEFORE IT MOVES (a
' refused one and it is never driven); SYNC_PRECOND; the mark, driveAtPower(LOAD_POWER, LOAD_POWER); both AT_SPEED; on to
' the grab point (UNTIL_TRAVEL); LOAD_PULL_LEAD_MS; the LOAD_WIN_MS window, the path limiter polled; on to the leg's limit,
' both wheels STOPPED, within LOAD_LEG_MS (SRC_REV 69: the bound covers a held drive, the last 0.6 m at about half speed,
' which FL_LEG_MS would cut); its end (loadEnd()); rest. No cue is printed: the window lies inside his hold (the CON). The
' load is provoked on purpose, so the LAGBOUND samples are exempt.
'
' @param tid - trace id
' @returns whyCode - WHY_NONE, or why the segment must end
'
' @local startMs - getms() at the command
' @local winStartMs - getms() at the window's start
' @local safeEvent - SAFE_* that ended a watch
' @local bReached - the watched wait reached what it waited for

    whyCode := WHY_NONE
    safeEvent := SAFE_NONE
    bInstLagExempt := TRUE
    ldPredX10 := abs(predictX10(spinIncre(LOAD_POWER))) #> 1
    waitBeat(SPIN_MIRROR_MS, CP_LOOP_READY)                 ' the mirror refreshes on the instrument's next passes
    flLegBegin(LOAD_TRAVEL_TICKS)
    beat(CP_LIB_STEER_DRIVE)
    ldArmErr := steering.stopAfterDistance(LOAD_TRAVEL_MM, steering.DDU_MM)
    beat(CP_LIB_STEER_DRIVE)
    if ldArmErr <> NO_ERROR
        whyCode := WHY_LIMIT_REFUSED
    elseif bSteerDrivePrecondition(curSeg, tid) == FALSE
        whyCode := WHY_SYNC_PRECOND
    else
        instMarkIndex()                                     ' the mark PRECEDES the command
        curIncre := 0
        startMs := getms()
        beat(CP_LIB_STEER_DRIVE)
        ldDriveErr := steering.driveAtPower(LOAD_POWER, LOAD_POWER)
        beat(CP_LIB_STEER_DRIVE)
        bLdDriven := TRUE
        if ldDriveErr <> NO_ERROR
            whyCode := WHY_SYNC_PRECOND
            ldStopBy := LDSTOP_ABORT
            steerStopMotors()
        else
            safeEvent, bReached := loadWatch(UNTIL_AT_SPEED, LOAD_ATSPEED_MS, FALSE)
            if bReached
                bLdReached := TRUE
                ldAtMs := getms() - startMs
            if bLoadGoing(safeEvent)
                spTravelMark := LOAD_GRAB_TICKS
                safeEvent, bReached := loadWatch(UNTIL_TRAVEL, LOAD_GRAB_WAIT_MS, FALSE)
                if bLoadGoing(safeEvent) and bReached
                    bLdGrabbed := TRUE
                    ldGrabMs := getms() - startMs
                    ldGrabAtMs := startMs + ldGrabMs        ' SRC_REV 81: LDFLT counts faults from the grab point
                    safeEvent, _ := loadWatch(UNTIL_TIME, LOAD_PULL_LEAD_MS, FALSE)
            if bLoadGoing(safeEvent) and bLdGrabbed
                ldWinStart := instTotal
                winStartMs := getms()
                safeEvent, _ := loadWatch(UNTIL_TIME, LOAD_WIN_MS, TRUE)
                ldWinEnd := instTotal
                ldWinMs := getms() - winStartMs
                ldWinAtMs := winStartMs                     ' SRC_REV 70: LDHUNT counts the path limiter's transitions in these stamps
                ldWinEndMs := winStartMs + ldWinMs
                ' the distance stop firing ends the window where its ramp-down begins, so what came before still counts
                bLdWinValid := (safeEvent == SAFE_NONE) and (bSpOvertravel == FALSE) and (bLdLatched == FALSE) and (ldWinMs >= LOAD_WIN_MS / 2)
            bReached := FALSE
            if (safeEvent == SAFE_NONE) and (bSpOvertravel == FALSE) and (bLdLatched == FALSE)
                safeEvent, bReached := loadWatch(UNTIL_STOPPED, (LOAD_LEG_MS - (getms() - startMs)) #> SAMPLE_MS, FALSE)
            whyCode := loadEnd(safeEvent, bReached)
        waitRest(SIDE_BOTH, STOP_TIMEOUT_MS, FALSE)

PRI loadWatch(untilKind, boundMs, bPoll) : safeEvent, bReached | startMs, lastPollMs
' A loaded trial's watched wait, every SAMPLE_MS: the safety read on both wheels, THE TRAVEL GUARD (bSpinGuardTripped(),
' SRC_REV 62: every floor leg's), and every LOAD_POLL_MS the protective codes and getPower() (loadPoll(): a latch, or a
' power the harness did not zero -- the distance stop -- ends a timed wait) and with bPoll the path limiter. The path
' scale is never read as a stop: a scaled wheel ramps down to a slower target and reads DCS_SPIN_DN while its command,
' and getPower(), stand. SRC_REV 69: no panel heartbeat, no STOP and no speed digits.
'
' @param untilKind - UNTIL_TIME, UNTIL_AT_SPEED, UNTIL_TRAVEL (spTravelMark) or UNTIL_STOPPED (the leg's end, which the
'   distance stop's firing does not end)
' @param boundMs - the wait's bound
' @param bPoll - TRUE to read the path limiter
' @returns safeEvent - SAFE_* that ended the wait, SAFE_NONE otherwise
' @returns bReached - the state was reached; UNTIL_TIME: the whole bound ran with nothing ending it
'
' @local startMs - getms() when the wait began
' @local lastPollMs - getms() of the last poll

    safetyReset()
    safeEvent := SAFE_NONE
    bReached := FALSE
    startMs := getms()
    lastPollMs := startMs - LOAD_POLL_MS
    repeat
        beat(CP_LOOP_POLL)
        waitms(SAMPLE_MS)
        safeEvent := safetyPoll(SIDE_BOTH)
        if bSpinGuardTripped()
            bLdOvertravel := TRUE
            quit
        if (getms() - lastPollMs) >= LOAD_POLL_MS
            lastPollMs := getms()
            loadPoll(bPoll)
        if untilKind == UNTIL_AT_SPEED
            bReached := bMirrorAllInState(SIDE_BOTH, DCS_AT_SPEED)
        elseif untilKind == UNTIL_TRAVEL
            bReached := (flTravelMax() >= spTravelMark)
        elseif untilKind == UNTIL_STOPPED
            bReached := bMirrorAllInState(SIDE_BOTH, DCS_STOPPED)
        if (safeEvent <> SAFE_NONE) or bReached or bLdLatched or ((getms() - startMs) >= boundMs)
            quit
        if bLdStopBegan and (untilKind <> UNTIL_STOPPED)
            quit
    if untilKind == UNTIL_TIME
        bReached := bLoadGoing(safeEvent)

PRI bLoadGoing(safeEvent) : bGoing
' Whether a loaded drive is still running as the harness drives it: no safety event, no travel guard, no latch, and its
' distance stop not fired.
'
' @param safeEvent - SAFE_* the last watch ended on
' @returns bGoing - T/F where T means the next phase may run

    bGoing := (safeEvent == SAFE_NONE) and (bLdOvertravel == FALSE) and (bLdLatched == FALSE) and (bLdStopBegan == FALSE)

PRI loadPoll(bPoll) | eLeftCode, eRightCode, leftPower, rightPower, scalePm, bLeftShort, bRightShort
' One LOAD poll: both protective codes (either set is a latch: a protective stop secures both wheels) or else
' getPower() (either zero, unasked, is the distance stop); with bPoll the path limiter's scale and each wheel's SHORT.
'
' @param bPoll - TRUE to read the path limiter
'
' @local eLeftCode - the left wheel's protective code
' @local eRightCode - the right wheel's
' @local leftPower - the left wheel's getPower()
' @local rightPower - the right wheel's
' @local scalePm - testGetPathScale(), thousandths
' @local bLeftShort - T/F where T means the left wheel's lag limiter held lately
' @local bRightShort - the right wheel's

    eLeftCode, eRightCode := steerProtCodes()
    if (eLeftCode <> NO_ERROR) or (eRightCode <> NO_ERROR)
        bLdLatched := TRUE
    else
        beat(CP_LIB_STEER_QUERY)
        leftPower, rightPower := steering.getPower()
        beat(CP_LIB_STEER_QUERY)
        if (leftPower == 0) or (rightPower == 0)
            bLdStopBegan := TRUE
    if bPoll
        beat(CP_LIB_STEER_QUERY)
        scalePm := steering.testGetPathScale()
        _, _, bLeftShort, _, _, _ := steering.testLeftGetDriveFollow()
        _, _, bRightShort, _, _, _ := steering.testRightGetDriveFollow()
        beat(CP_LIB_STEER_QUERY)
        ldPathMin <#= scalePm
        if bLeftShort <> FALSE
            ldShort[SLOT_LEFT] := (ldShort[SLOT_LEFT] + 1) <# LIM_SMALL
        if bRightShort <> FALSE
            ldShort[SLOT_RIGHT] := (ldShort[SLOT_RIGHT] + 1) <# LIM_SMALL
        ldPolls := (ldPolls + 1) <# LIM_SMALL

PRI loadEnd(safeEvent, bAtLimit) : whyCode
' Classify how a GRAB trial's drive ended and take the stop it calls for: the travel guard (already shorted), the
' abort or a stalled instrument, a fault (the platform policy is stopping the other wheel), the protective stop (it has
' secured both), its own end at its limit, or its bound (LOAD_LEG_MS). A fault and a latch are readings (the trial is
' judged, or STALLED) and do not end the segment.
'
' @param safeEvent - SAFE_* the last watch ended on
' @param bAtLimit - both wheels read STOPPED at the leg's end
' @returns whyCode - WHY_NONE, or why the segment must end

    whyCode := WHY_NONE
    if bLdOvertravel
        ldStopBy := LDSTOP_OVERTRAVEL
        whyCode := WHY_OVERTRAVEL
    elseif (safeEvent == SAFE_ABS_ABORT) or (safeEvent == SAFE_INST_STALL)
        ldStopBy := LDSTOP_ABORT
        whyCode := safeWhy(safeEvent)
    elseif safeEvent == SAFE_FAULT
        ldStopBy := LDSTOP_FAULT
        bLdFault := TRUE
        ldWhy := WHY_FAULTED
    elseif bLdLatched
        ldStopBy := LDSTOP_BLOCKED
    elseif bAtLimit
        ldStopBy := LDSTOP_LIMIT
    else
        ldStopBy := LDSTOP_TIMEOUT
        whyCode := WHY_STOP_TIMEOUT
    if bSteerUp and (ldStopBy <> LDSTOP_FAULT) and (ldStopBy <> LDSTOP_BLOCKED) and (ldStopBy <> LDSTOP_LIMIT)
        steerStopMotors()

PRI loadReadAfter()
' What the driver reports once a LOAD drive has ended, while the lifetime is up: both protective codes (a latch the
' polls missed counts), each wheel's fault cause since start (any cause is a fault in this trial) and its stop reason.

    beat(CP_LIB_STEER_QUERY)
    ldLeftCode, ldRightCode := steering.getProtectiveStop()
    ldLeftCause, ldRightCause := steering.getFaultCause()
    ldLeftSr, ldRightSr := steering.getStopReason()
    beat(CP_LIB_STEER_QUERY)
    bLdSrRead := TRUE
    if (ldLeftCode <> NO_ERROR) or (ldRightCode <> NO_ERROR)
        bLdLatched := TRUE
    if (ldLeftCause <> wheelL.FC_NONE) or (ldRightCause <> wheelL.FC_NONE)
        bLdFault := TRUE

PRI loadEngages() : nFlips, nEngagesPre, bEngaged
' The path limiter's reading of the last drain (EV_PATH_LIMIT: an engage is a value under PERMILLE_FULL, a release is
' PERMILLE_FULL), either wheel's log, against the judged window (evdSinceMs .. evdUntilMs, set from ldWinAtMs and
' ldWinEndMs before the drain): evDrain() counted each event against its own stamp. SRC_REV 70: LDHUNT judges CYCLING
' under a sustained hold (PL-144), so the value is the TRANSITIONS inside the window; the engages before it (the free
' start-up's, the limiter matching two wheels that start unevenly) are printed beside it, not judged. The precondition is
' that the limiter is engaged over the window: a wheel's last event before it was an engage, or one occurs inside it
' (a release needs a prior engage, so any transition with none before is an engage).
'
' SRC_REV 82 (PL-192): a wheel's first engage inside the window, found released, is the onset and is not counted.
'
' @returns nFlips - the transitions, engages and releases, stamped inside the window, less each wheel's onset
' @returns nEngagesPre - the engages stamped before it
' @returns bEngaged - T/F where T means the limiter was engaged over the window (FALSE when there was no window)

    nFlips := evdPathIn
    nEngagesPre := evdPathPre
    bEngaged := bLdWinValid and (evdPathEng[EVI_LEFT] or evdPathEng[EVI_RIGHT] or evdPathOn[EVI_LEFT] or evdPathOn[EVI_RIGHT] or (evdPathIn > 0))

PRI loadEvents() | slotIdx
' SRC_REV 81 (PL-189): what the last GRAB drain read for LDFLT and LDPATH's premise -- whether it read whole, each wheel's EV_FAULT and
' EV_FAULT_RESYNC counts from the grab point (evdFltSinceMs was set to ldGrabAtMs), and the gripped wheel's fold-back against the judged
' window: engaged at its start (its last EV_FOLDBACK before the window was an engage, value 0) or an EV_FOLDBACK inside it. A log's
' index is its wheel's slot (EVI_LEFT is SLOT_LEFT, EVI_RIGHT SLOT_RIGHT).
'
' @local slotIdx - motor slot

    bLdEvRead := bEvdClean()
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        ldFltN[slotIdx] := evdFltAfter[EVI_LEFT + slotIdx]
        ldRsyN[slotIdx] := evdRsyAfter[EVI_LEFT + slotIdx]
    ldFoldIn := evdFoldIn[EVI_LEFT + LOAD_GRIP_SLOT]
    bLdFoldPre := bEvdFoldPre[EVI_LEFT + LOAD_GRIP_SLOT]
    bLdFoldHeld := bLdFoldPre or (ldFoldIn > 0)

PRI loadJudge() | slotIdx, startJ, endJ, largerTicks, nHeld, nBad
' A loaded trial's readings from the frozen ring (I10), over its window: each wheel's hall ticks on the instrument's own
' decode and that as a percentage of the command's predicted rate (windowStats()); the mismatch; each wheel's longest
' tick gap; and HELDATSPD over both wheels.
'
' @local slotIdx - motor slot
' @local startJ - the window's first logical index
' @local endJ - its last
' @local largerTicks - the farther wheel's ticks
' @local nHeld - one wheel's held samples
' @local nBad - one wheel's bad ones

    if bLdFrozen and bLdDriven and (ldWinStart >= 0) and (ldWinEnd > ldWinStart)
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            windowStats(slotIdx, SLOT_RIGHT - slotIdx, ldWinStart, ldWinEnd)
            ldTicks[slotIdx] := abs(rsHwTicks)
            if rsWinMs > 0
                ldPct[slotIdx] := (ldTicks[slotIdx] * MS_PER_SEC * X10 * LOAD_PCT_SCALE) / (rsWinMs * ldPredX10)
        largerTicks := ldTicks[SLOT_LEFT] #> ldTicks[SLOT_RIGHT]
        if largerTicks > 0
            ldMisPm := (abs(ldTicks[SLOT_LEFT] - ldTicks[SLOT_RIGHT]) * SPIN_PM) / largerTicks
        drainBegin()
        startJ := ringIndex(ldWinStart)
        endJ := ringIndex(ldWinEnd - 1)
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            ldGapMs[slotIdx] := longestTickGap(slotIdx, startJ, endJ)
            nHeld, nBad := heldAtSpeed(slotIdx, startJ, endJ)
            ldHeldN += nHeld
            ldHeldBad += nBad

PRI loadFold() | bJudged, bPctRead, bFltSeen
' Resolve a GRAB trial's outcome (LDO_*) and fold a judged one into LDPATH, LDHUNT and the gripped wheel's LDHOLD, and the trial into
' LDFLT.
' LDHOLD'S PRECONDITION (SRC_REV 63: GRAB is the overload hold's only proof): the grip actually held the gripped wheel
' (LOAD_GRIP_SLOT) below its command -- it read SHORT in the window and ran under LOAD_OVL_PCT of its command's rate,
' with no latch -- or a wheel faulted (LDHOLD's negative). A window it ran through at LOAD_OVL_PCT or more is LIGHT
' (NOT_OVERLOADED): not judged, and the RESULT line asks for a firmer grip next run. A trial read from the ring adds its
' HELDATSPD counts. SRC_REV 81 (PL-189): LDHOLD also needs the wheel to have run LDHOLD_PCT_LO % or more of its command (else
' ldHoldWhy NEAR_STOP, or NO_SAMPLES with no window read); LDPATH needs the gripped wheel's fold-back NOT engaged in the window (else
' ldPathWhy LIMIT_HELD, EVENTS_LOST when the drain did not read whole); LDFLT is judged for every driven trial whose grip slowed
' the gripped wheel but left it moving (LDFLT_PCT_LO .. LDFLT_PCT_HI), the CON's 3.; each cell's why is BM-LDFLT's.
'
' @local bJudged - T/F where T means this trial is a judged overload
' @local bPctRead - T/F where T means the window was read from the ring, so ldPct is the wheel's reading
' @local bFltSeen - T/F where T means a wheel's log held an EV_FAULT or an EV_FAULT_RESYNC from the grab point

    if bLdDriven
        if bLdFault
            ldOutcome := LDO_FAULT
        elseif bLdLatched
            ldOutcome := LDO_STALLED
            if ldWhy == WHY_NONE
                ldWhy := WHY_STALLED
        elseif (bLdWinValid == FALSE) or (bLdFrozen == FALSE)
            ldOutcome := LDO_ABORT
        elseif (ldShort[LOAD_GRIP_SLOT] > 0) and (ldPct[LOAD_GRIP_SLOT] < LOAD_OVL_PCT)
            ldOutcome := LDO_OVERLOAD
        else
            ldOutcome := LDO_LIGHT
            if ldWhy == WHY_NONE
                ldWhy := WHY_NOT_OVERLOADED
    bPctRead := bLdFrozen and bLdDriven and (ldWinStart >= 0) and (ldWinEnd > ldWinStart)
    bJudged := (ldOutcome == LDO_OVERLOAD) or (ldOutcome == LDO_FAULT)
    ldHoldWhy := WHY_NONE
    ldPathWhy := WHY_NONE
    if bJudged
        bLdJudged := TRUE
        ' SRC_REV 81: LDHOLD reads the hold only on a wheel that kept turning (the CON, 1.): a gap near a stop is the hand's
        if bPctRead == FALSE
            ldHoldWhy := WHY_NO_SAMPLES
        elseif ldPct[LOAD_GRIP_SLOT] < LDHOLD_PCT_LO
            ldHoldWhy := WHY_NEAR_STOP
        else
            sfLdHoldN := (sfLdHoldN + 1) <# LIM_SMALL
            if ldOutcome == LDO_FAULT
                sfLdHoldMs := LOAD_GAP_FAULT_MS             ' a fault is LDHOLD's negative
            else
                sfLdHoldMs #>= ldGapMs[LOAD_GRIP_SLOT]
        if bLdEngaged                                       ' LDHUNT's precondition: the limiter was engaged over the window
            bSfLdHunt := TRUE
            sfLdHunt := ldFlips
        ' SRC_REV 81: LDPATH reads the line only where drv_incr is the field's speed (the CON, 2.): not under the fold-back's hold
        if (bLdWinValid == FALSE) or (bLdFrozen == FALSE)
            ldPathWhy := WHY_NO_SAMPLES
        elseif (ldTicks[SLOT_LEFT] #> ldTicks[SLOT_RIGHT]) < LOAD_MIN_TICKS
            ldPathWhy := WHY_TOO_FEW_TICKS
        elseif bLdEvRead == FALSE
            ldPathWhy := WHY_EVENTS_LOST
        elseif bLdFoldHeld
            ldPathWhy := WHY_LIMIT_HELD
        else
            bSfLdPath := TRUE
            sfLdPathPm := ldMisPm
        if bLdWinValid and (ldWhy == WHY_NONE) and (ldPathWhy == WHY_TOO_FEW_TICKS)
            ldWhy := WHY_TOO_FEW_TICKS
    ' SRC_REV 81 (PL-189): LDFLT -- every driven trial that reached the grab, the grip leaving the gripped wheel slowed but moving
    ldFltWhy := WHY_NONE
    if (bLdDriven == FALSE) or (bLdGrabbed == FALSE)
        ldFltWhy := WHY_NOT_REACHED
    elseif bPctRead == FALSE
        ldFltWhy := WHY_NO_SAMPLES
    elseif ldPct[LOAD_GRIP_SLOT] < LDFLT_PCT_LO
        ldFltWhy := WHY_NEAR_STOP
    elseif ldPct[LOAD_GRIP_SLOT] > LDFLT_PCT_HI
        ldFltWhy := WHY_NOT_SLOWED
    else
        bFltSeen := (ldFltN[SLOT_LEFT] + ldFltN[SLOT_RIGHT] + ldRsyN[SLOT_LEFT] + ldRsyN[SLOT_RIGHT]) > 0
        if bFltSeen or bLdEvRead                            ' a fault seen is a FAIL whatever else the drain lost; none seen needs a whole drain
            bSfLdFltRan := TRUE
            bSfLdFltOk := (bFltSeen == FALSE)
        else
            ldFltWhy := WHY_EVENTS_LOST
    if bLdFrozen and bLdDriven and (ldWinStart >= 0)
        sfHeldN := (sfHeldN + ldHeldN) <# LIM_SMALL
        sfHeldBad := (sfHeldBad + ldHeldBad) <# LIM_SMALL
#endif

PRI floorLeadIn()
' THE LEAD-IN (Stephen 2026-09-30, R3: "let's go ahead and add a 10-second lead-in. Nothing more."): after the banner and
' the build records, and before the steering object is started or anything can move, LEAD_IN_MS of beat-keeping wait (the
' watchdog, 4 s, is fed through all of it) under two plain lines, so he can be standing where the run sheet says when the
' platform moves. It replaces the first READY: there is no screen to click.
'
' The action is named by the banner's action field and by the RESULT line.

    alignSay(@"LEAD-IN: stand where the run sheet says; nothing moves for 10 s")
    sayCountdown(@"LEAD-IN: the platform starts moving in", LEAD_IN_MS / MS_PER_SEC)
    waitBeat(LEAD_IN_MS, CP_LOOP_READY)

PRI sayCountdown(pLine, nSeconds)
' One plain operator line that ends in a count of seconds (alignSay()'s shape, with a number): the text, a space, the
' seconds and " s". The line is a terminal line for Stephen, in plain words; no record carries it. DEBUG puts ", "
' between two adjacent formatted items and none beside a string literal, so a literal stands between every pair here
' (SRC_REV 70, H7: "starts moving in , 10 s").
'
' @param pLine - pointer to the text, which ends in a word, not a space
' @param nSeconds - the seconds to show

    beat(CP_EMIT)
    debug(zstr_(pLine), " ", udec_(nSeconds), " s")
    beat(CP_EMIT)

PRI sayResult(pAction, pBody, pWhy)
' THE RESULT LINE, printed last, just before the session ends: "RESULT: <action> -- <body>" and, when there is a cause,
' ": <why>", one plain line he reads when he walks back to rerun. It is worded only from what the run's own verdict
' logic decided (floorResult()). SRC_REV 70 (H7): the body and the cause were two adjacent formatted items, which DEBUG
' separates with ", " (every line ended in one); now a literal stands between them, and none follows an empty cause.
'
' @param pAction - pointer to the action's words (sFloorWords)
' @param pBody - pointer to what happened, in plain words, without a closing colon
' @param pWhy - pointer to the plain cause that follows the body, or the empty string

    beat(CP_EMIT)
    if byte[pWhy] == 0
        debug("RESULT: ", zstr_(pAction), " -- ", zstr_(pBody))
    else
        debug("RESULT: ", zstr_(pAction), " -- ", zstr_(pBody), ": ", zstr_(pWhy))
    beat(CP_EMIT)

PRI floorResult() | pAction, pBody, pWhy
' The RESULT line for this image's action (SRC_REV 69): its words, and a body and cause taken from that action's own
' staging -- the verdict logic's, never a second opinion, so the line cannot contradict the cells. A build with no
' action says so.
'
' @local pAction - the action's words
' @local pBody - what happened, in plain words
' @local pWhy - the plain cause after it

    pAction := tokenAt(@sFloorWords, FLA_COUNT, FLOOR_ACT)
    pBody := @sResNoAction
    pWhy := @sResEmpty
#ifdef DBF_AUTO
    pBody, pWhy := resultAuto()                             ' SRC_REV 70: the session's one line, composed from all three parts
#elseifdef DBF_OBSTSESS
    pBody, pWhy := resultObstSession()                      ' SRC_REV 70: both trials and their drives back in one line
#else
#ifdef DBF_OBST
    pBody, pWhy := resultObstacle()
#endif
#ifdef DBF_GRAB
    pBody, pWhy := resultGrab()
#endif
#ifdef DBF_FAULTRUN
    pBody, pWhy := resultFaultRun()
#endif
#ifdef DBF_SPINLEG
    pBody, pWhy := resultSpin()
#endif
#endif
    sayResult(pAction, pBody, pWhy)

PRI resultEnded(bDriven, whyCode) : pBody, pWhy
' The body and cause for a run that ended short: one that never drove says it did nothing, one that drove says it ended
' early, each followed by the cause in plain words.
'
' @param bDriven - a drive was commanded
' @param whyCode - WHY_* the run's own staging names
' @returns pBody - "the run did nothing: " or "ended early, nothing more was judged: "
' @returns pWhy - the cause in plain words

    pBody := @sResNothing
    if bDriven
        pBody := @sResEarly
    pWhy := whyWords(whyCode)

PRI whyWords(whyCode) : pWords
' A cause in plain words, for the RESULT line: the causes a floor run can end on, else a pointer to the log.
'
' @param whyCode - WHY_*
' @returns pWords - the plain words

    case whyCode
        WHY_NO_COG:
            pWords := @sResWhyNoCog
        WHY_LIMIT_REFUSED:
            pWords := @sResWhyLimit
        WHY_SYNC_PRECOND:
            pWords := @sResWhyDrive
        WHY_INST_NOACK:
            pWords := @sResWhyNoAck
        WHY_TICK_SIZE_DIFFERS:
            pWords := @sResWhyTick
        WHY_ABORTED:
            pWords := @sResWhyAbort
        WHY_OVERTRAVEL:
            pWords := @sResWhyOver
        WHY_STOP_TIMEOUT:
            pWords := @sResWhyTimeout
        WHY_STALLED:
            pWords := @sResWhyStalled
        WHY_FAULTED:
            pWords := @sResWhyFaulted
        WHY_INST_STALLED:
            pWords := @sResWhyStall
        WHY_STOP_BEGAN:
            pWords := @sResWhyStopBgn
        WHY_STEADY_TIMEOUT:
            pWords := @sResWhyNoSettle
        WHY_FENCE_REFUSED:
            pWords := @sResWhyFence
        WHY_NOT_CLEAR:
            pWords := @sResWhyNotClear
        WHY_STRAIGHTS_SKIPPED:
            pWords := @sResWhySkipped
        WHY_NOT_AT_START:
            pWords := @sResWhyNotHome
        WHY_RATE_REFUSED:
            pWords := @sResWhyRate
#ifdef DBG_FENCE
        WHY_MOTOR_RETIRED:                                  ' the sessions' skip lines name these; a single action's RESULT line is as it was
            pWords := @sResWhyRetired
        WHY_NO_FAULT:
            pWords := @sResWhyNoFault
        WHY_NO_ROOM:
            pWords := @sResWhyNoRoom
        WHY_NOT_REACHED:
            pWords := @sResWhyNoMove
#endif
        other:
            pWords := @sResWhyOther

#ifdef DBF_OBST
PRI resultObstacle() : pBody, pWhy
' OBSTACLE's body and cause: from the trial's own staging and the BLKSTOP and PROTCLR folds -- latched and every check
' held, latched but a check failed, met the obstacle with no latch in time, never met it, or ended short. SRC_REV 74: "every
' check held" is THIS trial's own two flags (bBlkStopBad, bBlkClrBad, set by blockFold() from this trial's readings and
' cleared by blkReset()), not the session's counts (sfBlkBad, sfClrBad): in a two-trial session a first trial's failure
' no longer reads against the second's RESULT body, nor the second's against a body already taken for the first.
'
' @returns pBody - what happened
' @returns pWhy - the cause after it, or the empty string

    pWhy := @sResEmpty
    if bBlkDriven == FALSE
        pBody, pWhy := resultEnded(FALSE, blkWhy)
    elseif blkStopBy == BLKSTOP_LATCHED
        pBody := @sResObstBad
        if bBlkStopJudged and (bBlkStopBad == FALSE) and bBlkApiRan and (bBlkClrBad == FALSE)
            pBody := @sResObstLatched
    elseif blkStopBy == BLKSTOP_NO_LATCH
        pBody := @sResObstNoLatch
    elseif blkStopBy == BLKSTOP_LIMIT
        pBody := @sResObstMissed
    else
        pBody, pWhy := resultEnded(TRUE, blkWhy)
#endif

#ifdef DBF_GRAB
PRI resultGrab() : pBody, pWhy | bFirm, bHuntBad, bNoEngage
' GRAB's body and cause, from the outcome loadFold() resolved (LDO_*) and the two cells it folded: judged, a wheel
' faulted, too light (hold harder next run), stalled (hold less next run), or ended short. SRC_REV 70: an overload the
' line check could not judge (LDPATH NOMEAS: the hold slowed the wheels under LOAD_MIN_TICKS of travel, TOO_FEW_TICKS) says
' the hold was too firm and to hold less next run; a path limiter that changed state during the hold (LDHUNT FAIL) says
' so, and one not engaged over the window (LDHUNT NOMEAS) says that; "judged" is printed only when none happened. SRC_REV 81: the
' firm-hold wording also covers an overload that left the gripped wheel under LDHOLD_PCT_LO of its command (LDHOLD NOMEAS, NEAR_STOP);
' LDPATH's LIMIT_HELD (the fold-back held the wheel) is not a hold too firm, and still prints "judged".
'
' @returns pBody - what happened and what to do next run
' @returns pWhy - the cause after it, or the empty string
'
' @local bFirm - an overload whose line check (LDPATH) read NOMEAS for too little travel, or whose LDHOLD read NOMEAS near a stop
' @local bHuntBad - the path limiter changed state inside the window (LDHUNT's value is over its band)
' @local bNoEngage - an overload whose path limiter was not engaged over the window (LDHUNT NOMEAS)

    pWhy := @sResEmpty
    if bLdDriven == FALSE
        pBody, pWhy := resultEnded(FALSE, ldWhy)
    else
        bFirm := (ldOutcome == LDO_OVERLOAD) and ((ldPathWhy == WHY_TOO_FEW_TICKS) or (ldHoldWhy == WHY_NEAR_STOP))
        bHuntBad := bSfLdHunt and ((sfLdHunt < LOAD_HUNT_LO) or (sfLdHunt > LOAD_HUNT_HI))
        bNoEngage := (ldOutcome == LDO_OVERLOAD) and (bSfLdHunt == FALSE)
        case ldOutcome
            LDO_OVERLOAD:
                pBody := @sResGrabJudged
                if bFirm
                    pBody := @sResGrabFirm
                    if bHuntBad
                        pWhy := @sResGrabHuntWhy
                    elseif bNoEngage
                        pWhy := @sResGrabNoEngWhy
                elseif bHuntBad
                    pBody := @sResGrabHuntBad
                elseif bNoEngage
                    pBody := @sResGrabNoEng
            LDO_FAULT:
                pBody := @sResGrabFault
                if bHuntBad
                    pWhy := @sResGrabHuntWhy
            LDO_LIGHT:
                pBody := @sResGrabLight
            LDO_STALLED:
                pBody := @sResGrabStalled
            other:
                pBody, pWhy := resultEnded(TRUE, ldWhy)
#endif

#ifdef DBF_FAULTRUN
PRI resultFaultRun() : pBody, pWhy
' FAULTRUN's body and cause: the fault was not requested (the leg back ended first: SRC_REV 70 tells it from the next);
' the fault did not latch; it latched and the recovery and the drive on to the start ran, with
' PL-93's current ratio on either side of its band (POSTFLT's own criterion, RD_RATIO_X100_HI); the drive on did not run;
' or the run ended before the fault.
'
' @returns pBody - what happened
' @returns pWhy - the cause after it, or the empty string

    pWhy := @sResEmpty
    if bFrunDriven == FALSE
        pBody, pWhy := resultEnded(FALSE, frSegWhy)
    elseif frOutcome == FRO_NOT_RUN
        pBody := @sResFrNotRun                              ' never requested: the leg back ended before its steady second
        pWhy := whyWords(frunWhy)
    elseif frOutcome <> FRO_FAULT
        pBody := @sResFrNoFault
    elseif bRdDriven == FALSE
        pBody := @sResFrNoRedrive
        pWhy := whyWords(rdWhy)
    elseif (bRdRatio[SLOT_LEFT] == FALSE) and (bRdRatio[SLOT_RIGHT] == FALSE)
        pBody := @sResFrNoRatio
    elseif (sfRdMax[SLOT_LEFT] #> sfRdMax[SLOT_RIGHT]) > RD_RATIO_X100_HI
        pBody := @sResFrHigh
    else
        pBody := @sResFrRecovered
#endif

#ifdef DBF_SPINLEG
PRI resultSpin() : pBody, pWhy
' The spin leg's body and cause: it ended at its turn limit (and within SPINSTOP's tolerance of it, or not), was stopped
' past it, by the abort, on its bound or by a fault, or never ran.
'
' @returns pBody - what happened
' @returns pWhy - the cause after it, or the empty string

    pWhy := @sResEmpty
    if bSpDriven == FALSE
        pBody, pWhy := resultEnded(FALSE, spWhy)
    else
        case spStopBy
            SPSTOP_LIMIT:
                pBody := @sResSpinOffLim
                if sfSpStopBad == 0
                    pBody := @sResSpinLimit
            SPSTOP_OVERTRAVEL:
                pBody := @sResSpinPast
            SPSTOP_ABORT:
                pBody := @sResSpinAborted
            SPSTOP_TIMEOUT:
                pBody := @sResSpinTimeout
            SPSTOP_FAULT:
                pBody := @sResSpinFault
            other:
                pBody, pWhy := resultEnded(TRUE, spWhy)
#endif

#ifdef DBF_AUTO
PRI resultAuto() : pBody, pWhy | pPartBody, pPartWhy
' SESSION 2's one RESULT line, composed in the buffer from what its three parts decided (the verdict logic's own, never a second
' opinion): how many of the ten spins ended at their turn limit (and how many of those were off the allowed distance, or were never
' driven); the fault run's own body (resultFaultRun()) or why it did not run; how many of the four ramp legs ran to their limit, or
' why none did; and where the dead reckoning puts the platform at the end.
'
' @returns pBody - pointer to the composed text
' @returns pWhy - the empty string: the causes are inside the body
'
' @local pPartBody - the fault run's body
' @local pPartWhy - the fault run's cause

    resReset()
    resCat(@"spins: ")
    resCatNum(sessSpinLimit)
    resCat(@" of ")
    resCatNum(SPIN_LEGS)
    resCat(@" ended at their turn limit")
    if sfSpStopBad > 0
        resCat(@" (")
        resCatNum(sfSpStopBad)
        resCat(@" not within the allowed distance of it)")
    if sessSpinDriven < SPIN_LEGS
        resCat(@", ")
        resCatNum(SPIN_LEGS - sessSpinDriven)
        resCat(@" never driven: ")
        resCat(whyWords(sessSpinWhy))
    resCat(@"; fault run: ")
    if bSessFrRan == FALSE
        resCat(@"not run: ")
        resCat(whyWords(sessSkipWhy))
    else
        pPartBody, pPartWhy := resultFaultRun()
        resCat(pPartBody)
        if byte[pPartWhy] <> 0
            resCat(@": ")
            resCat(pPartWhy)
    resCat(@"; ramp legs: ")
    if sessRampTried == 0
        resCat(@"not run: ")
        resCat(whyWords(sessSkipWhy))
    else
        resCatNum(sessRampLimit)
        resCat(@" of ")
        resCatNum(RAMP_LEGS)
        resCat(@" ran to their limit")
    resCatPosition()
    pBody := @resBuf
    pWhy := @sResEmpty
#endif

#ifdef DBF_OBSTSESS
PRI resultObstSession() : pBody, pWhy | kindIdx
' SESSION 3's one RESULT line, composed in the buffer: for each trial, COAST then BRAKE, its own body and cause
' (resultObstacle(), taken right after the trial) and what became of its drive back -- made and at the start, not made and why,
' or none owed -- and where the dead reckoning puts the platform at the end.
'
' @returns pBody - pointer to the composed text
' @returns pWhy - the empty string: the causes are inside the body
'
' @local kindIdx - BLK_COAST, BLK_BRAKE

    resReset()
    repeat kindIdx from BLK_COAST to BLK_BRAKE
        if kindIdx == BLK_COAST
            resCat(@"COAST: ")
        else
            resCat(@"; BRAKE: ")
        if bSessObstRan[kindIdx] == FALSE
            resCat(@"not run: ")
            resCat(whyWords(sessTrialWhy[kindIdx]))
        else
            resCat(sessObstBody[kindIdx])
            if byte[sessObstWhy[kindIdx]] <> 0
                resCat(@": ")
                resCat(sessObstWhy[kindIdx])
            case sessBackState[kindIdx]
                SBK_RETURNED:
                    resCat(@", then drove back to its start")
                SBK_FAILED:
                    resCat(@", but did not drive back: ")
                    resCat(whyWords(sessBackWhy[kindIdx]))
                other:
                    resCat(@", and had nothing to drive back")
    resCatPosition()
    pBody := @resBuf
    pWhy := @sResEmpty
#endif

PRI emitLoadCells() | slotIdx
' The floor situations' load cells' verdicts (their CON), each NOMEAS when nothing measured it: POSTFLT X100 per motor;
' BLKSTOP COUNT (BOTH), PROTCLR COUNT (BOTH); per motor BLKSHORT MV, the control, before BLKCOAST MV; HELDATSPD COUNT
' (BOTH); BLKLIMIT BOOL (BOTH, SRC_REV 75); BLKWIN and BLKFLT BOOL (BOTH, SRC_REV 77); LDFLT BOOL (BOTH, SRC_REV 81); LDPATH PERMILLE (BOTH); LDHUNT COUNT (BOTH, SRC_REV 62); LDHOLD MS for the gripped wheel only (SRC_REV 63:
' GRAB alone judges it, and it grips LOAD_GRIP_SLOT, so the other wheel's instance could only ever read NOMEAS).
'
' @local slotIdx - motor slot

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        emitSignoff(@sSfCellPostFlt, SIDE_LEFT + slotIdx, @sSfCritPostFlt, sfRdN[slotIdx] > 0, sfRdMax[slotIdx], 0, RD_RATIO_X100_HI, sfRdN[slotIdx], @sSfUnitsX100)
    emitSignoff(@sSfCellBlkStop, SIDE_BOTH, @sSfCritBlkStop, sfBlkN > 0, sfBlkBad, SPIN_BAD_LO, SPIN_BAD_HI, sfBlkN, @sSfUnitsCount)
    emitSignoff(@sSfCellProtClr, SIDE_BOTH, @sSfCritProtClr, sfClrN > 0, sfClrBad, SPIN_BAD_LO, SPIN_BAD_HI, sfClrN, @sSfUnitsCount)
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        emitSignoff(@sSfCellBlkShort, SIDE_LEFT + slotIdx, @sSfCritBlkShort, bSfBlkShort[slotIdx], sfBlkShortMv[slotIdx], 0, BLK_PH_SPLIT_MV - 1, SIGNOFF_ONE_INSTANCE, @sSfUnitsMv)
        emitSignoff(@sSfCellBlkCoast, SIDE_LEFT + slotIdx, @sSfCritBlkCoast, bSfBlkCoast[slotIdx], sfBlkCoastMv[slotIdx], BLK_PH_SPLIT_MV, LIM_BIG, SIGNOFF_ONE_INSTANCE, @sSfUnitsMv)
    emitSignoff(@sSfCellHeldAtSp, SIDE_BOTH, @sSfCritHeldAtSp, sfHeldN > 0, sfHeldBad, HELD_BAD_LO, HELD_BAD_HI, sfHeldN, @sSfUnitsCount)
    ' SRC_REV 75 (task 3657): BLKLIMIT, the BRAKE trial's fold-back-then-latch order and its latch time (the section's CON)
    emitSignoffBool(@sSfCellBlkLimit, SIDE_BOTH, @sSfCritBlkLimit, bSfBlkLimRan, bSfBlkLimOk, SIGNOFF_ONE_INSTANCE)
    ' SRC_REV 77 (task 3662): BLKWIN (no |err| 82..88 once a limiter acted and no tick since) and BLKFLT (the trial latches
    '  with no EV_FAULT or EV_FAULT_RESYNC), the OBSTACLE trials' two cells; BM-BLKWIN's why says why one is NOMEAS
    emitSignoffBool(@sSfCellBlkWin, SIDE_BOTH, @sSfCritBlkWin, bSfBlkWinRan, bSfBlkWinOk, SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellBlkFlt, SIDE_BOTH, @sSfCritBlkFlt, bSfBlkFltRan, bSfBlkFltOk, SIGNOFF_ONE_INSTANCE)
    emitSignoff(@sSfCellLdPath, SIDE_BOTH, @sSfCritLdPath, bSfLdPath, sfLdPathPm, 0, LOAD_LINE_PM, SIGNOFF_ONE_INSTANCE, @sSfUnitsPm)
    emitSignoff(@sSfCellLdHunt, SIDE_BOTH, @sSfCritLdHunt, bSfLdHunt, sfLdHunt, LOAD_HUNT_LO, LOAD_HUNT_HI, SIGNOFF_ONE_INSTANCE, @sSfUnitsCount)
    emitSignoff(@sSfCellLdHold, SIDE_LEFT + LOAD_GRIP_SLOT, @sSfCritLdHold, sfLdHoldN > 0, sfLdHoldMs, 0, LOAD_GAP_HI_MS, sfLdHoldN, @sSfUnitsMs)
    ' SRC_REV 81 (PL-189): LDFLT, the grab's I-9' (no EV_FAULT, no EV_FAULT_RESYNC from the grab point); BM-LDFLT's why says why it is NOMEAS
    emitSignoffBool(@sSfCellLdFlt, SIDE_BOTH, @sSfCritLdFlt, bSfLdFltRan, bSfLdFltOk, SIGNOFF_ONE_INSTANCE)

PRI emitFlBuild()
' BM-FLBUILD (SRC_REV 62): the floor rules' pre-registered numbers -- every straight leg's travel in mm and ticks, the
' harness's own cap past it, a leg's bound, the slow walk's power and its field rate (ticks/s x10), and the order of
' the situations. Worst case 150 bytes.

    recBegin(@"BM-FLBUILD")
    benchLog.numField(@"leg_mm", FL_LEG_MM, LIM_SMALL)
    benchLog.numField(@"leg_tk", FL_LEG_TICKS, LIM_SMALL)
    benchLog.numField(@"over_tk", FL_OVER_TICKS, LIM_TINY)
    benchLog.numField(@"leg_ms", FL_LEG_MS, LIM_SMALL)
    benchLog.numField(@"slow_pwr", FL_SLOW_POWER, LIM_TINY)
    benchLog.numField(@"slow_x10", FL_SLOW_RATE_X10, LIM_SMALL)
    benchLog.numField(@"move_ms", FL_MOVE_MS, LIM_SMALL)
    emitRecord()

#ifdef DBF_FAULTRUN
PRI emitRdBuild()
' BM-RDBUILD: FAULTRUN's pre-registered numbers (SRC_REV 62) -- its power, the wheel faulted, PL-93's ratio band and an
' abort's score, the least "before" it divides by, the least of the leg back the re-drive runs in, and its window and
' the shortest that measures. Worst case 160 bytes.

    recBegin(@"BM-RDBUILD")
    benchLog.numField(@"power", FLR_POWER, LIM_TINY)
    benchLog.tokenField(@"motor", sideToken(FLR_SIDE), TOKMAX_MOTOR)
    benchLog.numField(@"ratio_hi", RD_RATIO_X100_HI, LIM_SMALL)
    benchLog.numField(@"abort_x100", RD_ABORT_X100, LIM_SMALL)
    benchLog.numField(@"pre_min", RD_PRE_MIN, LIM_SMALL)
    benchLog.numField(@"min_ticks", RD_MIN_TICKS, LIM_TINY)
    benchLog.numField(@"win_ms", SPIN_FAULT_SETTLE_MS, LIM_SMALL)
    benchLog.numField(@"win_min", RD_WIN_MIN_MS, LIM_SMALL)
    emitRecord()
#endif

#ifdef DBF_OBST
PRI emitBlkBuild()
' BM-BLKBUILD: OBSTACLE's pre-registered numbers (SRC_REV 62) -- the power, the lowered limit, where the obstacle
' stands, the latch's earliest honest time, the stamps' lateness, the stand's floor, the blocked count's band and the
' count run that says the stop is overdue (SRC_REV 76: count_lo and count_hi replace lag_ms and stand_hi), the getPower() poll, the phase window's settle and length, the split between a
' coast and a short, and the decimation (SRC_REV 69: the trial count, `trials`, is gone with the loop). Worst case under
' the 250 bytes it was.

    recBegin(@"BM-BLKBUILD")
    benchLog.numField(@"power", BLK_POWER, LIM_TINY)
    benchLog.numField(@"limit_a", BLK_LIMIT_A, LIM_TINY)
    benchLog.numField(@"near_mm", OBS_NEAR_MM, LIM_SMALL)
    benchLog.numField(@"far_mm", OBS_FAR_MM, LIM_SMALL)
    benchLog.numField(@"latch_min", BLK_LATCH_MIN_MS, LIM_SMALL)
    benchLog.numField(@"count_lo", BLK_COUNT_LO_MS, LIM_SMALL)
    benchLog.numField(@"stamp_ms", BLK_STAMP_MS, LIM_TINY)
    benchLog.numField(@"stand_lo", BLK_STAND_LO_MS, LIM_SMALL)
    benchLog.numField(@"count_hi", BLK_COUNT_HI_MS, LIM_SMALL)
    benchLog.numField(@"nolatch", BLK_NOLATCH_MS, LIM_SMALL)
    benchLog.numField(@"poll_ms", BLK_POLL_MS, LIM_TINY)
    benchLog.numField(@"settle_ms", BLK_PH_SETTLE_MS, LIM_SMALL)
    benchLog.numField(@"win_ms", BLK_PH_WIN_MS, LIM_SMALL)
    benchLog.numField(@"split_mV", BLK_PH_SPLIT_MV, LIM_TINY)
    benchLog.numField(@"decim", BLK_DECIM, LIM_TINY)
    emitRecord()
#endif

#ifdef DBF_GRAB
PRI emitLdBuild()
' BM-LDBUILD: GRAB's pre-registered numbers (SRC_REV 62) -- the power, the increment it commands and C-1's rate for it,
' the lowered limit, the leg in mm and ticks, the grab point, the hold's lead and judged window, the overload threshold,
' the line band, the least travel it reads, the tick-gap bound and LDHUNT's engage count (SRC_REV 63: the only loaded
' trial; the incline's overloaded climb is removed. SRC_REV 69: one trial, so the `tries` field is gone, and the drive's
' time bound is new, leg_ms). Worst case 245 bytes.

    recBegin(@"BM-LDBUILD")
    benchLog.numField(@"power", LOAD_POWER, LIM_TINY)
    benchLog.numField(@"incre", spinIncre(LOAD_POWER), LIM_BIG)
    benchLog.numField(@"pred_x10", predictX10(spinIncre(LOAD_POWER)), LIM_MID)
    benchLog.numField(@"limit_a", LOAD_LIMIT_A, LIM_TINY)
    benchLog.numField(@"travel_mm", LOAD_TRAVEL_MM, LIM_SMALL)
    benchLog.numField(@"travel_tk", LOAD_TRAVEL_TICKS, LIM_SMALL)
    benchLog.numField(@"grab_tk", LOAD_GRAB_TICKS, LIM_SMALL)
    benchLog.numField(@"lead_ms", LOAD_PULL_LEAD_MS, LIM_SMALL)
    benchLog.numField(@"win_ms", LOAD_WIN_MS, LIM_SMALL)
    benchLog.numField(@"ovl_pct", LOAD_OVL_PCT, LIM_TINY)
    benchLog.numField(@"line_pm", LOAD_LINE_PM, LIM_TINY)
    benchLog.numField(@"min_ticks", LOAD_MIN_TICKS, LIM_TINY)
    benchLog.numField(@"gap_ms", LOAD_GAP_HI_MS, LIM_SMALL)
    benchLog.numField(@"hunt", LOAD_HUNT_HI, LIM_TINY)
    benchLog.numField(@"leg_ms", LOAD_LEG_MS, LIM_SMALL)
    emitRecord()
#endif

#ifdef DBF_FAULTRUN
PRI emitRedrive() | bValid
' BM-RDRIVE: FAULTRUN's re-drive (PL-93) -- the wheel faulted, what was left of the leg back, the limit's and the
' drive's returns, what ended it, command to both AT_SPEED, its window's length, each wheel's getCurrent() mean on the
' leg OUT (SRC_REV 62: the second reference, not judged), before the fault and in the window (A x 10_000), and the
' after-over-before ratio (x100; RD_ABORT_X100 after an abort). SRC_REV 62: the leg field is gone (one run). Worst
' case 262 bytes.
'
' @local bValid - the window's readings are a measurement

    bValid := bRdWinValid
    recBegin(@"BM-RDRIVE")
    benchLog.tokenField(@"motor", sideToken(rdSide), TOKMAX_MOTOR)
    benchLog.naNumField(@"remain", rdRemain, LIM_TINY, rdRemain > 0)
    benchLog.naNumField(@"lim_err", rdLimErr, LIM_SMALL, bRdDriven)
    benchLog.naNumField(@"drv_err", rdDriveErr, LIM_SMALL, bRdDriven)
    benchLog.tokenField(@"stop_by", tokenAt(@tokSpStop, SPSTOP_COUNT, rdStopBy), TOKMAX_SPSTOP)
    benchLog.naNumField(@"at_ms", rdAtMs, LIM_SMALL, bRdReached)
    benchLog.naNumField(@"win_ms", rdWinMs, LIM_SMALL, bRdReached)
    benchLog.naNumField(@"l_fwd", rdFwd[SLOT_LEFT], LIM_MID, bRdFwd)
    benchLog.naNumField(@"r_fwd", rdFwd[SLOT_RIGHT], LIM_MID, bRdFwd)
    benchLog.naNumField(@"l_pre", rdPre[SLOT_LEFT], LIM_MID, rdPre[SLOT_LEFT] > 0)
    benchLog.naNumField(@"r_pre", rdPre[SLOT_RIGHT], LIM_MID, rdPre[SLOT_RIGHT] > 0)
    benchLog.naNumField(@"l_post", rdPost[SLOT_LEFT], LIM_MID, bValid)
    benchLog.naNumField(@"r_post", rdPost[SLOT_RIGHT], LIM_MID, bValid)
    benchLog.naNumField(@"l_x100", rdRatio[SLOT_LEFT], LIM_SMALL, bRdRatio[SLOT_LEFT])
    benchLog.naNumField(@"r_x100", rdRatio[SLOT_RIGHT], LIM_SMALL, bRdRatio[SLOT_RIGHT])
    whyField(rdWhy)
    emitRecord()
#endif

#ifdef DBF_OBST
PRI emitBlock()
' BM-BLOCK: one OBSTACLE trial (PL-106) -- its number (1-based) and kind, the lifetime, the limit's, the leg's distance
' stop's and the drive's returns, what ended its drive, command to both AT_SPEED, command to latch, each wheel's stand
' still (its last hall tick to the latch, or to the harness's stop), and both stop reasons. SRC_REV 62: arm_err,
' at_ms, l_stand and r_stand are new; moved is gone (both wheels drive); the codes and HELDATSPD moved to BM-BLKCLR.
' SRC_REV 76: l_count and r_count, each wheel's blocked count run at the latch (or the stop), 2 x (9 + 7) more.
' Worst case 257 bytes.

    recBegin(@"BM-BLOCK")
    benchLog.numField(@"trial", blkKind + 1, LIM_TINY)
    benchLog.tokenField(@"kind", tokenAt(@tokBlk, BLK_KINDS, blkKind), TOKMAX_BLK)
    benchLog.naNumField(@"sid", blkSid, LIM_SMALL, blkSid > 0)
    benchLog.naNumField(@"lim_err", blkLimErr, LIM_SMALL, blkSid > 0)
    benchLog.naNumField(@"arm_err", blkArmErr, LIM_SMALL, blkSid > 0)
    benchLog.naNumField(@"drv_err", blkDriveErr, LIM_SMALL, bBlkDriven)
    benchLog.tokenField(@"stop_by", tokenAt(@tokBlkStop, BLKSTOP_COUNT, blkStopBy), TOKMAX_BLKSTOP)
    benchLog.naNumField(@"at_ms", blkAtMs, LIM_SMALL, bBlkReached)
    benchLog.naNumField(@"latch_ms", blkLatchMs, LIM_SMALL, bBlkLatched)
    benchLog.naNumField(@"l_stand", blkStandMs[SLOT_LEFT], LIM_SMALL, bBlkLatched or (blkStopBy == BLKSTOP_NO_LATCH))
    benchLog.naNumField(@"r_stand", blkStandMs[SLOT_RIGHT], LIM_SMALL, bBlkLatched or (blkStopBy == BLKSTOP_NO_LATCH))
    benchLog.naNumField(@"l_count", blkCountRunMs[SLOT_LEFT], LIM_SMALL, bBlkLatched or (blkStopBy == BLKSTOP_NO_LATCH))
    benchLog.naNumField(@"r_count", blkCountRunMs[SLOT_RIGHT], LIM_SMALL, bBlkLatched or (blkStopBy == BLKSTOP_NO_LATCH))
    srField(@"l_sr", blkLeftSr, bBlkSrRead)
    srField(@"r_sr", blkRightSr, bBlkSrRead)
    whyField(blkWhy)
    emitRecord()

PRI emitBlkClr() | bRead, slotIdx, bridgeCode[INST_MOTORS]
' BM-BLKCLR: one OBSTACLE trial's codes, API sequence (PL-111's API half) and the bridge it left (PL-132) -- both
' protective codes at the latch, the refused drive's return, clearEmergency()'s and whether both codes stayed set,
' clearProtectiveStop()'s and whether both then read NO_ERROR, the rest of the leg armed and the drive after it; each
' wheel's phase-sum mean at rest over the window (mV x10) and the bridge it reads (COAST at or above BLK_PH_SPLIT_MV,
' else SHORT); HELDATSPD's held and bad samples over the drive, both wheels. Worst case 272 bytes.
'
' @local bRead - the drive's ring was read (HELDATSPD)
' @local slotIdx - motor slot
' @local bridgeCode - each wheel's BRIDGE_*

    bRead := bBlkFrozen and bBlkDriven
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        bridgeCode[slotIdx] := BRIDGE_NA
        if bBlkLatched and bBlkFrozen and (blkPhN[slotIdx] > 0)
            bridgeCode[slotIdx] := BRIDGE_SHORT
            if blkPhX10[slotIdx] >= (BLK_PH_SPLIT_MV * X10)
                bridgeCode[slotIdx] := BRIDGE_COAST
    recBegin(@"BM-BLKCLR")
    benchLog.numField(@"trial", blkKind + 1, LIM_TINY)
    benchLog.naNumField(@"l_code", blkLeftCode, LIM_SMALL, bBlkLatched)
    benchLog.naNumField(@"r_code", blkRightCode, LIM_SMALL, bBlkLatched)
    benchLog.naNumField(@"refuse", blkRefuseErr, LIM_SMALL, bBlkApiRan)
    benchLog.naNumField(@"est_clr", blkEstClrErr, LIM_SMALL, bBlkApiRan)
    benchLog.boolField(@"est_held", bBlkEstHeld)
    benchLog.naNumField(@"clr", blkClrErr, LIM_SMALL, bBlkApiRan)
    benchLog.boolField(@"clr_ok", bBlkClrOk)
    benchLog.naNumField(@"arm", blkArm2Err, LIM_SMALL, bBlkApiRan)
    benchLog.naNumField(@"again", blkAgainErr, LIM_SMALL, bBlkApiRan)
    benchLog.naNumField(@"l_ph_x10", blkPhX10[SLOT_LEFT], LIM_MID, bridgeCode[SLOT_LEFT] <> BRIDGE_NA)
    benchLog.naNumField(@"r_ph_x10", blkPhX10[SLOT_RIGHT], LIM_MID, bridgeCode[SLOT_RIGHT] <> BRIDGE_NA)
    benchLog.tokenField(@"l_bridge", tokenAt(@tokBridge, BRIDGE_COUNT, bridgeCode[SLOT_LEFT]), TOKMAX_BRIDGE)
    benchLog.tokenField(@"r_bridge", tokenAt(@tokBridge, BRIDGE_COUNT, bridgeCode[SLOT_RIGHT]), TOKMAX_BRIDGE)
    benchLog.naNumField(@"held_n", blkHeldN, LIM_SMALL, bRead)
    benchLog.naNumField(@"held_bad", blkHeldBad, LIM_SMALL, bRead)
    whyField(blkWhy)
    emitRecord()

PRI emitBlkWin()
' BM-BLKWIN (SRC_REV 77, FMT 52): one OBSTACLE trial's BLKWIN and BLKFLT readings -- the trial and kind, each wheel's window
' (passes read from the pass after the fold-back acted with no tick since, the passes whose |err| read BLK_WIN_LO_ERR..
' BLK_WIN_HI_ERR, and the largest |err| read), each wheel's EV_FAULT and EV_FAULT_RESYNC counts over the trial, and the
' cause each cell is not measured for (WHY_NONE when it was). Printed after the trial's fold. Worst case 218 bytes:
' tag 9 + seq 15 + trial 11 + kind 11 + l_win, r_win 14 each + l_hit, r_hit 11 each + l_emax, r_emax 12 each + l_flt,
' r_flt, l_rsy, r_rsy 11 each + win_why, flt_why 27 each (each field is 2 + its name + its width).

    recBegin(@"BM-BLKWIN")
    benchLog.numField(@"trial", blkKind + 1, LIM_TINY)
    benchLog.tokenField(@"kind", tokenAt(@tokBlk, BLK_KINDS, blkKind), TOKMAX_BLK)
    benchLog.naNumField(@"l_win", blkWinN[SLOT_LEFT], LIM_SMALL, bBlkDriven)
    benchLog.naNumField(@"r_win", blkWinN[SLOT_RIGHT], LIM_SMALL, bBlkDriven)
    benchLog.naNumField(@"l_hit", blkWinHit[SLOT_LEFT], LIM_TINY, bBlkDriven)
    benchLog.naNumField(@"r_hit", blkWinHit[SLOT_RIGHT], LIM_TINY, bBlkDriven)
    benchLog.naNumField(@"l_emax", blkWinMax[SLOT_LEFT], LIM_TINY, blkWinN[SLOT_LEFT] > 0)
    benchLog.naNumField(@"r_emax", blkWinMax[SLOT_RIGHT], LIM_TINY, blkWinN[SLOT_RIGHT] > 0)
    benchLog.naNumField(@"l_flt", blkFltN[SLOT_LEFT], LIM_TINY, bBlkEvRead)
    benchLog.naNumField(@"r_flt", blkFltN[SLOT_RIGHT], LIM_TINY, bBlkEvRead)
    benchLog.naNumField(@"l_rsy", blkRsyN[SLOT_LEFT], LIM_TINY, bBlkEvRead)
    benchLog.naNumField(@"r_rsy", blkRsyN[SLOT_RIGHT], LIM_TINY, bBlkEvRead)
    benchLog.tokenField(@"win_why", tokenAt(@tokWhy, WHY_COUNT, blkWinWhy), TOKMAX_WHY)
    benchLog.tokenField(@"flt_why", tokenAt(@tokWhy, WHY_COUNT, blkFltWhy), TOKMAX_WHY)
    emitRecord()
#endif

#ifdef DBF_GRAB
PRI emitLoad()
' BM-LOAD: the GRAB trial (PL-150) -- the lifetime, the limit's, the distance stop's and the drive's returns, command to
' both AT_SPEED, command to the grab point (SRC_REV 62), what ended its drive, its outcome, its window's length, whether
' a wheel faulted, both protective codes after it, and why. SRC_REV 69: the `trial` field is gone (one trial a run).
' Worst case under the 241 bytes it was.

    recBegin(@"BM-LOAD")
    benchLog.naNumField(@"sid", ldSid, LIM_SMALL, ldSid > 0)
    benchLog.naNumField(@"lim_err", ldLimErr, LIM_SMALL, ldSid > 0)
    benchLog.naNumField(@"arm_err", ldArmErr, LIM_SMALL, ldSid > 0)
    benchLog.naNumField(@"drv_err", ldDriveErr, LIM_SMALL, bLdDriven)
    benchLog.naNumField(@"at_ms", ldAtMs, LIM_SMALL, bLdReached)
    benchLog.naNumField(@"grab_ms", ldGrabMs, LIM_SMALL, bLdGrabbed)
    benchLog.tokenField(@"stop_by", tokenAt(@tokLdStop, LDSTOP_COUNT, ldStopBy), TOKMAX_LDSTOP)
    benchLog.tokenField(@"outcome", tokenAt(@tokLdo, LDO_COUNT, ldOutcome), TOKMAX_LDO)
    benchLog.naNumField(@"win_ms", ldWinMs, LIM_SMALL, ldWinStart >= 0)
    benchLog.boolField(@"fault", bLdFault)
    benchLog.naNumField(@"l_code", ldLeftCode, LIM_SMALL, bLdSrRead)
    benchLog.naNumField(@"r_code", ldRightCode, LIM_SMALL, bLdSrRead)
    whyField(ldWhy)
    emitRecord()

PRI emitLdFlt() | bRead
' BM-LDFLT (SRC_REV 81, FMT 53; PL-189): one GRAB trial's three new readings -- the gripped wheel's l_pct (BM-LOADW's, repeated
' because LDFLT's and LDHOLD's preconditions read it), each wheel's EV_FAULT and EV_FAULT_RESYNC counts from the grab point (LDFLT's
' value), the gripped wheel's EV_FOLDBACK events inside the judged window (fold_in) and whether its fold-back was already engaged at
' the window's start (fold_pre) -- LDPATH's premise -- and the cause each cell is not measured for (WHY_NONE when it was): LDFLT,
' LDHOLD and LDPATH. Printed after BM-LOADW. Worst case 192 bytes: tag 8 + seq 15 + l_pct 14 + l_flt, r_flt, l_rsy, r_rsy 11 each +
' fold_in 13 + fold_pre 15 + flt_why 27 + hold_why 28 + path_why 28 (each field is 2 + its name + its width).
'
' @local bRead - the window was read from the ring

    bRead := bLdFrozen and bLdDriven and (ldWinStart >= 0) and (ldWinEnd > ldWinStart)
    recBegin(@"BM-LDFLT")
    benchLog.naNumField(@"l_pct", ldPct[LOAD_GRIP_SLOT], LIM_SMALL, bRead)
    benchLog.naNumField(@"l_flt", ldFltN[SLOT_LEFT], LIM_TINY, bLdEvRead)
    benchLog.naNumField(@"r_flt", ldFltN[SLOT_RIGHT], LIM_TINY, bLdEvRead)
    benchLog.naNumField(@"l_rsy", ldRsyN[SLOT_LEFT], LIM_TINY, bLdEvRead)
    benchLog.naNumField(@"r_rsy", ldRsyN[SLOT_RIGHT], LIM_TINY, bLdEvRead)
    benchLog.naNumField(@"fold_in", ldFoldIn, LIM_TINY, bLdEvRead)
    benchLog.boolField(@"fold_pre", bLdFoldPre)
    benchLog.tokenField(@"flt_why", tokenAt(@tokWhy, WHY_COUNT, ldFltWhy), TOKMAX_WHY)
    benchLog.tokenField(@"hold_why", tokenAt(@tokWhy, WHY_COUNT, ldHoldWhy), TOKMAX_WHY)
    benchLog.tokenField(@"path_why", tokenAt(@tokWhy, WHY_COUNT, ldPathWhy), TOKMAX_WHY)
    emitRecord()

PRI emitLoadW() | bRead
' BM-LOADW: one GRAB trial's window (PL-150, PL-95) -- each wheel's hall ticks on the instrument's decode and that as a
' percentage of the command's predicted rate, their mismatch (thousandths), the path limiter's least scale over its
' polls, the polls that read each wheel SHORT, each wheel's longest tick gap (SRC_REV 62: was the left's), HELDATSPD's
' held and bad samples over both wheels, and the path limiter's reading in the drain. SRC_REV 69: the `trial` field is
' gone. SRC_REV 70 (FMT 44): `engages` is replaced by flips, the EV_PATH_LIMIT transitions (engages and releases) inside
' the judged window -- LDHUNT's value -- with engages_pre, the engages before the window (printed, not judged), and
' engaged, whether the limiter was engaged over the window (LDHUNT's precondition; flips is NA when it was not). Worst
' case 291 bytes (262 - 13 + 11 + 17 + 14): over the design's 280 target, inside the 640-byte line buffer.
'
' @local bRead - the window was read from the ring

    bRead := bLdFrozen and bLdDriven and (ldWinStart >= 0) and (ldWinEnd > ldWinStart)
    recBegin(@"BM-LOADW")
    benchLog.naNumField(@"l_ticks", ldTicks[SLOT_LEFT], LIM_TINY, bRead)
    benchLog.naNumField(@"r_ticks", ldTicks[SLOT_RIGHT], LIM_TINY, bRead)
    benchLog.naNumField(@"mis_pm", ldMisPm, LIM_SMALL, bRead)
    benchLog.naNumField(@"l_pct", ldPct[SLOT_LEFT], LIM_SMALL, bRead)
    benchLog.naNumField(@"r_pct", ldPct[SLOT_RIGHT], LIM_SMALL, bRead)
    benchLog.naNumField(@"path_min", ldPathMin, LIM_SMALL, ldPolls > 0)
    benchLog.naNumField(@"polls", ldPolls, LIM_SMALL, bLdDriven)
    benchLog.naNumField(@"l_short", ldShort[SLOT_LEFT], LIM_SMALL, bLdDriven)
    benchLog.naNumField(@"r_short", ldShort[SLOT_RIGHT], LIM_SMALL, bLdDriven)
    benchLog.naNumField(@"l_gap", ldGapMs[SLOT_LEFT], LIM_SMALL, bRead)
    benchLog.naNumField(@"r_gap", ldGapMs[SLOT_RIGHT], LIM_SMALL, bRead)
    benchLog.naNumField(@"held_n", ldHeldN, LIM_SMALL, bRead)
    benchLog.naNumField(@"held_bad", ldHeldBad, LIM_SMALL, bRead)
    benchLog.naNumField(@"flips", ldFlips, LIM_TINY, bLdEngaged)   ' NA when the limiter was not engaged over the window
    benchLog.naNumField(@"engages_pre", ldEngPre, LIM_TINY, bLdDriven)
    benchLog.boolField(@"engaged", bLdEngaged)
    emitRecord()
#endif

#endif

CON { --- ALIGN: the hall zero measured cold, cog 0, the bridge never driven (task 3590) --- }

#ifdef DBP_ALIGN
VAR { ALIGN tier state -- cog 0 only }

    ' THE LEG'S CROSSINGS ARE HELD, NOT EMITTED, UNTIL THE LEG ENDS. Stephen sets the pace by hand, so
    '  the tier must be SILENT while he turns: the guide has to stay the last line on his screen. That
    '  is why crossings are detected on the fly and raw samples are never stored -- a ring deep enough
    '  for an operator-paced leg does not exist, and one that wrapped would lose the leg's start.
    LONG    agCrossKey[ALIGN_MAX_CROSS]                     ' phase << 8 | rising << 4 | the sector's hall code
    LONG    agCrossIn[ALIGN_MAX_CROSS]                      ' sector's opening edge -> the crossing, us
    LONG    agCrossDur[ALIGN_MAX_CROSS]                     ' that sector's full duration, us; 0 while the sector is open
    LONG    agCrossTick[ALIGN_MAX_CROSS]                    ' signed tick index of the sector, so a leg's crossings order
    LONG    agBias[ALIGN_PHASES]                            ' each phase's stationary level, mV -- the level a crossing crosses
    LONG    agHyst[ALIGN_PHASES]                            ' each phase's hysteresis half-band, mV (PL-99)
    LONG    agRawSign[ALIGN_PHASES]                         ' sign of (mV - bias) at the last sample that had one; 0 before any
    LONG    agRawCt[ALIGN_PHASES]                           ' getct() of the LAST change of that sign since the band was left
    LONG    agFlipCt[ALIGN_PHASES]                          ' getct() of the FIRST such change; the crossing is timed between
    LONG    bAgFlipSeen[ALIGN_PHASES]                       ' TRUE once agFlipCt holds a flip since the band was last left
    LONG    agArm[ALIGN_PHASES]                             ' side of the band last left: +1 above, -1 below, 0 not yet left

    LONG    agLegIdx                                        ' 0..ALIGN_LEGS-1, the leg being run
    LONG    agSide                                          ' SIDE_LEFT or SIDE_RIGHT
    LONG    agAskedDir                                      ' +1 or -1: what the guide ASKED for
    LONG    agSpeed                                         ' ASPD_SLOW or ASPD_FAST
    LONG    agBiasTries                                     ' bias re-takes this leg cost
    LONG    bAgBiasStill                                    ' TRUE when a bias read completed with the wheel stationary
    LONG    agHallCode                                      ' hall code last seen
    LONG    agTicks                                         ' signed ticks since the leg's first edge
    LONG    agLastMoveMs                                    ' getms() of the last tick -- the stall test's only input
    LONG    bAgSectOpen                                     ' TRUE once the first edge has opened a sector
    LONG    agSectStartCt                                   ' getct() at the open sector's edge
    LONG    agSectHall                                      ' hall code of the open sector
    LONG    agSectSamples                                   ' samples taken inside the open sector
    LONG    agSectSampMin                                   ' fewest samples any closed sector got -- the leg's resolution
    LONG    agLastSectCt                                    ' the last KEPT sector's duration, clock ticks; 0 when there is none
    LONG    agSectors                                       ' sectors closed and kept
    LONG    agSamples                                       ' samples taken in the leg
    LONG    agCross                                         ' crossings held, pending ones included
    LONG    agPend                                          ' crossings held for the OPEN sector, resolved when it closes
    LONG    agDropped                                       ' crossings a full buffer could not keep -- must stay 0 (D2)
    LONG    agUnusable                                      ' crossings discarded with a sector too long to be a turn
    LONG    agClip                                          ' phase readings at a rail this leg -- peaks, reported as a rate
    LONG    agBandRailed                                    ' phases whose crossing band touches a rail -- disqualifies the leg
    LONG    agPeakI                                         ' worst |sense_i| this leg, mV -- the no-drive invariant
    LONG    agFirstEdgeMs                                   ' getms() of the leg's first edge -- a timestamp
    LONG    agSpanMs                                        ' first edge to last, ms -- a duration, and never the timestamp
    '  ...and bAgSectOpen is what says the span exists: both become true at the leg's first edge and
    '  neither is cleared before the next leg, so a second flag beside it would be a second name for
    '  one fact, which is the shape that drifts (D7: never let one value carry two meanings -- and
    '  never let two values carry one).
    LONG    agOutcome                                       ' ALEG_*

VAR { ALIGN sign-off accumulators -- cog 0 only }

    LONG    sfAgLegs                                        ' legs that ran
    LONG    sfAgPeakI                                       ' worst |sense_i| anywhere in the tier, mV
    LONG    sfAgBandRailed                                  ' phases whose crossing band touched a rail, across the tier
    LONG    sfAgCoverMin                                    ' fewest crossings any leg kept
    LONG    sfAgResMin                                      ' fewest samples per sector anywhere
    LONG    bSfAgCombo[ALIGN_COMBOS]                        ' wheel x MEASURED direction that returned a leg

PRI segAlign()
' ALIGN (tier dual-align, attended, task 3590): measure the hall zero Z cold. Both wheels are lifted and
' NEITHER IS EVER DRIVEN -- each is started so its driver reads the ADC, set to FLOAT at stop so the
' bridge coasts (all six FETs off), and then turned BY HAND. The phase pins carry the motor's own
' back-EMF, whose zero crossings are fixed to the rotor's magnetic frame; the angle between those
' crossings and the hall edges IS Z, over the whole circle, at zero current.
'
' No panel and no operator input: all panel work is benched, and this tier needs none -- the guide is
' plain text and the leg ends on TICKS, so the operator sets the pace and never watches a clock.
'
' Eight legs, 2 wheels x 2 directions x 2 hand speeds, run a wheel at a time so nobody walks between
' them mid-tier.

    segBegin(SEG_ALIGN)
    agLegIdx := -1                                          ' alignResetLeg() advances it, so a leg is emitted under its OWN index
    agSamples := 0                                          ' ...and leg 0 has no predecessor to emit
    sfAgPeakI := 0
    sfAgBandRailed := 0
    sfAgCoverMin := LIM_BIG
    sfAgResMin := LIM_BIG
    alignWheel(SIDE_LEFT)
    alignWheel(SIDE_RIGHT)
    alignEmitLeg()                                          ' the LAST leg has no successor to emit it, so the tier does
    alignSay(@"ALIGN done -- all eight legs attempted; stop turning")
    segEnd(segWhy())

PRI alignWheel(side) | speedIdx, dirIdx, bStarted
' Run one wheel's four legs: both directions at both hand speeds. The wheel is started once for the
' four, set to FLOAT at stop so it coasts, and stopped after them.
'
' A WHEEL THAT WOULD NOT START STILL PRINTS ITS FOUR LEGS, as NOSTART -- and they go through the SAME
' loop and the same alignLeg(), which is why there is one leg sequence here and not two. Skipping them
' would leave the matrix cell failing with nothing in the log naming which wheel, and would shift every
' later leg's index: an absence that reads as a different run (D2, a discovery failure must never
' render as a zero).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
'
' @local speedIdx - ASPD_SLOW then ASPD_FAST
' @local dirIdx - 0 for the forward leg, 1 for the reverse leg
' @local bStarted - TRUE when this wheel's driver came up

    bStarted := bWheelStart(SEG_ALIGN, side)
    if bStarted
        wheelHold(side, FALSE)                              ' SM_FLOAT: at rest the bridge is BR_COAST, which is the whole tier
    repeat speedIdx from ASPD_SLOW to ASPD_FAST
        repeat dirIdx from 0 to 1
            alignLeg(side, 1 - (dirIdx << 1), speedIdx, bStarted)
    if bStarted
        wheelStopRaw(side)

PRI alignLeg(side, askedDir, speedClass, bStarted) | biasTry
' One leg, in the order that makes the operator's screen readable and the bias trustworthy:
'
'  1. emit the leg that just finished -- its crossings and its summary, a burst he can watch scroll
'  2. settle, then read each phase's BIAS with the wheel stationary; a read during which a tick moved
'     is thrown away and re-taken. The bias is taken BEFORE the guide, not after it, so the wheel is
'     stationary BY CONSTRUCTION rather than by asking him to wait -- there is no race to lose (P10).
'  3. the guide: wheel, direction, speed, turns. It is the LAST line before the tier goes quiet.
'  4. quiet: sample until the ticks arrive, or until nothing has moved for ALIGN_STALL_MS.
'
' A leg whose wheel never started takes none of steps 2-4: it is reset, named NOSTART, and left for its
' successor to emit like any other leg.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param askedDir - +1 for the forward leg, -1 for the reverse leg; the leg is LABELLED by what it measures
' @param speedClass - ASPD_SLOW or ASPD_FAST
' @param bStarted - TRUE when this wheel's driver came up
'
' @local biasTry - bias attempts spent

    alignEmitLeg()
    alignResetLeg(side, askedDir, speedClass)
    if bStarted
        waitms(ALIGN_SETTLE_MS)
        repeat biasTry from 1 to ALIGN_BIAS_TRIES
            agBiasTries := biasTry
            bAgBiasStill := bAlignBias(side)
            if bAgBiasStill
                quit
        alignGuide()
        alignRun(side)
        alignScoreLeg()
    else
        agOutcome := ALEG_NOSTART

PRI alignResetLeg(side, askedDir, speedClass)
' Clear every per-leg accumulator before the bias read. One place, so no leg can inherit the previous
' leg's crossings, sector or counters.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param askedDir - +1 forward or -1 reverse, what the guide will ask for
' @param speedClass - ASPD_SLOW or ASPD_FAST

    agLegIdx += 1                                          ' advanced HERE, after the previous leg has been emitted under its own index
    agSide := side
    agAskedDir := askedDir
    agSpeed := speedClass
    agBiasTries := 0
    bAgBiasStill := FALSE
    agTicks := 0
    bAgSectOpen := FALSE
    agSectSamples := 0
    agSectSampMin := LIM_BIG
    agLastSectCt := 0
    agSectors := 0
    agSamples := 0
    agCross := 0
    agPend := 0
    agDropped := 0
    agUnusable := 0
    agClip := 0
    agBandRailed := 0
    agPeakI := 0
    agFirstEdgeMs := 0
    agSpanMs := 0
    agOutcome := ALEG_OK
    longfill(@agBias, 0, ALIGN_PHASES)
    longfill(@agHyst, 0, ALIGN_PHASES)
    longfill(@agRawSign, 0, ALIGN_PHASES)
    longfill(@agRawCt, 0, ALIGN_PHASES)
    longfill(@agFlipCt, 0, ALIGN_PHASES)
    longfill(@bAgFlipSeen, FALSE, ALIGN_PHASES)
    longfill(@agArm, 0, ALIGN_PHASES)

PRI bAlignBias(side) : bStill | startMs, sampleCount, startHall, phaseIdx, phaseMv[ALIGN_PHASES], sumMv[ALIGN_PHASES], minMv[ALIGN_PHASES], maxMv[ALIGN_PHASES]
' Read each phase's stationary level for ALIGN_BIAS_MS. The level a back-EMF crossing crosses is the
' phase's own reading with the rotor still -- not zero, and not assumed: a coasting phase pin sits
' wherever the sense chain puts it, and that is measured here rather than written down.
'
' The same read sizes each phase's hysteresis band (PL-99) from how far its readings strayed from their
' mean, so the band is the noise this channel actually has at this moment rather than a constant.
'
' A read during which the hall code moved is NOT a bias, so it is discarded and the caller re-takes it.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bStill - TRUE when the whole read completed with no hall movement
'
' @local startMs - getms() the read began
' @local sampleCount - samples in the read
' @local startHall - hall code when the read began
' @local phaseIdx - 0 for U, 1 for V, 2 for W
' @local phaseMv - this sample's three phase readings
' @local sumMv - each phase's total over the read
' @local minMv - each phase's lowest reading over the read
' @local maxMv - each phase's highest reading over the read

    bStill := TRUE
    sampleCount := 0
    longfill(@sumMv, 0, ALIGN_PHASES)
    longfill(@minMv, LIM_BIG, ALIGN_PHASES)
    longfill(@maxMv, 0 - LIM_BIG, ALIGN_PHASES)
    startHall := alignHallRead(side)
    startMs := getms()
    repeat
        beat(CP_LOOP_POLL)
        phaseMv[0], phaseMv[1], phaseMv[2], _ := alignTelemetry(side)
        repeat phaseIdx from 0 to ALIGN_PHASES - 1
            sumMv[phaseIdx] += phaseMv[phaseIdx]
            minMv[phaseIdx] <#= phaseMv[phaseIdx]
            maxMv[phaseIdx] #>= phaseMv[phaseIdx]
        sampleCount += 1
        if alignHallRead(side) <> startHall
            bStill := FALSE
            quit
        if (getms() - startMs) >= ALIGN_BIAS_MS
            quit
    if bStill and (sampleCount > 0)
        agBandRailed := 0
        repeat phaseIdx from 0 to ALIGN_PHASES - 1
            alignSetBand(phaseIdx, sumMv[phaseIdx] / sampleCount, minMv[phaseIdx], maxMv[phaseIdx])

PRI alignSetBand(phaseIdx, biasMv, minMv, maxMv) | noiseMv
' Set one phase's bias and hysteresis band from its stationary read, and count the phase if its band
' reaches a rail -- the crossing region is the only part of the trace Z is read from (PL-100).
'
' @param phaseIdx - 0 for U, 1 for V, 2 for W
' @param biasMv - the phase's mean stationary reading
' @param minMv - its lowest stationary reading
' @param maxMv - its highest stationary reading
'
' @local noiseMv - the larger stray of the read from its mean, either side

    noiseMv := (maxMv - biasMv) #> (biasMv - minMv)
    agBias[phaseIdx] := biasMv
    agHyst[phaseIdx] := noiseMv + ALIGN_HYST_MARGIN_MV
    if bAlignRailed(biasMv - agHyst[phaseIdx]) or bAlignRailed(biasMv + agHyst[phaseIdx])
        agBandRailed += 1

PRI alignRun(side) | nowCt, uMv, vMv, wMv, iMv, absI
' The quiet part of a leg: poll as fast as cog 0 can, and end on the ticks or on a stall. Nothing is
' emitted here -- the next leg emits this one.
'
' The two channels do NOT share a resolution, and the record says so rather than averaging them away:
' the hall code is read LIVE from the pins, so a sector edge is placed to one poll; the phase readings
' come from the driver's status block, which the driver refreshes about every 0.52 ms, so a crossing is
' placed to that. samp_sect in BM-ALEG is what a reader uses to judge either.
'
' NOTE -- THE PER-PHASE CALLS BELOW ARE NOT WORTH BATCHING, and this note is here so the next reader does not
' spend the effort finding that out. Folding the three alignClipTest() and three alignCross() calls
' into one pass would remove about eight Spin2 method dispatches per sample -- real, but it buys
' nothing HERE, because the crossing channel's resolution is set by the DRIVER's ~0.52 ms status
' refresh and not by this loop, which already oversamples it several times over. The one thing a
' faster loop would sharpen is the hall edge, and there it is worth a fraction of a degree spread
' across roughly ninety crossings. Optimising the loop would make the instrument no better.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
'
' @local nowCt - getct() of this sample, the one timestamp the sample's edge and crossings both use
' @local uMv - phase U reading
' @local vMv - phase V reading
' @local wMv - phase W reading
' @local iMv - sense current reading
' @local absI - its magnitude, against the no-drive invariant

    ' Take the reference code HERE, not from the bias read: a bias that failed all its tries never set
    '  one, and a stale code from the previous leg would read as an edge on the first sample and put a
    '  tick on the board that the wheel never turned.
    agHallCode := alignHallRead(side)
    agLastMoveMs := getms()
    repeat
        beat(CP_LOOP_POLL)
        nowCt := getct()
        alignHallStep(side, nowCt)
        uMv, vMv, wMv, iMv := alignTelemetry(side)
        absI := abs(iMv)
        agPeakI #>= absI
        agSamples += 1
        alignClipTest(uMv)
        alignClipTest(vMv)
        alignClipTest(wMv)
        if bAgSectOpen
            agSectSamples += 1
            alignCross(0, uMv, nowCt)
            alignCross(1, vMv, nowCt)
            alignCross(2, wMv, nowCt)
        if abs(agTicks) >= ALIGN_LEG_TICKS
            quit
        if (getms() - agLastMoveMs) >= ALIGN_STALL_MS
            agOutcome := ALEG_STALLED
            quit
    alignDropPending()

PRI alignHallStep(side, nowCt) | hallCode, hallDelta
' Read the hall pins and, on a code change that carries a tick, close the open sector and open the next
' one at this sample's timestamp. PINREAD reads the IN register and changes no pin configuration, so
' the running driver is not disturbed.
'
' A code change whose delta is zero is a transition the poll could not resolve; it does not move the
' sector, so its crossings stay attributed to the sector actually open.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param nowCt - this sample's getct()
'
' @local hallCode - the 3-bit code just read
' @local hallDelta - signed tick delta for the transition

    hallCode := alignHallRead(side)
    if hallCode <> agHallCode
        hallDelta := hallDeltas65[(agHallCode << HALL_CODE_BITS) | hallCode] SIGNX FIELD_ERR_SIGNBIT
        agHallCode := hallCode
        if hallDelta <> 0
            if bAgSectOpen
                alignSectorClose(nowCt)
            else
                bAgSectOpen := TRUE
                agFirstEdgeMs := getms()                    ' the measured span starts at the FIRST edge, not at the guide
            agSectStartCt := nowCt
            agSectHall := hallCode
            agSectSamples := 0
            agTicks += hallDelta
            agLastMoveMs := getms()

PRI alignSectorClose(endCt) | sectCt, crossIdx
' Close the open sector: give every crossing held inside it the sector's full duration, or discard them
' all when the sector is not a turn.
'
' A SECTOR LONGER THAN ALIGN_SECT_MAX_CT IS NOT A MEASUREMENT AND MUST NOT BECOME ONE. If the hand
' pauses mid-sector the back-EMF collapses to nothing and the "crossings" inside it are noise about the
' bias; interpolating an angle across such a sector would invent one. So they are dropped and counted,
' which is also what keeps the getct() span inside one unwrapped 32-bit difference.
'
' @param endCt - getct() of the edge that closes the sector
'
' @local sectCt - the sector's duration in clock ticks
' @local crossIdx - index of each crossing held in this sector

    sectCt := endCt - agSectStartCt
    if (sectCt > 0) and (sectCt <= ALIGN_SECT_MAX_CT)
        ' NOTE -- THE agPend > 0 GUARD IS LOAD-BEARING, not defensive. Spin2's `repeat x from a to b` takes
        '  its DIRECTION from a and b (p2kbSpin2Repeat, step_direction), so with agPend 0 the range
        '  `from agCross to agCross - 1` counts DOWN and runs twice, writing agCrossDur one past the
        '  live data and again at index agCross - 1. An empty sector is the ordinary case, not a rare one.
        if agPend > 0
            repeat crossIdx from agCross - agPend to agCross - 1
                agCrossDur[crossIdx] := sectCt / TICKS_PER_US
        agSectors += 1
        agSectSampMin <#= agSectSamples
        agLastSectCt := sectCt
    else
        agUnusable += agPend
        agCross -= agPend
        agLastSectCt := 0                                   ' a sector that was not a turn is no scale for its successor
    agPend := 0

PRI alignDropPending()
' Discard the crossings of the sector still open when the leg ended: no closing edge ever arrived, so
' they have no duration and cannot be interpolated. A crossing with no sector is not a short record, it
' is a wrong one.

    agUnusable += agPend
    agCross -= agPend
    agPend := 0

PRI alignCross(phaseIdx, phaseMv, nowCt) | rawSign, newArm
' Test one phase for a crossing of its own bias and, on one, hold the record until the sector closes.
'
' TWO THINGS ARE TRACKED, AND THEY ARE DIFFERENT (PL-99). The RAW sign of (reading - bias) flips on
' every jitter about the bias, so it only ever supplies the crossing's TIME: the midpoint of the first
' and last raw flips since the band was last left. The ARM is which side of the hysteresis band the
' reading last LEFT, and only a change of arm -- the reading leaving the band on the far side -- makes
' a crossing. Jitter inside the band moves the time and never the arm, so it cannot make a crossing,
' and the crossing it does make is timed where the signal crossed rather than where it left the band.
'
' @param phaseIdx - 0 for U, 1 for V, 2 for W
' @param phaseMv - this sample's reading for that phase
' @param nowCt - this sample's getct()
'
' @local rawSign - sign of (reading - bias) this sample
' @local newArm - the side of the band this sample is on, or the old arm while inside it

    rawSign := alignSignOf(phaseMv - agBias[phaseIdx])
    if (rawSign <> 0) and (rawSign <> agRawSign[phaseIdx])
        agRawSign[phaseIdx] := rawSign
        agRawCt[phaseIdx] := nowCt
        if bAgFlipSeen[phaseIdx] == FALSE
            agFlipCt[phaseIdx] := nowCt
            bAgFlipSeen[phaseIdx] := TRUE
    newArm := agArm[phaseIdx]
    if phaseMv > (agBias[phaseIdx] + agHyst[phaseIdx])
        newArm := 1
    elseif phaseMv < (agBias[phaseIdx] - agHyst[phaseIdx])
        newArm := -1
    if newArm <> agArm[phaseIdx]
        if agArm[phaseIdx] <> 0                             ' the first arming only chooses a side; it crosses nothing
            alignKeepCross(phaseIdx, newArm, agFlipCt[phaseIdx] + ((agRawCt[phaseIdx] - agFlipCt[phaseIdx]) / 2) - agSectStartCt)
        bAgFlipSeen[phaseIdx] := FALSE                      ' the next crossing's flips start from here
        agArm[phaseIdx] := newArm

PRI alignKeepCross(phaseIdx, crossSign, crossCt) | inUs
' Hold one crossing for the open sector, to be given the sector's duration when it closes.
'
' A CROSSING MAY BE TIMED BEFORE THE OPEN SECTOR'S EDGE. It is timed between its raw sign flips, and a
' hall edge can land between that time and the reading leaving the band -- so its t_us is NEGATIVE and
' it belongs to the sector before, placed by this one's duration. That is sound only when the two are
' about the same length, which the last kept sector's duration bounds: a flip further back than one
' whole sector, or with no kept sector before it, is not placed and is counted unusable instead.
'
' @param phaseIdx - 0 for U, 1 for V, 2 for W
' @param crossSign - +1 for a rising crossing, -1 for a falling one
' @param crossCt - clock ticks from the open sector's edge to the crossing; negative when before it
'
' @local inUs - crossCt in microseconds

    inUs := crossCt / TICKS_PER_US
    if (crossCt < 0) and ((0 - crossCt) > agLastSectCt)
        agUnusable += 1
    elseif agCross < ALIGN_MAX_CROSS
        agCrossKey[agCross] := (phaseIdx << ALIGN_KEY_PHASE_SHIFT) | ((crossSign > 0) ? ALIGN_KEY_RISING : 0) | agSectHall
        agCrossIn[agCross] := inUs
        agCrossDur[agCross] := 0
        agCrossTick[agCross] := agTicks
        agCross += 1
        agPend += 1
    else
        agDropped += 1

PRI alignClipTest(phaseMv)
' Count a phase reading sitting at a rail. This is PEAK railing -- the channel's headroom -- and it no
' longer judges the leg: a crossing is read at the bias, and whether THAT region is clean is the band
' test in alignSetBand() (PL-100). Not clamped, because it is printed as a rate, and a clamped count
' became an uninformative 99,999 on every shakedown leg.
'
' @param phaseMv - one phase reading, mV

    if bAlignRailed(phaseMv)
        agClip += 1

PRI bAlignRailed(phaseMv) : bRailed
' Whether a phase level sits at or past a rail -- the one definition both the peak count and the band
' test use, so the two cannot disagree about a level exactly on a threshold.
'
' @param phaseMv - a phase level, mV
' @returns bRailed - TRUE at or above ALIGN_CLIP_HI_MV, or at or below ALIGN_CLIP_LO_MV

    bRailed := (phaseMv >= ALIGN_CLIP_HI_MV) or (phaseMv <= ALIGN_CLIP_LO_MV)

PRI alignSignOf(nDiff) : nSign
' The sign of a difference, as the crossing test needs it: zero is its own answer, never folded into
' either side, so a reading exactly at the bias cannot invent a crossing.
'
' @param nDiff - the difference to take the sign of
' @returns nSign - +1, -1 or 0

    nSign := 0
    if nDiff > 0
        nSign := 1
    elseif nDiff < 0
        nSign := -1

PRI alignHallRead(side) : hallCode
' This wheel's 3-bit hall code, read straight from the pins.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns hallCode - the 3-bit code

    hallCode := pinread(instMotorBase(side - SIDE_LEFT) + HALL_PIN_OFFSET addpins HALL_PIN_SPAN)

PRI alignTelemetry(side) : uMv, vMv, wMv, iMv
' One wheel's three phase readings and its sense current, in a single library call.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns uMv - phase U, mV
' @returns vMv - phase V, mV
' @returns wMv - phase W, mV
' @returns iMv - sense current, mV

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT                                   ' if/else, never `? :` -- PL-29, PL-76
        _, _, iMv, uMv, vMv, wMv, _, _ := wheelR.testGetTelemetry()
    else
        _, _, iMv, uMv, vMv, wMv, _, _ := wheelL.testGetTelemetry()
    beat(CP_LIB_QUERY)

PRI alignScoreLeg() | comboIdx
' Judge the finished leg and fold it into the tier's accumulators. The leg is scored by what it
' MEASURED, never by what was asked of it: a leg turned the wrong way is good data filed correctly.
'
' A stall already named itself. Otherwise a phase whose crossing band reaches a rail disqualifies the
' leg outright, and too few crossings makes it SHORT -- both are outcomes the leg reports about itself,
' not verdicts. Peak railing does not disqualify: it cannot move a crossing (PL-100).
'
' @local comboIdx - wheel x measured direction slot this leg fills

    if bAgSectOpen
        agSpanMs := getms() - agFirstEdgeMs
    if agOutcome == ALEG_OK
        if agBandRailed > 0
            agOutcome := ALEG_CLIPPED
        elseif agCross < ALIGN_MIN_CROSS
            agOutcome := ALEG_SHORT
    sfAgLegs += 1
    sfAgPeakI #>= agPeakI
    sfAgBandRailed += agBandRailed
    if agOutcome == ALEG_OK
        sfAgCoverMin <#= agCross
        sfAgResMin <#= agSectSampMin
        comboIdx := ((agSide - SIDE_LEFT) << 1) + ((agTicks < 0) ? 1 : 0)
        bSfAgCombo[comboIdx] := TRUE

PRI alignGuide()
' The record, then THE ONE LINE THE OPERATOR ACTS ON -- and the operator's line comes LAST, because
' it is the last thing on screen before the tier goes quiet and he starts turning.
'
' THAT LINE SAYS THE WHOLE INSTRUCTION IN PLAIN WORDS: which wheel, which way, how fast. It used to
' say "see the leg, dir and speed on the BM-AGUIDE line above", which asked a person standing at the
' rig to find a comma-delimited record and decode `ask_dir,1` into a direction. Stephen, 2026-09-21:
' "too hard to figure out ... how about you say turn <wheel:left|right> <dir:forward|reverse>
' <speed:slow|fast>". A line that needs another line to be understood is not an instruction.
'
' He never has to hit a speed and never has to count: slow and fast are his own pace, the rate he
' actually turned at is measured and printed in BM-ALEG afterwards, and the leg ends on its own tick
' total -- which is why the line tells him to turn until the output resumes rather than naming a
' number he would have to track.

    recBegin(@"BM-AGUIDE")
    benchLog.numField(@"leg", agLegIdx, LIM_TINY)
    benchLog.tokenField(@"motor", sideToken(agSide), TOKMAX_MOTOR)
    benchLog.tokenField(@"ask_dir", alignDirToken(agAskedDir), TOKMAX_ADIR)
    benchLog.tokenField(@"speed", tokenAt(@tokASpd, ASPD_COUNT, agSpeed), TOKMAX_ASPD)
    benchLog.numField(@"turns", ALIGN_TURNS, LIM_TINY)
    benchLog.numField(@"ticks", ALIGN_LEG_TICKS, LIM_SMALL)
    benchLog.boolField(@"bias_still", bAgBiasStill)
    benchLog.numField(@"bias_u_mV", agBias[0], LIM_SMALL)
    benchLog.numField(@"bias_v_mV", agBias[1], LIM_SMALL)
    benchLog.numField(@"bias_w_mV", agBias[2], LIM_SMALL)
    benchLog.numField(@"hyst_u_mV", agHyst[0], LIM_SMALL)
    benchLog.numField(@"hyst_v_mV", agHyst[1], LIM_SMALL)
    benchLog.numField(@"hyst_w_mV", agHyst[2], LIM_SMALL)
    benchLog.numField(@"band_railed", agBandRailed, LIM_TINY)
    benchLog.numField(@"bias_tries", agBiasTries, LIM_TINY)
    emitRecord()
    alignSay(alignGuideLine())

PRI alignGuideLine() : pText
' The operator's line for this leg, picked whole from the eight written out in DAT.
'
' Picked rather than composed on purpose: this is the one line of the tier a person has to read
' correctly while standing at a rig with his hands on a wheel, and a string assembled from parts is
' a string that can be assembled wrong. Eight legs, eight lines, each one already complete.
'
' @returns pText - pointer to this leg's instruction

    if agSide == SIDE_RIGHT
        if agSpeed == ASPD_FAST
            pText := (agAskedDir > 0) ? @sAgRightFwdFast : @sAgRightRevFast
        else
            pText := (agAskedDir > 0) ? @sAgRightFwdSlow : @sAgRightRevSlow
    else
        if agSpeed == ASPD_FAST
            pText := (agAskedDir > 0) ? @sAgLeftFwdFast : @sAgLeftRevFast
        else
            pText := (agAskedDir > 0) ? @sAgLeftFwdSlow : @sAgLeftRevSlow

PRI alignDirToken(nDir) : pTok
' A direction as a word, for every ALIGN record that carries one.
'
' @param nDir - positive for forward, negative or zero for reverse
' @returns pTok - FORWARD or REVERSE

    if nDir > 0
        pTok := tokenAt(@tokADir, ADIR_COUNT, ADIR_FORWARD)
    else
        pTok := tokenAt(@tokADir, ADIR_COUNT, ADIR_REVERSE)

#endif

#ifdef DBG_SAY
PRI alignSay(pText)
' One plain operator line. No panel: all PLOT/panel work is benched, and this tier needs none. The PACK part's lines
' come through here too (task 3611): its steps also end on what a sensor sees, not on a key or a click.
'
' @param pText - pointer to the text to show

    beat(CP_EMIT)
    debug(zstr_(pText))
    beat(CP_EMIT)
#endif

#ifdef DBP_ALIGN
PRI alignEmitLeg() | crossIdx
' Emit the leg that just finished: every kept crossing, then the leg's own summary. Nothing is emitted
' while the operator is turning, so this burst is what he sees between legs.
'
' EVERY leg is emitted by its successor, run or not -- a NOSTART or STALLED leg is a result and prints
' one. The only silent call is the first, before leg 0 exists, which agLegIdx < 0 selects.
'
' @local crossIdx - index of each kept crossing

    if agLegIdx >= 0
        ' NOTE -- same load-bearing guard as alignSectorClose(): with agCross 0 the range `from 0 to -1`
        '  counts DOWN and emits two records from outside the live data. A leg with no crossings is an
        '  ordinary outcome here -- NOSTART has none by definition, and a stall can end one early.
        if agCross > 0
            repeat crossIdx from 0 to agCross - 1
                alignEmitCross(crossIdx)
        alignEmitSummary()

PRI alignEmitCross(crossIdx)
' One resolved back-EMF crossing. Z IS COMPUTED OFF-BOARD FROM t_us AND dur_us: the crossing's place
' inside its hall sector is t_us/dur_us of 60 electrical degrees, which is sound because 60 electrical
' degrees is only 4 degrees of wheel on a 15-pole-pair hub. No fit runs here -- a board that fitted its
' own data would be reporting a conclusion the log could not be re-read to check (D9).
'
' t_us MAY BE NEGATIVE: the crossing then precedes this sector's opening edge and lies in the sector
' before it, placed on this one's duration (alignKeepCross()). The reader subtracts, never discards.
'
' @param crossIdx - index of the crossing to emit

    recBegin(@"BM-ACROSS")
    benchLog.numField(@"leg", agLegIdx, LIM_TINY)
    benchLog.tokenField(@"motor", sideToken(agSide), TOKMAX_MOTOR)
    benchLog.numField(@"phase", agCrossKey[crossIdx] >> ALIGN_KEY_PHASE_SHIFT, LIM_TINY)
    benchLog.boolField(@"rising", agCrossKey[crossIdx] & ALIGN_KEY_RISING)
    benchLog.numField(@"hall", agCrossKey[crossIdx] & ALIGN_KEY_HALL_MASK, LIM_TINY)
    benchLog.numField(@"tick", agCrossTick[crossIdx], LIM_SMALL)
    benchLog.numField(@"t_us", agCrossIn[crossIdx], LIM_BIG)
    benchLog.numField(@"dur_us", agCrossDur[crossIdx], LIM_BIG)
    emitRecord()

PRI alignEmitSummary() | rateX10, railPm
' The finished leg in one record: what it was asked for, what it MEASURED, and every count a reader
' needs to decide whether its crossings are a measurement.
'
' edge_s_x10 is the rate the operator actually turned at, in hall edges per second x10. It is reported
' rather than commanded, and it is the number that separates the 2x2's two speeds -- hall hysteresis is
' a fixed ANGLE and the input filter's delay a fixed TIME, so only a real speed difference between the
' slow and brisk legs can tell them apart.
'
' rail_pm is peak railing per thousand phase readings -- the channel's headroom, reported and not
' judged (PL-100); band_railed is what judges.
'
' @local rateX10 - measured hall edge rate, edges/s x10
' @local railPm - railed phase readings per thousand taken

    rateX10 := 0
    if bAgSectOpen and (agSpanMs > 0)
        rateX10 := (abs(agTicks) * MS_PER_SEC * 10) / agSpanMs
    railPm := 0
    if agSamples > 0
        railPm := (agClip * ALIGN_PER_MILLE) / (agSamples * ALIGN_PHASES)
    recBegin(@"BM-ALEG")
    benchLog.numField(@"leg", agLegIdx, LIM_TINY)
    benchLog.tokenField(@"motor", sideToken(agSide), TOKMAX_MOTOR)
    benchLog.tokenField(@"speed", tokenAt(@tokASpd, ASPD_COUNT, agSpeed), TOKMAX_ASPD)
    benchLog.tokenField(@"ask_dir", alignDirToken(agAskedDir), TOKMAX_ADIR)
    benchLog.tokenField(@"meas_dir", alignDirToken(agTicks), TOKMAX_ADIR)
    benchLog.numField(@"ticks", agTicks, LIM_SMALL)
    benchLog.naNumField(@"span_ms", agSpanMs, LIM_BIG, bAgSectOpen)
    benchLog.naNumField(@"edge_s_x10", rateX10, LIM_BIG, rateX10 > 0)
    benchLog.numField(@"samples", agSamples, LIM_BIG)
    benchLog.numField(@"sectors", agSectors, LIM_SMALL)
    benchLog.naNumField(@"samp_sect", agSectSampMin, LIM_SMALL, agSectors > 0)
    benchLog.numField(@"cross", agCross, LIM_SMALL)
    benchLog.numField(@"unusable", agUnusable, LIM_SMALL)
    benchLog.numField(@"dropped", agDropped, LIM_SMALL)
    benchLog.naNumField(@"rail_pm", railPm, LIM_SMALL, agSamples > 0)
    benchLog.numField(@"band_railed", agBandRailed, LIM_TINY)
    benchLog.numField(@"peak_i_mV", agPeakI, LIM_SMALL)
    benchLog.boolField(@"bias_still", bAgBiasStill)
    benchLog.tokenField(@"outcome", tokenAt(@tokALeg, ALEG_COUNT, agOutcome), TOKMAX_ALEG)
    emitRecord()

PRI bAlignMatrix() : bAllFour | comboIdx
' Whether all four wheel x measured-direction combinations returned a leg. The 2x2 is the instrument's
' design, not its coverage: averaging the two DIRECTIONS is what cancels hall hysteresis and filter
' delay, both of which make an edge late in the direction of travel. Three of four legs is not
' three-quarters of the measurement -- it is a Z with an uncancelled bias in it.
'
' @returns bAllFour - TRUE when every combination has a leg
'
' @local comboIdx - each wheel x direction slot

    bAllFour := TRUE
    repeat comboIdx from 0 to ALIGN_COMBOS - 1
        if bSfAgCombo[comboIdx] == FALSE
            bAllFour := FALSE

PRI emitAlignCells()
' The ALIGN tier's five SIGNOFF verdicts. The first is the safety invariant; the next two can
' disqualify a reading; the last two say whether the matrix the instrument needs was actually covered.
' Each is NOMEAS when no leg ran, so a tier that never started cannot print a clean sheet.

    emitSignoff(@sSfCellAgNoDrv, SIDE_NONE, @sSfCritAgNoDrv, sfAgLegs > 0, sfAgPeakI, ALIGN_NODRIVE_LO, ALIGN_NODRIVE_HI, sfAgLegs, @sSfUnitsMv)
    emitSignoff(@sSfCellAgClip, SIDE_NONE, @sSfCritAgClip, sfAgLegs > 0, sfAgBandRailed, ALIGN_CLIP_LO, ALIGN_CLIP_HI, sfAgLegs, @sSfUnitsCount)
    emitSignoff(@sSfCellAgCover, SIDE_NONE, @sSfCritAgCover, sfAgCoverMin < LIM_BIG, sfAgCoverMin, ALIGN_COVER_LO, ALIGN_COVER_HI, sfAgLegs, @sSfUnitsCount)
    emitSignoff(@sSfCellAgRes, SIDE_NONE, @sSfCritAgRes, sfAgResMin < LIM_BIG, sfAgResMin, ALIGN_RES_LO, ALIGN_RES_HI, sfAgLegs, @sSfUnitsCount)
    emitSignoffBool(@sSfCellAgMatrix, SIDE_NONE, @sSfCritAgMatrix, sfAgLegs > 0, bAlignMatrix(), ALIGN_COMBOS)

#endif

CON { --- REG: PL-151's part-B half, pointed -- TURNDIST, FLTCAUSE and FLTRETRY in one short load (SRC_REV 54) --- }

  ' WHAT THIS PART IS FOR. PL-151 found three 6.0 API claims whose evidence is stale or missing: driveForDistance(left,
  '  right) stopping each wheel at its own distance (R17-DUAL-TURNDIST-B, last PASS at Visit 6a on the pre-R18.4 driver),
  '  getFaultCause() (R17-DUAL-FLTCAUSE-B, never a PASS), and PL-66's retry -- the same power sent again after a fault
  '  clears it and drives (R16-DUAL-FLTRETRY-B, never measured). Part B carries all three inside a 20-minute load of
  '  everything else. This part runs only them, wheels up and unattended, in under a minute (STEPHEN 2026-09-26: "our
  '  bench run tests should not be an accumulation of all the tests we've ever run"), and declares those same three
  '  cells: the collation lets the latest build that declares a cell speak.
  '
  ' THE ORDER IS THE CONSTRUCTION.
  '  1. TURNDIST -- one steering lifetime: part B's two turn trials, overshootTrial() unchanged (driveForDistance(10, 2)
  '     and (2, 10) ft at OVERSHT_POWER), judged as part B judges them: each wheel at rest within STOP_LIMIT_HI ticks of
  '     its OWN target, in the platform frame. Negative: the unfixed library stopped both wheels at the shorter
  '     distance, so the long wheel rested hundreds of ticks short and fails.
  '  2. FLTCAUSE's negative -- in that same lifetime, after those two healthy drives: getFaultCause() reads FC_NONE on
  '     both wheels. Measured only when the turn trials ran and nothing faulted in them.
  '  3. FLTCAUSE and FLTRETRY -- one forced fault per wheel, LEFT then RIGHT, each in a steering lifetime of its own (a
  '     start re-inits the cause, the fault response and the driver's sticky fault flag, so the second trial cannot read
  '     the first one's fault). The fault response is set to FR_SHIPPED so the fault LATCHES (DCS_FAULTED): PL-66 is
  '     about a latched fault, and FR_GRADED's re-synced stop zeroes the command itself, which would make the retry a
  '     change of command and prove nothing. Both wheels are driven at REG_POWER to AT_SPEED; testLeftForceFault() or
  '     testRightForceFault() (PL-119: the safe, repeatable provocation) faults ONE wheel on its next driven frame; the
  '     platform comes to rest (the faulted wheel coasts, the steering front cog stops its partner along its ramp); then
  '     getStatus() and getFaultCause() are read as the fault left them, and the SAME power is commanded again.
  '      FLTCAUSE - the faulted wheel reads FC_LAG (the halls are legal: testForceFault()'s own contract) and its
  '                 partner, which only stopped, reads FC_NONE. Negatives: step 2, and the partner in every trial. A
  '                 cause that is never written, or written to the wrong wheel, or FC_HALL, fails.
  '      FLTRETRY - measured when the faulted wheel read DS_FAULTED before the retry; PASS when driveAtPower() of the
  '                 same power returned NO_ERROR and both wheels reached DCS_AT_SPEED within D_AT_SPEED_MS. Negative:
  '                 PL-66's mechanism -- the driver keeps a repeated request standing and stays FAULTED -- never reaches
  '                 speed and fails.
  '     THE RETRY'S WAIT IGNORES THE FAULT FLAG. The driver's fault flag is sticky until clearFaultSignal() or a restart
  '     (isp_bldc_motor.spin2 clearFaultSignal(), S-5), so waitWatched() would end the retry's wait on the very fault
  '     being retried from. regWaitSpeed() keeps the absolute-current abort and the instrument stall and waits for
  '     AT_SPEED itself. (Part B's fltApiRetry() waits through waitWatched(), and so cannot pass on a driver that
  '     behaves -- recorded in the SRC_REV 54 note, not changed here.)
    REG_POWER             = FLTAPI_POWER                    ' 50: part B's fault-API power, both wheels
    REG_BRAKE_PCT         = wheelL.BRAKE_PCT_DEFAULT        ' FR_SHIPPED ignores it; the driver's own default is written
    ' testForceFault() returns once the front cog took the request (1 ms); the driver faults on its next driven pass and
    '  the instrument mirrors the flag within one 2 ms sample (FR_PROVOKE_MS's derivation: about 4 ms). 100 ms is 25x.
    REG_LATCH_MS          = 100
    ' the platform's rest after the fault: the partner's ramp from half speed (~730 ms MEASURED, FR_PLAT_RAMP_MS's
    '  note), REST_CONFIRM_MS of stillness, and a margin; a lifted wheel's free coast from half speed is shorter.
    '  SRC_REV 59 (DRIVER_REV 38): the jerk-limited ramp from REG_POWER's 81.7 x 10^6 is 1_108 ms (DERIVED, the
    '  S-curve's v / A + A / J), and with REST_CONFIRM_MS still inside this bound
    REG_REST_MS           = 3_000
    REG_TRIALS            = 2                               ' one forced fault per wheel
    REG_BAD_LO            = 0
    REG_BAD_HI            = 0

#ifdef DBP_REG
VAR { REG state -- cog 0 only }

    ' the forced-fault trial in hand (regFaultTrial())
    LONG    rfSid                                           ' the trial's steering life, 0 when it did not start
    LONG    rfForceErr                                      ' testLeftForceFault() / testRightForceFault()'s return
    LONG    rfModeErr                                       ' setFaultResponse(FR_SHIPPED)'s return
    LONG    bRfLatched                                      ' the fault flag reached the mirror inside REG_LATCH_MS
    LONG    rfLatchMs                                       ' ...ms from the force
    LONG    bRfRest                                         ' the platform was confirmed at rest after the fault
    LONG    rfStat[INST_MOTORS]                             ' getStatus() per wheel, as the fault left the platform
    LONG    rfCause[INST_MOTORS]                            ' getFaultCause() per wheel, then
    LONG    bRfRetried                                      ' the same power was commanded again
    LONG    rfRetryErr                                      ' ...driveAtPower()'s return
    LONG    bRfSpeed                                        ' both wheels then reached DCS_AT_SPEED
    LONG    rfRetryMs                                       ' ...ms from the retry command
    LONG    rfWhy                                           ' why the trial measured nothing, WHY_NONE when it ran
    ' the cells' accumulators (all zero at load: this part's VAR is read by nothing else)
    LONG    bRegNegRan                                      ' FLTCAUSE's negative was read
    LONG    bRegNegOk                                       ' ...and both wheels read FC_NONE
    LONG    regNegCause[INST_MOTORS]
    LONG    regCauseN                                       ' forced faults that latched, and whose causes read wrong
    LONG    regCauseBad
    LONG    regRetryN                                       ' retries from a fault the API reported latched, and those that
    LONG    regRetryBad                                     '  did not reach speed

PRI segRegress() | turnIdx, whyCode, sid, side
' REGRESS (part REG, PL-151): the turn trials and FLTCAUSE's negative in one steering lifetime, then one forced-fault
' lifetime per wheel (the section's CON says why this order). Both wheel objects are stopped first (shared pin claims,
' PL-18), as OVERSHT does.
'
' @local turnIdx - 0 the left wheel long, 1 the right wheel long
' @local whyCode - why the remaining turn trials are skipped, WHY_NONE while they run
' @local sid - the first steering start's life, 0 when it did not start
' @local side - SIDE_LEFT then SIDE_RIGHT, the wheel faulted

    segBegin(SEG_REGRESS)
    wheelStop(SIDE_LEFT)
    wheelStop(SIDE_RIGHT)
    whyCode := WHY_NONE
    sid := 0
    if bRunContinue(SEG_REGRESS) == FALSE
        whyCode := WHY_ABORTED
    elseif bSteerStart(SEG_REGRESS) == FALSE
        whyCode := WHY_NO_COG
    else
        sid := steerLife
        beat(CP_LIB_STEER_DRIVE)
        steering.setMaxSpeedForDistance(OVERSHT_POWER)
        beat(CP_LIB_STEER_DRIVE)
    repeat turnIdx from 0 to OVERSHT_TURNS - 1
        beat(CP_LOOP_POLL)
        whyCode := overshootTrial(SEG_REGRESS, sid, lookupz(turnIdx: OVERSHT_FT_LONG, OVERSHT_FT_SHORT), lookupz(turnIdx: OVERSHT_FT_SHORT, OVERSHT_FT_LONG), whyCode)
    regCauseNegative(sid)
    bInstIdle()
    steerStop()
    repeat side from SIDE_LEFT to SIDE_RIGHT
        beat(CP_LOOP_POLL)
        regFaultTrial(side)
    segEnd(segWhy())

PRI regCauseNegative(sid) | eLeftCause, eRightCause
' FLTCAUSE's negative: after the turn trials' healthy drives, getFaultCause() must read FC_NONE on both wheels. Read only
' when the steering object is up, a turn trial was measured, and nothing faulted in the segment so far (a fault there
' would make the drive not a healthy one); BM-REGNEG either way.
'
' @param sid - the steering start's life, 0 when it did not start
'
' @local eLeftCause - the left wheel's FC_*
' @local eRightCause - the right wheel's FC_*

    eLeftCause := wheelL.FC_NONE
    eRightCause := wheelL.FC_NONE
    if bSteerUp and (sfTurnN > 0) and (segFaults == 0)
        beat(CP_LIB_STEER_QUERY)
        eLeftCause, eRightCause := steering.getFaultCause()
        beat(CP_LIB_STEER_QUERY)
        bRegNegRan := TRUE
        bRegNegOk := (eLeftCause == wheelL.FC_NONE) and (eRightCause == wheelL.FC_NONE)
    regNegCause[SLOT_LEFT] := eLeftCause
    regNegCause[SLOT_RIGHT] := eRightCause
    emitRegNeg(sid)

PRI regFaultTrial(side) | slotIdx, otherIdx, tid, safeEvent, bReached, startMs
' One forced-fault trial on {side} (the section's CON, step 3): its own steering lifetime; FR_SHIPPED on both wheels; arm
' the instrument on the steering source (its mirror carries the fault flag and the states); both wheels at REG_POWER to
' AT_SPEED; the forced fault on {side} only, watched for REG_LATCH_MS; the platform to rest; getStatus() and
' getFaultCause() as the fault left it; the same power again, and the wait for both wheels at AT_SPEED; stop, rest,
' BM-REGFLT, fold, and the lifetime ends (steerStop(): the next start re-inits the fault response and the fault flag).
'
' @param side - the wheel faulted: SIDE_LEFT or SIDE_RIGHT
'
' @local slotIdx - the faulted wheel's slot
' @local otherIdx - its partner's
' @local tid - the trial's id, printed in BM-REGFLT
' @local safeEvent - SAFE_* from the watched waits
' @local bReached - both wheels reached AT_SPEED before the force
' @local startMs - getms() at the force, then at the retry

    slotIdx := side - SIDE_LEFT
    otherIdx := SLOT_RIGHT - slotIdx
    tid := nextTraceId()
    rfSid := 0
    rfForceErr := NO_ERROR
    rfModeErr := NO_ERROR
    bRfLatched := FALSE
    rfLatchMs := 0
    bRfRest := FALSE
    rfStat[SLOT_LEFT] := wheelL.DS_Unknown
    rfStat[SLOT_RIGHT] := wheelL.DS_Unknown
    rfCause[SLOT_LEFT] := wheelL.FC_NONE
    rfCause[SLOT_RIGHT] := wheelL.FC_NONE
    bRfRetried := FALSE
    rfRetryErr := NO_ERROR
    bRfSpeed := FALSE
    rfRetryMs := 0
    rfWhy := WHY_NONE
    if bRunContinue(SEG_REGRESS) == FALSE
        rfWhy := WHY_ABORTED
    elseif bSteerStart(SEG_REGRESS) == FALSE
        rfWhy := WHY_NO_COG
    else
        rfSid := steerLife
        rfModeErr := steerSetFaultResponse(wheelL.FR_SHIPPED, REG_BRAKE_PCT)
        if bInstArm(INST_SRC_STEER, 1) == FALSE
            rfWhy := WHY_INST_NOACK
        elseif bSteerDriveBoth(SEG_REGRESS, tid, REG_POWER) == FALSE
            rfWhy := WHY_SYNC_PRECOND
        else
            safeEvent, bReached := waitWatched(SIDE_BOTH, D_AT_SPEED_MS, CP_LOOP_ATSPEED, UNTIL_AT_SPEED)
            if safeEvent <> SAFE_NONE
                rfWhy := safeWhy(safeEvent)
            elseif bReached == FALSE
                rfWhy := WHY_STEADY_TIMEOUT
            else
                instMark()
                startMs := getms()
                rfForceErr := steerForceFault(side)
                ' this lifetime holds no fault but the one forced, so the first SAFE_FAULT is the latch; an absolute-current
                '  read over the abort stops the whole steering object (safetyPoll(SIDE_BOTH))
                safeEvent, _ := waitWatched(SIDE_BOTH, REG_LATCH_MS, CP_LOOP_CAPTURE, UNTIL_TIME)
                if safeEvent == SAFE_FAULT
                    bRfLatched := TRUE
                    rfLatchMs := getms() - startMs
                    safeEvent, bRfRest := waitRest(SIDE_BOTH, REG_REST_MS, FALSE)
                    if safeEvent <> SAFE_NONE
                        rfWhy := safeWhy(safeEvent)
                    elseif bSteerUp
                        regReadAfter()
                        regRetry()
                elseif safeEvent == SAFE_NONE
                    rfWhy := WHY_NO_FAULT                   ' the forced fault never latched: the hook failed
                else
                    rfWhy := safeWhy(safeEvent)
        if bSteerUp
            steerStopMotors()
            waitRest(SIDE_BOTH, STOP_TIMEOUT_MS, FALSE)      ' the fault flag stays set: rest, not a fault, ends the wait
    emitRegFlt(tid, side)
    regFold(slotIdx, otherIdx)
    segItems := (segItems + 1) <# LIM_SMALL
    bInstIdle()
    steerStop()

PRI regReadAfter() | eLeftStatus, eRightStatus, eLeftCause, eRightCause
' The reads that must see the platform as the fault left it, before the retry changes it: getStatus() and getFaultCause()
' per wheel, through the public API a user would call.
'
' @local eLeftStatus - left DS_*
' @local eRightStatus - right DS_*
' @local eLeftCause - left FC_*
' @local eRightCause - right FC_*

    beat(CP_LIB_STEER_QUERY)
    eLeftStatus, eRightStatus := steering.getStatus()
    eLeftCause, eRightCause := steering.getFaultCause()
    beat(CP_LIB_STEER_QUERY)
    rfStat[SLOT_LEFT] := eLeftStatus
    rfStat[SLOT_RIGHT] := eRightStatus
    rfCause[SLOT_LEFT] := eLeftCause
    rfCause[SLOT_RIGHT] := eRightCause

PRI regRetry() | startMs, safeEvent
' PL-66: THE SAME POWER, COMMANDED AGAIN, clears the fault and drives. driveAtPower(REG_POWER, REG_POWER) -- the very call
' the trial drove with -- and a wait of at most D_AT_SPEED_MS for both wheels at DCS_AT_SPEED (regWaitSpeed()).
'
' @local startMs - getms() at the retry command
' @local safeEvent - SAFE_* from the wait

    bRfRetried := TRUE
    curIncre := 0
    startMs := getms()
    beat(CP_LIB_STEER_DRIVE)
    rfRetryErr := steering.driveAtPower(REG_POWER, REG_POWER)
    beat(CP_LIB_STEER_DRIVE)
    if rfRetryErr == NO_ERROR
        safeEvent, bRfSpeed := regWaitSpeed(D_AT_SPEED_MS)
        if bRfSpeed
            rfRetryMs := getms() - startMs
        elseif safeEvent <> SAFE_NONE
            rfWhy := safeWhy(safeEvent)

PRI regWaitSpeed(boundMs) : safeEvent, bReached | startMs
' waitWatched(SIDE_BOTH, boundMs, CP_LOOP_ATSPEED, UNTIL_AT_SPEED) pass for pass, except that the fault flag does not end
' it: the flag is sticky until a restart (the section's CON), so it still carries the fault being retried from. The
' absolute-current abort and a stalled instrument end it as they end every watched wait.
'
' @param boundMs - the wait's bound
' @returns safeEvent - SAFE_ABS_ABORT or SAFE_INST_STALL when one ended the wait, SAFE_NONE otherwise
' @returns bReached - TRUE when both wheels' mirrors read DCS_AT_SPEED
'
' @local startMs - getms() when the wait began

    safetyReset()
    safeEvent := SAFE_NONE
    bReached := FALSE
    startMs := getms()
    repeat
        beat(CP_LOOP_ATSPEED)
        waitms(SAMPLE_MS)
        safeEvent := safetyPoll(SIDE_BOTH)
        if safeEvent == SAFE_FAULT
            safeEvent := SAFE_NONE
        bReached := bMirrorAllInState(SIDE_BOTH, DCS_AT_SPEED)
        if (safeEvent <> SAFE_NONE) or bReached or ((getms() - startMs) >= boundMs)
            quit

PRI regFold(slotIdx, otherIdx)
' Fold one forced-fault trial into FLTCAUSE and FLTRETRY (the section's CON).
'
' @param slotIdx - the faulted wheel's slot
' @param otherIdx - its partner's

    if bRfLatched and bRfRetried
        regCauseN := (regCauseN + 1) <# LIM_SMALL
        if (rfCause[slotIdx] <> wheelL.FC_LAG) or (rfCause[otherIdx] <> wheelL.FC_NONE)
            regCauseBad := (regCauseBad + 1) <# LIM_SMALL
        if rfStat[slotIdx] == wheelL.DS_FAULTED              ' PL-66's precondition: the API reported the fault latched
            regRetryN := (regRetryN + 1) <# LIM_SMALL
            if (rfRetryErr <> NO_ERROR) or (bRfSpeed == FALSE)
                regRetryBad := (regRetryBad + 1) <# LIM_SMALL

PRI emitRegNeg(sid)
' BM-REGNEG: FLTCAUSE's negative -- each wheel's getFaultCause() after the turn trials' healthy drives. Worst case 108
' bytes: tag(9) + seq(15) + sid(10) + turns(12) + ran(9) + l_cause(13) + r_cause(13) + ok(8) + why(23).
'
' @param sid - the steering start's life

    recBegin(@"BM-REGNEG")
    benchLog.numField(@"sid", sid, LIM_SMALL)
    benchLog.numField(@"turns", sfTurnN, LIM_TINY)
    benchLog.boolField(@"ran", bRegNegRan)
    benchLog.tokenField(@"l_cause", tokenAt(@tokFltCause, FC_COUNT, regNegCause[SLOT_LEFT]), TOKMAX_FCAUSE)
    benchLog.tokenField(@"r_cause", tokenAt(@tokFltCause, FC_COUNT, regNegCause[SLOT_RIGHT]), TOKMAX_FCAUSE)
    benchLog.boolField(@"ok", bRegNegOk)
    if bRegNegRan
        whyField(WHY_NONE)
    elseif bSteerUp == FALSE
        whyField(WHY_NO_COG)
    elseif segFaults <> 0
        whyField(WHY_FAULTED)
    else
        whyField(WHY_NOT_REACHED)
    emitRecord()

PRI emitRegFlt(tid, side)
' BM-REGFLT: one forced-fault trial -- the force, its latch, the platform's status and cause per wheel as the fault left
' it, and the same-power retry. Worst case 262 bytes: tag(9) + seq(15) + tid(12) + sid(10) + motor(12) + f_err(14) +
' latched(14) + latch_ms(17) + rest(11) + l_stat(15) + r_stat(15) + l_cause(13) + r_cause(13) + r_err(14) + retried(14)
' + speed(12) + retry_ms(17) + why(23).
'
' @param tid - the trial's id
' @param side - the wheel faulted

    recBegin(@"BM-REGFLT")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.numField(@"sid", rfSid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"f_err", rfForceErr, LIM_SMALL)
    benchLog.boolField(@"latched", bRfLatched)
    benchLog.naNumField(@"latch_ms", rfLatchMs, LIM_SMALL, bRfLatched)
    benchLog.boolField(@"rest", bRfRest)
    benchLog.tokenField(@"l_stat", statusToken(rfStat[SLOT_LEFT]), TOKMAX_STAT)
    benchLog.tokenField(@"r_stat", statusToken(rfStat[SLOT_RIGHT]), TOKMAX_STAT)
    benchLog.tokenField(@"l_cause", tokenAt(@tokFltCause, FC_COUNT, rfCause[SLOT_LEFT]), TOKMAX_FCAUSE)
    benchLog.tokenField(@"r_cause", tokenAt(@tokFltCause, FC_COUNT, rfCause[SLOT_RIGHT]), TOKMAX_FCAUSE)
    benchLog.numField(@"r_err", rfRetryErr, LIM_SMALL)
    benchLog.boolField(@"retried", bRfRetried)
    benchLog.boolField(@"speed", bRfSpeed)
    benchLog.naNumField(@"retry_ms", rfRetryMs, LIM_SMALL, bRfSpeed)
    whyField(rfWhy)
    emitRecord()

PRI emitRegCells()
' Part REG's three cells after its own two, each part B's id with part B's criterion token (the section's CON):
'  TURNDIST - COUNT (BOTH): the worse wheel's |rest - its own target| over the turn trials, platform frame, 0..STOP_LIMIT_HI
'  FLTCAUSE - BOOL (BOTH): measured when both forced faults latched and the negative was read; TRUE when every faulted
'             wheel read FC_LAG, every partner FC_NONE, and both wheels FC_NONE after the healthy drives
'  FLTRETRY - BOOL (BOTH): measured when both faulted wheels read DS_FAULTED before their retry; TRUE when both retries
'             returned NO_ERROR and reached AT_SPEED

    emitSignoff(@sSfCellTurnDist, SIDE_BOTH, @sSfCritTurnDist, sfTurnN > 0, sfTurnMax, STOP_LIMIT_LO, STOP_LIMIT_HI, sfTurnN, @sSfUnitsCount)
    emitSignoffBool(@sSfCellFltCause, SIDE_BOTH, @sSfCritFltCause, bRegNegRan and (regCauseN == REG_TRIALS), bRegNegOk and (regCauseBad == 0), regCauseN + 1)
    emitSignoffBool(@sSfCellFltRetry, SIDE_BOTH, @sSfCritFltRetry, regRetryN == REG_TRIALS, regRetryBad == 0, regRetryN)
#endif

CON { --- KICK: the speed-change kick at the top of the range, pointed (SRC_REV 54; PL-78, PL-87) --- }

  ' WHAT THIS PART IS FOR. The driver's arrival pass skipped the field's increment for one pass at the end of every ramp
  '  (the kick PL-78 / PL-87 chased); the fix advances the field on that pass. Its certificate is the transition current,
  '  on exactly the transitions that carried the worst kicks MEASURED on the pre-fix driver: at the top of the range,
  '  71-214 sense mV above the steady peak (Visit 8b / 9: debug_260922-161317.log, 64-183 mV on these seven, both wheels,
  '  both directions; debug_260922-185255.log). Part A walks the whole ladder in about 13 minutes; this part walks only
  '  these seven, per wheel and direction, in under two minutes.
  '
  ' THE MEASUREMENT IS PART A'S, UNCHANGED. Each rung is ladderSign()'s: rungMeasure() with the ladder's own timings
  '  (LADDER_STEADY_MS, LADDER_SETTLE_MS, WINDOW_MS), so tr_i_over here is the same reading as the pre-fix logs'. Per
  '  wheel and direction one lifetime walks kickIdx: from rest to 120 x 10^6 (a start, not judged), then the speed-ups
  '  120->140, 140->147, 147->155, 155->165 and the slow-downs 165->155, 155->147, 147->140 (x 10^6). R21-DUAL-TRKICK-T
  '  is judged per wheel exactly as R17-DUAL-TRKICK-A is: the running peak tr_i_over over the judged transitions,
  '  PASS at TRKICK_EXCESS_MV (50 sense mV) or under. Negative: the pre-fix driver's 64-183 mV on these transitions fails.
  '  SRC_REV 59 (DRIVER_REV 38, PL-160), THE STIMULUS CHECKED AND KEPT: each transition is still a command from one
  '  steady rung to the next, and the transition window still runs from the command's mark to the steady window
  '  (rungMeasure(): AT_SPEED, then LADDER_SETTLE_MS). The jerk-limited ramp changes only the ramp between them: a
  '  step of 7-10 x 10^6 is now a triangle of acceleration (under A^2 / J, 16.2 x 10^6 up and 24.0 x 10^6 down, so it
  '  never holds its limit), about 2 x sqrt(dv / J) passes -- 0.3-0.4 s, where the stepped ramp's took about 0.45 s --
  '  the 20 x 10^6 step 120 -> 140 holds accel_up briefly, and the start from rest to 120 x 10^6 takes about 4_000
  '  passes (2.1 s), inside LADDER_STEADY_MS. Its peak acceleration, sqrt(J x dv) on the small steps (22_000-27_000 a
  '  pass up, 26_000-32_000 down) and 33_958 on 120 -> 140, is comparable to the stepped ramp's up (its growing step
  '  reached about 21_000-30_000 by the end of these steps) and far under its fixed 50_000 down, so a transition loads
  '  the drive no harder than the pre-fix runs whose kicks this cell was set against; the arrival pass still advances
  '  the field (DRIVER_REV 34's fix, kept in jerkStep). The criterion and its negative are unchanged.
  '
  ' WHAT THE SHUNT CANNOT SEE. A slow-down can kick by regeneration, which drives current back into the bus and so
  '  under-reads, or reads negative, on the DC-link shunt. So each transition also prints BM-KICKTR from the same frozen
  '  ring: the signed position-error extremes and the error sample of largest magnitude (tr_err_spk, sign kept), the
  '  lowest sense_i (tr_i_min, negative under regeneration), and the duty over the transition against the steady
  '  window's mean (duty_exc: the excursion of larger magnitude, signed). No cell judges them: they are the readings a
  '  deceleration kick would show where tr_i_over cannot.
    KICK_STEPS            = 8                               ' entries in kickIdx
    KICK_RUNG_LO          = 7                               ' ladderIncre index of 120 x 10^6, the walk's lowest speed
    KICK_RUNG_HI          = 11                              ' ...and of 165 x 10^6, its highest

#ifdef DBP_KICK
DAT ' ---- KICK tables ----

' the walk, as indices into ladderIncre: 120 from rest, up through 140, 147, 155 to 165, then down to 140
kickIdx         LONG    7, 8, 9, 10, 11, 10, 9, 8

VAR { KICK state -- cog 0 only }

    LONG    ktN                                             ' up samples in the transition
    LONG    ktErrMin                                        ' the lowest signed err over it
    LONG    ktErrMax                                        ' ...the highest
    LONG    ktErrSpk                                        ' the sample of largest |err|, its sign kept
    LONG    ktIMin                                          ' the lowest signed sense_i, mV
    LONG    ktDutyMin                                       ' the lowest duty
    LONG    ktDutyMax                                       ' ...and the highest
    LONG    ktWhy                                           ' WHY_NONE when the kt* values are a measurement

PRI segKick() | side, signMul
' KICK (part KICK): per motor x sign, one lifetime over kickIdx -- ladderSign(), the ladder's own walk, rungs and records
' (the section's CON).
'
' @local side - SIDE_LEFT then SIDE_RIGHT
' @local signMul - SIGN_NEG then SIGN_POS

    segBegin(SEG_KICK)
    repeat side from SIDE_LEFT to SIDE_RIGHT
        repeat signMul from SIGN_NEG to SIGN_POS step SIGN_STEP
            beat(CP_LOOP_POLL)
            ladderSign(SEG_KICK, side, signMul, @kickIdx, KICK_STEPS)
    segEnd(segWhy())

PRI kickStats(slotIdx) | sampleIdx, startJ, endJ, errNow, iNow, dutyNow
' BM-KICKTR's readings, from the same transition interval transitionStats() walks -- the command mark to the window's start
' -- in the ring rungMeasure() froze. Legal only while it is FROZEN (I10): ladderSign() calls this before any recovery can
' restart the wheel and re-arm it. Samples whose driver was not up are left out (I3). A command sample the ring has
' overwritten is NA (WHY_RING_LOST_HEAD), as transitionStats() says it.
'
' @param slotIdx - motor slot under test
'
' @local sampleIdx - logical index
' @local startJ - logical index of the command's sample
' @local endJ - logical index of the last sample before the window
' @local errNow - this sample's signed err
' @local iNow - this sample's signed sense_i
' @local dutyNow - this sample's duty

    ktN := 0
    ktErrMin := 0
    ktErrMax := 0
    ktErrSpk := 0
    ktIMin := 0
    ktDutyMin := 0
    ktDutyMax := 0
    if (bRgCaptured == FALSE) or (rgCmdStart < 0) or (rgWinStart <= rgCmdStart)
        ktWhy := WHY_NO_SAMPLES
    else
        drainBegin()
        if drStored == 0
            ktWhy := WHY_NO_SAMPLES
        elseif rgCmdStart < drLostHead
            ktWhy := WHY_RING_LOST_HEAD
        else
            ktWhy := WHY_NONE
            startJ := rgCmdStart - drLostHead
            endJ := (rgWinStart - 1 - drLostHead) <# (drStored - 1)
            if endJ >= startJ
                repeat sampleIdx from startJ to endJ
                    beat(CP_LOOP_DRAIN)
                    if bSmpUp(sampleIdx, slotIdx)
                        errNow := smpErr(sampleIdx, slotIdx)
                        iNow := smpI(sampleIdx, slotIdx)
                        dutyNow := smpDuty(sampleIdx, slotIdx)
                        if ktN == 0
                            ktErrMin := errNow
                            ktErrMax := errNow
                            ktErrSpk := errNow
                            ktIMin := iNow
                            ktDutyMin := dutyNow
                            ktDutyMax := dutyNow
                        else
                            ktErrMin <#= errNow
                            ktErrMax #>= errNow
                            if abs(errNow) > abs(ktErrSpk)
                                ktErrSpk := errNow
                            ktIMin <#= iNow
                            ktDutyMin <#= dutyNow
                            ktDutyMax #>= dutyNow
                        ktN += 1
            if ktN == 0
                ktWhy := WHY_NO_SAMPLES

PRI emitKickTr(rid, side, motorIncre) | dutyExc, whyCode
' BM-KICKTR: one transition's signed readings beside its BM-RUNGTR (the section's CON). duty is the steady window's mean
' (BM-RUNG2's), and duty_exc the transition's excursion from it of larger magnitude, signed: positive above the steady
' duty, negative below. Worst case 267 bytes: tag(9) + seq(15) + rid(12) + motor(12) + incre(19) + from_incre(24) +
' tr_err_spk(16) + tr_err_min(16) + tr_err_max(16) + tr_i_min(17) + tr_duty_min(20) + tr_duty_max(20) + duty(13) +
' duty_exc(17) + tr_i_over(18) + why(23).
'
' @param rid - rung id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
'
' @local dutyExc - the signed excursion
' @local whyCode - the rung's why when it did not run clean, else the transition's own

    dutyExc := ktDutyMax - rsDutyMean
    if (rsDutyMean - ktDutyMin) > dutyExc
        dutyExc := ktDutyMin - rsDutyMean
    whyCode := rgWhy
    if whyCode == WHY_NONE
        whyCode := ktWhy
    recBegin(@"BM-KICKTR")
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"from_incre", rgFromIncre, LIM_BIG)
    benchLog.naNumField(@"tr_err_spk", ktErrSpk, LIM_TINY, ktWhy == WHY_NONE)
    benchLog.naNumField(@"tr_err_min", ktErrMin, LIM_TINY, ktWhy == WHY_NONE)
    benchLog.naNumField(@"tr_err_max", ktErrMax, LIM_TINY, ktWhy == WHY_NONE)
    benchLog.naNumField(@"tr_i_min", ktIMin, LIM_SMALL, ktWhy == WHY_NONE)
    benchLog.naNumField(@"tr_duty_min", ktDutyMin, LIM_SMALL, ktWhy == WHY_NONE)
    benchLog.naNumField(@"tr_duty_max", ktDutyMax, LIM_SMALL, ktWhy == WHY_NONE)
    benchLog.naNumField(@"duty", rsDutyMean, LIM_SMALL, bRgWindowValid)
    benchLog.naNumField(@"duty_exc", dutyExc, LIM_SMALL, (ktWhy == WHY_NONE) and bRgWindowValid)
    benchLog.naNumField(@"tr_i_over", trIOver(), LIM_SMALL, bTrIOverValid())
    whyField(whyCode)
    emitRecord()

PRI emitKickCells() | slotIdx
' Part KICK's cell after its own two: R21-DUAL-TRKICK-T per motor, R17-DUAL-TRKICK-A's criterion over this part's
' judged transitions (the running peak tr_i_over, sense mV, PASS at TRKICK_HI or under; NOMEAS when none was judged).
'
' @local slotIdx - motor slot

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        emitSignoff(@sSfCellTrKickT, SIDE_LEFT + slotIdx, @sSfCritTrKick, sfTrN[slotIdx] > 0, sfTrKickPk[slotIdx], TRKICK_LO, TRKICK_HI, sfTrN[slotIdx], @sSfUnitsMv)
#endif

CON { --- instrument cog: runs in its own cog; no debug() anywhere below it (I1) --- }

PRI instrument() | dueCt, slackTicks, seenSeq
' The instrument cog (design sec 2). Paces itself on an absolute getct() schedule and never calls
' waitct() without positive slack; services cog 0's commands once per pass; reads both motors and the
' hall pins whenever it is not IDLE; stores one sample in instDecimate while RUN or FREEZE. Holds no
' lock, emits nothing, commands no motor. After EXIT it parks until cog 0 stops it (I4).
'
' @local dueCt - getct() the next sample is due at
' @local slackTicks - dueCt - getct(), signed (a GETCT difference is wrap-safe)
' @local seenSeq - instCmdSeq read once this pass

    isDecimCount := 0
    isFreezeLeft := 0
    isFreezeSeq := 0
    instState := INST_ST_IDLE
    dueCt := getct() + INST_PERIOD_TICKS
    repeat
        instHeartbeat += 1
        if instState == INST_ST_EXITED
            waitms(INST_EXIT_POLL_MS)
        else
            seenSeq := instCmdSeq
            if (seenSeq <> instAckSeq) and ((instState <> INST_ST_FREEZE) or (seenSeq <> isFreezeSeq))
                instExecute(seenSeq)
            if instState <> INST_ST_EXITED
                slackTicks := dueCt - getct()
                if slackTicks > INST_MIN_SLACK_US * TICKS_PER_US
                    waitct(dueCt)
                    dueCt += INST_PERIOD_TICKS
                elseif slackTicks > 0
                    dueCt += INST_PERIOD_TICKS              ' on time, too close to the target to wait on
                else
                    instCountLate(0 - slackTicks)
                    if (0 - slackTicks) >= INST_PERIOD_TICKS
                        dueCt := getct() + INST_PERIOD_TICKS  ' re-base; the skipped periods were counted
                    else
                        dueCt += INST_PERIOD_TICKS
                if instState <> INST_ST_IDLE
                    instSample()

PRI instExecute(seenSeq) | motorIdx
' Execute one cog-0 command, write the resulting state, then the ack (instrument cog). A FREEZE with
' post-samples is acked later, by instSample(), when they are stored. A command not legal from the
' current state is acked with the state unchanged; cog 0 checks the state it asked for.
'
' @param seenSeq - the instCmdSeq this command was read under
'
' @local motorIdx - motor slot

    case instCmd
        INST_CMD_ARM:
            if (instState == INST_ST_IDLE) or (instState == INST_ST_FROZEN)
                instW := 0
                instTotal := 0
                instMarkTotal := -1                         ' no mark belongs to this capture until cog 0 marks
                instMarkAckSeq := instMarkSeq
                instLate := 0
                instSkipped := 0
                instMaxLateTicks := 0
                instClamps := 0
                instIntegSat := 0
                repeat motorIdx from SLOT_LEFT to SLOT_RIGHT
                    instHwSkip[motorIdx] := 0
                    isHwPos[motorIdx] := 0
                    isHallCode[motorIdx] := pinread(instMotorBase(motorIdx) + HALL_PIN_OFFSET addpins HALL_PIN_SPAN)
                    isIgPrev[motorIdx] := -1                ' seeded by the first stored sample
                    isLagLive[motorIdx] := (PART_ID <> PART_SPIN)   ' SRC_REV 70: a floor leg's LAGBND starts at its command (instPackFlags())
                    instLvlMin[motorIdx] := POSX
                    instLvlMax[motorIdx] := NEGX
                    instLvlN[motorIdx] := 0
                isDecimCount := 0
                instState := INST_ST_RUN
        INST_CMD_FREEZE:
            if instState == INST_ST_RUN
                isFreezeLeft := instArg0
                isFreezeSeq := seenSeq
                instState := (isFreezeLeft > 0) ? INST_ST_FREEZE : INST_ST_FROZEN
        INST_CMD_IDLE:
            if instState <> INST_ST_EXITED
                instState := INST_ST_IDLE
        INST_CMD_EXIT:
            instState := INST_ST_EXITED
    if instState <> INST_ST_FREEZE
        instAckSeq := seenSeq

PRI instCountLate(lateTicks)
' Count one sample that started after its due time (instrument cog): late only past INST_LATE_TICKS,
' the largest lateness, and whole periods with no sample. Every counter saturates at LIM_BIG (I2).
'
' @param lateTicks - how far past its due time the sample starts, in ticks (> 0)

    if instState <> INST_ST_IDLE
        if lateTicks > INST_LATE_TICKS
            instLate := (instLate + 1) <# LIM_BIG
            instRunLate := (instRunLate + 1) <# LIM_BIG
        instMaxLateTicks #>= lateTicks
        instRunMaxLateTicks #>= lateTicks
        if lateTicks >= INST_PERIOD_TICKS
            instSkipped := (instSkipped + (lateTicks / INST_PERIOD_TICKS)) <# LIM_BIG
            instRunSkipped := (instRunSkipped + (lateTicks / INST_PERIOD_TICKS)) <# LIM_BIG

PRI instSample() | motorIdx, sampleCt, seenMarkSeq
' Record a new mark's ring total, read the hall pins and the source once, refresh the last-sample
' mirror, and store a decimated sample while RUN or FREEZE (instrument cog). The mark check comes first,
' before this pass reads or stores anything, so instMarkTotal is the total index of the first stored
' sample taken at or after the mark (sec 12.7: the mark is located by ring index, never by time).
'
' @local motorIdx - motor slot
' @local sampleCt - getct() at the start of the sample, stored as t
' @local seenMarkSeq - instMarkSeq read once this pass

    seenMarkSeq := instMarkSeq
    if seenMarkSeq <> instMarkAckSeq
        instMarkTotal := instTotal                          ' total first, then the ack cog 0 waits on
        instMarkAckSeq := seenMarkSeq
    sampleCt := getct()
    repeat motorIdx from SLOT_LEFT to SLOT_RIGHT
        instReadHall(motorIdx)
    instReadSource()
    repeat motorIdx from SLOT_LEFT to SLOT_RIGHT
        instLastUp[motorIdx] := isUp[motorIdx]
        instLastI[motorIdx] := isUp[motorIdx] ? isSenseI[motorIdx] : 0
        instLastState[motorIdx] := isUp[motorIdx] ? isState[motorIdx] : DCS_UNKNOWN
        instLastFault[motorIdx] := isUp[motorIdx] ? isFault[motorIdx] : FALSE
        instLastPos[motorIdx] := isPos[motorIdx]
        instLastHw[motorIdx] := isHwPos[motorIdx]
    if (instState == INST_ST_RUN) or (instState == INST_ST_FREEZE)
        if isDecimCount == 0
            instStore(sampleCt)
            if instState == INST_ST_FREEZE
                isFreezeLeft -= 1
                if isFreezeLeft <= 0
                    instState := INST_ST_FROZEN
                    instAckSeq := isFreezeSeq
        isDecimCount += 1
        if isDecimCount >= instDecimate
            isDecimCount := 0

PRI instReadHall(motorIdx) | hallCode, hallDelta
' Decode one motor's hall inputs into hwPos with the local deltas65 copy (instrument cog). PINREAD reads
' the IN register and changes no pin configuration, so a running driver is not disturbed (Q4). A code
' change with a zero delta that touches no illegal code is a transition the poll could not resolve:
' counted in instHwSkip, never silent.
'
' @param motorIdx - motor slot
'
' @local hallCode - the 3-bit hall code just read
' @local hallDelta - signed tick delta from hallDeltas65

    hallCode := pinread(instMotorBase(motorIdx) + HALL_PIN_OFFSET addpins HALL_PIN_SPAN)
    if hallCode <> isHallCode[motorIdx]
        hallDelta := hallDeltas65[(isHallCode[motorIdx] << HALL_CODE_BITS) | hallCode] SIGNX FIELD_ERR_SIGNBIT
        if (hallDelta == 0) and (bHallCodeLegal(hallCode) == TRUE) and (bHallCodeLegal(isHallCode[motorIdx]) == TRUE)
            instHwSkip[motorIdx] := (instHwSkip[motorIdx] + 1) <# LIM_BIG
        isHwPos[motorIdx] += hallDelta
        isHallCode[motorIdx] := hallCode

PRI bHallCodeLegal(hallCode) : bLegal
' Report whether a 3-bit hall code is one a working sensor set can produce.
'
' @param hallCode - 3-bit hall code
' @returns bLegal - FALSE for %000 and %111

    bLegal := (hallCode <> HALL_CODE_ILLEGAL_LO) and (hallCode <> HALL_CODE_ILLEGAL_HI)

PRI instReadSource() | lvlU, lvlV, lvlW
' Read the status block of the source latched at ARM, per motor, gated on the driver running (I3):
' WHEELS by testGetMotorCog() <> 0, STEER by the driver state <> DCS_Unknown (stop() writes it after
' its cogstop). Every call here is debug-free (I1, design sec 1 citations). Instrument cog.
'
' @local lvlU - PWMCLIP: phase U's high-side level (LIMITS build only)
' @local lvlV - PWMCLIP: phase V's
' @local lvlW - PWMCLIP: phase W's

    case instSrc
        INST_SRC_WHEELS:
            isUp[SLOT_LEFT] := (wheelL.testGetMotorCog() <> 0)
            if isUp[SLOT_LEFT]
                isDuty[SLOT_LEFT], isErr[SLOT_LEFT], isSenseI[SLOT_LEFT], isSenseU[SLOT_LEFT], isSenseV[SLOT_LEFT], isSenseW[SLOT_LEFT], isState[SLOT_LEFT], isFault[SLOT_LEFT] := wheelL.testGetTelemetry()
                isPos[SLOT_LEFT] := wheelL.getRawHallTicks()
                isMissed[SLOT_LEFT], isIllegal[SLOT_LEFT] := wheelL.getHallIntegrityCounts()
                if INST_TRACKS_LEVELS and (isDecimCount == 0)                  ' only a pass that stores folds them
                    lvlU, lvlV, lvlW := wheelL.testGetDriveLevels()
                    isLvlLo[SLOT_LEFT] := lvlU <# lvlV <# lvlW
                    isLvlHi[SLOT_LEFT] := lvlU #> lvlV #> lvlW
            isUp[SLOT_RIGHT] := (wheelR.testGetMotorCog() <> 0)
            if isUp[SLOT_RIGHT]
                isDuty[SLOT_RIGHT], isErr[SLOT_RIGHT], isSenseI[SLOT_RIGHT], isSenseU[SLOT_RIGHT], isSenseV[SLOT_RIGHT], isSenseW[SLOT_RIGHT], isState[SLOT_RIGHT], isFault[SLOT_RIGHT] := wheelR.testGetTelemetry()
                isPos[SLOT_RIGHT] := wheelR.getRawHallTicks()
                isMissed[SLOT_RIGHT], isIllegal[SLOT_RIGHT] := wheelR.getHallIntegrityCounts()
                if INST_TRACKS_LEVELS and (isDecimCount == 0)
                    lvlU, lvlV, lvlW := wheelR.testGetDriveLevels()
                    isLvlLo[SLOT_RIGHT] := lvlU <# lvlV <# lvlW
                    isLvlHi[SLOT_RIGHT] := lvlU #> lvlV #> lvlW
        INST_SRC_STEER:
            isState[SLOT_LEFT], isState[SLOT_RIGHT] := steering.testGetDriverState()
            isUp[SLOT_LEFT] := (isState[SLOT_LEFT] <> DCS_UNKNOWN)
            isUp[SLOT_RIGHT] := (isState[SLOT_RIGHT] <> DCS_UNKNOWN)
            if isUp[SLOT_LEFT]
                isDuty[SLOT_LEFT], isErr[SLOT_LEFT], isSenseI[SLOT_LEFT], isSenseU[SLOT_LEFT], isSenseV[SLOT_LEFT], isSenseW[SLOT_LEFT], isState[SLOT_LEFT], isFault[SLOT_LEFT] := steering.testLeftGetTelemetry()
            if isUp[SLOT_RIGHT]
                isDuty[SLOT_RIGHT], isErr[SLOT_RIGHT], isSenseI[SLOT_RIGHT], isSenseU[SLOT_RIGHT], isSenseV[SLOT_RIGHT], isSenseW[SLOT_RIGHT], isState[SLOT_RIGHT], isFault[SLOT_RIGHT] := steering.testRightGetTelemetry()
            if isUp[SLOT_LEFT] or isUp[SLOT_RIGHT]
                isPos[SLOT_LEFT], isPos[SLOT_RIGHT] := steering.testGetRawHallTicks()
                isMissed[SLOT_LEFT], isIllegal[SLOT_LEFT], isMissed[SLOT_RIGHT], isIllegal[SLOT_RIGHT] := steering.getHallIntegrityCounts()
        other:
            isUp[SLOT_LEFT] := FALSE
            isUp[SLOT_RIGHT] := FALSE

PRI instStore(sampleCt) | ringBase, motorIdx, motorOff
' Store one sample at the next ring index (instrument cog). The ring is circular: past
' INST_RING_SAMPLES the oldest sample is overwritten, and cog 0 reports the excess as lost_head.
'
' @param sampleCt - getct() at the start of this sample
'
' @local ringBase - first long of this sample in ring[]
' @local motorIdx - motor slot
' @local motorOff - first long of this motor's four longs

    instW := instTotal +// INST_RING_SAMPLES
    ringBase := instW * INST_SAMPLE_LONGS
    ring[ringBase + SMP_T] := sampleCt
    repeat motorIdx from SLOT_LEFT to SLOT_RIGHT
        motorOff := ringBase + SMP_MOTOR_BASE + (motorIdx * SMP_MOTOR_LONGS)
        ring[motorOff + SMP_POS] := isUp[motorIdx] ? isPos[motorIdx] : 0
        ring[motorOff + SMP_SENSE], ring[motorOff + SMP_PHVW] := instPackSense(motorIdx)
        ring[motorOff + SMP_FLAGS] := instPackFlags(motorIdx)
        ring[motorOff + SMP_HW] := isHwPos[motorIdx]
        ' PWMCLIP (task 3604): a stored sample's levels, folded where the sample itself is, and only while the
        '  drive is applying them -- a faulted bridge coasts or shorts whatever the levels read
        if INST_TRACKS_LEVELS and isUp[motorIdx] and (isFault[motorIdx] == FALSE)
            instLvlMin[motorIdx] <#= isLvlLo[motorIdx]
            instLvlMax[motorIdx] #>= isLvlHi[motorIdx]
            instLvlN[motorIdx] := (instLvlN[motorIdx] + 1) <# LIM_BIG
    instTotal := (instTotal + 1) <# LIM_BIG
    instRunSamples := (instRunSamples + 1) <# LIM_BIG

PRI instClamp(fieldValue, lowLimit, highLimit) : clampedValue
' Clamp one stored field to its width, counting the clamp (instrument cog; I2).
'
' @param fieldValue - the reading
' @param lowLimit - smallest storable value
' @param highLimit - largest storable value
' @returns clampedValue - fieldValue inside lowLimit..highLimit

    clampedValue := (fieldValue #> lowLimit) <# highLimit
    if clampedValue <> fieldValue
        instClamps := (instClamps + 1) <# LIM_BIG
        instRunClamps := (instRunClamps + 1) <# LIM_BIG

PRI instPackSense(motorIdx) : senseLong, phaseLong | senseMv, uMv, vMv, wMv
' Pack i and the THREE phase voltages into two longs (instrument cog).
'
' The three are carried apart, not summed. Their sum is a bus-voltage estimator and it discards
'  exactly the per-phase difference a rotor-angle estimate needs; smpPh() re-derives the sum, so
'  every reading that wanted it still has it.
'
' @param motorIdx - motor slot
' @returns senseLong - i << 16 | phase U & $FFFF; 0 when the driver is not up
' @returns phaseLong - phase V << 16 | phase W & $FFFF; 0 when the driver is not up
'
' @local senseMv - clamped sense_i
' @local uMv - clamped phase U
' @local vMv - clamped phase V
' @local wMv - clamped phase W

    senseLong := 0
    phaseLong := 0
    if isUp[motorIdx]
        senseMv := instClamp(isSenseI[motorIdx], 0 - FIELD_I16_MAX, FIELD_I16_MAX)
        uMv := instClamp(isSenseU[motorIdx], 0 - FIELD_I16_MAX, FIELD_I16_MAX)
        vMv := instClamp(isSenseV[motorIdx], 0 - FIELD_I16_MAX, FIELD_I16_MAX)
        wMv := instClamp(isSenseW[motorIdx], 0 - FIELD_I16_MAX, FIELD_I16_MAX)
        senseLong := (senseMv << SENSE_I_SHIFT) | (uMv & SENSE_PH_MASK)
        phaseLong := (vMv << SENSE_I_SHIFT) | (wMv & SENSE_PH_MASK)

PRI instPackFlags(motorIdx) : flagsLong | dutyVal, errVal, igNow, igDelta
' Pack duty, err, state, fault, up and the integrity delta since the previous stored sample into one
' long (instrument cog). The delta saturates at INTEG_DELTA_MAX; a saturation is counted.
'
' @param motorIdx - motor slot
' @returns flagsLong - duty << 16 | err << 8 | state << 5 | fault << 4 | up << 3 | integDelta
'
' @local dutyVal - clamped duty
' @local errVal - clamped err
' @local igNow - missed + illegal now
' @local igDelta - events since the previous stored sample

    flagsLong := 0
    if isUp[motorIdx]
        dutyVal := instClamp(isDuty[motorIdx], 0, FIELD_DUTY_MAX)
        errVal := instClamp(isErr[motorIdx], FIELD_ERR_MIN, FIELD_ERR_MAX)
        igNow := isMissed[motorIdx] + isIllegal[motorIdx]
        igDelta := 0
        if isIgPrev[motorIdx] >= 0
            igDelta := (igNow - isIgPrev[motorIdx]) #> 0
            if igDelta > INTEG_DELTA_MAX
                igDelta := INTEG_DELTA_MAX
                instIntegSat := (instIntegSat + 1) <# LIM_BIG
        isIgPrev[motorIdx] := igNow
        ' LAGBOUND (task 3558): the lag limiter's invariant, folded here because this is the one place a
        '  stored sample's err is already in hand. A faulted sample is left out -- the fault is what the
        '  limiter exists to prevent, and its err is the state after the driver gave up, not under control
        '  -- and so is a sample inside a deliberate provocation window. SRC_REV 70 (part SPIN, the floor): and so is a
        '  sample before the wheel's command has acted -- the pre-roll's resting rotor error (-111 on the coast trial at
        '  rest) is not a lag the limiter failed to hold; the wheel leaving DCS_STOPPED starts the bound.
        if isState[motorIdx] <> DCS_STOPPED
            isLagLive[motorIdx] := TRUE
        if (isFault[motorIdx] == FALSE) and (bInstLagExempt == FALSE) and isLagLive[motorIdx]
            instLagMax[motorIdx] #>= abs(errVal)
            instLagN[motorIdx] := (instLagN[motorIdx] + 1) <# LIM_BIG
        flagsLong := (dutyVal << FLAG_DUTY_SHIFT) | ((errVal & FIELD_BYTE_MASK) << FLAG_ERR_SHIFT)
        flagsLong |= ((isState[motorIdx] & FLAG_STATE_MASK) << FLAG_STATE_SHIFT)
        flagsLong |= ((isFault[motorIdx] <> FALSE) ? (1 << FLAG_FAULT_BIT) : 0)
        flagsLong |= (1 << FLAG_UP_BIT) | igDelta

PRI instMotorBase(motorIdx) : basePin
' Base pin of a motor slot's board (shared by both cogs; reads only constants).
'
' @param motorIdx - motor slot
' @returns basePin - LEFT_TEST_BASE or RIGHT_TEST_BASE

    basePin := (motorIdx == SLOT_RIGHT) ? RIGHT_TEST_BASE : LEFT_TEST_BASE

CON { --- instrument control, cog 0 side (design sec 2.4, 2.5) --- }

PRI instStart() | startMs, bAcked
' Start the instrument cog once for the run (I4), prove it answers a command, and emit BM-INST.
'
' @local startMs - getms() before the first command
' @local bAcked - the first IDLE command was acknowledged

    benchLog.cogEventBegin()
    instCogId := cogspin(NEWCOG, instrument(), @instStack)
    benchLog.cogEventEnd()
    if instCogId < 0
        emitInst(INST_EV_NOSTART, 0, FALSE, WHY_NO_COG)
    else
        startMs := getms()
        bAcked := bInstCommand(INST_CMD_IDLE, 0, 0, INST_ACK_TIMEOUT_MS)
        if bAcked
            emitInst(INST_EV_START, getms() - startMs, TRUE, WHY_NONE)
        else
            emitInst(INST_EV_NOACK, 0, FALSE, WHY_INST_NOACK)

PRI instStop() | startMs, bAcked
' Stop the instrument cooperatively at run end: EXIT, bounded wait for the ack, then cogstop (I4).
' Without an ack the cogstop still runs: the instrument holds no lock and emits no debug (I1, I4).
'
' @local startMs - getms() before the EXIT command
' @local bAcked - the EXIT command was acknowledged

    if instCogId >= 0
        startMs := getms()
        bAcked := bInstCommand(INST_CMD_EXIT, 0, 0, INST_ACK_TIMEOUT_MS)
        benchLog.cogEventBegin()
        cogstop(instCogId)
        emitInst(INST_EV_STOP, getms() - startMs, bAcked, bAcked ? WHY_NONE : WHY_INST_NOACK)
        instCogId := -1

PRI bInstCommand(cmdCode, argFirst, argSecond, timeoutMs) : bAcked | startMs
' Send one command and wait, bounded and beating CP_INST_ACK every SAMPLE_MS, for its ack. The
' arguments are written first, then the command, then the sequence number the instrument watches.
'
' @param cmdCode - INST_CMD_* value
' @param argFirst - instArg0
' @param argSecond - instArg1
' @param timeoutMs - the longest wait for the ack
' @returns bAcked - TRUE when instAckSeq reached this command's sequence number
'
' @local startMs - getms() when the command was sent

    bAcked := FALSE
    if instCogId >= 0
        instArg0 := argFirst
        instArg1 := argSecond
        instArg2 := 0
        instCmd := cmdCode
        instCmdSeq += 1
        startMs := getms()
        repeat
            beat(CP_INST_ACK)
            if instAckSeq == instCmdSeq
                bAcked := TRUE
                quit
            if (getms() - startMs) >= timeoutMs
                quit
            waitms(SAMPLE_MS)

PRI bInstQuiet() : bQuiet
' Report whether the instrument has acknowledged IDLE or FROZEN (or is not running): the only states in
' which cog 0 may start, stop or switch a wheel, or drain the ring (I10).
'
' @returns bQuiet - TRUE when a wheel may be touched

    bQuiet := (instCogId < 0) or ((instAckSeq == instCmdSeq) and ((instState == INST_ST_IDLE) or (instState == INST_ST_FROZEN)))

PRI bInstArm(eSource, decimation) : bArmed
' Arm a capture on a source, legal only from IDLE or FROZEN. A missing ack emits BM-INST NOACK.
'
' @param eSource - INST_SRC_* value
' @param decimation - store one sample in this many (1..INST_DECIM_MAX)
' @returns bArmed - TRUE when the instrument acknowledged RUN

    bArmed := FALSE
    if (instCogId >= 0) and bInstQuiet()
        instSrc := eSource
        instDecimate := (decimation #> 1) <# INST_DECIM_MAX
        if bInstCommand(INST_CMD_ARM, eSource, instDecimate, INST_ACK_TIMEOUT_MS)
            bArmed := (instState == INST_ST_RUN)
        else
            emitInst(INST_EV_NOACK, INST_ACK_TIMEOUT_MS, FALSE, WHY_INST_NOACK)

PRI bInstFreeze(postSamples) : bFrozen | timeoutMs
' Freeze the capture after postSamples more stored samples. The ack bound covers the post samples.
'
' @param postSamples - samples to store after the command (0: freeze now)
' @returns bFrozen - TRUE when the instrument acknowledged FROZEN
'
' @local timeoutMs - ack bound: INST_ACK_TIMEOUT_MS plus the post samples' own duration

    bFrozen := (instCogId >= 0) and (instAckSeq == instCmdSeq) and (instState == INST_ST_FROZEN)
    if (bFrozen == FALSE) and (instCogId >= 0) and (instState == INST_ST_RUN)
        timeoutMs := INST_ACK_TIMEOUT_MS + ((postSamples #> 0) * instDecimate * MS_PER_SEC) / INST_RATE_HZ
        if bInstCommand(INST_CMD_FREEZE, postSamples #> 0, 0, timeoutMs)
            bFrozen := (instState == INST_ST_FROZEN)
        else
            emitInst(INST_EV_NOACK, timeoutMs, FALSE, WHY_INST_NOACK)

PRI bInstIdle() : bIdle
' Return the instrument to IDLE: it stops storing and stops reading any wheel.
'
' @returns bIdle - TRUE when IDLE is acknowledged (or no instrument runs)

    bIdle := (instCogId < 0) or ((instAckSeq == instCmdSeq) and (instState == INST_ST_IDLE))
    if bIdle == FALSE
        if bInstCommand(INST_CMD_IDLE, 0, 0, INST_ACK_TIMEOUT_MS)
            bIdle := (instState == INST_ST_IDLE)
        else
            emitInst(INST_EV_NOACK, INST_ACK_TIMEOUT_MS, FALSE, WHY_INST_NOACK)

PRI instIdleForShutdown()
' Before the end-of-run stops, return the instrument to IDLE so no wheel is stopped under it (I10).

    bInstIdle()

PRI instMark()
' Mark an event immediately before its library call. The instrument records the ring total on its
' next pass (instMarkTotal); instMarkCt is kept only for timing within one sample period (sec 12.7).

    instMarkCt := getct()
    instMarkSeq += 1

PRI instMarkIndex() : markTotal | startMs
' Mark a window boundary and wait, bounded and beating CP_INST_ACK every SAMPLE_MS, for the instrument
' to record the ring total at the mark (sec 12.7). A window is delimited by two of these totals.
'
' @returns markTotal - total index of the first sample stored at or after the mark, -1 when not recorded
'
' @local startMs - getms() when the mark was written

    markTotal := -1
    instMark()
    startMs := getms()
    repeat
        beat(CP_INST_ACK)
        if instMarkAckSeq == instMarkSeq
            markTotal := instMarkTotal
            quit
        if (getms() - startMs) >= INST_ACK_TIMEOUT_MS
            quit
        waitms(SAMPLE_MS)

CON { --- cog-0 safety monitor and watched waits (design sec 2.8) --- }

PRI safetyReset() | slotIdx
' Start a watched wait: clear the consecutive-current counts and take the heartbeat baseline.
'
' @local slotIdx - motor slot

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        safeAbsCount[slotIdx] := 0
    safeLastHeartbeat := instHeartbeat
    safeLastHeartbeatMs := getms()

PRI safetyPoll(side) : safeEvent | slotIdx
' One safety read of the instrument's last-sample mirror (no library getter). An absolute current at or
' above ABS_ABORT_MV on ABS_ABORT_SAMPLES consecutive reads stops that wheel FIRST, then emits BM-ABORT.
' Precedence: ABS_ABORT, then INST_STALL, then FAULT.
'
' @param side - SIDE_LEFT, SIDE_RIGHT or SIDE_BOTH: which motors are watched
' @returns safeEvent - SAFE_* value
'
' @local slotIdx - motor slot

    safeEvent := SAFE_NONE
    if instHeartbeat <> safeLastHeartbeat
        safeLastHeartbeat := instHeartbeat
        safeLastHeartbeatMs := getms()
    elseif (getms() - safeLastHeartbeatMs) >= INST_STALL_MS
        safeEvent := SAFE_INST_STALL
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        if bSideWatches(side, slotIdx) and (instLastUp[slotIdx] <> FALSE)
            if instLastI[slotIdx] >= ABS_ABORT_MV
                safeAbsCount[slotIdx] += 1
                if (safeAbsCount[slotIdx] >= ABS_ABORT_SAMPLES) and (safeEvent <> SAFE_ABS_ABORT)
                    abortStopMotor(side, slotIdx)
                    emitAbort(curSeg, curTid, (side == SIDE_BOTH) ? SIDE_BOTH : side, curIncre, ABR_ABS_CURRENT, ...
                        instLastI[slotIdx], SCOPE_TRIAL)
                    safeEvent := SAFE_ABS_ABORT
            else
                safeAbsCount[slotIdx] := 0
            if (instLastFault[slotIdx] <> FALSE) and (safeEvent == SAFE_NONE)
                safeEvent := SAFE_FAULT

PRI bSideWatches(side, slotIdx) : bWatched
' Report whether a motor slot belongs to a side.
'
' @param side - SIDE_* value
' @param slotIdx - motor slot
' @returns bWatched - TRUE when the side covers the slot

    bWatched := (side == SIDE_BOTH) or ((side - SIDE_LEFT) == slotIdx)

PRI abortStopMotor(side, slotIdx)
' The absolute-current abort's stop: the one place a wheel is stopped while the instrument may be
' reading it. Safety outranks I10; a straddled sample is gated by up (I3) on its next read.
'
' @param side - SIDE_BOTH stops the steering object; otherwise the slot's wheel
' @param slotIdx - motor slot over the limit

    beat(CP_LIB_STOP)
    if side == SIDE_BOTH
        benchLog.cogEventBegin()
        steering.stop()
        bSteerUp := FALSE
    elseif slotIdx == SLOT_RIGHT
        benchLog.cogEventBegin()
        wheelR.stop()
    else
        benchLog.cogEventBegin()
        wheelL.stop()
    beat(CP_LIB_STOP)

PRI waitWatched(side, durationMs, cpId, untilKind) : safeEvent, bReached | startMs
' A beat-polled wait of at most durationMs that reads only the instrument mirror every SAMPLE_MS, and
' ends early on a safety event or when every watched motor reaches the requested state. With the operator
' panel up (the attended parts only) it also keeps the heartbeat running and ends on a STOP
' (SAFE_OPER_STOP); in every unattended part both are no-ops.
'
' @param side - SIDE_LEFT, SIDE_RIGHT or SIDE_BOTH
' @param durationMs - the wait's bound
' @param cpId - CP_LOOP_* beaten every pass
' @param untilKind - UNTIL_TIME, UNTIL_STOPPED, UNTIL_AT_SPEED or UNTIL_MOVING
' @returns safeEvent - SAFE_* that ended the wait, SAFE_NONE otherwise
' @returns bReached - TRUE when the requested state (or, for UNTIL_TIME, the full duration) was reached
'
' @local startMs - getms() when the wait began

    safetyReset()
    safeEvent := SAFE_NONE
    bReached := FALSE
    startMs := getms()
    repeat
        beat(cpId)
#ifdef DBG_PANEL
        panelTick(startMs, durationMs)                      ' PL-152: the panel is compiled into the attended parts only
#endif
        waitms(SAMPLE_MS)
        safeEvent := safetyPoll(side)
#ifdef DBG_PANEL
        if (safeEvent == SAFE_NONE) and bPanelStopPressed()
            safeEvent := SAFE_OPER_STOP
#endif
        if untilKind == UNTIL_STOPPED
            bReached := bMirrorAllInState(side, DCS_STOPPED)
        elseif untilKind == UNTIL_AT_SPEED
            bReached := bMirrorAllInState(side, DCS_AT_SPEED)
        elseif untilKind == UNTIL_MOVING
            bReached := bMirrorNoneInState(side, DCS_STOPPED)
        if (safeEvent <> SAFE_NONE) or bReached or ((getms() - startMs) >= durationMs)
            quit
    if untilKind == UNTIL_TIME
        bReached := (safeEvent == SAFE_NONE)

PRI bMirrorAllInState(side, eState) : bAll | slotIdx
' Report whether every watched motor's mirror shows the driver up and in one state.
'
' @param side - SIDE_LEFT, SIDE_RIGHT or SIDE_BOTH
' @param eState - DCS_* value
' @returns bAll - TRUE when every watched motor is up and in eState
'
' @local slotIdx - motor slot

    bAll := TRUE
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        if bSideWatches(side, slotIdx)
            if (instLastUp[slotIdx] == FALSE) or (instLastState[slotIdx] <> eState)
                bAll := FALSE

PRI bMirrorNoneInState(side, eState) : bNone | slotIdx
' Report whether every watched motor's mirror shows the driver up and outside one state.
'
' @param side - SIDE_LEFT, SIDE_RIGHT or SIDE_BOTH
' @param eState - DCS_* value
' @returns bNone - TRUE when every watched motor is up and not in eState
'
' @local slotIdx - motor slot

    bNone := TRUE
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        if bSideWatches(side, slotIdx)
            if (instLastUp[slotIdx] == FALSE) or (instLastState[slotIdx] == eState)
                bNone := FALSE

PRI waitRest(side, durationMs, bEndOnFault) : safeEvent, bRest | slotIdx, startMs, stillStartMs, lastPos[INST_MOTORS], lastHw[INST_MOTORS], bMoved
' A beat-polled capture wait after an event that reads only the instrument mirror (sec 2.8): ends when
' EVERY watched motor's pos and hwPos have been unchanged for REST_CONFIRM_MS, on a safety event, or
' after durationMs. After stop() pos is frozen, so hwPos alone decides.
'
' SIDE_BOTH WAITS FOR THE PLATFORM, not for a wheel. The slots are walked through bSideWatches(), as every
' other watched wait does: indexing a per-slot array with side - SIDE_LEFT would read past the array for
' SIDE_BOTH, which is why the walk is here rather than one computed slot.
'
' @param side - SIDE_LEFT, SIDE_RIGHT or SIDE_BOTH
' @param durationMs - the capture bound
' @param bEndOnFault - FALSE when the fault is the event under capture, so its flag does not end the wait
' @returns safeEvent - SAFE_* that ended the wait, SAFE_NONE otherwise
' @returns bRest - TRUE when rest was confirmed
'
' @local slotIdx - motor slot
' @local startMs - getms() when the wait began
' @local stillStartMs - getms() when any watched pos or hwPos last changed
' @local lastPos - mirrored pos of each slot at the previous pass
' @local lastHw - mirrored hwPos of each slot at the previous pass
' @local bMoved - a watched slot moved during this pass

    safetyReset()
    safeEvent := SAFE_NONE
    bRest := FALSE
    startMs := getms()
    stillStartMs := startMs
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        lastPos[slotIdx] := instLastPos[slotIdx]
        lastHw[slotIdx] := instLastHw[slotIdx]
    repeat
        beat(CP_LOOP_CAPTURE)
        waitms(SAMPLE_MS)
        safeEvent := safetyPoll(side)
        if (safeEvent == SAFE_FAULT) and (bEndOnFault == FALSE)
            safeEvent := SAFE_NONE
        bMoved := FALSE
        repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
            if bSideWatches(side, slotIdx)
                if (instLastPos[slotIdx] <> lastPos[slotIdx]) or (instLastHw[slotIdx] <> lastHw[slotIdx])
                    bMoved := TRUE
                lastPos[slotIdx] := instLastPos[slotIdx]
                lastHw[slotIdx] := instLastHw[slotIdx]
        if bMoved
            stillStartMs := getms()
        elseif (getms() - stillStartMs) >= REST_CONFIRM_MS
            bRest := TRUE
        if (safeEvent <> SAFE_NONE) or bRest or ((getms() - startMs) >= durationMs)
            quit

PRI waitBeat(durationMs, cpId) | startMs
' A beat-polled wait with no motor watched (rests, cool-downs): no single waitms() exceeds SAMPLE_MS.
'
' @param durationMs - the wait's length
' @param cpId - CP_LOOP_* beaten every pass
'
' @local startMs - getms() when the wait began

    startMs := getms()
    repeat
        beat(cpId)
        if (getms() - startMs) >= durationMs
            quit
        waitms(SAMPLE_MS)

CON { --- ring drain accessors, cog 0, legal only while the instrument is IDLE or FROZEN (I10) --- }

PRI drainBegin()
' Snapshot the ring geometry for a drain: how many samples are readable, how many were overwritten,
' and where logical sample 0 sits.

    beat(CP_LOOP_DRAIN)
    drStored := instTotal <# INST_RING_SAMPLES
    drLostHead := instTotal - drStored
    drOldest := 0
    if instTotal > INST_RING_SAMPLES
        drOldest := (instW + 1) +// INST_RING_SAMPLES

PRI smpBase(sampleIdx) : ringBase
' First long in ring[] of a logical sample.
'
' @param sampleIdx - logical index 0..drStored-1, oldest first
' @returns ringBase - index of its t long

    ringBase := ((drOldest + sampleIdx) +// INST_RING_SAMPLES) * INST_SAMPLE_LONGS

PRI smpMotorLong(sampleIdx, slotIdx, fieldOff) : fieldLong
' One motor long of a logical sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @param fieldOff - SMP_POS, SMP_SENSE, SMP_FLAGS, SMP_HW or SMP_PHVW
' @returns fieldLong - the stored long

    fieldLong := ring[smpBase(sampleIdx) + SMP_MOTOR_BASE + (slotIdx * SMP_MOTOR_LONGS) + fieldOff]

PRI smpT(sampleIdx) : sampleCt
' getct() at the start of a logical sample.
'
' @param sampleIdx - logical index
' @returns sampleCt - the stored t

    sampleCt := ring[smpBase(sampleIdx) + SMP_T]

PRI smpPos(sampleIdx, slotIdx) : nPos
' Driver pos of a logical sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns nPos - stored pos (0 when the driver was not up)

    nPos := smpMotorLong(sampleIdx, slotIdx, SMP_POS)

PRI smpHw(sampleIdx, slotIdx) : nHwPos
' Hall-decoded hwPos of a logical sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns nHwPos - stored hwPos

    nHwPos := smpMotorLong(sampleIdx, slotIdx, SMP_HW)

PRI smpI(sampleIdx, slotIdx) : senseMv
' sense_i of a logical sample, sign-extended from 16 bits.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns senseMv - mV

    senseMv := smpMotorLong(sampleIdx, slotIdx, SMP_SENSE) SAR SENSE_I_SHIFT

PRI smpPhU(sampleIdx, slotIdx) : phaseMv
' Phase U of a logical sample, sign-extended from 16 bits.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns phaseMv - mV

    phaseMv := (smpMotorLong(sampleIdx, slotIdx, SMP_SENSE) & SENSE_PH_MASK) SIGNX SENSE_PH_SIGNBIT

PRI smpPhV(sampleIdx, slotIdx) : phaseMv
' Phase V of a logical sample, sign-extended from 16 bits.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns phaseMv - mV

    phaseMv := smpMotorLong(sampleIdx, slotIdx, SMP_PHVW) SAR SENSE_I_SHIFT

PRI smpPhW(sampleIdx, slotIdx) : phaseMv
' Phase W of a logical sample, sign-extended from 16 bits.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns phaseMv - mV

    phaseMv := (smpMotorLong(sampleIdx, slotIdx, SMP_PHVW) & SENSE_PH_MASK) SIGNX SENSE_PH_SIGNBIT

PRI smpPh(sampleIdx, slotIdx) : phaseMv
' Phase sum u+v+w of a logical sample, re-derived from the three stored phases.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns phaseMv - mV

    phaseMv := smpPhU(sampleIdx, slotIdx) + smpPhV(sampleIdx, slotIdx) + smpPhW(sampleIdx, slotIdx)

PRI smpDuty(sampleIdx, slotIdx) : dutyVal
' Duty of a logical sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns dutyVal - 0..65535

    dutyVal := smpMotorLong(sampleIdx, slotIdx, SMP_FLAGS) >> FLAG_DUTY_SHIFT

PRI smpErr(sampleIdx, slotIdx) : errVal
' Position error of a logical sample, sign-extended from 8 bits.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns errVal - -128..127

    errVal := ((smpMotorLong(sampleIdx, slotIdx, SMP_FLAGS) >> FLAG_ERR_SHIFT) & FIELD_BYTE_MASK) SIGNX FIELD_ERR_SIGNBIT

PRI smpState(sampleIdx, slotIdx) : eDrvrState
' Driver state of a logical sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns eDrvrState - DCS_* 0..7

    eDrvrState := (smpMotorLong(sampleIdx, slotIdx, SMP_FLAGS) >> FLAG_STATE_SHIFT) & FLAG_STATE_MASK

PRI bSmpFault(sampleIdx, slotIdx) : bFaulted
' Fault flag of a logical sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns bFaulted - TRUE when the fault flag was set

    bFaulted := ((smpMotorLong(sampleIdx, slotIdx, SMP_FLAGS) >> FLAG_FAULT_BIT) & 1) <> 0

PRI bSmpUp(sampleIdx, slotIdx) : bUp
' Driver-running flag of a logical sample (I3).
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns bUp - TRUE when the driver was up

    bUp := ((smpMotorLong(sampleIdx, slotIdx, SMP_FLAGS) >> FLAG_UP_BIT) & 1) <> 0

PRI smpIg(sampleIdx, slotIdx) : igDelta
' Hall integrity events since the previous stored sample.
'
' @param sampleIdx - logical index
' @param slotIdx - motor slot
' @returns igDelta - 0..INTEG_DELTA_MAX

    igDelta := smpMotorLong(sampleIdx, slotIdx, SMP_FLAGS) & FLAG_IG_MASK

PRI drainFindMark() | markIdx
' Locate the event mark by ring index (sec 12.7): its logical index is instMarkTotal - drLostHead, valid
' when the instrument recorded it for the latest mark and it lies in 0..drStored-1. Below 0 the mark
' sample was overwritten, so lost_head reaches the mark. Sets drMarkJ and bDrMarkFound.
'
' @local markIdx - the mark's logical index

    drMarkJ := drStored
    bDrMarkFound := FALSE
    if (instMarkAckSeq == instMarkSeq) and (instMarkTotal >= 0)
        markIdx := instMarkTotal - drLostHead
        if (markIdx >= 0) and (markIdx < drStored)
            drMarkJ := markIdx
            bDrMarkFound := TRUE

CON { --- trace emission (design sec 3.5, sec 12.4) and window statistics (I2) --- }

PRI bTraceDrain(tid, slotPri, slotOth, endCode) : bLost | emitMax
' Drain a frozen capture as one trace: locate the mark by ring index, bound the trace to
' TRACE_MAX_SAMPLES from TRACE_PRE_SAMPLES before it, find rest, choose the dense window and stride that
' fit TRACE_EMIT_MAX (dense 250, then 100, then stride 1, 2, 4, 8), emit the BM-TS lines, then
' BM-TRACE-END. The caller has emitted BM-TRACE or BM-STRACE, and folds nothing: this method folds the
' trace into R14-DUAL-TRACES-*. SRC_REV 79 (PL-187): with bTrWhole the mark is ignored (the trace starts at the first stored
' sample, so a rung's window marks cannot trim its approach), the last trTail samples are lines too, the stride may grow to
' trStrideCap, and trWatch names a wheel whose safety is read while the drain runs; all three shaping VARs are cleared at the end.
'
' @param tid - trace id from nextTraceId()
' @param slotPri - primary motor slot (the o_ fields are the other slot)
' @param slotOth - the other motor slot
' @param endCode - TEND_* naming why the capture ended
' @returns bLost - TRUE when the capture lost data at or before its mark, or dropped samples
'
' @local emitMax - the lines the fit may emit: TRACE_EMIT_MAX, or trEmitMax when a caller asked for more (SRC_REV 80)

    emitMax := TRACE_EMIT_MAX #> trEmitMax
    drainBegin()
    drPri := slotPri
    drOth := slotOth
    drainFindMark()
    if bTrWhole
        drMarkJ := drStored
        bDrMarkFound := FALSE
    drStartJ := 0
    if bDrMarkFound
        drStartJ := (drMarkJ - TRACE_PRE_SAMPLES) #> 0
    drEndJ := drStored - 1
    drDropped := 0
    if (drStored > 0) and ((drEndJ - drStartJ + 1) > TRACE_MAX_SAMPLES)
        drDropped := (drEndJ - drStartJ + 1) - TRACE_MAX_SAMPLES
        drEndJ := drStartJ + TRACE_MAX_SAMPLES - 1
    traceFindRest()
    traceStopTicks()
    traceIntegritySums()
    traceIdleMove()
    trTid := tid
    trDense := TRACE_DENSE_SAMPLES
    trStride := 1
    traceWalk(FALSE)
    if trLines > emitMax
        trDense := TRACE_DENSE_MIN
        traceWalk(FALSE)
        repeat while (trLines > emitMax) and (trStride < (TRACE_STRIDE_MAX #> trStrideCap))
            trStride *= TRACE_STRIDE_GROWTH
            traceWalk(FALSE)
    traceWalk(TRUE)
    ' lost_head reaches the mark: samples were overwritten and none survives before the mark
    bLost := (drDropped > 0) or ((drLostHead > 0) and ((bDrMarkFound == FALSE) or (drMarkJ == 0)))
    sfTraces := (sfTraces + 1) <# LIM_BIG
    if bLost
        sfTraceLost := (sfTraceLost + 1) <# LIM_BIG
    emitTraceEnd(tid, endCode, WHY_NO_SAMPLES)
    trTail := 0
    trStrideCap := 0
    trEmitMax := 0
    bTrWhole := FALSE

PRI traceWatchPoll() | safeEvent
' One safety read of the wheel trWatch names, at most once per SAMPLE_MS, as every watched wait reads it (SRC_REV 79): a LIMTOP
' study trace drains while its wheel is still driven, and the counting walks and the emission take seconds with nothing else
' watching it. An absolute-current abort stops the wheel and prints its BM-ABORT inside safetyPoll(); trWatchEvent keeps the
' worst event read, and the caller treats it as it treats a rung's safeEvent.
'
' @local safeEvent - SAFE_* this read returned

    if (getms() - trWatchMs) >= SAMPLE_MS
        trWatchMs := getms()
        safeEvent := safetyPoll(trWatch)
        if (safeEvent == SAFE_ABS_ABORT) or (safeEvent == SAFE_INST_STALL) or (trWatchEvent == SAFE_NONE)
            trWatchEvent := safeEvent

PRI traceFindRest() | restSamples, stillCount, runStartJ, sampleIdx
' Find rest after the mark: pos and hwPos of the primary motor unchanged for REST_CONFIRM_MS. Sets
' drRestK (k where the still run began) and bDrRestFound.
'
' @local restSamples - stored samples spanning REST_CONFIRM_MS at this capture's decimation
' @local stillCount - consecutive unchanged samples so far
' @local runStartJ - logical index where the current still run began
' @local sampleIdx - logical index

    bDrRestFound := FALSE
    drRestK := 0
    restSamples := ((REST_CONFIRM_MS * INST_RATE_HZ) / MS_PER_SEC / instDecimate) #> 1
    if bDrMarkFound and (drMarkJ < drEndJ)
        stillCount := 0
        runStartJ := drMarkJ
        repeat sampleIdx from drMarkJ + 1 to drEndJ
            beat(CP_LOOP_DRAIN)
            if (smpPos(sampleIdx, drPri) == smpPos(sampleIdx - 1, drPri)) and (smpHw(sampleIdx, drPri) == smpHw(sampleIdx - 1, drPri))
                stillCount += 1
                if stillCount >= restSamples
                    drRestK := runStartJ - drStartJ
                    bDrRestFound := TRUE
                    quit
            else
                stillCount := 0
                runStartJ := sampleIdx

PRI traceStopTicks() | restJ
' STPDECEL: how far the primary motor travelled between the event and rest, from the trace the drain has
' just located. One subtraction on samples the trace already found, so no extra reading and no extra run:
' the deceleration number rides the capture C-4 already takes.
'
' @local restJ - logical index of the sample where the still run began

    trStopTicks := 0
    bTrStopValid := FALSE
    if bDrMarkFound and bDrRestFound
        restJ := drStartJ + drRestK
        if (restJ >= drMarkJ) and (restJ <= drEndJ)
            trStopTicks := abs(smpPos(restJ, drPri) - smpPos(drMarkJ, drPri))
            bTrStopValid := TRUE

PRI traceIdleMove() | sampleIdx
' IDLEMOVE (task 3572): the largest distance the OTHER wheel's halls moved during the trace, from its own
' hwPos (the instrument decodes the hall pins itself, so this sees the wheel whether or not its driver runs).
' In a motor-frame trial the other wheel is stopped and nobody commands it; a wheel that moves anyway is a
' command reaching the wrong wheel (PL-76's class) or a mechanical coupling, and either invalidates the trial.
'
' @local sampleIdx - logical index

    trIdleMove := 0
    if drStored > 0
        repeat sampleIdx from drStartJ to drEndJ
            beat(CP_LOOP_DRAIN)
            if trWatch <> SIDE_NONE
                traceWatchPoll()
            trIdleMove #>= abs(smpHw(sampleIdx, drOth) - smpHw(drStartJ, drOth))

PRI traceIntegritySums() | sampleIdx
' Integrity events over the trace for both motors, and the primary motor's unresolved hall transitions.
'
' @local sampleIdx - logical index

    drIgSum := 0
    drOIgSum := 0
    drHwSkip := instHwSkip[drPri]
    if (drStored > 0) and (drStartJ < drEndJ)
        repeat sampleIdx from drStartJ + 1 to drEndJ
            beat(CP_LOOP_DRAIN)
            if trWatch <> SIDE_NONE
                traceWatchPoll()
            drIgSum := (drIgSum + smpIg(sampleIdx, drPri)) <# LIM_BIG
            drOIgSum := (drOIgSum + smpIg(sampleIdx, drOth)) <# LIM_BIG

PRI traceWalk(bEmit) | sampleIdx, kIdx, markK, lastK, posRel, hwRel, stNow, bFltNow, bUpNow, bWant, bChanged
' Walk the trace applying the emission rule. With bEmit FALSE it only counts the lines the rule wants
' (trLines), so bTraceDrain() can pick a dense window and stride; with bEmit TRUE it emits them, never
' more than TRACE_EMIT_MAX, or trEmitMax when a caller raised it (SRC_REV 82, PL-182: SRC_REV 80 raised only the fit's cap, so
' the slow leg still emitted 400 lines) -- the last sample is always kept -- and leaves trLines / trKSum as emitted.
' Rule: k below mark_k + dense; or k within trTail of the last k (SRC_REV 79; no sample when trTail is 0); or, on every
' stride-th k, a change of pos, hw, st, flt or up from the last emitted line, or k a multiple of
' TRACE_SPARSE_EVERY x stride; or the first or last sample. Each pass reads the safety of the wheel trWatch names, when one is.
'
' @param bEmit - TRUE to emit BM-TS lines, FALSE to count only
'
' @local sampleIdx - logical index
' @local kIdx - trace index k
' @local markK - k of the mark (0 when the mark was not found)
' @local lastK - k of the trace's last sample
' @local posRel - primary pos relative to k = 0
' @local hwRel - primary hwPos relative to k = 0
' @local stNow - primary state
' @local bFltNow - primary fault flag
' @local bUpNow - primary up flag
' @local bWant - the rule wants this line
' @local bChanged - a watched field differs from the last emitted line

    trLines := 0
    trKSum := 0
    trIgRun := 0
    bTrEmitted := FALSE
    markK := bDrMarkFound ? (drMarkJ - drStartJ) : 0
    lastK := drEndJ - drStartJ
    if drStored > 0
        repeat sampleIdx from drStartJ to drEndJ
            beat(CP_LOOP_DRAIN)
            if trWatch <> SIDE_NONE
                traceWatchPoll()
            kIdx := sampleIdx - drStartJ
            if kIdx > 0
                trIgRun := (trIgRun + smpIg(sampleIdx, drPri)) <# LIM_BIG
            posRel := smpPos(sampleIdx, drPri) - smpPos(drStartJ, drPri)
            hwRel := smpHw(sampleIdx, drPri) - smpHw(drStartJ, drPri)
            stNow := smpState(sampleIdx, drPri)
            bFltNow := bSmpFault(sampleIdx, drPri)
            bUpNow := bSmpUp(sampleIdx, drPri)
            bWant := (sampleIdx == drStartJ) or (sampleIdx == drEndJ) or (kIdx < markK + trDense) or (kIdx > lastK - trTail)
            if (kIdx +// trStride) == 0
                bChanged := (bTrEmitted == FALSE) or (posRel <> trLastPos) or (hwRel <> trLastHw)
                bChanged := bChanged or (stNow <> trLastSt) or (bFltNow <> trLastFlt) or (bUpNow <> trLastUp)
                if bChanged or ((kIdx +// (TRACE_SPARSE_EVERY * trStride)) == 0)
                    bWant := TRUE
            if bWant and ((bEmit == FALSE) or (trLines < (TRACE_EMIT_MAX #> trEmitMax) - 1) or (sampleIdx == drEndJ))
                trLines += 1
                trKSum := (trKSum + kIdx) <# LIM_MID
                trLastPos := posRel
                trLastHw := hwRel
                trLastSt := stNow
                trLastFlt := bFltNow
                trLastUp := bUpNow
                bTrEmitted := TRUE
                if bEmit
                    emitTs(sampleIdx, kIdx, posRel, hwRel)

PRI windowStats(slotIdx, otherIdx, winStartTotal, winEndTotal) | sampleIdx, startJ, endJ, firstJ, lastJ, iSum, phSum, phUSum, phVSum, phWSum, dutySum, errSum, sampleI
' Compute a measurement window's statistics from drained samples (I2). The window is delimited by ring
' index, never by time (sec 12.7): only samples whose total index lies in winStartTotal..winEndTotal-1
' count (each bound is an instMarkIndex() total, the first sample at or after its mark). Sums run over
' at most INST_RING_SAMPLES clamped fields, and i / phase / duty / err statistics use only samples whose
' driver was up (I3). A bound below 0 selects no sample and reads no ring long. Fills the rs* staging.
'
' @param slotIdx - motor slot under test
' @param otherIdx - the idle motor slot (bRsIdleUp / rsIdleIMax, I6)
' @param winStartTotal - total index at the window start, -1 when not recorded
' @param winEndTotal - total index at the window end, -1 when not recorded
'
' @local sampleIdx - logical index
' @local startJ - logical index of the first sample in the window
' @local endJ - logical index of the last sample in the window
' @local firstJ - first sample inside the window, -1 when none
' @local lastJ - last sample inside the window
' @local iSum - sum of i over up samples, |sum| <= 32_767 x 4_096
' @local phSum - sum of the phase sum over up samples, same bound
' @local phUSum - sum of phase U over up samples, same bound
' @local phVSum - sum of phase V over up samples, same bound
' @local phWSum - sum of phase W over up samples, same bound
' @local dutySum - sum of duty over up samples, <= 65_535 x 4_096
' @local errSum - sum of err over up samples
' @local sampleI - this sample's i

    drainBegin()
    rsN := 0
    iSum := 0
    phSum := 0
    phUSum := 0
    phVSum := 0
    phWSum := 0
    dutySum := 0
    errSum := 0
    rsIMin := POSX
    rsIMax := NEGX
    rsDutyPk := 0
    rsErrPk := 0
    rsIgSum := 0
    rsIMeanX10 := 0
    rsPhMeanX10 := 0
    rsPhUMeanX10 := 0
    rsPhVMeanX10 := 0
    rsPhWMeanX10 := 0
    rsDutyMean := 0
    rsErrMean := 0
    rsTicks := 0
    rsHwTicks := 0
    rsWinMs := 0
    rsRateX10 := 0
    bRsAllUp := TRUE
    bRsIdleUp := FALSE
    rsIdleIMax := 0
    firstJ := -1
    lastJ := -1
    startJ := 0
    endJ := -1
    if (winStartTotal >= 0) and (winEndTotal > winStartTotal) and (drStored > 0)
        startJ := (winStartTotal - drLostHead) #> 0
        endJ := (winEndTotal - 1 - drLostHead) <# (drStored - 1)
    if endJ >= startJ
        repeat sampleIdx from startJ to endJ
            beat(CP_LOOP_DRAIN)
            if firstJ < 0
                firstJ := sampleIdx
            elseif bSmpUp(sampleIdx, slotIdx)
                rsIgSum := (rsIgSum + smpIg(sampleIdx, slotIdx)) <# LIM_BIG
            lastJ := sampleIdx
            if bSmpUp(sampleIdx, slotIdx)
                sampleI := smpI(sampleIdx, slotIdx)
                rsN += 1
                iSum += sampleI
                phSum += smpPh(sampleIdx, slotIdx)
                phUSum += smpPhU(sampleIdx, slotIdx)
                phVSum += smpPhV(sampleIdx, slotIdx)
                phWSum += smpPhW(sampleIdx, slotIdx)
                dutySum += smpDuty(sampleIdx, slotIdx)
                errSum += smpErr(sampleIdx, slotIdx)
                rsIMin <#= sampleI
                rsIMax #>= sampleI
                rsDutyPk #>= smpDuty(sampleIdx, slotIdx)
                rsErrPk #>= abs(smpErr(sampleIdx, slotIdx))
            else
                bRsAllUp := FALSE
            if bSmpUp(sampleIdx, otherIdx)
                bRsIdleUp := TRUE
                rsIdleIMax #>= abs(smpI(sampleIdx, otherIdx))
    if rsN > 0
        rsIMeanX10 := (iSum * X10) / rsN
        rsPhMeanX10 := (phSum * X10) / rsN
        rsPhUMeanX10 := (phUSum * X10) / rsN
        rsPhVMeanX10 := (phVSum * X10) / rsN
        rsPhWMeanX10 := (phWSum * X10) / rsN
        ' R18-DUAL-PHSEP-A: three identical means over a turning wheel means one reading was written
        '  into all three slots. smpPh() derives the sum from them, so a packing fault still yields a
        '  plausible ph_x10 -- this is the only reading that catches it.
        sfPhN := (sfPhN + 1) <# LIM_SMALL
        if (rsPhUMeanX10 == rsPhVMeanX10) and (rsPhVMeanX10 == rsPhWMeanX10)
            sfPhSame := (sfPhSame + 1) <# LIM_SMALL
        rsDutyMean := dutySum / rsN
        rsErrMean := errSum / rsN
    else
        rsIMin := 0
        rsIMax := 0
        bRsAllUp := FALSE
    if (firstJ >= 0) and (lastJ > firstJ)
        rsTicks := smpPos(lastJ, slotIdx) - smpPos(firstJ, slotIdx)
        rsHwTicks := smpHw(lastJ, slotIdx) - smpHw(firstJ, slotIdx)
        rsWinMs := (smpT(lastJ) - smpT(firstJ)) / TICKS_PER_MS
        if rsWinMs > 0
            rsRateX10 := (rsTicks * RATE_X10_SCALE) / rsWinMs
    rsLate := instLate
    rsSkipped := instSkipped
    rsClamps := instClamps
    rsHwSkip := instHwSkip[slotIdx]

PRI predictX10(motorIncre) : predX10
' C-1's predicted hall ticks per second x10 for an increment (design sec 3.2), signed like the increment.
'
' @param motorIncre - signed increment
' @returns predX10 - (|incre| / PRED_INCRE_DIV) x PRED_MUL / PRED_DIV, with the increment's sign

    predX10 := ((abs(motorIncre) / PRED_INCRE_DIV) * PRED_MUL) / PRED_DIV
    if motorIncre < 0
        predX10 := 0 - predX10

PRI foldIdleWheel(slotIdx, bIdleUp)
' Fold one motor-frame capture into R14-DUAL-IDLEFLT-A: one capture on this motor, and whether any of its
' samples showed the idle wheel up (bCaptureIdleUp()).
'
' @param slotIdx - motor slot under test
' @param bIdleUp - TRUE when any sample of the capture showed the idle wheel up

    sfFrameCaps[slotIdx] := (sfFrameCaps[slotIdx] + 1) <# LIM_BIG
    if bIdleUp
        sfIdleUp[slotIdx] := (sfIdleUp[slotIdx] + 1) <# LIM_BIG

PRI foldIntegrity(slotIdx, nMissed, nIllegal)
' Fold integrity counts into R14-DUAL-INTEG-A. Each count is clamped before abs() so a corrupt count
' still adds and abs() never sees NEGX; the sum saturates at LIM_BIG (scan addIntegritySum()).
'
' @param slotIdx - motor slot
' @param nMissed - missed hall transitions
' @param nIllegal - illegal hall codes

    sfIntegSum[slotIdx] := (sfIntegSum[slotIdx] + abs((nMissed #> (0 - LIM_MID)) <# LIM_MID) + abs((nIllegal #> (0 - LIM_MID)) <# LIM_MID)) <# LIM_BIG

PRI nextTraceId() : tid
' Allocate a run-wide trace id and make it the current one (BM-ABORT context).
'
' @returns tid - 1, 2, 3 ...

    traceSeq := (traceSeq + 1) <# LIM_SMALL
    tid := traceSeq
    curTid := tid

PRI nextRungId() : rid
' Allocate a run-wide rung id.
'
' @returns rid - 1, 2, 3 ...

    rungSeq := (rungSeq + 1) <# LIM_SMALL
    rid := rungSeq

PRI segWhy() : whyCode
' The BM-SEG END why of a segment body: ABORTED once the run has aborted, else NONE.
'
' @returns whyCode - WHY_ABORTED or WHY_NONE

    whyCode := bRunAborted ? WHY_ABORTED : WHY_NONE

PRI safeWhy(safeEvent) : whyCode
' The why token of a safety event that ended a trial before its event.
'
' @param safeEvent - SAFE_* value
' @returns whyCode - FAULTED, ABORTED, INST_STALLED, OPERATOR_STOP, or NONE for SAFE_NONE

    case safeEvent
        SAFE_FAULT:
            whyCode := WHY_FAULTED
        SAFE_ABS_ABORT:
            whyCode := WHY_ABORTED
        SAFE_INST_STALL:
            whyCode := WHY_INST_STALLED
        SAFE_OPER_STOP:
            whyCode := WHY_OPERATOR_STOP
        other:
            whyCode := WHY_NONE

PRI safeEnd(safeEvent) : endCode
' The BM-TRACE-END end token of a safety event that ended a capture.
'
' @param safeEvent - SAFE_* value (not SAFE_NONE)
' @returns endCode - TEND_FAULT for a fault, TEND_ABORT for an abort or a stalled instrument

    endCode := (safeEvent == SAFE_FAULT) ? TEND_FAULT : TEND_ABORT

PRI trialSkipWhy(seg, side, skipWhy) : whyCode
' Decide whether one wheel trial may run: a cause already known first, then the run caps, a retired
' motor (sec 4.2 step 4) and a driver cog that is not running.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param skipWhy - WHY_* already known, WHY_NONE when none
' @returns whyCode - WHY_NONE when the trial may run, else its cause

    whyCode := skipWhy
    if whyCode == WHY_NONE
        if bRunContinue(seg) == FALSE
            whyCode := WHY_ABORTED
        elseif bSlotRetired[side - SIDE_LEFT]
            whyCode := WHY_MOTOR_RETIRED
        elseif isWheelUp(side) == FALSE
            whyCode := WHY_NO_COG

PRI traceCaptureMs(decimation) : captureMs
' The post-mark capture bound: the samples TRACE_MAX_SAMPLES leaves after TRACE_PRE_SAMPLES and the
' freeze margin, as ms at a decimation. A capture held to it never drops samples, and its mark stays in
' the ring (the ring holds TRACE_MAX_SAMPLES plus the margin), so R14-DUAL-TRACES-* cannot fail on it.
'
' @param decimation - samples stored one in this many
' @returns captureMs - the longest post-mark capture, ms

    captureMs := ((TRACE_MAX_SAMPLES - TRACE_PRE_SAMPLES - TRACE_FREEZE_MARGIN) * decimation * MS_PER_SEC) / INST_RATE_HZ

PRI bCaptureIdleUp(otherIdx) : bIdleUp | sampleIdx
' Report whether any sample of the frozen capture showed the idle wheel's driver up (R14-DUAL-IDLEFLT-A).
' Legal only while the instrument is FROZEN (I10).
'
' @param otherIdx - the idle motor slot
' @returns bIdleUp - TRUE when any stored sample has the idle wheel up
'
' @local sampleIdx - logical index

    drainBegin()
    bIdleUp := FALSE
    if drStored > 0
        repeat sampleIdx from 0 to drStored - 1
            beat(CP_LOOP_DRAIN)
            if bSmpUp(sampleIdx, otherIdx)
                bIdleUp := TRUE
                quit

PRI cpReset()
' Clear the trace capture staging before a trial.

    cpWhy := WHY_NONE
    cpEnd := TEND_TIMEOUT
    bCpFrozen := FALSE
    bCpFaultSeen := FALSE
    cpWantNeg := 0
    cpWantPos := 0
    bCpOffWritten := FALSE
    bCpOffRestored := FALSE
    bCpEstopSet := FALSE
    cpRampMs := 0
    bCpRampReached := FALSE
    cpRampLag := 0
    bCpRampLagValid := FALSE

PRI traceEmptyEnd(tid, endCode, whyCode)
' BM-TRACE-END for a trace with no drainable capture (skipped, or never frozen so never drained, I10):
' every drain field is reset so nothing stale prints, and why names the cause. Not folded into TRACES.
'
' @param tid - trace id
' @param endCode - TEND_* value
' @param whyCode - WHY_* naming why nothing was captured

    drStored := 0
    drLostHead := 0
    drDropped := 0
    drStartJ := 0
    drEndJ := -1
    drMarkJ := 0
    bDrMarkFound := FALSE
    drRestK := 0
    bDrRestFound := FALSE
    drIgSum := 0
    drOIgSum := 0
    drHwSkip := 0
    trLines := 0
    trKSum := 0
    trStride := 1
    emitTraceEnd(tid, endCode, whyCode)

PRI traceSkip(tid, seg, side, causeCode, motorIncre, reqMode, accelUp, whyCode)
' Emit a wheel trace that did not run: its header (offsets from cpWantNeg / cpWantPos) and an empty end
' whose why names the cause, so the analyser sees every planned trace.
'
' @param tid - trace id
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param causeCode - CAUSE_* the trace would have done
' @param motorIncre - signed increment
' @param reqMode - MODE_* requested
' @param accelUp - accel_up (the speed-up limit, maxRamp) read back
' @param whyCode - WHY_* naming why it did not run

    emitTrace(tid, seg, side, causeCode, motorIncre, cpWantNeg, cpWantPos, reqMode, accelUp, WHY_NONE)
    traceEmptyEnd(tid, TEND_ABORT, whyCode)

PRI traceEmitCapture(seg, side, tid, causeCode, motorIncre, reqMode, accelUp) | slotIdx, otherIdx
' Finish a wheel trace's capture. First every side effect the trial created is undone and read back
' (I11: offsets with BM-OFFREST, the e-stop, the brake request, I6); only then BM-TRACE, and BM-TS /
' BM-TRACE-END from the frozen ring, folded into R14-DUAL-TRACES-* and R14-DUAL-IDLEFLT-A. An unfrozen
' capture is never drained (I10): its end is empty with why from cpWhy.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param tid - trace id
' @param causeCode - CAUSE_* done
' @param motorIncre - signed increment
' @param reqMode - MODE_* requested
' @param accelUp - accel_up (the speed-up limit, maxRamp) read back
'
' @local slotIdx - motor slot
' @local otherIdx - the idle motor slot

    slotIdx := side - SIDE_LEFT
    otherIdx := SLOT_RIGHT - slotIdx
    if bCpOffWritten and (bCpOffRestored == FALSE)
        bRestoreOffsets(side, cpWantNeg, cpWantPos)
        bCpOffRestored := TRUE
    if bCpEstopSet
        restoreEmergency(side)
        bCpEstopSet := FALSE
    if bBrakeRequested[slotIdx]
        restoreStopMode(side)
    emitTrace(tid, seg, side, causeCode, motorIncre, cpWantNeg, cpWantPos, reqMode, accelUp, cpWhy)
    if bCpFrozen
        bTraceDrain(tid, slotIdx, otherIdx, cpEnd)
        foldIdleWheel(slotIdx, bCaptureIdleUp(otherIdx))
        sfIdleMoveMax[slotIdx] #>= trIdleMove               ' IDLEMOVE (task 3572): bTraceDrain() measured it
        sfIdleMoveN[slotIdx] := (sfIdleMoveN[slotIdx] + 1) <# LIM_SMALL
    else
        traceEmptyEnd(tid, cpEnd, (cpWhy == WHY_NONE) ? WHY_INST_NOACK : cpWhy)

PRI traceRecover(seg, side, tid, motorIncre, coolMs) : rstCode, rstMs | slotIdx, uncBefore, startMs, bFaultNow, bCleared
' Close a wheel trial after its restores and records (sec 4.2): when a fault was seen, or the fault flag
' is set now, recover it (testResetFault() alone, then restart, then retire) and cool coolMs; then zero
' and wait stopped.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param tid - trace id of the trial
' @param motorIncre - the trial's command
' @param coolMs - cool-down after a fault
' @returns rstCode - RST_NONE (no fault), RST_RESET, RST_RESTART or RST_FAILED
' @returns rstMs - ms the recovery took, cool-down excluded
'
' @local slotIdx - motor slot
' @local uncBefore - R14-DUAL-RSTPROV count before the recovery (a change means step 2 did not clear)
' @local startMs - getms() before the recovery
' @local bFaultNow - the fault flag after the restores
' @local bCleared - bRecoverFault()'s result

    slotIdx := side - SIDE_LEFT
    rstCode := RST_NONE
    rstMs := 0
    bFaultNow := FALSE
    if isWheelUp(side)
        _, _, bFaultNow := wheelClearedState(side)
    if bCpFaultSeen or (bFaultNow <> FALSE)
        uncBefore := sfResetUncleared[slotIdx]
        startMs := getms()
        bCleared := bRecoverFault(seg, tid, side, motorIncre, 0)
        rstMs := getms() - startMs
        if bCleared == FALSE
            rstCode := RST_FAILED
        elseif sfResetUncleared[slotIdx] == uncBefore
            rstCode := RST_RESET
        else
            rstCode := RST_RESTART
        waitBeat(coolMs, CP_LOOP_COOL)
    bZeroAndWaitStopped(side)

CON { --- ABI dump: what each driver holds in the hub runs it shares with Spin2 (task 3615, PL-120) --- }

  ' WHY THIS EXISTS. The right wheel drives in every SPIN variant but drove nothing in dual-start and dual-fault
  '  (pass 1), and three bench trips localised that without showing it. These records show it: the three hub runs
  '  the driver cog shares with Spin2 by address offset (isp_bldc_motor.spin2 VAR, reached through testGetAbiAddrs()):
  '  the ABI_LAUNCH_LONGS launch longs (pinbase .. targetIncre), the DRVR_STATUS_LONGS_COUNT status longs the driver
  '  writes every pass and fault after them, the DRVR_PARAMS_LONGS_COUNT parameters it reads every pass, and the
  '  object's motorCog.
  '
  ' THE DUMP IS THE INSTRUMENT (D2): every value is the long as the driver holds it -- never scaled, clamped, decoded
  '  or named by a token -- in VAR declaration order under the VAR's own name, so a log reads against that block
  '  without the source. Each wheel's runs are copied with one longmove() apiece, before anything is printed, so the
  '  nine records describe one moment and not nine. The names are abiName()'s, written from the VAR block; BM-ABIL
  '  prints the driver's own st_n and par_n beside them, so a driver whose runs changed length shows in the log
  '  rather than silently shifting every name after the change.
  '
  ' Records, each worst case under 280 bytes (header: tag 8 + seq 15 + where 15 + motor 12 + life 13 = 63, where
  '  widened by one for NOMOTION; a raw field is 2 + len(name) + 14, "-2_147_483_648"): BM-ABIL the launch run, motorCog,
  '  st_n, par_n, why (233); BM-ABIS1 drive_u .. sense_i_mV (236); BM-ABIS2 hall .. hall_illegal (273); BM-ABIS3
  '  drv_incr_now .. drv_accel_now (231); BM-ABIS4 the status run's longs past drv_accel_now -- drv_stop_passes and
  '  drv_stop_fp at DRIVER_REV 39 -- then fault (142, + 17 per unnamed long); BM-ABIP1 offset_fwd .. dead_gap (240);
  '  BM-ABIP2 accel_dn .. i_limit_k (254); BM-ABIP3 duty_floor .. fault_clr (266); BM-ABIP4 probe_sink .. sense_zero,
  '  and any longs past it (165, + 17 each).
  ' SRC_REV 59 (FMT 38; DRIVER_REV 38 / 39, PL-160 / PL-161): both runs are sized from the library's own counts (the
  '  parameter run was a literal 25 since PL-138 and PL-146 made it 27, so drv_release and sense_zero were never dumped),
  '  and the names follow the VAR block: drv_accel_now after foldback_frames (DRVR_STATUS_ACCEL_NOW_IDX), then
  '  DRIVER_REV 39's drv_stop_passes and drv_stop_fp, the driver's stop plan; the four ramp longs are accel_dn, accel_up, jerk_up
  '  and jerk_dn where they were ramp_down, ramp_max, ramp_min and ramp_inc; drv_release and sense_zero close the
  '  parameter run. hall_missed and hall_illegal move from BM-ABIS3 to BM-ABIS2, and the run's tail and fault get a
  '  record of their own, BM-ABIS4. THE NAMES CANNOT SHIFT ANY MORE: the three runs have a table each (tokAbiLaunch,
  '  tokAbiStatus, tokAbiParams), each read from its own run's first long; a long past its table's names -- a run that
  '  grew after these names were written (ABI_STATUS_NAMED, ABI_PARAMS_NAMED) -- prints under "?" rather than under
  '  the next long's name, and fault, the long after the status run, is named by its place, not by a count. BM-ABIL's
  '  st_n and par_n print the library's counts beside them, so a "?" is read against them.
  '
  ' Where (token = tokAbiWhere):
  '  ABIW_SKSTART - part START, every lifetime whose steering start() returned a cog, both wheels through the steering
  '                 object, after skReadHealth() and before anything is folded; motorCog from steering.testGetMotorCogs()
  '  ABIW_PREFLT  - PREFLT, in every part that runs it, the wheel just nudged, after the nudge and before wheelStop(),
  '                 through wheelL / wheelR -- whether or not it moved
  '  ABIW_TIMEOUT - part FRESP, a trial whose wheel never reached AT_SPEED, at the timeout while it is still commanded
  '                 (PL-120's second form, 2026-09-24: the right drove at PREFLT, then not in any later lifetime, and no
  '                 dump fell in a failing one)
  '  ABIW_NOMOTION - part FRESP, a trial whose wheel has been commanded for FR_NOMOTION_MS with no hall tick, once per
  '                 trial, while it is still commanded and before the driver's ~1 s protective stop (PL-120's
  '                 2026-09-24 21:21 recurrence: the TIMEOUT dump read only the state after that stop had latched).
  '                 PL-136: also every PREFLT nudge, in every part, by the same test (waitWatchedNoMo()); its life is the
  '                 one BM-START seg PREFLT names, so a reader tells it from a trial's
    #0, ABIW_SKSTART, ABIW_PREFLT, ABIW_TIMEOUT, ABIW_NOMOTION
    ABIW_COUNT      = ABIW_NOMOTION + 1
    TOKMAX_ABIWHERE = 8                                     ' NOMOTION, the longest

    ABI_LAUNCH_LONGS = 4                                    ' pinbase, params_ptr, targetAngle, targetIncre
    ' task 3621: the status run is sized from the library's own count, plus fault after it, so a driver whose run grows
    '  cannot silently drop fault off the end of the copy (at src_rev 44 a literal 21 did, after R20.1's foldback_frames)
    ABI_STATUS_LONGS = wheelL.DRVR_STATUS_LONGS_COUNT + 1   ' drive_u .. drv_stop_fp (24 at DRIVER_REV 39), then fault
    ABI_PARAMS_LONGS = wheelL.DRVR_PARAMS_LONGS_COUNT       ' offset_fwd .. sense_zero (27; SRC_REV 59, was a literal 25)
    ABI_STATUS_NAMED = wheelL.DRVR_STATUS_LONGS_COUNT       ' the status longs tokAbiStatus names: drive_u .. drv_stop_fp (24 at DRIVER_REV 39)
    ABI_PARAMS_NAMED = wheelL.DRVR_PARAMS_LONGS_COUNT       ' the parameter longs tokAbiParams names: offset_fwd .. sense_zero (27)
    ABI_TARGET_IDX   = ABI_LAUNCH_LONGS - 1                 ' targetIncre: the launch run's last long (SRC_REV 70: bSpinStopBegun())
    TARGET_SIGN_BIT  = 30                                   ' targetIncre's sign bit; bit 31 is the driver's sync flag (gettgtincr's SIGNX 30)
    ABI_STATUS_BASE  = ABI_LAUNCH_LONGS                     ' the status run's first long in a wheel's abiSnap row
    ABI_PARAMS_BASE  = ABI_STATUS_BASE + ABI_STATUS_LONGS   ' ...and the parameter run's
    ABI_FAULT_IDX    = ABI_PARAMS_BASE - 1                  ' fault: the long after the status run
    ABI_LONGS        = ABI_PARAMS_BASE + ABI_PARAMS_LONGS   ' 56 per wheel at DRIVER_REV 39
    ' each record's [first, last] in a wheel's abiSnap row, declaration order
    ABI_S1_FIRST = ABI_STATUS_BASE                          ' drive_u
    ABI_S2_FIRST = ABI_STATUS_BASE + 7                      ' hall
    ABI_S3_FIRST = ABI_STATUS_BASE + 16                     ' drv_incr_now (SRC_REV 59: was hall_missed, + 14)
    ABI_S4_FIRST = ABI_STATUS_BASE + wheelL.DRVR_STATUS_ACCEL_NOW_IDX + 1   ' drv_stop_passes, the first long past drv_accel_now
    ABI_P1_FIRST = ABI_PARAMS_BASE                          ' offset_fwd
    ABI_P2_FIRST = ABI_PARAMS_BASE + 7                      ' accel_dn (was ramp_down)
    ABI_P3_FIRST = ABI_PARAMS_BASE + 15                     ' duty_floor
    ABI_P4_FIRST = ABI_PARAMS_BASE + 23                     ' probe_sink
    ABI_LAST     = ABI_LONGS - 1                            ' sense_zero at DRIVER_REV 38 (was probe_y)
    ' SRC_REV 75 (task 3657): the status run's longs limSample() reads in place, each by its index from the run's first long
    '  (drive_u, the address testGetAbiAddrs() returns), derived from the table above -- tokAbiStatus names them in this order --
    '  so a long that moves moves them, and BM-ABIS3's first long (drv_incr_now) is the one they count from
    LG_INCR_IDX     = ABI_S3_FIRST - ABI_STATUS_BASE        ' drv_incr_now
    LG_HELD_IDX     = LG_INCR_IDX + 1                       ' lag_held
    LG_CAPPED_IDX   = LG_INCR_IDX + 2                       ' duty_capped
    LG_FOLD_IDX     = LG_INCR_IDX + 4                       ' foldback_frames (fault_resyncs is the long between)
    LG_FAULT_IDX    = ABI_FAULT_IDX - ABI_STATUS_BASE       ' fault, the long after the status run
    LG_ERR_IDX      = LG_INCR_IDX - 6                       ' err: before it loop_ticks, loop_ctcks, drv_state, hall_missed, hall_illegal (SRC_REV 76)
    LG_STATE_IDX    = LG_INCR_IDX - 3                       ' drv_state: before it hall_missed, hall_illegal (SRC_REV 78, limSample()'s arrival latch)

DAT ' ---- ABI dump tables ----

tokAbiWhere     BYTE    "SKSTART", 0, "PREFLT", 0, "TIMEOUT", 0, "NOMOTION", 0, TOK_END
' isp_bldc_motor.spin2 VAR names, declaration order, one table per run (SRC_REV 59): the launch run, the status run
'  (ABI_STATUS_NAMED of them; fault, after it, is named by its place), the parameter run (ABI_PARAMS_NAMED)
tokAbiLaunch    BYTE    "pinbase", 0, "params_ptr", 0, "targetAngle", 0, "targetIncre", 0, TOK_END
tokAbiStatus    BYTE    "drive_u", 0, "drive_v", 0, "drive_w", 0
                BYTE    "sense_u_mV", 0, "sense_v_mV", 0, "sense_w_mV", 0, "sense_i_mV", 0
                BYTE    "hall", 0, "pos", 0, "duty", 0, "err", 0, "loop_ticks", 0, "loop_ctcks", 0, "drv_state", 0
                BYTE    "hall_missed", 0, "hall_illegal", 0, "drv_incr_now", 0, "lag_held", 0, "duty_capped", 0
                BYTE    "fault_resyncs", 0, "foldback_frames", 0, "drv_accel_now", 0
                BYTE    "drv_stop_passes", 0, "drv_stop_fp", 0, TOK_END
tokAbiParams   BYTE    "offset_fwd", 0, "offset_rev", 0, "duty_min", 0, "duty_max", 0, "servo_shift", 0
                BYTE    "ff_ceiling", 0, "dead_gap", 0
                BYTE    "accel_dn", 0, "cfg_ctcks", 0, "stop_mode", 0, "e_stop", 0, "accel_up", 0, "jerk_up", 0
                BYTE    "jerk_dn", 0, "i_limit_k", 0
                BYTE    "duty_floor", 0, "hold_duty", 0, "hold_short", 0, "fault_mode", 0, "brake_on", 0
                BYTE    "probe_phase", 0, "force_seq", 0, "fault_clr", 0
                BYTE    "probe_sink", 0, "probe_y", 0, "drv_release", 0, "sense_zero", 0, TOK_END
sAbiFault      BYTE    "fault", 0
' the one long lineAddNum() cannot negate: NEGX printed as the signed decimal it is
sAbiNegx        BYTE    "-2_147_483_648", 0

VAR { ABI dump -- cog 0 only }

    LONG    abiSnap[INST_MOTORS * ABI_LONGS]                ' [slot * ABI_LONGS + i]: the three runs, as copied
    LONG    abiCog[INST_MOTORS]                             ' motorCog as held (cogid + 1, 0 when not started)
    LONG    bAbiCogValid[INST_MOTORS]                       ' abiCog was read (FALSE through the steering object)

PRI abiDumpSteer() | pLaunchL, pStatusL, pParamsL, pLaunchR, pStatusR, pParamsR
' SKSTART: both steering wheels' runs, copied back to back and only then printed (BM-ABI* per wheel, LEFT first).
'
' @local pLaunchL - the LEFT driver's @pinbase
' @local pStatusL - ...@drive_u
' @local pParamsL - ...@offset_fwd
' @local pLaunchR - the RIGHT driver's @pinbase
' @local pStatusR - ...@drive_u
' @local pParamsR - ...@offset_fwd

    beat(CP_LIB_STEER_QUERY)
    pLaunchL, pStatusL, pParamsL := steering.testLeftGetAbiAddrs()
    pLaunchR, pStatusR, pParamsR := steering.testRightGetAbiAddrs()
    abiCog[SLOT_LEFT], abiCog[SLOT_RIGHT] := steering.testGetMotorCogs()
    beat(CP_LIB_STEER_QUERY)
    abiSnapshot(SLOT_LEFT, pLaunchL, pStatusL, pParamsL)
    abiSnapshot(SLOT_RIGHT, pLaunchR, pStatusR, pParamsR)
    bAbiCogValid[SLOT_LEFT] := TRUE
    bAbiCogValid[SLOT_RIGHT] := TRUE
    emitAbi(SLOT_LEFT, ABIW_SKSTART, steerLife)
    emitAbi(SLOT_RIGHT, ABIW_SKSTART, steerLife)

PRI abiDumpWheel(side, whereCode) | slotIdx, pLaunch, pStatus, pParams
' PREFLT, TIMEOUT or NOMOTION (a FLTRESP trial's or, PL-136, a PREFLT nudge's): one wheel's runs and its motorCog
' through its own motor object, then BM-ABI*.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param whereCode - ABIW_PREFLT, ABIW_TIMEOUT or ABIW_NOMOTION
'
' @local slotIdx - motor slot
' @local pLaunch - the driver's @pinbase
' @local pStatus - ...@drive_u
' @local pParams - ...@offset_fwd

    slotIdx := side - SIDE_LEFT
    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT                                   ' if/else, never `? :` -- PL-29, PL-76
        pLaunch, pStatus, pParams := wheelR.testGetAbiAddrs()
        abiCog[slotIdx] := wheelR.testGetMotorCog()
    else
        pLaunch, pStatus, pParams := wheelL.testGetAbiAddrs()
        abiCog[slotIdx] := wheelL.testGetMotorCog()
    beat(CP_LIB_QUERY)
    abiSnapshot(slotIdx, pLaunch, pStatus, pParams)
    bAbiCogValid[slotIdx] := TRUE
    emitAbi(slotIdx, whereCode, slotLife[slotIdx])

PRI abiSnapshot(slotIdx, pLaunch, pStatus, pParams) | rowBase
' Copy one driver's three runs into its abiSnap row, one longmove() per run, nothing interpreted.
'
' @param slotIdx - motor slot
' @param pLaunch - @pinbase
' @param pStatus - @drive_u (fault is the long after the DRVR_STATUS_LONGS_COUNT run)
' @param pParams - @offset_fwd
'
' @local rowBase - the wheel's first index in abiSnap

    rowBase := slotIdx * ABI_LONGS
    longmove(@abiSnap[rowBase], pLaunch, ABI_LAUNCH_LONGS)
    longmove(@abiSnap[rowBase + ABI_STATUS_BASE], pStatus, ABI_STATUS_LONGS)
    longmove(@abiSnap[rowBase + ABI_PARAMS_BASE], pParams, ABI_PARAMS_LONGS)

PRI emitAbi(slotIdx, whereCode, lifeValue) | rowBase, longIdx
' BM-ABIL, then BM-ABIS1..4 and BM-ABIP1..4, from one wheel's abiSnap row (sizes in the section's CON note).
'
' @param slotIdx - motor slot
' @param whereCode - ABIW_* value
' @param lifeValue - the lifetime the dump was taken in (steerLife or slotLife), NA when 0
'
' @local rowBase - the wheel's first index in abiSnap
' @local longIdx - index within the row

    rowBase := slotIdx * ABI_LONGS
    abiHead(@"BM-ABIL", slotIdx, whereCode, lifeValue)
    repeat longIdx from 0 to ABI_LAUNCH_LONGS - 1
        abiRawField(abiName(longIdx), abiSnap[rowBase + longIdx])
    if bAbiCogValid[slotIdx]
        abiRawField(@"motorCog", abiCog[slotIdx])
    else
        benchLog.textField(@"motorCog", @sSfNa)
    benchLog.numField(@"st_n", wheelL.DRVR_STATUS_LONGS_COUNT, LIM_TINY)
    benchLog.numField(@"par_n", wheelL.DRVR_PARAMS_LONGS_COUNT, LIM_TINY)
    if bAbiCogValid[slotIdx]
        whyField(WHY_NONE)
    else
        whyField(WHY_NO_PASSTHROUGH)
    emitRecord()
    emitAbiRun(@"BM-ABIS1", slotIdx, whereCode, lifeValue, ABI_S1_FIRST, ABI_S2_FIRST - 1)
    emitAbiRun(@"BM-ABIS2", slotIdx, whereCode, lifeValue, ABI_S2_FIRST, ABI_S3_FIRST - 1)
    emitAbiRun(@"BM-ABIS3", slotIdx, whereCode, lifeValue, ABI_S3_FIRST, ABI_S4_FIRST - 1)
    emitAbiRun(@"BM-ABIS4", slotIdx, whereCode, lifeValue, ABI_S4_FIRST, ABI_FAULT_IDX)
    emitAbiRun(@"BM-ABIP1", slotIdx, whereCode, lifeValue, ABI_P1_FIRST, ABI_P2_FIRST - 1)
    emitAbiRun(@"BM-ABIP2", slotIdx, whereCode, lifeValue, ABI_P2_FIRST, ABI_P3_FIRST - 1)
    emitAbiRun(@"BM-ABIP3", slotIdx, whereCode, lifeValue, ABI_P3_FIRST, ABI_P4_FIRST - 1)
    emitAbiRun(@"BM-ABIP4", slotIdx, whereCode, lifeValue, ABI_P4_FIRST, ABI_LAST)

PRI emitAbiRun(pTag, slotIdx, whereCode, lifeValue, firstIdx, lastIdx) | rowBase, longIdx
' One BM-ABIS* / BM-ABIP* record: the header, then abiSnap[firstIdx .. lastIdx] of the wheel's row, raw, named.
'
' @param pTag - the record tag
' @param slotIdx - motor slot
' @param whereCode - ABIW_* value
' @param lifeValue - the lifetime the dump was taken in, NA when 0
' @param firstIdx - the first long, index within the row
' @param lastIdx - the last
'
' @local rowBase - the wheel's first index in abiSnap
' @local longIdx - index within the row

    rowBase := slotIdx * ABI_LONGS
    abiHead(pTag, slotIdx, whereCode, lifeValue)
    repeat longIdx from firstIdx to lastIdx
        abiRawField(abiName(longIdx), abiSnap[rowBase + longIdx])
    emitRecord()

PRI abiName(longIdx) : pName
' The VAR name of one long of a wheel's abiSnap row (SRC_REV 59): each run's from its own table, counted from that run's
' first long, so a run that grew cannot shift the names of the runs after it; a long past its table prints "?"
' (tokenAt()), and fault, the long after the status run, is named by its place.
'
' @param longIdx - index within the row
' @returns pName - pointer to the name

    if longIdx < ABI_STATUS_BASE
        pName := tokenAt(@tokAbiLaunch, ABI_LAUNCH_LONGS, longIdx)
    elseif longIdx < ABI_FAULT_IDX
        pName := tokenAt(@tokAbiStatus, ABI_STATUS_NAMED, longIdx - ABI_STATUS_BASE)
    elseif longIdx == ABI_FAULT_IDX
        pName := @sAbiFault
    else
        pName := tokenAt(@tokAbiParams, ABI_PARAMS_NAMED, longIdx - ABI_PARAMS_BASE)

PRI abiHead(pTag, slotIdx, whereCode, lifeValue)
' Begin one BM-ABI* record: tag, seq, where, motor, life.
'
' @param pTag - the record tag
' @param slotIdx - motor slot
' @param whereCode - ABIW_* value
' @param lifeValue - the lifetime the dump was taken in, NA when 0

    recBegin(pTag)
    benchLog.tokenField(@"where", tokenAt(@tokAbiWhere, ABIW_COUNT, whereCode), TOKMAX_ABIWHERE)
    benchLog.tokenField(@"motor", sideToken(SIDE_LEFT + slotIdx), TOKMAX_MOTOR)
    benchLog.naNumField(@"life", lifeValue, LIM_SMALL, lifeValue > 0)

PRI abiRawField(pName, rawValue)
' Append one long as held, signed decimal and unclamped (D2). NEGX, which lineAddNum() cannot negate, prints as the
' same decimal text.
'
' @param pName - the field name
' @param rawValue - the long

    if rawValue == NEGX
        benchLog.textField(pName, @sAbiNegx)
    else
        benchLog.unclampedNumField(pName, rawValue)

CON { --- the driver's reporting (task 3621, R20.1): stop reasons and the soft-event log, read by cog 0 --- }

  ' WHAT IS READ. R20.1 has the driver report why each drive ended (getStopReason(), SR_*) and what it handled on its
  '  own (getEvent(), EV_*): DOCs/plans/DRIVER-REPORTING-DESIGN.md SS1, SS2. Cog 0 is the only reader in this file, and it
  '  reads the log only by DRAINING it (evDrain()): getEvent() until EV_NONE, every event printed as one BM-EV and
  '  counted into the evd* staging, so the cell that judges a drain and a person reading the log see the same events.
  '  A drain that does not end on EV_NONE inside EV_DRAIN_MAX reads, or that is told EV_LOST, is not clean (bEvdClean()),
  '  and every cell judged on an unclean drain FAILS: a lost event never reads as none (D2).
  '
  ' WHERE (the stage printed on each BM-EV and BM-SR):
  '  EVST_SKCHECK  - part START, each lifetime whose start returned a cog, EV_SETTLE_MS after its last act, before the stop
  '  EVST_FRTRIAL  - part FAULTRESP, each FLTRESP trial whose forced fault latched, right after its capture (frReadAfter())
  '  EVST_FRHOOK   - HOOKREST: the stop reason only (BM-SR), no drain
  '  EVST_FRPLAT   - each FLTPLAT trial, after its capture, before the platform is stopped
  '  EVST_D_FOLD, EVST_D_DERATE, EVST_D_BLOCK - part D's three LIMIT steps, each drained EV_SETTLE_MS after its stop
  '  EVST_STEERSEG, EVST_WHEEL - part D's two default-limit forms: getEventTotal() only (BM-EVTOT), beside FRONTST
  '  EVST_PACK     - part PACK (R20.4): after the start, at the end of step 1, and EV_SETTLE_MS after each unplug and replug
  '  EVST_OBSTACLE - part SPIN's OBSTACLE trials (SRC_REV 58 as BLOCK), EV_SETTLE_MS after the API sequence, before the stop
  '  EVST_GRAB     - part SPIN's GRAB trials (SRC_REV 58 as LOAD), EV_SETTLE_MS after the platform rests, before the drive
  '                  back
  '  EVST_FAULTRUN - part SPIN's FAULTRUN (SRC_REV 62): the stop reasons only (BM-SR), as the fault left the platform
  '  (SRC_REV 63: EVST_INCLINE, the overloaded climb's stop reasons, removed with the climb)
  '  EVST_SPIN     - SRC_REV 70, the floor session FLOOR_ACT_AUTO: each spin leg's log, EV_SETTLE_MS after the leg, before its
  '                  lifetime is closed (the spin logs printed no BM-EV before, so the path limiter's engages there were invisible)
  '  EVST_RAMP     - the floor session's ramp legs: each leg's log, EV_SETTLE_MS after its rest
  '  EVST_BACK     - the floor session FLOOR_ACT_OBSTACLE's drive back: its log, EV_SETTLE_MS after its rest
  '
  ' EV_SETTLE_MS. A rate-limited kind (the hall counts) and the fold-back's release are queued only on the event-check
  '  pass after EV_RATE_GAP_MS of quiet, and that check runs every EV_CHECK_MS. The last change is seen at most one check
  '  after it happens, and the release is queued at most one check after the gap has run from there: EV_RATE_GAP_MS +
  '  2 x EV_CHECK_MS after the last change. Two more checks are margin. Every drain that needs it is taken at least this
  '  long after its act has come to rest (waitRest()'s own REST_CONFIRM_MS comes on top), so it holds every event the act
  '  produced.
    EV_KIND_SLOTS    = wheelL.EV_FOLDBACK - wheelL.EV_NONE + 1                     ' 16: EV_NONE .. EV_FOLDBACK
  ' The log a drained event came from (steering's EVW_* less EVW_LEFT; a wheel object's own events are its side's):
    #0, EVI_LEFT, EVI_RIGHT, EVI_PLAT
    EV_WHEELS        = EVI_PLAT + 1
  ' The kinds a drain keeps in order, the first EV_SEQ_MAX of each per log (every kind is counted and summed):
    #0, EVQ_STOP, EVQ_CLIMIT, EVQ_PATH, EVQ_FOLD, EVQ_RETRY, EVQ_GUARD
    EVQ_COUNT        = EVQ_GUARD + 1
    EV_SEQ_MAX       = 6
    EV_DRAIN_MAX     = (2 * (wheelL.EV_QUEUE_DEPTH + 1)) + 8                       ' two logs' kept events and EV_LOST each, and what arrives meanwhile
    EV_CHECK_MS      = (wheelL.WINDOW_PASSES * MS_PER_SEC) / wheelL.FRONT_LOOP_HZ  ' 8: the front cog's event-check period
    EV_SETTLE_MS     = wheelL.EV_RATE_GAP_MS + (4 * EV_CHECK_MS)                   ' 1_032
  ' The object a drain reads:
    #0, EVSRC_STEER, EVSRC_LEFT, EVSRC_RIGHT
  ' The stage (token = tokEvStage):
    #0, EVST_SKCHECK, EVST_FRTRIAL, EVST_FRHOOK, EVST_FRPLAT, EVST_D_FOLD, EVST_D_DERATE, EVST_D_BLOCK, EVST_STEERSEG, EVST_WHEEL, ...
        EVST_PACK, EVST_OBSTACLE, EVST_GRAB, EVST_FAULTRUN, EVST_SPIN, EVST_RAMP, EVST_BACK
    EVST_COUNT       = EVST_BACK + 1
    TOKMAX_EVSTAGE   = 8
    TOKMAX_EVKIND    = 12
    TOKMAX_EVWHEEL   = 5
    TOKMAX_SR        = 10
    SR_TOK_COUNT     = wheelL.SR_PARTNER - wheelL.SR_NONE + 1                      ' tokSr is indexed by the library's SR_* less SR_NONE
  ' R20-DUAL-FRONTST-EV (SS2.3): A-10's gate on the steering front cog's worst pass, the budget the event records spend
    FRONT_EV_PASS_US = 950
    R20_BAD_LO       = 0                                                           ' every R20 count cell passes at zero bad instances
    R20_BAD_HI       = 0

DAT ' ---- reporting tables (task 3621) ----

tokEvStage      BYTE    "SKCHECK", 0, "FRTRIAL", 0, "FRHOOK", 0, "FRPLAT", 0, "D_FOLD", 0, "D_DERATE", 0, "D_BLOCK", 0
                BYTE    "STEERSEG", 0, "WHEEL", 0, "PACK", 0, "OBSTACLE", 0, "GRAB", 0, "FAULTRUN", 0
                BYTE    "SPIN", 0, "RAMP", 0, "BACK", 0, TOK_END
' the library's EV_*, EV_NONE first (EV_FAULT_RESYNC printed RESYNC, EV_CURRENT_LIMIT CUR_LIMIT)
tokEvKind       BYTE    "NONE", 0, "LOST", 0, "STOP", 0, "RESYNC", 0, "FAULT", 0, "HOLD_SLIP", 0, "HOLD_LIMIT", 0
                BYTE    "CUR_LIMIT", 0, "PATH_LIMIT", 0, "HALL_MISSED", 0, "HALL_ILLEGAL", 0, "WALK_GUARD", 0
                BYTE    "LATE_PASS", 0, "PACK", 0, "CHECK_RETRY", 0, "FOLDBACK", 0, TOK_END
tokEvWheel      BYTE    "LEFT", 0, "RIGHT", 0, "PLAT", 0, TOK_END
' the library's SR_*, SR_NONE first (SR_FAULT_CONTROLLED printed FAULT_CTRL)
tokSr           BYTE    "NONE", 0, "COMMANDED", 0, "AT_LIMIT", 0, "FAULT_CTRL", 0, "FAULT_LOST", 0, "BLOCKED", 0
                BYTE    "LINK_LOST", 0, "EMERGENCY", 0, "PARTNER", 0, TOK_END

VAR { the driver's reporting (task 3621) -- one drain's staging, cog 0 only }

    LONG    evdN[EV_WHEELS * EV_KIND_SLOTS]                 ' [log * EV_KIND_SLOTS + kind - EV_NONE]: events of that kind read
    LONG    evdSum[EV_WHEELS * EV_KIND_SLOTS]               ' ...their values summed
    LONG    evdSeq[EV_WHEELS * EVQ_COUNT * EV_SEQ_MAX]      ' [(log * EVQ_COUNT + EVQ_*) * EV_SEQ_MAX + i]: the first values, in order
    LONG    evdLost                                         ' events the drain was told it lost (EV_LOST values), and unknown kinds
    LONG    evdReads                                        ' events of any kind it read
    LONG    bEvdEnded                                       ' it ended on EV_NONE inside EV_DRAIN_MAX reads
    LONG    evdSinceMs                                      ' SRC_REV 70: set by the caller before a drain: the window's start, getms()
    LONG    evdUntilMs                                      ' ...and its end
    LONG    evdPathPre                                      ' ...EV_PATH_LIMIT engages (value under PERMILLE_FULL, either wheel) stamped before the window
    LONG    evdPathIn                                       ' ...EV_PATH_LIMIT transitions, engages AND releases, stamped inside it
    LONG    evdPathEng[2]                                   ' ...per wheel (EVI_LEFT, EVI_RIGHT): the last one before the window was an engage
    LONG    evdPathOn[2]                                    ' ...per wheel: SRC_REV 82 (PL-192): an engage inside the window found it released, the onset (not counted in evdPathIn)
    LONG    evdFoldMs[EV_WHEELS]                            ' SRC_REV 75 (BLKLIMIT): the stamp of the first EV_FOLDBACK engage (value 0) each log held...
    LONG    bEvdFold[EV_WHEELS]                             ' ...one was read
    LONG    evdBlockedMs[EV_WHEELS]                         ' ...and of the first EV_STOP whose reason was SR_BLOCKED, the protective stop's latch
    LONG    bEvdBlocked[EV_WHEELS]                          ' ...one was read
    LONG    evdFltSinceMs                                   ' SRC_REV 81 (PL-189): set by the caller before a drain: the stamp EV_FAULT and EV_FAULT_RESYNC are counted from, getms()
    LONG    evdFltAfter[EV_WHEELS]                          ' ...each log's EV_FAULT events stamped at or after it
    LONG    evdRsyAfter[EV_WHEELS]                          ' ...and its EV_FAULT_RESYNC events
    LONG    evdFoldIn[EV_WHEELS]                            ' ...each log's EV_FOLDBACK events (engages and releases) stamped inside the window evdSinceMs .. evdUntilMs
    LONG    bEvdFoldPre[EV_WHEELS]                          ' ...whether its last EV_FOLDBACK before that window was an engage (value 0), the fold-back still engaged at its start

PRI evDrain(src, stage) | eKind, nMs, eWheel, nValue, logIdx
' DRAIN one event log (this section's CON): getEvent() until EV_NONE, at most EV_DRAIN_MAX reads, each event printed as
' BM-EV and counted into the evd* staging, cleared first. The steering object merges both wheels' logs and the
' platform's; a wheel object's log is its own. SRC_REV 70: each path-limiter engage is also counted before or after
' the window evdSinceMs..evdUntilMs: the engages before it (evdPathPre), the transitions inside it (evdPathIn) and
' whether each wheel's last one before it was an engage (evdPathEng), the GRAB trial's LDHUNT reading. SRC_REV 82 (PL-192): a wheel's
' first engage inside the window that found it released is its onset (evdPathOn), not a transition: a hold that engages once and holds
' to the stop is not hunting. SRC_REV 75: and each log's
' first EV_FOLDBACK engage and first SR_BLOCKED stop, with their stamps (bEvdFold, evdFoldMs, bEvdBlocked, evdBlockedMs: BLKLIMIT).
' SRC_REV 81 (PL-189): and each log's EV_FAULT and EV_FAULT_RESYNC stamped at or after evdFltSinceMs (evdFltAfter, evdRsyAfter: LDFLT),
' and its EV_FOLDBACK events inside the window evdSinceMs..evdUntilMs with whether the last before it was an engage (evdFoldIn,
' bEvdFoldPre: LDPATH's premise). The caller sets all three stamps before the drain; a drain whose caller set none counts them
' from a stale stamp, and no one reads them.
'
' @param src - EVSRC_STEER, EVSRC_LEFT (wheelL) or EVSRC_RIGHT (wheelR)
' @param stage - EVST_* printed on each BM-EV
'
' @local eKind - a read's kind
' @local nMs - its getms() stamp
' @local eWheel - the steering object's EVW_* for it
' @local nValue - its value
' @local logIdx - EVI_* of the log that held it

    longfill(@evdN, 0, EV_WHEELS * EV_KIND_SLOTS)
    longfill(@evdSum, 0, EV_WHEELS * EV_KIND_SLOTS)
    longfill(@evdSeq, 0, EV_WHEELS * EVQ_COUNT * EV_SEQ_MAX)
    evdLost := 0
    evdReads := 0
    evdPathPre := 0
    evdPathIn := 0
    evdPathEng[EVI_LEFT] := FALSE
    evdPathEng[EVI_RIGHT] := FALSE
    evdPathOn[EVI_LEFT] := FALSE
    evdPathOn[EVI_RIGHT] := FALSE
    longfill(@evdFoldMs, 0, EV_WHEELS)
    longfill(@bEvdFold, FALSE, EV_WHEELS)
    longfill(@evdBlockedMs, 0, EV_WHEELS)
    longfill(@bEvdBlocked, FALSE, EV_WHEELS)
    longfill(@evdFltAfter, 0, EV_WHEELS)
    longfill(@evdRsyAfter, 0, EV_WHEELS)
    longfill(@evdFoldIn, 0, EV_WHEELS)
    longfill(@bEvdFoldPre, FALSE, EV_WHEELS)
    bEvdEnded := FALSE
    repeat EV_DRAIN_MAX
        beat(CP_LIB_STEER_QUERY)
        if src == EVSRC_STEER                               ' if/else, never `? :` -- PL-29, PL-76
            eKind, nMs, eWheel, nValue := steering.getEvent()
        elseif src == EVSRC_RIGHT
            eKind, nMs, nValue := wheelR.getEvent()
            eWheel := steering.EVW_RIGHT
        else
            eKind, nMs, nValue := wheelL.getEvent()
            eWheel := steering.EVW_LEFT
        beat(CP_LIB_STEER_QUERY)
        if eKind == wheelL.EV_NONE
            bEvdEnded := TRUE
            quit
        evdReads += 1
        logIdx := ((eWheel - steering.EVW_LEFT) #> EVI_LEFT) <# EVI_PLAT
        evFold(logIdx, eKind, nValue)
        if (eKind == wheelL.EV_FOLDBACK) and (nValue == 0) and (bEvdFold[logIdx] == FALSE)          ' SRC_REV 75: BLKLIMIT's two stamps
            bEvdFold[logIdx] := TRUE
            evdFoldMs[logIdx] := nMs
        if (eKind == wheelL.EV_STOP) and (nValue == wheelL.SR_BLOCKED) and (bEvdBlocked[logIdx] == FALSE)
            bEvdBlocked[logIdx] := TRUE
            evdBlockedMs[logIdx] := nMs
        if (eKind == wheelL.EV_PATH_LIMIT) and (logIdx <> EVI_PLAT)
            if (nMs - evdSinceMs) < 0                       ' a getms() difference is wrap-safe
                evdPathEng[logIdx] := (nValue < wheelL.PERMILLE_FULL)
                if nValue < wheelL.PERMILLE_FULL
                    evdPathPre += 1
            elseif (nMs - evdUntilMs) <= 0
                if (nValue < wheelL.PERMILLE_FULL) and (evdPathEng[logIdx] == FALSE) and (evdPathOn[logIdx] == FALSE)
                    evdPathOn[logIdx] := TRUE               ' SRC_REV 82 (PL-192): the onset, not a flip
                else
                    evdPathIn += 1
        if (eKind == wheelL.EV_FAULT) and ((nMs - evdFltSinceMs) >= 0)              ' SRC_REV 81 (LDFLT): faults from the stamp on
            evdFltAfter[logIdx] += 1
        if (eKind == wheelL.EV_FAULT_RESYNC) and ((nMs - evdFltSinceMs) >= 0)
            evdRsyAfter[logIdx] += 1
        if eKind == wheelL.EV_FOLDBACK                      ' SRC_REV 81 (LDPATH's premise): the fold-back against the window, as the path limiter above
            if (nMs - evdSinceMs) < 0
                bEvdFoldPre[logIdx] := (nValue == 0)
            elseif (nMs - evdUntilMs) <= 0
                evdFoldIn[logIdx] += 1
        emitEv(stage, eKind, nMs, logIdx, nValue)

PRI evFold(logIdx, eKind, nValue) | arrIdx, qIdx
' Count one drained event into the evd* staging: its kind's count and sum, and, for a kind kept in order, its value.
' A kind outside EV_NONE .. EV_FOLDBACK is counted as lost: it is not a value this file can judge.
'
' @param logIdx - EVI_*
' @param eKind - EV_*
' @param nValue - its value
'
' @local arrIdx - the kind's index in evdN / evdSum
' @local qIdx - EVQ_* for a kind kept in order, -1 otherwise

    if (eKind < wheelL.EV_NONE) or (eKind > wheelL.EV_FOLDBACK)
        evdLost += 1
    else
        if eKind == wheelL.EV_LOST
            evdLost += nValue #> 1
        arrIdx := (logIdx * EV_KIND_SLOTS) + (eKind - wheelL.EV_NONE)
        qIdx := evqOf(eKind)
        if (qIdx >= 0) and (evdN[arrIdx] < EV_SEQ_MAX)
            evdSeq[(((logIdx * EVQ_COUNT) + qIdx) * EV_SEQ_MAX) + evdN[arrIdx]] := nValue
        evdN[arrIdx] += 1
        evdSum[arrIdx] += nValue

PRI evqOf(eKind) : qIdx
' The EVQ_* slot a kind is kept in order under, or -1.
'
' @param eKind - EV_*
' @returns qIdx - EVQ_STOP, EVQ_CLIMIT, EVQ_PATH, EVQ_FOLD, EVQ_RETRY, EVQ_GUARD, or -1

    case eKind
        wheelL.EV_STOP:
            qIdx := EVQ_STOP
        wheelL.EV_CURRENT_LIMIT:
            qIdx := EVQ_CLIMIT
        wheelL.EV_PATH_LIMIT:
            qIdx := EVQ_PATH
        wheelL.EV_FOLDBACK:
            qIdx := EVQ_FOLD
        wheelL.EV_CHECK_RETRY:
            qIdx := EVQ_RETRY
        wheelL.EV_WALK_GUARD:
            qIdx := EVQ_GUARD
        other:
            qIdx := -1

PRI evCount(logIdx, eKind) : nCount
' Events of one kind the last drain read from one log.
'
' @param logIdx - EVI_*
' @param eKind - EV_NONE .. EV_FOLDBACK
' @returns nCount - the count

    nCount := evdN[(logIdx * EV_KIND_SLOTS) + (eKind - wheelL.EV_NONE)]

PRI evSum(logIdx, eKind) : nSum
' The values of one kind the last drain read from one log, summed.
'
' @param logIdx - EVI_*
' @param eKind - EV_NONE .. EV_FOLDBACK
' @returns nSum - the sum

    nSum := evdSum[(logIdx * EV_KIND_SLOTS) + (eKind - wheelL.EV_NONE)]

PRI evSeqAt(logIdx, qIdx, seqIdx) : nValue
' The seqIdx'th value of a kind kept in order, from one log of the last drain.
'
' @param logIdx - EVI_*
' @param qIdx - EVQ_*
' @param seqIdx - 0..EV_SEQ_MAX-1
' @returns nValue - the value

    nValue := evdSeq[(((logIdx * EVQ_COUNT) + qIdx) * EV_SEQ_MAX) + seqIdx]

PRI bEvdClean() : bClean
' Whether the last drain can be judged: it ended on EV_NONE and nothing was lost.
'
' @returns bClean - TRUE when it can

    bClean := bEvdEnded and (evdLost == 0)

PRI evPairs(logIdx, qIdx) : nPairs, bFormed | eKind, nVals, seqIdx, nValue
' The engage/release pairs one log's EV_FOLDBACK (qIdx EVQ_FOLD: engage value 0, release a frame count over 0) or
' EV_PATH_LIMIT (EVQ_PATH: engage under PERMILLE_FULL, release PERMILLE_FULL) holds in the last drain, and whether the
' whole sequence is engage, release, engage, release ..., ending on a release, with every value in order kept.
'
' @param logIdx - EVI_*
' @param qIdx - EVQ_FOLD or EVQ_PATH
' @returns nPairs - the pairs, when well formed; 0 otherwise
' @returns bFormed - TRUE when the sequence is well formed (an empty one is)
'
' @local eKind - the kind qIdx keeps
' @local nVals - its events in the drain
' @local seqIdx - 0..nVals-1
' @local nValue - one value

    eKind := wheelL.EV_PATH_LIMIT
    if qIdx == EVQ_FOLD
        eKind := wheelL.EV_FOLDBACK
    nVals := evCount(logIdx, eKind)
    bFormed := (nVals <= EV_SEQ_MAX) and ((nVals // 2) == 0)
    if bFormed and (nVals > 0)                              ' a Spin2 repeat from a higher bound counts down
        repeat seqIdx from 0 to nVals - 1
            nValue := evSeqAt(logIdx, qIdx, seqIdx)
            if (seqIdx // 2) == 0
                if qIdx == EVQ_FOLD
                    bFormed &= (nValue == 0)
                else
                    bFormed &= (nValue < wheelL.PERMILLE_FULL)
            elseif qIdx == EVQ_FOLD
                bFormed &= (nValue > 0)
            else
                bFormed &= (nValue == wheelL.PERMILLE_FULL)
    nPairs := 0
    if bFormed
        nPairs := nVals / 2

PRI wheelStopReason(side) : eReason
' getStopReason() of one wheel object (R20.1).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns eReason - SR_*

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT                                   ' if/else, never `? :` -- PL-29, PL-76
        eReason := wheelR.getStopReason()
    else
        eReason := wheelL.getStopReason()
    beat(CP_LIB_QUERY)

PRI wheelEventTotal(side, eKind) : nCount
' getEventTotal() of one wheel object (R20.1): the events of a kind queued since its start, read or not, lost or not.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param eKind - EV_STOP .. EV_FOLDBACK
' @returns nCount - the total

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        nCount := wheelR.getEventTotal(eKind)
    else
        nCount := wheelL.getEventTotal(eKind)
    beat(CP_LIB_QUERY)

PRI wheelDrainError(side)
' Drain one wheel object's error slot for this cog (getError(), result discarded): what an earlier call left is not
' the next start's cause.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        wheelR.getError()
    else
        wheelL.getError()
    beat(CP_LIB_QUERY)

PRI wheelReadRefusal(side)
' A wheel start that returned -1: its getError() cause and its getHealth() masks, into the st* staging BM-REFUSE prints.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        stErr := wheelR.getError()
        stChk, stFail, stRec := wheelR.getHealth()
    else
        stErr := wheelL.getError()
        stChk, stFail, stRec := wheelL.getHealth()
    beat(CP_LIB_QUERY)

PRI emitEv(stage, eKind, nMs, logIdx, nValue)
' BM-EV (task 3621): one event a drain read -- the stage, the kind, getms() when it was queued, the log that held it
' (PLAT: the platform's own), and its value, meaning per EV_* (DRIVER-REPORTING-DESIGN.md SS2.1). Worst case 101 bytes.
'
' @param stage - EVST_*
' @param eKind - EV_*
' @param nMs - the event's getms() stamp
' @param logIdx - EVI_*
' @param nValue - the event's value

    recBegin(@"BM-EV")
    benchLog.tokenField(@"stage", tokenAt(@tokEvStage, EVST_COUNT, stage), TOKMAX_EVSTAGE)
    benchLog.tokenField(@"kind", tokenAt(@tokEvKind, EV_KIND_SLOTS, eKind - wheelL.EV_NONE), TOKMAX_EVKIND)
    benchLog.tokenField(@"wheel", tokenAt(@tokEvWheel, EV_WHEELS, logIdx), TOKMAX_EVWHEEL)
    benchLog.numField(@"ms", nMs, LIM_BIG)
    benchLog.numField(@"value", nValue, LIM_BIG)
    emitRecord()

PRI emitSr(stage, side, eLeftReason, eRightReason, bLeftRead, bRightRead)
' BM-SR (task 3621): the stop reasons read at one point -- the stage, the wheel the stage is about (the one faulted, or
' the one started alone), the trace in hand, and each wheel's getStopReason() (NA for a wheel not read). Worst case
' 93 bytes.
'
' @param stage - EVST_*
' @param side - SIDE_LEFT, SIDE_RIGHT or SIDE_BOTH
' @param eLeftReason - the left wheel's SR_*
' @param eRightReason - the right wheel's SR_*
' @param bLeftRead - the left wheel's was read
' @param bRightRead - the right wheel's was read

    recBegin(@"BM-SR")
    benchLog.tokenField(@"stage", tokenAt(@tokEvStage, EVST_COUNT, stage), TOKMAX_EVSTAGE)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.naNumField(@"tid", curTid, LIM_SMALL, curTid > 0)
    srField(@"l_sr", eLeftReason, bLeftRead)
    srField(@"r_sr", eRightReason, bRightRead)
    emitRecord()

PRI srField(pName, eReason, bRead)
' One stop-reason field: the SR_* token, or NA when not read.
'
' @param pName - the field name
' @param eReason - SR_*
' @param bRead - TRUE when eReason was read

    if bRead
        benchLog.tokenField(pName, tokenAt(@tokSr, SR_TOK_COUNT, eReason - wheelL.SR_NONE), TOKMAX_SR)
    else
        benchLog.textField(pName, @sSfNa)

PRI emitEvTot(stage, side, lFold, rFold, lClim, rClim, lPath, rPath, nLate)
' BM-EVTOT (task 3621): one of part D's default-limit forms, its getEventTotal() since its start for the kinds a lowered
' limit makes, read beside its FRONTST: EV_FOLDBACK, EV_CURRENT_LIMIT and EV_PATH_LIMIT per wheel, and EV_LATE_PASS (the
' steering object's is the platform's). The single wheel prints its own in the l_ fields and NA in the r_ ones. Worst
' case 150 bytes.
'
' @param stage - EVST_STEERSEG or EVST_WHEEL
' @param side - SIDE_BOTH (the steering object) or SIDE_LEFT (the single wheel)
' @param lFold - the left wheel's EV_FOLDBACK total
' @param rFold - the right wheel's
' @param lClim - the left wheel's EV_CURRENT_LIMIT total
' @param rClim - the right wheel's
' @param lPath - the left wheel's EV_PATH_LIMIT total
' @param rPath - the right wheel's
' @param nLate - the form's EV_LATE_PASS total

    recBegin(@"BM-EVTOT")
    benchLog.tokenField(@"stage", tokenAt(@tokEvStage, EVST_COUNT, stage), TOKMAX_EVSTAGE)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"l_fold", lFold, LIM_SMALL)
    benchLog.naNumField(@"r_fold", rFold, LIM_SMALL, side == SIDE_BOTH)
    benchLog.numField(@"l_clim", lClim, LIM_SMALL)
    benchLog.naNumField(@"r_clim", rClim, LIM_SMALL, side == SIDE_BOTH)
    benchLog.numField(@"l_path", lPath, LIM_SMALL)
    benchLog.naNumField(@"r_path", rPath, LIM_SMALL, side == SIDE_BOTH)
    benchLog.numField(@"late", nLate, LIM_SMALL)
    emitRecord()

PRI emitSRefuse(seg)
' BM-SREFUSE (task 3621): a steering start() that returned -1, and why -- the three getError() codes (the platform's,
' then each wheel's; ERR_START_CHECK_FAILED is a refusal) and both wheels' getHealth() masks (HLT_* bits, hex), all read
' right after the call. Worst case 190 bytes.
'
' @param seg - SEG_* in progress

    recBegin(@"BM-SREFUSE")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"life", steerLife, LIM_SMALL)
    benchLog.numField(@"ret", ssRet, LIM_TINY)
    benchLog.numField(@"err", ssErr, LIM_SMALL)
    benchLog.numField(@"l_err", ssLErr, LIM_SMALL)
    benchLog.numField(@"r_err", ssRErr, LIM_SMALL)
    benchLog.hexField(@"l_chk", ssChk[SLOT_LEFT])
    benchLog.hexField(@"l_fail", ssFail[SLOT_LEFT])
    benchLog.hexField(@"l_rec", ssRec[SLOT_LEFT])
    benchLog.hexField(@"r_chk", ssChk[SLOT_RIGHT])
    benchLog.hexField(@"r_fail", ssFail[SLOT_RIGHT])
    benchLog.hexField(@"r_rec", ssRec[SLOT_RIGHT])
    emitRecord()

PRI emitRProbe(seg, side, bSteer) | ePhase, nUMv, nVMv, nWMv
' BM-RPROBE (PL-120, Visit 10 pass 5): one wheel's lead-check readings after a start() that returned -1 -- the last
' attempt's, which the driver keeps until the next start (testGetProbe()). p_<driven><read> as BM-SKPROBE. A wheel
' whose bridge stopped driving shows here which phases it could still raise and where the others sat. Worst case
' 150 bytes.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param bSteer - T/F where T means the steering object's start refused (life is the steering life), F a wheel's own
'
' @local ePhase - the phase that was driven, PRB_U..PRB_W
' @local nUMv - U's reading while ePhase was driven, mV
' @local nVMv - V's reading
' @local nWMv - W's reading

    recBegin(@"BM-RPROBE")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"life", bSteer ? steerLife : slotLife[side - SIDE_LEFT], LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    repeat ePhase from wheelL.PRB_U to wheelL.PRB_W
        beat(bSteer ? CP_LIB_STEER_QUERY : CP_LIB_QUERY)
        if bSteer and (side == SIDE_LEFT)
            nUMv, nVMv, nWMv := steering.testLeftGetProbe(ePhase)
        elseif bSteer
            nUMv, nVMv, nWMv := steering.testRightGetProbe(ePhase)
        elseif side == SIDE_LEFT
            nUMv, nVMv, nWMv := wheelL.testGetProbe(ePhase)
        else
            nUMv, nVMv, nWMv := wheelR.testGetProbe(ePhase)
        benchLog.numField(lookupz(ePhase - wheelL.PRB_U : @"p_uu", @"p_vu", @"p_wu"), nUMv, LIM_SMALL)
        benchLog.numField(lookupz(ePhase - wheelL.PRB_U : @"p_uv", @"p_vv", @"p_wv"), nVMv, LIM_SMALL)
        benchLog.numField(lookupz(ePhase - wheelL.PRB_U : @"p_uw", @"p_vw", @"p_ww"), nWMv, LIM_SMALL)
    emitRecord()

PRI emitRefuse(seg, side)
' BM-REFUSE (task 3621): a wheel start() that returned -1, and why -- its getError() code and its getHealth() masks
' (HLT_* bits, hex), read right after the call. Worst case 130 bytes.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT

    recBegin(@"BM-REFUSE")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"life", slotLife[side - SIDE_LEFT], LIM_SMALL)
    benchLog.numField(@"ret", stCogRet, LIM_TINY)
    benchLog.numField(@"err", stErr, LIM_SMALL)
    benchLog.hexField(@"chk", stChk)
    benchLog.hexField(@"fail", stFail)
    benchLog.hexField(@"rec", stRec)
    emitRecord()

PRI r20ResetCells() | formIdx
' Clear R20-T0-EV-LATE's and part D's event-cell accumulators (initRunState()), so a cell nothing reached prints NOMEAS.
'
' @local formIdx - [0] the steering front cog, [1] the single wheel's

    repeat formIdx from SLOT_LEFT to SLOT_RIGHT
        sfLateRepN[formIdx] := 0
        sfLateRepBad[formIdx] := 0
        sfLateNoneN[formIdx] := 0
        sfLateNoneBad[formIdx] := 0
    dEvStages := 0
    dEvUnclean := 0
    dFoldPairs := 0
    dFoldBadSeq := 0
    dPathBadSeq := 0
    dPathPairs := 0
    dPathLogMax := 0
    bDPathBehind := FALSE
    bDBlockDrained := FALSE
    dClimN := 0
    dClimBad := 0
    bDClimPos := FALSE
    dDefForms := 0
    dDefFoldBad := 0
    dDefClimBad := 0
    bDDefSteer := FALSE
    dDefPathBad := 0

PRI lateFold(formIdx, nLate, nLateEv)
' Fold one FRONTST read into R20-T0-EV-LATE (task 3621, SS6): EV_LATE_PASS is queued iff a front pass ran late. A read
' with late passes and no event is bad; so is one with an event and no late pass.
'
' @param formIdx - [0] the steering front cog, [1] the single wheel's
' @param nLate - the form's late passes since its start
' @param nLateEv - its EV_LATE_PASS total since its start

    if nLate > 0
        sfLateRepN[formIdx] := (sfLateRepN[formIdx] + 1) <# LIM_SMALL
        if nLateEv == 0
            sfLateRepBad[formIdx] := (sfLateRepBad[formIdx] + 1) <# LIM_SMALL
    else
        sfLateNoneN[formIdx] := (sfLateNoneN[formIdx] + 1) <# LIM_SMALL
        if nLateEv <> 0
            sfLateNoneBad[formIdx] := (sfLateNoneBad[formIdx] + 1) <# LIM_SMALL

PRI emitLateCells(formIdx, side)
' R20-T0-EV-LATE's two instances for one front-cog form: LATE_REPORTED (reads with a late pass, each must have its
' EV_LATE_PASS; NOMEAS while no pass has run late -- MEASURED 0 at Visit 8) and NO_LATE_NO_EVENT (reads with none, each
' must have no EV_LATE_PASS). Together they are the iff; either instance FAILS on one bad read.
'
' @param formIdx - [0] the steering front cog, [1] the single wheel's
' @param side - SIDE_BOTH (steering) or SIDE_LEFT (the wheel)

    emitSignoff(@sSfCellEvLate, side, @sSfCritLateRep, sfLateRepN[formIdx] > 0, sfLateRepBad[formIdx], R20_BAD_LO, R20_BAD_HI, sfLateRepN[formIdx], @sSfUnitsCount)
    emitSignoff(@sSfCellEvLate, side, @sSfCritLateNone, sfLateNoneN[formIdx] > 0, sfLateNoneBad[formIdx], R20_BAD_LO, R20_BAD_HI, sfLateNoneN[formIdx], @sSfUnitsCount)

CON { --- wheel and steering wrappers: every library call is bracketed by beat(CP_LIB_*) --- }

PRI bWheelStart(seg, side) : bStarted | slotIdx, cogValue, startMs, restMs, nMissed, nIllegal
' Start one wheel alone and record its lifetime: refuse unless the instrument is IDLE or FROZEN (I10);
' stop the steering object and both wheels first (I6, shared pin claims PL-18); keep starts at least
' START_SPACING_MS apart; start with board detection never forced (I12); wait ready; read the cog,
' board, offsets and integrity counts; take this lifetime's floated zero-command sense mean through
' the instrument; emit BM-START. A retired motor is not started. Task 3621: the start is watched with the
' start grace (WD_START_GRACE_MS), and a start that returns -1 is followed by BM-REFUSE -- its getError() cause
' and its getHealth() masks, read right after the call.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bStarted - TRUE when the cog is valid and the driver reported ready
'
' @local slotIdx - motor slot
' @local cogValue - testGetMotorCog() after the start
' @local startMs - getms() after start(), for the ready wait
' @local restMs - spacing still owed before this start
' @local nMissed - missed transitions at start
' @local nIllegal - illegal codes at start

    slotIdx := side - SIDE_LEFT
    bStarted := FALSE
    stWhy := WHY_NONE
    if bInstQuiet() == FALSE
        instRefused(seg)
        stWhy := WHY_INST_BUSY
    elseif bSlotRetired[slotIdx]
        stWhy := WHY_MOTOR_RETIRED
    else
        steerStop()
        wheelStopRaw(SIDE_LEFT)
        wheelStopRaw(SIDE_RIGHT)
        restMs := START_SPACING_MS - (getms() - lastStartMs)
        if bAnyStart and (restMs > 0)
            waitBeat(restMs, CP_LOOP_REST)
        ' task 3621: this cog's error slot is drained first, so a refusal's getError() below is this start's cause, and
        '  the watchdog is granted WD_START_GRACE_MS for this one call only: start() may re-run a failing check
        wheelDrainError(side)
        wdGraceMs := WD_START_GRACE_MS
        beat(CP_LIB_START)
        if side == SIDE_RIGHT
            benchLog.cogEventBegin()
            stCogRet := wheelR.start(RIGHT_TEST_BASE, TEST_VOLTAGE, TEST_DET_MODE)
            benchLog.cogEventEnd()
        else
            benchLog.cogEventBegin()
            stCogRet := wheelL.start(LEFT_TEST_BASE, TEST_VOLTAGE, TEST_DET_MODE)
            benchLog.cogEventEnd()
        beat(CP_LIB_START)
        wdGraceMs := 0
        if stCogRet < 0
            wheelReadRefusal(side)                          ' the cause and every health mask, before anything else runs
        lastStartMs := getms()
        bAnyStart := TRUE
        lifeSeq := (lifeSeq + 1) <# LIM_SMALL
        slotLife[slotIdx] := lifeSeq
        bBrakeRequested[slotIdx] := FALSE                   ' init() sets SM_FLOAT
        startMs := getms()
        repeat
            bStReady := isWheelReady(side)
            if bStReady or ((getms() - startMs) >= READY_TIMEOUT_MS)
                quit
            beat(CP_LOOP_READY)
            waitms(SAMPLE_MS)
        stReadyMs := getms() - startMs
        beat(CP_LIB_QUERY)
        if side == SIDE_RIGHT
            cogValue := wheelR.testGetMotorCog()
            stBoard := wheelR.getBoardType()
            nMissed, nIllegal := wheelR.getHallIntegrityCounts()
        else
            cogValue := wheelL.testGetMotorCog()
            stBoard := wheelL.getBoardType()
            nMissed, nIllegal := wheelL.getHallIntegrityCounts()
        beat(CP_LIB_QUERY)
        stOffNeg, stOffPos := wheelGetOffsets(side)
        stMissed := nMissed
        stIllegal := nIllegal
        bStCogOk := (stCogRet >= 0) and (stCogRet <= MAX_COG_ID) and (stCogRet == cogValue - 1)
        bStarted := bStCogOk and bStReady
        sfStarts[slotIdx] := (sfStarts[slotIdx] + 1) <# LIM_BIG
        if stBoard <> wheelL.REV_B
            sfNotRevb[slotIdx] := (sfNotRevb[slotIdx] + 1) <# LIM_BIG
        foldIntegrity(slotIdx, nMissed, nIllegal)
        bLifeZeroValid[slotIdx] := FALSE
        slotLastIncre[slotIdx] := 0                         ' R18.1: a new lifetime starts at rest
        if bStarted
            stWhy := lifetimeZero(side)
        else
            stWhy := WHY_NO_COG
        emitStart(seg, side)
        if stCogRet < 0
            emitRefuse(seg, side)                           ' task 3621: why the start returned -1
            emitRProbe(seg, side, FALSE)                    ' PL-120: what the refusing lead check read

PRI lifetimeZero(side) : whyCode | slotIdx, winStartTotal, winEndTotal
' Take this driver lifetime's floated zero-command sense_i and phase-sum means: ZERO_WINDOW_MS through
' the instrument (no getter in a timed wait, sec 2.8), valid only within this lifetime (PL-32). The
' window is delimited by two instrument-recorded ring totals (sec 12.7).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns whyCode - WHY_NONE, or the cause of the missing zero
'
' @local slotIdx - motor slot
' @local winStartTotal - ring total at the window start
' @local winEndTotal - ring total at the window end

    slotIdx := side - SIDE_LEFT
    whyCode := WHY_INST_NOACK
    if bInstArm(INST_SRC_WHEELS, 1)
        winStartTotal := instMarkIndex()
        waitWatched(side, ZERO_WINDOW_MS, CP_LOOP_ZERO, UNTIL_TIME)
        winEndTotal := instMarkIndex()
        if bInstFreeze(0)
            windowStats(slotIdx, SLOT_RIGHT - slotIdx, winStartTotal, winEndTotal)
            if rsN > 0
                lifeZeroX10[slotIdx] := rsIMeanX10
                lifePhX10[slotIdx] := rsPhMeanX10
                bLifeZeroValid[slotIdx] := TRUE
                whyCode := WHY_NONE
            else
                whyCode := WHY_NO_SAMPLES
        bInstIdle()

PRI instRefused(seg)
' Record a wrapper refusal because the instrument had not acknowledged IDLE or FROZEN (I10).
'
' @param seg - SEG_* in progress

    instBusyRefusals := (instBusyRefusals + 1) <# LIM_BIG
    emitSeg(seg, SEGEV_SKIP, bSegAttended(seg), 0, 0, 0, 0, WHY_INST_BUSY)

PRI wheelStop(side)
' Stop one wheel. The instrument is first returned to IDLE (I10). A stop is never refused: if the
' instrument does not acknowledge, the refusal is recorded and the wheel is stopped anyway, because
' stopping is the safe direction and a straddled sample is gated by up (I3).
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    if bInstQuiet() == FALSE
        bInstIdle()
        if bInstQuiet() == FALSE
            instRefused(curSeg)
    wheelStopRaw(side)

PRI wheelStopRaw(side)
' stop() one wheel (cogstop + pinclear, which floats it) and forget any brake request (I6).
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    beat(CP_LIB_STOP)
    if side == SIDE_RIGHT
        benchLog.cogEventBegin()
        wheelR.stop()
    else
        benchLog.cogEventBegin()
        wheelL.stop()
    beat(CP_LIB_STOP)
    bBrakeRequested[side - SIDE_LEFT] := FALSE

PRI wheelCommand(side, motorIncre) | safeIncre
' Command one wheel's raw increment. Nothing above COMMAND_MAX_INCRE is ever sent: LADDER_MAX_INCRE, except
' in the LIMITS build, whose climb probes to LIMTOP_MAX_INCRE.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
'
' @local safeIncre - the increment actually sent

    safeIncre := motorIncre
    if abs(motorIncre) > COMMAND_MAX_INCRE
        safeIncre := 0
    curIncre := safeIncre
    beat(CP_LIB_COMMAND)
    if side == SIDE_RIGHT
        wheelR.testDriveAtMotorIncrement(safeIncre)
    else
        wheelL.testDriveAtMotorIncrement(safeIncre)
    beat(CP_LIB_COMMAND)

PRI wheelHold(side, bBrake)
' Request BRAKE or FLOAT at stop on the wheel under test only (I6); every exit path of a BRAKE trial
' calls restoreStopMode() before the next command.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param bBrake - TRUE for holdAtStop(TRUE)

    beat(CP_LIB_HOLD)
    if side == SIDE_RIGHT
        wheelR.holdAtStop(bBrake)
    else
        wheelL.holdAtStop(bBrake)
    beat(CP_LIB_HOLD)
    bBrakeRequested[side - SIDE_LEFT] := (bBrake <> FALSE)

PRI isWheelReady(side) : bReady
' isReady() of one wheel.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bReady - TRUE when its driver reports a state

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT                                   ' if/else, never `? :` -- PL-29, PL-76
        bReady := wheelR.isReady()
    else
        bReady := wheelL.isReady()
    beat(CP_LIB_QUERY)

PRI scheduledDegrees(offsetTenths) : offDegrees
' One leg of the scheduled pair in whole degrees, rounded exactly as the driver's writeOffsetsTenths() does.
'
' @param offsetTenths - Z * 10 +- the lead in tenths, within one turn either way
' @returns offDegrees - the leg in whole degrees, 0..359

    offDegrees := ((((offsetTenths + DEGREES_IN_TURN * TENTHS_PER_DEG) // (DEGREES_IN_TURN * TENTHS_PER_DEG)) + TENTHS_PER_DEG / 2) / TENTHS_PER_DEG) // DEGREES_IN_TURN

PRI expectedOffsets() : offNeg, offPos
' The commutation pair this BUILD compiled, derived from the motor object's own constants.
'
' Judged against what the driver actually applied, so a build-time selection that never reached
'  offsetsForMotor() is caught rather than assumed. Both legs land in 0..359 after one wrap, so the
'  single conditional add is the whole normalisation this needs.
'
' @returns offNeg - expected offset_fwd degrees (negative increments)
' @returns offPos - expected offset_rev degrees (positive increments)

    offNeg := wheelL.HUB_HALL_ZERO_DEGR + wheelL.HUB_LEAD_DEGR
    offPos := wheelL.HUB_HALL_ZERO_DEGR - wheelL.HUB_LEAD_DEGR
    if offNeg < 0
        offNeg += DEGREES_IN_TURN
    if offPos < 0
        offPos += DEGREES_IN_TURN

PRI foldOffsetCheck(side, offNeg, offPos) | expNeg, expPos, bScheduled, leadTenths
' Count one reading of the applied offsets against what the build should apply (R18-DUAL-OFFSETS-A).
'
' Task 3601: with the lead schedule on, the pair changes with speed, so the expectation is the pair the
' schedule gives at the wheel's present speed (testGetLead()), not the compiled fixed pair -- which is now
' only the expectation when the schedule is off (the legacy build, or after a test set the pair by hand).
' Read at a rung's start, when the wheel is steady at the previous rung, so the front cog's one-slot write
' lag cannot separate the two readings.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param offNeg - applied offset_fwd degrees
' @param offPos - applied offset_rev degrees
'
' @local expNeg - the expected offset_fwd degrees
' @local expPos - the expected offset_rev degrees
' @local bScheduled - T/F where T means the wheel's lead schedule is on
' @local leadTenths - the schedule's lead at the present speed, tenths of a degree

    beat(CP_LIB_OFFSETS)
    if side == SIDE_RIGHT
        bScheduled, leadTenths := wheelR.testGetLead()
    else
        bScheduled, leadTenths := wheelL.testGetLead()
    beat(CP_LIB_OFFSETS)
    if bScheduled == TRUE
        expNeg := scheduledDegrees(wheelL.HUB_HALL_ZERO_DEGR * TENTHS_PER_DEG + leadTenths)
        expPos := scheduledDegrees(wheelL.HUB_HALL_ZERO_DEGR * TENTHS_PER_DEG - leadTenths)
    else
        expNeg, expPos := expectedOffsets()
    sfOffsetN := (sfOffsetN + 1) <# LIM_SMALL
    if (offNeg <> expNeg) or (offPos <> expPos)
        sfOffsetBad := (sfOffsetBad + 1) <# LIM_SMALL

PRI wheelGetOffsets(side) : offNeg, offPos
' Read back the applied commutation offsets (logged beside every wheel measurement).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns offNeg - offset_fwd degrees (negative increments)
' @returns offPos - offset_rev degrees (positive increments)

    beat(CP_LIB_OFFSETS)
    if side == SIDE_RIGHT
        offNeg, offPos := wheelR.testGetFwdRevIndep()
    else
        offNeg, offPos := wheelL.testGetFwdRevIndep()
    beat(CP_LIB_OFFSETS)

PRI wheelIntegrity(side) : nMissed, nIllegal
' Hall integrity counts of one wheel since its start.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns nMissed - missed transitions
' @returns nIllegal - illegal codes

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        nMissed, nIllegal := wheelR.getHallIntegrityCounts()
    else
        nMissed, nIllegal := wheelL.getHallIntegrityCounts()
    beat(CP_LIB_QUERY)

PRI wheelClearedState(side) : bCleared, eDrvrState, bFaultSig
' Recovery's cleared test (design sec 4.2): isStopped() AND NOT isFaultSignal().
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bCleared - stopped and not faulted
' @returns eDrvrState - DCS_* now
' @returns bFaultSig - the fault flag now

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        bCleared := wheelR.isStopped()
        bFaultSig := wheelR.isFaultSignal()
        eDrvrState := wheelR.getDriverState()
    else
        bCleared := wheelL.isStopped()
        bFaultSig := wheelL.isFaultSignal()
        eDrvrState := wheelL.getDriverState()
    beat(CP_LIB_QUERY)
    bCleared := (bCleared <> FALSE) and (bFaultSig == FALSE)

PRI isWheelUp(side) : bUp
' Report whether a wheel's driver cog is running (testGetMotorCog() <> 0, the I3 gate).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bUp - TRUE when the driver cog runs

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT                                   ' if/else, never `? :` -- PL-29, PL-76
        bUp := wheelR.testGetMotorCog() <> 0
    else
        bUp := wheelL.testGetMotorCog() <> 0
    beat(CP_LIB_QUERY)

PRI wheelStopMotor(side)
' stopMotor() one wheel: the zero command, under whatever stop mode was requested.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    curIncre := 0
    beat(CP_LIB_COMMAND)
    if side == SIDE_RIGHT
        wheelR.stopMotor()
    else
        wheelL.stopMotor()
    beat(CP_LIB_COMMAND)

PRI wheelEstop(side)
' emergencyCutoff() one wheel. Every caller clears it with restoreEmergency() after its freeze (I11).
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    curIncre := 0
    beat(CP_LIB_ESTOP)
    if side == SIDE_RIGHT
        wheelR.emergencyCutoff()
    else
        wheelL.emergencyCutoff()
    beat(CP_LIB_ESTOP)

PRI wheelAccelUp(side) : nAccelUp
' Read back one wheel's speed-up limit, accel_up (testGetRampLimits()'s second, DRIVER_REV 46; SRC_REV 59 -- the
' trace header printed ramp_inc, which DRIVER_REV 38 made the slow-down jerk).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns nAccelUp - accel_up read back

    beat(CP_LIB_RAMP)
    if side == SIDE_RIGHT
        _, nAccelUp, _, _ := wheelR.testGetRampLimits()
    else
        _, nAccelUp, _, _ := wheelL.testGetRampLimits()
    beat(CP_LIB_RAMP)

PRI wheelAccelNow(side) : nAccel
' One wheel's trajectory generator's acceleration now, the signed change of its field's increment per drive pass
' (testGetAccelNow(), DRIVER_REV 38).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns nAccel - drv_accel_now, signed

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        nAccel := wheelR.testGetAccelNow()
    else
        nAccel := wheelL.testGetAccelNow()
    beat(CP_LIB_QUERY)

PRI wheelSetRamp(side, accelRate, decelRate) : accelUpBack, accelDnBack
' Set a trial's ramp and read both limits back: FAULTB's trials and LIMRAMP's (task 3604). SRC_REV 61 (DRIVER_REV 46):
' set through the public API, setAcceleration() and setDeceleration() in mm/s^2 (the raw setRampingValues() is gone);
' the driver pairs each limit with its jerk. Every caller restores the built-in ramp with bRestoreRamp() afterwards (I11).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param accelRate - the trial's speed-up rate, mm/s^2
' @param decelRate - the trial's slow-down rate, mm/s^2
' @returns accelUpBack - accel_up read back (testGetRampLimits())
' @returns accelDnBack - accel_dn read back

    beat(CP_LIB_RAMP)
    if side == SIDE_RIGHT
        wheelR.setAcceleration(accelRate)
        wheelR.setDeceleration(decelRate)
        _, accelUpBack, _, accelDnBack := wheelR.testGetRampLimits()
    else
        wheelL.setAcceleration(accelRate)
        wheelL.setDeceleration(decelRate)
        _, accelUpBack, _, accelDnBack := wheelL.testGetRampLimits()
    beat(CP_LIB_RAMP)

PRI wheelSetOffsets(side, negDegrees, posDegrees)
' Write one wheel's commutation offsets (POSTFLT's fault-provoking write). The pair read before it is
' restored and read back with bRestoreOffsets() on every exit path (I11).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param negDegrees - offset_fwd degrees (negative increments)
' @param posDegrees - offset_rev degrees (positive increments)

    beat(CP_LIB_OFFSETS)
    if side == SIDE_RIGHT
        wheelR.testSetFwdRevIndep(negDegrees, posDegrees)
    else
        wheelL.testSetFwdRevIndep(negDegrees, posDegrees)
    beat(CP_LIB_OFFSETS)

PRI wheelCurrent(side) : ampsX10k
' getCurrent() of one wheel (debug-free, the only library call inside a ladder window).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns ampsX10k - motor current, A x 10_000

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        ampsX10k, _ := wheelR.getCurrent()
    else
        ampsX10k, _ := wheelL.getCurrent()
    beat(CP_LIB_QUERY)

PRI bWheelDerated(side) : bDeratedNow
' Whether one wheel's fold-back currently holds the continuous limit rather than the peak one.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bDeratedNow - T/F where T means the front cog has derated this motor's limit

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        _, _, bDeratedNow, _, _ := wheelR.testGetCurrentLimitState()
    else
        _, _, bDeratedNow, _, _ := wheelL.testGetCurrentLimitState()
    beat(CP_LIB_QUERY)

PRI wheelDriveConstants(side) : deadGap, dutyMax, adcFrame, frameCnt, dutyMin
' The drive constants init() derived for one wheel (testGetDriveConstants()); dutyMin as it stands now, since
' LIMLOW writes it (task 3604).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns deadGap - dead_gap, system ticks
' @returns dutyMax - duty_max, 1/16ths
' @returns adcFrame - adc_fram
' @returns frameCnt - frame_cnt
' @returns dutyMin - duty_min, 1/16ths

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT
        deadGap, _, dutyMin, dutyMax, adcFrame, frameCnt := wheelR.testGetDriveConstants()
    else
        deadGap, _, dutyMin, dutyMax, adcFrame, frameCnt := wheelL.testGetDriveConstants()
    beat(CP_LIB_QUERY)

PRI wheelDriveHealth(side) : nLagHeld, nDutyCapped, nDrvIncr
' The driver's two UNBOUNDED health counters for one wheel (testGetDriveHealth(), R18.1). Both count
' control passes since the driver started, so a rung's reading is a DIFFERENCE across its window, the
' way pos is; neither can top out, which is the whole point (PL-95: err is held near LAG_HOLD by the
' limiter and bounded by its own +-127, and duty saturates at duty_max -- so above mid-range both stop
' reporting exactly where the behaviour is).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns nLagHeld - passes on which the limiter withheld the field advance
' @returns nDutyCapped - passes on which the duty demand exceeded the cap
' @returns nDrvIncr - the field's increment per drive pass, so a withheld count converts to an advance

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT                                   ' if/else, never `? :` -- PL-29, PL-76
        nLagHeld, nDutyCapped, nDrvIncr, _ := wheelR.testGetDriveHealth()
    else
        nLagHeld, nDutyCapped, nDrvIncr, _ := wheelL.testGetDriveHealth()
    beat(CP_LIB_QUERY)

PRI wheelStartSense(side)
' startSenseCog() for one wheel (LIVE: testGetRpm() needs it). Its debug is compiled out in the quiet
' build (I5), and the wheel's stop() ends it.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    beat(CP_LIB_START)
    if side == SIDE_RIGHT
        wheelR.startSenseCog()
    else
        wheelL.startSenseCog()
    beat(CP_LIB_START)

PRI wheelRpm(side) : rpmRead
' testGetRpm() of one wheel.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns rpmRead - rpm averaged over the ~1 s window

    beat(CP_LIB_QUERY)
    if side == SIDE_RIGHT                                   ' if/else, never `? :` -- PL-29, PL-76
        rpmRead := wheelR.testGetRpm()
    else
        rpmRead := wheelL.testGetRpm()
    beat(CP_LIB_QUERY)

PRI bZeroAndWaitStopped(side) : bStopped | bArmedHere
' Command zero to a running wheel and wait, beat-polled, for DCS_STOPPED. The mirror is current only
' while the instrument is not IDLE, so an IDLE instrument is armed for the wait and frozen after it
' (callers drain before calling this). A wheel whose driver cog is not running is left alone.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bStopped - TRUE when the mirror showed DCS_STOPPED within STOP_TIMEOUT_MS
'
' @local bArmedHere - this call armed the instrument, so it freezes it

    bStopped := FALSE
    if isWheelUp(side)
        wheelCommand(side, 0)
        bArmedHere := FALSE
        if bInstQuiet() and (instState == INST_ST_IDLE)
            bArmedHere := bInstArm(INST_SRC_WHEELS, 1)
        _, bStopped := waitWatched(side, STOP_TIMEOUT_MS, CP_LOOP_STOPPED, UNTIL_STOPPED)
        if bArmedHere
            bInstFreeze(0)

PRI bSteerStart(seg) : bStarted
' Start the steering object: refuse unless the instrument is IDLE or FROZEN (I10), then bSteerStartNow().
'
' @param seg - SEG_* in progress
' @returns bStarted - TRUE when start() returned a cog id and both drivers reported ready

    bStarted := FALSE
    ssWhy := WHY_NONE
    bSsCalled := FALSE
    if bInstQuiet() == FALSE
        instRefused(seg)
    else
        bStarted := bSteerStartNow(seg)

PRI bSteerStartNow(seg) : bStarted | startMs, restMs, leftMissed, leftIllegal, rightMissed, rightIllegal
' Start the steering object: stop both wheel instances first (shared pin claims, PL-18); detection never forced (I12);
' wait ready; read both drivers' states, offsets, integrity counts and detected boards (testGetBoardTypes(), sec 12.1
' Q8); set holdAtStop(FALSE); emit BM-SSTART. The steering start's life is the sid its records carry. Task 3621: the
' start is watched with the start grace (WD_START_GRACE_MS), and a start that returns -1 is followed by
' BM-SREFUSE -- the three getError() codes and both wheels' getHealth() masks, read right after the call.
' Every caller but one comes through bSteerStart()'s I10 guard. RESTCOAST (task 3623) calls here directly, with the
' instrument running on INST_SRC_NONE, which reads no library object (dStepRestCoast()).
'
' @param seg - SEG_* in progress
' @returns bStarted - TRUE when start() returned a cog id and both drivers reported ready
'
' @local startMs - getms() after start(), for the ready wait
' @local restMs - spacing still owed before this start
' @local leftMissed - left missed transitions
' @local leftIllegal - left illegal codes
' @local rightMissed - right missed transitions
' @local rightIllegal - right illegal codes

    bStarted := FALSE
    ssWhy := WHY_NONE
    bSsCalled := TRUE
    wheelStopRaw(SIDE_LEFT)
    wheelStopRaw(SIDE_RIGHT)
    restMs := START_SPACING_MS - (getms() - lastStartMs)
    if bAnyStart and (restMs > 0)
        waitBeat(restMs, CP_LOOP_REST)
    ' task 3621: this cog's three error slots are drained first, so a refusal's getError() below is this start's
    '  cause, and the watchdog is granted WD_START_GRACE_MS for this one call only (its derivation is at the constant)
    beat(CP_LIB_STEER_QUERY)
    steering.getError()
    beat(CP_LIB_STEER_QUERY)
    wdGraceMs := WD_START_GRACE_MS
    beat(CP_LIB_STEER_START)
    benchLog.cogEventBegin()
    ssCallMs := getms()                                     ' task 3623: RESTCOAST's call_ms
    ssRet := steering.start(LEFT_TEST_BASE, RIGHT_TEST_BASE, TEST_VOLTAGE, TEST_DET_MODE, TEST_DET_MODE)
    benchLog.cogEventEnd()
    beat(CP_LIB_STEER_START)
    wdGraceMs := 0
    if ssRet < 0                                            ' the cause and every health mask, before anything else runs
        beat(CP_LIB_STEER_QUERY)
        ssErr, ssLErr, ssRErr := steering.getError()
        ssChk[SLOT_LEFT], ssFail[SLOT_LEFT], ssRec[SLOT_LEFT], ssChk[SLOT_RIGHT], ssFail[SLOT_RIGHT], ssRec[SLOT_RIGHT] := steering.getHealth()
        beat(CP_LIB_STEER_QUERY)
    lastStartMs := getms()
    bAnyStart := TRUE
    lifeSeq := (lifeSeq + 1) <# LIM_SMALL
    steerLife := lifeSeq
    bSsRetOk := (ssRet >= 0) and (ssRet <= MAX_COG_ID)
    bSteerUp := (ssRet >= 0)
    startMs := getms()
    repeat
        beat(CP_LIB_STEER_QUERY)
        bStarted := steering.isReady()
        beat(CP_LIB_STEER_QUERY)
        if bStarted or ((getms() - startMs) >= READY_TIMEOUT_MS)
            quit
        beat(CP_LOOP_READY)
        waitms(SAMPLE_MS)
    ssReadyMs := getms() - startMs
    beat(CP_LIB_STEER_QUERY)
    ssLeftState, ssRightState := steering.testGetDriverState()
    ssLeftNeg, ssLeftPos := steering.testLeftGetFwdRevIndep()
    ssRightNeg, ssRightPos := steering.testRightGetFwdRevIndep()
    leftMissed, leftIllegal, rightMissed, rightIllegal := steering.getHallIntegrityCounts()
    ssLeftBoard, ssRightBoard := steering.testGetBoardTypes()
    beat(CP_LIB_STEER_QUERY)
    ssLeftIg := leftMissed + leftIllegal
    ssRightIg := rightMissed + rightIllegal
    bStarted := bSsRetOk and (bStarted <> FALSE)
    if bSteerUp
        steerHold(FALSE)
    emitSStart(seg)
    if ssRet < 0
        emitSRefuse(seg)                                    ' task 3621: why the start returned -1
        emitRProbe(seg, SIDE_LEFT, TRUE)                    ' PL-120: what the refusing lead check read, per wheel
        emitRProbe(seg, SIDE_RIGHT, TRUE)

PRI steerStop()
' Stop the steering object (both drivers and its sense cog), returning the instrument to IDLE first
' (I10). Like wheelStop(), never refused.

    if bInstQuiet() == FALSE
        bInstIdle()
        if bInstQuiet() == FALSE
            instRefused(curSeg)
    beat(CP_LIB_STEER_STOP)
    benchLog.cogEventBegin()
    steering.stop()
    beat(CP_LIB_STEER_STOP)
    bSteerUp := FALSE

PRI steerHold(bBrake)
' holdAtStop() on both steering wheels; steering segments set FALSE at start (I6).
'
' @param bBrake - TRUE for holdAtStop(TRUE)

    beat(CP_LIB_HOLD)
    steering.holdAtStop(bBrake)
    beat(CP_LIB_HOLD)

PRI steerTrackTicks() : leftTicks, rightTicks
' The steering object's own tracking count, in hall ticks, per wheel.
'
' @returns leftTicks - left getRotationCount(DRU_HALL_TICKS)
' @returns rightTicks - right getRotationCount(DRU_HALL_TICKS)

    beat(CP_LIB_STEER_QUERY)
    leftTicks, rightTicks := steering.getRotationCount(steering.DRU_HALL_TICKS)
    beat(CP_LIB_STEER_QUERY)

PRI steerStopMotors()
' stopMotors() on the steering object (no sync wait, so no SYNC_PRECOND check is owed).

    curIncre := 0
    beat(CP_LIB_STEER_STOP)
    steering.stopMotors()
    beat(CP_LIB_STEER_STOP)

PRI bSteerDriveBoth(seg, tid, powerValue) : bDriven
' driveAtPower(powerValue, powerValue) on the steering object, always preceded by the SYNC_PRECOND check
' (design sec 4.3): a driver in DCS_ESTOP would hang the call's SyncStatus() wait. A failed check emits
' BM-ABORT SYNC_PRECOND and drives nothing; a stopped steering object is never driven.
'
' @param seg - SEG_* in progress
' @param tid - trace id in progress, 0 when none
' @param powerValue - power [-100..100] for both wheels
' @returns bDriven - TRUE when the drive call was made

    bDriven := FALSE
    if bSteerUp
        if bSteerDrivePrecondition(seg, tid)
            curIncre := 0
            beat(CP_LIB_STEER_DRIVE)
            steering.driveAtPower(powerValue, powerValue)
            beat(CP_LIB_STEER_DRIVE)
            bDriven := TRUE

PRI steerRecoverFault(tid) : whyCode | slotIdx, side, startMs, bLtFlt, bLtSig, bRtFlt, bRtSig, eLeftState, eRightState, eDrvrState, bFaultSig, bCleared, offNeg, offPos
' Recover a steering-segment fault per motor through the TEST-USE pass-throughs (sec 4.2 step 2:
' testResetFault() alone, which issues the zero command itself). The steering object has no per-wheel
' restart, so a fault reset does not clear is BM-UNRECOV MOTOR_RETIRED and ends the segment's trials.
' Folds R14-DUAL-RSTPROV-* and cools FAULT_COOL_MS after any fault.
'
' @param tid - trace id of the trial
' @returns whyCode - WHY_MOTOR_RETIRED when a fault stayed uncleared, else WHY_NONE
'
' @local slotIdx - motor slot
' @local side - SIDE_LEFT or SIDE_RIGHT
' @local startMs - getms() before the reset
' @local bLtFlt - left isFaulted()
' @local bLtSig - left isFaultSignal()
' @local bRtFlt - right isFaulted()
' @local bRtSig - right isFaultSignal()
' @local eLeftState - left driver state after the reset
' @local eRightState - right driver state after the reset
' @local eDrvrState - this motor's driver state after the reset
' @local bFaultSig - this motor's fault flag
' @local bCleared - stopped and not faulted after the reset
' @local offNeg - offset_fwd read back
' @local offPos - offset_rev read back

    whyCode := WHY_NONE
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        beat(CP_LOOP_POLL)
        side := SIDE_LEFT + slotIdx
        beat(CP_LIB_STEER_QUERY)
        bLtFlt, bLtSig, bRtFlt, bRtSig := steering.testGetFaultStatus()
        beat(CP_LIB_STEER_QUERY)
        bFaultSig := (slotIdx == SLOT_RIGHT) ? (bRtFlt or bRtSig) : (bLtFlt or bLtSig)
        if bFaultSig
            runFaults := (runFaults + 1) <# LIM_BIG
            segFaults := (segFaults + 1) <# LIM_SMALL
            sfFaults[slotIdx] := (sfFaults[slotIdx] + 1) <# LIM_BIG
            startMs := getms()
            beat(CP_LIB_RESETFAULT)
            if slotIdx == SLOT_RIGHT
                steering.testRightResetFault()
            else
                steering.testLeftResetFault()
            beat(CP_LIB_RESETFAULT)
            beat(CP_LIB_STEER_QUERY)
            eLeftState, eRightState := steering.testGetDriverState()
            bLtFlt, bLtSig, bRtFlt, bRtSig := steering.testGetFaultStatus()
            if slotIdx == SLOT_RIGHT
                offNeg, offPos := steering.testRightGetFwdRevIndep()
            else
                offNeg, offPos := steering.testLeftGetFwdRevIndep()
            beat(CP_LIB_STEER_QUERY)
            eDrvrState := (slotIdx == SLOT_RIGHT) ? eRightState : eLeftState
            bFaultSig := (slotIdx == SLOT_RIGHT) ? bRtSig : bLtSig
            bCleared := (eDrvrState == DCS_STOPPED) and (bFaultSig == FALSE)
            emitRecover(curSeg, tid, side, 0, offNeg, offPos, RSTEP_RESET, bCleared, getms() - startMs, eDrvrState, bFaultSig)
            if bCleared == FALSE
                sfResetUncleared[slotIdx] := (sfResetUncleared[slotIdx] + 1) <# LIM_BIG
                unrecovTotal := (unrecovTotal + 1) <# LIM_TINY
                segUnrecov := (segUnrecov + 1) <# LIM_TINY
                emitUnrecov(curSeg, tid, side, 0, offNeg, offPos, eDrvrState, bFaultSig, eDrvrState <> DCS_UNKNOWN)
                whyCode := WHY_MOTOR_RETIRED
            waitBeat(FAULT_COOL_MS, CP_LOOP_COOL)

PRI bSteerDrivePrecondition(seg, tid) : bOk | eLeftState, eRightState
' The SYNC_PRECOND construction (design sec 4.3): both drivers up and neither in DCS_ESTOP, else BM-ABORT
' SYNC_PRECOND and the caller does not call.
'
' WHY IT IS STILL HERE, NOW THAT THE HANG IT GUARDED IS GONE. Before task 3513, steering.driveAtPower()
' ended in an unbounded SyncStatus() wait that never returned while a driver sat in DCS_ESTOP -- one
' e-stopped wheel could hang cog 0 for the rest of the run. The front cog now owns the ATN and the wait,
' and a caller waits only the bounded request round trip, so the hang cannot recur. The check is kept
' because a measuring trial that begins with an e-stopped driver is measuring the wrong thing, and it
' says so in a record instead of quietly producing a trial with no motion. The one place it is
' deliberately NOT used is dDrive(), where the refusal is the measurement (DST_ESTOP_REFUSE).
'
' @param seg - SEG_* in progress
' @param tid - trace id in progress, 0 when none
' @returns bOk - TRUE when the drive call may be made
'
' @local eLeftState - left driver state
' @local eRightState - right driver state

    beat(CP_LIB_STEER_QUERY)
    eLeftState, eRightState := steering.testGetDriverState()
    beat(CP_LIB_STEER_QUERY)
    bOk := (eLeftState <> DCS_UNKNOWN) and (eRightState <> DCS_UNKNOWN) and (eLeftState <> DCS_ESTOP) and (eRightState <> DCS_ESTOP)
    if bOk == FALSE
        emitAbort(seg, tid, SIDE_BOTH, 0, ABR_SYNC_PRECOND, (eLeftState * X10) + eRightState, SCOPE_TRIAL)

PRI shutdownAll()
' Stop the steering object and both wheels unconditionally at run end. stop() on a never-started
' instance touches no pin.

    beat(CP_LIB_STOP)
    benchLog.cogEventBegin()
    steering.stop()
    wheelL.stop()
    wheelR.stop()
    beat(CP_LIB_STOP)
    bSteerUp := FALSE

CON { --- recovery policy (design sec 4.2) and side-effect restores (I11) --- }

PRI bRecoverFault(seg, tid, side, motorIncre, coolMs) : bCleared | slotIdx, startMs, offNeg, offPos, eDrvrState, bFaultSig, bUp
' Recover a faulted wheel in-session. Step 2: testResetFault() alone (it issues the zero command
' itself). Step 3, if not cleared: stop, rest RESTART_REST_MS, start, wait ready. Step 4, if still not
' cleared: BM-UNRECOV MOTOR_RETIRED; that motor's remaining trials in this load are skipped; the run
' continues. Then the cool-down, beat-polled. Callers restore every trial side effect BEFORE calling.
'
' @param seg - SEG_* in progress
' @param tid - trace id of the faulted trial, 0 when none
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - the faulted command
' @param coolMs - FAULT_COOL_MS, or FAULT_TRIAL_COOL_MS for FAULTB
' @returns bCleared - TRUE when step 2 or step 3 cleared the fault
'
' @local slotIdx - motor slot
' @local startMs - getms() at the start of a step
' @local offNeg - offset_fwd read back
' @local offPos - offset_rev read back
' @local eDrvrState - driver state after a step
' @local bFaultSig - fault flag after a step
' @local bUp - the restart's start succeeded

    slotIdx := side - SIDE_LEFT
    slotLastIncre[slotIdx] := 0                             ' R18.1: recovery leaves the wheel at rest -- the next rung starts from there
    runFaults := (runFaults + 1) <# LIM_BIG
    segFaults := (segFaults + 1) <# LIM_SMALL
    sfFaults[slotIdx] := (sfFaults[slotIdx] + 1) <# LIM_BIG
    startMs := getms()
    beat(CP_LIB_RESETFAULT)
    if side == SIDE_RIGHT
        wheelR.testResetFault()
    else
        wheelL.testResetFault()
    beat(CP_LIB_RESETFAULT)
    bCleared, eDrvrState, bFaultSig := wheelClearedState(side)
    offNeg, offPos := wheelGetOffsets(side)
    emitRecover(seg, tid, side, motorIncre, offNeg, offPos, RSTEP_RESET, bCleared, getms() - startMs, eDrvrState, bFaultSig)
    if bCleared == FALSE
        sfResetUncleared[slotIdx] := (sfResetUncleared[slotIdx] + 1) <# LIM_BIG
        startMs := getms()
        wheelStop(side)
        waitBeat(RESTART_REST_MS, CP_LOOP_REST)
        bUp := bWheelStart(seg, side)
        bCleared, eDrvrState, bFaultSig := wheelClearedState(side)
        bCleared := bCleared and bUp
        offNeg, offPos := wheelGetOffsets(side)
        emitRecover(seg, tid, side, motorIncre, offNeg, offPos, RSTEP_RESTART, bCleared, getms() - startMs, eDrvrState, bFaultSig)
        if bCleared == FALSE
            bSlotRetired[slotIdx] := TRUE
            unrecovTotal := (unrecovTotal + 1) <# LIM_TINY
            segUnrecov := (segUnrecov + 1) <# LIM_TINY
            emitUnrecov(seg, tid, side, motorIncre, offNeg, offPos, eDrvrState, bFaultSig, bUp)
            wheelStop(side)
    waitBeat(coolMs, CP_LOOP_COOL)

PRI bRestoreRamp(side) : bOk | jerkUp, accelUp, jerkDn, accelDn
' Restore the built-in ramp, read it back and emit BM-RAMPREST (I11). The last read-back of each motor is
' R14-DUAL-RAMPREST-B's measurement. SRC_REV 59 (DRIVER_REV 38): restored through the public API a program would use --
' setAcceleration(ACCEL_BUILTIN_MM_S2) and setDeceleration(DECEL_BUILTIN_MM_S2) -- and judged against this file's own
' derivation of the four parameters those rates give on the 6.5in wheel (RAMP_DEF_*: 71 / 33_958 / 104 / 49_918).
' NEGATIVE: DRIVER_REV 35-37's constant speed-up ramp read 33_958 / 33_958 / 0 / 49_918, and the stepped defaults this
' restore once wrote read 418 / 200_000 / 105 / 50_000 on DRIVER_REV 38: either FAILS.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @returns bOk - TRUE when RAMP_DEF_JERK_UP / RAMP_DEF_ACCEL_UP / RAMP_DEF_JERK_DN / RAMP_DEF_ACCEL_DN read back
'
' @local jerkUp - jerk_up (minRamp) read back
' @local accelUp - accel_up (maxRamp) read back
' @local jerkDn - jerk_dn (incRamp) read back
' @local accelDn - accel_dn (decrRamp) read back

    beat(CP_LIB_RAMP)
    if side == SIDE_RIGHT
        wheelR.setAcceleration(wheelR.ACCEL_BUILTIN_MM_S2)
        wheelR.setDeceleration(wheelR.DECEL_BUILTIN_MM_S2)
        jerkUp, accelUp, jerkDn, accelDn := wheelR.testGetRampLimits()
    else
        wheelL.setAcceleration(wheelL.ACCEL_BUILTIN_MM_S2)
        wheelL.setDeceleration(wheelL.DECEL_BUILTIN_MM_S2)
        jerkUp, accelUp, jerkDn, accelDn := wheelL.testGetRampLimits()
    beat(CP_LIB_RAMP)
    bOk := (jerkUp == RAMP_DEF_JERK_UP) and (accelUp == RAMP_DEF_ACCEL_UP) and (jerkDn == RAMP_DEF_JERK_DN) and (accelDn == RAMP_DEF_ACCEL_DN)
    bSfRampRan[side - SIDE_LEFT] := TRUE
    bSfRampOk[side - SIDE_LEFT] := bOk
    emitRampRest(side, jerkUp, accelUp, jerkDn, accelDn, bOk)

PRI bRestoreOffsets(side, wantNeg, wantPos) : bOk | offNeg, offPos
' Restore the offsets read at the trial's start, read them back and emit BM-OFFREST (I11). Every
' read-back of a motor is ANDed into R14-DUAL-OFFREST-C.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param wantNeg - offset_fwd degrees to restore
' @param wantPos - offset_rev degrees to restore
' @returns bOk - TRUE when both read back equal
'
' @local offNeg - offset_fwd read back
' @local offPos - offset_rev read back

    beat(CP_LIB_OFFSETS)
    if side == SIDE_RIGHT
        wheelR.testSetFwdRevIndep(wantNeg, wantPos)
    else
        wheelL.testSetFwdRevIndep(wantNeg, wantPos)
    beat(CP_LIB_OFFSETS)
    offNeg, offPos := wheelGetOffsets(side)
    bOk := (offNeg == wantNeg) and (offPos == wantPos)
    bSfOffRan[side - SIDE_LEFT] := TRUE
    bSfOffOk[side - SIDE_LEFT] := (bSfOffOk[side - SIDE_LEFT] <> FALSE) and bOk
    emitOffRest(side, wantNeg, wantPos, offNeg, offPos, bOk)

PRI restoreStopMode(side)
' Return the wheel under test to FLOAT at stop (I6, I11). The library has no stop-mode getter, so this
' restore cannot be read back; bBrakeRequested records that it was issued.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    wheelHold(side, FALSE)

PRI restoreEmergency(side)
' Clear an e-stop issued by a trial (I11). The library has no e_stop getter; the driver state leaving
' DCS_ESTOP on a later instrument sample is the evidence.
'
' @param side - SIDE_LEFT or SIDE_RIGHT

    beat(CP_LIB_ESTOP)
    if side == SIDE_RIGHT
        wheelR.clearEmergency()
    else
        wheelL.clearEmergency()
    beat(CP_LIB_ESTOP)

CON { --- record emission, cog 0 (design sec 3). Byte counts: each field is 2 + len(name) + width --- }

PRI recBegin(pTag)
' Start a BM- record: tag first, then the run-wide seq (I8).
'
' @param pTag - pointer to the record tag

    benchLog.begin(pTag)
    logSeq := (logSeq + 1) <# LIM_MID
    benchLog.numField(@"seq", logSeq, LIM_MID)

PRI emitRecord() | pRecord
' Emit the assembled record: the one cog-0 debug() statement in this file, bracketed by CP_EMIT.
'
' @local pRecord - pointer to the zero-terminated record

    pRecord := benchLog.pLine()
    beat(CP_EMIT)
    debug(zstr_(pRecord))
    beat(CP_EMIT)

PRI tokenAt(pTable, tokenCount, tokenIdx) : pTok | skipCount
' Look up a token in a packed zero-separated DAT table; an index outside the table returns "?".
' Reads only DAT, so it is safe from any cog.
'
' @param pTable - pointer to the packed table
' @param tokenCount - tokens in the table
' @param tokenIdx - 0-based token index
' @returns pTok - pointer to the token text
'
' @local skipCount - bytes skipped inside one token (bounded)

    pTok := @sUnknownTok
    if (tokenIdx >= 0) and (tokenIdx < tokenCount)
        pTok := pTable
        repeat tokenIdx
            repeat skipCount from 0 to TOKEN_SCAN_MAX
                if BYTE[pTok] == 0
                    quit
                pTok += 1
            pTok += 1

PRI whyField(whyCode)
' Append the why field (always last in a measurement record).
'
' @param whyCode - WHY_* value

    benchLog.tokenField(@"why", tokenAt(@tokWhy, WHY_COUNT, whyCode), TOKMAX_WHY)

PRI sideToken(side) : pTok
' Motor token for a side.
'
' @param side - SIDE_* value
' @returns pTok - NONE, LEFT, RIGHT or BOTH

    pTok := tokenAt(@tokSide, SIDE_COUNT, side)

PRI segToken(seg) : pTok
' Segment token.
'
' @param seg - SEG_* value
' @returns pTok - segment token

    pTok := tokenAt(@tokSeg, SEG_COUNT, seg)

PRI dcsToken(eDrvrState) : pTok
' Driver-state token.
'
' @param eDrvrState - DCS_* value
' @returns pTok - state token, "?" outside 0..7

    pTok := tokenAt(@tokDcs, DCS_COUNT, eDrvrState)

PRI boardToken(eBoardRev) : pTok
' Board-revision token.
'
' @param eBoardRev - REV_* value
' @returns pTok - REV_A, REV_B or UNKNOWN

    if eBoardRev == wheelL.REV_A
        pTok := @sBoardRevA
    elseif eBoardRev == wheelL.REV_B
        pTok := @sBoardRevB
    else
        pTok := @sBoardUnknown

PRI statusToken(eStatus) : pTok
' getStatus() token for BM-OUT.
'
' @param eStatus - DS_* value
' @returns pTok - MOVING, HOLDING, OFF, FAULTED, ESTOP or UNKNOWN

    if eStatus == wheelL.DS_MOVING
        pTok := tokenAt(@tokStat, STAT_COUNT, STAT_MOVING)
    elseif eStatus == wheelL.DS_HOLDING
        pTok := tokenAt(@tokStat, STAT_COUNT, STAT_HOLDING)
    elseif eStatus == wheelL.DS_OFF
        pTok := tokenAt(@tokStat, STAT_COUNT, STAT_OFF)
    elseif eStatus == wheelL.DS_FAULTED
        pTok := tokenAt(@tokStat, STAT_COUNT, STAT_FAULTED)
    elseif eStatus == wheelL.DS_ESTOP
        pTok := tokenAt(@tokStat, STAT_COUNT, STAT_ESTOP)
    else
        pTok := tokenAt(@tokStat, STAT_COUNT, STAT_UNKNOWN)

VAR { the record labels' self-check (SRC_REV 71, task 3651) -- cog 0 only }

    LONG    bSfTokTabOk                                     ' TOKTAB: every table, row run and string walked was as many and as long as it must be
    LONG    sfTokTabN                                       ' tables walked (the packed ones, and estPlan)
    LONG    sfTokEntryN                                     ' tokens (and estPlan rows) counted over them
    LONG    sfTokCountBad                                   ' tables whose entries were not their enum's count
    LONG    sfTokLenBad                                     ' tokens longer than their field
    LONG    pTokFirstBad                                    ' the first table at fault, its name; 0 when none
    LONG    sfTokStrN                                       ' sign-off strings walked
    LONG    sfTokStrBad                                     ' ...of them longer than their field (TOKMAX_CELL or TOKMAX_CRIT), or a run with no end
    LONG    sfTokStrFirst                                   ' the first such string's place in the run, 1-based; 0 when none

PRI tokLength(pToken) : tokLen | scanIdx
' The length of a zero-terminated token, read no further than TOKEN_SCAN_MAX + 1 bytes: a longer one reads as that, which
' no field holds. Reads only DAT.
'
' @param pToken - pointer to the token
' @returns tokLen - bytes before the terminator, at most TOKEN_SCAN_MAX + 1
'
' @local scanIdx - index into the token

    tokLen := 0
    repeat scanIdx from 0 to TOKEN_SCAN_MAX
        if BYTE[pToken][scanIdx] == 0
            quit
        tokLen += 1

PRI tokTabWalk(pName, pTable, tokenCount, maxLen) | pEntry, entryCnt, tokLen, bBad
' Walk one packed token table to its TOK_END sentinel: count its tokens against tokenCount, the count its enum gives it, and
' measure each against maxLen, the longest its field prints. Reads at most one token past tokenCount, so a table that is
' long, or has no sentinel, is found and not walked into the DAT after it. The first table at fault is remembered by name.
'
' @param pName - pointer to the table's name, for BM-TOKCHK
' @param pTable - pointer to the packed table
' @param tokenCount - the tokens the table must hold
' @param maxLen - the longest token its field prints (TOKEN_SCAN_MAX where the table has no field of its own)
'
' @local pEntry - the token being measured
' @local entryCnt - tokens counted
' @local tokLen - the token's length
' @local bBad - this table has a fault

    bBad := FALSE
    pEntry := pTable
    entryCnt := 0
    repeat tokenCount + 1
        if BYTE[pEntry] == TOK_END
            quit
        tokLen := tokLength(pEntry)
        if tokLen > maxLen
            sfTokLenBad += 1
            bBad := TRUE
        pEntry += tokLen + 1
        entryCnt += 1
    if entryCnt <> tokenCount
        sfTokCountBad += 1
        bBad := TRUE
    sfTokTabN += 1
    sfTokEntryN += entryCnt
    if bBad and (pTokFirstBad == 0)
        pTokFirstBad := pName

PRI estRowsWalk(pName, pTable, rowCount) | entryCnt, bBad
' Walk the estPlan rows to their EST_END sentinel and count them against rowCount (SEG_COUNT): the same check as
' tokTabWalk(), for a table of words. Reads at most one row past rowCount.
'
' @param pName - pointer to the table's name, for BM-TOKCHK
' @param pTable - pointer to the table
' @param rowCount - the rows the table must hold
'
' @local entryCnt - rows counted
' @local bBad - this table has a fault

    bBad := FALSE
    entryCnt := 0
    repeat rowCount + 1
        if WORD[pTable][(entryCnt * EST_ROW_WORDS) + EST_SECS] == EST_END
            quit
        entryCnt += 1
    if entryCnt <> rowCount
        sfTokCountBad += 1
        bBad := TRUE
    sfTokTabN += 1
    sfTokEntryN += entryCnt
    if bBad and (pTokFirstBad == 0)
        pTokFirstBad := pName

PRI bIsCellId(pText) : bCell
' Whether a sign-off string is a cell id: R, two digits and a hyphen (R14-DUAL-NOSTALL-A). Every other string in the run is a
' criterion, units, study or verdict token.
'
' @param pText - pointer to the string
' @returns bCell - TRUE for a cell id

    bCell := (BYTE[pText][0] == "R") and (BYTE[pText][1] >= "0") and (BYTE[pText][1] <= "9") and (BYTE[pText][2] >= "0") and (BYTE[pText][2] <= "9") and (BYTE[pText][3] == "-")

PRI signoffStringsWalk() | pEntry, entryCnt, tokLen, maxLen
' Walk the sign-off string run (sSfBin to its TOK_END) and hold every cell id to TOKMAX_CELL and every other string to
' TOKMAX_CRIT: a longer one prints "?" in its SIGNOFF record, as sSfCritSpPeak's 24 characters did against 18. Bounded by
' SF_RUN_MAX_STRINGS; a run still going at the bound has lost its sentinel and is a fault.
'
' @local pEntry - the string being measured
' @local entryCnt - strings counted
' @local tokLen - the string's length
' @local maxLen - the longest its field prints

    pEntry := @sSfBin
    entryCnt := 0
    repeat SF_RUN_MAX_STRINGS
        if BYTE[pEntry] == TOK_END
            quit
        maxLen := bIsCellId(pEntry) ? TOKMAX_CELL : TOKMAX_CRIT
        tokLen := tokLength(pEntry)
        entryCnt += 1
        if tokLen > maxLen
            sfTokStrBad += 1
            if sfTokStrFirst == 0
                sfTokStrFirst := entryCnt
        pEntry += tokLen + 1
    if BYTE[pEntry] <> TOK_END
        sfTokStrBad += 1
        if sfTokStrFirst == 0
            sfTokStrFirst := entryCnt + 1
    sfTokStrN := entryCnt

PRI tokenTablesSelfTest()
' BM-TOKCHK: the record labels check themselves, before anything moves (SRC_REV 71, task 3651; PL-96 and PL-97's four instances).
' Every packed token table this build compiles is walked to its TOK_END, its tokens counted against its enum's count and each
' measured against its field's TOKMAX_*; estPlan's rows are counted against SEG_COUNT; and every sign-off cell id and criterion
' string is measured against TOKMAX_CELL and TOKMAX_CRIT. R21-DUAL-TOKTAB judges the result (bSfTokTabOk), TRUE only when nothing
' was found. Each walk sits under the #ifdef its table sits under, so a build checks the tables it holds, and a new table is
' added here when it is added to the file. A table with no field of its own (the ABI names, the plain-line words) is held to
' TOKEN_SCAN_MAX, the longest token tokenAt() can step over. Worst case 174 bytes: tag 9 + seq 15 + tables 15 + tokens 15 +
' bad_count 18 + bad_len 16 + first_bad 27 (TOKMAX_TABNAME) + strings 16 + str_bad 16 + first_str 18 + ok 9.

    beat(CP_INIT)
    sfTokTabN := 0
    sfTokEntryN := 0
    sfTokCountBad := 0
    sfTokLenBad := 0
    pTokFirstBad := 0
    sfTokStrN := 0
    sfTokStrBad := 0
    sfTokStrFirst := 0
    tokTabWalk(@"tokSide", @tokSide, SIDE_COUNT, TOKMAX_MOTOR)
    tokTabWalk(@"tokSeg", @tokSeg, SEG_COUNT, TOKMAX_SEG)
    tokTabWalk(@"tokWhy", @tokWhy, WHY_COUNT, TOKMAX_WHY)
    tokTabWalk(@"tokInstEv", @tokInstEv, INST_EV_COUNT, TOKMAX_INSTEV)
    tokTabWalk(@"tokInstSt", @tokInstSt, INST_ST_COUNT, TOKMAX_INSTST)
    tokTabWalk(@"tokRes", @tokRes, RES_COUNT, TOKMAX_RESULT)
    tokTabWalk(@"tokCause", @tokCause, CAUSE_COUNT, TOKMAX_CAUSE)
    tokTabWalk(@"tokMode", @tokMode, MODE_COUNT, TOKMAX_REQMODE)
    tokTabWalk(@"tokTend", @tokTend, TEND_COUNT, TOKMAX_TEND)
    tokTabWalk(@"tokRst", @tokRst, RST_COUNT, TOKMAX_RST)
    tokTabWalk(@"tokRstep", @tokRstep, RSTEP_COUNT, TOKMAX_STEP)
    tokTabWalk(@"tokAbr", @tokAbr, ABR_COUNT, TOKMAX_REASON)
    tokTabWalk(@"tokScope", @tokScope, SCOPE_COUNT, TOKMAX_SCOPE)
    tokTabWalk(@"tokAns", @tokAns, ANS_COUNT, TOKMAX_ANSWER)
    tokTabWalk(@"tokInput", @tokInput, INPUT_COUNT, TOKMAX_INPUT)
    tokTabWalk(@"tokSlower", @tokSlower, SLOWER_COUNT, TOKMAX_SLOWER)
    tokTabWalk(@"tokStopBy", @tokStopBy, STOPBY_COUNT, TOKMAX_STOPBY)
    tokTabWalk(@"tokPrompt", @tokPrompt, PROMPT_COUNT, TOKMAX_PROMPT)
    tokTabWalk(@"tokUiKind", @tokUiKind, UIK_COUNT, TOKMAX_UIKIND)
    tokTabWalk(@"tokUiRes", @tokUiRes, UIR_COUNT, TOKMAX_UIRES)
    tokTabWalk(@"tokDStep", @tokDStep, DST_COUNT, TOKMAX_DSTEP)
    tokTabWalk(@"tokDRes", @tokDRes, DRES_COUNT, TOKMAX_DRES)
    tokTabWalk(@"tokFltCause", @tokFltCause, FC_COUNT, TOKMAX_FCAUSE)
    tokTabWalk(@"tokButton", @tokButton, BM_BTN_COUNT, TOKMAX_BUTTON)
    tokTabWalk(@"tokOpEv", @tokOpEv, OPEV_COUNT, TOKMAX_OPEREV)
    tokTabWalk(@"tokSegEv", @tokSegEv, SEGEV_COUNT, TOKMAX_SEGEV)
    tokTabWalk(@"tokExit", @tokExit, EXIT_COUNT, TOKMAX_EXIT)
    tokTabWalk(@"tokStat", @tokStat, STAT_COUNT, TOKMAX_STAT)
    tokTabWalk(@"tokPart", @tokPart, PART_COUNT, TOKMAX_PART)
    tokTabWalk(@"tokASpd", @tokASpd, ASPD_COUNT, TOKMAX_ASPD)
    tokTabWalk(@"tokADir", @tokADir, ADIR_COUNT, TOKMAX_ADIR)
    tokTabWalk(@"tokALeg", @tokALeg, ALEG_COUNT, TOKMAX_ALEG)
    tokTabWalk(@"tokDcs", @tokDcs, DCS_COUNT, TOKMAX_STATE)
    tokTabWalk(@"tokCp", @tokCp, CP_COUNT, TOKMAX_CP)
    tokTabWalk(@"tokFinds", @tokFinds, SEG_COUNT, TOKMAX_FINDS)
    tokTabWalk(@"tokLeadV", @tokLeadV, LEADV_COUNT, TOKMAX_LEADV)
    tokTabWalk(@"tokAbiWhere", @tokAbiWhere, ABIW_COUNT, TOKMAX_ABIWHERE)
    tokTabWalk(@"tokAbiLaunch", @tokAbiLaunch, ABI_LAUNCH_LONGS, TOKEN_SCAN_MAX)
    tokTabWalk(@"tokAbiStatus", @tokAbiStatus, ABI_STATUS_NAMED, TOKEN_SCAN_MAX)
    tokTabWalk(@"tokAbiParams", @tokAbiParams, ABI_PARAMS_NAMED, TOKEN_SCAN_MAX)
    tokTabWalk(@"tokEvStage", @tokEvStage, EVST_COUNT, TOKMAX_EVSTAGE)
    tokTabWalk(@"tokEvKind", @tokEvKind, EV_KIND_SLOTS, TOKMAX_EVKIND)
    tokTabWalk(@"tokEvWheel", @tokEvWheel, EV_WHEELS, TOKMAX_EVWHEEL)
    tokTabWalk(@"tokSr", @tokSr, SR_TOK_COUNT, TOKMAX_SR)
    estRowsWalk(@"estPlan", @estPlan, SEG_COUNT)
#ifdef DBP_LIMITS
    tokTabWalk(@"tokEdge", @tokEdge, EDGE_COUNT, TOKMAX_EDGE)
    tokTabWalk(@"tokFolK", @tokFolK, FOLK_COUNT, TOKMAX_FOLK)
#endif
#ifdef DBG_FRPLAT
    tokTabWalk(@"tokFrCell", @tokFrCell, FRC_COUNT, TOKMAX_FRCELL)
    tokTabWalk(@"tokFrOut", @tokFrOut, FRO_COUNT, TOKMAX_FROUT)
    tokTabWalk(@"tokFrPath", @tokFrPath, FRP_COUNT, TOKMAX_FRPATH)
    tokTabWalk(@"tokFrMode", @tokFrMode, FR_MODE_COUNT, TOKMAX_FRMODE)
    tokTabWalk(@"tokFrWin", @tokFrWin, FR_WINS, TOKMAX_FRWIN)
    tokTabWalk(@"tokHold", @tokHold, HS_COUNT, TOKMAX_HOLD)
    tokTabWalk(@"tokPfOut", @tokPfOut, PFO_COUNT, TOKMAX_PFOUT)
#endif
#ifdef DBG_PACKTOK
    tokTabWalk(@"tokPack", @tokPack, PACK_TOK_COUNT, TOKMAX_PACK)
#endif
#ifdef DBP_START
    tokTabWalk(@"tokSkNegKind", @tokSkNegKind, SKNEG_COUNT, TOKMAX_SKNEG_KIND)
    tokTabWalk(@"tokPrbPhase", @tokPrbPhase, PRB_TOK_COUNT, TOKMAX_SKNEG_WHICH)
    tokTabWalk(@"tokHallSwap", @tokHallSwap, HSW_TOK_COUNT, TOKMAX_SKNEG_WHICH)
    tokTabWalk(@"tokWndState", @tokWndState, WND_TOK_COUNT, TOKMAX_WND)
    tokTabWalk(@"tokSkMode", @tokSkMode, SKM_COUNT, TOKMAX_SKMODE)
    tokTabWalk(@"tokWalkLeg", @tokWalkLeg, WLEG_TOK_COUNT, TOKMAX_WLEG)
    tokTabWalk(@"tokWalkEnd", @tokWalkEnd, WLE_TOK_COUNT, TOKMAX_WLE)
#endif
#ifdef DBP_PACK
    tokTabWalk(@"tokPkPair", @tokPkPair, PKP_COUNT, TOKMAX_PKPAIR)
#endif
#ifdef DBP_SPIN
    tokTabWalk(@"tokSpOff", @tokSpOff, SPOFF_COUNT, TOKMAX_SPOFF)
    tokTabWalk(@"tokSpSpeed", @tokSpSpeed, SPIN_SPEEDS, TOKMAX_SPSPEED)
    tokTabWalk(@"tokSpDir", @tokSpDir, SPIN_DIRS, TOKMAX_SPDIR)
    tokTabWalk(@"tokSpStop", @tokSpStop, SPSTOP_COUNT, TOKMAX_SPSTOP)
    tokTabWalk(@"tokCrk", @tokCrk, CRK_COUNT, TOKMAX_CRK)
    tokTabWalk(@"tokCrStop", @tokCrStop, CRSTOP_COUNT, TOKMAX_CRSTOP)
    tokTabWalk(@"tokBlk", @tokBlk, BLK_KINDS, TOKMAX_BLK)
    tokTabWalk(@"tokBlkStop", @tokBlkStop, BLKSTOP_COUNT, TOKMAX_BLKSTOP)
    tokTabWalk(@"tokBridge", @tokBridge, BRIDGE_COUNT, TOKMAX_BRIDGE)
    tokTabWalk(@"tokLdo", @tokLdo, LDO_COUNT, TOKMAX_LDO)
    tokTabWalk(@"tokLdStop", @tokLdStop, LDSTOP_COUNT, TOKMAX_LDSTOP)
    tokTabWalk(@"tokFll", @tokFll, FLL_COUNT, TOKMAX_FLL)
    tokTabWalk(@"tokFloorAct", @tokFloorAct, FLA_COUNT, TOKMAX_FLOORACT)
    tokTabWalk(@"sFloorWords", @sFloorWords, FLA_COUNT, TOKEN_SCAN_MAX)
#endif
#ifdef DBG_FENCE
    tokTabWalk(@"tokFenEv", @tokFenEv, FENEV_COUNT, TOKMAX_FENEV)
    tokTabWalk(@"tokFenWhat", @tokFenWhat, FEN_COUNT, TOKMAX_FENWHAT)
    tokTabWalk(@"sFenWords", @sFenWords, FEN_COUNT, TOKEN_SCAN_MAX)
#endif
#ifdef DBF_RAMP
    tokTabWalk(@"tokRampSet", @tokRampSet, RSET_COUNT, TOKMAX_RSET)
#endif
    signoffStringsWalk()
    bSfTokTabOk := (sfTokCountBad == 0) and (sfTokLenBad == 0) and (sfTokStrBad == 0)
    recBegin(@"BM-TOKCHK")
    benchLog.numField(@"tables", sfTokTabN, LIM_SMALL)
    benchLog.numField(@"tokens", sfTokEntryN, LIM_SMALL)
    benchLog.numField(@"bad_count", sfTokCountBad, LIM_SMALL)
    benchLog.numField(@"bad_len", sfTokLenBad, LIM_SMALL)
    benchLog.tokenField(@"first_bad", (pTokFirstBad == 0) ? @sTokNoBad : pTokFirstBad, TOKMAX_TABNAME)
    benchLog.numField(@"strings", sfTokStrN, LIM_SMALL)
    benchLog.numField(@"str_bad", sfTokStrBad, LIM_SMALL)
    benchLog.numField(@"first_str", sfTokStrFirst, LIM_SMALL)
    benchLog.boolField(@"ok", bSfTokTabOk)
    emitRecord()

PRI emitHeaderRecords() | orderIdx
' Emit the header before anything moves: BM-BANNER, BM-BUILD, one SIGNOFF-DECL per judged cell, one
' BM-PLAN per segment of this part, the BM-LADDER table when the part ladders, and the panic line.
'
' @local orderIdx - rung index

    emitBanner()
    emitCommit()                                            ' SRC_REV 72 (PL-68): the commit, beside src_rev
    emitBuild()
    emitSignoffDecls()
    tokenTablesSelfTest()                                   ' SRC_REV 71: BM-TOKCHK, before anything moves; R21-DUAL-TOKTAB judges it
    ' PL-152: an #ifdef chain on the DBP_* symbols where this was a case on PART_ID and `if PART_ID ==` tests -- the
    '  same records, in the same order, selected at compile time
#ifdef DBP_A
    emitPlan(SEG_PREFLT, 1)
    emitPlan(SEG_STOPMODE, 2)
    emitPlan(SEG_LIVE, 3)
    emitPlan(SEG_LADDER, 4)
    emitPlan(SEG_LOWSPD, 5)
    emitPlan(SEG_TAKE, 6)
    repeat orderIdx from 0 to LADDER_RUNGS - 1
        emitLadder(orderIdx)
#elseifdef DBP_CLOCK
    emitPlan(SEG_PREFLT, 1)
    emitPlan(SEG_CLOCK, 2)
#elseifdef DBP_B
    emitPlan(SEG_PREFLT, 1)
    emitPlan(SEG_FAULTB, 2)
    emitPlan(SEG_OVERSHT, 3)
#elseifdef DBP_BRAKE
    emitPlan(SEG_OUTSIDE, 1)
#elseifdef DBP_C
    emitPlan(SEG_PREFLT, 1)
    emitPlan(SEG_BASELINE, 2)
    emitPlan(SEG_POSTFLT, 3)
#elseifdef DBP_D
    emitPlan(SEG_PREFLT, 1)
    emitPlan(SEG_STEERSEG, 2)
    emitPlan(SEG_LIMIT, 3)
#elseifdef DBP_FLOOR
    emitPlan(SEG_FLOOR, 1)
#elseifdef DBP_UICHECK
    emitPlan(SEG_UICHECK, 1)
#elseifdef DBP_LEAD
    emitPlan(SEG_PREFLT, 1)
    emitPlan(SEG_LEAD, 2)
#elseifdef DBP_LIMITS
    emitPlan(SEG_PREFLT, 1)
    emitPlan(SEG_LIMTOP, 2)
    if BUILD_TOP_ONLY == FALSE
        emitPlan(SEG_LIMRAMP, 3)
        emitPlan(SEG_LIMLOW, 4)
#elseifdef DBP_FAULTRESP
    emitPlan(SEG_PREFLT, 1)
    emitPlan(SEG_FLTRESP, 2)
    emitPlan(SEG_FLTPLAT, 3)
    emitFrBuild()                                           ' task 3613: the pre-registered numbers, and what is not built
    emitFrDiag()                                            ' PL-120: the NOMOTION / recovery constants and the wheel order
    emitNotBuilt(@sSfCellB4Pulse, @sSfStudyB4, WHY_REPLACED_BY_X2)
#elseifdef DBP_START
    emitPlan(SEG_SKCHECK, 1)
    emitSkBuild()                                           ' task 3613: the pre-registered numbers, and the walk when not built
    if BUILD_NO_WALK
        emitNotBuilt(@sSfCellSkWalk, @sSfStudyB5, WHY_PART_NOT_BUILT)
    if BUILD_START_POS                                      ' task 3621: R20-PACK-EV's unplug and replug is R20.4's attended run,
        emitNotBuilt(@sSfCellPackEv, @sSfStudyR204, WHY_PART_NOT_BUILT)         '  the dual-pack tier (part PACK)
#elseifdef DBP_SPIN
    ' SRC_REV 69: BM-PLAN names this image's ONE action (Stephen 2026-09-30, R4) -- its segment, its action token, its
    '  plan -- and emitSpinHeader() prints that action's numbers, before anything moves. A build with no action symbol
    '  prints no plan row: it runs nothing.
    planAction := FLOOR_ACT
#ifdef DBF_AUTO
    planAction := FLA_PLAN_SPINS                            ' SRC_REV 70, SESSION 2: its three parts, in the order they run
    emitPlan(SEG_SPIN, 1)
    planAction := FLA_PLAN_FAULT
    emitPlan(SEG_FAULTRUN, 2)
    planAction := FLA_PLAN_RAMP
    emitPlan(SEG_RAMP, 3)
#elseifdef DBF_OBSTSESS
    planAction := FLA_OBST_COAST                            ' SESSION 3: its two trials, each with its drive back
    emitPlan(SEG_OBSTACLE, 1)
    planAction := FLA_OBST_SHORT
    emitPlan(SEG_OBSTACLE, 2)
#else
#ifdef DBF_OBST
    emitPlan(SEG_OBSTACLE, 1)
#endif
#ifdef DBF_GRAB
    emitPlan(SEG_GRAB, 1)
#endif
#ifdef DBF_FAULTRUN
    emitPlan(SEG_FAULTRUN, 1)
#endif
#ifdef DBF_SPINLEG
    emitPlan(SEG_SPIN, 1)
#endif
#endif
#ifndef DBF_NONE
    emitSpinHeader()                                        ' task 3591: the limit's derivation and every band, before anything moves
#endif
#elseifdef DBP_PACK
    emitPlan(SEG_PACK, 1)
    emitPkBuild()                                           ' task 3611: the part's compiled numbers, and every cell when unfitted
    if user.PACK_SENSOR_FITTED == FALSE
        emitNotBuilt(@sSfCellPkMeter, @sSfStudyR204, WHY_PACK_NOT_FITTED)
        emitNotBuilt(@sSfCellPkAbsent, @sSfStudyR204, WHY_PACK_NOT_FITTED)
        emitNotBuilt(@sSfCellPackEv, @sSfStudyR204, WHY_PACK_NOT_FITTED)
#elseifdef DBP_REG
    emitPlan(SEG_PREFLT, 1)
    emitPlan(SEG_REGRESS, 2)
#elseifdef DBP_KICK
    emitPlan(SEG_PREFLT, 1)
    emitPlan(SEG_KICK, 2)
    repeat orderIdx from KICK_RUNG_LO to KICK_RUNG_HI       ' the ladder rows this part's walk commands
        emitLadder(orderIdx)
#endif
    beat(CP_EMIT)
    debug(zstr_(@sPanicLine))
    beat(CP_EMIT)

PRI emitWdStart(bStarted, cogIdRead)
' BM-WDSTART: whether the watchdog cog started. Worst case 48 bytes.
'
' @param bStarted - TRUE when cogspin() returned a cog id
' @param cogIdRead - cogspin()'s raw return

    recBegin(@"BM-WDSTART")
    benchLog.boolField(@"started", bStarted)
    benchLog.numField(@"cog", cogIdRead, LIM_TINY)
    emitRecord()

PRI emitBanner()
' BM-BANNER. part and cfg_id come from #ifdef-selected constants; quiet, mdbg and sdbg print the
' compiled masks. Worst case 241 bytes (design sec 3.2's 256 less the removed cables field, 2+6+7). SRC_REV 69, FMT 43:
' a PART_SPIN image appends action, the floor action it was built for (2 + 6 + TOKMAX_FLOORACT 17 = 25 more: 266).

    recBegin(@"BM-BANNER")
    benchLog.numField(@"src_rev", SRC_REV, LIM_SMALL)
    benchLog.numField(@"fmt", FMT_VERSION, LIM_SMALL)
    benchLog.tokenField(@"part", tokenAt(@tokPart, PART_COUNT, PART_ID), TOKMAX_PART)
#ifdef BENCH_CFG
    benchLog.tokenField(@"cfg_id", @sCfgBench, TOKMAX_CFG)
#else
    benchLog.tokenField(@"cfg_id", @sCfgUser, TOKMAX_CFG)
#endif
    benchLog.tokenField(@"frame", @sFrameMotor, TOKMAX_FRAME)
    benchLog.numField(@"clkfreq", CLKFREQ, LIM_BIG)
    benchLog.numField(@"left_base", LEFT_TEST_BASE, LIM_SMALL)
    benchLog.numField(@"right_base", RIGHT_TEST_BASE, LIM_SMALL)
    benchLog.numField(@"voltage_enum", TEST_VOLTAGE, LIM_SMALL)
    benchLog.numField(@"det_mode", TEST_DET_MODE, LIM_SMALL)
    benchLog.numField(@"motor_type", user.MOTOR_TYPE, LIM_SMALL)
    benchLog.boolField(@"quiet", bQuietMasks)
    benchLog.numField(@"mdbg", user.MOTOR_DBG_MASK, LIM_SMALL)
    benchLog.numField(@"sdbg", user.STEER_DBG_MASK, LIM_SMALL)
#ifdef DBP_SPIN
    benchLog.tokenField(@"action", tokenAt(@tokFloorAct, FLA_COUNT, FLOOR_ACT), TOKMAX_FLOORACT)   ' SRC_REV 69, FMT 43
#endif
    emitRecord()

PRI emitCommit()
' BM-COMMIT (SRC_REV 72, PL-68): the commit this binary was built from, beside src_rev -- the short SHA in a bench pack,
' NOT_A_PACK from the source tree (isp_bench_commit.spin2). Its own record because BM-BANNER (266) and BM-BUILD (271) have
' no room under 280. Worst case 50 bytes: tag 9 + seq 15 + src_rev 12 + commit 8 + 12 (a short SHA, or NOT_A_PACK's 10).

    recBegin(@"BM-COMMIT")
    benchLog.numField(@"src_rev", SRC_REV, LIM_SMALL)
    benchLog.textField(@"commit", commit.commitText())
    emitRecord()

PRI emitBuild()
' BM-BUILD: the compiled instrument, limits and C-6 constants, and the driver's revision. Worst case
' 271 bytes (237 before drv_rev, which adds ",drv_rev," 9 and at most 5 digits; wd_start_ms, task 3621, appended,
' adds 2 + 11 + 7).

    recBegin(@"BM-BUILD")
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.numField(@"inst_hz", INST_RATE_HZ, LIM_SMALL)
    benchLog.numField(@"inst_ticks", INST_PERIOD_TICKS, LIM_BIG)
    benchLog.numField(@"ring", INST_RING_SAMPLES, LIM_SMALL)
    benchLog.numField(@"slongs", INST_SAMPLE_LONGS, LIM_TINY)
    benchLog.numField(@"waitms_max", WAITMS_MAX_MS, LIM_SMALL)
    benchLog.numField(@"wd_stall_ms", WD_STALL_MS, LIM_SMALL)
    benchLog.numField(@"abs_abort_mV", ABS_ABORT_MV, LIM_SMALL)
    benchLog.numField(@"ladder_max", LADDER_MAX_INCRE, LIM_BIG)
    benchLog.numField(@"rwire_mohm", RWIRE_MOHM, LIM_SMALL)
    benchLog.numField(@"pack_mV", PACK_MV, LIM_SMALL)
    benchLog.numField(@"fault_cool_ms", FAULT_COOL_MS, LIM_SMALL)
    benchLog.numField(@"drv_rev", wheelL.DRIVER_REV, LIM_SMALL)
    benchLog.numField(@"wd_start_ms", WD_START_GRACE_MS, LIM_SMALL)   ' task 3621: the watchdog's extra allowance inside a start()
    emitRecord()

PRI emitInst(eventCode, ackMs, bAckValid, whyCode)
' BM-INST: instrument lifecycle event with its run-wide counters. Worst case 198 bytes.
'
' @param eventCode - INST_EV_* value
' @param ackMs - ms the acknowledged command took
' @param bAckValid - TRUE when ackMs is a measurement
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-INST")
    benchLog.tokenField(@"event", tokenAt(@tokInstEv, INST_EV_COUNT, eventCode), TOKMAX_INSTEV)
    benchLog.naNumField(@"cog", instCogId, LIM_TINY, instCogId >= 0)
    benchLog.tokenField(@"state", tokenAt(@tokInstSt, INST_ST_COUNT, instState), TOKMAX_INSTST)
    benchLog.naNumField(@"ack_ms", ackMs, LIM_SMALL, bAckValid)
    benchLog.numField(@"samples", instRunSamples, LIM_BIG)
    benchLog.numField(@"late", instRunLate, LIM_BIG)
    benchLog.numField(@"skipped", instRunSkipped, LIM_BIG)
    benchLog.numField(@"max_late_us", instRunMaxLateTicks / TICKS_PER_US, LIM_MID)
    benchLog.numField(@"clamps", instRunClamps, LIM_MID)
    whyField(whyCode)
    emitRecord()

PRI emitPlan(seg, orderIdx) | bAttended, estS, estKb
' BM-PLAN: one segment of this load, its findings and its planned size (sec 12.4 est_kb).
' Worst case: 117 + est_kb(2+6+7=15) = 132 bytes. SRC_REV 69, FMT 43: a PART_SPIN image appends action (2 + 6 + 17 = 25
' more: 157) and prints exactly one BM-PLAN, for its one action. SRC_REV 70: the action field is the ROW's own (planAction), and a
' SESSION prints one row per part (floor-auto: AUTO_SPINS, AUTO_FAULT, AUTO_RAMP, each with its own est_s and est_kb) or per trial
' (floor-obstacle: OBST_COAST, OBST_SHORT, each trial with its drive back).
'
' @param seg - SEG_* value
' @param orderIdx - 1-based position in this load
'
' @local bAttended - the segment needs a person
' @local estS - planned seconds (design sec 4.4)
' @local estKb - worst-case log KB: traces x (TRACE_EMIT_MAX x 241 B + headers) plus records (BM-TS is 271 B since
'  SRC_REV 46; the figures were not rescaled)

    bAttended := bSegAttended(seg)
    ' OVERSHT: the four distance trials plus the fault-API trial (task 3552) -- about 6 s of poll, the
    '  stop, and up to two FAULT_COOL_MS cool-downs. Its rows are BM-OUT, already counted in est_kb.
    ' STEERSEG and LIMIT (task 3560) print few records and no traces: their time is the steps' own holds
    ' Task 3623: STEERSEG's RESTCOAST adds two lifetimes -- three steering starts of ~1.2 s, two spin-ups with
    '  D_SETTLE_MS, two windows, and two free coasts to rest -- about 25 s, at most about 60 s with both coasts at
    '  RC_REST_MS; 180 -> 240 s. Three BM-SSTART, two BM-RESTCOAST and a BM-DSTEP: about 1.5 KB, 4 -> 6
    ' R18.1: LADDER's walk went from 12 steps to LADDER_WALK_STEPS per motor and sign -- 38 x 4 = 152
    '  measured rungs against 48 -- and each rung now prints five records rather than four. Visit 6a
    '  MEASURED 119_523 ms and about 960 B per rung for the 48, so the walk is about 375 s and 180 KB;
    '  both figures are rounded up, as every other entry here is.
    ' LOWSPD (R18.2 item 5) is the last entry: 5 rungs x 2 signs x 2 motors, each about 8 s (a
    '  LOW_WINDOW_MS window plus its settle and its AT_SPEED wait), so about 160 s and five records a
    '  rung at the ladder's ~1.2 KB -- call it 30 KB. Part A's estimate becomes 1_185 s against
    '  RUN_TIME_CAP_S 1_500, and its MEASURED cost should land near 780 s.
    ' ALIGN (task 3590) is the last entry and its time is the OPERATOR's, not the instrument's: eight
    '  hand-turned legs of 3 revolutions each. A leg is about 20 s turning plus the guide, the settle and
    '  the bias read, so call it 240 s; it stores only crossings, about 135 a leg at the ladder's record
    '  width, so about 25 KB. A stalled leg costs ALIGN_STALL_MS instead, which is why RUN_TIME_CAP_S is
    '  1_800 rather than this estimate.
    ' LEAD and TAKE had no entry, so their rows printed 0 (PL-97's mechanism): LEAD MEASURED about 4.5 min at
    '  Visit 8b for its 112 rungs at the ladder's ~1.2 KB; TAKE is two short lifetimes.
    ' Task 3604, the LIMITS part. LIMTOP: 4 climbs of up to ~15 rungs at the ladder's ~2.5 s, plus an AT_SPEED
    '  bound or two at the edge, and BM-CLIP beside each rung's five records. LIMRAMP: 20 traces at STOPMODE's
    '  worst case of TRACE_EMIT_MAX lines each. LIMLOW: 32 rungs of about 10 s (LIMLOW_WINDOW_MS, its settle
    '  and a quick AT_SPEED). SRC_REV 79 (PL-187): LIMTOP gains eight study traces, an EDGE and an OVERCMD trace per climb, at most
    '  TRACE_EMIT_MAX BM-TS lines each: 8 x (400 x 308 B + a 233 B BM-TRACE and a 277 B BM-TRACE-END) = 990 KB at BM-TS's worst
    '  case, which this row counts at the true 308 B rather than the 241 B of the rows above; and about 2 s of drain each (the
    '  counting walks and the emission), 20 s in all: LIMTOP's row 360 s and 90 KB -> 380 s and 1_080 KB.
    ' Task 3613, the FAULTRESP part. FLTRESP: per wheel the hook's at-rest check (~4 s, no trace) and 12 driven trials,
    '  each its own lifetime (~2 s start and zero), a spin-up of up to ~2 s, a 1 s settle, a capture of about a second
    '  and a FAULT_COOL_MS cool-down -- about 13 s -- and one trace each at STOPMODE's worst case of TRACE_EMIT_MAX lines:
    '  24 traces. FLTPLAT: 2 steering trials of about 15 s, each a trace of up to 3 s at decimation 1. PL-120's recovery
    '  probe is not in FLTRESP's est_s: it runs only after a no-motion failure, at most once, and adds at most about
    '  2 minutes and, per try, its BM-START and BM-FRRECOV. Nor are PL-136's PREFLT stages in PREFLT's: they run only
    '  when a nudge does not move, and add at most PF_RETRY_TRIES lifetimes of about 5 s (each a trace) and one probe
    '  of about 2 minutes. FAULTRESP's PREFLT traces every nudge (two traces of about 300 lines), inside its est_kb.
    ' PL-136: BM-TS grew from 241 to 271 bytes (u, v, w); the est_kb figures were set at 241 and are about 12 % low for
    '  the trace-heavy segments.
    ' Task 3613, the START part. SKCHECK: SK_LIVES steering lifetimes of about 3.5 s -- START_SPACING_MS, the ~1.2 s
    '  start (its own ~1 s rest zero and the ~40 ms checks per wheel), the reads and a ZERO_WINDOW_MS window -- and
    '  SK_WALKS walks of about 1.5 s with their rest confirm; no trace. About 1.3 KB of records a lifetime. PL-137:
    '  dual-start walks in all 10 (was 3), and each walk adds four BM-SKWLEG of up to 264 B: about 60 s and 25 KB.
    ' Task 3591, the SPIN part, whose time is mostly the OPERATOR's. SPIN: twelve legs, each a READY screen he clicks
    '  (call it 5 s), a leg of 3-9 s and its records, plus six steering starts and two FAULT_COOL_MS cool-downs --
    '  about 240 s; four traces at TRACE_EMIT_MAX lines (the quarter's two START legs and the two fault legs) and about
    '  1 KB of records a leg. CREEP: carrying the platform to the incline, then three trials of about 40 s each.
    ' Task 3611, the PACK part, whose time is mostly the OPERATOR's: the ~1.5 s start, step 1's 60 s, and four steps he
    '  ends, call them 15 s each with their settles -- about 150 s; 30 BM-PKREAD of ~110 B and a handful of others,
    '  about 5 KB.
    ' SRC_REV 54, the REG part. REGRESS: a steering start (~1.5 s), OVERSHT's two turn trials (~6 s each, a trace of up
    '  to TRACE_EMIT_MAX lines each), then two forced-fault lifetimes of a start, a spin-up, the fault, the coast to rest
    '  and the same-power retry to speed -- about 8 s each: about 40 s and, with its two traces, about 230 KB.
    ' SRC_REV 54, the KICK part. KICK: four lifetimes, each a ~2.7 s start and zero window, the ~4 s start from rest to
    '  120 x 10^6, and seven more rungs at the ladder's MEASURED ~2 s a rung (debug_260922-161317.log): about 90 s; five
    '  rung records and a BM-KICKTR a rung, about 1.4 KB, so about 45 KB.
    ' SRC_REV 58, the SPIN part's load cells. SPIN gains a re-drive after each fault leg -- a READY screen he clicks, a
    '  spin-up and a 1 s window at SLOW, the stop -- about 20 s each: 240 -> 280 s, and a BM-RDRIVE each. BLOCK: two
    '  trials, each a steering start (~1.5 s), the chocked drive to its latch (at most BLK_WAIT_MS), the phase window,
    '  the API sequence and EV_SETTLE_MS before the drain -- about 10 s -- plus his chocking, about a minute: 90 s; a
    '  trace each of up to TRACE_EMIT_MAX lines, about 230 KB. LOAD: the setup (about a minute: the lane and the strap),
    '  the free trial and up to LOAD_DRAG_TRIES drag trials, each a READY screen, a start, a drive of about 7 s, the
    '  stop, the drain and his push back to the start, about 40 s: 240 s at three trials; a trace per drag trial,
    '  about 330 KB at three.
    ' SRC_REV 62, the floor situations. OBSTACLE (was BLOCK): two trials, each a READY screen, a start (~1.5 s), a drive of
    '  at most 1 m at 0.16 m/s to the obstacle and ~1.2 s to the latch, the checks, EV_SETTLE_MS, and his pull back:
    '  about 40 s each, 90 s; a trace each, 230 KB. GRAB (was LOAD): up to three trials of a READY screen, a start, the
    '  1 m out (about 8 s), a READY screen and the 1 m back, EV_SETTLE_MS: about 60 s each, 180 s; a trace each, 330 KB.
    '  INCLINE (was CREEP): SRC_REV 63, three climbs of ~2.5 s, the watches (5, 15 and 15 s) and the drive down (~7 s),
    '  after his setup: about 120 s; no trace (the overloaded climb's is gone), records only, 10 KB. FAULTRUN (new): a
    '  READY screen, a start, 1 m out, a READY screen, the leg back to its fault and its capture (~4 s at decimation 1), the drain, FAULT_COOL_MS, a READY screen and the re-drive to
    '  the start: about 60 s; one trace, 120 KB. SPIN: ten legs (was twelve), 280 -> 200 s, two traces, 120 KB.
    ' SRC_REV 69, the PART_SPIN images: each runs ONE action once, so the four rows above no longer describe it. Its plan is
    '  the part chain's FLOOR_EST_S and FLOOR_EST_KB, derived there for that action, with the LEAD_IN_MS lead-in in them.
    estS := 0                                               ' a seg outside the table plans nothing, as lookupz() read it
    estKb := 0
    if (seg >= 0) and (seg < SEG_COUNT)                     ' SRC_REV 71: the figures are the estPlan rows (DAT), counted by the self-check
        estS := WORD[@estPlan][(seg * EST_ROW_WORDS) + EST_SECS]
        estKb := WORD[@estPlan][(seg * EST_ROW_WORDS) + EST_KB]
#ifdef DBP_SPIN
    estS := FLOOR_EST_S                                     ' SRC_REV 69: this image's own action's plan (the part chain)
    estKb := FLOOR_EST_KB
#ifdef DBF_AUTO
    case seg                                                ' SRC_REV 70: a session's row is its part's (the part chain's constants)
        SEG_SPIN:
            estS := AUTO_EST_SPIN_S
            estKb := AUTO_EST_SPIN_KB
        SEG_FAULTRUN:
            estS := AUTO_EST_FR_S
            estKb := AUTO_EST_FR_KB
        SEG_RAMP:
            estS := AUTO_EST_RAMP_S
            estKb := AUTO_EST_RAMP_KB
#endif
#ifdef DBF_OBSTSESS
    estS := OBST_TRIAL_EST_S                                ' SESSION 3: each of its two rows is one trial and its drive back
    estKb := OBST_TRIAL_EST_KB
#endif
#endif
    recBegin(@"BM-PLAN")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"order", orderIdx, LIM_TINY)
    benchLog.boolField(@"attended", bAttended)
    benchLog.tokenField(@"part", tokenAt(@tokPart, PART_COUNT, PART_ID), TOKMAX_PART)
    benchLog.tokenField(@"finds", tokenAt(@tokFinds, SEG_COUNT, seg), TOKMAX_FINDS)
    benchLog.numField(@"est_s", estS, LIM_SMALL)
    benchLog.numField(@"est_kb", estKb, LIM_SMALL)
#ifdef DBP_SPIN
    benchLog.tokenField(@"action", tokenAt(@tokFloorAct, FLA_COUNT, planAction), TOKMAX_FLOORACT)   ' SRC_REV 69, FMT 43; SRC_REV 70: the row's own
#endif
    emitRecord()

#ifdef DBG_LADDER
PRI emitLadder(rungIdx) | motorIncre
' BM-LADDER: one row of the LADDER table. Worst case 85 bytes.
'
' @param rungIdx - 0-based rung
'
' @local motorIncre - the rung's increment

    motorIncre := ladderIncre[rungIdx]
    recBegin(@"BM-LADDER")
    benchLog.numField(@"rung", rungIdx, LIM_TINY)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"pred_x10", predictX10(motorIncre), LIM_MID)
    benchLog.boolField(@"probe", rungIdx >= LADDER_BASE_RUNGS)
    emitRecord()

#endif

PRI emitStart(seg, side) | slotIdx, bZero
' BM-START from the st* staging and this lifetime's zero. Worst case 264 bytes.
'
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
'
' @local slotIdx - motor slot
' @local bZero - the lifetime zero is a measurement

    slotIdx := side - SIDE_LEFT
    bZero := bLifeZeroValid[slotIdx] <> FALSE
    recBegin(@"BM-START")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"life", slotLife[slotIdx], LIM_SMALL)
    benchLog.numField(@"cog_ret", stCogRet, LIM_TINY)
    benchLog.boolField(@"cog_ok", bStCogOk)
    benchLog.tokenField(@"board", boardToken(stBoard), TOKMAX_BOARD)
    benchLog.numField(@"board_enum", stBoard, LIM_TINY)
    benchLog.boolField(@"ready", bStReady)
    benchLog.numField(@"ready_ms", stReadyMs, LIM_SMALL)
    benchLog.numField(@"off_neg", stOffNeg, LIM_TINY)
    benchLog.numField(@"off_pos", stOffPos, LIM_TINY)
    benchLog.numField(@"missed", stMissed, LIM_SMALL)
    benchLog.numField(@"illegal", stIllegal, LIM_SMALL)
    benchLog.naNumField(@"zero_x10", lifeZeroX10[slotIdx], LIM_MID, bZero)
    benchLog.naNumField(@"ph_x10", lifePhX10[slotIdx], LIM_MID, bZero)
    whyField(bZero ? WHY_NONE : stWhy)
    emitRecord()

PRI emitSStart(seg)
' BM-SSTART from the ss* staging (sec 12.1 Q8: l_board / r_board replace board NA).
' Worst case: tag(9) + seq(15) + seg(13) + life(13) + motor(12) + ret(9) + ret_ok(13) + l_st(16) +
' r_st(16) + ready_ms(17) + l_neg(11) + l_pos(11) + r_neg(11) + r_pos(11) + l_ig(13) + r_ig(13) +
' l_board(16) + r_board(16) + why(23) = 258 bytes.
'
' @param seg - SEG_* in progress

    recBegin(@"BM-SSTART")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"life", steerLife, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(SIDE_BOTH), TOKMAX_MOTOR)
    benchLog.numField(@"ret", ssRet, LIM_TINY)
    benchLog.boolField(@"ret_ok", bSsRetOk)
    benchLog.tokenField(@"l_st", dcsToken(ssLeftState), TOKMAX_STATE)
    benchLog.tokenField(@"r_st", dcsToken(ssRightState), TOKMAX_STATE)
    benchLog.numField(@"ready_ms", ssReadyMs, LIM_SMALL)
    benchLog.numField(@"l_neg", ssLeftNeg, LIM_TINY)
    benchLog.numField(@"l_pos", ssLeftPos, LIM_TINY)
    benchLog.numField(@"r_neg", ssRightNeg, LIM_TINY)
    benchLog.numField(@"r_pos", ssRightPos, LIM_TINY)
    benchLog.numField(@"l_ig", ssLeftIg, LIM_SMALL)
    benchLog.numField(@"r_ig", ssRightIg, LIM_SMALL)
    benchLog.tokenField(@"l_board", boardToken(ssLeftBoard), TOKMAX_BOARD)
    benchLog.tokenField(@"r_board", boardToken(ssRightBoard), TOKMAX_BOARD)
    whyField(ssWhy)
    emitRecord()

#ifdef DBG_RUNG
PRI emitRung(seg, rid, rungIdx, side, motorIncre, resultCode, steadyMs, bSteadyValid, bWindowValid, whyCode)
' BM-RUNG from the caller's result and the rs* window statistics. Worst case 262 bytes.
'
' @param seg - SEG_* in progress
' @param rid - rung id from nextRungId()
' @param rungIdx - rung index into ladderIncre (or the segment's own rung number)
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param resultCode - RES_* value
' @param steadyMs - ms from command to AT_SPEED
' @param bSteadyValid - TRUE when steadyMs is a measurement
' @param bWindowValid - TRUE when the window statistics are a measurement
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-RUNG")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"life", slotLife[side - SIDE_LEFT], LIM_SMALL)
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.numField(@"rung", rungIdx, LIM_TINY)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.tokenField(@"result", tokenAt(@tokRes, RES_COUNT, resultCode), TOKMAX_RESULT)
    benchLog.numField(@"off_neg", rsOffNeg, LIM_TINY)
    benchLog.numField(@"off_pos", rsOffPos, LIM_TINY)
    benchLog.naNumField(@"steady_ms", steadyMs, LIM_SMALL, bSteadyValid)
    benchLog.naNumField(@"win_ms", rsWinMs, LIM_SMALL, bWindowValid)
    benchLog.naNumField(@"ticks", rsTicks, LIM_MID, bWindowValid)
    benchLog.naNumField(@"rate_x10", rsRateX10, LIM_MID, bWindowValid)
    benchLog.numField(@"pred_x10", predictX10(motorIncre), LIM_MID)
    whyField(whyCode)
    emitRecord()

PRI emitRung2(rid, side, motorIncre, dutyMax, bWindowValid, whyCode) | slotIdx, bZero
' BM-RUNG2: currents, phase sum and duty over the window; inet uses this lifetime's zero (PL-32).
' err / err_pk are the STEADY window's, opened after AT_SPEED and the settle: err_pk - err is the duty
' servo's ripple, never a transition kick (PL-87) -- BM-RUNGTR carries the transition. Worst case 269 bytes.
'
' @param rid - rung id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param dutyMax - duty_max from testGetDriveConstants()
' @param bWindowValid - TRUE when the window statistics are a measurement
' @param whyCode - WHY_* naming the cause of every NA
'
' @local slotIdx - motor slot
' @local bZero - this lifetime's zero is a measurement

    slotIdx := side - SIDE_LEFT
    bZero := bLifeZeroValid[slotIdx] <> FALSE
    recBegin(@"BM-RUNG2")
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.naNumField(@"zero_x10", lifeZeroX10[slotIdx], LIM_MID, bZero)
    benchLog.naNumField(@"i_x10", rsIMeanX10, LIM_MID, bWindowValid)
    benchLog.naNumField(@"inet_x10", rsIMeanX10 - lifeZeroX10[slotIdx], LIM_MID, bWindowValid and bZero)
    benchLog.naNumField(@"i_min", rsIMin, LIM_SMALL, bWindowValid)
    benchLog.naNumField(@"i_max", rsIMax, LIM_SMALL, bWindowValid)
    benchLog.naNumField(@"ph_x10", rsPhMeanX10, LIM_MID, bWindowValid)
    benchLog.naNumField(@"phu_x10", rsPhUMeanX10, LIM_MID, bWindowValid)
    benchLog.naNumField(@"phv_x10", rsPhVMeanX10, LIM_MID, bWindowValid)
    benchLog.naNumField(@"phw_x10", rsPhWMeanX10, LIM_MID, bWindowValid)
    benchLog.naNumField(@"duty", rsDutyMean, LIM_SMALL, bWindowValid)
    benchLog.naNumField(@"duty_pk", rsDutyPk, LIM_SMALL, bWindowValid)
    benchLog.numField(@"duty_max", dutyMax, LIM_SMALL)
    benchLog.naNumField(@"err", rsErrMean, LIM_TINY, bWindowValid)
    benchLog.naNumField(@"err_pk", rsErrPk, LIM_TINY, bWindowValid)
    benchLog.numField(@"n", rsN, LIM_SMALL)
    whyField(whyCode)
    emitRecord()

PRI emitRungTransition(rid, side, motorIncre)
' The pair of records every measured rung's TRANSITION needs -- BM-RUNGTR and BM-RUNGHL -- as one call,
' so the two rung kinds that emit them (rungEmitAll() for LADDER and CLOCK, liveRung() for LIVE) cannot
' drift apart on what a transition is recorded as (R18.1).
'
' @param rid - rung id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment

    emitRungTr(rid, side, motorIncre)
    emitRungHl(rid, side, motorIncre)

PRI emitRungTr(rid, side, motorIncre) | whyCode
' BM-RUNGTR (PL-87): the rung's TRANSITION, from the command mark to the window start -- peak |err| and
' peak |i| over the ramp and settle, against the rung's own steady statistics.
'
' R18.1 (PL-95), two fields, and the second one is what the cell now judges:
'  from_incre - the speed the wheel was HOLDING when the command arrived, so the transition's delta and
'               its direction are read off the record. from_rest is DERIVED from it here rather than
'               passed in: it is the same fact, and two copies of one fact maintained by different code
'               paths are two copies that can drift (D7).
'  tr_i_over  - the transition current peak above this rung's own steady peak. tr_over is the same
'               comparison on err, and err is CLAMPED: the limiter holds it near LAG_HOLD, so tr_over
'               read 0 of 22 at Visit 6a while tr_i_pk rose seventy-five-fold on the same rungs
'               (PL-87's table). Current is not clamped, and it was being recorded the whole time.
'
' Worst case 219 bytes: tag(9) + seq(15) + rid(12) + motor(12) + incre(19) + from_incre(24) +
' from_rest(16) + tr_ms(14) + tr_err_pk(15) + tr_i_pk(16) + tr_i_over(18) + tr_over(13) + tr_n(13) +
' why(23).
'
' @param rid - rung id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
'
' @local whyCode - the rung's why when it did not run clean, else the transition's own

    whyCode := rgWhy
    if whyCode == WHY_NONE
        whyCode := trWhy
    recBegin(@"BM-RUNGTR")
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"from_incre", rgFromIncre, LIM_BIG)
    benchLog.boolField(@"from_rest", rgFromIncre == 0)
    benchLog.naNumField(@"tr_ms", trMs, LIM_SMALL, trWhy == WHY_NONE)
    benchLog.naNumField(@"tr_err_pk", trErrPk, LIM_TINY, trWhy == WHY_NONE)
    benchLog.naNumField(@"tr_i_pk", trIPk, LIM_SMALL, trWhy == WHY_NONE)
    benchLog.naNumField(@"tr_i_over", trIOver(), LIM_SMALL, bTrIOverValid())
    benchLog.naNumField(@"tr_over", trErrPk - rsErrPk, LIM_TINY, (trWhy == WHY_NONE) and bRgWindowValid)
    benchLog.numField(@"tr_n", trN, LIM_SMALL)
    whyField(whyCode)
    emitRecord()

PRI trIOver() : nOver
' tr_i_over: the transition current peak above this rung's own steady peak (R18.1). One derivation, read
' by the BM-RUNGTR field and by R17-DUAL-TRKICK-A, so the printed value and the judged value are the same
' value rather than two expressions that agree today. Only a measurement when bTrIOverValid().
'
' @returns nOver - transition peak |i| less the steady window's i_max, in sense mV

    nOver := trIPk - rsIMax

PRI bTrIOverValid() : bValid
' Whether tr_i_over is a measurement: both peaks it subtracts must be measurements of this rung (R18.1).
' One test, used by the record and by the cell, so a printed NA and an unjudged rung cannot diverge.
'
' @returns bValid - TRUE when the transition and the steady window both measured

    bValid := (trWhy == WHY_NONE) and (bRgWindowValid <> FALSE)

PRI emitRungHl(rid, side, motorIncre)
' BM-RUNGHL (R18.1, PL-95): the driver's two UNBOUNDED health counters over this rung, differenced --
' tr_* across the TRANSITION (command to window start: the ramp and the settle), win_* across the STEADY
' window. drv_incr is the field's increment per drive pass at the window start, so lag_held converts to
' the field advance the limiter withheld: withheld angle = lag x drv_incr.
'
' WHY THIS RECORD EXISTS. err and duty, which BM-RUNG2 prints, both TOP OUT exactly where the drive stops
' keeping up -- err is held near LAG_HOLD by the limiter and bounded by its own +-127, duty saturates at
' duty_max and pins there for the whole top half of the range. Above the knee they report a ceiling, not
' a drive. These counts have no ceiling: zero means the drive kept up for every pass of the window, and
' they grow without bound when it cannot.
'
' NO CELL JUDGES THEM. They are characterisation readings for Visit 7, and the acceptance numbers that
' will judge them are R18.3's to choose, before R18.4 builds against them (doctrine D2: a criterion
' chosen after the fact cannot fail). On today's drive they are expected to be large above mid-range --
' that is PL-95, already recorded, not a verdict this harness re-states.
'
' Worst case 174 bytes: tag(9) + seq(15) + rid(12) + motor(12) + incre(19) + tr_lag(15) + tr_cap(15) +
' win_lag(16) + win_cap(16) + drv_incr(22) + why(23).
'
' @param rid - rung id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment

    recBegin(@"BM-RUNGHL")
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.naNumField(@"tr_lag", rgHlTrLag, LIM_SMALL, bRgHlTrValid)
    benchLog.naNumField(@"tr_cap", rgHlTrCap, LIM_SMALL, bRgHlTrValid)
    benchLog.naNumField(@"win_lag", rgHlWinLag, LIM_SMALL, bRgHlWinValid)
    benchLog.naNumField(@"win_cap", rgHlWinCap, LIM_SMALL, bRgHlWinValid)
    benchLog.naNumField(@"drv_incr", rgHlDrvIncr, LIM_BIG, bRgHlTrValid)
    whyField(rgWhy)
    emitRecord()

#endif

#ifdef DBG_LOWRUNG
PRI emitLow(rid, side, motorIncre, whyCode)
' BM-LOW (R18.2 item 5): the two readings that exist only below the ladder's bottom rung -- whether the
' wheel starts and how long starting takes, and the spread of the intervals between hall edges, which is
' the cogging reading. Everything else about the rung is already in BM-RUNG / BM-RUNG2 / BM-RUNGTR /
' BM-RUNGHL / BM-RUNG3; this record adds only what the low-speed regime makes visible.
'
' NO CELL JUDGES IT. Like BM-RUNGHL it is characterisation for R18.3, which chooses the acceptance
' numbers before R18.4 builds against them (D2). We do not yet know what a good first-edge time or a
' tolerable gap spread is at 1x10^6 -- that is the point of measuring.
'
' Worst case 148 bytes: tag(6) + seq(15) + rid(12) + motor(12) + incre(19) + first_ms(17) + edges(13) +
' gap_min(16) + gap_max(16) + why(23).
'
' @param rid - rung id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-LOW")
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.naNumField(@"first_ms", lsFirstEdgeMs, LIM_SMALL, bLsFirstValid)
    benchLog.numField(@"edges", lsEdges, LIM_SMALL)
    benchLog.naNumField(@"gap_min", lsGapMin, LIM_SMALL, bLsGapValid)
    benchLog.naNumField(@"gap_max", lsGapMax, LIM_SMALL, bLsGapValid)
    whyField(whyCode)
    emitRecord()

#endif

#ifdef DBG_RUNG
PRI emitRung3(rid, side, motorIncre, missedD, illegalD, ampsX10k, bAmpsValid, bWindowValid, whyCode) | rsImpl
' BM-RUNG3: integrity deltas, hwPos, getCurrent() mean and the capture's counters. Worst case 270 bytes.
'
' @param rid - rung id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param missedD - missed transitions over the rung (read before arm and after freeze)
' @param illegalD - illegal codes over the rung
' @param ampsX10k - mean getCurrent() over the window, A x 10_000
' @param bAmpsValid - TRUE when ampsX10k is a measurement
' @param bWindowValid - TRUE when the window statistics are a measurement
' @param whyCode - WHY_* naming the cause of every NA
'
' @local rsImpl - implied sense scale i_x10 x 1_000 / amps_x10k

    rsImpl := 0
    if bAmpsValid and (ampsX10k > 0)
        rsImpl := (rsIMeanX10 * MS_PER_SEC) / ampsX10k
    recBegin(@"BM-RUNG3")
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"missed_d", missedD, LIM_SMALL)
    benchLog.numField(@"illegal_d", illegalD, LIM_SMALL)
    benchLog.naNumField(@"hw_ticks", rsHwTicks, LIM_MID, bWindowValid)
    benchLog.numField(@"hw_skip", rsHwSkip, LIM_SMALL)
    benchLog.naNumField(@"amps_x10k", ampsX10k, LIM_MID, bAmpsValid)
    benchLog.naNumField(@"rs_impl", rsImpl, LIM_SMALL, bAmpsValid and bWindowValid and (ampsX10k > 0))
    benchLog.numField(@"late", rsLate, LIM_SMALL)
    benchLog.numField(@"skipped", rsSkipped, LIM_SMALL)
    benchLog.numField(@"clamps", rsClamps, LIM_SMALL)
    benchLog.boolField(@"idle_up", bRsIdleUp)
    benchLog.numField(@"idle_i", rsIdleIMax, LIM_SMALL)
    whyField(whyCode)
    emitRecord()

#endif

#ifdef DBP_A
PRI emitLive(rid, side, motorIncre, rpmRead, bHeartbeatOk, bWindowValid, whyCode)
' BM-LIVE: instrument liveness beside testGetRpm(). Worst case 203 bytes.
'
' @param rid - rung id
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - signed increment
' @param rpmRead - testGetRpm() after the window
' @param bHeartbeatOk - the instrument heartbeat advanced over the window
' @param bWindowValid - TRUE when the window statistics are a measurement
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-LIVE")
    benchLog.numField(@"rid", rid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.boolField(@"up_all", bRsAllUp)
    benchLog.naNumField(@"ticks", rsTicks, LIM_MID, bWindowValid)
    benchLog.naNumField(@"i_min", rsIMin, LIM_SMALL, bWindowValid)
    benchLog.naNumField(@"i_max", rsIMax, LIM_SMALL, bWindowValid)
    benchLog.boolField(@"frozen", bWindowValid and (rsIMin == rsIMax))
    benchLog.naNumField(@"rpm", rpmRead, LIM_SMALL, bWindowValid)
    benchLog.naNumField(@"rate_x10", rsRateX10, LIM_MID, bWindowValid)
    benchLog.boolField(@"hb_ok", bHeartbeatOk)
    whyField(whyCode)
    emitRecord()

#endif

#ifdef DBP_CLOCK
PRI bEmitClock(side, adcFram, frameCnt, deadGap) : bFrameOk | expFrame, bSwept
' BM-CLOCK: the driver's frame count against the compiled clock's expected value. Also returns the
' comparison this clock's R14-DUAL-CLKFRM-K200 / -K270 / -K300 cell folds. Worst case 159 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param adcFram - adc_fram from testGetDriveConstants()
' @param frameCnt - frame_cnt from testGetDriveConstants()
' @param deadGap - dead_gap from testGetDriveConstants()
' @returns bFrameOk - adc_fram equals the expected frame count at a swept clock
'
' @local expFrame - expected frame count at CLK_FREQ
' @local bSwept - CLK_FREQ is 200, 270 or 300 MHz

    bSwept := TRUE
    case CLK_FREQ
        CLK_SWEEP_200:
            expFrame := EXP_FRAME_200
        CLK_SWEEP_270:
            expFrame := EXP_FRAME_270
        CLK_SWEEP_300:
            expFrame := EXP_FRAME_300
        other:
            expFrame := 0
            bSwept := FALSE
    bFrameOk := bSwept and (adcFram == expFrame)
    recBegin(@"BM-CLOCK")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"clkfreq", CLKFREQ, LIM_BIG)
    benchLog.numField(@"adc_fram", adcFram, LIM_SMALL)
    benchLog.numField(@"frame_cnt", frameCnt, LIM_SMALL)
    benchLog.numField(@"dead_gap", deadGap, LIM_TINY)
    benchLog.naNumField(@"exp_fram", expFrame, LIM_SMALL, bSwept)
    benchLog.boolField(@"fram_ok", bFrameOk)
    whyField(bSwept ? WHY_NONE : WHY_UNSWEPT_CLOCK)
    emitRecord()

#endif

PRI emitTrace(tid, seg, side, causeCode, motorIncre, offNeg, offPos, reqMode, accelUp, whyCode)
' BM-TRACE: a wheel trace header naming what was requested and what was done, never the outcome (I7).
' Worst case 233 bytes.
'
' @param tid - trace id
' @param seg - SEG_* in progress
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param causeCode - CAUSE_* value
' @param motorIncre - signed increment
' @param offNeg - offset_fwd read back before the measurement
' @param offPos - offset_rev read back before the measurement
' @param reqMode - MODE_* requested
' @param accelUp - accel_up (the speed-up limit, maxRamp) read back
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-TRACE")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"life", slotLife[side - SIDE_LEFT], LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"cause", tokenAt(@tokCause, CAUSE_COUNT, causeCode), TOKMAX_CAUSE)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"off_neg", offNeg, LIM_TINY)
    benchLog.numField(@"off_pos", offPos, LIM_TINY)
    benchLog.tokenField(@"req_mode", tokenAt(@tokMode, MODE_COUNT, reqMode), TOKMAX_REQMODE)
    benchLog.numField(@"accel_up", accelUp, LIM_MID)                         ' SRC_REV 59 (FMT 38): was ramp_inc
    benchLog.numField(@"period_us", INST_PERIOD_US, LIM_SMALL)
    benchLog.numField(@"decim", instDecimate, LIM_TINY)
    benchLog.numField(@"pre", TRACE_PRE_SAMPLES, LIM_SMALL)
    whyField(whyCode)
    emitRecord()

PRI emitSTrace(tid, seg, causeCode, leftPower, rightPower, bPowersValid, dirValue, reqMode, whyCode)
' BM-STRACE: a steering trace header; primary motor LEFT, o_ fields RIGHT. Worst case 200 bytes (an NA
' power is shorter than a number).
'
' @param tid - trace id
' @param seg - SEG_* in progress
' @param causeCode - CAUSE_* value
' @param leftPower - requested left power, or FLOOR's getPower() read-back
' @param rightPower - requested right power, or FLOOR's getPower() read-back
' @param bPowersValid - TRUE when the powers are a request or a read-back; FALSE prints NA
' @param dirValue - commanded direction (0 when not driveDirection())
' @param reqMode - MODE_* requested
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-STRACE")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"life", steerLife, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(SIDE_BOTH), TOKMAX_MOTOR)
    benchLog.tokenField(@"cause", tokenAt(@tokCause, CAUSE_COUNT, causeCode), TOKMAX_CAUSE)
    benchLog.naNumField(@"l_pwr", leftPower, LIM_TINY, bPowersValid)
    benchLog.naNumField(@"r_pwr", rightPower, LIM_TINY, bPowersValid)
    benchLog.numField(@"dir", dirValue, LIM_TINY)
    benchLog.tokenField(@"req_mode", tokenAt(@tokMode, MODE_COUNT, reqMode), TOKMAX_REQMODE)
    benchLog.numField(@"period_us", INST_PERIOD_US, LIM_SMALL)
    benchLog.numField(@"decim", instDecimate, LIM_TINY)
    benchLog.numField(@"pre", TRACE_PRE_SAMPLES, LIM_SMALL)
    whyField(whyCode)
    emitRecord()

PRI emitTs(sampleIdx, kIdx, posRel, hwRel) | bUp, bOtherUp, bLate
' BM-TS: one stored sample of the trace in drain (drPri primary, drOth other). lt is computed from the
' stored t of the previous sample. PL-136 appends u, v and w, the primary's three phase voltages (mV), which the ring
' has always stored apart (instPackSense()) and which were printed only as their sum ph; NA when its driver was down,
' as ph is. SRC_REV 70 (FMT 44) appends the other wheel's e, st and flt beside the primary's -- o_e, o_st, o_flt, from the
' same ring sample (the lag fault the coast trial's RIGHT wheel took was invisible: only its pos, hw and i were printed).
' Worst case 308 bytes (271, and o_e 9 + o_st 16 + o_flt 12): over the design's 280 target, well inside the builder's
' 640-byte line buffer (isp_bench_log LINE_BUF_SIZE), which is what truncates.
'
' @param sampleIdx - logical index
' @param kIdx - trace index k
' @param posRel - primary pos relative to k = 0
' @param hwRel - primary hwPos relative to k = 0
'
' @local bUp - primary driver up
' @local bOtherUp - other driver up
' @local bLate - this sample started late relative to the previous stored one

    bUp := bSmpUp(sampleIdx, drPri)
    bOtherUp := bSmpUp(sampleIdx, drOth)
    bLate := FALSE
    if kIdx > 0
        bLate := (smpT(sampleIdx) - smpT(sampleIdx - 1)) > ((INST_PERIOD_TICKS * instDecimate) + INST_LATE_TICKS)
    recBegin(@"BM-TS")
    benchLog.numField(@"tid", trTid, LIM_SMALL)
    benchLog.numField(@"k", kIdx, LIM_SMALL)
    benchLog.boolField(@"lt", bLate)
    benchLog.numField(@"pos", posRel, LIM_MID)
    benchLog.numField(@"hw", hwRel, LIM_MID)
    benchLog.naNumField(@"i", smpI(sampleIdx, drPri), LIM_SMALL, bUp)
    benchLog.naNumField(@"ph", smpPh(sampleIdx, drPri), LIM_SMALL, bUp)
    benchLog.naNumField(@"d", smpDuty(sampleIdx, drPri), LIM_SMALL, bUp)
    benchLog.naNumField(@"e", smpErr(sampleIdx, drPri), LIM_TINY, bUp)
    benchLog.tokenField(@"st", dcsToken(smpState(sampleIdx, drPri)), TOKMAX_STATE)
    benchLog.boolField(@"flt", bSmpFault(sampleIdx, drPri))
    benchLog.boolField(@"up", bUp)
    benchLog.numField(@"ig", trIgRun, LIM_SMALL)
    benchLog.numField(@"o_pos", smpPos(sampleIdx, drOth) - smpPos(drStartJ, drOth), LIM_MID)
    benchLog.numField(@"o_hw", smpHw(sampleIdx, drOth) - smpHw(drStartJ, drOth), LIM_MID)
    benchLog.naNumField(@"o_i", smpI(sampleIdx, drOth), LIM_SMALL, bOtherUp)
    benchLog.boolField(@"o_up", bOtherUp)
    benchLog.naNumField(@"o_e", smpErr(sampleIdx, drOth), LIM_TINY, bOtherUp)
    benchLog.tokenField(@"o_st", dcsToken(smpState(sampleIdx, drOth)), TOKMAX_STATE)
    benchLog.boolField(@"o_flt", bSmpFault(sampleIdx, drOth))
    benchLog.naNumField(@"u", smpPhU(sampleIdx, drPri), LIM_SMALL, bUp)
    benchLog.naNumField(@"v", smpPhV(sampleIdx, drPri), LIM_SMALL, bUp)
    benchLog.naNumField(@"w", smpPhW(sampleIdx, drPri), LIM_SMALL, bUp)
    whyField((bUp and bOtherUp) ? WHY_NONE : WHY_NO_COG)
    emitRecord()

PRI emitTraceEnd(tid, endCode, emptyWhy) | traceSamples, markK, whyCode
' BM-TRACE-END from the drain state, with sec 12.4's stride before why. Worst case: 265 + stride
' (2+6+4=12) = 277 bytes.
'
' @param tid - trace id
' @param endCode - TEND_* value
' @param emptyWhy - WHY_* printed when no sample was stored (NO_SAMPLES, or why the trial never ran)
'
' @local traceSamples - samples in the trace (drStartJ..drEndJ)
' @local markK - k of the mark
' @local whyCode - emptyWhy, NOT_REACHED (mark or rest not found) or NONE

    traceSamples := 0
    if drStored > 0
        traceSamples := drEndJ - drStartJ + 1
    markK := drMarkJ - drStartJ
    if drStored == 0
        whyCode := emptyWhy
    elseif (bDrMarkFound == FALSE) or (bDrRestFound == FALSE)
        whyCode := WHY_NOT_REACHED
    else
        whyCode := WHY_NONE
    recBegin(@"BM-TRACE-END")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.numField(@"stored", traceSamples, LIM_SMALL)
    benchLog.numField(@"emitted", trLines, LIM_SMALL)
    benchLog.numField(@"ksum", trKSum, LIM_MID)
    benchLog.naNumField(@"mark_k", markK, LIM_SMALL, bDrMarkFound)
    benchLog.naNumField(@"late", instLate, LIM_SMALL, drStored > 0)
    benchLog.naNumField(@"skipped", instSkipped, LIM_SMALL, drStored > 0)
    benchLog.numField(@"lost_head", drLostHead, LIM_SMALL)
    benchLog.numField(@"dropped", drDropped, LIM_SMALL)
    benchLog.tokenField(@"end", tokenAt(@tokTend, TEND_COUNT, endCode), TOKMAX_TEND)
    benchLog.naNumField(@"rest_k", drRestK, LIM_SMALL, bDrRestFound)
    benchLog.numField(@"ig_sum", drIgSum, LIM_SMALL)
    benchLog.numField(@"o_ig_sum", drOIgSum, LIM_SMALL)
    benchLog.numField(@"hw_skip", drHwSkip, LIM_SMALL)
    benchLog.numField(@"stride", trStride, LIM_TINY)
    whyField(whyCode)
    emitRecord()

#ifdef DBP_B
PRI emitFbTrial(tid, side)
' BM-FBTRIAL from the fb* staging. Worst case 269 bytes.
'
' @param tid - trace id of the trial
' @param side - SIDE_LEFT or SIDE_RIGHT

    recBegin(@"BM-FBTRIAL")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"trial", fbTrial, LIM_TINY)
    benchLog.numField(@"accel_up", fbAccelUp, LIM_MID)                       ' SRC_REV 59 (FMT 38): was ramp_inc
    benchLog.numField(@"incre", fbIncre, LIM_BIG)
    benchLog.numField(@"off_neg", fbOffNeg, LIM_TINY)
    benchLog.numField(@"off_pos", fbOffPos, LIM_TINY)
    benchLog.tokenField(@"result", tokenAt(@tokRes, RES_COUNT, fbResult), TOKMAX_RESULT)
    benchLog.naNumField(@"t_ms", fbTMs, LIM_SMALL, bFbTValid)
    benchLog.numField(@"i_pk", fbIPk, LIM_SMALL)
    benchLog.numField(@"duty_pk", fbDutyPk, LIM_SMALL)
    benchLog.numField(@"duty_max", fbDutyMax, LIM_SMALL)
    benchLog.boolField(@"dsat", bFbDsat)
    benchLog.tokenField(@"rst", tokenAt(@tokRst, RST_COUNT, fbRst), TOKMAX_RST)
    benchLog.numField(@"rst_ms", fbRstMs, LIM_SMALL)
    whyField(fbWhy)
    emitRecord()

#endif

PRI emitRampRest(side, jerkUp, accelUp, jerkDn, accelDn, bOk)
' BM-RAMPREST: the ramp restore read back (I11). Worst case 148 bytes. SRC_REV 59 (FMT 38): the four fields are
' DRIVER_REV 38's names for testGetRampLimits()'s four (were min, max, inc, down).
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param jerkUp - jerk_up read back
' @param accelUp - accel_up read back
' @param jerkDn - jerk_dn read back
' @param accelDn - accel_dn read back
' @param bOk - TRUE when the built-in ramp read back

    recBegin(@"BM-RAMPREST")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"jerk_up", jerkUp, LIM_MID)
    benchLog.numField(@"accel_up", accelUp, LIM_MID)
    benchLog.numField(@"jerk_dn", jerkDn, LIM_MID)
    benchLog.numField(@"accel_dn", accelDn, LIM_MID)
    benchLog.boolField(@"ok", bOk)
    whyField(WHY_NONE)
    emitRecord()

PRI emitOffRest(side, wantNeg, wantPos, offNeg, offPos, bOk)
' BM-OFFREST: the offset restore read back (I11). Worst case 123 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param wantNeg - offset_fwd restored
' @param wantPos - offset_rev restored
' @param offNeg - offset_fwd read back
' @param offPos - offset_rev read back
' @param bOk - TRUE when both read back equal

    recBegin(@"BM-OFFREST")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"want_neg", wantNeg, LIM_TINY)
    benchLog.numField(@"want_pos", wantPos, LIM_TINY)
    benchLog.numField(@"off_neg", offNeg, LIM_TINY)
    benchLog.numField(@"off_pos", offPos, LIM_TINY)
    benchLog.boolField(@"ok", bOk)
    whyField(WHY_NONE)
    emitRecord()

PRI emitRecover(seg, tid, side, motorIncre, offNeg, offPos, stepCode, bCleared, stepMs, eDrvrState, bFaultSig)
' BM-RECOVER: one recovery step. Worst case 193 bytes.
'
' @param seg - SEG_* in progress
' @param tid - trace id, 0 when none
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - the faulted command
' @param offNeg - offset_fwd read back
' @param offPos - offset_rev read back
' @param stepCode - RSTEP_* value
' @param bCleared - stopped and not faulted
' @param stepMs - ms the step took
' @param eDrvrState - driver state after the step
' @param bFaultSig - fault flag after the step

    recBegin(@"BM-RECOVER")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"off_neg", offNeg, LIM_TINY)
    benchLog.numField(@"off_pos", offPos, LIM_TINY)
    benchLog.tokenField(@"step", tokenAt(@tokRstep, RSTEP_COUNT, stepCode), TOKMAX_STEP)
    benchLog.boolField(@"cleared", bCleared)
    benchLog.numField(@"ms", stepMs, LIM_SMALL)
    benchLog.tokenField(@"st", dcsToken(eDrvrState), TOKMAX_STATE)
    benchLog.boolField(@"flt", bFaultSig)
    whyField(WHY_NONE)
    emitRecord()

PRI emitUnrecov(seg, tid, side, motorIncre, offNeg, offPos, eDrvrState, bFaultSig, bUp)
' BM-UNRECOV: recovery step 4, the motor is retired for this load. Worst case 184 bytes.
'
' @param seg - SEG_* in progress
' @param tid - trace id, 0 when none
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - the faulted command
' @param offNeg - offset_fwd read back
' @param offPos - offset_rev read back
' @param eDrvrState - driver state after the restart
' @param bFaultSig - fault flag after the restart
' @param bUp - the restart's start succeeded

    recBegin(@"BM-UNRECOV")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.numField(@"off_neg", offNeg, LIM_TINY)
    benchLog.numField(@"off_pos", offPos, LIM_TINY)
    benchLog.tokenField(@"st", dcsToken(eDrvrState), TOKMAX_STATE)
    benchLog.boolField(@"flt", bFaultSig)
    benchLog.boolField(@"up", bUp)
    benchLog.tokenField(@"action", @sActionRetired, TOKMAX_ACTION)
    whyField(WHY_MOTOR_RETIRED)
    emitRecord()

PRI emitAbort(seg, tid, side, motorIncre, reasonCode, detailValue, scopeCode)
' BM-ABORT. Worst case 153 bytes.
'
' @param seg - SEG_* in progress
' @param tid - trace id, 0 when none
' @param side - SIDE_* affected
' @param motorIncre - the command in force
' @param reasonCode - ABR_* value
' @param detailValue - the reading or count that triggered it
' @param scopeCode - SCOPE_* value

    recBegin(@"BM-ABORT")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.tokenField(@"reason", tokenAt(@tokAbr, ABR_COUNT, reasonCode), TOKMAX_REASON)
    benchLog.numField(@"value", detailValue, LIM_BIG)
    benchLog.tokenField(@"scope", tokenAt(@tokScope, SCOPE_COUNT, scopeCode), TOKMAX_SCOPE)
    whyField(WHY_NONE)
    emitRecord()

#ifdef DBG_OVERSHT
PRI emitOvershoot(tid, sid, powerValue, distFt, bStraight) | bValid
' BM-OVERSHOOT from the ov* staging. Worst case 271 bytes. On a TURN trial (two distances) dist_ft and tgt
' print NA, since one number cannot describe both wheels; BM-TURN carries each wheel's (task 3577).
'
' @param tid - trace id
' @param sid - the steering start's life
' @param powerValue - commanded power
' @param distFt - commanded distance, feet (a straight trial's; printed NA on a turn)
' @param bStraight - TRUE when both wheels were given distFt
'
' @local bValid - the stop/rest fields are measurements (ovWhy is WHY_NONE)

    bValid := (ovWhy == WHY_NONE)
    recBegin(@"BM-OVERSHOOT")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.numField(@"sid", sid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(SIDE_BOTH), TOKMAX_MOTOR)
    benchLog.numField(@"power", powerValue, LIM_TINY)
    benchLog.naNumField(@"dist_ft", distFt, LIM_TINY, bStraight)
    benchLog.naNumField(@"tgt", overshootTarget(distFt), LIM_MID, bStraight)
    benchLog.naNumField(@"l_stop", ovLeftStop, LIM_MID, bValid)
    benchLog.naNumField(@"r_stop", ovRightStop, LIM_MID, bValid)
    benchLog.naNumField(@"l_rest", ovLeftRest, LIM_MID, bValid)
    benchLog.naNumField(@"r_rest", ovRightRest, LIM_MID, bValid)
    benchLog.numField(@"l_trk", ovLeftTrk, LIM_MID)
    benchLog.numField(@"r_trk", ovRightTrk, LIM_MID)
    benchLog.naNumField(@"t_stop", ovTStopMs, LIM_SMALL, bValid)
    benchLog.numField(@"l_ig", ovLeftIg, LIM_SMALL)
    benchLog.numField(@"r_ig", ovRightIg, LIM_SMALL)
    whyField(ovWhy)
    emitRecord()

PRI emitTurn(tid, leftFt, rightFt) | bValid
' BM-TURN (task 3577): a turn trial's two distances, two targets and two rests, the rests in the PLATFORM
' frame (ovRightRestPf, the right wheel's raw rest x STEER_RIGHT_RAW_SIGN), so each rest reads against its own target as
' R17-DUAL-TURNDIST-B judges it. BM-OVERSHOOT beside it keeps the raw stop and rest fields. Worst case:
' tag(7) + seq(15) + tid(12) + l_ft(10) + r_ft(10) + l_tgt(17) + r_tgt(17) + l_rest(18) + r_rest(18) +
' why(23) = 147 bytes.
'
' @param tid - trace id
' @param leftFt - the left wheel's commanded distance, feet
' @param rightFt - the right wheel's commanded distance, feet
'
' @local bValid - the rest fields are measurements (ovWhy is WHY_NONE)

    bValid := (ovWhy == WHY_NONE)
    recBegin(@"BM-TURN")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.numField(@"l_ft", leftFt, LIM_TINY)
    benchLog.numField(@"r_ft", rightFt, LIM_TINY)
    benchLog.numField(@"l_tgt", overshootTarget(leftFt), LIM_MID)
    benchLog.numField(@"r_tgt", overshootTarget(rightFt), LIM_MID)
    benchLog.naNumField(@"l_rest", ovLeftRest, LIM_MID, bValid)
    benchLog.naNumField(@"r_rest", ovRightRestPf, LIM_MID, bValid)
    whyField(ovWhy)
    emitRecord()

#endif

#ifdef DBG_OUTPOLL
PRI emitOut(tid, sid, rowIdx) | rowBase
' BM-OUT: one 100 ms poll of the public API from outBuf. Worst case 239 + faulted(2+7+5=14) +
' estop(2+5+5=12) = 265 bytes.
'
' @param tid - trace id
' @param sid - the steering start's life
' @param rowIdx - 0-based poll row
'
' @local rowBase - first long of the row

    rowBase := rowIdx * OUT_LONGS
    recBegin(@"BM-OUT")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.numField(@"sid", sid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(SIDE_BOTH), TOKMAX_MOTOR)
    benchLog.numField(@"t_ms", outBuf[rowBase + OUT_T_MS], LIM_SMALL)
    benchLog.tokenField(@"l_stat", statusToken(outBuf[rowBase + OUT_L_STAT]), TOKMAX_STAT)
    benchLog.tokenField(@"r_stat", statusToken(outBuf[rowBase + OUT_R_STAT]), TOKMAX_STAT)
    benchLog.tokenField(@"l_st", dcsToken(outBuf[rowBase + OUT_L_ST]), TOKMAX_STATE)
    benchLog.tokenField(@"r_st", dcsToken(outBuf[rowBase + OUT_R_ST]), TOKMAX_STATE)
    benchLog.boolField(@"l_flt", outBuf[rowBase + OUT_L_FLT])
    benchLog.boolField(@"l_sig", outBuf[rowBase + OUT_L_SIG])
    benchLog.boolField(@"r_flt", outBuf[rowBase + OUT_R_FLT])
    benchLog.boolField(@"r_sig", outBuf[rowBase + OUT_R_SIG])
    benchLog.boolField(@"turning", outBuf[rowBase + OUT_TURNING])
    benchLog.numField(@"l_pwr", outBuf[rowBase + OUT_L_PWR], LIM_TINY)
    benchLog.numField(@"r_pwr", outBuf[rowBase + OUT_R_PWR], LIM_TINY)
    benchLog.boolField(@"faulted", outBuf[rowBase + OUT_FAULTED])
    benchLog.boolField(@"estop", outBuf[rowBase + OUT_ESTOP])
    whyField(WHY_NONE)
    emitRecord()

#endif

#ifdef DBP_B
PRI emitFltApi(tid, sid, whyCode)
' BM-FLTAPI: the OVERSHT fault-API trial's own verdict (task 3552). The trial PRINTS WHETHER IT FAULTED,
' so a run that provoked nothing says so in one line instead of being inferred from the absence of rows.
' flt_ms and held_ms print NA when no fault arrived. Worst case 224 - want_off(17) + l_shift(16) + r_shift(16)
' + l_cause(13) + r_cause(13) = 265 bytes.
'
' @param tid - trace id, the one the BM-OUT rows below carry
' @param sid - the steering start's life
' @param whyCode - WHY_NONE when the fault arrived and the verdict was read, else the cause

    recBegin(@"BM-FLTAPI")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.numField(@"sid", sid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(SIDE_BOTH), TOKMAX_MOTOR)
    ' task 3572: the provocation is a COMPUTED shift per wheel (faultShiftDeg()), so the record names each
    '  wheel's shift and the offset it read back (the offsets in force are in the BM-OFFREST pair beside this)
    benchLog.numField(@"l_shift", fltLeftShift, LIM_SMALL)
    benchLog.numField(@"r_shift", fltRightShift, LIM_SMALL)
    benchLog.numField(@"l_off", fltLeftInc, LIM_SMALL)
    benchLog.numField(@"r_off", fltRightInc, LIM_SMALL)
    benchLog.numField(@"power", FLTAPI_POWER, LIM_TINY)
    benchLog.numField(@"rows", outCount, LIM_SMALL)
    benchLog.naNumField(@"flt_ms", fltFaultMs, LIM_SMALL, bSfFltApiRan)
    benchLog.naNumField(@"held_ms", fltLatchMs, LIM_SMALL, bSfFltApiRan)
    benchLog.numField(@"need_ms", FLTAPI_LATCH_MS, LIM_SMALL)
    benchLog.boolField(@"latched", bSfFltApiOk)
    ' task 3560 / PL-66: the SAME power commanded again after the fault. Appended, so a fmt-3 reader
    '  still parses every field it knows.
    benchLog.naNumField(@"retry_err", fltRetryErr, LIM_MID, bSfRetryRan)
    benchLog.naNumField(@"retry_ms", fltRetryMs, LIM_SMALL, bSfRetryRan and bFltRetryOk)
    benchLog.boolField(@"retry_ok", bFltRetryOk)
    ' task 3572 (S-7): the cause each wheel reports for the provoked fault. Appended.
    benchLog.tokenField(@"l_cause", tokenAt(@tokFltCause, FC_COUNT, fltLeftCause), TOKMAX_FCAUSE)
    benchLog.tokenField(@"r_cause", tokenAt(@tokFltCause, FC_COUNT, fltRightCause), TOKMAX_FCAUSE)
    whyField(whyCode)
    emitRecord()

#endif

#ifdef DBP_D
PRI emitDStep(side)
' BM-DSTEP: one part-D claim, from the ds* staging. One record shape for every step, so the log reads as
' one table and a step that could not be provoked prints its NOMEAS row beside the ones that did.
' Worst case 187 bytes.
'
' @param side - SIDE_BOTH (the steering object) or SIDE_LEFT (the single wheel)

    recBegin(@"BM-DSTEP")
    benchLog.tokenField(@"step", tokenAt(@tokDStep, DST_COUNT, dsStep), TOKMAX_DSTEP)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"seg", segToken(curSeg), TOKMAX_SEG)
    benchLog.naNumField(@"measured", dsMeasured, LIM_MID, dsResult <> DRES_NOMEAS)
    benchLog.numField(@"lo", dsLo, LIM_MID)
    benchLog.numField(@"hi", dsHi, LIM_MID)
    benchLog.tokenField(@"result", tokenAt(@tokDRes, DRES_COUNT, dsResult), TOKMAX_DRES)
    whyField(dsWhy)
    emitRecord()

PRI emitTimeStop(side, bFired, fireRelMs, bZero, zeroRelMs, bRest, restRelMs, nLatePasses)
' BM-TIMESTOP (SRC_REV 57, PL-145): one time stop's three instants, each in ms from its deadline, signed (negative is
' before it), NA for an instant not seen. zero_ms is the judged number, BM-DSTEP TIMESTOP's measured: every driver
' first read DCS_STOPPED. fire_ms is when getPower() first read 0, the limit firing, a correct stop's one ramp-down
' before the deadline. rest_ms is rest confirmed (REST_CONFIRM_MS of still pos and hwPos included), the number the cell
' judged through SRC_REV 56, printed for continuity and NOT judged; its deadline is now taken before the call, so it
' can read up to one request round trip later than a SRC_REV 56 reading of the same stop. late_pass is the front cog's
' late passes over the step (testGetFrontStats()), not judged: whether an overrun fell inside it. Printed only for a
' stop that was armed at speed. Worst case 104 bytes.
'
' @param side - SIDE_BOTH or SIDE_LEFT
' @param bFired - TRUE when getPower() was seen at 0
' @param fireRelMs - that instant, ms from the deadline
' @param bZero - TRUE when every driver was seen at DCS_STOPPED
' @param zeroRelMs - that instant, ms from the deadline
' @param bRest - TRUE when rest was confirmed
' @param restRelMs - that instant, ms from the deadline
' @param nLatePasses - the front cog's late passes counted over the step

    recBegin(@"BM-TIMESTOP")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.naNumField(@"fire_ms", fireRelMs, LIM_SMALL, bFired)
    benchLog.naNumField(@"zero_ms", zeroRelMs, LIM_SMALL, bZero)
    benchLog.naNumField(@"rest_ms", restRelMs, LIM_SMALL, bRest)
    benchLog.numField(@"late_pass", nLatePasses, LIM_SMALL)
    emitRecord()

PRI emitRestCoast(slotIdx, whyCode) | refIdx, trialIdx, eResult
' BM-RESTCOAST (task 3623, PL-138): one wheel's two RESTCOAST runs. Rates are hall ticks/s x10 from the instrument's
' pin-decoded position: *_pre over RC_PRE_MS before the stop call (the speed each run stopped from), *_x10 over the
' window of win_ms from it, whose ticks are *_ticks. keep_pct is tr_x10 / ref_x10 in %, the cell's number. rs_ret is
' the trial's start() return and call_ms how long after the stop call it was called; coast_ms is the reference's stop
' call to confirmed rest (REST_CONFIRM_MS included), NA when rest was not confirmed inside RC_REST_MS.
' Worst case 269 bytes.
'
' @param slotIdx - motor slot
' @param whyCode - WHY_* naming what this wheel's number is missing, WHY_NONE when it was measured
'
' @local refIdx - the reference run's staging index for this wheel
' @local trialIdx - the trial run's
' @local eResult - DRES_*

    refIdx := (RC_REF * INST_MOTORS) + slotIdx
    trialIdx := (RC_TRIAL * INST_MOTORS) + slotIdx
    if bRcRan[slotIdx] == FALSE
        eResult := DRES_NOMEAS
    elseif rcKeepPct[slotIdx] >= RC_KEEP_PCT
        eResult := DRES_PASS
    else
        eResult := DRES_FAIL
    recBegin(@"BM-RESTCOAST")
    benchLog.tokenField(@"motor", sideToken(SIDE_LEFT + slotIdx), TOKMAX_MOTOR)
    benchLog.numField(@"power", D_RC_POWER, LIM_TINY)
    benchLog.numField(@"win_ms", RC_WINDOW_MS, LIM_SMALL)
    benchLog.naNumField(@"ref_pre_x10", rcPreX10[refIdx], LIM_SMALL, rcWhy[RC_REF] == WHY_NONE)
    benchLog.naNumField(@"ref_ticks", rcTicks[refIdx], LIM_SMALL, rcWhy[RC_REF] == WHY_NONE)
    benchLog.naNumField(@"ref_x10", rcWinX10[refIdx], LIM_SMALL, rcWhy[RC_REF] == WHY_NONE)
    benchLog.naNumField(@"tr_pre_x10", rcPreX10[trialIdx], LIM_SMALL, rcWhy[RC_TRIAL] == WHY_NONE)
    benchLog.naNumField(@"tr_ticks", rcTicks[trialIdx], LIM_SMALL, rcWhy[RC_TRIAL] == WHY_NONE)
    benchLog.naNumField(@"tr_x10", rcWinX10[trialIdx], LIM_SMALL, rcWhy[RC_TRIAL] == WHY_NONE)
    benchLog.naNumField(@"keep_pct", rcKeepPct[slotIdx], LIM_SMALL, bRcRan[slotIdx])
    benchLog.naNumField(@"rs_ret", rcRet, LIM_TINY, bRcCalled)
    benchLog.naNumField(@"call_ms", rcCallMs, LIM_SMALL, bRcCalled)
    benchLog.naNumField(@"coast_ms", rcCoastMs, LIM_SMALL, rcCoastMs >= 0)
    benchLog.tokenField(@"result", tokenAt(@tokDRes, DRES_COUNT, eResult), TOKMAX_DRES)
    whyField(whyCode)
    emitRecord()

#endif

#ifdef DBG_FRONTST
PRI emitFrontSt(side, nPasses, nLate, nMaxTicks, nStackHi, nStackOf)
' BM-FRONTST: one front cog's loop health, with the pass time in microseconds beside the raw ticks so the
' reading does not have to be divided by a clock the reader has to look up. Worst case 174 bytes.
'
' PL-75: stack_of is now the size the OBJECT reports alongside its own mark, not a harness constant.
' It used to print D_FRONT_STACK_HI, which is a number this file holds and the object never sees, so
' the record would have kept saying 128 however much the object actually allocated -- and the two
' front cogs do not have the same allocation. A record that carries both numbers from one source
' cannot misreport a saturated mark as a healthy one.
'
' @param side - SIDE_BOTH (the steering front cog) or SIDE_LEFT (the wheel's own)
' @param nPasses - passes since launch
' @param nLate - passes that overran their slot
' @param nMaxTicks - longest pass body, in system ticks
' @param nStackHi - stack longs ever used
' @param nStackOf - the allocation that mark is measured against, from the same object

    recBegin(@"BM-FRONTST")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"passes", nPasses, LIM_BIG)
    benchLog.numField(@"late", nLate, LIM_BIG)
    benchLog.numField(@"max_ticks", nMaxTicks, LIM_BIG)
    benchLog.numField(@"max_us", nMaxTicks / TICKS_PER_US, LIM_MID)
    benchLog.numField(@"slot_us", US_PER_SEC / wheelL.FRONT_LOOP_HZ, LIM_SMALL)
    benchLog.numField(@"stack_hi", nStackHi, LIM_SMALL)
    benchLog.numField(@"stack_of", nStackOf, LIM_SMALL)
    whyField(WHY_NONE)
    emitRecord()

#endif

#ifdef DBP_D
PRI emitLimSt(side, slotIdx, stepCode, stepValue) | nPeakA, nContA, bDeratedNow, nPhaseMa, nLimitK
' BM-LIMST: one wheel's current-limit state as the step that printed it left it, plus that step's own
' number. The RESTORE rows are the ones whose peak_a and cont_a read the MOSFET values back (I11).
' Worst case 190 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param slotIdx - motor slot
' @param stepCode - DST_* the row belongs to
' @param stepValue - the printing step's number (a phase average, a derate time, or peak x10 + cont)
'
' @local nPeakA - the peak limit in force
' @local nContA - the continuous limit in force
' @local bDeratedNow - the fold-back holds the continuous limit
' @local nPhaseMa - the judged phase average, mA
' @local nLimitK - the fold-back factor

    nPeakA, nContA, bDeratedNow, nPhaseMa, nLimitK := dLimitState(slotIdx)
    recBegin(@"BM-LIMST")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"step", tokenAt(@tokDStep, DST_COUNT, stepCode), TOKMAX_DSTEP)
    benchLog.numField(@"peak_a", nPeakA, LIM_SMALL)
    benchLog.numField(@"cont_a", nContA, LIM_SMALL)
    benchLog.boolField(@"derated", bDeratedNow)
    benchLog.numField(@"phase_ma", nPhaseMa, LIM_BIG)
    benchLog.numField(@"limit_k", nLimitK, LIM_MID)
    benchLog.numField(@"value", stepValue, LIM_BIG)
    whyField(WHY_NONE)
    emitRecord()

#endif

PRI emitLag(side, slotIdx)
' BM-LAG: the run's largest |err| the instrument saw for one motor, with the samples behind it.
'
' THE FIELD SATURATES AT 127, which is what a driver with no lag limiter prints: the stored err is a
' signed byte and the driver's own fault test sits at 125. So a printed 127 says "the limiter did not
' hold", and the bound below says how far under the fault test it did hold.
'
' PL-78: hold and fault are printed beside max_err so the whole band is in the record and the reader
' does not have to look up either number. hold is the gate the driver applies once per drive pass
' (LAG_HOLD); fault is the test it trips (125); hi is the criterion, one below fault. A max_err between
' hold and hi is the normal state, not a near-miss. Worst case 174 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param slotIdx - motor slot

    recBegin(@"BM-LAG")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"part", tokenAt(@tokPart, PART_COUNT, PART_ID), TOKMAX_PART)
    benchLog.naNumField(@"max_err", instLagMax[slotIdx], LIM_SMALL, instLagN[slotIdx] > 0)
    benchLog.numField(@"samples", instLagN[slotIdx], LIM_BIG)
    benchLog.numField(@"lo", LAG_MAX_LO, LIM_SMALL)
    benchLog.numField(@"hi", LAG_MAX_HI, LIM_SMALL)
    benchLog.numField(@"hold", LAG_HOLD_REF, LIM_SMALL)
    benchLog.numField(@"fault", LAG_FAULT_TEST, LIM_SMALL)
    benchLog.numField(@"sat", FIELD_ERR_MAX, LIM_SMALL)
    whyField((instLagN[slotIdx] > 0) ? WHY_NONE : WHY_NO_SAMPLES)
    emitRecord()

PRI emitLagAll() | slotIdx
' One BM-LAG per motor, on cog 0's end path, after every capture this part took.
'
' @local slotIdx - motor slot

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        emitLag(SIDE_LEFT + slotIdx, slotIdx)

#ifdef DBP_B
PRI emitStopCur(tid, side, slotIdx)
' BM-STOPCUR: what a stop FROM SPEED costs in current, against what holding that speed cost.
'
' The claim (task 3558) is that a commanded stop does not surge -- the surge tripped the harness's own
' 10 A abort at Visit 2 (PL-55). Every number comes from the same frozen capture, so they are the same
' instrument and the same scale.
'
' PL-82: bound_mV IS THE CRITERION and hold_pk_mV is the comparison a reader makes. The old criterion was
' stop_pk against hold_mV_x10, which is a peak against a mean AND against a reference that drifts about
' 25 % as the motor warms -- so it failed on the reference. hold_mV_x10 is kept precisely because the
' drift is visible in it. Worst case 210 bytes.
'
' @param tid - trace id of the trial
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param slotIdx - motor slot

    recBegin(@"BM-STOPCUR")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.naNumField(@"hold_mV_x10", scHoldIX10[slotIdx], LIM_BIG, bScValid[slotIdx])
    benchLog.naNumField(@"hold_pk_mV", scHoldPk[slotIdx], LIM_MID, bScValid[slotIdx])
    benchLog.naNumField(@"stop_pk_mV", scStopPk[slotIdx], LIM_MID, bScValid[slotIdx])
    benchLog.numField(@"samples", scSamples[slotIdx], LIM_SMALL)
    benchLog.numField(@"bound_mV", STOPCUR_BOUND_MV, LIM_SMALL)
    benchLog.numField(@"abort_mV", ABS_ABORT_MV, LIM_SMALL)
    whyField(bScValid[slotIdx] ? WHY_NONE : WHY_NO_SAMPLES)
    emitRecord()

#endif

#ifdef DBG_OVERSHT
PRI emitDistM(tid, sid, tickMmX100)
' BM-DISTM: the steering object's getDistance(DDU_M) against the ticks it is derived from.
'
' Visit 3 left DDU_M unqualified: task 3502 corrected the metre conversion, and no bench reading has
' compared the two since. l_ticks / r_ticks are THE TICK COUNTS THE GETTER SAW, read in the same place
' and at the same moment as l_m / r_m (PL-77) -- so the comparison really is of the conversion alone,
' and a disagreement names a conversion fault instead of two reads taken moments apart.
'
' PL-84: mm_x100 is the MOTOR object's travel-per-tick and str_mm_x100 is the STEERING object's own
' copy, which every distance it reports or accepts is scaled by. They are equal by construction --
' start() sets the second from the first -- so a difference is a corrupted copy, and until this field
' existed the record showed the healthy one while the steering used something else entirely. Worst case
' 215 bytes.
'
' @param tid - trace id of the trial
' @param sid - the steering start's life
' @param tickMmX100 - wheel travel per hall tick in hundredths of a mm, from the library's own geometry

    recBegin(@"BM-DISTM")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.numField(@"sid", sid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(SIDE_BOTH), TOKMAX_MOTOR)
    benchLog.numField(@"l_ticks", dmLeftTicks, LIM_MID)
    benchLog.numField(@"r_ticks", dmRightTicks, LIM_MID)
    benchLog.numField(@"l_m", dmLeftM, LIM_SMALL)
    benchLog.numField(@"r_m", dmRightM, LIM_SMALL)
    benchLog.numField(@"l_pred_m", dmLeftPredM, LIM_SMALL)
    benchLog.numField(@"r_pred_m", dmRightPredM, LIM_SMALL)
    benchLog.numField(@"mm_x100", tickMmX100, LIM_SMALL)
    benchLog.numField(@"str_mm_x100", dmSteerMmX100, LIM_BIG)
    benchLog.boolField(@"agree", bSfDistMOk)
    whyField(bSfDistMRan ? WHY_NONE : WHY_NO_SAMPLES)
    emitRecord()

#endif

#ifdef DBP_FLOOR
PRI emitFloor(tid, sid, runMs, answerCode, inputCode, leftRateX10, rightRateX10, bRatesValid, slowerCode, stopByCode, whyCode)
' BM-FLOOR. The rates and slower print NA together when the rates were not measured. Worst case 219 bytes.
'
' @param tid - trace id
' @param sid - the steering start's life
' @param runMs - ms driven
' @param answerCode - ANS_* value
' @param inputCode - INPUT_* value
' @param leftRateX10 - left ticks per second x10 over the run
' @param rightRateX10 - right ticks per second x10 over the run
' @param bRatesValid - TRUE when the rates (and so slower) are measurements
' @param slowerCode - SLOWER_* value
' @param stopByCode - STOPBY_* value
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-FLOOR")
    benchLog.numField(@"tid", tid, LIM_SMALL)
    benchLog.numField(@"sid", sid, LIM_SMALL)
    benchLog.tokenField(@"motor", sideToken(SIDE_BOTH), TOKMAX_MOTOR)
    benchLog.numField(@"power", FLOOR_POWER, LIM_TINY)
    benchLog.numField(@"dir", FLOOR_DIRECTION, LIM_TINY)
    benchLog.numField(@"run_ms", runMs, LIM_SMALL)
    benchLog.tokenField(@"answer", tokenAt(@tokAns, ANS_COUNT, answerCode), TOKMAX_ANSWER)
    benchLog.tokenField(@"input", tokenAt(@tokInput, INPUT_COUNT, inputCode), TOKMAX_INPUT)
    benchLog.naNumField(@"l_rate_x10", leftRateX10, LIM_MID, bRatesValid)
    benchLog.naNumField(@"r_rate_x10", rightRateX10, LIM_MID, bRatesValid)
    if bRatesValid
        benchLog.tokenField(@"slower", tokenAt(@tokSlower, SLOWER_COUNT, slowerCode), TOKMAX_SLOWER)
    else
        benchLog.textField(@"slower", @sSfNa)
    benchLog.tokenField(@"stop_by", tokenAt(@tokStopBy, STOPBY_COUNT, stopByCode), TOKMAX_STOPBY)
    whyField(whyCode)
    emitRecord()

#endif

#ifdef DBP_UICHECK
PRI emitUiStep(kindCode, testedIdx, gotIdx, bKeyGot, bClickGot, promptIdx, resultCode, waitedMs)
' BM-UISTEP: one UICHECK step, what was shown and what arrived. tested is the one live button a control step
' checks (NA on a screen step); got is the button a screen step received (NA otherwise, or when none did);
' key and click say whether that input arrived; press_x / press_y are the last left-button press of the step
' exactly as PC_MOUSE reported it, NA when there was none (click FALSE then says why). Worst case: tag(9) +
' seq(15) + step(10) + kind(13) + tested(16) + got(13) + key(10) + click(12) + press_x(19) + press_y(19) +
' prompt(12) + result(15) + wait_ms(19) + why(23) = 205 bytes.
'
' @param kindCode - UIK_* value
' @param testedIdx - BM_BTN_* under test, PNL_BTN_NONE on a screen step
' @param gotIdx - BM_BTN_* a screen step received, PNL_BTN_NONE otherwise
' @param bKeyGot - the step's button arrived as a key
' @param bClickGot - the step's button arrived as a mouse click
' @param promptIdx - BM_SCR_* on screen, whose prompt cell has the same index
' @param resultCode - UIR_* value
' @param waitedMs - ms the step took

    uiStepCount := (uiStepCount + 1) <# LIM_SMALL
    recBegin(@"BM-UISTEP")
    benchLog.numField(@"step", uiStepCount, LIM_TINY)
    benchLog.tokenField(@"kind", tokenAt(@tokUiKind, UIK_COUNT, kindCode), TOKMAX_UIKIND)
    uiButtonField(@"tested", testedIdx)
    uiButtonField(@"got", gotIdx)
    benchLog.boolField(@"key", bKeyGot)
    benchLog.boolField(@"click", bClickGot)
    benchLog.naNumField(@"press_x", uiPressX, LIM_MID, bUiPressSeen)
    benchLog.naNumField(@"press_y", uiPressY, LIM_MID, bUiPressSeen)
    benchLog.numField(@"prompt", promptIdx, LIM_TINY)
    benchLog.tokenField(@"result", tokenAt(@tokUiRes, UIR_COUNT, resultCode), TOKMAX_UIRES)
    benchLog.numField(@"wait_ms", waitedMs, LIM_MID)
    whyField(lookupz(resultCode: WHY_NONE, WHY_OPERATOR_SKIP, WHY_OPERATOR_TIMEOUT))
    emitRecord()

PRI uiButtonField(pName, btnIdx)
' Append a button field: its token, or NA when no button applies.
'
' @param pName - pointer to the field name
' @param btnIdx - BM_BTN_* value, PNL_BTN_NONE for none

    if (btnIdx >= 0) and (btnIdx < BM_BTN_COUNT)
        benchLog.tokenField(pName, tokenAt(@tokButton, BM_BTN_COUNT, btnIdx), TOKMAX_BUTTON)
    else
        benchLog.textField(pName, @sSfNa)

#endif

#ifdef DBG_PANEL
PRI emitOper(promptCode, eventCode, answerCode, inputCode, waitedMs, whyCode)
' BM-OPER: what the operator was shown and did. Worst case 125 bytes.
'
' @param promptCode - PROMPT_* value
' @param eventCode - OPEV_* value
' @param answerCode - ANS_* value
' @param inputCode - INPUT_* value
' @param waitedMs - ms since the prompt was shown
' @param whyCode - WHY_* value

    recBegin(@"BM-OPER")
    benchLog.tokenField(@"prompt", tokenAt(@tokPrompt, PROMPT_COUNT, promptCode), TOKMAX_PROMPT)
    benchLog.tokenField(@"event", tokenAt(@tokOpEv, OPEV_COUNT, eventCode), TOKMAX_OPEREV)
    benchLog.tokenField(@"answer", tokenAt(@tokAns, ANS_COUNT, answerCode), TOKMAX_ANSWER)
    benchLog.tokenField(@"input", tokenAt(@tokInput, INPUT_COUNT, inputCode), TOKMAX_INPUT)
    benchLog.numField(@"wait_ms", waitedMs, LIM_MID)
    whyField(whyCode)
    emitRecord()

#endif

PRI emitSeg(seg, eventCode, bAttended, itemCount, faultCount, unrecovCount, elapsedMs, whyCode)
' BM-SEG. Worst case 140 bytes.
'
' @param seg - SEG_* value
' @param eventCode - SEGEV_* value
' @param bAttended - the segment needs a person
' @param itemCount - trials, rungs or traces done
' @param faultCount - faults in the segment
' @param unrecovCount - motors retired in the segment
' @param elapsedMs - segment duration
' @param whyCode - WHY_* value

    recBegin(@"BM-SEG")
    benchLog.tokenField(@"seg", segToken(seg), TOKMAX_SEG)
    benchLog.tokenField(@"event", tokenAt(@tokSegEv, SEGEV_COUNT, eventCode), TOKMAX_SEGEV)
    benchLog.boolField(@"attended", bAttended)
    benchLog.numField(@"items", itemCount, LIM_SMALL)
    benchLog.numField(@"faults", faultCount, LIM_SMALL)
    benchLog.numField(@"unrecov", unrecovCount, LIM_TINY)
    benchLog.numField(@"ms", elapsedMs, LIM_MID)
    whyField(whyCode)
    emitRecord()

#ifdef DBG_PREFLT
PRI emitPreflt(side, motorIncre, ticksMoved, hwMoved, bMeasured, whyCode)
' BM-PREFLT. Worst case 124 bytes.
'
' @param side - SIDE_LEFT or SIDE_RIGHT
' @param motorIncre - the nudge increment
' @param ticksMoved - driver pos delta
' @param hwMoved - hwPos delta
' @param bMeasured - the deltas are measurements
' @param whyCode - WHY_* naming the cause of every NA

    recBegin(@"BM-PREFLT")
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.numField(@"incre", motorIncre, LIM_BIG)
    benchLog.naNumField(@"ticks", ticksMoved, LIM_SMALL, bMeasured)
    benchLog.naNumField(@"hw_ticks", hwMoved, LIM_MID, bMeasured)
    benchLog.boolField(@"moved", bMeasured and (ticksMoved <> 0))
    whyField(bMeasured ? WHY_NONE : whyCode)
    emitRecord()

#endif

PRI emitTrap(trapCode, bReturned)
' BM-TRAP: the one top-level trap's value, every run (I9). Worst case 55 bytes.
'
' @param trapCode - the value \runPart() delivered
' @param bReturned - runPart() reached its end

    recBegin(@"BM-TRAP")
    benchLog.numField(@"code", trapCode, LIM_BIG)
    benchLog.boolField(@"returned", bReturned)
    emitRecord()

PRI emitEnd(exitCode)
' BM-END: the last record before the marker; records is the seq this record carries (I8).
' Worst case 152 bytes.
'
' @param exitCode - EXIT_* value

    recBegin(@"BM-END")
    benchLog.tokenField(@"exit", tokenAt(@tokExit, EXIT_COUNT, exitCode), TOKMAX_EXIT)
    benchLog.tokenField(@"part", tokenAt(@tokPart, PART_COUNT, PART_ID), TOKMAX_PART)
    benchLog.numField(@"segs", segsRun, LIM_TINY)
    benchLog.tokenField(@"last_seg", segToken(lastSeg), TOKMAX_SEG)
    benchLog.numField(@"records", logSeq, LIM_MID)
    benchLog.numField(@"trap_code", runTrapCode, LIM_BIG)
    benchLog.numField(@"unrecov", unrecovTotal, LIM_TINY)
    whyField(WHY_NONE)
    emitRecord()

CON { --- sign-off verdicts (design sec 5.2; record contract VISIT-SIGNOFF-DESIGN.md sec B.1) --- }

PRI partNoStallCell() : pCell
' This part's R14-DUAL-NOSTALL-* cell id, and for the CLOCK part this clock's (shared by cog 0 and the
' watchdog; reads only DAT).
'
' @returns pCell - pointer to the cell id, "?" for PART_NONE and for a CLOCK build at an unswept clock

    case PART_ID
        PART_A:
            pCell := @sSfCellNoStallA
        PART_CLOCK:
            pCell := clockCell(@sSfCellNoStallK200, @sSfCellNoStallK270, @sSfCellNoStallK300)
        PART_B:
            pCell := @sSfCellNoStallB
        PART_BRAKE:
            pCell := @sSfCellNoStallH
        PART_C:
            pCell := @sSfCellNoStallC
        PART_D:
            pCell := @sSfCellNoStallD
        PART_FLOOR:
            pCell := @sSfCellNoStallF
        PART_UICHECK:
            pCell := @sSfCellNoStallU
        PART_ALIGN:
            pCell := @sSfCellNoStallZ
        PART_LEAD:
            pCell := @sSfCellNoStallL
        PART_LIMITS:
            pCell := @sSfCellNoStallM
        PART_FAULTRESP:
            pCell := @sSfCellNoStallX
        PART_START:
            pCell := @sSfCellNoStallS
        PART_SPIN:
            pCell := @sSfCellNoStallP
        PART_PACK:
            pCell := @sSfCellNoStallV
        PART_REG:
            pCell := @sSfCellNoStallR
        PART_KICK:
            pCell := @sSfCellNoStallT
        other:
            pCell := @sUnknownTok

PRI partDbgMaskCell() : pCell
' This part's R14-DUAL-DBGMASK-* cell id, and for the CLOCK part this clock's.
'
' @returns pCell - pointer to the cell id, "?" for PART_NONE and for a CLOCK build at an unswept clock

    case PART_ID
        PART_A:
            pCell := @sSfCellDbgMaskA
        PART_CLOCK:
            pCell := clockCell(@sSfCellDbgMaskK200, @sSfCellDbgMaskK270, @sSfCellDbgMaskK300)
        PART_B:
            pCell := @sSfCellDbgMaskB
        PART_BRAKE:
            pCell := @sSfCellDbgMaskH
        PART_C:
            pCell := @sSfCellDbgMaskC
        PART_D:
            pCell := @sSfCellDbgMaskD
        PART_FLOOR:
            pCell := @sSfCellDbgMaskF
        PART_UICHECK:
            pCell := @sSfCellDbgMaskU
        PART_ALIGN:
            pCell := @sSfCellDbgMaskZ
        PART_LEAD:
            pCell := @sSfCellDbgMaskL
        PART_LIMITS:
            pCell := @sSfCellDbgMaskM
        PART_FAULTRESP:
            pCell := @sSfCellDbgMaskX
        PART_START:
            pCell := @sSfCellDbgMaskS
        PART_SPIN:
            pCell := @sSfCellDbgMaskP
        PART_PACK:
            pCell := @sSfCellDbgMaskV
        PART_REG:
            pCell := @sSfCellDbgMaskR
        PART_KICK:
            pCell := @sSfCellDbgMaskT
        other:
            pCell := @sUnknownTok

PRI clockCell(pCell200, pCell270, pCell300) : pCell
' The compiled clock's cell id, chosen from a cell's three per-clock ids by SF_CLOCK_SLOT (design sec 12.10;
' reads only DAT, so it is safe from any cog).
'
' @param pCell200 - pointer to the cell's 200 MHz id
' @param pCell270 - pointer to the cell's 270 MHz id
' @param pCell300 - pointer to the cell's 300 MHz id
' @returns pCell - pointer to this clock's id, "?" at an unswept clock

    case SF_CLOCK_SLOT
        SF_CLOCK_200:
            pCell := pCell200
        SF_CLOCK_270:
            pCell := pCell270
        SF_CLOCK_300:
            pCell := pCell300
        other:
            pCell := @sUnknownTok

PRI emitSignoffDecls()
' One SIGNOFF-DECL per cell this build judges, before anything moves. A build that judges no cell (PART_NONE,
' or a CLOCK build at an unswept clock: SF_JUDGES_CELLS) declares nothing but R21-DUAL-TOKTAB, which every build declares
' and judges (SRC_REV 71: the record labels' self-check; the negative tier dual-tokneg is a PART_NONE build). Each cell id
' is a DAT string passed by @label on the emitter's own line, so the CLOCK part names each clock's labels under its
' SF_CLOCK_SLOT.
'
' PL-152: an #ifdef chain on the DBP_* symbols where this was a case on PART_ID -- the same declarations, in the same
' order, for each part. A PART_NONE build (SF_JUDGES_CELLS FALSE) compiles none of them.

    emitSignoffDecl(@sSfCellTokTab)
#ifndef DBP_NONE
    if SF_JUDGES_CELLS
#ifdef DBP_A
                emitSignoffDecl(@sSfCellNoStallA)
                emitSignoffDecl(@sSfCellDbgMaskA)
                emitSignoffDecl(@sSfCellInstLive)
                emitSignoffDecl(@sSfCellIdleFlt)
                emitSignoffDecl(@sSfCellRevB)
                emitSignoffDecl(@sSfCellInteg)
                emitSignoffDecl(@sSfCellTracesA)
                emitSignoffDecl(@sSfCellOffsets)
                emitSignoffDecl(@sSfCellInstWide)
                emitSignoffDecl(@sSfCellPhSep)
                emitSignoffDecl(@sSfCellTake)
                emitSignoffDecl(@sSfCellFolAgree)
                emitSignoffDecl(@sSfCellLagA)
                emitSignoffDecl(@sSfCellNoFold)
                emitSignoffDecl(@sSfCellRateLaw)
                emitSignoffDecl(@sSfCellSrvHunt)
                emitSignoffDecl(@sSfCellSrvKeep)
                emitSignoffDecl(@sSfCellIdleMvA)
                emitSignoffDecl(@sSfCellTrKickA)
#elseifdef DBP_CLOCK
                case SF_CLOCK_SLOT
                    SF_CLOCK_200:
                        emitSignoffDecl(@sSfCellNoStallK200)
                        emitSignoffDecl(@sSfCellDbgMaskK200)
                        emitSignoffDecl(@sSfCellClkFrameK200)
                        emitSignoffDecl(@sSfCellHallK200)
                    SF_CLOCK_270:
                        emitSignoffDecl(@sSfCellNoStallK270)
                        emitSignoffDecl(@sSfCellDbgMaskK270)
                        emitSignoffDecl(@sSfCellClkFrameK270)
                        emitSignoffDecl(@sSfCellHallK270)
                    SF_CLOCK_300:
                        emitSignoffDecl(@sSfCellNoStallK300)
                        emitSignoffDecl(@sSfCellDbgMaskK300)
                        emitSignoffDecl(@sSfCellClkFrameK300)
                        emitSignoffDecl(@sSfCellHallK300)
#elseifdef DBP_B
                emitSignoffDecl(@sSfCellNoStallB)
                emitSignoffDecl(@sSfCellDbgMaskB)
                emitSignoffDecl(@sSfCellTracesB)
                emitSignoffDecl(@sSfCellRstProvB)
                emitSignoffDecl(@sSfCellRampRest)
                emitSignoffDecl(@sSfCellFltApi)
                emitSignoffDecl(@sSfCellLagB)
                emitSignoffDecl(@sSfCellStopCur)
                emitSignoffDecl(@sSfCellRmpDroop)
                emitSignoffDecl(@sSfCellStopLim)
                emitSignoffDecl(@sSfCellTurnDist)
                emitSignoffDecl(@sSfCellDistM)
                emitSignoffDecl(@sSfCellFltRetry)
                emitSignoffDecl(@sSfCellFltCause)
                emitSignoffDecl(@sSfCellOffRestB)
                emitSignoffDecl(@sSfCellIdleMvB)
#elseifdef DBP_BRAKE
                emitSignoffDecl(@sSfCellNoStallH)
                emitSignoffDecl(@sSfCellDbgMaskH)
                emitSignoffDecl(@sSfCellBrakeFlt)
#elseifdef DBP_C
                emitSignoffDecl(@sSfCellNoStallC)
                emitSignoffDecl(@sSfCellDbgMaskC)
                emitSignoffDecl(@sSfCellTracesC)
                emitSignoffDecl(@sSfCellRstProvC)
                emitSignoffDecl(@sSfCellOffRest)
                emitSignoffDecl(@sSfCellLagC)
                emitSignoffDecl(@sSfCellStpDecel)
                emitSignoffDecl(@sSfCellFltStop)
                emitSignoffDecl(@sSfCellIdleMvC)
#elseifdef DBP_D
                emitSignoffDecl(@sSfCellNoStallD)
                emitSignoffDecl(@sSfCellDbgMaskD)
                emitSignoffDecl(@sSfCellLagD)
                emitSignoffDecl(@sSfCellEstopD)
                emitSignoffDecl(@sSfCellOrdered)
                emitSignoffDecl(@sSfCellCoopShut)
                emitSignoffDecl(@sSfCellTrackRst)
                emitSignoffDecl(@sSfCellTimeStop)
                emitSignoffDecl(@sSfCellLockStep)
                emitSignoffDecl(@sSfCellFrontSt)
                emitSignoffDecl(@sSfCellFoldBack)
                emitSignoffDecl(@sSfCellDerate)
                emitSignoffDecl(@sSfCellBlocked)
                emitSignoffDecl(@sSfCellHoldSet)
                emitSignoffDecl(@sSfCellNotFol)
                emitSignoffDecl(@sSfCellWEstop)
                emitSignoffDecl(@sSfCellWTimStop)
                emitSignoffDecl(@sSfCellCmdTmo)
                emitSignoffDecl(@sSfCellWCmdTmo)
                emitSignoffDecl(@sSfCellDirSign)
                emitSignoffDecl(@sSfCellEvFold)             ' task 3621
                emitSignoffDecl(@sSfCellEvClim)
                emitSignoffDecl(@sSfCellEvPath)
                emitSignoffDecl(@sSfCellPathHunt)           ' PL-144
                emitSignoffDecl(@sSfCellEvLate)
                emitSignoffDecl(@sSfCellRestCst)            ' task 3623
#elseifdef DBP_FLOOR
                emitSignoffDecl(@sSfCellNoStallF)
                emitSignoffDecl(@sSfCellDbgMaskF)
                emitSignoffDecl(@sSfCellFloorAns)
#elseifdef DBP_UICHECK
                emitSignoffDecl(@sSfCellNoStallU)
                emitSignoffDecl(@sSfCellDbgMaskU)
                emitSignoffDecl(@sSfCellUiCheck)
#elseifdef DBP_ALIGN
                emitSignoffDecl(@sSfCellNoStallZ)
                emitSignoffDecl(@sSfCellDbgMaskZ)
                emitSignoffDecl(@sSfCellAgNoDrv)
                emitSignoffDecl(@sSfCellAgClip)
                emitSignoffDecl(@sSfCellAgCover)
                emitSignoffDecl(@sSfCellAgRes)
                emitSignoffDecl(@sSfCellAgMatrix)
#elseifdef DBP_LEAD
                emitSignoffDecl(@sSfCellNoStallL)
                emitSignoffDecl(@sSfCellDbgMaskL)
                emitSignoffDecl(@sSfCellLeadBrkt)
#elseifdef DBP_LIMITS
                emitSignoffDecl(@sSfCellNoStallM)
                emitSignoffDecl(@sSfCellDbgMaskM)
                emitSignoffDecl(@sSfCellTracesM)
                emitSignoffDecl(@sSfCellTopSpd)
                emitSignoffDecl(@sSfCellPwmClip)
                emitSignoffDecl(@sSfCellPowerMap)
                emitSignoffDecl(@sSfCellFollowM)
                emitSignoffDecl(@sSfCellFolFall)
                emitSignoffDecl(@sSfCellOvrStep)            ' SRC_REV 81 (task 3668): the over-command's full-power step completes
#elseifdef DBP_FAULTRESP
                emitSignoffDecl(@sSfCellNoStallX)
                emitSignoffDecl(@sSfCellDbgMaskX)
                emitSignoffDecl(@sSfCellTracesX)
                emitSignoffDecl(@sSfCellHookRest)
                emitSignoffDecl(@sSfCellForced)
                emitSignoffDecl(@sSfCellRstProvX)
                emitSignoffDecl(@sSfCellBlunt)
                emitSignoffDecl(@sSfCellGraded)
                emitSignoffDecl(@sSfCellGrd100)
                emitSignoffDecl(@sSfCellFrRest)
                emitSignoffDecl(@sSfCellRestFlat)
                emitSignoffDecl(@sSfCellCoastEmf)
                emitSignoffDecl(@sSfCellShortTk)
                emitSignoffDecl(@sSfCellShortI)
                emitSignoffDecl(@sSfCellResync)
                emitSignoffDecl(@sSfCellPlatStop)
                emitSignoffDecl(@sSfCellB4Pulse)
                emitSignoffDecl(@sSfCellSrFault)            ' task 3621
                emitSignoffDecl(@sSfCellSrLost)
                emitSignoffDecl(@sSfCellSrPart)
                emitSignoffDecl(@sSfCellFrontEv)
                emitSignoffDecl(@sSfCellEvLate)
#elseifdef DBP_START
                emitSignoffDecl(@sSfCellNoStallS)
                emitSignoffDecl(@sSfCellDbgMaskS)
                emitSignoffDecl(@sSfCellSkHealth)
                emitSignoffDecl(@sSfCellSkRz)
                emitSignoffDecl(@sSfCellSkPrbFlr)
                emitSignoffDecl(@sSfCellSkProbe)
                emitSignoffDecl(@sSfCellSkWalk)
                emitSignoffDecl(@sSfCellSkPack)
                if BUILD_NEG == SKNEG_PHASE                 ' task 3614: each negative's cell in its own build only
                    emitSignoffDecl(@sSfCellSkPhNeg)
                elseif BUILD_NEG == SKNEG_SWAP
                    emitSignoffDecl(@sSfCellSkSwNeg)
                if BUILD_WIND == SKWIND_POS                 ' task 3610: the winding cells, likewise
                    emitSignoffDecl(@sSfCellSkWindR)
                    emitSignoffDecl(@sSfCellSkWindSp)
                    emitSignoffDecl(@sSfCellWindV)          ' R20.4
                elseif BUILD_WIND == SKWIND_NEG
                    emitSignoffDecl(@sSfCellSkWindNg)
                if BUILD_NEG == SKNEG_PHASE                 ' task 3621: the reporting cells, each in its own build
                    emitSignoffDecl(@sSfCellRefuse)
                    emitSignoffDecl(@sSfCellOptOut)
                    emitSignoffDecl(@sSfCellRetry)
                elseif BUILD_START_POS
                    emitSignoffDecl(@sSfCellNoRefuse)
                    emitSignoffDecl(@sSfCellRetry)
                    emitSignoffDecl(@sSfCellEvGuard)
                    emitSignoffDecl(@sSfCellEvMiss)
                    emitSignoffDecl(@sSfCellPackEv)
                elseif BUILD_NEG == SKNEG_SWAP
                    emitSignoffDecl(@sSfCellEvGuard)
                    emitSignoffDecl(@sSfCellEvMiss)
                elseif BUILD_START_B1
                    emitSignoffDecl(@sSfCellEvIll)
#elseifdef DBP_SPIN
                emitSignoffDecl(@sSfCellNoStallP)
                emitSignoffDecl(@sSfCellDbgMaskP)
                emitSignoffDecl(@sSfCellTracesP)
                emitSignoffDecl(@sSfCellRstProvP)
                emitSignoffDecl(@sSfCellLagP)
                emitSignoffDecl(@sSfCellSpStop)
                emitSignoffDecl(@sSfCellSpOff)
                emitSignoffDecl(@sSfCellSpDir)
                emitSignoffDecl(@sSfCellSpHunt)
                emitSignoffDecl(@sSfCellSpErr)
                emitSignoffDecl(@sSfCellSpStrt)
                emitSignoffDecl(@sSfCellSpPeak)
                emitSignoffDecl(@sSfCellSpFol)
                emitSignoffDecl(@sSfCellSpSym)
                emitSignoffDecl(@sSfCellSpCtl)
                emitSignoffDecl(@sSfCellSpLead)
                emitSignoffDecl(@sSfCellSpPlat)
                emitSignoffDecl(@sSfCellCrCoast)
                emitSignoffDecl(@sSfCellCrLow)
                emitSignoffDecl(@sSfCellCreep)
                emitSignoffDecl(@sSfCellCrHold)
                emitSignoffDecl(@sSfCellPostFlt)            ' SRC_REV 58: the floor run's load cells
                emitSignoffDecl(@sSfCellBlkStop)
                emitSignoffDecl(@sSfCellProtClr)
                emitSignoffDecl(@sSfCellBlkCoast)
                emitSignoffDecl(@sSfCellBlkShort)
                emitSignoffDecl(@sSfCellHeldAtSp)
                emitSignoffDecl(@sSfCellLdPath)
                emitSignoffDecl(@sSfCellLdHunt)             ' SRC_REV 62: PL-144's no-hunting half, on GRAB
                emitSignoffDecl(@sSfCellLdHold)
                emitSignoffDecl(@sSfCellSpRate)             ' SRC_REV 75 (task 3657): the hold-speed fix's floor cells
                emitSignoffDecl(@sSfCellSpHold)
                emitSignoffDecl(@sSfCellLimGive)
                emitSignoffDecl(@sSfCellRampArr)
                emitSignoffDecl(@sSfCellBlkLimit)
                emitSignoffDecl(@sSfCellBlkWin)             ' SRC_REV 77 (task 3662): the blocked-wheel stop's two new cells
                emitSignoffDecl(@sSfCellBlkFlt)
                emitSignoffDecl(@sSfCellLdFlt)              ' SRC_REV 81 (task 3668): the grab does not fault a wheel
#elseifdef DBP_PACK
                emitSignoffDecl(@sSfCellNoStallV)
                emitSignoffDecl(@sSfCellDbgMaskV)
                emitSignoffDecl(@sSfCellPkMeter)
                emitSignoffDecl(@sSfCellPkAbsent)
                emitSignoffDecl(@sSfCellPackEv)
#elseifdef DBP_REG
                emitSignoffDecl(@sSfCellNoStallR)           ' SRC_REV 54 (PL-151): the pointed regression part
                emitSignoffDecl(@sSfCellDbgMaskR)
                emitSignoffDecl(@sSfCellTurnDist)           ' part B's cells, the same claims, now certified here
                emitSignoffDecl(@sSfCellFltCause)
                emitSignoffDecl(@sSfCellFltRetry)
#elseifdef DBP_KICK
                emitSignoffDecl(@sSfCellNoStallT)           ' SRC_REV 54 (PL-78 / PL-87): the pointed kick part
                emitSignoffDecl(@sSfCellDbgMaskT)
                emitSignoffDecl(@sSfCellTrKickT)
#endif
#endif

PRI emitSignoffDecl(pCell)
' SIGNOFF-DECL for one cell: sf, bin, cell, task only (no seq: the collation reads exactly these
' fields). Worst case: tag(12) + sf(8) + bin(11) + cell(28) + task(11) = 70 bytes.
'
' @param pCell - pointer to the cell id

    benchLog.begin(@"SIGNOFF-DECL")
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.tokenField(@"bin", @sSfBin, TOKMAX_BIN)
    benchLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    benchLog.tokenField(@"task", @sSfTask, TOKMAX_TASK)
    emitRecord()

PRI emitSignoffs() | slotIdx, side
' Every declared cell's SIGNOFF instances, once, on cog 0's end path after the wheels, the steering
' object and the instrument are stopped. A build that judges no cell (SF_JUDGES_CELLS FALSE) emits none but TOKTAB.
' A cell whose segment did not run prints NOMEAS, measured NA, n 0. Every build, PART_NONE's included, first prints
' TOKTAB BOOL (R21-DUAL-TOKTAB, SRC_REV 71: the record labels' self-check, n the tables walked). Per part:
'  A      NOSTALL BOOL; DBGMASK BOOL; INSTLIVE BOOL per motor; IDLEFLT / REVB / INTEG COUNT per motor;
'         NOFOLD / RATELAW BOOL per motor; IDLEMOVE-A and TRKICK COUNT per motor; TRACES COUNT; LAGBOUND
'         COUNT per motor
'  CLOCK  this clock's NOSTALL BOOL, DBGMASK BOOL, and CLKFRAME BOOL and HALL COUNT per motor (-K200 /
'         -K270 / -K300)
'  B      NOSTALL BOOL; DBGMASK BOOL; TRACES COUNT; RSTPROV COUNT per motor; RAMPREST BOOL per motor;
'         FLTAPI BOOL (the steering object, BOTH); FLTCAUSE BOOL (BOTH); OFFREST-B BOOL and IDLEMOVE-B COUNT
'         per motor; STOPLIM and TURNDIST COUNT (BOTH); DISTM BOOL (BOTH)
'  D      NOSTALL BOOL; DBGMASK BOOL; LAGBOUND COUNT per motor; each part-D step's cell, DIRSIGN among them,
'         and RESTCOAST PCT per motor (emitDStepCells())
'  BRAKE  NOSTALL BOOL; DBGMASK BOOL; BRAKEFLT BOOL (LEFT)
'  C      NOSTALL BOOL; DBGMASK BOOL; TRACES COUNT; RSTPROV COUNT per motor; OFFREST BOOL per motor;
'         IDLEMOVE-C COUNT and FLTSTOP BOOL per motor
'  FLOOR  NOSTALL BOOL; DBGMASK BOOL; FLOORANS BOOL
'  UI     NOSTALL BOOL; DBGMASK BOOL; UICHECK BOOL (every BM-UISTEP OK)
'  ALIGN  NOSTALL BOOL; DBGMASK BOOL; ALIGN-ND MV (the no-drive invariant), ALIGN-CLIP / -COVER / -RES
'         COUNT (the three that can disqualify a reading), ALIGN-MTRX BOOL (all four wheel x direction)
'  LEAD   NOSTALL BOOL; DBGMASK BOOL; LEAD-BRKT COUNT per motor
'  LIMITS NOSTALL BOOL; DBGMASK BOOL; TRACES COUNT; TOPSPD INCR_E6 and PWMCLIP PWM_CNT per motor; SRC_REV 81: OVRSTEP BOOL per motor
'  FRESP  NOSTALL BOOL; DBGMASK BOOL; TRACES COUNT; per motor HOOKREST and RESYNC BOOL, FORCED, RSTPROV, BLUNT,
'         GRADED, GRD100, FRREST, RESTFLAT, COASTEMF, SHORTTK and SHORTI COUNT, PLATSTOP PCT (the wheel that was NOT
'         faulted); B4PULSE NOT_BUILT (emitFaultRespCells())
'  START  NOSTALL BOOL; DBGMASK BOOL; per motor HEALTH, RZSPREAD, PROBE and WALK COUNT (WALK NOT_BUILT in the
'         START_NO_WALK build) and PRBFLR MV, the control before the probe; PACK COUNT; PHNEG COUNT (LEFT, the
'         START_NEG_PHASE build only) or SWNEG COUNT (LEFT, the START_NEG_SWAP build only); WINDR and WINDSPR COUNT
'         per motor (dual-start only) or WINDNEG COUNT (LEFT, START_NEG_PHASE only); task 3621's reporting cells, COUNT,
'         each in its own build (emitStartCells())
'  D and FRESP also carry task 3621's reporting cells (emitDEvCells(), emitFaultRespCells())
'  SPIN   NOSTALL BOOL; DBGMASK BOOL; TRACES COUNT; SPINSTOP, SPINOFF, SPINDIR COUNT and CRPCOAST, CRPLOW TICKS (BOTH);
'         per motor RSTPROV, SPINHUNT, SPINERR COUNT, SPINSTRT PERMILLE, SPINPEAK, SPINSYM, SPINCTL, SPINLEAD X100,
'         SPINFOL COUNT, CREEP TICKS, CRPHOLD BOOL; SPINPLAT PCT on the wheel FAULTRUN does not fault; LAGBOUND COUNT per
'         motor (emitSpinCells()); SRC_REV 75: SPINRATE PCT and SPINHOLD COUNT per motor, LIMGIVE and RAMPARR COUNT (BOTH),
'         BLKLIMIT BOOL (BOTH); SRC_REV 77: BLKWIN and BLKFLT BOOL (BOTH); SRC_REV 81: LDFLT BOOL (BOTH); SRC_REV 58/62: POSTFLT X100 per motor; BLKSTOP, PROTCLR, HELDATSPD COUNT (BOTH);
'         BLKSHORT and BLKCOAST MV per motor; LDPATH PERMILLE, LDHUNT COUNT (BOTH); LDHOLD MS per motor (emitLoadCells())
'  PACK   NOSTALL BOOL; DBGMASK BOOL; METER MV twice (CAL_POINT_MV, SECOND_POINT_MV), ABSENT COUNT, EV COUNT twice
'         (PACK_STEADY_NO_EV, PACK_UNPLUG_EV); every pack cell NOT_BUILT when unfitted (emitPackCells())
'
' @local slotIdx - motor slot
' @local side - SIDE_LEFT or SIDE_RIGHT

    beat(CP_EMIT)
    ' SRC_REV 71: the record labels' self-check, in every build -- PART_NONE's too, the one the negative tier dual-tokneg is.
    '  Measured always: tokenTablesSelfTest() ran before anything else in the run (emitHeaderRecords()). n is the tables walked
    emitSignoffBool(@sSfCellTokTab, SIDE_NONE, @sSfCritTokTab, TRUE, bSfTokTabOk, sfTokTabN)
    if SF_JUDGES_CELLS
        emitSignoffBool(partNoStallCell(), SIDE_NONE, @sSfCritCog0End, TRUE, TRUE, SIGNOFF_ONE_INSTANCE)
        emitSignoffBool(partDbgMaskCell(), SIDE_NONE, @sSfCritQuiet, TRUE, bQuietMasks, SIGNOFF_ONE_INSTANCE)
        ' PL-152: an #ifdef chain on the DBP_* symbols where this was a case on PART_ID -- the same verdicts, in the
        '  same order, for each part
#ifdef DBP_A
                repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                    side := SIDE_LEFT + slotIdx
                    emitSignoffBool(@sSfCellInstLive, side, @sSfCritInstLive, bSfLiveRan[slotIdx], bSfLiveOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    emitSignoff(@sSfCellIdleFlt, side, @sSfCritIdleUp, sfFrameCaps[slotIdx] > 0, sfIdleUp[slotIdx], IDLE_UP_LO, IDLE_UP_HI, sfFrameCaps[slotIdx], @sSfUnitsCount)
                    emitSignoff(@sSfCellRevB, side, @sSfCritNotRevB, sfStarts[slotIdx] > 0, sfNotRevb[slotIdx], NOT_REVB_LO, NOT_REVB_HI, sfStarts[slotIdx], @sSfUnitsCount)
                    emitSignoff(@sSfCellInteg, side, @sSfCritInteg, sfStarts[slotIdx] > 0, sfIntegSum[slotIdx], INTEG_SUM_LO, INTEG_SUM_HI, sfStarts[slotIdx] + sfIntegN[slotIdx], @sSfUnitsCount)
                    emitSignoffBool(@sSfCellNoFold, side, @sSfCritNoFold, bSfNoFoldRan[slotIdx], bSfNoFoldOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    emitSignoffBool(@sSfCellRateLaw, side, @sSfCritRateLaw, bSfRateLawRan[slotIdx], bSfRateLawOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    ' SRC_REV 73 (task 3654): A-3 and A-5; NOMEAS unless both directions gave a judged window
                    emitSignoffBool(@sSfCellSrvHunt, side, @sSfCritSrvHunt, srvHuntSigns[slotIdx] == SIGN_MASK_BOTH, bSfSrvHuntOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    emitSignoffBool(@sSfCellSrvKeep, side, @sSfCritSrvKeep, srvKeepSigns[slotIdx] == SIGN_MASK_BOTH, bSfSrvKeepOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    emitIdleMoveCell(@sSfCellIdleMvA, slotIdx)
                    ' task 3573: NOMEAS when no start from rest gave a control, or no running-speed change was judged
                    emitSignoff(@sSfCellTrKickA, side, @sSfCritTrKick, sfTrN[slotIdx] > 0, sfTrKickPk[slotIdx], TRKICK_LO, TRKICK_HI, sfTrN[slotIdx], @sSfUnitsMv)
                    ' task 3584 (Visit 8): A-6 and A-8's following case, from the TAKE segment
                    emitSignoffBool(@sSfCellTake, side, @sSfCritTake, bSfTakeRan[slotIdx], bSfTakeOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    emitSignoff(@sSfCellFolAgree, side, @sSfCritFolAgree, bSfFolAgreeRan[slotIdx], sfFolAgreeDiff[slotIdx], FOLAGREE_LO, FOLAGREE_HI, SIGNOFF_ONE_INSTANCE, @sSfUnitsCount)
                emitSignoff(@sSfCellTracesA, SIDE_NONE, @sSfCritTraces, sfTraces > 0, sfTraceLost, TRACE_LOST_LO, TRACE_LOST_HI, sfTraces, @sSfUnitsCount)
                emitSignoff(@sSfCellOffsets, SIDE_NONE, @sSfCritOffsets, sfOffsetN > 0, sfOffsetBad, OFFSET_BAD_LO, OFFSET_BAD_HI, sfOffsetN, @sSfUnitsCount)
                emitSignoff(@sSfCellInstWide, SIDE_NONE, @sSfCritInstWide, instRunSamples > 0, instRunLate + instRunSkipped + instRunClamps, INSTWIDE_LO, INSTWIDE_HI, instRunSamples, @sSfUnitsCount)
                emitSignoff(@sSfCellPhSep, SIDE_NONE, @sSfCritPhSep, sfPhN > 0, sfPhSame, PHSAME_LO, PHSAME_HI, sfPhN, @sSfUnitsCount)
                emitLagCells(@sSfCellLagA)
#elseifdef DBP_CLOCK
                repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                    emitSignoffBool(clockCell(@sSfCellClkFrameK200, @sSfCellClkFrameK270, @sSfCellClkFrameK300), SIDE_LEFT + slotIdx, @sSfCritClkFrame, bSfClkRan[slotIdx], bSfClkOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    emitSignoff(clockCell(@sSfCellHallK200, @sSfCellHallK270, @sSfCellHallK300), SIDE_LEFT + slotIdx, @sSfCritHall, sfHallLives[slotIdx] > 0, sfHallIllegal[slotIdx], HALL_ILLEGAL_LO, HALL_ILLEGAL_HI, sfHallLives[slotIdx], @sSfUnitsCount)
#elseifdef DBP_B
                emitSignoff(@sSfCellTracesB, SIDE_NONE, @sSfCritTraces, sfTraces > 0, sfTraceLost, TRACE_LOST_LO, TRACE_LOST_HI, sfTraces, @sSfUnitsCount)
                repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                    side := SIDE_LEFT + slotIdx
                    emitSignoff(@sSfCellRstProvB, side, @sSfCritRstProv, sfFaults[slotIdx] > 0, sfResetUncleared[slotIdx], RESET_UNCLEAR_LO, RESET_UNCLEAR_HI, sfFaults[slotIdx], @sSfUnitsCount)
                    emitSignoffBool(@sSfCellRampRest, side, @sSfCritRampRest, bSfRampRan[slotIdx], bSfRampOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    emitSignoffBool(@sSfCellStopCur, side, @sSfCritStopCur, bSfStopCurRan[slotIdx], bSfStopCurOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    emitSignoffBool(@sSfCellRmpDroop, side, @sSfCritRmpDroop, bSfDroopRan[slotIdx], bSfDroopOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                emitSignoffBool(@sSfCellFltApi, SIDE_BOTH, @sSfCritFltApi, bSfFltApiRan, bSfFltApiOk, SIGNOFF_ONE_INSTANCE)
                emitSignoffBool(@sSfCellFltRetry, SIDE_BOTH, @sSfCritFltRetry, bSfRetryRan, bSfRetryOk, SIGNOFF_ONE_INSTANCE)
                ' task 3572: a lag fault reports FC_LAG on both wheels (S-7); measured only once the provocation faulted
                emitSignoffBool(@sSfCellFltCause, SIDE_BOTH, @sSfCritFltCause, bSfFltApiRan, (fltLeftCause == wheelL.FC_LAG) and (fltRightCause == wheelL.FC_LAG), SIGNOFF_ONE_INSTANCE)
                repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                    emitSignoffBool(@sSfCellOffRestB, SIDE_LEFT + slotIdx, @sSfCritOffRest, bSfOffRan[slotIdx], bSfOffOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    emitIdleMoveCell(@sSfCellIdleMvB, slotIdx)
                emitSignoff(@sSfCellStopLim, SIDE_BOTH, @sSfCritStopLim, sfStopLimN > 0, sfStopLimMax, STOP_LIMIT_LO, STOP_LIMIT_HI, sfStopLimN, @sSfUnitsCount)
                ' task 3577 (AB): the turn trials, judged against the same band as a straight stop
                emitSignoff(@sSfCellTurnDist, SIDE_BOTH, @sSfCritTurnDist, sfTurnN > 0, sfTurnMax, STOP_LIMIT_LO, STOP_LIMIT_HI, sfTurnN, @sSfUnitsCount)
                emitSignoffBool(@sSfCellDistM, SIDE_BOTH, @sSfCritDistM, bSfDistMRan, bSfDistMOk, SIGNOFF_ONE_INSTANCE)
                emitLagCells(@sSfCellLagB)
#elseifdef DBP_BRAKE
                emitSignoffBool(@sSfCellBrakeFlt, SIDE_LEFT, @sSfCritBrakeFlt, bSfBrakeRan, bSfBrakeSeen, SIGNOFF_ONE_INSTANCE)
#elseifdef DBP_C
                emitSignoff(@sSfCellTracesC, SIDE_NONE, @sSfCritTraces, sfTraces > 0, sfTraceLost, TRACE_LOST_LO, TRACE_LOST_HI, sfTraces, @sSfUnitsCount)
                repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
                    side := SIDE_LEFT + slotIdx
                    emitSignoff(@sSfCellRstProvC, side, @sSfCritRstProv, sfFaults[slotIdx] > 0, sfResetUncleared[slotIdx], RESET_UNCLEAR_LO, RESET_UNCLEAR_HI, sfFaults[slotIdx], @sSfUnitsCount)
                    emitSignoffBool(@sSfCellOffRest, side, @sSfCritOffRest, bSfOffRan[slotIdx], bSfOffOk[slotIdx], SIGNOFF_ONE_INSTANCE)
                    emitSignoff(@sSfCellStpDecel, side, @sSfCritStpDecel, bSfDecelRan[slotIdx], sfDecelTicks[slotIdx], DECEL_TICKS_LO, DECEL_TICKS_HI, SIGNOFF_ONE_INSTANCE, @sSfUnitsCount)
                    ' task 3572 (R17.1): measured only when both of this motor's provoked faults were captured
                    emitIdleMoveCell(@sSfCellIdleMvC, slotIdx)
                    emitSignoffBool(@sSfCellFltStop, side, @sSfCritFltStop, bSfFltStopRan[(slotIdx * MODE_COUNT) + MODE_FLOAT] and bSfFltStopRan[(slotIdx * MODE_COUNT) + MODE_BRAKE], sfFltStopTicks[(slotIdx * MODE_COUNT) + MODE_FLOAT] >= sfFltStopTicks[(slotIdx * MODE_COUNT) + MODE_BRAKE] + FLTSTOP_GAP_TICKS, SIGNOFF_ONE_INSTANCE)
                emitLagCells(@sSfCellLagC)
#elseifdef DBP_D
                emitDStepCells()
                emitLagCells(@sSfCellLagD)
#elseifdef DBP_FLOOR
                emitSignoffBool(@sSfCellFloorAns, SIDE_NONE, @sSfCritFloorAns, bSfFloorRan, bSfFloorAnswered, SIGNOFF_ONE_INSTANCE)
#elseifdef DBP_UICHECK
                emitSignoffBool(@sSfCellUiCheck, SIDE_NONE, @sSfCritUiCheck, bSfUiRan, bSfUiOk, uiStepCount)
#elseifdef DBP_ALIGN
                emitAlignCells()
#elseifdef DBP_LEAD
                emitLeadCells()
#elseifdef DBP_LIMITS
                emitLimitsCells()
#elseifdef DBP_FAULTRESP
                emitFaultRespCells()
#elseifdef DBP_START
                emitStartCells()
#elseifdef DBP_SPIN
                emitSpinCells()
                emitLoadCells()                             ' SRC_REV 58: the floor run's load cells
                emitLagCells(@sSfCellLagP)
#elseifdef DBP_PACK
                emitPackCells()
#elseifdef DBP_REG
                emitRegCells()                              ' SRC_REV 54 (PL-151)
#elseifdef DBP_KICK
                emitKickCells()                             ' SRC_REV 54 (PL-78 / PL-87)
#endif

PRI emitIdleMoveCell(pCell, slotIdx)
' IDLEMOVE (task 3572): the other wheel's largest travel over every motor-frame trace this motor was primary in.
' NOMEAS when no such trace was frozen.
'
' @param pCell - pointer to this part's IDLEMOVE cell id
' @param slotIdx - the primary motor's slot

    emitSignoff(pCell, SIDE_LEFT + slotIdx, @sSfCritIdleMove, sfIdleMoveN[slotIdx] > 0, sfIdleMoveMax[slotIdx], IDLE_MOVE_LO, IDLE_MOVE_HI, sfIdleMoveN[slotIdx], @sSfUnitsCount)

PRI emitLagCells(pCell) | slotIdx
' LAGBOUND's two instances, one per motor: the part's own cell id, judged on the instrument's running
' maximum. A part whose instrument stored no sample for a motor prints NOMEAS for it.
'
' @param pCell - pointer to this part's LAGBND cell id
'
' @local slotIdx - motor slot

    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        emitSignoff(pCell, SIDE_LEFT + slotIdx, @sSfCritLag, instLagN[slotIdx] > 0, instLagMax[slotIdx], LAG_MAX_LO, LAG_MAX_HI, instLagN[slotIdx], @sSfUnitsCount)

#ifdef DBP_D
PRI emitDStepCells() | slotIdx
' Part D's cells. The steering object's instances carry SIDE_BOTH, the single wheel's SIDE_LEFT, and the
' two forms are judged separately because they are two different shapes of the same contract.
'
' @local slotIdx - motor slot, for the per-wheel R18.4 cells

    emitSignoffBool(@sSfCellLockStep, SIDE_BOTH, @sSfCritLockStep, bSfDStepRan[DST_LOCKSTEP], bSfDStepOk[DST_LOCKSTEP], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellTrackRst, SIDE_BOTH, @sSfCritTrackRst, bSfDStepRan[DST_TRACKRESET], bSfDStepOk[DST_TRACKRESET], SIGNOFF_ONE_INSTANCE)
    ' the e-stop cell is the three claims together: a latch that refuses, holds and releases is one property
    emitSignoffBool(@sSfCellEstopD, SIDE_BOTH, @sSfCritEstopD, bDEstopRan(FALSE), bDEstopOk(FALSE), SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellOrdered, SIDE_BOTH, @sSfCritOrdered, bSfDStepRan[DST_ORDERED], bSfDStepOk[DST_ORDERED], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellTimeStop, SIDE_BOTH, @sSfCritTimeStop, bSfDStepRan[DST_TIMESTOP], bSfDStepOk[DST_TIMESTOP], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellCoopShut, SIDE_BOTH, @sSfCritCoopShut, bSfDStepRan[DST_COOPSHUT], bSfDStepOk[DST_COOPSHUT], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellFrontSt, SIDE_BOTH, @sSfCritFrontSt, bSfFrontRan[SLOT_LEFT], bSfFrontOk[SLOT_LEFT], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellFoldBack, SIDE_LEFT, @sSfCritFoldBack, bSfLimRan[SLOT_LEFT], bSfLimOk[SLOT_LEFT], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellFoldBack, SIDE_RIGHT, @sSfCritFoldBack, bSfLimRan[SLOT_RIGHT], bSfLimOk[SLOT_RIGHT], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellDerate, SIDE_LEFT, @sSfCritDerate, bSfDerateRan[SLOT_LEFT], bSfDerateOk[SLOT_LEFT], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellDerate, SIDE_RIGHT, @sSfCritDerate, bSfDerateRan[SLOT_RIGHT], bSfDerateOk[SLOT_RIGHT], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellBlocked, SIDE_BOTH, @sSfCritBlocked, bSfDStepRan[DST_BLOCKED], bSfDStepOk[DST_BLOCKED], SIGNOFF_ONE_INSTANCE)
    ' R18.4 Visit 8 (task 3584): A-7 and A-8's not-following case, per wheel, from the same stall
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        emitSignoffBool(@sSfCellHoldSet, SIDE_LEFT + slotIdx, @sSfCritHoldSet, bSfHoldSetRan[slotIdx], bSfHoldSetOk[slotIdx], SIGNOFF_ONE_INSTANCE)
        emitSignoffBool(@sSfCellNotFol, SIDE_LEFT + slotIdx, @sSfCritNotFol, bSfNotFolRan[slotIdx], bSfNotFolOk[slotIdx], SIGNOFF_ONE_INSTANCE)
    ' the single-wheel form: the same latch and the same time stop, with its own front cog
    emitSignoffBool(@sSfCellWEstop, SIDE_LEFT, @sSfCritEstopD, bDEstopRan(TRUE), bDEstopOk(TRUE), SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellWTimStop, SIDE_LEFT, @sSfCritTimeStop, bSfWDStepRan[DST_TIMESTOP], bSfWDStepOk[DST_TIMESTOP], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellFrontSt, SIDE_LEFT, @sSfCritFrontSt, bSfFrontRan[SLOT_RIGHT], bSfFrontOk[SLOT_RIGHT], SIGNOFF_ONE_INSTANCE)
    ' task 3570 (S-8): the command timeout, both forms
    emitSignoffBool(@sSfCellCmdTmo, SIDE_BOTH, @sSfCritCmdTmo, bSfDStepRan[DST_CMDTIMEOUT], bSfDStepOk[DST_CMDTIMEOUT], SIGNOFF_ONE_INSTANCE)
    emitSignoffBool(@sSfCellWCmdTmo, SIDE_LEFT, @sSfCritCmdTmo, bSfWDStepRan[DST_CMDTIMEOUT], bSfWDStepOk[DST_CMDTIMEOUT], SIGNOFF_ONE_INSTANCE)
    ' task 3577 (AC): the direction sign, the steering object only -- a single wheel has no direction
    emitSignoffBool(@sSfCellDirSign, SIDE_BOTH, @sSfCritDirSign, bSfDStepRan[DST_DIRSIGN], bSfDStepOk[DST_DIRSIGN], SIGNOFF_ONE_INSTANCE)
    emitDEvCells()                                          ' task 3621
    ' task 3623 (PL-138): each wheel's rate kept across a steering stop() + start(), against the same run's free coast
    repeat slotIdx from SLOT_LEFT to SLOT_RIGHT
        emitSignoff(@sSfCellRestCst, SIDE_LEFT + slotIdx, @sSfCritRestCst, bRcRan[slotIdx], rcKeepPct[slotIdx], RC_KEEP_PCT, RC_KEEP_HI_PCT, SIGNOFF_ONE_INSTANCE, @sSfUnitsPct)

PRI emitDEvCells() | nBad
' Part D's event cells (task 3621, DRIVER-REPORTING-DESIGN.md SS6), each a COUNT of bad instances, passing at 0, and
' each measured only when BOTH its positive (the LIMIT segment's lowered limits, dEvStage()) and its negative (a
' default-limit form's totals, dEvDefaults()) were read:
'  EV-FOLDBACK - positive: the three LIMIT stages hold at least one EV_FOLDBACK engage (0) and release (frames > 0), every
'                log's sequence well formed, every drain clean; negative: no EV_FOLDBACK in either default-limit form.
'                Bad: each malformed log, each unclean drain, no pair at all (1), each default form with one
'  EV-CLIMIT   - positive: a wheel dStepDerate() saw derate logged D_DERATE_CONT_A, then D_DERATE_PEAK_A once it came
'                back, and a wheel that never derated logged none; NOMEAS unless one derated (SS6: wheels-up may not
'                reach it); negative: none in either default-limit form. Bad: each wheel that did not match, each form
'                with one
'  EV-PATH     - positive: the BLOCK step, which saw a wheel BEHIND its partner (dBehindPoll(): held while its partner
'                read commanded and free on D_BEHIND_POLLS polls running), holds an EV_PATH_LIMIT engage (under 1000) and its release (1000), every LIMIT stage's
'                sequences well formed; NOMEAS unless a wheel was seen behind (a stall of both together is not);
'                negative: none in STEERSEG. Bad: each malformed log, each unclean drain, no pair (1), STEERSEG with one
'  EV-LATE     - per front-cog form (emitLateCells())
'
' @local nBad - one cell's bad instances

    nBad := dFoldBadSeq + dEvUnclean + dDefFoldBad
    if dFoldPairs == 0
        nBad += 1
    emitSignoff(@sSfCellEvFold, SIDE_BOTH, @sSfCritEvFold, (dEvStages == 3) and (dDefForms > 0), nBad, R20_BAD_LO, R20_BAD_HI, dEvStages + dDefForms, @sSfUnitsCount)
    emitSignoff(@sSfCellEvClim, SIDE_BOTH, @sSfCritEvClim, bDClimPos and (dDefForms > 0), dClimBad + dDefClimBad, R20_BAD_LO, R20_BAD_HI, dClimN + dDefForms, @sSfUnitsCount)
    nBad := dPathBadSeq + dDefPathBad + dEvUnclean
    if dPathPairs == 0
        nBad += 1
    emitSignoff(@sSfCellEvPath, SIDE_BOTH, @sSfCritEvPath, bDBlockDrained and bDPathBehind and bDDefSteer, nBad, R20_BAD_LO, R20_BAD_HI, dEvStages + 1, @sSfUnitsCount)
    ' PL-144: the BLOCK step's one drive holds one engage and its release in the behind wheel's log; each further pair is
    '  a cycle back to full and down again. Its negative is on disk: Visit 10 pass 6 logged 5 on the pre-fix driver.
    emitSignoff(@sSfCellPathHunt, SIDE_BOTH, @sSfCritPathHunt, bDBlockDrained and bDPathBehind, dPathLogMax, 1, 1, SIGNOFF_ONE_INSTANCE, @sSfUnitsCount)
    emitLateCells(SLOT_LEFT, SIDE_BOTH)
    emitLateCells(SLOT_RIGHT, SIDE_LEFT)

PRI bDEstopRan(bWheelForm) : bRan
' Whether all three e-stop steps of one form were measured.
'
' @param bWheelForm - TRUE for the single-wheel form, FALSE for the steering object
' @returns bRan - TRUE when refuse, latch and clear were all measured

    if bWheelForm
        bRan := bSfWDStepRan[DST_ESTOP_REFUSE] and bSfWDStepRan[DST_ESTOP_LATCH] and bSfWDStepRan[DST_ESTOP_CLEAR]
    else
        bRan := bSfDStepRan[DST_ESTOP_REFUSE] and bSfDStepRan[DST_ESTOP_LATCH] and bSfDStepRan[DST_ESTOP_CLEAR]

PRI bDEstopOk(bWheelForm) : bOk
' Whether all three e-stop steps of one form held. A latch that refuses but never releases, or releases
' but never held, is not an emergency stop -- so the cell is their conjunction, not three near-misses.
'
' @param bWheelForm - TRUE for the single-wheel form, FALSE for the steering object
' @returns bOk - TRUE when refuse, latch and clear all held

    if bWheelForm
        bOk := bSfWDStepOk[DST_ESTOP_REFUSE] and bSfWDStepOk[DST_ESTOP_LATCH] and bSfWDStepOk[DST_ESTOP_CLEAR]
    else
        bOk := bSfDStepOk[DST_ESTOP_REFUSE] and bSfDStepOk[DST_ESTOP_LATCH] and bSfDStepOk[DST_ESTOP_CLEAR]

#endif

PRI emitSignoff(pCell, side, pCrit, bMeasured, measuredVal, loLimit, hiLimit, instCount, pUnits) | boundedVal, pVerdict
' One numeric SIGNOFF verdict (test_bench_scan.spin2 emitSignoff(), units named by the caller). Judged on the
' clamped printed value; PASS only when measured and in range; NOMEAS with measured NA and n 0 when not
' measured. Worst case 198 bytes.
'
' @param pCell - pointer to the cell id
' @param side - SIDE_NONE, SIDE_LEFT or SIDE_RIGHT
' @param pCrit - pointer to the criterion token
' @param bMeasured - TRUE when the instance was measured
' @param measuredVal - the measured count
' @param loLimit - lowest passing value
' @param hiLimit - highest passing value
' @param instCount - starts, captures, traces or faults behind measuredVal
' @param pUnits - pointer to the units token measuredVal is in (@sSfUnitsCount, @sSfUnitsMv)
'
' @local boundedVal - measuredVal clamped to +/-LIM_BIG
' @local pVerdict - PASS, FAIL or NOMEAS

    boundedVal := (measuredVal #> (0 - LIM_BIG)) <# LIM_BIG
    if bMeasured == FALSE
        pVerdict := @sSfNomeas
    elseif (boundedVal >= loLimit) and (boundedVal <= hiLimit)
        pVerdict := @sSfPass
    else
        pVerdict := @sSfFail
    benchLog.begin(@"SIGNOFF")
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.tokenField(@"bin", @sSfBin, TOKMAX_BIN)
    benchLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    benchLog.tokenField(@"task", @sSfTask, TOKMAX_TASK)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"crit", pCrit, TOKMAX_CRIT)
    benchLog.naNumField(@"measured", boundedVal, LIM_BIG, bMeasured)
    benchLog.numField(@"lo", loLimit, LIM_BIG)
    benchLog.numField(@"hi", hiLimit, LIM_BIG)
    benchLog.tokenField(@"units", pUnits, TOKMAX_UNITS)
    benchLog.numField(@"n", bMeasured ? instCount : 0, LIM_SMALL)
    benchLog.tokenField(@"verdict", pVerdict, TOKMAX_SFVERDICT)
    emitRecord()

PRI emitSignoffBool(pCell, side, pCrit, bMeasured, bCriterionMet, instCount) | pVerdict
' One BOOL SIGNOFF verdict: measured TRUE/FALSE (NA when not measured), lo TRUE, hi TRUE. PASS only
' when measured and TRUE. Worst case 175 bytes.
'
' @param pCell - pointer to the cell id
' @param side - SIDE_NONE, SIDE_LEFT or SIDE_RIGHT
' @param pCrit - pointer to the criterion token
' @param bMeasured - TRUE when the instance was measured
' @param bCriterionMet - TRUE when the whole criterion held
' @param instCount - instances behind the result
'
' @local pVerdict - PASS, FAIL or NOMEAS

    if bMeasured == FALSE
        pVerdict := @sSfNomeas
    elseif bCriterionMet <> FALSE
        pVerdict := @sSfPass
    else
        pVerdict := @sSfFail
    benchLog.begin(@"SIGNOFF")
    benchLog.numField(@"sf", SF_VERSION, LIM_TINY)
    benchLog.tokenField(@"bin", @sSfBin, TOKMAX_BIN)
    benchLog.tokenField(@"cell", pCell, TOKMAX_CELL)
    benchLog.tokenField(@"task", @sSfTask, TOKMAX_TASK)
    benchLog.tokenField(@"motor", sideToken(side), TOKMAX_MOTOR)
    benchLog.tokenField(@"crit", pCrit, TOKMAX_CRIT)
    if bMeasured
        benchLog.boolField(@"measured", bCriterionMet)
    else
        benchLog.textField(@"measured", @sSfNa)
    benchLog.textField(@"lo", @sSfTrue)
    benchLog.textField(@"hi", @sSfTrue)
    benchLog.tokenField(@"units", @sSfUnitsBool, TOKMAX_UNITS)
    benchLog.numField(@"n", bMeasured ? instCount : 0, LIM_SMALL)
    benchLog.tokenField(@"verdict", pVerdict, TOKMAX_SFVERDICT)
    emitRecord()

CON { --- watchdog cog (test_bench_scan.spin2 pattern, design sec 4.3): runs in its own cog --- }

PRI watchdog() | lastSeenBeat, lastChangeMs, msSinceBeat
' Watch cog 0's heartbeat every WD_POLL_MS; declare a stall once it has not advanced for WD_STALL_MS, plus the grace
' cog 0 grants while it is inside a start() call (wdGraceMs, task 3621: WD_START_GRACE_MS) or a checkWiring() call
' (PL-137: WD_WALK_GRACE_MS), each derived where it is defined.
' Runs forever: declareStall() never returns.
'
' @local lastSeenBeat - wdHeartbeat at the previous sample
' @local lastChangeMs - getms() when wdHeartbeat last changed
' @local msSinceBeat - ms since wdHeartbeat last changed

    lastSeenBeat := wdHeartbeat
    lastChangeMs := getms()
    repeat
        waitms(WD_POLL_MS)
        if wdHeartbeat <> lastSeenBeat
            lastSeenBeat := wdHeartbeat
            lastChangeMs := getms()
        else
            msSinceBeat := getms() - lastChangeMs
            if msSinceBeat >= WD_STALL_MS + wdGraceMs
                declareStall(msSinceBeat)

PRI declareStall(msSinceBeat)
' Cog 0 has stalled: set wdDeclaring first, snapshot, stop wheelL, wheelR and the steering object
' (never through a beat() wrapper), then emit BM-WATCHDOG, BM-WATCHDOG2, this part's NOSTALL FAIL,
' BM-END exit WATCHDOG and the marker through the watchdog's own builder, and idle forever. It never
' commands the instrument (not its value to write, sec 2.4). Its seq continues from logSeq.
'
' @param msSinceBeat - ms since wdHeartbeat last changed

    wdDeclaring := TRUE
    wdSeq := logSeq
    wdSnapshotStall()
    benchLog.cogEventBegin()
    wheelL.stop()
    wheelR.stop()
    steering.stop()
    wdEmitWatchdog(msSinceBeat)
    wdEmitWatchdog2()
    if SF_JUDGES_CELLS
        wdEmitNoStall()
    wdEmitEnd()
    ' QUOTED, not backticked: matches main()'s marker exactly
    debug("DEBUG_END_SESSION")
    repeat
        waitms(WD_IDLE_MS)

PRI wdSnapshotStall()
' Snapshot, before the stops, every value the watchdog records report (watchdog cog). The source is the
' steering object when either of its drivers is up, else the two wheel instances. Direct getters only.

    wdSnapCheckpoint := wdCheckpoint
    wdSnapInstState := instState
    wdSnapLeftCog := wheelL.testGetMotorCog()
    wdSnapRightCog := wheelR.testGetMotorCog()
    wdSnapState[SLOT_LEFT], wdSnapState[SLOT_RIGHT] := steering.testGetDriverState()
    wdSnapSteerUp := (wdSnapState[SLOT_LEFT] <> DCS_UNKNOWN) or (wdSnapState[SLOT_RIGHT] <> DCS_UNKNOWN)
    if wdSnapSteerUp
        wdSnapDuty[SLOT_LEFT], wdSnapErr[SLOT_LEFT], wdSnapSenseI[SLOT_LEFT], _, _, _, wdSnapState[SLOT_LEFT], wdSnapFault[SLOT_LEFT] := steering.testLeftGetTelemetry()
        wdSnapDuty[SLOT_RIGHT], wdSnapErr[SLOT_RIGHT], wdSnapSenseI[SLOT_RIGHT], _, _, _, wdSnapState[SLOT_RIGHT], wdSnapFault[SLOT_RIGHT] := steering.testRightGetTelemetry()
        wdSnapPos[SLOT_LEFT], wdSnapPos[SLOT_RIGHT] := steering.testGetRawHallTicks()
    else
        wdSnapDuty[SLOT_LEFT], wdSnapErr[SLOT_LEFT], wdSnapSenseI[SLOT_LEFT], _, _, _, wdSnapState[SLOT_LEFT], wdSnapFault[SLOT_LEFT] := wheelL.testGetTelemetry()
        wdSnapDuty[SLOT_RIGHT], wdSnapErr[SLOT_RIGHT], wdSnapSenseI[SLOT_RIGHT], _, _, _, wdSnapState[SLOT_RIGHT], wdSnapFault[SLOT_RIGHT] := wheelR.testGetTelemetry()
        wdSnapPos[SLOT_LEFT] := wheelL.getRawHallTicks()
        wdSnapPos[SLOT_RIGHT] := wheelR.getRawHallTicks()

PRI wdRecBegin(pTag)
' Start a watchdog record in wdLog (never cog 0's builder) with the watchdog's own seq.
'
' @param pTag - pointer to the record tag

    wdLog.begin(pTag)
    wdSeq := (wdSeq + 1) <# LIM_MID
    wdLog.numField(@"seq", wdSeq, LIM_MID)

PRI wdEmitRecord() | pRecord
' Emit the watchdog's assembled record: the watchdog's one record debug() statement. No beat().
'
' @local pRecord - pointer to the zero-terminated record

    pRecord := wdLog.pLine()
    debug(zstr_(pRecord))

PRI wdEmitWatchdog(msSinceBeat)
' BM-WATCHDOG. Worst case 142 bytes.
'
' @param msSinceBeat - ms since wdHeartbeat last changed

    wdRecBegin(@"BM-WATCHDOG")
    wdLog.numField(@"ms", msSinceBeat, LIM_SMALL)
    wdLog.numField(@"checkpoint", wdSnapCheckpoint, LIM_TINY)
    wdLog.tokenField(@"cp_tok", tokenAt(@tokCp, CP_COUNT, wdSnapCheckpoint), TOKMAX_CP)
    wdLog.numField(@"l_cog", wdSnapLeftCog, LIM_TINY)
    wdLog.numField(@"r_cog", wdSnapRightCog, LIM_TINY)
    wdLog.boolField(@"steer_up", wdSnapSteerUp)
    wdLog.tokenField(@"inst_state", tokenAt(@tokInstSt, INST_ST_COUNT, wdSnapInstState), TOKMAX_INSTST)
    wdLog.boolField(@"stack_ok", wdStackSentinel == WD_STACK_SENTINEL)
    wdEmitRecord()

PRI wdEmitWatchdog2()
' BM-WATCHDOG2: both motors' pre-stop telemetry. Worst case 193 bytes.

    wdRecBegin(@"BM-WATCHDOG2")
    wdLog.tokenField(@"l_st", dcsToken(wdSnapState[SLOT_LEFT]), TOKMAX_STATE)
    wdLog.boolField(@"l_flt", wdSnapFault[SLOT_LEFT])
    wdLog.numField(@"l_duty", wdSnapDuty[SLOT_LEFT], LIM_SMALL)
    wdLog.numField(@"l_err", wdSnapErr[SLOT_LEFT], LIM_TINY)
    wdLog.numField(@"l_i", wdSnapSenseI[SLOT_LEFT], LIM_SMALL)
    wdLog.numField(@"l_pos", wdSnapPos[SLOT_LEFT], LIM_MID)
    wdLog.tokenField(@"r_st", dcsToken(wdSnapState[SLOT_RIGHT]), TOKMAX_STATE)
    wdLog.boolField(@"r_flt", wdSnapFault[SLOT_RIGHT])
    wdLog.numField(@"r_duty", wdSnapDuty[SLOT_RIGHT], LIM_SMALL)
    wdLog.numField(@"r_err", wdSnapErr[SLOT_RIGHT], LIM_TINY)
    wdLog.numField(@"r_i", wdSnapSenseI[SLOT_RIGHT], LIM_SMALL)
    wdLog.numField(@"r_pos", wdSnapPos[SLOT_RIGHT], LIM_MID)
    wdEmitRecord()

PRI wdEmitNoStall()
' This part's R14-DUAL-NOSTALL-* as FAIL from the watchdog cog: measured FALSE, n 1. Worst case 175 bytes.

    wdLog.begin(@"SIGNOFF")
    wdLog.numField(@"sf", SF_VERSION, LIM_TINY)
    wdLog.tokenField(@"bin", @sSfBin, TOKMAX_BIN)
    wdLog.tokenField(@"cell", partNoStallCell(), TOKMAX_CELL)
    wdLog.tokenField(@"task", @sSfTask, TOKMAX_TASK)
    wdLog.tokenField(@"motor", sideToken(SIDE_NONE), TOKMAX_MOTOR)
    wdLog.tokenField(@"crit", @sSfCritCog0End, TOKMAX_CRIT)
    wdLog.boolField(@"measured", FALSE)
    wdLog.textField(@"lo", @sSfTrue)
    wdLog.textField(@"hi", @sSfTrue)
    wdLog.tokenField(@"units", @sSfUnitsBool, TOKMAX_UNITS)
    wdLog.numField(@"n", SIGNOFF_ONE_INSTANCE, LIM_SMALL)
    wdLog.tokenField(@"verdict", @sSfFail, TOKMAX_SFVERDICT)
    wdEmitRecord()

PRI wdEmitEnd()
' BM-END exit WATCHDOG from the watchdog cog; trap_code NA because runPart() never returned to main().
' Worst case 152 bytes.

    wdRecBegin(@"BM-END")
    wdLog.tokenField(@"exit", tokenAt(@tokExit, EXIT_COUNT, EXIT_WATCHDOG), TOKMAX_EXIT)
    wdLog.tokenField(@"part", tokenAt(@tokPart, PART_COUNT, PART_ID), TOKMAX_PART)
    wdLog.numField(@"segs", segsRun, LIM_TINY)
    wdLog.tokenField(@"last_seg", segToken(lastSeg), TOKMAX_SEG)
    wdLog.numField(@"records", wdSeq, LIM_MID)
    wdLog.naNumField(@"trap_code", 0, LIM_BIG, FALSE)
    wdLog.numField(@"unrecov", unrecovTotal, LIM_TINY)
    wdLog.tokenField(@"why", tokenAt(@tokWhy, WHY_COUNT, WHY_NOT_REACHED), TOKMAX_WHY)
    wdEmitRecord()

CON { --- cog-0 heartbeat --- }

PRI beat(checkpointId)
' Advance cog 0's heartbeat and record its checkpoint (cog 0 only; the watchdog and the instrument must
' never call this). Once the watchdog has declared, beat() never returns: a slow cog 0 that resumes
' parks here and cannot command a motor the watchdog already stopped (test_bench_scan.spin2 beat()).
'
' @param checkpointId - CP_* naming the statement group cog 0 is now inside

    if wdDeclaring
        repeat
            waitms(WD_IDLE_MS)
    wdCheckpoint := checkpointId
    wdHeartbeat += 1

