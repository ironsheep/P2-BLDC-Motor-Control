sSfCritNoGuard  BYTE    "NO_GUARD_EV", 0
sSfCritMissSum  BYTE    "MISSED_SUM_EQUAL", 0
sSfCritNoHall   BYTE    "NO_HALL_EV", 0
sSfCritIllSum   BYTE    "ILLEGAL_SUM_EQUAL", 0
sSfCritNoIll    BYTE    "NO_ILLEGAL_EV", 0
sSfCritPackQ    BYTE    "PACK_STEADY_NO_EV", 0
sSfCritPackEv   BYTE    "PACK_UNPLUG_EV", 0
' task 3623 (PL-138): part D's RESTCOAST, one instance per wheel
sSfCellRestCst  BYTE    "R20-DUAL-RESTCOAST", 0                 ' part D: a steering stop() and start() back to back keeps the coast
sSfCritRestCst  BYTE    "KEPT_PCT_OF_COAST", 0
sSfStudyR204   BYTE    "R20.4", 0
' R20.4 (task 3611): the PACK part's cells (suffix V) -- its own two, then the meter pairs, the absent reading, and
'  R20-PACK-EV's two halves under the criteria dual-start declares
sSfCellNoStallV BYTE    "R20-DUAL-NOSTALL-V", 0
sSfCellDbgMaskV BYTE    "R20-DUAL-DBGMASK-V", 0
sSfCellPkMeter  BYTE    "R20-PACK-METER", 0                     ' dual-pack: the calibrated reading against a meter, two pairs
sSfCellPkAbsent BYTE    "R20-PACK-ABSENT", 0                    ' dual-pack: an unplugged sensor reads absent, never a voltage
sSfCritPkCal    BYTE    "CAL_POINT_MV", 0
sSfCritPkSecond BYTE    "SECOND_POINT_MV", 0
sSfCritPkAbsent BYTE    "UNPLUG_NOT_ABSENT", 0
