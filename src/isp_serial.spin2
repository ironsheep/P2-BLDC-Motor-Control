'' =================================================================================================
''
''   File....... isp_serial.spin2
''   Purpose.... True mode, unbuffererd serial coms using smart pins
''               -- same features as original jm_serial.spin2 by Jon McPhalen with minor enhancements
''   Authors.... Eric Smith, Chip Gracey, and Jon McPhalen
''               -- formatted strings inspired by clib.spin for P1 (author unknown)
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Feb 2022
''   Updated.... 4 Feb 2022
''
'' =================================================================================================

'' stop bit support added by Stephen M Moraco 13 Jan 2022

CON { fixed io pins }

  RX1 = 63
  TX1 = 62


CON { smart pin modes }

  TX_MODE = %0000_0000_000_0000000000000_01_11110_0
  RX_MODE = %0000_0000_000_0000000000000_00_11111_0

CON { serial configuration }

    DATA_BITS = 8
    STOP_BITS = 2

    ' (following ignored for now)
    #0, PARITY_NONE, PARITY_EVEN, PARITY_ODD

    ' tx pin pull-up constants
    #0, PU_NONE, PU_1K5, PU_3K3, PU_15K                           ' pull-up options


CON { pst formatting }

  HOME    =  1
  CRSR_XY =  2
  CRSR_LF =  3
  CRSR_RT =  4
  CRSR_UP =  5
  CRSR_DN =  6
  BELL    =  7
  BKSP    =  8
  TAB     =  9
  LF      = 10
  CLR_EOL = 11
  CLR_DN  = 12
  CR      = 13
  CRSR_X  = 14
  CRSR_Y  = 15
  CLS     = 16


OBJ

  nstr : "jm_nstr"

VAR

  long  rxp
  long  txp
  long  baud

  long  byteMask
  long  byteExtraBits

  byte  pbuf[80]                                                ' padded strings


PUB null()
  '' This is not a top level object
''

PUB start(baudrate)
'' Start simple serial coms on default pins at baudrate
''
'' @param baudrate - the serial bit rate, bits per second

  startx(RX1, TX1, baudrate, P_HIGH_15K)


PUB startx(rxpin, txpin, baudrate, txPullup) | bitperiod, bitmode, databits
'' Start simple serial coms on rxpin and txpin at baudrate
''
'' @param rxpin - the receive pin
'' @param txpin - the transmit pin
'' @param baudrate - the serial bit rate, bits per second
'' @param txPullup - the transmit pin's pull-up: PU_NONE, PU_1K5, PU_3K3 or PU_15K

' Local Variables:
' @local bitperiod - system clocks per bit
' @local bitmode - the smart-pin X value: bit period and data-bit count
' @local databits - data bits per character, plus one for a second stop bit

  longmove(@rxp, @rxpin, 3)  ' also save baudrate incase driver is asked
  bitperiod := clkfreq / baudrate

  case txPullup
    PU_NONE : txPullup := P_HIGH_FLOAT                            ' use external pull-up
    PU_1K5  : txPullup := P_HIGH_1K5                              ' 1.5k
    PU_3K3  : txPullup := P_HIGH_1MA                              ' acts like ~3.3k
    other   : txPullup := P_HIGH_15K                              ' 15K

  databits := DATA_BITS
  if (STOP_BITS == 2)
    databits += 1

  bitmode := 7 + (bitperiod << 16)

  ' setup constants for tx() to use
    byteMask := $FF
    if (DATA_BITS == 7)
      byteMask := $7f

    byteExtraBits := 0
    if (STOP_BITS == 2)
      byteExtraBits |= $100

  pinf(txp)
  wrpin(txp, TX_MODE | txPullup)
  wxpin(txp, bitmode)
  pinl(txp)

  pinf(rxp)
  wrpin(rxp, RX_MODE)
  wxpin(rxp, bitmode)
  pinl(rxp)

PUB getBaudrate() : baudrate
'' Return the configured baud rate
''
'' @returns baudrate - the bit rate startx() was given, bits per second

    baudrate := baud    '' was saved by startx()

PUB rxflush()
'' Clear serial input
''

  repeat
  while (rxcheck() >= 0)


PUB rxcheck() : rxbyte | check
'' Check for serial input
'' -- returns -1 if nothing available
''
'' @returns rxbyte - the received byte, or -1 when none is waiting

' Local Variables:
' @local check - the smart pin's IN flag: non-zero when it is ready

  rxbyte := -1
  check := pinr(rxp)
  if (check)
    rxbyte := rdpin(rxp) >> 24
    rxbyte &= byteMask  ' handle 7bit data (e.g., 7N1 vs. 8N1)


PUB rxtime(ms) : nByte | mstix, nStartTix
'' Wait ms milliseconds for a byte to be received
'' -- returns -1 if no byte received, $00..$FF if byte
''
'' @param ms - milliseconds to wait
'' @returns nByte - the received byte, $00..$FF, or -1 when none arrived in time

' Local Variables:
' @local mstix - system clocks per millisecond
' @local nStartTix - the system counter when the wait began

  mstix := clkfreq / 1000

  nStartTix := getct()
  repeat
  until ((nByte := rxcheck()) >= 0) or (((getct() - nStartTix) / mstix) > ms)


PUB rx() : rxbyte
'' Wait for serial input
'' -- blocks!
''
'' @returns rxbyte - the received byte

  repeat
    rxbyte := rxcheck()
  until (rxbyte >= 0)


PUB tx(nByte)
'' Emit byte
''
'' @param nByte - the byte to send

  nByte &= byteMask
  nByte |= byteExtraBits

  wypin(txp, nByte)
  txflush()


PUB txn(nByte, nCount)
'' Emit byte n times
''
'' @param nByte - the byte to send
'' @param nCount - how many times to send it

  repeat nCount
    tx(nByte)


PUB txflush() | check
'' Wait until last byte has finished
''

' Local Variables:
' @local check - the smart pin's IN flag: non-zero when it is ready

  repeat
    check := pinr(txp)
  while (check == 0)


PUB str(p_str)
'' Emit z-string at p_str
''
'' @param p_str - pointer to a zero-terminated string

  repeat (strsize(p_str))
    tx(byte[p_str++])


PUB substr(p_str, len) | nByte
'' Emit len characters of string at p_str
'' -- aborts if end of string detected
''
'' @param p_str - pointer to a zero-terminated string
'' @param len - the most characters to send

' Local Variables:
' @local nByte - the character being sent

  repeat len
    nByte := byte[p_str++]
    if (nByte > 0)
      tx(nByte)
    else
      quit


PUB padstr(p_str, width, pad)
'' Emit p_str as padded field of width characters
'' -- pad is character to use to fill out field
'' -- positive width causes right alignment
'' -- negative width causes left alignment
''
'' @param p_str - pointer to a zero-terminated string
'' @param width - the field width; negative left-aligns
'' @param pad - the character that fills the field

  str(nstr.padstr(p_str, width, pad))


CON { formatted strings }

{
    Escape sequences

      \\          backslash char
      \%          percent char
      \r          carriage return
      \n          new line (vertical tab)
      \t          tab (horizontal)
      \q          double quote
      \nnn        arbitrary ASCII value (nnn is decimal)

    Formatted arguments

      %w.pf       print argument as decimal width decimal point
      %[w[.p]]d   print argument as decimal
      %[w[.p]]x   print argument as hex
      %[w[.p]]o   print argument as octal
      %[w[.p]]q   print argument as quarternary
      %[w[.p]]b   print argument as binary
      %[w]s       print argument as string
      %[w]c       print argument as character (

                  -- w is field width
                     * positive n causes right alignment in field
                     * negative n causes left align ment in field
                  -- %ns aligns s in field (may truncate)
                  -- %nc prints n copies of c
                  -- p is precision characters
                     * number of characters to use, aligned in field
                       -- for %n.pf, p is number of digits after dpoint

}


PUB fstr0(p_str)
'' Emit string with formatting characters.
''
'' @param p_str - pointer to the format control string

  format(p_str, 0)


PUB fstr1(p_str, arg1)
'' Emit string with formatting characters and one argument.
''
'' @param p_str - pointer to the format control string
'' @param arg1 - value for the first field (the fields after it follow it on the stack)

  format(p_str, @arg1)


PUB fstr2(p_str, arg1, arg2)
'' Emit string with formatting characters and two arguments.
''
'' @param p_str - pointer to the format control string
'' @param arg1 - value for the first field (the fields after it follow it on the stack)
'' @param arg2 - value for the second field

  format(p_str, @arg1)


PUB fstr3(p_str, arg1, arg2, arg3)
'' Emit string with formatting characters and three arguments.
''
'' @param p_str - pointer to the format control string
'' @param arg1 - value for the first field (the fields after it follow it on the stack)
'' @param arg2 - value for the second field
'' @param arg3 - value for the third field

  format(p_str, @arg1)


PUB fstr4(p_str, arg1, arg2, arg3, arg4)
'' Emit string with formatting characters and four arguments.
''
'' @param p_str - pointer to the format control string
'' @param arg1 - value for the first field (the fields after it follow it on the stack)
'' @param arg2 - value for the second field
'' @param arg3 - value for the third field
'' @param arg4 - value for the fourth field

  format(p_str, @arg1)


PUB fstr5(p_str, arg1, arg2, arg3, arg4, arg5)
'' Emit string with formatting characters and five arguments.
''
'' @param p_str - pointer to the format control string
'' @param arg1 - value for the first field (the fields after it follow it on the stack)
'' @param arg2 - value for the second field
'' @param arg3 - value for the third field
'' @param arg4 - value for the fourth field
'' @param arg5 - value for the fifth field

  format(p_str, @arg1)


PUB fstr6(p_str, arg1, arg2, arg3, arg4, arg5, arg6)
'' Emit string with formatting characters and six arguments.
''
'' @param p_str - pointer to the format control string
'' @param arg1 - value for the first field (the fields after it follow it on the stack)
'' @param arg2 - value for the second field
'' @param arg3 - value for the third field
'' @param arg4 - value for the fourth field
'' @param arg5 - value for the fifth field
'' @param arg6 - value for the sixth field

  format(p_str, @arg1)

PUB fstr7(p_str, arg1, arg2, arg3, arg4, arg5, arg6, arg7)
'' Emit string with formatting characters and seven arguments.
''
'' @param p_str - pointer to the format control string
'' @param arg1 - value for the first field (the fields after it follow it on the stack)
'' @param arg2 - value for the second field
'' @param arg3 - value for the third field
'' @param arg4 - value for the fourth field
'' @param arg5 - value for the fifth field
'' @param arg6 - value for the sixth field
'' @param arg7 - value for the seventh field

  format(p_str, @arg1)


PUB format(p_str, p_args) | idx, currChar, asc, fld, digits
'' Emit formatted string with escape sequences and embedded values
'' -- p_str is a pointer to the format control string
'' -- p_args is pointer to array of longs that hold field values
''    * field values can be numbers, characters, or pointers to strings
''
'' @param p_str - pointer to the format control string
'' @param p_args - pointer to the array of longs that hold the field values (numbers, characters or string pointers)

' Local Variables:
' @local idx - index of the next field value
' @local currChar - the character being examined
' @local asc - the character code of a \nnn escape
' @local fld - the field width from the specification
' @local digits - the digit count (precision) from the specification

  idx := 0                                                     ' value index

  repeat
    currChar := byte[p_str++]
    if (currChar == 0)
      quit                                                     ' end of the format string: the loop is the method's end

    elseif (currChar == "\")
      currChar := byte[p_str++]
      if (currChar == "\")
        tx("\")
      elseif (currChar == "%")
        tx("%")
      elseif (currChar == "r")
        tx(CR)
      elseif (currChar == "n")
        tx(LF)
      elseif (currChar == "t")
        tx(TAB)
      elseif (currChar == "q")
        tx(34)
      elseif ((currChar >= "0") and (currChar <= "9"))
        --p_str
        p_str, asc, _ := get_nargs(p_str)
        if ((asc >= 0) and (asc <= 255))
          tx(asc)

    elseif (currChar == "%")
      p_str, fld, digits := get_nargs(p_str)
      currChar := byte[p_str++]
      if (currChar == "f")
        str(nstr.fmt_number(long[p_args][idx++], 99, digits, fld, " "))
      elseif (currChar == "d")
        str(nstr.fmt_number(long[p_args][idx++], 10, digits, fld, " "))
      elseif (currChar == "x")
        str(nstr.fmt_number(long[p_args][idx++], 16, digits, fld, " "))
      elseif (currChar == "o")
        str(nstr.fmt_number(long[p_args][idx++], 08, digits, fld, " "))
      elseif (currChar == "q")
        str(nstr.fmt_number(long[p_args][idx++], 04, digits, fld, " "))
      elseif (currChar == "b")
        str(nstr.fmt_number(long[p_args][idx++], 02, digits, fld, " "))
      elseif (currChar == "s")
        str(nstr.padstr(long[p_args][idx++], fld, " "))
      elseif (currChar == "c")
        txn(long[p_args][idx++], abs fld)

    else
      tx(currChar)


PUB fmt_number(nNumber, base, digits, width, pad)
'' Emit nNumber converted to number in padded field
'' -- nNumber is converted using base as radix
''    * 99 for decimal with digits after decimal point
'' -- digits is max number of digits to use
'' -- width is width of final field (max)
'' -- pad is character that fills out field
''
'' @param nNumber - the number to emit
'' @param base - the radix; 99 for decimal with digits after the decimal point
'' @param digits - the most digits to use (0 for as many as needed)
'' @param width - the field width; negative left-aligns
'' @param pad - the character that fills the field

  str(nstr.fmt_number(nNumber, base, digits, width, pad))


PUB dec(nNumber)
'' Emit nNumber as decimal
''

' str(nstr.dec(nNumber, 0))
''
'' @param nNumber - the number to emit

  str(nstr.itoa(nNumber, 10, 0))


PUB fwdec(nNumber, digits)
'' Emit nNumber as decimal using fixed # of digits
'' -- may add leading zeros
''

' str(nstr.dec(nNumber, digits))
''
'' @param nNumber - the number to emit
'' @param digits - the most digits to use (0 for as many as needed)

  str(nstr.itoa(nNumber, 10, digits))


PUB jdec(nNumber, digits, width, pad)
'' Emit nNumber as decimal using fixed # of digits
'' -- aligned in padded field (negative width to left-align)
'' -- digits is max number of digits to use
'' -- width is width of final field (max)
'' -- pad is character that fills out field
''
'' @param nNumber - the number to emit
'' @param digits - the most digits to use (0 for as many as needed)
'' @param width - the field width; negative left-aligns
'' @param pad - the character that fills the field

  str(nstr.fmt_number(nNumber, 10, digits, width, pad))


PUB dpdec(nNumber, dp)
'' Emit nNumber as decimal with decimal point
'' -- dp is number of digits after decimal point
''
'' @param nNumber - the number to emit
'' @param dp - digits after the decimal point

  str(nstr.dpdec(nNumber, dp))



PUB jdpdec(nNumber, dp, width, pad)
'' Emit nNumber as decimal with decimal point
'' -- aligned in padded field (negative width to left-align)
'' -- dp is number of digits after decimal point
'' -- width is width of final field (max)
'' -- pad is character that fills out field
''
'' @param nNumber - the number to emit
'' @param dp - digits after the decimal point
'' @param width - the field width; negative left-aligns
'' @param pad - the character that fills the field

  str(nstr.fmt_number(nNumber, 99, dp, width, pad))


PUB hex(nNumber)
'' Emit nNumber as hexadecimal
''
'' @param nNumber - the number to emit

  str(nstr.itoa(nNumber, 16, 0))


PUB fwhex(nNumber, digits)
'' Emit nNumber as hexadecimal using fixed # of digits
''
'' @param nNumber - the number to emit
'' @param digits - the most digits to use (0 for as many as needed)

  str(nstr.itoa(nNumber, 16, digits))


PUB jhex(nNumber, digits, width, pad)
'' Emit nNumber as hexadecimal using fixed # of digits
'' -- aligned inside field
'' -- pad fills out field
''
'' @param nNumber - the number to emit
'' @param digits - the most digits to use (0 for as many as needed)
'' @param width - the field width; negative left-aligns
'' @param pad - the character that fills the field

  str(nstr.fmt_number(nNumber, 16, digits, width, pad))


PUB oct(nNumber)
'' Emit nNumber as octal
''
'' @param nNumber - the number to emit

  str(nstr.itoa(nNumber, 8, 0))


PUB fwoct(nNumber, digits)
'' Emit nNumber as octal using fixed # of digits
''
'' @param nNumber - the number to emit
'' @param digits - the most digits to use (0 for as many as needed)

  str(nstr.itoa(nNumber, 8, digits))


PUB joct(nNumber, digits, width, pad)
'' Emit nNumber as octal using fixed # of digits
'' -- aligned inside field
'' -- pad fills out field
''
'' @param nNumber - the number to emit
'' @param digits - the most digits to use (0 for as many as needed)
'' @param width - the field width; negative left-aligns
'' @param pad - the character that fills the field

  str(nstr.fmt_number(nNumber, 8, digits, width, pad))


PUB qrt(nNumber)
'' Emit nNumber as quarternary
''
'' @param nNumber - the number to emit

  str(nstr.itoa(nNumber, 4, 0))


PUB fwqrt(nNumber, digits)
'' Emit nNumber as quarternary using fixed # of digits
''
'' @param nNumber - the number to emit
'' @param digits - the most digits to use (0 for as many as needed)

  str(nstr.itoa(nNumber, 4, digits))


PUB jqrt(nNumber, digits, width, pad)
'' Emit nNumber as quarternary using fixed # of digits
'' -- aligned inside field
'' -- pad fills out field
''
'' @param nNumber - the number to emit
'' @param digits - the most digits to use (0 for as many as needed)
'' @param width - the field width; negative left-aligns
'' @param pad - the character that fills the field

  str(nstr.fmt_number(nNumber, 4, digits, width, pad))


PUB bin(nNumber)
'' Emit nNumber as binary
''
'' @param nNumber - the number to emit

  str(nstr.itoa(nNumber, 2, 0))


PUB fwbin(nNumber, digits)
'' Emit nNumber as binary using fixed # of digits
''
'' @param nNumber - the number to emit
'' @param digits - the most digits to use (0 for as many as needed)

  str(nstr.itoa(nNumber, 2, digits))


PUB jbin(nNumber, digits, width, pad)
'' Emit nNumber as binary using fixed # of digits
'' -- aligned inside field
'' -- pad fills out field
''
'' @param nNumber - the number to emit
'' @param digits - the most digits to use (0 for as many as needed)
'' @param width - the field width; negative left-aligns
'' @param pad - the character that fills the field

  str(nstr.fmt_number(nNumber, 2, digits, width, pad))

PUB memDump(pBytes, lenBytes, pMessage) | rowCount, pCurrByte, lastRowByteCount, bytesSoFar
'' Dump rows of hex values with address preceeding
''
'' @param pBytes - pointer to the first byte to dump
'' @param lenBytes - how many bytes to dump
'' @param pMessage - pointer to a title string printed first, or 0 for none

' Local Variables:
' @local rowCount - full 16-byte rows to dump
' @local pCurrByte - pointer to the next row's first byte
' @local lastRowByteCount - bytes in the final partial row
' @local bytesSoFar - bytes dumped so far

    if pMessage
        fstr1(string("** %s:\r\n"), pMessage)

    rowCount := lenBytes / 16
    lastRowByteCount := lenBytes - (rowCount * 16)
    pCurrByte := pBytes
    bytesSoFar := 0

    ' emit full lines
    if rowCount > 0
        repeat rowCount
            memDumpRow(pCurrByte, 16)
            pCurrByte += 16
            bytesSoFar += 16

    if  bytesSoFar < lenBytes
        ' emit last line
        memDumpRow(pCurrByte, lastRowByteCount)

PRI get_nargs(p_str) : p_str1, val1, val2 | currChar, sign

' Parse one or two numbers from string in n, -n, n.n, or -n.n format
' -- dpoint separates values
' -- only first # may be negative
' -- returns pointer to 1st char after value(s)
'
' @param p_str - pointer to the first digit (or '-') of the field specification
' @returns p_str1 - pointer to the first character after the value(s)
' @returns val1 - the first value (may be negative)
' @returns val2 - the second value, after the decimal point; 0 when absent

' Local Variables:
' @local currChar - the character being examined
' @local sign - -1 when the first value is negative, else 0

  currChar := byte[p_str]                                              ' check for negative on first value
  if (currChar == "-")
    sign := -1
    ++p_str
  else
    sign := 0

  repeat                                                        ' get first value
    currChar := byte[p_str++]
    if ((currChar >= "0") and (currChar <= "9"))
      val1 := (val1 * 10) + (currChar - "0")
    else
      if (sign)
        val1 := -val1
      quit

  if (currChar == ".")                                                 ' if dpoint
    repeat                                                      '  get second value
      currChar := byte[p_str++]
      if ((currChar >= "0") and (currChar <= "9"))
        val2 := (val2 * 10) + (currChar - "0")
      else
        quit

  p_str1 := p_str - 1                                           ' back up to non-digit


pri memDumpRow(pBytes, lenBytes) | bytIndex
' Print one dump row: the address, then each byte in hex, with a gap after the eighth.
'
' @param pBytes - pointer to the first byte to dump
' @param lenBytes - how many bytes to dump

' Local Variables:
' @local bytIndex - index of the byte being printed

    ' emit address
    fstr1(string("  0x%.8x: "), pBytes)
    ' emit 8 bytes
    ' emit gap
    ' emit 8 bytes
    repeat bytIndex from 0 to lenBytes - 1
        fstr1(string("0x%.2x "), BYTE [pBytes][bytIndex])
        if bytIndex == 7
            fstr0(string(" "))
    fstr0(string("\r\n"))



