CON { Public Interface Constants }

    ' The motor, pin-group, voltage and detection-mode names are DEFINED in the user configuration
    '  (isp_bldc_motor_userconfig.spin2, section 1) and re-exported here, so a program that uses only
    '  this object can name them -- one definition, nothing to keep in step by hand.

    ' Names of supported Motors
    MOTR_6_5_INCH       = user.MOTR_6_5_INCH
    MOTR_DOCO_4KRPM     = user.MOTR_DOCO_4KRPM
    ' return value when user makes bad choice
    INVALID_MOTOR = -1

    '  ID where the P2 Eval Motor Board is plugged in (Enum)
    '    (Names of supported PinGroups) to make enum work, but you can't connect to it. ;-)
    PINS_P0_P15         = user.PINS_P0_P15
    PINS_P8_P23         = user.PINS_P8_P23
    PINS_P16_P31        = user.PINS_P16_P31
    PINS_NO_USE_P24_P39 = user.PINS_NO_USE_P24_P39
    PINS_P32_P47        = user.PINS_P32_P47
    PINS_P40_P55        = user.PINS_P40_P55
    ' return value when user makes bad choice
    INVALID_PIN_BASE = -1

    ' Names of supported voltages
    '  Lipo battery sizes: 2s-7.4v, 3s-11.1v, 4s-14.8v, 5s-18.5v, 6s-22.2v, 7s-25.9v
    PWR_Unknown         = user.PWR_Unknown
    PWR_6p0V            = user.PWR_6p0V
    PWR_7p4V            = user.PWR_7p4V
    PWR_11p1V           = user.PWR_11p1V
    PWR_12p0V           = user.PWR_12p0V
    PWR_14p8V           = user.PWR_14p8V
    PWR_18p5V           = user.PWR_18p5V
    PWR_22p2V           = user.PWR_22p2V
    PWR_24p0V           = user.PWR_24p0V
    PWR_25p9V           = user.PWR_25p9V
    ' return value when user makes bad choice
    INVALID_VOLTAGE = -1

    VALUE_NOT_SET = -1

    ' RevIDs of BLDC driver board
    #20, REV_Unknown, REV_A, REV_B

    ' Driver Detection Mode of BLDC driver boards
    BRD_AUTO_DET        = user.BRD_AUTO_DET
    BRD_REV_A           = user.BRD_REV_A
    BRD_REV_B           = user.BRD_REV_B
    INVALID_DET_MODE = -1

    ' Driver Distance-Units Enum: (Millimeters, Centimeters, Inches, Feet, Meters, Kilometers, Miles)
    #0, DDU_Unknown, DDU_MM, DDU_CM, DDU_IN, DDU_FT, DDU_M, DDU_KM, DDU_MI

    ' Driver Rotation-Units Enum:
    #0, DRU_Unknown, DRU_HALL_TICKS, DRU_DEGREES, DRU_ROTATIONS

    ' Driver Time-Unit Enum:
    #0, DTU_Unknown, DTU_MILLISEC, DTU_SEC

    ' Driver Status Enum: (serial hosts receive these as numbers -- append new values, never renumber)
    #10, DS_Unknown, DS_MOVING, DS_HOLDING, DS_OFF, DS_FAULTED, DS_ESTOP

    ' Driver Control Stop-State Enum:
    #0, SM_Unknown, SM_FLOAT, SM_BRAKE

    ' Fault Cause Enum (getFaultCause()): why the most recent fault since start() happened
    '  FC_NONE - no fault since start()
    '  FC_LAG  - the rotor could not follow the field: an overload, a stall, or a wrong commutation offset
    '  FC_HALL - a hall sensor read an illegal code (%000 or %111) at the fault: dead, unpowered or disconnected
    #0, FC_NONE, FC_LAG, FC_HALL

    ' Hold State Enum (getHoldStatus()): what the hold at rest is doing (holdAtStop(TRUE))
    '  HS_OFF      - not holding: moving, holdAtStop(FALSE), faulted, emergency-stopped or not started
    '  HS_HOLDING  - at rest and holding its stop position, with only as much effort as the load needs
    '  HS_SLIPPED  - the load moved the wheel past the hold; the phases are shorted (a speed-dependent drag)
    '  HS_LIMITED  - held at its effort ceiling longer than the time limit; the phases are shorted
    #0, HS_OFF, HS_HOLDING, HS_SLIPPED, HS_LIMITED

    ' Health Check Bits (getHealth()): the checks start() runs with the motor at rest, nothing moving
    '  HLT_HALLS      - the hall sensors read a legal code, and none has read an illegal one since start
    '  HLT_SENSE_ZERO - the current sense reads a plausible zero with the bridge off
    '  HLT_PHASE_U/V/W - that motor lead is connected: its voltage followed another phase's through the windings,
    '                    and the phase itself could be driven. One open lead fails its own bit; no motor fails all three
    HLT_HALLS       = 1 << 0
    HLT_SENSE_ZERO  = 1 << 1
    HLT_PHASE_U     = 1 << 2
    HLT_PHASE_V     = 1 << 3
    HLT_PHASE_W     = 1 << 4
    HLT_ALL_CHECKS  = HLT_HALLS | HLT_SENSE_ZERO | HLT_PHASE_U | HLT_PHASE_V | HLT_PHASE_W
    '  HLT_WIRING     - checkWiring() only (it moves the wheel): one electrical cycle each way moved the wheel the same
    '                   distance both ways with no fault and no bad hall code -- catches swapped or dead hall or phase wiring
    HLT_WIRING      = 1 << 5
    '  HLT_PACK       - checked only with the pack voltage sensor fitted (user.PACK_SENSOR_FITTED): it reads a pack
    HLT_PACK        = 1 << 6

    ' Pack Sensor Status Enum (getPackVoltage()): the optional pack voltage sensor, VOLTAGE-SENSOR.md
    '  PACK_NOT_FITTED - user.PACK_SENSOR_FITTED is FALSE, or this instance does not read it (the steering object's right wheel)
    '  PACK_ABSENT     - fitted, but it reads under PACK_ABSENT_MV: unplugged, or its lead is open (R4 pulls the pin to 0 V)
    '  PACK_PRESENT    - a pack voltage is being read
    #0, PACK_NOT_FITTED, PACK_ABSENT, PACK_PRESENT

    ' Fault Response Enum (setFaultResponse()): what the motor does on a position fault (|err| >= 125 while driven)
    '  FR_SHIPPED - the bridge takes the stop mode's fault state at once: SM_FLOAT coasts, SM_BRAKE shorts
    '  FR_GRADED  - with the halls legal, the first fault re-seeds the field from the halls and ramps to a
    '               stop under control; otherwise (halls lost, or a second fault on that ramp) SM_BRAKE takes
    '               the graded short BR_BRAKE and SM_FLOAT coasts
    #0, FR_SHIPPED, FR_GRADED

    ' setHoldLimits(): the slowest rise and the longest time limit it accepts
    HOLD_RISE_MS_MAX            = 10_000
    HOLD_LIMIT_MS_MAX           = 600_000   ' 10 minutes

    ' Stop Reason Enum (getStopReason()): why the last drive ended (serial hosts receive these as numbers -- append new
    '  values, never renumber; from 40, so none can be read as a DS_*, REV_* or BRD_* value, and none is an error)
    '  SR_NONE             - no drive has ended since the last accepted drive command, or since start()
    '  SR_COMMANDED        - a call the program made ended it: a stop, a zero power, or a call that replaced it
    '  SR_AT_LIMIT         - its distance, rotation or time limit was reached
    '  SR_FAULT_CONTROLLED - a position fault the driver answered by re-syncing from the halls and stopping under control
    '  SR_FAULT_LOST       - a position fault latched (DCS_FAULTED): control was lost, and the fault's bridge state took over
    '  SR_BLOCKED          - a protective stop: commanded to move, held at its current limit, and not moving
    '  SR_LINK_LOST        - setCommandTimeout(): no drive command arrived in time
    '  SR_EMERGENCY        - emergencyCutoff()
    '  SR_PARTNER          - isp_steering_2wheel only: the other wheel's condition stopped this one; read that wheel's reason
    #40, SR_NONE, SR_COMMANDED, SR_AT_LIMIT, SR_FAULT_CONTROLLED, SR_FAULT_LOST, SR_BLOCKED, SR_LINK_LOST, SR_EMERGENCY, SR_PARTNER

    ' Event Kind Enum (getEvent()): the soft conditions the motor handled on its own (serial hosts receive these as
    '  numbers -- append new values, never renumber; from 60, apart from every other enum)
    '  EV_NONE          - nothing unread (value 0)
    '  EV_LOST          - this cog fell more than EV_QUEUE_DEPTH events behind (value: events lost); it always comes first
    '  EV_STOP          - a drive ended (value: the SR_* recorded, as getStopReason() then reads)
    '  EV_FAULT_RESYNC  - a position fault answered by a re-sync and a controlled stop (value: FC_LAG)
    '  EV_FAULT         - a position fault latched, DCS_FAULTED (value: FC_LAG or FC_HALL)
    '  EV_HOLD_SLIP     - the hold at rest handed off to the phase short on a slip (value: the displacement, hall ticks)
    '  EV_HOLD_LIMIT    - the hold at rest handed off to the phase short at its time limit (value: the duty it held)
    '  EV_CURRENT_LIMIT - the thermal derate engaged or released (value: the phase-current limit now in force, amps)
    '  EV_PATH_LIMIT    - isp_steering_2wheel only: the path limiter engaged or fully released (value: the scale, per mille)
    '  EV_HALL_MISSED   - missed hall transitions (value: how many since the last EV_HALL_MISSED); at most one a second
    '  EV_HALL_ILLEGAL  - illegal hall codes, %000 and %111 (value: how many since the last); at most one a second
    '  EV_WALK_GUARD    - checkWiring()'s current guard shorted a leg (value: the net DC-link mV that tripped it)
    '  EV_LATE_PASS     - a front-cog pass ended within LATE_MARGIN_US of its 1 ms slot's end, or past it (value: late passes since the last); at most one a second
    '  EV_PACK          - the pack sensor's status changed (value: the new PACK_*); at most one a second
    '  EV_CHECK_RETRY   - a start check failed, then passed on a retry (value: the recovered HLT_* bits | attempts << 8)
    '  EV_FOLDBACK      - the driver's per-frame current fold-back engaged (value 0), then went quiet for a second
    '                     (value: the frames it limited since it engaged)
    #60, EV_NONE, EV_LOST, EV_STOP, EV_FAULT_RESYNC, EV_FAULT, EV_HOLD_SLIP, EV_HOLD_LIMIT, EV_CURRENT_LIMIT, EV_PATH_LIMIT, EV_HALL_MISSED, EV_HALL_ILLEGAL, EV_WALK_GUARD, EV_LATE_PASS, EV_PACK, EV_CHECK_RETRY, EV_FOLDBACK
    EV_QUEUE_DEPTH              = 16        ' PROVISIONAL: the events each reading cog can fall behind before it loses its oldest

    MOTOR_ID_STRLEN = 10

    ' Error codes: every command method returns NO_ERROR or one of these, and records it for getError().
    '  Getters that cannot measure return a documented neutral value and record the code instead.
    '  Every code is below -1_000, so none can be mistaken for a pin group, voltage, cog id, power or
    '  any other value this object returns. -2_000..-2_099 is RESERVED for protective-stop causes.
    '   NO_ERROR               - the call did what it was asked
    '   ERR_BAD_PIN_GROUP      - start: base pin is not a legal PINS_* group
    '   ERR_PIN_GROUP_IN_USE   - start: the pin group overlaps one another motor instance holds
    '   ERR_BAD_VOLTAGE        - start: the voltage is not in this motor's power table
    '   ERR_BAD_DETECT_MODE    - start: the detection mode is not a BRD_* value
    '   ERR_NO_FREE_COG        - start: no cog was free for the driver or the front cog
    '   ERR_ABI_MISMATCH       - start: the driver's shared-memory layout is wrong; no driver launched
    '   ERR_NOT_STARTED        - a command on a motor whose driver and front cog are not running
    '   ERR_NO_SENSE_TASK      - no longer raised (start() always runs the front cog); kept so callers still compile
    '   ERR_BAD_UNITS          - a units value outside its DDU_*, DRU_* or DTU_* enum
    '   ERR_BAD_COUNT          - a distance, rotation, time, rate or ramp value outside its range (e.g. less than 1)
    '   ERR_NO_WHEEL_DIA       - a distance request when the configured wheel diameter is 0
    '   ERR_LIMIT_UNRESOLVABLE - a stop limit that rounds to less than one hall tick
    '   ERR_SYNC_TIMEOUT       - a synchronized command the driver did not take in time
    '   ERR_BUSY               - TEST-USE: moveShaftToAngle() while a move is still pending
    '   ERR_FAULT_NOT_CLEARED  - TEST-USE: testResetFault() found the driver not stopped after its wait
    '   ERR_EMERGENCY_STOPPED  - a drive refused, and nothing written, while the motor is emergency-stopped
    '   ERR_NO_RESPONSE        - the front cog did not answer within its bound (at start, or for a request)
    '   ERR_BOARD_NOT_DETECTED - start: no board was detected at the pin group and no revision was forced; getCurrent(): no current scale
    '   ERR_COMMAND_TIMEOUT    - setCommandTimeout() is on and no drive command arrived within it: the motor was stopped
    '   ERR_START_CHECK_FAILED - start: a start check still failed after its retries, so the motor was not started (getHealth() says which)
    '   ERR_NOT_IMPLEMENTED    - the method is kept so programs compile, but does nothing (calibrate())
    '   ERR_PROTECTIVE_STOP    - a protective stop is latched for a cause outside the named ones
    '   ERR_PLATFORM_BLOCKED   - a protective stop is latched: a commanded motor held at its current limit did not move
    NO_ERROR                = 0
    ERR_BAD_PIN_GROUP       = -1_001
    ERR_PIN_GROUP_IN_USE    = -1_002
    ERR_BAD_VOLTAGE         = -1_003
    ERR_BAD_DETECT_MODE     = -1_004
    ERR_NO_FREE_COG         = -1_005
    ERR_ABI_MISMATCH        = -1_006
    ERR_NOT_STARTED         = -1_007
    ERR_NO_SENSE_TASK       = -1_008
    ERR_BAD_UNITS           = -1_009
    ERR_BAD_COUNT           = -1_010
    ERR_NO_WHEEL_DIA        = -1_011
    ERR_LIMIT_UNRESOLVABLE  = -1_012
    ERR_SYNC_TIMEOUT        = -1_013
    ERR_BUSY                = -1_014
    ERR_FAULT_NOT_CLEARED   = -1_015
    ERR_EMERGENCY_STOPPED   = -1_016
    ERR_NO_RESPONSE         = -1_017
    ERR_BOARD_NOT_DETECTED  = -1_018
    ERR_COMMAND_TIMEOUT     = -1_019
    ERR_START_CHECK_FAILED  = -1_020
    ERR_NOT_IMPLEMENTED     = -1_021
    ERR_PROTECTIVE_STOP     = -2_000
    ERR_PLATFORM_BLOCKED    = -2_001

    ' setAcceleration(): the accepted rate, mm/s squared at the wheel rim (10_000 is about 1 g)
    ACCEL_MIN_MM_S2         = 1
    ACCEL_MAX_MM_S2         = 10_000

    ' setDeceleration(): the accepted rate, mm/s squared at the wheel rim. The floor is higher than setAcceleration()'s:
    '  every stop ramps down at this rate, the command timeout's and a controlled fault stop's (FR_GRADED) included, so
    '  it must stay a stop -- at 250 a wheel at 2 m/s is at rest in 8 s. The built-in rate is about 1,470 (6.5in wheel).
    DECEL_MIN_MM_S2         = 250
    DECEL_MAX_MM_S2         = 10_000

    ' PL-160 (DRIVER_REV 38): the built-in rates, until setAcceleration() / setDeceleration() is called, and the time
    '  every ramp takes to ease its acceleration in (and out): the jerk is the rate / RAMP_TAU_MS. PROVISIONAL, owner Q2:
    '  a ruling retunes these three numbers and nothing else.
    ACCEL_BUILTIN_MM_S2     = 1_000
    DECEL_BUILTIN_MM_S2     = 1_470
    RAMP_TAU_MS             = 250

    ' setRampingValues(): the largest value it accepts (the driver runs at most ACCEL_STEP_CAP)
    RAMP_STEP_MAX           = $4000_0000

    ' setCommandTimeout(): 0 turns it off (the default); otherwise the accepted range, in ms
    CMD_TIMEOUT_OFF         = 0
    CMD_TIMEOUT_MIN_MS      = 10
    CMD_TIMEOUT_MAX_MS      = 60_000

    ' setMaxSpeed() and setMaxSpeedForDistance(): the top speed until one is set, and the range a value is saturated to
    MAX_SPEED_DEFAULT       = 75
    MAX_SPEED_MIN           = 1
    MAX_SPEED_MAX           = 100

    ' PL-155: WHICH SETTINGS start() KEEPS. The settings below are the program's own: they may be made before start(), are
    '  kept across stop() and start(), and are applied at every start() (after its checks, which run with the motor
    '  floated). Each reads back through its getter:
    '    setMaxSpeed()             getMaxSpeed()
    '    setMaxSpeedForDistance()  getMaxSpeedForDistance()
    '    holdAtStop()              isHoldAtStop()
    '    setForwardIsReverse()     isForwardReversed()     (forwardIsReverse() is setForwardIsReverse(TRUE))
    '    setStartChecks()          (read by start() itself)
    '    setAcceleration()         getAcceleration()       (PL-160)
    '    setDeceleration()         getDeceleration()       (PL-160)
    '    setRampingValues()        getRampingValues()      (PL-160: the raw ramp; the last ramp call wins)
    '  start() RESTORES the defaults of the protective settings, which need a running motor (ERR_NOT_STARTED before
    '  start()), so a program sets them after every start(): setFaultResponse(), setHoldLimits(), setCommandTimeout().

OBJ { objects / constants included by this object }

#ifdef BENCH_CFG
    user        :   "isp_bldc_motor_userconfig_bench"     ' bench configuration (-D BENCH_CFG)
#else
    user        :   "isp_bldc_motor_userconfig"     ' driver configuration
#endif
    distConv    :   "isp_dist_utils"                ' distance conversion utils

CON { DEBUG channels -- the mask and the channel names come from the user config }

    DEBUG_MASK = user.MOTOR_DBG_MASK            ' DEBUG[user.DBGCH_*] compiles only when its bit is set

DAT { misc time constants }

    ' time constants based on CPU freq
    ticks1ms    LONG    0
    ticks1us    LONG    0
    ticks500us  long    0                       ' the drive-pass deadline; the pass itself runs every 23 ADC frames, ~1913 Hz (see drvMotor)

PUB null()
'' This is not a top-level object
''

PUB start(eMotorBasePin, eMotorVoltage, eDetectionMode) : ok
'' Specify motor control board connect location for this motor and start the driver and its front cog (2 cogs)
''
'' PL-45: on success, this blocks for about 1 s while it samples the current-sense rest zero
'' getCurrent() nets out; a failure returns well before that (captureRestZero() runs last)
'' With BRD_AUTO_DET a pin group where no board is detected is refused (ERR_BOARD_NOT_DETECTED): without its
'' board revision the motor would have no current limit. Force BRD_REV_A or BRD_REV_B to drive it anyway.
'' R20.1: a start check (getHealth()) that still fails after START_CHECK_RETRIES retries refuses the start
'' (ERR_START_CHECK_FAILED; getHealth() stays readable) unless setStartChecks(FALSE) was called first. The retries
'' add time only on a failure: up to about 4 s.
''
'' @param eMotorBasePin - The base pin ENUM (PINS_*) for adapter board for this motor
'' @param eMotorVoltage - The voltage ENUM (PWR_*) for this motor
'' @param eDetectionMode - The detection mode ENUM (BRD_*) for this motor
'' @returns ok - The COG ID of the motor driver task or (-1) if failed to start; the cause of a -1 is in getError()

    ok := startEx(eMotorBasePin, eMotorVoltage, eDetectionMode, false)

PUB startEx(eMotorBasePin, eMotorVoltage, eDetectionMode, sync) : ok | eError, bParked
'' Specify motor control board connect location for this motor and start the driver and its front cog (2 cogs), specify sync setting
''
'' The front cog tracks position, enforces the stop limits and is the only cog that commands the driver.
''
'' PL-45: on success, this blocks for about 1 s while it samples the current-sense rest zero
'' getCurrent() nets out; a failure returns well before that (captureRestZero() runs last)
'' With BRD_AUTO_DET a pin group where no board is detected is refused (ERR_BOARD_NOT_DETECTED), as by start().
'' A start check still failing after its retries refuses the start (ERR_START_CHECK_FAILED), as by start().
''
'' @param eMotorBasePin - The base pin ENUM (PINS_*) for adapter board for this motor
'' @param eMotorVoltage - The voltage ENUM (PWR_*) for this motor
'' @param eDetectionMode - The detection mode ENUM (BRD_*) for this motor
'' @param sync - non zero if the driver should start parked, released by the front cog as soon as the front cog runs
'' @returns ok - The COG ID of the motor driver task or (-1) if failed to start; the cause of a -1 is in getError()

' Local Variables:
' @local eError - NO_ERROR, or the first step's failure code
' @local bParked - T/F where T means the driver starts parked until its ATN

    ' Validate, then acquire, then commit: a rejected call changes nothing -- a running motor keeps
    '  running -- and after the claim nothing but the two cog launches can fail, and each failure
    '  stop()s whatever did start, so no half-started instance exists.
    ok := -1
    bParked := (sync <> FALSE)
    eError := launchDriver(eMotorBasePin, eMotorVoltage, eDetectionMode, bParked)
    if eError == NO_ERROR
        eError := launchFront(bParked)
        if eError == NO_ERROR
            captureRestZero()    ' PL-45: the driver is confirmed running and released; nothing has driven it yet
            ' R19.4: nothing moves; getHealth() reports. R20.1: a refusing check still failing after its retries refuses
            '  the start, unless setStartChecks(FALSE); stop() leaves getHealth()'s verdict readable
            if (runStartChecks() <> 0) and (bStartChecksOptOut == FALSE)
                stop()
                eError := recordError(ERR_START_CHECK_FAILED)
                debug[user.DBGCH_ERROR]("! ERROR: start refused, a start check still fails after its retries ", uhex_long(healthFailed))
            else
                applyStartSettings() ' PL-155: the program's kept settings, now the checks have run with the motor floated
                startPackSense()     ' R19.5: the pack voltage sensor, when fitted
                ' R20.1: the front cog is the event log's only writer, so it queues EV_CHECK_RETRY, not this cog
                if postRequest(REQ_NOTE_START, 0, 0, 0) <> NO_ERROR
                    debug[user.DBGCH_ERROR]("! ERROR: startEx(", zstr_(@motorId), ") front cog did not take the start's check record")
                ok := motorCog - 1    ' public contract: the driver cog's id (0-7), per @returns

PUB startOwned(eMotorBasePin, eMotorVoltage, eDetectionMode) : ok
'' INTERNAL USE: start this motor's driver parked for its owner's ATN, with no front cog of its own (for isp_steering_2wheel)
''
'' The owner releases the driver with COGATN and then services this motor from its own front cog
'' through the front*() routines. Commands on this instance itself return ERR_NOT_STARTED.
'' An undetected board is refused (ERR_BOARD_NOT_DETECTED) unless a revision is forced, as by start().
'' PL-155: the owner calls applyStartSettings() once its start checks have passed, as start() does.
''
'' @param eMotorBasePin - The base pin ENUM (PINS_*) for adapter board for this motor
'' @param eMotorVoltage - The voltage ENUM (PWR_*) for this motor
'' @param eDetectionMode - The detection mode ENUM (BRD_*) for this motor
'' @returns ok - The COG ID of the motor driver task or (-1) if failed to start; the cause of a -1 is in getError()

    ok := -1
    if launchDriver(eMotorBasePin, eMotorVoltage, eDetectionMode, TRUE) == NO_ERROR
        ok := motorCog - 1

PUB stop() : eError | releaseStart
'' Stop cogs and release pins assigned to this motor
''
'' PL-138: a running driver is first asked to let go of its bridge (it coasts, then drops its gate modes), and
'' stop() waits for that, bounded (RELEASE_TIMEOUT_US, under 2 ms), before it stops the driver cog.
''
'' @returns eError - NO_ERROR; stopping always succeeds, on a started or an unstarted instance

' Local Variables:
' @local releaseStart - getct() when the driver was asked to release

    bSettingsLive := FALSE  ' PL-155: a setter now only stores its value, for the next start() to apply

    ' PL-41: the front cog is asked to EXIT first. It answers every open request, acknowledges, and
    '  parks with no output, so the cogstop below cannot cut a debug line. Without an answer in the
    '  bound the cog is stopped anyway: only the clean-line guarantee is lost.
    if senseCog     ' stop the front cog first, so nothing commands the driver after this
        if postRequest(REQ_EXIT, 0, 0, 0) <> NO_ERROR
            debug[user.DBGCH_ERROR]("! ERROR: front cog did not acknowledge EXIT; stopping anyway")
        cogstop(senseCog - 1)
        senseCog := 0

    if motorCog     ' stop motor drive
        ' PL-138 (W4): a cogstop drops every DIR the driver holds (p2kbSpin2Cogstop), and on a DRIVING bridge
        '  each high side that was ON turns off on the same clock edge its low side turns on: a shoot-through
        '  with no dead gap. So the driver is asked to release first (driverRelease): it coasts
        '  RELEASE_WAIT_FRAMES frames, drops its gate modes with every gate OFF, reports DCS_RELEASED and
        '  parks. No front cog remains (this instance's is stopped above; an owner's is stopped by the owner
        '  before it calls here), so this cog is the one writer of drv_release. The wait is bounded and the cogstop follows regardless: a driver not yet in
        '  its loop (calibrating, or parked for its ATN) never answers, and holds every gate OFF there (PL-138
        '  part 1: high sides pwmt in reset, low sides mode 0 driven LOW), so its cogstop cuts nothing driven.
        drv_release := TRUE
        releaseStart := getct()
        repeat until (drv_state == DCS_RELEASED) or (getct() - releaseStart >= RELEASE_TIMEOUT_US * ticks1us)
        if drv_state <> DCS_RELEASED
            debug[user.DBGCH_LIFECYCLE]("* driver did not report DCS_RELEASED in ", udec_(RELEASE_TIMEOUT_US), " us (not yet driving?); stopping anyway")
        cogstop(motorCog - 1)
        ' PL-138 (W3): the backstop, at once. A driver that did not release leaves its low sides in pwmn, and with
        '  DIR low (the cogstop cleared it) a pwmn pin outputs HIGH: all three low sides ON until the modes are
        '  cleared. motorCog <> 0 means this instance's init() ran, so pinbase is this instance's claimed group.
        pinclear(pinbase addpins DRV_PIN_SPAN)
        motorCog := 0
        ' PL-52: no front cog remains to own motorPower (this instance's, or the owner's, is already
        ' stopped above / by the owner before calling here), so this write cannot race a second writer.
        motorPower := 0
        ' PL-28(b): no driver cog remains to keep drv_state current, so mark it not-running
        ' the same way init() marks a not-yet-started instance (DCS_Unknown), AFTER the cog
        ' is stopped so this write cannot race the driver's own block-copy of the status run.
        drv_state := DCS_Unknown

    if bPackOwned == TRUE                                                       ' R19.5: no front cog reads it now
        bPackOwned := FALSE
        pinclear(user.PACK_SENSE_PIN)

    ' Release EVERY pin of the group, AFTER the cogstop. The driver is not "sensed half, driven
    ' half": it WRPINs ADC smart-pin modes onto base+0..4 (adc_pins) as well as PWM modes onto
    ' base+8..13 (drive_pins), and raises DIR on both (never on the hall inputs, base+5..7). A smart pin whose DIR
    ' goes low keeps its WRPIN mode, and while a mode is set its IN is the smart pin's handshake
    ' flag, not the pin level -- so leaving base+0..4 configured made the next getBoardType()
    ' read a Rev B board as Rev A. Only pinclear() zeroes the mode (DIR := 0, WRPIN := 0).
    ' base+14..15 are unused by the driver but were already cleared here, so the whole 16-pin
    ' group is released. ADDPINS cannot cross a 32-pin port boundary, so this is two 8-pin
    ' calls rather than one 16-pin call.
    ' Only when THIS instance initialised the group: pinbase is 0 (not VALUE_NOT_SET) in an
    ' instance that was never started, so pinbase alone would clear P0..P15 out from under
    ' another motor. The AE claim is taken only by setupForStart(), after every argument has
    ' been validated and immediately before its init(), which cannot fail -- so holding the claim
    ' means this instance's init() completed. It is keyed by this instance's own @pinbase, so no
    ' other instance's state can satisfy it.
    if (pinbase <> VALUE_NOT_SET) and (bHoldsPinBaseClaim() == TRUE)
        pinclear(pinbase addpins HALF_GROUP_SPAN)
        pinclear(pinbase + GROUP_HI_OFFSET addpins HALF_GROUP_SPAN)
    pinbase := VALUE_NOT_SET

    releasePinBaseClaim()    ' AE: free this instance's pin-range claim, if any
    eError := NO_ERROR

PUB testSetup(eMotorBasePin, eMotorVoltage, eDetectionMode) : eError
'' TESTING USE: Specify motor control board connect location for this motor BUT DON'T start the driver
''
'' @param eMotorBasePin - The base pin ENUM (PINS_*) for adapter board for this motor
'' @param eMotorVoltage - The voltage ENUM (PWR_*) for this motor
'' @param eDetectionMode - The detection mode ENUM (BRD_*) for this motor
'' @returns eError - NO_ERROR, or the ERR_* code also recorded for getError(); a rejected call changes nothing

    eError := setupForStart(eMotorBasePin, eMotorVoltage, eDetectionMode)

DAT { pin-range allocation tracking (AE) }

' One owner slot per legal PINS_* base. Holds @pinbase (a unique per-instance hub address) for
' whichever isp_bldc_motor instance currently claims that 16-pin range, or 0 when free. DAT is
' shared across every instance of this object (unlike VAR, which is per-instance), which is
' exactly the shared registry overlap detection needs.
    gOwnerP0P15     LONG    0
    gOwnerP8P23     LONG    0
    gOwnerP16P31    LONG    0
    gOwnerP32P47    LONG    0
    gOwnerP40P55    LONG    0

PUB startSenseCog() : ok
'' Return the id of the sense (front) cog that start() launched; starts nothing
''
'' Kept for 5.x callers: start() now always runs the front cog, which tracks position and enforces the stop limits.
''
'' @returns ok - The COG ID of the front cog, or (-1) when the motor is not started, with the cause in getError()

    ok := -1
    if senseCog <> 0
        ok := senseCog - 1
    else
        recordError(ERR_NOT_STARTED)
        debug[user.DBGCH_ERROR]("! ERROR: startSenseCog(", zstr_(@motorId), ") motor not started; start() runs the front cog")

PUB testSetMotorId(pIDStr) : eError
'' TESTING USE: save name used in debug messages
''
'' @param pIDStr - pointer to a zero-terminated name, at most MOTOR_ID_STRLEN characters are kept
'' @returns eError - NO_ERROR

    strcopy(@motorId, pIdStr, MOTOR_ID_STRLEN)
    eError := NO_ERROR

PUB setAcceleration(rate) : eError | rampStep
'' Set how fast the motor speeds up: every speed-up from now on reaches a steady {rate}, in mm/s squared at the wheel rim
''
'' Until this is called the motor speeds up at its built-in rate, ACCEL_BUILTIN_MM_S2 (1_000). Every ramp eases in and
'' out (PL-160, DRIVER_REV 38): the acceleration rises from 0 to {rate} over RAMP_TAU_MS (250 ms) and falls back to 0
'' as the target speed arrives, so the motor never takes a step of torque. Slowing down and stopping are set apart,
'' by setDeceleration(), so this does not change the stopping distances. The motor can still accelerate more slowly
'' than asked: the drive never lets the field run further ahead of the rotor than the motor can follow.
'' PL-160: kept across stop() and start(), and may be set before start(); getAcceleration() reads it back. It replaces
'' the speed-up part of an earlier setRampingValues(), and a later setRampingValues() replaces it: the last call wins.
''
'' @param rate - acceleration while speeding up, mm/s squared [ACCEL_MIN_MM_S2 to ACCEL_MAX_MM_S2]
'' @returns eError - NO_ERROR, ERR_NO_WHEEL_DIA when the configured wheel diameter is 0, or ERR_BAD_COUNT for a {rate} outside the range (also recorded for getError()); a rejected call changes nothing

' Local Variables:
' @local rampStep - the driver's acceleration limit, its increment change per drive pass, that gives {rate}

    eError, rampStep := rampStepForAccel(rate, ACCEL_MIN_MM_S2, ACCEL_MAX_MM_S2)
    if eError == NO_ERROR
        usrAccelStep := rampStep                                                ' PL-160: kept, first; a start() applies it
        usrAccel := rate
        if bSettingsLive == TRUE
            requestRamps()                                                      '  and in effect now on a running motor (its front cog applies it)
    else
        eError := recordError(eError)
        debug[user.DBGCH_ERROR]("! ERROR: setAcceleration() rejected ", sdec_long(eError), sdec_long(rate))

PUB setDeceleration(rate) : eError | rampStep
'' Set how fast the motor slows down: every slow-down and stop from now on reaches a steady {rate}, in mm/s squared at the wheel rim
''
'' Until this is called the motor slows at its built-in rate, DECEL_BUILTIN_MM_S2 (1_470). The deceleration eases in
'' and out over RAMP_TAU_MS, as setAcceleration()'s does (PL-160). The stopping
'' distance follows it: a lower rate stops further on. stopAfterDistance(), stopAfterRotation() and stopAfterTime()
'' start their stop early by the distance and time this rate takes, so they still come to rest at their limit. The
'' command timeout's stop and a controlled fault stop (FR_GRADED) ramp down at it too, which is why its floor,
'' DECEL_MIN_MM_S2, is higher than setAcceleration()'s. emergencyCutoff() does not ramp and is not affected. The motor
'' can still slow more gently than asked: the ramp down waits whenever the rotor runs too far ahead of the field.
'' PL-160: kept across stop() and start(), and may be set before start(); getDeceleration() reads it back. It replaces
'' the slow-down step of an earlier setRampingValues(), and a later setRampingValues() replaces it: the last call wins.
''
'' @param rate - deceleration while slowing down or stopping, mm/s squared [DECEL_MIN_MM_S2 to DECEL_MAX_MM_S2]
'' @returns eError - NO_ERROR, ERR_NO_WHEEL_DIA when the configured wheel diameter is 0, or ERR_BAD_COUNT for a {rate} outside the range (also recorded for getError()); a rejected call changes nothing

' Local Variables:
' @local rampStep - the driver's deceleration limit, its increment change per drive pass, that gives {rate}

    eError, rampStep := rampStepForAccel(rate, DECEL_MIN_MM_S2, DECEL_MAX_MM_S2)
    if eError == NO_ERROR
        usrDecelStep := rampStep                                                ' PL-160: kept, first; a start() applies it
        usrDecel := rate
        if bSettingsLive == TRUE
            requestRamps()                                                      '  and in effect now on a running motor (its front cog applies it)
    else
        eError := recordError(eError)
        debug[user.DBGCH_ERROR]("! ERROR: setDeceleration() rejected ", sdec_long(eError), sdec_long(rate))

PUB getAcceleration() : nRate
'' Return the rate the motor speeds up at, mm/s squared at the wheel rim
''
'' After setAcceleration() this is the rate it was given; until then the built-in rate, ACCEL_BUILTIN_MM_S2 (1_000);
'' after setRampingValues() the rate its maxRamp gives. PL-160 (DRIVER_REV 38): every ramp now has a single steady
'' rate, so this no longer returns 0 for the built-in ramp. 0 only when the configured wheel diameter is 0. The kept
'' setting, so it reads the same before start().
''
'' @returns nRate - the speed-up rate, mm/s squared

    nRate := usrAccel
    if nRate == 0
        if usrAccelStep <> 0
            nRate := rateForRampStep(usrAccelStep)
        elseif rampStepScale() <> 0.0
            nRate := ACCEL_BUILTIN_MM_S2

PUB getDeceleration() : nRate
'' Return the rate the motor slows down and stops at, mm/s squared at the wheel rim
''
'' After setDeceleration() this is the rate it was given; until then the built-in rate, DECEL_BUILTIN_MM_S2 (1_470);
'' after setRampingValues() the rate its decrRamp gives. 0 only when the configured wheel diameter is 0. The kept
'' setting, so it reads the same before start().
''
'' @returns nRate - the slow-down rate, mm/s squared

    nRate := usrDecel
    if nRate == 0
        if usrDecelStep <> 0
            nRate := rateForRampStep(usrDecelStep)
        elseif rampStepScale() <> 0.0
            nRate := DECEL_BUILTIN_MM_S2

PUB setRampingValues(minRamp, maxRamp, incRamp, decrRamp) : eError
'' Change the ramp's two acceleration limits, in the driver's own units (angle increment change per drive pass): the raw form of the ramp
''
'' setAcceleration() and setDeceleration() are the user interface to the ramp, in mm/s squared; this is the raw
'' escape beneath them. The last call wins: this replaces what both set, and each of them replaces its own part of
'' this. PL-160: kept across stop() and start(), and may be set before start(); getRampingValues() reads it back.
'' minRamp and incRamp have no effect since DRIVER_REV 38: the jerk-limited ramp derives its jerks from maxRamp and
'' decrRamp and RAMP_TAU_MS. They are still checked, so a call that was refused before is refused now.
''
'' @param minRamp - no effect since DRIVER_REV 38 [1 to maxRamp]
'' @param maxRamp - the speed-up acceleration limit: the most the field's increment grows in one drive pass [minRamp to RAMP_STEP_MAX]; above ACCEL_STEP_CAP it runs at ACCEL_STEP_CAP
'' @param incRamp - no effect since DRIVER_REV 38 [0 to RAMP_STEP_MAX]
'' @param decrRamp - the slow-down acceleration limit: the most the field's increment falls in one drive pass [1 to RAMP_STEP_MAX]; above ACCEL_STEP_CAP it runs at ACCEL_STEP_CAP
'' @returns eError - NO_ERROR, or ERR_BAD_COUNT (also recorded for getError()) for a value outside its range; a rejected call changes nothing

    ' G: a zero decrRamp would never stop the motor, and a negative step would ramp the wrong way
    if (minRamp < 1) or (maxRamp < minRamp) or (maxRamp > RAMP_STEP_MAX) or (incRamp < 0) or (incRamp > RAMP_STEP_MAX) or (decrRamp < 1) or (decrRamp > RAMP_STEP_MAX)
        eError := recordError(ERR_BAD_COUNT)
        debug[user.DBGCH_ERROR]("! ERROR: setRampingValues() rejected ", sdec_long(minRamp), sdec_long(maxRamp), sdec_long(incRamp), sdec_long(decrRamp))
    else
        usrAccelStep := maxRamp                                                 ' PL-160: kept, first; a start() applies it
        usrDecelStep := decrRamp
        usrAccel := 0                                                           ' the rates asked for are replaced: the getters
        usrDecel := 0                                                           '  now read the rates these steps give
        if bSettingsLive == TRUE
            requestRamps()                                                      '  and in effect now on a running motor (its front cog applies it)
        eError := NO_ERROR

PUB getRampingValues() : minRamp, maxRamp, incRamp, decrRamp
'' Return the ramp's four driver parameters, in the driver's own units: the two jerks and the two acceleration limits
''
'' While the motor runs, the values the driver is using; before start() (or after stop()), the values the next
'' start() applies (PL-160). Until a ramp setter is called these are the built-in ramp's. Since DRIVER_REV 38 the
'' four longs are the jerk-limited ramp's: each jerk is its acceleration limit spread over RAMP_TAU_MS.
''
'' @returns minRamp - jerk_up, the speed-up jerk: the acceleration a ramp from rest takes on its first pass, and adds every pass after
'' @returns maxRamp - accel_up, the speed-up acceleration limit
'' @returns incRamp - jerk_dn, the slow-down jerk
'' @returns decrRamp - accel_dn, the slow-down acceleration limit

    if bSettingsLive == TRUE
        minRamp := jerk_up
        maxRamp := accel_up
        incRamp := jerk_dn
        decrRamp := accel_dn
    else
        minRamp, maxRamp, incRamp, decrRamp := keptRamps()

PUB setMaxSpeed(speed) : eError | limitSpeed
'' Limit top-speed to {speed} where {speed} is [1 to 100]  (default is MAX_SPEED_DEFAULT, 75)
''
'' PL-155: kept across stop() and start(), and may be set before start(); getMaxSpeed() reads it back.
''
'' @param speed - top speed [MAX_SPEED_MIN to MAX_SPEED_MAX]; a value outside the range is saturated to it
'' @returns eError - NO_ERROR

' Local Variables:
' @local limitSpeed - {speed} saturated to [1 to 100]

    limitSpeed :=  MAX_SPEED_MIN #> speed <# MAX_SPEED_MAX
    if limitSpeed <> speed
        debug[user.DBGCH_WARNING]("! WARNING: setMaxSpeed() speed out of range (corrected):", udec_long(speed), " - must be [1 to 100]")
    debug[user.DBGCH_COMMAND]("setMaxSpeed() ", udec_long(limitSpeed))
    usrMaxSpeed := limitSpeed                                                   ' PL-155: kept, first; a start() applies it
    if bSettingsLive == TRUE
        maxSpeed := limitSpeed                                                  '  and in effect now on a running motor
    eError := NO_ERROR

PUB setMaxSpeedForDistance(speed) : eError | limitSpeed4dist
'' Limit top-speed of driveForDistance() operations to {speed} where {speed} is [1 to 100]  (default is MAX_SPEED_DEFAULT, 75)
''
'' PL-155: kept across stop() and start(), and may be set before start(); getMaxSpeedForDistance() reads it back.
''
'' @param speed - top speed [MAX_SPEED_MIN to MAX_SPEED_MAX]; a value outside the range is saturated to it
'' @returns eError - NO_ERROR

' Local Variables:
' @local limitSpeed4dist - {speed} saturated to [1 to 100]

    limitSpeed4dist :=  MAX_SPEED_MIN #> speed <# MAX_SPEED_MAX
    if limitSpeed4dist <> speed
        debug[user.DBGCH_WARNING]("! WARNING: setMaxSpeedForDistance() speed out of range (corrected):", udec_long(speed), " - must be [1 to 100]")
    debug[user.DBGCH_COMMAND]("setMaxSpeedForDistance() ", udec_long(limitSpeed4dist))
    usrMaxSpeed4dist := limitSpeed4dist                                         ' PL-155: kept, first; a start() applies it
    if bSettingsLive == TRUE
        maxSpeed4dist := limitSpeed4dist
    eError := NO_ERROR

PUB calibrate() : eError
'' NOT IMPLEMENTED: this method does nothing, and returns ERR_NOT_IMPLEMENTED (PL-159)
''
'' It is kept so that programs which call it still compile. No calibration is needed: the commutation offsets
'' for each supported motor are built in.
''
'' @returns eError - ERR_NOT_IMPLEMENTED, always (also recorded for getError())

    eError := recordError(ERR_NOT_IMPLEMENTED)

PUB holdAtStop(bEnable) : eError
'' Informs the motor control cog to actively hold position (bEnable=true) or coast (bEnable=false) once AT REST
''
'' PL-58: chooses hold or release only at rest. Every stop commanded from speed follows the driver's own ramp
'' regardless of this setting; MEASURED (Visit 2) both settings take the same distance to stop from a given speed.
'' Coast turns all six bridge FETs off. The hold keeps the wheel where it stopped, spending only the effort the
'' load pushes back with: the more a slope or a push moves the wheel, the harder it holds, up to a ceiling. If the
'' load moves the wheel past the hold, or it holds at its ceiling too long, it shorts the motor phases instead (a
'' drag that grows with speed but cannot hold a wheel still) and getHoldStatus() says which. On a fault the motor
'' coasts (bEnable=false) or brakes (bEnable=true): a faulted driver has lost the rotor, so it cannot hold a
'' position. emergencyCutoff() always brakes.
'' PL-155: kept across stop() and start(), and may be set before start(); isHoldAtStop() reads it back. start()
'' applies it once its checks have run, which they do with the motor floated (coasting) whatever is chosen here.
''
'' @param bEnable - T/F where T means hold position at rest and F means coast (any non-zero value is T)
'' @returns eError - NO_ERROR

    usrStopMode := (bEnable) ? SM_BRAKE : SM_FLOAT                             ' PL-155: kept, first; a start() applies it
    if bSettingsLive == TRUE
        stop_mode := usrStopMode                                                '  and in effect now on a running motor
    eError := NO_ERROR

PUB isHoldAtStop() : bEnable
'' Return whether the motor holds its position at rest (holdAtStop(TRUE)) or coasts (FALSE, the default)
''
'' @returns bEnable - T/F where T means hold at rest, F means coast; the kept setting, so it reads the same before start()

    bEnable := (usrStopMode == SM_BRAKE)

PUB setCommandTimeout(nMs) : eError
'' Stop the motor if no drive command arrives within {nMs} while it is driven: a link-loss guard, off by default
''
'' While it is on, a driven motor must be sent a drive command at least every {nMs}, whatever started it:
'' driveAtPower() or driveForDistance(), with or without a stopAfter*() limit armed. When one does not arrive in time
'' the motor stops, as stopMotor() stops it (holdAtStop() chooses hold or coast at rest), and ERR_COMMAND_TIMEOUT is
'' reported once by getError() on every cog that calls it. Re-sending the same driveAtPower() keeps an armed
'' stopAfter*() limit; re-sending driveForDistance() starts its distance again. Setting it restarts the clock.
'' A protective setting (PL-155): start() turns it off, and it needs a running motor (ERR_NOT_STARTED before start()),
'' so set it after every start(). getCommandTimeout() reads it back.
''
'' @param nMs - the timeout in ms [CMD_TIMEOUT_MIN_MS to CMD_TIMEOUT_MAX_MS], or CMD_TIMEOUT_OFF (0) to turn it off
'' @returns eError - NO_ERROR, ERR_BAD_COUNT for a value outside the range, or ERR_NOT_STARTED / ERR_NO_RESPONSE, also recorded for getError(); a rejected call changes nothing

    if (nMs <> CMD_TIMEOUT_OFF) and ((nMs < CMD_TIMEOUT_MIN_MS) or (nMs > CMD_TIMEOUT_MAX_MS))
        eError := recordError(ERR_BAD_COUNT)
        debug[user.DBGCH_ERROR]("! ERROR: setCommandTimeout() rejected ", sdec_long(nMs))
    else
        eError := recordError(postRequest(REQ_SET_TIMEOUT, nMs, 0, 0))    ' the front cog owns the clock

PUB getCommandTimeout() : nMs
'' Return the command timeout in effect, as setCommandTimeout() set it
''
'' @returns nMs - the timeout in ms, or CMD_TIMEOUT_OFF (0) when it is off: before start(), and after every start() until set

    nMs := cmdTimeoutMs
    if senseCog == 0                                                            ' start() turns it off; nothing watches it now
        nMs := CMD_TIMEOUT_OFF

PUB setFaultResponse(eMode, brakePct) : eError
'' Choose what the motor does on a position fault: the rotor could not follow the field (an overload or a stall)
''
'' FR_SHIPPED coasts (holdAtStop(FALSE)) or shorts the phases (TRUE) at once. FR_GRADED, while the halls read a
'' legal code, re-seeds the field from the halls and stops along the ramp down (getStopReason() reads
'' SR_FAULT_CONTROLLED); with the halls lost, or on a second fault during that stop, it coasts (FALSE) or takes the
'' graded short (TRUE): the phases shorted for {brakePct} of each BRAKE_PERIOD_MS and coasting for the rest, which
'' scales the average braking torque to {brakePct} of the full short's. The peak current is still the full short's.
'' A protective setting (PL-155): start() restores the default, FR_GRADED at BRAKE_PCT_DEFAULT (10 %), and it needs a
'' running motor (ERR_NOT_STARTED before start()), so set it after every start(). getFaultResponse() reads it back.
''
'' @param eMode - FR_SHIPPED or FR_GRADED
'' @param brakePct - the graded short's shorted time, % of each brake period [0..100]
'' @returns eError - NO_ERROR, ERR_BAD_COUNT for a value out of range, or ERR_NOT_STARTED / ERR_NO_RESPONSE, also recorded for getError(); a rejected call changes nothing

    if ((eMode <> FR_SHIPPED) and (eMode <> FR_GRADED)) or (brakePct < 0) or (brakePct > 100)
        eError := recordError(ERR_BAD_COUNT)
        debug[user.DBGCH_ERROR]("! ERROR: setFaultResponse() rejected ", sdec_long(eMode), sdec_long(brakePct))
    else
        eError := recordError(postRequest(REQ_SET_FAULT, eMode, brakePct, 0))    ' the front cog is the only writer

PUB setHoldLimits(ceilingPct, riseMs, limitMs) : eError
'' Set the limits of the hold at rest (holdAtStop(TRUE)): how hard it may hold, how fast it gets there, and for how long
''
'' The hold spends only the effort the load pushes back with, rising to {ceilingPct} over {riseMs} while the wheel stays
'' displaced; after {limitMs} at that ceiling it hands off to the phase short (getHoldStatus() reads HS_LIMITED). The
'' defaults (HOLD_CEILING_PCT, HOLD_RISE_MS, HOLD_LIMIT_MS) were sized with the wheels unloaded; a loaded robot may need
'' others. A protective setting (PL-155): start() restores the defaults, and it needs a running motor (ERR_NOT_STARTED
'' before start()), so set it after every start(). getHoldLimits() reads it back.
''
'' @param ceilingPct - the hold's duty ceiling, % of the drive's full duty [1..100]
'' @param riseMs - ms from the minimum duty to the ceiling while the wheel stays displaced [1..HOLD_RISE_MS_MAX]
'' @param limitMs - ms at the ceiling before the hold hands off to the phase short [1..HOLD_LIMIT_MS_MAX]
'' @returns eError - NO_ERROR, ERR_BAD_COUNT for a value out of range, or ERR_NOT_STARTED / ERR_NO_RESPONSE, also recorded for getError(); a rejected call changes nothing

    if (ceilingPct < 1) or (ceilingPct > 100) or (riseMs < 1) or (riseMs > HOLD_RISE_MS_MAX) or (limitMs < 1) or (limitMs > HOLD_LIMIT_MS_MAX)
        eError := recordError(ERR_BAD_COUNT)
        debug[user.DBGCH_ERROR]("! ERROR: setHoldLimits() rejected ", sdec_long(ceilingPct), sdec_long(riseMs), sdec_long(limitMs))
    else
        eError := recordError(postRequest(REQ_SET_HOLD, ceilingPct, riseMs, limitMs))    ' the front cog is the only writer

PUB setStartChecks(bRefuse) : eError
'' Choose whether start() refuses to start a motor that fails a start check: call it BEFORE start()
''
'' By default start() refuses (-1, ERR_START_CHECK_FAILED) when a check of HLT_HALLS, HLT_SENSE_ZERO or HLT_PHASE_U/V/W
'' still fails after START_CHECK_RETRIES retries. With {bRefuse} FALSE the motor starts anyway, and getHealth() still
'' says what failed. The retries run either way. HLT_WIRING and HLT_PACK never refuse. The choice is kept across
'' stop() and start() until it is changed.
''
'' @param bRefuse - T/F where T means refuse a start whose checks fail (the default), F means start anyway
'' @returns eError - NO_ERROR

    bStartChecksOptOut := (bRefuse == FALSE)
    eError := NO_ERROR

PUB resetTracking() : eError
'' Resets the odometer: the distance getDistance() and the rotation getRotationCount() report start again from 0
''
'' PL-153: the odometer is the total distance the wheel has travelled, forward and back alike (backing up is travel
'' too), since the last resetTracking() or start(). Nothing else resets it: not a drive, a limit, a fault, an
'' emergency stop or checkWiring(). An armed distance or rotation limit is not moved by it: each counts the travel
'' from the moment it was armed.
''
'' @returns eError - NO_ERROR once the front cog has applied the reset, or ERR_NOT_STARTED / ERR_NO_RESPONSE, also recorded for getError()

    eError := recordError(postRequest(REQ_RESET_TRACKING, 0, 0, 0))

PUB moveShaftToAngle(desiredAngle) : eError
'' TESTING USE: force motor to specific angle
''
'' @param desiredAngle - the shaft angle to move to
'' @returns eError - NO_ERROR, or ERR_BUSY (also recorded for getError()) while a previous move is still pending

    eError := NO_ERROR
    if targetAngle == $ffffffff
        targetAngle := desiredAngle
        debug[user.DBGCH_TEST]("MOT: move to ", sdec(targetAngle))
    else
        eError := recordError(ERR_BUSY)
        debug[user.DBGCH_TEST]("MOT: busy!!")

CON { --- Subsystem Control --- }

PUB driveForDistance(distance, distanceUnits) : eError | nStopTicks
'' Control the forward direction of this motor using the {distance} and {distanceUnits} inputs.
'' Turn the motor on then turn it off again after it reaches the specified {distance} in {distanceUnits} [DDU_MM, DDU_CM, DDU_IN, DDU_FT, DDU_M, DDU_KM or DDU_MI].
'' AFFECTED BY:  setAcceleration(), setDeceleration(), setMaxSpeedForDistance(), holdAtStop()
''
'' PL-153: the distance counts from this call, whatever the odometer (getDistance()) reads, so two calls in a row
'' each travel their own distance. FORWARD ONLY: to back up a distance, drive in reverse and arm a distance limit:
'' driveAtPower(-power), then stopAfterDistance(distance, units). Those are two calls, not one atomic move, and the
'' limit counts from its own call, so the travel between the two is not counted; armed first instead (as the demos
'' arm every limit), it counts from before the motor moves.
''
'' @param distance - distance to travel, at least 1
'' @param distanceUnits - units of {distance}: DDU_MM, DDU_CM, DDU_IN, DDU_FT, DDU_M, DDU_KM or DDU_MI
'' @returns eError - NO_ERROR, or the ERR_* code also recorded for getError() (ERR_EMERGENCY_STOPPED while emergency-stopped); on any error neither the limit is armed nor the motor started

' Local Variables:
' @local nStopTicks - the requested distance in hall ticks

    ' validate everything on this cog, then post one request: the front cog arms the limit and drives
    '  together, or refuses both (I1 item 2)
    eError, nStopTicks := ticksForDistance(distance, distanceUnits)
    if (eError == NO_ERROR) and (senseCog == 0)
        eError := ERR_NOT_STARTED
    if eError == NO_ERROR
        eError := postRequest(REQ_DRIVE_DISTANCE, nStopTicks, getMaxSpeedForDistance(), FALSE)
    eError := recordError(eError)
    if eError <> NO_ERROR
        debug[user.DBGCH_ERROR]("! ERROR: driveForDistance(", zstr_(@motorId), ") rejected ", sdec_long(eError), sdec_long(distance), sdec_long(distanceUnits))

PUB driveAtPower(power) : eError
'' Control the speed and direction of this motor using the {power, [(-100) to 100]} input.
'' Turns the motor on at {power}. PL-66: a FAULTED motor is cleared first, automatically, every time --
'' a repeated power is no different from a new one.
'' AFFECTED BY:  setAcceleration(), setDeceleration(), setMaxSpeed(), holdAtStop()
''
'' @param power - power [(-100) to 100], saturated to that range and then to setMaxSpeed(); 0 stops
'' @returns eError - NO_ERROR, or ERR_NOT_STARTED, ERR_EMERGENCY_STOPPED or ERR_NO_RESPONSE (a FAULTED motor did not clear in the bound, or the front cog did not answer; also recorded for getError()); on an error nothing new is written (a FAULTED motor's failed clear leaves a zero command)

    eError := driveAtPowerEx(power, false)

PUB driveAtPowerEx(power, sync) : eError | limitPwr
'' Control the speed and direction of this motor using the {power, [(-100) to 100]} input. (allow sync setting)
'' Turns the motor on at {power}. PL-66: a FAULTED motor is cleared first, automatically, every time --
'' a repeated power is no different from a new one.
'' AFFECTED BY:  setAcceleration(), setDeceleration(), setMaxSpeed(), holdAtStop()
''
'' @param power - power [(-100) to 100], saturated to that range and then to setMaxSpeed(); 0 stops
'' @param sync - non zero if the front cog should release the command to the driver with ATN and wait, bounded, for the driver to take it
'' @returns eError - NO_ERROR, or ERR_NOT_STARTED, ERR_EMERGENCY_STOPPED, ERR_SYNC_TIMEOUT (sync only; the motor is then stopped), or ERR_NO_RESPONSE (a FAULTED motor did not clear in the bound, or the front cog did not answer), also recorded for getError()

' Local Variables:
' @local limitPwr - {power} saturated to [(-100) to 100], for the range warning

    eError := NO_ERROR
    if senseCog == 0
        ' started means the driver and the front cog both run, and only the front cog commands the driver
        eError := recordError(ERR_NOT_STARTED)
        debug[user.DBGCH_ERROR]("! ERROR: driveAtPowerEx(", zstr_(@motorId), ") motor not started")
    else
        limitPwr :=  -100 #> power <# 100
        if limitPwr <> power
            debug[user.DBGCH_WARNING]("! WARNING: driveAtPowerEx() power out of range (corrected):", udec_long(power), " - must be [-100 to +100]")
        debug[user.DBGCH_COMMAND]("-MOT- driveAtPowerEx(", zstr_(@motorId), ") ", sdec_long(limitPwr), udec_long(accel_up), udec_long(jerk_up))
        ' the front cog saturates again and maps the power to the driver increment
        eError := recordError(postRequest(REQ_DRIVE, limitPwr, 0, (sync <> FALSE)))

PUB stopAfterRotation(nRotationCount, eRotationUnits) : eError | nStopTicks
'' Stops the motor so it is at rest at {rotationCount} of {rotationUnits} [DRU_HALL_TICKS, DRU_DEGREES, or DRU_ROTATIONS].
'' USE WITH:  driveAtPower(); the front cog start() launched enforces the limit
''
'' The stop begins early, by the distance the ramp-down needs at the motor's current speed, so the motor comes
'' to rest at the limit (within about two hall ticks), not past it. A limit shorter than that distance stops at once.
'' AFFECTED BY:  setDeceleration() (the ramp-down's rate, read afresh every pass)
'' PL-153: the rotation counts from this call (turning either way), not from the odometer (getRotationCount()).
'' PL-158: DRU_DEGREES rounds to the nearest hall tick (4 degrees on the 6.5in motor: 90 is 23 ticks, 92 degrees).
''
'' @param nRotationCount - rotation to travel, at least 1, resolving to at least one hall tick
'' @param eRotationUnits - units of {nRotationCount}: DRU_HALL_TICKS, DRU_DEGREES or DRU_ROTATIONS
'' @returns eError - NO_ERROR, or the ERR_* code also recorded for getError() (ERR_BAD_COUNT under 1 or past a long's hall ticks, ERR_BAD_UNITS, ERR_LIMIT_UNRESOLVABLE, ERR_NOT_STARTED when the motor is not started); a rejected call leaves any armed limit in place

' Local Variables:
' @local nStopTicks - the requested rotation in hall ticks

    ' validate everything, then commit: nothing is changed until every check has passed
    eError, nStopTicks := ticksForRotation(nRotationCount, eRotationUnits)
    if (eError == NO_ERROR) and (senseCog == 0)
        eError := ERR_NOT_STARTED

    if eError == NO_ERROR
        eError := postRequest(REQ_LIMIT_TICKS, nStopTicks, 0, 0)    ' the front cog arms it
    eError := recordError(eError)
    if eError <> NO_ERROR
        debug[user.DBGCH_ERROR]("! ERROR: stopAfterRotation() rejected ", sdec_long(eError), sdec_long(nRotationCount), sdec_long(eRotationUnits))

PUB stopAfterDistance(nDistance, eDistanceUnits) : eError | nStopTicks
'' Stops the motor so it is at rest at {distance} specified in {distanceUnits} [DDU_MM, DDU_CM, DDU_IN, DDU_FT, DDU_M, DDU_KM, DDU_MI].
'' USE WITH:  driveAtPower(); the front cog start() launched enforces the limit
''
'' The stop begins early, by the distance the ramp-down needs at the motor's current speed, so the motor comes
'' to rest at the limit (within about two hall ticks), not past it. A limit shorter than that distance stops at once.
'' AFFECTED BY:  setDeceleration() (the ramp-down's rate, read afresh every pass)
'' PL-153: the distance counts from this call (forward or back), not from the odometer (getDistance()). With
'' driveAtPower(-power) it backs the motor up a distance: two calls, not one atomic move (see driveForDistance()).
''
'' @param nDistance - distance to travel, at least 1, resolving to at least one hall tick
'' @param eDistanceUnits - units of {nDistance}: DDU_MM, DDU_CM, DDU_IN, DDU_FT, DDU_M, DDU_KM or DDU_MI
'' @returns eError - NO_ERROR, or the ERR_* code also recorded for getError() (ERR_NOT_STARTED when the motor is not started); a rejected call leaves any armed limit in place

' Local Variables:
' @local nStopTicks - the requested distance in hall ticks

    ' validate everything, then commit: nothing is changed until every check has passed
    eError, nStopTicks := ticksForDistance(nDistance, eDistanceUnits)
    if (eError == NO_ERROR) and (senseCog == 0)
        eError := ERR_NOT_STARTED

    if eError == NO_ERROR
        eError := postRequest(REQ_LIMIT_TICKS, nStopTicks, 0, 0)    ' the front cog arms it
    eError := recordError(eError)
    if eError <> NO_ERROR
        debug[user.DBGCH_ERROR]("! ERROR: stopAfterDistance() rejected ", sdec_long(eError), sdec_long(nDistance), sdec_long(eDistanceUnits))

PUB stopAfterTime(nTime, eTimeUnits) : eError | timeNow, nStopMSecs
'' Stops the motor so it is at rest when {time} specified in {timeUnits} [DTU_MILLISEC or DTU_SEC] has elapsed.
'' USE WITH:  driveAtPower(); the front cog start() launched enforces the limit
''
'' The stop begins early, by the time the ramp-down needs at the motor's current speed, so the motor is at
'' rest by the limit (within a few milliseconds). A limit shorter than that time stops at once.
'' AFFECTED BY:  setDeceleration() (the ramp-down's rate, read afresh every pass)
''
'' @param nTime - time to run, at least 1
'' @param eTimeUnits - units of {nTime}: DTU_MILLISEC or DTU_SEC
'' @returns eError - NO_ERROR, or the ERR_* code also recorded for getError() (ERR_NOT_STARTED when the motor is not started); a rejected call leaves any armed limit in place

' Local Variables:
' @local timeNow - getms() when the limit was computed
' @local nStopMSecs - the getms() value at which the motor stops, never 0 (0 means no limit)

    ' validate everything, then commit: nothing is changed until every check has passed
    eError := NO_ERROR
    timeNow := getms()
    nStopMSecs := 0
    if nTime < 1
        eError := ERR_BAD_COUNT
    elseif senseCog == 0
        eError := ERR_NOT_STARTED
    else
        case eTimeUnits
            DTU_MILLISEC:
                nStopMSecs := timeNow + nTime
            DTU_SEC:
                nStopMSecs := timeNow + (nTime * 1_000)
            other:
                eError := ERR_BAD_UNITS

    if eError == NO_ERROR
        if nStopMSecs == 0
            nStopMSecs := 1
        debug[user.DBGCH_COMMAND]("* stop motor at ", udec_long(nStopMSecs), ", now: ", udec_long(timeNow))
        eError := postRequest(REQ_LIMIT_TIME, nStopMSecs, 0, 0)    ' the front cog arms it
    eError := recordError(eError)
    if eError <> NO_ERROR
        debug[user.DBGCH_ERROR]("! ERROR: stopAfterTime() rejected ", sdec_long(eError), sdec_long(nTime), sdec_long(eTimeUnits))

PUB stopMotor() : eError
'' Stops the motor, killing any motion that was still in progress
'' PL-58: the stop itself always follows the driver's ramp; holdAtStop() only selects hold vs. coast once AT REST
'' AFFECTED BY:  setDeceleration() (the ramp's rate), holdAtStop()
''
'' @returns eError - NO_ERROR; stopping always succeeds

    ' I6: never refuses, never records. The front cog applies a posted stop first in its next pass.
    '  With no front cog (not started, inside start(), after stop()) there is no second writer, so the
    '  stop is written here; the same happens, reported, if a running front cog did not answer in time.
    eError := postRequest(REQ_STOP, 0, 0, 0)
    if eError <> NO_ERROR
        if eError == ERR_NO_RESPONSE
            debug[user.DBGCH_ERROR]("! ERROR: stopMotor(", zstr_(@motorId), ") front cog did not answer; stopping directly")
        frontSecure(FALSE)
    eError := NO_ERROR

PUB emergencyCutoff() : eError
'' EMERGENCY-Stop - Immediately stop motor, killing any motion that was still in progress
''
'' The emergency stop latches: drives are refused with ERR_EMERGENCY_STOPPED until clearEmergency().
'' It brakes by shorting the motor phases, whatever holdAtStop() selects, and stays braked while latched.
'' BY DESIGN this is a hard stop: it gives up the gentle deceleration every other stop uses, to stop motion now.
'' From speed, the short can draw tens of amps and stop the wheel abruptly, which can tip a tall robot. Use
'' stopMotor() when a controlled stop will do.
''
'' @returns eError - NO_ERROR; stopping always succeeds

    ' I6: never refuses, never records (see stopMotor())
    debug[user.DBGCH_FAULT]("-- EMERGENCY STOP --")
    eError := postRequest(REQ_ESTOP, 0, 0, 0)
    if eError <> NO_ERROR
        if eError == ERR_NO_RESPONSE
            debug[user.DBGCH_ERROR]("! ERROR: emergencyCutoff(", zstr_(@motorId), ") front cog did not answer; stopping directly")
        frontSecure(TRUE)
    eError := NO_ERROR

PUB clearEmergency() : eError
'' Clear EMERGENCY-Stop: the motor stays stopped and may be driven again
''
'' @returns eError - NO_ERROR once the driver has left its emergency stop; the protective code while a protective stop is latched (clearProtectiveStop() releases that); or ERR_NOT_STARTED / ERR_NO_RESPONSE; also recorded for getError()

    ' the front cog writes a zero command before releasing the latch, so nothing moves on the clear
    eError := recordError(postRequest(REQ_CLEAR_ESTOP, 0, 0, 0))
    if eError == NO_ERROR
        debug[user.DBGCH_FAULT]("-- EMERGENCY -- CLEARED --")
    else
        debug[user.DBGCH_ERROR]("! ERROR: clearEmergency(", zstr_(@motorId), ") not cleared ", sdec_long(eError))

PUB forwardIsReverse() : eError
'' Call when we have two motors and one of them needs to be reversed: the same as setForwardIsReverse(TRUE)
''
'' PL-155: kept across stop() and start(), and may be set before start(); setForwardIsReverse(FALSE) undoes it.
''
'' @returns eError - NO_ERROR

    eError := setForwardIsReverse(TRUE)

PUB setForwardIsReverse(bEnable) : eError
'' Reverse this motor's sense of forward (bEnable=true), for a motor mounted facing the other way, or restore it (false, the default)
''
'' A positive power then turns the motor the other way; getPower() and every other value still read as commanded.
'' PL-155: kept across stop() and start(), and may be set before start(); isForwardReversed() reads it back. It is
'' applied to the next drive command, not to one already running.
''
'' @param bEnable - T/F where T means forward and reverse are swapped for this motor (any non-zero value is T)
'' @returns eError - NO_ERROR

    usrReversed := (bEnable <> FALSE)                                           ' PL-155: kept, first; a start() applies it
    if bSettingsLive == TRUE
        motorIsReversed := usrReversed
    eError := NO_ERROR

PUB isForwardReversed() : bEnable
'' Return whether this motor's sense of forward is reversed (setForwardIsReverse(), forwardIsReverse())
''
'' @returns bEnable - T/F where T means forward and reverse are swapped; the kept setting, so it reads the same before start()

    bEnable := usrReversed

CON { --- Subsystem Status --- }

PUB getError() : eError | nEvents
'' Return and clear this cog's first recorded error
''
'' @returns eError - this cog's first ERR_* code since the last call, then a command timeout this cog has not yet been told of (ERR_COMMAND_TIMEOUT), NO_ERROR when none; cleared by this call

' Local Variables:
' @local nEvents - the front cog's command-timeout count, read once

    ' A latched protective stop is reported first, and is not cleared here: only clearProtectiveStop() releases it.
    ' A slot is read and cleared only by its own cog, and written only by that cog's recordError(),
    '  so another cog's calls can neither erase nor steal this cog's error.
    eError := protectiveCode
    if eError == NO_ERROR
        eError := lastError[COGID()]
        lastError[COGID()] := NO_ERROR
    ' S-8: the front cog counts the timeouts it took (its long alone); each cog records how many it has been
    '  told of (its own long alone), so every cog hears of every timeout once and no long has two writers
    nEvents := cmdTimeoutEvents
    if (eError == NO_ERROR) and (cmdTimeoutSeen[COGID()] <> nEvents)
        eError := ERR_COMMAND_TIMEOUT
        cmdTimeoutSeen[COGID()] := nEvents

PUB getStopReason() : eReason
'' Return why the last drive ended: the first stop after the last accepted drive command
''
'' A drive is opened by a non-zero power, driveForDistance() or a non-zero test increment the motor accepted; a refused
'' command opens nothing. The first stop after it is the reason, and it stays readable until the next accepted drive
'' command; a later stop of the resting motor changes nothing (the event log, getEvent(), still reports a fault). The one
'' exception: SR_FAULT_CONTROLLED becomes SR_FAULT_LOST when a second fault latches on that controlled stop. This is not
'' an error code, and getStatus() is unchanged by it. LIMIT: when a running front cog fails to answer a stop in time the
'' caller's cog stops the motor directly and records nothing, so a drive left open then reads SR_NONE.
''
'' @returns eReason - SR_COMMANDED, SR_AT_LIMIT, SR_FAULT_CONTROLLED, SR_FAULT_LOST, SR_BLOCKED, SR_LINK_LOST or SR_EMERGENCY; SR_NONE while a drive is open, or when none has ended since start()

    eReason := stopReason

PUB getEvent() : eKind, nMs, nValue
'' Return this cog's oldest unread event from the motor's soft-event log, or EV_NONE when it has read them all
''
'' The log holds what the motor handled on its own (EV_* in the constants): a stop and its reason, a fault, the hold's
'' hand-off, a current limit, hall trouble, a late front pass, the pack sensor, a start check that needed a retry.
'' Every cog that calls this reads the whole log for itself, in order: no cog can take another's event. A cog that
'' falls more than EV_QUEUE_DEPTH events behind loses its oldest, and is told first, with EV_LOST: a lost event never
'' reads as EV_NONE. start() empties the log. The peak current fold-back is logged as EV_FOLDBACK, its engage and its
'' release only; each frame it acted is not.
''
'' @returns eKind - the EV_* kind; EV_NONE when nothing is unread, EV_LOST when events were lost before the next one
'' @returns nMs - getms() when the event was queued (for EV_LOST, getms() now); 0 for EV_NONE
'' @returns nValue - the event's value, meaning per EV_* (for EV_LOST, how many were lost); 0 for EV_NONE

    eKind, nMs, nValue := readEvent(TRUE)

PUB peekEvent() : eKind, nMs, nValue
'' INTERNAL USE: return what getEvent() would return on this cog, without reading it (for isp_steering_2wheel's merge)
''
'' The next getEvent() on this cog returns the same event, or EV_LOST if the log lapped this cog in between.
''
'' @returns eKind - the EV_* kind; EV_NONE when nothing is unread, EV_LOST when events were lost before the next one
'' @returns nMs - getms() when the event was queued (for EV_LOST, getms() now); 0 for EV_NONE
'' @returns nValue - the event's value, meaning per EV_* (for EV_LOST, how many were lost); 0 for EV_NONE

    eKind, nMs, nValue := readEvent(FALSE)

PUB getEventTotal(eKind) : nCount
'' Return how many events of one kind the motor has queued since start(), read or not, lost or not
''
'' @param eKind - an EV_* kind from EV_STOP to EV_FOLDBACK
'' @returns nCount - the events of {eKind} since start(); 0, with ERR_BAD_COUNT recorded for getError(), for EV_NONE, EV_LOST or any other value

    nCount := 0
    if (eKind < EV_STOP) or (eKind > EV_FOLDBACK)
        recordError(ERR_BAD_COUNT)
    else
        nCount := evTotal[eKind - EV_STOP]

PUB getProtectiveStop() : eProtectiveCode
'' Return the latched protective stop's cause, without clearing it
''
'' @returns eProtectiveCode - ERR_PLATFORM_BLOCKED or another -2_0xx cause while a protective stop is latched, NO_ERROR when none

    eProtectiveCode := protectiveCode

PUB clearProtectiveStop() : eError
'' Acknowledge a protective stop: the motor stays stopped and may be driven again
''
'' While a protective stop is latched every drive is refused with its code, and clearEmergency() does not release it.
''
'' @returns eError - NO_ERROR once released, or ERR_NOT_STARTED / ERR_NO_RESPONSE, also recorded for getError()

    ' the front cog writes a zero command before releasing, so nothing moves on the clear
    eError := recordError(postRequest(REQ_CLEAR_PROTECT, 0, 0, 0))

PUB testSetCurrentLimits(peakAmps, contAmps) : eError
'' TEST USE: replace the peak and continuous phase-current limits (so a wheels-lifted rig can reach them)
''
'' @param peakAmps - the peak limit the driver folds back at, amps [1..I_PEAK_A]
'' @param contAmps - the continuous limit the front cog derates to, amps [1..peakAmps]
'' @returns eError - NO_ERROR, ERR_BAD_COUNT for a limit out of range, or ERR_NOT_STARTED / ERR_NO_RESPONSE, also recorded for getError()

    if (peakAmps < 1) or (peakAmps > I_PEAK_A) or (contAmps < 1) or (contAmps > peakAmps)
        eError := recordError(ERR_BAD_COUNT)
    else
        eError := recordError(postRequest(REQ_SET_LIMITS, peakAmps, contAmps, 0))

PUB testForceFault() : eError
'' TEST USE: fault the motor on its next driven frame, as if the rotor had lost the field -- a safe, repeatable stand-in
'' for a provoked position fault (R19.3)
''
'' The driver takes it where it takes a real fault and answers per setFaultResponse(); getFaultCause() then reads
'' FC_LAG, since the halls are legal. A second call while a re-synced stop is still ramping down takes the fallback
'' (the graded short, or a coast). A request made while the bridge is not driven (coasting, shorted, faulted) is
'' dropped, never kept for later; the hold at rest (holdAtStop(TRUE)) does drive the bridge, so it is taken there.
''
'' @returns eError - NO_ERROR, or ERR_NOT_STARTED / ERR_NO_RESPONSE, also recorded for getError()

    eError := recordError(postRequest(REQ_FORCE_FAULT, 0, 0, 0))

PUB testSetProbeWithhold(ePhase) : eError
'' TEST USE: leave {ePhase} undriven in the next start()'s lead check, as a phase whose switch cannot drive it -- a
'' negative control for HLT_PHASE_U/V/W that needs no rewiring (task 3613: the rig cannot open a motor lead)
''
'' Call before start(); it applies to that one start, in every attempt its retries make (so the start is refused unless
'' setStartChecks(FALSE)), and the checks clear it when they end. The withheld phase reads the coasting floor where its
'' driven reading belongs, so exactly its own HLT_PHASE_* bit fails, and nothing moves. An open winding fails the follow
'' test instead, and this cannot make one.
''
'' @param ePhase - PRB_U, PRB_V or PRB_W to withhold; PRB_NONE clears it
'' @returns eError - NO_ERROR, or ERR_BAD_COUNT for a value out of range, also recorded for getError()

    if (ePhase < PRB_NONE) or (ePhase > PRB_W)
        eError := recordError(ERR_BAD_COUNT)
    else
        testProbeWithhold := ePhase
        eError := recordError(NO_ERROR)

PUB testSetProbeWithholdFirst(ePhase) : eError
'' TEST USE: leave {ePhase} undriven in the FIRST attempt only of the next start()'s lead check, so its HLT_PHASE_* bit
'' fails once and then passes on the retry -- the positive control for getHealth()'s {nRecovered} and EV_CHECK_RETRY
''
'' Call before start(); it applies to that one start's first attempt, and the checks clear it when they end.
''
'' @param ePhase - PRB_U, PRB_V or PRB_W to withhold; PRB_NONE clears it
'' @returns eError - NO_ERROR, or ERR_BAD_COUNT for a value out of range, also recorded for getError()

    if (ePhase < PRB_NONE) or (ePhase > PRB_W)
        eError := recordError(ERR_BAD_COUNT)
    else
        testProbeWithholdFirst := ePhase
        eError := recordError(NO_ERROR)

PUB testSetWindingProbe(bEnable) : eError
'' TEST USE: have the next start()'s checks also measure each winding pair's resistance (R19.4 1e)
''
'' Call before start(); it applies to that one start, and the check clears it. Each pair in turn (U->V, V->W, W->U) is
'' driven at WIND_DUTY_PCT with the next phase's low side on, for 0.1 to 0.3 s, and read from the DC-link shunt. THE ROTOR
'' MOVES: it turns to each pair's alignment, up to half an electrical cycle, so use it wheels up or where a twitch is
'' safe. A phase withheld by testSetProbeWithhold() neither drives nor returns, so both pairs it belongs to read
'' WND_NOT_VISIBLE: the negative control.
''
'' @param bEnable - T/F where T measures the windings at the next start
'' @returns eError - NO_ERROR, also recorded for getError()

    bWindProbe := (bEnable <> FALSE)
    eError := recordError(NO_ERROR)

PUB testGetWinding(ePair) : eState, nMilliOhms, nNetMv
'' TEST USE: one winding pair's reading from the last start that measured the windings (R19.4 1e)
''
'' The resistance is d^2 x V / I_dc. V is the pack voltage the pack sensor read at that start when it is fitted and read
'' a pack, else the nominal drive voltage (getDriveVoltage()), with which a pack below nominal reads proportionally low.
'' testGetWindingVoltage() says which V it was (R20.4).
''
'' @param ePair - 0 for U->V, 1 for V->W, 2 for W->U
'' @returns eState - WND_NOT_RUN, WND_MEASURED, WND_NOT_VISIBLE, WND_TRIPPED or WND_UNSETTLED (WND_NOT_RUN for a pair out of range)
'' @returns nMilliOhms - the pair's resistance in milliohms when WND_MEASURED, else 0
'' @returns nNetMv - the pair's averaged DC-link reading over the rest zero, mV (0 when WND_NOT_RUN)

    eState := WND_NOT_RUN
    nMilliOhms := 0
    nNetMv := 0
    if (ePair >= 0) and (ePair <= 2)
        eState := windState[ePair]
        nNetMv := windNetMv[ePair]
        if eState == WND_MEASURED
            nMilliOhms := windMohm[ePair]

PUB testGetWindingVoltage() : ePackStatus, nMilliVolts
'' TEST USE: the drive voltage the last winding check computed its resistances with, and where it came from (R20.4)
''
'' @returns ePackStatus - PACK_PRESENT: the pack sensor's reading at that start; PACK_ABSENT (fitted, but it read no pack)
''   or PACK_NOT_FITTED (not fitted, or not readable by this instance): the nominal drive voltage was used
'' @returns nMilliVolts - that voltage, mV; 0 (with PACK_NOT_FITTED) before a start has measured the windings

    ePackStatus := windVoltSrc
    nMilliVolts := windVoltMv

PUB testSetHallSwap(eSwap) : eError
'' TEST USE: have the driver read two hall inputs as swapped from the next start(), as a mis-wired hall pair would -- a
'' negative control for checkWiring() that needs no rewiring (task 3613: the rig cannot swap hall wires)
''
'' Call before start(); it applies to that one start, and init() clears it. init() permutes its copy of the hall tables,
'' so the driver commutes and counts position exactly as it would with those two wires swapped: a drive may jerk or
'' stall. The drive loop does no extra work.
''
'' @param eSwap - HSW_HALLS_01, HSW_HALLS_12 or HSW_HALLS_02: the two hall-code bits read as swapped; HSW_NONE clears it
'' @returns eError - NO_ERROR, or ERR_BAD_COUNT for a value out of range, also recorded for getError()

    if (eSwap < HSW_NONE) or (eSwap > HSW_HALLS_02)
        eError := recordError(ERR_BAD_COUNT)
    else
        testHallSwap := eSwap
        eError := recordError(NO_ERROR)

PUB testGetFaultResponse() : eMode, nBrakeOn, nResyncEvents
'' TEST USE: the fault response in effect, and how many faults it has re-synced since start (R19.3)
''
'' @returns eMode - FR_SHIPPED or FR_GRADED
'' @returns nBrakeOn - the graded short's shorted PWM frames in each brake period of BRAKE_PERIOD_FRAMES
'' @returns nResyncEvents - faults answered by a re-sync and a controlled stop since start

    eMode := fault_mode
    nBrakeOn := brake_on
    nResyncEvents := faultResyncEvents

PUB testGetHold() : nHoldDuty, nCeilDuty, nCeilPasses, nSlipEvents, nLimitEvents
'' TEST USE: the hold's internals, to judge a bench cell (R19.1)
''
'' @returns nHoldDuty - the duty the driver applies at rest now
'' @returns nCeilDuty - the hold's duty ceiling
'' @returns nCeilPasses - consecutive front passes (ms) the hold has spent at its ceiling
'' @returns nSlipEvents - holds ended by a slip since start
'' @returns nLimitEvents - holds ended by the time limit since start

    nHoldDuty := hold_duty
    nCeilDuty := holdCeilDuty
    nCeilPasses := holdCeilPasses
    nSlipEvents := holdSlipEvents
    nLimitEvents := holdLimitEvents

PUB getDistance(eDistanceUnits) : nDistanceInUnits | fMMpTick, fValue, ticsPerRotation
'' Returns the odometer: the distance in {distanceUnits} [DDU_MM, DDU_CM, DDU_IN, DDU_FT, DDU_M, DDU_KM, DDU_MI] travelled by this motor since the last resetTracking() or start()
''
'' PL-153: TOTAL travel, never negative -- forward and back both add to it (backing up is travel too). Only
'' resetTracking() and start() reset it. RESOLUTION: the count is whole hall ticks (about 5.76 mm on the 6.5in wheel),
'' and the result is rounded to the nearest whole unit: DDU_M reads 0 until 0.5 m, DDU_MI until half a mile.
''
'' @param eDistanceUnits - units of the returned distance: DDU_MM, DDU_CM, DDU_IN, DDU_FT, DDU_M, DDU_KM or DDU_MI
'' @returns nDistanceInUnits - distance travelled, rounded to the nearest unit; 0, with ERR_BAD_UNITS or ERR_NO_WHEEL_DIA recorded for getError(), when it cannot be measured

' Local Variables:
' @local fMMpTick - wheel travel per hall tick, in mm (float)
' @local fValue - distance travelled in mm or inches (float), before the final unit conversion
' @local ticsPerRotation - hall ticks per rotation for this motor

    nDistanceInUnits := 0
    ' the divisor comes from the compile-time configuration, not from init(), so a call before start()
    '  divides by no zero (circInMM_x10 is 0 until then, which only makes the distance 0)
    _, ticsPerRotation := hallTicInfoForMotor()
    ' if we know the wheel diameter, then calculate value and return it
    if user.WHEEL_DIA_IN_INCH == 0.0
        recordError(ERR_NO_WHEEL_DIA)
        debug[user.DBGCH_ERROR]("! ERROR: getDistance() not supported when wheel dia. is unknown!")
    else
        fMMpTick := float(circInMM_x10) /. float(ticsPerRotation) /. 10.0
        case eDistanceUnits
            DDU_MM:
                nDistanceInUnits := round(float(posTrkHallTicks) *. fMMpTick)
            DDU_CM:
                nDistanceInUnits := round(float(posTrkHallTicks) *. fMMpTick /. 10.0)
            DDU_IN:
                fValue := distConv.fMm2inFloat(float(posTrkHallTicks) *. fMMpTick)
                nDistanceInUnits := round(fValue)
            DDU_FT:
                fValue := distConv.fMm2inFloat(float(posTrkHallTicks) *. fMMpTick)
                nDistanceInUnits := round(fValue /. 12.0)                       ' in FT
            DDU_M:
                fValue := float(posTrkHallTicks) *. fMMpTick
                nDistanceInUnits := round(fValue /. 1000.0)                     ' in M
            DDU_MI:
                fValue := distConv.fMm2inFloat(float(posTrkHallTicks) *. fMMpTick)
                nDistanceInUnits := round(fValue /. 5280.0 /. 12.0)             ' in MI
            DDU_KM:
                fValue := float(posTrkHallTicks) *. fMMpTick
                nDistanceInUnits := round(fValue /. 1000.0 /. 1000.0)           ' in kM
            other:
                recordError(ERR_BAD_UNITS)
                debug[user.DBGCH_ERROR]("! ERROR: invalid distanceUnits Value:", udec_long(eDistanceUnits))

PUB getRotationCount(eRotationUnits) : rotationCount | degreesPerTic, ticsPerRotation
'' Returns the odometer as a rotation: {rotationCount} in {rotationUnits} [DRU_DEGREES, DRU_ROTATIONS, or DRU_HALL_TICKS] since the last resetTracking() or start(), for this motor.
''
'' PL-153: total rotation either way, never negative, as getDistance(). RESOLUTION (PL-158): DRU_HALL_TICKS counts
'' each tick; DRU_DEGREES is ticks x degrees per tick, so it steps by 4 degrees (6.5in motor) or 15 (DocoEng);
'' DRU_ROTATIONS counts WHOLE rotations completed, truncated (89 ticks of a 90-tick rotation read 0).
''
'' @param eRotationUnits - units of the returned rotation: DRU_HALL_TICKS, DRU_DEGREES or DRU_ROTATIONS
'' @returns rotationCount - rotation accumulated; 0, with ERR_BAD_UNITS recorded for getError(), when the units are not DRU_*

' Local Variables:
' @local degreesPerTic - degrees of rotation per hall tick for this motor
' @local ticsPerRotation - hall ticks per rotation for this motor

    rotationCount := 0
    ' geometry from the compile-time configuration, not from init(), so a call before start() divides by no zero
    degreesPerTic, ticsPerRotation := hallTicInfoForMotor()
    case eRotationUnits
        DRU_HALL_TICKS:
            rotationCount := posTrkHallTicks
        DRU_DEGREES:
            ' degrees = ticks * 4 (6.5" wheel)
            rotationCount := posTrkHallTicks * degreesPerTic
        DRU_ROTATIONS:
            ' rotations = ticks / 90 (6.5" wheel)
            rotationCount := posTrkHallTicks / ticsPerRotation
        other:
            recordError(ERR_BAD_UNITS)
            debug[user.DBGCH_ERROR]("! ERROR: invalid rotationUnits Value:", udec_long(eRotationUnits))

PUB getPower() : nPower
'' Returns the last specified power value [-100 thru +100] for motor (will be zero if the motor is stopped).
''
'' @returns nPower - the last commanded power [-100 to 100]; 0 once the motor is stopped

    nPower := motorPower

PUB restZeroBegin() : eStatus | startMs
'' INTERNAL USE: PL-45 step 1 of 3 -- wait, bounded, for a real sense_i_mV to exist, then reset the rest-zero accumulator
''
'' Waits, bounded (REST_ZERO_READY_TIMEOUT_MS), for hub drv_state to leave init()'s DCS_Unknown. The
'' driver's status block-copy writes drv_state and sense_i_mV together, so the first changed drv_state
'' proves sense_i_mV carries a real ADC reading; before it, sense_i_mV is whatever init() or a prior
'' instance left. init() sets DCS_Unknown before every new driver cog is launched, so a restart
'' cannot pass this wait on the previous instance's state.
''
'' On a bound expiry (the driver never reached its first pass), restZeroSenseMv is left at 0: no
'' correction, rather than a stale hub value mistaken for a measurement.
''
'' @returns eStatus - NO_ERROR once a real sense_i_mV is confirmed, or ERR_NO_RESPONSE if the bound expired (restZeroSenseMv is left/reset to 0)

' Local Variables:
' @local startMs - getms() when the readiness wait began

    restZeroSampleSum := 0
    restZeroSampleCount := 0
    eStatus := NO_ERROR
    startMs := getms()
    repeat while drv_state == DCS_Unknown
        if getms() - startMs > REST_ZERO_READY_TIMEOUT_MS
            eStatus := ERR_NO_RESPONSE
            quit
        waitms(REQ_POLL_MS)
    if eStatus <> NO_ERROR
        restZeroSenseMv := 0                                                       ' no correction, not a stale value
        applySenseZero()                                                           ' PL-146: and none in the driver's fold-back

PUB restZeroAddSample()
'' INTERNAL USE: PL-45 step 2 of 3 -- accumulate one sense_i_mV sample into the rest-zero total
''
'' Call REST_ZERO_SAMPLE_COUNT times, REST_ZERO_SAMPLE_MS apart, after a successful restZeroBegin();
'' skip it after a failed restZeroBegin(), as isp_steering_2wheel's start() does per wheel.

    restZeroSampleSum += sense_i_mV
    restZeroSampleCount++

PUB restZeroFinish()
'' INTERNAL USE: PL-45 step 3 of 3 -- average the accumulated samples into restZeroSenseMv
''
'' A no-op (restZeroSenseMv stays at whatever restZeroBegin() left it, 0 on a failed begin) if
'' restZeroAddSample() was never called since restZeroBegin(). Either way the driver's fold-back is handed the
'' result (PL-146, applySenseZero()).
'' DRIVER_REV 40: the offset, not the mean. Each sample is a FLOORED mV reading (the driver's sar #11), and with the
'' +-3 mV noise spreading the true value over several counts a floored reading averages half a count low, so the
'' offset is the mean + 0.5, rounded to the nearest mV: floor(mean + 1), with the mean floored (never truncated
'' toward 0: a rest zero may be negative) -- unbiasedMeanMv(), which measureWindings() shares. Until then it was the
'' TRUNCATED mean, 0.5 .. 1.5 mV under the offset.

    if restZeroSampleCount > 0
        restZeroSenseMv := unbiasedMeanMv(restZeroSampleSum, restZeroSampleCount)
    applySenseZero()

PUB captureRestZero() | idx
'' INTERNAL USE: sample the current-sense rest zero, with the drive floated (PL-45); ~1 s
''
'' Call once, after the driver is confirmed running and released, and before any drive request is
'' ever posted to it: start()/startEx() call this themselves. stop_mode is still init()'s SM_FLOAT at
'' that moment and nothing has commanded a nonzero power yet, so the driver's own .checkstop keeps
'' the bridge off for every sample.
''
'' Composed from restZeroBegin()/restZeroAddSample()/restZeroFinish(), so isp_steering_2wheel's
'' start() can sample both wheels in one ~1 s window. The sample count and spacing are explained at
'' REST_ZERO_SAMPLE_COUNT.

' Local Variables:
' @local idx - the sample loop counter

    if restZeroBegin() == NO_ERROR
        repeat idx from 1 to REST_ZERO_SAMPLE_COUNT
            waitms(REST_ZERO_SAMPLE_MS)
            restZeroAddSample()
        restZeroFinish()

PUB runStartChecks() : nStillFailed | nEverFailed, nIllegal0, nPhasesNow, eWithheld
'' INTERNAL USE: the checks start() runs at rest, nothing moving, after the rest zero (R19.4), with bounded retries
'' (R20.1); ~40 ms when every check passes
''
'' Call once, after captureRestZero() (or the owner's rest-zero window), before any drive request: start()/startEx()
'' call this themselves. Judges the hall code, the current sense's rest zero and each motor lead, and records the
'' verdict for getHealth(). The lead check (BR_PROBE) switches one phase at 50 % with the other two off: there is no
'' current path, so nothing moves, and through the windings the undriven phases' voltages follow the driven one's.
'' A phase that follows no other phase, or cannot itself be driven, fails its HLT_PHASE_* bit.
'' A refusing check (START_CHECKS_REFUSE) that fails is re-run, up to START_CHECK_RETRIES times START_CHECK_RETRY_MS
'' apart, in this same driver lifetime, and only while it still fails: the lead probes again, the hall code legal with no
'' new illegal code during the gap, and the rest zero re-captured (captureRestZero(), ~1 s). A check that passes once
'' stays passed, so a failure a retry clears never refuses a start. Whether to refuse is the caller's (startEx()).
''
'' @returns nStillFailed - the START_CHECKS_REFUSE bits still failing after the retries; 0 when every refusing check passed

' Local Variables:
' @local nEverFailed - the refusing bits that failed in the first attempt
' @local nIllegal0 - hall_illegal before a retry's gap
' @local nPhasesNow - the HLT_PHASE_* bits one probe of the three leads failed
' @local eWithheld - the phase the first attempt's probes leave undriven (TEST-USE), PRB_NONE for none

    healthChecked := HLT_ALL_CHECKS
    healthFailed := 0
    healthRecovered := 0
    healthAttempts := 1
    if (bHallCodeLegal() == FALSE) or (hall_illegal <> 0)
        healthFailed |= HLT_HALLS
    if bSenseZeroOutOfBand() == TRUE
        healthFailed |= HLT_SENSE_ZERO
    eWithheld := testProbeWithhold
    if testProbeWithholdFirst <> PRB_NONE                                       ' TEST USE: the first attempt's own withheld phase
        eWithheld := testProbeWithholdFirst
    healthFailed |= probeLeads(eWithheld)
    if bWindProbe                                                               ' TEST USE (R19.4 1e): the winding pairs, first attempt only
        measureWindings()
    bWindProbe := FALSE                                                         ' TEST USE: applies to one start only
    nEverFailed := healthFailed & START_CHECKS_REFUSE

    ' R20.1: bounded retries of what still fails. A check that passes is never re-run, so it cannot fail again here.
    repeat while ((healthFailed & START_CHECKS_REFUSE) <> 0) and (healthAttempts <= START_CHECK_RETRIES)
        debug[user.DBGCH_LIFECYCLE]("* start checks: retry ", udec_long(healthAttempts), uhex_long(healthFailed))
        nIllegal0 := hall_illegal
        waitms(START_CHECK_RETRY_MS)                                            ' the gap a transient may pass in
        healthAttempts++
        if (healthFailed & HLT_HALLS) <> 0
            if (bHallCodeLegal() == TRUE) and (hall_illegal == nIllegal0)       ' legal now, and no new illegal code in the gap
                healthFailed &= !HLT_HALLS
        if (healthFailed & HLT_SENSE_ZERO) <> 0
            captureRestZero()                                                   ' nothing has driven the motor: a fresh rest zero
            if bSenseZeroOutOfBand() == FALSE
                healthFailed &= !HLT_SENSE_ZERO
        if (healthFailed & HLT_PHASES) <> 0
            nPhasesNow := probeLeads(testProbeWithhold)                         ' all three probes, re-judging only the failed bits
            healthFailed &= (!HLT_PHASES) | nPhasesNow                          ' a phase bit stays failed only if it fails again

    healthRecovered := nEverFailed & !healthFailed
    testProbeWithhold := PRB_NONE                                               ' TEST USE: a withheld phase applies to one start only,
    testProbeWithholdFirst := PRB_NONE                                          '  in every attempt (or the first only) of it
    nStillFailed := healthFailed & START_CHECKS_REFUSE
    debug[user.DBGCH_LIFECYCLE]("* start checks ", uhex_long(healthChecked), uhex_long(healthFailed), uhex_long(healthRecovered), udec_long(healthAttempts), sdec_long(restZeroSenseMv), sdec_long_array(@probeMv, 9))

PUB checkWiring() : eError | nStartPos, nMidPos, nMissed0, nIllegal0, bLegsOk
'' Move the wheel one electrical cycle forward and back (about 3.5 cm at the tyre on the 6.5in motor) to prove the hall
'' and phase wiring, and record the verdict as getHealth()'s HLT_WIRING
''
'' Opt-in: this moves the wheel, so call it only when the robot may move a little. It catches what start()'s checks,
'' which move nothing, cannot: a swapped hall pair, swapped phase leads, a dead hall line or a motor that does not
'' turn. Blocks about 1.3 s (two legs of about 0.65 s on the built-in ramp), at most twice WALK_LEG_TIMEOUT_MS; the motor ends at rest per holdAtStop(). The
'' walk's travel, both legs, adds to the odometer (getDistance(), getRotationCount()), which it no longer resets
'' (PL-153); each leg's own distance counts from the leg's start. A leg that draws more current than a healthy
'' walk ever does (miswiring stalls the rotor against the field) is ended at once by shorting the phases, and fails.
'' The walk always runs on the built-in ramp (ACCEL_BUILTIN_MM_S2, DECEL_BUILTIN_MM_S2), whatever setAcceleration(),
'' setDeceleration() or setRampingValues() chose, and puts the program's own ramp back as it ends (DRIVER_REV 40).
''
'' @returns eError - NO_ERROR once the walk has run, whatever its verdict (getHealth()'s HLT_WIRING says it), or ERR_NOT_STARTED, or ERR_NO_RESPONSE (the front cog did not put the built-in ramp in force within its bound: nothing walked, nothing judged), also recorded for getError()

' Local Variables:
' @local nStartPos - the driver's hall position before the first leg
' @local nMidPos - the hall position between the legs
' @local nMissed0 - the missed-transition count before the walk
' @local nIllegal0 - the illegal-code long before the walk
' @local bLegsOk - T/F where T means both legs were driven, stopped at rest and did not fault

    eError := NO_ERROR
    if senseCog == 0
        eError := recordError(ERR_NOT_STARTED)
    else
        nMissed0 := hall_missed
        nIllegal0 := hall_illegal
        nStartPos := pos
        eError := walkRamps(TRUE)                                               ' DRIVER_REV 40: a fixed stimulus, IN FORCE before the first post
        if eError == NO_ERROR
            bLegsOk := bWalkLeg(WLEG_OUT, WALK_POWER)
            nMidPos := pos
            if bLegsOk == TRUE
                bLegsOk := bWalkLeg(WLEG_BACK, -WALK_POWER)
            else
                walkNoteLeg(WLEG_BACK, FALSE)                                   ' PL-137: its record reads not run, never an earlier walk's
            walkRamps(FALSE)                                                    ' every leg's ending (rest, fault, guard, timeout) returns here
            bJudgeWalk(nMidPos - nStartPos, pos - nMidPos, bLegsOk, (hall_missed == nMissed0) and (hall_illegal == nIllegal0))
        else
            walkRamps(FALSE)                                                    ' the flag back down: nothing walked, nothing judged
            walkNoteLeg(WLEG_OUT, FALSE)                                        ' PL-137: neither record reads an earlier walk's
            walkNoteLeg(WLEG_BACK, FALSE)
            eError := recordError(eError)

PUB walkRamps(bOn) : eError
'' INTERNAL USE: run the wiring walk on the built-in ramp (TRUE), or put the program's kept ramp back (FALSE) -- checkWiring(), and isp_steering_2wheel's around both wheels' legs
''
'' DRIVER_REV 40: the walk is a diagnostic with a fixed stimulus. Its timeout (WALK_LEG_TIMEOUT_MS) and its pass band
'' (WALK_SHORT_TICKS, WALK_OVERSHOOT_TICKS) are derived on the built-in ramp; on a user's slow ramp a leg could not
'' finish (setAcceleration(1): the limit fires ~8.3 s in, against the 2 s timeout) and a correctly wired motor failed
'' HLT_WIRING. The kept settings are never touched, so a setter called during the walk takes effect at its end.
'' DRIVER_REV 40: it only sets the walk's flag; the front cog that serves this motor applies the ramp (requestRamps(),
'' frontApplyRamps()), so a setter on another cog can no longer interleave with the restore and leave the built-in
'' ramp in force. On a running motor it returns once the front cog has applied it.
'' NO_ERROR from walkRamps(TRUE) is the walk's guarantee, and the only one: an apply that read the flag TRUE has
'' finished, and every later apply reads it TRUE too until walkRamps(FALSE), so the built-in ramp stays in force
'' however a setter interleaves. A caller posts no leg without it (checkWiring()); no walk request applies a ramp.
''
'' @param bOn - T/F where T means apply the built-in ramp now, F the kept one
'' @returns eError - NO_ERROR once the front cog has applied it; ERR_NOT_STARTED when no start has applied the settings (only the flag is set: the next start() clears it, init()); ERR_NO_RESPONSE when the front cog did not apply it within REQ_ACK_TIMEOUT_MS (it stays asked for). Recorded nowhere

    bWalkRamps := bOn                                                           ' first: the front cog's apply reads it
    eError := ERR_NOT_STARTED
    if bSettingsLive == TRUE
        eError := requestRamps()

PUB bJudgeWalk(nFwdTicks, nRevTicks, bLegsOk, bHallsClean) : bPassed
'' INTERNAL USE: judge a wiring walk and record it as HLT_WIRING (checkWiring(), and isp_steering_2wheel's per wheel)
''
'' @param nFwdTicks - the first leg's raw hall ticks
'' @param nRevTicks - the second leg's raw hall ticks
'' @param bLegsOk - T/F where T means both legs were driven, stopped at rest and did not fault
'' @param bHallsClean - T/F where T means no missed transition and no illegal code during the walk
'' @returns bPassed - T/F where T means the walk proves the wiring

    walkFwdTicks := nFwdTicks
    walkRevTicks := nRevTicks
    ' DRIVER_REV 40: each leg's band is derived at WALK_SHORT_TICKS (the lag the rotor may take on after the limit fires)
    bPassed := bLegsOk and bHallsClean and (abs(nFwdTicks) >= WALK_TICKS - WALK_SHORT_TICKS) and (abs(nFwdTicks) <= WALK_TICKS + WALK_OVERSHOOT_TICKS)
    bPassed &= (abs(nRevTicks) >= WALK_TICKS - WALK_SHORT_TICKS) and (abs(nRevTicks) <= WALK_TICKS + WALK_OVERSHOOT_TICKS) and ((nFwdTicks > 0) <> (nRevTicks > 0))
    healthChecked |= HLT_WIRING
    if bPassed == TRUE
        healthFailed &= !HLT_WIRING
    else
        healthFailed |= HLT_WIRING
    debug[user.DBGCH_LIFECYCLE]("* wiring walk ", sdec_long(nFwdTicks), sdec_long(nRevTicks), sdec_long(bLegsOk), sdec_long(bHallsClean), sdec_long(bPassed))

PUB testGetWalk() : nFwdTicks, nRevTicks
'' TEST USE: the raw hall ticks each leg of the last wiring walk moved (R19.4)
''
'' @returns nFwdTicks - the first leg's ticks
'' @returns nRevTicks - the second leg's ticks

    nFwdTicks := walkFwdTicks
    nRevTicks := walkRevTicks

PUB walkNoteLeg(eLeg, bRan) | eDrvState
'' INTERNAL USE: end walk leg {eLeg}'s record where checkWiring()'s wait for it ended (PL-137; checkWiring(), and
'' isp_steering_2wheel's per wheel)
''
'' Call it on the walking cog, the one writer of the end fields, right after the wait and before any stop or release
'' that follows it, so the record holds the state that ended the wait. The front cog goes on watching the position
'' until the next drive command (frontWalkWatch()), which is how the record learns where the rotor settled.
''
'' @param eLeg - WLEG_OUT or WLEG_BACK; any other value records nothing
'' @param bRan - T/F where T means the leg was posted and taken; F records it WLE_NOT_RUN

' Local Variables:
' @local eDrvState - the driver state read once, at the end of the wait

    if (eLeg >= WLEG_OUT) and (eLeg <= WLEG_BACK)
        if bRan == FALSE
            wlEnd[eLeg] := WLE_NOT_RUN
            wlEndMs[eLeg] := wlEndPos[eLeg] := wlLagHeld[eLeg] := WALK_NA
        else
            eDrvState := drv_state
            wlEndMs[eLeg] := getms() - wlPostMs[eLeg]
            wlEndPos[eLeg] := pos
            wlLagHeld[eLeg] := lag_held - wlLag0[eLeg]
            ' the first cause that holds, in WLE_*'s documented order: a state the wait ends on names its own cause,
            '  and a wheel that had not settled when the wait ended is the bound's
            if bWalkTripped == TRUE
                wlEnd[eLeg] := WLE_GUARD
            elseif (eDrvState == DCS_FAULTED) or (bWlFaultSeen[eLeg] == TRUE)
                wlEnd[eLeg] := WLE_FAULT
            elseif eDrvState == DCS_ESTOP
                wlEnd[eLeg] := WLE_ESTOP
            elseif eDrvState <> DCS_STOPPED
                wlEnd[eLeg] := WLE_TIMEOUT
            elseif wlLimMs[eLeg] <> WALK_NA
                wlEnd[eLeg] := WLE_LIMIT
            else
                wlEnd[eLeg] := WLE_OTHER
        bWlRan[eLeg] := bRan                                                    ' LAST: the end fields above are this leg's

PUB testGetWalkLeg(eLeg) : eEnd, nEndMs, nPostPos, nPeakPos, nLimitPos, nLimitMs, nLimitTrk, nLimitStopTicks, nStopPos, nStopMs, nEndPos, nSettlePos, nLastMoveMs, bSettleFinal, nLagHeld
'' TEST USE: one leg of the last wiring walk, as the driver saw it (PL-137) -- read it after checkWiring() returns
''
'' Positions are raw hall ticks (getRawHallTicks()); times are ms from the leg's post, when its command was written and
'' taken. A reading not taken is WALK_NA, and a leg that did not run (WLE_NOT_RUN, also any {eLeg} out of range) reads
'' WALK_NA throughout. The settle position is watched every front pass from the post until the next drive command --
'' the second leg's command, for the first leg -- so nothing guesses when the rotor has come to rest: bSettleFinal says
'' whether the watch has ended, and nLastMoveMs when the rotor last moved.
''
'' @param eLeg - WLEG_OUT or WLEG_BACK
'' @returns eEnd - WLE_*: how the leg ended, judged when checkWiring()'s wait for it ended
'' @returns nEndMs - ms from the post to the end of that wait: the leg's elapsed time
'' @returns nPostPos - the position the leg's distance limit counted from
'' @returns nPeakPos - the position furthest from nPostPos, either way, while watched
'' @returns nLimitPos - the position right after the distance limit's stop was written; WALK_NA if it never fired
'' @returns nLimitMs - ms from the post to the limit firing; WALK_NA if it never fired
'' @returns nLimitTrk - the tracked hall ticks it fired on, each step counted whichever way; WALK_NA if it never fired
'' @returns nLimitStopTicks - the stopping distance it allowed for, hall ticks; WALK_NA if it never fired
'' @returns nStopPos - the position when the driver first reported rest (DCS_STOPPED, DCS_FAULTED or DCS_ESTOP) after reporting the leg's motion; WALK_NA if it never did while watched
'' @returns nStopMs - ms from the post to that report; WALK_NA likewise
'' @returns nEndPos - the position at the end of the wait
'' @returns nSettlePos - the position when the watch ended, or the latest while it runs
'' @returns nLastMoveMs - ms from the post to the last position change while watched; WALK_NA if the rotor never moved
'' @returns bSettleFinal - T/F where T means the watch has ended (the next drive command), so nSettlePos is final; F if the leg did not run
'' @returns nLagHeld - drive passes the lag limiter held the field, from the post to the end of the wait

    eEnd := WLE_NOT_RUN
    nEndMs := nPostPos := nPeakPos := nLimitPos := nLimitMs := nLimitTrk := nLimitStopTicks := WALK_NA
    nStopPos := nStopMs := nEndPos := nSettlePos := nLastMoveMs := nLagHeld := WALK_NA
    bSettleFinal := FALSE
    if (eLeg >= WLEG_OUT) and (eLeg <= WLEG_BACK)
        if bWlRan[eLeg] == TRUE
            eEnd := wlEnd[eLeg]
            nEndMs := wlEndMs[eLeg]
            nPostPos := wlPostPos[eLeg]
            nPeakPos := wlPeakPos[eLeg]
            nLimitMs := wlLimMs[eLeg]
            if nLimitMs <> WALK_NA
                nLimitPos := wlLimPos[eLeg]
                nLimitTrk := wlLimTrk[eLeg]
                nLimitStopTicks := wlLimStopTk[eLeg]
            nStopMs := wlStopMs[eLeg]
            if nStopMs <> WALK_NA
                nStopPos := wlStopPos[eLeg]
            nEndPos := wlEndPos[eLeg]
            bSettleFinal := bWlClosed[eLeg]                                     ' first: a watch closing now leaves its final pos below
            nSettlePos := wlLastPos[eLeg]
            nLastMoveMs := wlLastMoveMs[eLeg]
            nLagHeld := wlLagHeld[eLeg]

PUB startPackSense() | nPin
'' INTERNAL USE: calibrate and start reading the pack voltage sensor, when user.PACK_SENSOR_FITTED (R19.5); ~2 ms
''
'' start()/startEx() call this themselves; isp_steering_2wheel calls it on its left wheel only, since a robot has one
'' pack. The pin is refused (not read, with a warning) when it lies inside this motor's own pin group or one another
'' started motor holds (R20.4: before, only its own). Adds HLT_PACK to getHealth(): it fails when the sensor reads no
'' pack.

' Local Variables:
' @local nPin - user.PACK_SENSE_PIN

    nPin := user.PACK_SENSE_PIN
    if user.PACK_SENSOR_FITTED <> FALSE
        if bPackPinUsable() == FALSE
            debug[user.DBGCH_WARNING]("! WARNING: PACK_SENSE_PIN ", sdec_long(nPin), " is not a free pin, the pack sensor is not read")
        else
            packCalibrate(nPin)
            packAvgRaw := packRead(nPin) << PACK_AVG_SHIFT                      ' PL-161: the average is kept in raw counts
            evLastPack := packStatusFor(packMvFromAvg())                        ' R20.1: EV_PACK reports changes from this, set before the front cog reads it
            bPackOwned := TRUE
            healthChecked |= HLT_PACK
            if packMvFromAvg() < PACK_ABSENT_MV
                healthFailed |= HLT_PACK
            debug[user.DBGCH_LIFECYCLE]("* pack sensor ", sdec_long(nPin), sdec_long(packGioRaw), sdec_long(packVioRaw), sdec_long(packMvFromAvg()))

PUB frontSamplePack(nRawSum, nSamples)
'' FRONT COG ONLY: once every WINDOW_PASSES passes, on PACK_PHASE -- fold the pack samples summed since the last call into the average (R19.5)
''
'' PL-161: the front cog reads the pin once a pass, inline, and only sums the raw samples (while isPackRead()); this
'' folds that sum in once a slot, on the pass phase PACK_PHASE, which carries no other slot work. No conversion is made
'' here: the average is kept in raw counts and converted to mV only when it is read (packMvFromAvg()). Every pass's
'' sample still reaches the average, so its noise is as before; only the arithmetic moved off the per-pass path.
'' A no-op on an instance that does not read the sensor (startPackSense()), or with no sample summed.
''
'' @param nRawSum - the pin's raw SINC2 samples (rdpin(user.PACK_SENSE_PIN)) summed since the last call
'' @param nSamples - how many samples {nRawSum} holds: WINDOW_PASSES, except in a front cog's first slot

    if (bPackOwned == TRUE) and (nSamples > 0)
        packAvgRaw += (((nRawSum << PACK_AVG_SHIFT) / nSamples) - packAvgRaw) SAR PACK_AVG_SHIFT

PUB isPackRead() : bRead
'' INTERNAL USE: whether this instance reads the pack sensor (startPackSense() took the pin), so its front cog sums the pin (PL-161)
''
'' isp_steering_2wheel reads it once as its front cog starts: only then may a front cog read the pin, since a pin this
'' instance refused may be a motor board's.
''
'' @returns bRead - T/F where T means the pack pin is this instance's to read; F when not fitted, refused or stopped

    bRead := bPackOwned

PUB getPackVoltage() : ePackStatus, nMilliVolts
'' Return the pack voltage from the optional pack voltage sensor (VOLTAGE-SENSOR.md), averaged over about 64 ms
''
'' The average takes one sample a millisecond, folded in every 8 ms (PL-161), and follows a change with a time
'' constant of about 60 ms.
''
'' @returns ePackStatus - PACK_PRESENT, PACK_ABSENT (fitted, but it reads no pack: unplugged or an open lead), or PACK_NOT_FITTED
'' @returns nMilliVolts - the pack voltage in mV, calibrated by user.PACK_SENSE_CAL_PERMILLE; 0 unless PACK_PRESENT

    ePackStatus := PACK_NOT_FITTED
    nMilliVolts := 0
    if bPackOwned == TRUE
        nMilliVolts := packMvFromAvg()
        ePackStatus := packStatusFor(nMilliVolts)
        if ePackStatus <> PACK_PRESENT
            nMilliVolts := 0

PUB testGetPackRaw() : nPinMv, nUncalMv, nGioRaw, nVioRaw | nRaw
'' TEST USE: the readings under getPackVoltage(), for the sensor's one-time calibration (R20.4)
''
'' Unlike getPackVoltage(), these are raw and ungated: they read whatever the pin holds, a pack or not.
''
'' @returns nPinMv - the pin's own voltage now, before the divider, mV: ONE SINC2 sample, ratiometric (0 unless read)
'' @returns nUncalMv - getPackVoltage()'s average WITHOUT user.PACK_SENSE_CAL_PERMILLE, mV: the reading the meter's is
''   divided by, CAL_PERMILLE = 1000 x meter / nUncalMv (0 unless read)
'' @returns nGioRaw - the ADC's GIO reading, taken when the sensor was started (0 unless read)
'' @returns nVioRaw - its VIO reading, likewise

' Local Variables:
' @local nRaw - the pin's latest SINC2 sample

    nPinMv := nUncalMv := nGioRaw := nVioRaw := 0
    if (bPackOwned == TRUE) and (packVioRaw > packGioRaw)
        nRaw := rdpin(user.PACK_SENSE_PIN)
        nPinMv := muldiv64(nRaw - packGioRaw, PACK_FULL_SCALE_MV, packVioRaw - packGioRaw) #> 0
        nUncalMv := muldiv64(packMvFromAvg(), 1000, user.PACK_SENSE_CAL_PERMILLE #> 1)
        nGioRaw := packGioRaw
        nVioRaw := packVioRaw

PUB getHealth() : nChecked, nFailed, nRecovered
'' Return what start() checked with the motor at rest, which checks failed, and which failed at first and then passed: HLT_* bits
''
'' HLT_HALLS (the hall sensors), HLT_SENSE_ZERO (the current sense), and HLT_PHASE_U, HLT_PHASE_V, HLT_PHASE_W (each
'' motor lead connected and drivable). An open lead fails its own bit; no motor at all fails all three. Nothing moves
'' during the checks. A check that fails is retried, up to START_CHECK_RETRIES times; one still failing after that
'' refuses the start (-1, ERR_START_CHECK_FAILED) unless setStartChecks(FALSE) was called, and these results stay
'' readable after the refusal. HLT_WIRING joins them once checkWiring() has run, and HLT_PACK with the pack sensor.
''
'' @returns nChecked - the HLT_* bits checked since start(); 0 before start()
'' @returns nFailed - the HLT_* bits that failed; 0 when every check passed
'' @returns nRecovered - the HLT_* bits that failed at least once and then passed on a retry (not in {nFailed}); 0 when none needed one

    nChecked := healthChecked
    nFailed := healthFailed
    nRecovered := healthRecovered

PUB testGetProbe(ePhase) : nUMv, nVMv, nWMv
'' TEST USE: the three phase voltages start()'s lead check read while probing {ePhase} (R19.4)
''
'' @param ePhase - PRB_U, PRB_V or PRB_W: the phase that was driven
'' @returns nUMv - the U phase's reading, mV; 0 for any other {ePhase}
'' @returns nVMv - the V phase's reading, mV
'' @returns nWMv - the W phase's reading, mV

    if (ePhase >= PRB_U) and (ePhase <= PRB_W)
        nUMv := probeMv[(ePhase - PRB_U) * 3 + 0]
        nVMv := probeMv[(ePhase - PRB_U) * 3 + 1]
        nWMv := probeMv[(ePhase - PRB_U) * 3 + 2]

PUB getCurrent() : fAmps, fWatts
'' Returns the latest current sense values, net of the rest zero taken at start (PL-45)
''
'' PL-159: despite their names, both results are INTEGERS, not floats. The first is the current in tenths of a
'' milliamp (nCurrent_0p1mA: 12_345 reads 1.2345 A); the second is the power in milliwatts (nPower_mW).
''
'' @returns fAmps - nCurrent_0p1mA: the motor current as an integer in tenths of a mA (amps x 10_000); 0, with ERR_BOARD_NOT_DETECTED recorded for getError(), when the board was never detected
'' @returns fWatts - nPower_mW: the motor power as an integer in mW; 0 under the same condition

    fAmps, fWatts := scaledCurrent()
    if rSenseForBoard == VALUE_NOT_SET
        ' PL-25: a never-detected board has no scale to divide by; a signed divide by -1 would
        '  otherwise flip every reading negative instead of reporting "no measurement". Recorded only
        '  here: this is a caller's command, not telemetry.
        recordError(ERR_BOARD_NOT_DETECTED)

PUB getMaxSpeed() : nSpeed
'' Returns the last specified {maxSpeed}
''
'' @returns nSpeed - the maximum speed last set by setMaxSpeed(), [1 to 100]; MAX_SPEED_DEFAULT (75) until one is set. The kept setting (PL-155), so it reads the same before start()

    nSpeed := usrMaxSpeed                                                       ' 0 until set: a VAR is 0 at load
    if nSpeed == 0
        nSpeed := MAX_SPEED_DEFAULT

PUB getMaxSpeedForDistance() : nSpeed4dist
'' Returns the last specified {maxSpeedForDistance}
''
'' @returns nSpeed4dist - the maximum speed for distance moves last set by setMaxSpeedForDistance(), [1 to 100]; MAX_SPEED_DEFAULT (75) until one is set, before start() as after

    nSpeed4dist := usrMaxSpeed4dist
    if nSpeed4dist == 0
        nSpeed4dist := MAX_SPEED_DEFAULT

PUB getDriveVoltage() : eVoltage, nMilliVolts
'' Return the drive (battery) voltage this motor was started for, and its nominal value
''
'' This is the PWR_* value given to start() -- the demos pass the user configuration's DRIVE_VOLTAGE -- not a
'' measurement. The optional pack sensor measures the supply: see getPackVoltage().
''
'' @returns eVoltage - the PWR_* value in effect; PWR_Unknown, with ERR_NOT_STARTED recorded for getError(), before the first start()
'' @returns nMilliVolts - the nominal voltage of {eVoltage} in mV (e.g. 18_500 for PWR_18p5V); 0 before the first start()

    eVoltage := eUserSelectedVolts
    nMilliVolts := nominalMilliVolts(eVoltage)
    if eVoltage == PWR_Unknown
        recordError(ERR_NOT_STARTED)

PUB getStatus() : eStatus
'' Returns status of motor drive state for this motor: enumerated constant: DS_Unknown, DS_MOVING, DS_HOLDING, DS_OFF, DS_FAULTED, or DS_ESTOP
''
'' PL-158: DS_HOLDING follows the hold itself: it reads only while the hold at rest (holdAtStop(TRUE)) is holding. A hold
'' that has handed off to the phase short (getHoldStatus() reads HS_SLIPPED or HS_LIMITED) is no longer holding, and
'' reads DS_OFF, as a coasting motor does: stopped, and not holding. getHoldStatus() tells the two apart.
''
'' @returns eStatus - DS_FAULTED while the driver is faulted (until a stop or a power is commanded), DS_ESTOP while emergency- or protectively stopped, DS_HOLDING when stopped and holding, DS_OFF when stopped and not holding (coasting, or the hold handed off to the phase short), DS_MOVING while otherwise running, DS_Unknown when the driver is not running

    eStatus := DS_Unknown                               ' if not one of the following status
    if isFaulted()                                      ' M: a faulted motor is not moving, so this is tested first
        eStatus := DS_FAULTED
    elseif isEmergency()                                ' M: nor is an emergency-stopped one
        eStatus := DS_ESTOP
    elseif isStopped()
        ' PL-158: the driver holds at rest only in SM_BRAKE with the hold not handed off (restBridge: hold_short set
        '  means the phases are shorted instead), so that is when it reads DS_HOLDING
        if (stop_mode == SM_BRAKE) and (hold_short == FALSE)
            eStatus := DS_HOLDING
        else
            eStatus := DS_OFF
    elseif isReady()
        eStatus := DS_MOVING

PUB getHoldStatus() : eHoldState, nDisplacement
'' Return what the hold at rest is doing (holdAtStop(TRUE)), and how far the load has moved the wheel from where it stopped
''
'' @returns eHoldState - HS_HOLDING while holding; HS_SLIPPED or HS_LIMITED when the hold has handed off to the phase short (the load moved the wheel past the hold, or it held at its ceiling too long); HS_OFF when not holding
'' @returns nDisplacement - hall ticks from the stop position this rest, signed; 0 when not holding

    eHoldState := holdState
    nDisplacement := holdDisp

PUB getHoldLimits() : ceilingPct, riseMs, limitMs
'' Return the limits of the hold at rest in effect, as setHoldLimits() set them (start() restores the defaults)
''
'' @returns ceilingPct - the hold's duty ceiling, % of the drive's full duty
'' @returns riseMs - ms from the minimum duty to the ceiling while the wheel stays displaced
'' @returns limitMs - ms at the ceiling before the hold hands off to the phase short

    ceilingPct := holdCeilPct
    riseMs := holdRiseMs
    limitMs := holdLimitMs

PUB getFaultResponse() : eMode, brakePct
'' Return the response to a position fault in effect, as setFaultResponse() set it (start() restores the default)
''
'' @returns eMode - FR_SHIPPED or FR_GRADED
'' @returns brakePct - the graded short's shorted time, % of each brake period

    eMode := fault_mode
    brakePct := faultBrakePct

PUB getDriverState() : eDrvrState
'' Return Enum [DCS_*] value representing state of driver
''
'' @returns eDrvrState - state of driver: enumerated constant DCS_*

    eDrvrState := drv_state

PUB getRawHallTicks() : nPos
'' Return the raw driver-maintained tick count
''
'' @returns nPos - the driver's hall-tick position count

    nPos := pos

PUB getHallIntegrityCounts() : nMissedTransitions, nIllegalCodes | nAllLowCodes, nAllHighCodes
'' Return the hall-sensor integrity counts the driver has accumulated since this motor was last started
''
'' @returns nMissedTransitions - times the hall code changed without a countable single step (a skipped transition), each leaving pos at least one tick short
'' @returns nIllegalCodes - times the hall sensors entered an illegal code (%000 or %111), meaning a dead or disconnected sensor; 0 before start (getHallIllegalCodes() splits it)

' Local Variables:
' @local nAllLowCodes - entries into %000, from getHallIllegalCodes()
' @local nAllHighCodes - entries into %111, from getHallIllegalCodes()

    nMissedTransitions := hall_missed
    nAllLowCodes, nAllHighCodes := getHallIllegalCodes()
    nIllegalCodes := nAllLowCodes + nAllHighCodes

PUB getHallIllegalCodes() : nAllLowCodes, nAllHighCodes | nIllegalWords
'' Return the illegal hall codes split by kind, since this motor was last started: all three lines low, and all three high
''
'' %000 is what a sensor that has lost power, or a line pulled low, reads; %111 is a line stuck or floating high.
'' Each count stops at 65_535.
''
'' @returns nAllLowCodes - times the hall sensors entered %000; 0 before start
'' @returns nAllHighCodes - times the hall sensors entered %111; 0 before start

' Local Variables:
' @local nIllegalWords - the driver's illegal-code long, read once: %000 entries in the low word, %111 in the high

    nIllegalWords := hall_illegal
    nAllLowCodes := nIllegalWords & HALL_ILL_WORD_MAX
    nAllHighCodes := nIllegalWords >> 16

PUB boardIdString() : pZStr
'' Return board ID string for this board revision
''
'' @returns pZStr - pointer to a zero-terminated string naming the detected (or user-forced) board revision

    case eDetectedBoard
        REV_Unknown:
            pZStr := @"No Board Connected"
        REV_A:
            pZStr := bUserForced ? @"64010 Rev A -USER FORCED" : @"64010 Rev A"
        REV_B:
            pZStr := bUserForced ? @"64010 Rev B -USER FORCED" : @"64010 Rev B"
        other:
            debug[user.DBGCH_ERROR]("* [CODE] bad return value from getBoardType()")
            pZStr := @"????"

PUB getBoardType() : eBoardRev | pSenseCommon, pinSum, readStartTicks, sumTicks, highTimeUs
'' ID Revision of attached BLDC driver board
''
'' @returns eBoardRev - REV_A or REV_B when a 64010 board is recognised at this pin group, else REV_Unknown (while this motor's driver is running: the revision recorded when it was started)

' Local Variables:
' @local pSenseCommon - the detection pin, pinbase + DETECT_SENSE_OFFSET
' @local pinSum - how many of the DETECT_READ_COUNT reads found the pin high
' @local readStartTicks - getct() taken just before the read loop
' @local sumTicks - ticks the whole read loop took, measured so the threshold does not depend on CLKFREQ
' @local highTimeUs - how long the released pin stayed high, in microseconds

{ Detection contract (auto-detect only; a forced BRD_REV_A / BRD_REV_B is returned as given):

   pinSum == 0                              -> REV_A        1K pulldown, first read already low
   pinSum >  DETECT_NODET_MIN_SUM           -> REV_Unknown  nothing discharges the pin: empty group
   high time <  DETECT_REVB_MIN_US          -> REV_Unknown  something pulls the pin down fast, but it is
                                                            not a Rev B sense node -- e.g. a group that
                                                            overlaps another board, whose base+4 is that
                                                            board's W low-side gate input
   otherwise                                -> REV_B        0.1uF sense node discharging

  The pin sum alone depends on CLKFREQ (more reads fit in the same discharge at a faster clock),
  so the Rev B floor is applied to the high TIME: pinSum x (loop ticks / reads) converted to
  microseconds. The loop body is unchanged; getct() is taken outside it.

  MEASURED at 270 MHz (bench 2026-09-11 / 2026-09-12, both rigs, rail on): real Rev B sums
  93-104 = 69-77 uS; the overlapping-group signature sums 1 (Rev B rig) and 7-9 (Rev A rig)
  = 1-7 uS; Rev A 0; empty 500. 20 uS sits about 3x above the overlap ceiling and 3x below the
  Rev B floor. The Rev B band was characterised with the rail powered only.

  Never measured under this motor's own running driver: base+4 is then the driver's ADC smart
  pin, the reading is meaningless and the pinclear() below would break the driver. In that
  case the revision recorded at start is returned unmeasured.
}

    ' returns one of REV_Unknown, REV_A, REV_B
    eBoardRev := REV_Unknown
    ' if user is overriding detection then use users' override value
    ' A2: eUserDetectionMode holds BRD_REV_A/BRD_REV_B (getInternalDetectMode()'s internal
    ' enum, 31/32), not REV_A/REV_B (21/22) -- comparing it against REV_A/REV_B here could
    ' never match, so a forced choice silently fell through to auto-detect every time. That in
    ' turn made A3's "-USER FORCED" string in boardIdString() describe the auto-detected value,
    ' not the one the user actually asked for. Fixing the comparison fixes both.
     case eUserDetectionMode    ' setup by init()
        BRD_REV_A:
            eBoardRev := REV_A
        BRD_REV_B:
            eBoardRev := REV_B
        other:
            ' do we know the base pin of the board...??
            if (pinbase == VALUE_NOT_SET) or (bHoldsPinBaseClaim() == FALSE)
                ' never initialised (or released by stop()): touch no pin -- pinbase may still read 0
                debug[user.DBGCH_DETECT]("BLDC: getBoardType() pinbase: ** NOT SET **")
            elseif motorCog <> 0
                ' this motor's driver owns base+0..13 right now: do not measure, do not pinclear
                eBoardRev := eDetectedBoard
                debug[user.DBGCH_DETECT]("BLDC: getBoardType() driver running, not measured; returning revision recorded at start ", udec_(eDetectedBoard))
            else
                ' yes, detect the board rev
                pinSum := 0
                pSenseCommon := pinbase + DETECT_SENSE_OFFSET
                'debug("BLDC: getBoardType() pinbase=(", udec_(pinbase), "), pSenseCommon=(", uhex_Long_(pSenseCommon), ")")
                pinclear(pSenseCommon)                  ' drop any smart-pin mode left on the pin, or pinread() returns its handshake flag
                pinhigh(pSenseCommon)                   ' charge 0.1uF capacitor on RevB boards
                waitms(DETECT_CHARGE_MS)
                pinfloat(pSenseCommon)                  ' release the pin, ready to read state

                readStartTicks := getct()
                repeat DETECT_READ_COUNT                ' check pin state DETECT_READ_COUNT times, x = sum of results
                    pinSum += pinread(pSenseCommon)
                sumTicks := getct() - readStartTicks
                highTimeUs := (pinSum * sumTicks / DETECT_READ_COUNT) / (ticks1us #> 1)
                ' Handle the result! (the detection contract is in the block comment above)
                if pinSum == 0
                    debug[user.DBGCH_DETECT]("--- ", udec(pinSum), ", 64010 Rev A, ", udec(highTimeUs))
                    eBoardRev := REV_A
                elseif pinSum > DETECT_NODET_MIN_SUM
                    debug[user.DBGCH_DETECT]("--- ", udec(pinSum), ", Board not detected!, ", udec(highTimeUs))
                elseif highTimeUs < DETECT_REVB_MIN_US
                    debug[user.DBGCH_DETECT]("--- ", udec(pinSum), ", Board not detected! (below Rev B band, overlapping group?), ", udec(highTimeUs))
                else
                    debug[user.DBGCH_DETECT]("--- ", udec(pinSum), ", 64010 Rev B, ", udec(highTimeUs))
                    eBoardRev := REV_B

                'debug("--- getBoardType() pinSum=(", udec_(pinSum), "), eBoardRev=(", udec_(eBoardRev), ")")

PUB isReady() : bState
'' Return T/F where T means the motor cog is running
''
'' @returns bState - T/F where T means the driver cog is running (its state is not DCS_Unknown)

    bState := (drv_state <> DCS_Unknown) ? true : false

PUB isStopped() : bState
'' Return T/F where T means the motor is stopped
''
'' @returns bState - T/F where T means the driver state is DCS_STOPPED

    bState := (drv_state == DCS_STOPPED) ? true : false

PUB isMoveDone() : bDone | eDrvState
'' Return T/F where T means the motor is not moving under a command: the last drive is over, however it ended (PL-156)
''
'' TRUE once the motor is at rest with no drive commanded (a limit, a stop, a timeout or a zero power ended it, or a
'' re-synced fault's controlled stop reached rest), and at once while it is faulted, emergency-stopped or protectively
'' stopped: nothing will move it until the program acts. FALSE from the moment a drive command is accepted -- even
'' before the driver has taken it -- and through its ramp down. A drive with no limit never ends by itself, so wait on
'' this with a bound, then read getStopReason() for why the drive ended. TRUE when the motor is not started. Unlike
'' isStopped(), which is only the rest state, a fault or an emergency stop ends the wait.
''
'' @returns bDone - T/F where T means no commanded motion is under way

' Local Variables:
' @local eDrvState - the driver state, read once

    eDrvState := drv_state
    ' the command is written (targetIncre) before the front cog answers the drive request, so a caller that has its
    '  answer never sees a stale rest: a non-zero command at DCS_STOPPED is a drive the driver has not taken yet
    bDone := (eDrvState == DCS_FAULTED) or (eDrvState == DCS_ESTOP) or (eDrvState == DCS_Unknown) or (eDrvState == DCS_RELEASED)
    bDone |= (eDrvState == DCS_STOPPED) and ((targetIncre & !SYNC_BIT) == 0)

PUB isFaulted() : bState
'' Return T/F where T means the motor is faulted now
''
'' @returns bState - T/F where T means the driver is faulted; it clears only when a stop or a power is commanded (isFaultSignal() keeps the record that it happened)

    bState := (drv_state == DCS_FAULTED) ? true : false

PUB isStarting() : bState
'' Return T/F where T means the motor is spinning up
''
'' @returns bState - T/F where T means the driver state is DCS_SPIN_UP

    'bState := (drv_state == DCS_SPIN_UP or drv_state == DCS_AT_SPEED) ? true : false
    bState := (drv_state == DCS_SPIN_UP) ? true : false
    'if not bState
    '    debug("MOT not at spin_up but at ", udec(drv_state))

PUB isTurning() : bState
'' Return T/F where T means the motor is rotating
''
'' @returns bState - T/F where T means the driver is running and neither stopped, faulted nor emergency-stopped

    bState := isReady() and not isStopped() and not isFaulted() and not isEmergency()

PUB isEmergency() : bState
'' Return T/F where T means the motor is emergency-stopped
''
'' @returns bState - T/F where T means the driver state is DCS_ESTOP

    bState := (drv_state == DCS_ESTOP) ? true : false

PUB isFaultSignal() : bState
'' Return T/F where T means the motor has faulted since it was started or since clearFaultSignal() was last called
''
'' @returns bState - T/F where T means the driver recorded a fault; unlike isFaulted() it stays set after the fault state clears

    bState := (fault <> false) ? true : false

PUB getFaultCause() : eCause
'' Return why the most recent fault since start() happened
''
'' The cause stays readable after the fault itself clears (a stop or a new power clears it); only a later fault
'' replaces it, and start() resets it to FC_NONE.
''
'' @returns eCause - FC_LAG (the rotor could not follow the field: an overload, a stall, or a wrong commutation offset), FC_HALL (a hall sensor read %000 or %111 at the fault: dead, unpowered or disconnected), or FC_NONE when there has been no fault

    eCause := faultCause

PUB clearFaultSignal() : eError
'' Reset the recorded fault indicator read by isFaultSignal()
''
'' @returns eError - NO_ERROR

' S-5: nothing clears the indicator automatically -- only this method (also called by testResetFault()) and a restart
    if fault
        debug[user.DBGCH_FAULT]("MTR: did reset fault ind.")
        fault := false
    eError := NO_ERROR

CON { --- PUBLIC Utility Methods --- }

PUB validBasePinForChoice(userBasePin) : legalBasePin
'' VALIDATE users' base-pin choice returns legalBasePin or INVALID_PIN_BASE
''
'' @param userBasePin - the base pin ENUM (PINS_*) to check
'' @returns legalBasePin - {userBasePin} when it is a legal group, else INVALID_PIN_BASE; no side effects (start() reports a group already in use)

    legalBasePin := INVALID_PIN_BASE
    if lookdown(userBasePin: PINS_P0_P15, PINS_P8_P23, PINS_P16_P31, PINS_P32_P47, PINS_P40_P55) <> 0
        legalBasePin := userBasePin
    debug[user.DBGCH_VALIDATE]("*VAL* ", sdec_long(legalBasePin))

PUB validVoltageForChoice(userVoltage) : legalVoltage
'' VALIDATE users' voltage choice returns legalVoltage or INVALID_VOLTAGE
''
'' @param userVoltage - the voltage ENUM (PWR_*) to check
'' @returns legalVoltage - {userVoltage} when this motor's power table holds it, else INVALID_VOLTAGE

    legalVoltage := userVoltage
    if powerTableIndex(userVoltage) == 0
        legalVoltage := INVALID_VOLTAGE
    debug[user.DBGCH_VALIDATE]("*VAL* ", sdec_long(legalVoltage))

PUB validMotorForChoice(userMotor) : legalMotor
'' VALIDATE users' motor choice returns legalMotor or INVALID_MOTOR
''
'' @param userMotor - the motor ENUM (MOTR_*) to check
'' @returns legalMotor - {userMotor} when it names a supported motor, else INVALID_MOTOR

    legalMotor := userMotor
    if lookdown(userMotor: MOTR_6_5_INCH, MOTR_DOCO_4KRPM) == 0
        legalMotor := INVALID_MOTOR
    debug[user.DBGCH_VALIDATE]("*VAL* ", sdec_long(legalMotor))

PUB validDetectModeForChoice(userDetMode) : legalMode
'' VALIDATE users' detection mode choice returns legalMode or INVALID_DET_MODE
''
'' @param userDetMode - the detection mode ENUM (BRD_*) to check
'' @returns legalMode - {userDetMode} when it is a BRD_* value, else INVALID_DET_MODE

    legalMode := userDetMode
    if lookdown(userDetMode: BRD_AUTO_DET..BRD_REV_B) == 0
        legalMode := INVALID_DET_MODE
    debug[user.DBGCH_VALIDATE]("*VAL* ", sdec_long(legalMode))

PUB hallTicInfoForMotor() : degreesPerTic, ticsPerRotation
'' Return numbers for user selected motor (for use by two-wheel-steering object!)
''
'' @returns degreesPerTic - degrees of rotation per hall tick for the configured motor
'' @returns ticsPerRotation - hall ticks per full rotation for the configured motor

    if user.MOTOR_TYPE == user.MOTR_DOCO_4KRPM
        ' degrees = ticks * 15
        degreesPerTic := 15
        ' rotations = ticks / 24
        ticsPerRotation := 24
    else
        ' degrees = ticks * 4
        degreesPerTic := 4
        ' rotations = ticks / 90
        ticsPerRotation := 90

PUB wheelGeometry() : nCircInMM_x10, nTickInMM_x100 | ticsPerRotation
'' Return the configured wheel's circumference and travel per hall tick (for use by two-wheel-steering object!)
''
'' @returns nCircInMM_x10 - wheel circumference, in tenths of a mm; 0 when the configured wheel diameter is 0
'' @returns nTickInMM_x100 - wheel travel per hall tick, in hundredths of a mm; 0 when the configured wheel diameter is 0

' Local Variables:
' @local ticsPerRotation - hall ticks per rotation for this motor

    nCircInMM_x10 := 0
    nTickInMM_x100 := 0
    if user.WHEEL_DIA_IN_INCH <> 0.0
        _, ticsPerRotation := hallTicInfoForMotor()
        ' task 3502: keep tenths of a mm -- circInMMforDiaInInchFloat() truncates to whole mm
        '  (518 for a 6.5in wheel against 518.68) before the x10, losing 0.13% of every distance
        nCircInMM_x10 := round(distConv.floatCircInMMforDiaInInchFloat(user.WHEEL_DIA_IN_INCH) *. 10.0)
        ' task 3502: mm-per-tick carried at x100 (not x10), rounded to nearest, so it keeps two
        '  fractional digits instead of one -- at x10 scale, 6.5in-wheel/90-tick motors truncate
        '  5.7 mm/tick against a true 5.763, a systematic -1.1% in every DDU_* conversion. Signed
        '  '/' is safe here: both operands are always non-negative (a wheel circumference and a tick count).
        nTickInMM_x100 := ((nCircInMM_x10 * 10) + (ticsPerRotation / 2)) / ticsPerRotation

PUB ticksForDistance(nDistance, eDistanceUnits) : eError, nStopTicks | nTickInMM_x100, nUnitInMM_x100
'' INTERNAL USE: validate a distance and convert it to hall ticks, with no side effects and nothing recorded (for isp_steering_2wheel)
''
'' @param nDistance - distance to travel, at least 1, resolving to at least one hall tick
'' @param eDistanceUnits - units of {nDistance}: DDU_MM, DDU_CM, DDU_IN, DDU_FT, DDU_M, DDU_KM or DDU_MI
'' @returns eError - NO_ERROR, ERR_BAD_COUNT (less than 1, or more hall ticks than a long holds), ERR_NO_WHEEL_DIA, ERR_BAD_UNITS or ERR_LIMIT_UNRESOLVABLE
'' @returns nStopTicks - the distance in hall ticks; meaningful only when {eError} is NO_ERROR

' Local Variables:
' @local nTickInMM_x100 - wheel travel per hall tick in hundredths of a mm, 0 when the wheel diameter is 0
' @local nUnitInMM_x100 - one {eDistanceUnits} in hundredths of a mm, 0 when it is not a DDU_* unit

    ' K: one integer conversion for every unit, exact for the imperial ones (1 in = 25.4 mm), 64-bit in
    '  the middle so a long distance in a large unit cannot overflow (was DDU_M's x100_000 at 21 km)
    eError := NO_ERROR
    nStopTicks := 0
    _, nTickInMM_x100 := wheelGeometry()
    nUnitInMM_x100 := unitInMM_x100(eDistanceUnits)
    if nDistance < 1
        eError := ERR_BAD_COUNT
    elseif nTickInMM_x100 == 0
        eError := ERR_NO_WHEEL_DIA
    elseif nUnitInMM_x100 == 0
        eError := ERR_BAD_UNITS
    elseif nDistance > maxDistanceInUnits(nUnitInMM_x100, nTickInMM_x100)
        eError := ERR_BAD_COUNT
    else
        nStopTicks := muldiv64(nDistance, nUnitInMM_x100, nTickInMM_x100)
        if nStopTicks < 1
            eError := ERR_LIMIT_UNRESOLVABLE

PUB testSetLimit(newMaxLimit) : eError
'' TESTING USE: set override limit so we can characterize motor
''
'' @param newMaxLimit - the driver angle increment that 100% power maps to, in both directions
'' @returns eError - NO_ERROR

    maxFwdIncreAtPwr := newMaxLimit
    maxRevIncreAtPwr := 0 - newMaxLimit
    minFwdIncreAtPwr := 0
    minRevIncreAtPwr := 0
    debug[user.DBGCH_TEST]("MOT: new limits: ", sdec(maxFwdIncreAtPwr), sdec(maxRevIncreAtPwr))
    eError := NO_ERROR

PUB testSetFwdRevOffsets(newOfsDegr, bFwdIsInverse) : eError | fwdDegrees, revDegrees
'' TESTING USE: set offsets so we can characterize motor current draw
''
'' Turns the dynamic lead schedule OFF, so the pair set here stays applied until
'' testSetLeadScheduled(TRUE); the call takes about a millisecond (see applyFixedOffsets()).
''
'' @param newOfsDegr - the commutation offset to apply, in degrees
'' @param bFwdIsInverse - T/F where T means forward is the inverse of reverse (DocoEng motor), F the reverse (6.5in motor)
'' @returns eError - NO_ERROR

' Local Variables:
' @local fwdDegrees - forward commutation offset, in degrees
' @local revDegrees - reverse commutation offset, in degrees

    if bFwdIsInverse
        ' forward is the inverse of reverse (ex. docoEng.com motor)
        fwdDegrees := 360 - newOfsDegr
        revDegrees := newOfsDegr
    else
        ' reverse is the inverse of forward (ex. 6.5" wheel motor)
        fwdDegrees := newOfsDegr
        revDegrees := 360 - fwdDegrees

    applyFixedOffsets(fwdDegrees, revDegrees)                                   ' R18.4: turns the lead schedule off
    debug[user.DBGCH_TEST]("MOT:  ", sdec(fwdDegrees), uhex_long(offset_fwd))
    debug[user.DBGCH_TEST](" (tst)", sdec(revDegrees), uhex_long(offset_rev))
    eError := NO_ERROR

PUB testSetFwdRevIndep(fwdDegrees, revDegrees) : eError
'' TESTING USE: set forward and reverse commutation offsets independently
''
'' This method allows separate control of the two offsets to characterize
'' motor current draw with asymmetric commutation angles. Both inputs are
'' normalised into 0..359 (by bounded add/subtract-360 steps) before they are
'' converted and applied, and the NORMALISED degrees are what testGetFwdRevIndep()
'' returns. Turns the dynamic lead schedule OFF, so the pair stays applied until
'' testSetLeadScheduled(TRUE); the call takes about a millisecond (see applyFixedOffsets()).
''
'' DETAIL: offset_fwd is applied to NEGATIVE motor increments and offset_rev to POSITIVE
'' motor increments -- the names do not describe the direction of travel.
'' These offsets are selected in the PASM2 driver at two locations:
'' - Hall-angle initialiser: testb tgt_incr, #31 wc / if_c add angle_, offset_fwd_
'' - Control loop: cmpm angle_, prior_angle wcz / wrc fwdrev / if_c add err_, offset_fwd_
'' CMPM sets C to MSB of (D - S), making NEGATIVE increments use offset_fwd (default 43 degrees
'' for 6.5in motor) and POSITIVE increments use offset_rev (default 317 degrees).
''
'' @param fwdDegrees - commutation offset for negative increments, in degrees (normalised into 0..359)
'' @param revDegrees - commutation offset for positive increments, in degrees (normalised into 0..359)
'' @returns eError - NO_ERROR

    ' FRAC's behaviour for a negative or >= 360 operand is not established, so the operand is
    '  always brought into 0..359 first (applyFixedOffsets() does it)
    applyFixedOffsets(fwdDegrees, revDegrees)                                   ' R18.4: turns the lead schedule off
    debug[user.DBGCH_TEST]("MOT:  ", sdec(offset_fwd_degrees), uhex_long(offset_fwd))
    debug[user.DBGCH_TEST](" (ind)", sdec(offset_rev_degrees), uhex_long(offset_rev))
    eError := NO_ERROR

PUB testGetFwdRevIndep() : fwdDegrees, revDegrees
'' TESTING USE: return the currently-applied forward and reverse commutation offsets
''
'' Returns the offsets that are ACTUALLY applied by the driver, whether set by init(),
'' the dynamic lead schedule (rounded to whole degrees), testSetFwdRevOffsets(), or
'' testSetFwdRevIndep(). This getter is used by automated offset scans (Bench Pass 2a)
'' to verify the offsets before sweeping.
''
'' @returns fwdDegrees - commutation offset for negative increments, in degrees
'' @returns revDegrees - commutation offset for positive increments, in degrees

    fwdDegrees := offset_fwd_degrees
    revDegrees := offset_rev_degrees

PUB testSetLeadScheduled(bEnable) : eError
'' TESTING USE: turn the dynamic lead schedule on or off
''
'' While on, this motor's front cog re-derives the commutation pair from the lead table
'' once per 8 ms slot (6.5in motor only). Setting an offset pair with testSetFwdRevOffsets()
'' or testSetFwdRevIndep() turns it off; this turns it back on.
''
'' @param bEnable - T/F where T means the schedule writes the pair; F leaves the pair as it is
'' @returns eError - NO_ERROR, or ERR_BAD_COUNT when {bEnable} is TRUE on a motor with no lead table

    eError := NO_ERROR
    if (bEnable == TRUE) and (user.MOTOR_TYPE <> MOTR_6_5_INCH)
        eError := ERR_BAD_COUNT
    else
        bLeadWritePending := TRUE                                               ' first, so the schedule's first slot writes the pair
        bLeadScheduled := (bEnable == TRUE)

PUB testGetLead() : bScheduled, leadTenths
'' TESTING USE: return whether the dynamic lead schedule is on, and the lead it gives at the field's present speed
''
'' @returns bScheduled - T/F where T means the front cog is writing the pair from the lead table
'' @returns leadTenths - the table's lead for the present |drv_incr_now|, in tenths of a degree

    bScheduled := bLeadScheduled
    leadTenths := leadTenthsForIncrement(abs(drv_incr_now))

PUB testDriveAtMotorIncrement(motorIncre) : eError
'' TESTING USE: set target accelleration to fix value
''
'' @param motorIncre - the driver angle increment to run at; 0 stops
'' @returns eError - NO_ERROR, or ERR_NOT_STARTED, ERR_EMERGENCY_STOPPED or ERR_NO_RESPONSE, also recorded for getError()

    eError := recordError(postRequest(REQ_TEST_INCREMENT, motorIncre, 0, 0))
    if eError <> NO_ERROR
        debug[user.DBGCH_ERROR]("! ERROR: testDriveAtMotorIncrement(", zstr_(@motorId), ") refused ", sdec_long(eError))

PUB testGetResults() : nMaxRPM, maxTics, bDidFault, max_mV
'' TESTING USE: return results of test pass
''
'' @returns nMaxRPM - highest RPM seen during the pass
'' @returns maxTics - highest hall-tick count seen in one second during the pass
'' @returns bDidFault - T/F where T means the driver recorded a fault (the isFaultSignal() indicator)
'' @returns max_mV - highest current-sense reading seen during the pass, in mV

    nMaxRPM := maxRpm
    maxTics := tvMaxCntsInSec
    bDidFault := fault
    max_mV := tvMaxSenseI
    'debug("MOT: result: ", udec(nMaxRPM), udec(maxTics), sdec(bDidFault))

PUB testResetFault() : eError
'' TESTING USE: reset our fault indicator that we tripped during test
''
'' @returns eError - NO_ERROR, or ERR_FAULT_NOT_CLEARED (also recorded for getError()) when the driver had not stopped by the end of the wait

    eError := NO_ERROR
    if fault
        debug[user.DBGCH_TEST]("MOT: reset fault...")
        ' PL-28(a), task 3616: the driver leaves DCS_FAULTED only when the front cog clears it, and a
        ' commanded stop does (frontStopCommanded()). So issuing the stop here, rather than waiting on
        ' the caller to have done so, guarantees the driver's next pass clears the fault. The stop goes
        ' through stopMotor(), the securing path, so the front cog writes it when one runs.
        stopMotor()
        clearFaultSignal()
        waitms(30) ' values will clear in 20ms but leave extra time to occur

        if not isStopped()
            debug[user.DBGCH_TEST]("MOT: wait until motor resets...")
            repeat 1000
                if isStopped()
                    quit
                else
                    waitms(2)
            if isStopped() == FALSE
                eError := recordError(ERR_FAULT_NOT_CLEARED)
                debug[user.DBGCH_TEST]("MOT: WAIT-fault-reset ended still-FAULT!")
    else
        debug[user.DBGCH_TEST]("MOT: testResetFault() NOT faulted!?")

PUB testResetMaxValues() : eError
'' TESTING USE: reset the accumulated maximum sense values, the rpm window and the position tracking
''
'' @returns eError - NO_ERROR once the front cog has applied the reset, or ERR_NOT_STARTED / ERR_NO_RESPONSE, also recorded for getError()

    eError := recordError(postRequest(REQ_RESET_MAX, 0, 0, 0))

PUB testGetTelemetry() : nDuty, nErr, nSenseI, nSenseU, nSenseV, nSenseW, eDrvrState, bDidFault
'' TESTING USE: snapshot the per-cycle driver status values in a single call
''
'' @returns nDuty - latest duty value reported by the driver
'' @returns nErr - latest position-error value reported by the driver
'' @returns nSenseI - latest current-sense reading, in mV
'' @returns nSenseU - latest phase-U sense reading, in mV
'' @returns nSenseV - latest phase-V sense reading, in mV
'' @returns nSenseW - latest phase-W sense reading, in mV
'' @returns eDrvrState - state of driver: enumerated constant DCS_*
'' @returns bDidFault - T/F where T means the driver has faulted

    ' NOTE: these longs are block-copied out of the driver every cycle. Reading them as one
    '  group here is far tighter than a series of separate calls, but it is still not atomic
    '  with respect to the driver - a sample can straddle a driver update.
    nDuty := duty
    nErr := err
    nSenseI := sense_i_mV
    nSenseU := sense_u_mV
    nSenseV := sense_v_mV
    nSenseW := sense_w_mV
    eDrvrState := drv_state
    bDidFault := (fault <> false) ? true : false

PUB testGetFollowing() : nMeasTicksSec, nCmdTicksSec, nPctOfCmd, bValid
'' TESTING USE: whether the drive is FOLLOWING its command -- the measured tick rate against the
'' commanded one, as a percentage
''
'' WHY THIS EXISTS (R18.1, harvested 2026-09-22). testGetDriveHealth() below counts the passes on
'' which each limiter ACTED, which says the drive ran out of authority but not how far behind it
'' ended up. This says how far. The bench instrument proved the quantity carries the answer before
'' the driver owned it: at the current wall the drive was following at 44-47 % of commanded while
'' duty saturated. Measuring that in a harness integrates nothing -- the drive itself could not tell
'' whether it was doing what it was told, and now it can.
''
'' HOW TO READ IT: 100 is following. Below 100 the motor is turning slower than commanded, and the
'' number keeps meaning something all the way down -- 0 is stalled, and unlike err (held near
'' LAG_HOLD and bounded by its own representation) or duty (pinned at its cap) it has no ceiling to
'' hide behind. NOT valid until the rpm window has filled, so a reading taken within the first second
'' of a command, or during a ramp, is a transient and {bValid} says so.
''
'' @returns nMeasTicksSec - measured hall ticks per second, the rpm window's own sum
'' @returns nCmdTicksSec - hall ticks per second the present command asks for, 0 when stopped
'' @returns nPctOfCmd - measured as a percentage of commanded; 100 is following, 0 is stalled
'' @returns bValid - T/F where T means the window is full and a non-zero rate is commanded

    nMeasTicksSec := hallWindowSum
    nCmdTicksSec := followCmdTicksSec
    nPctOfCmd := followPctOfCmd
    bValid := bFollowValid

PUB testGetDriveHealth() : nLagHeld, nDutyCapped, nDrvIncr, nPos
'' TESTING USE: the driver's two UNBOUNDED health counters, with the pair needed to interpret them
''
'' WHY THESE EXIST (R18.1, PL-95). The two quantities that say whether the drive is keeping up --
'' the position error and the duty -- both TOP OUT exactly when it stops keeping up: err is held near
'' LAG_HOLD by the lag limiter and is bounded by its own +-128 representation, and duty saturates at
'' duty_max and pins there. A measure that tops out reports nothing past its ceiling, which is where
'' the interesting behaviour is. These two count the control passes on which each limit ACTED, which
'' has no ceiling.
''
'' HOW TO READ THEM: difference each across a window, as getRawHallTicks() is differenced. The
'' fraction of passes counted is the fraction of the window the drive spent out of authority; zero
'' means it kept up throughout. nLagHeld multiplied by nDrvIncr is the field advance withheld.
''
'' @returns nLagHeld - control passes on which the limiter withheld the field advance, since driver start
'' @returns nDutyCapped - control passes on which the duty demand exceeded the cap, since driver start
'' @returns nDrvIncr - the field's increment per drive pass, so a withheld count converts to an advance
'' @returns nPos - the driver's hall-tick position, so the same read yields the measured travel

    ' read as one group, for the reason testGetTelemetry() gives: tighter than separate calls, and
    '  still not atomic against the driver's own block copy
    nLagHeld := lag_held
    nDutyCapped := duty_capped
    nDrvIncr := drv_incr_now
    nPos := pos

PUB testSetMotorReversed(bEnable) : eError
'' TESTING USE: set -or clear- the reversed-motor flag for this motor
''
'' @param bEnable - T/F where T means forward and reverse are swapped for this motor
'' @returns eError - NO_ERROR

    ' NOTE: the running motor's working copy only, for this run: the next start() applies the kept setting again
    '  (setForwardIsReverse(), PL-155, is the user's undo). A test that measures this motor both with and without
    '  the reversal puts it back here without changing what the program chose.
    motorIsReversed := bEnable
    eError := NO_ERROR

PUB testGetDriveConstants() : deadGap, pwmLimit, dutyMin, dutyMax, adcFrame, frameCnt
'' TESTING USE: snapshot the drive constants init() derived for the detected board/config
''
'' @returns deadGap - commutation dead-time, in system ticks
'' @returns pwmLimit - PWM duty hard limit, half the PWM frame less half the dead-time
'' @returns dutyMin - minimum duty value, the larger of 100 and half the dead-time, in 1/16ths
'' @returns dutyMax - maximum duty value, clamped to the PWM limit, in 1/16ths
'' @returns adcFrame - ADC sample period, set to the full PWM frame count
'' @returns frameCnt - PWM frame length in system ticks, derived from PWM_RATE_IN_HZ

    deadGap := dead_gap
    pwmLimit := pwm_limit
    dutyMin := duty_min
    dutyMax := duty_max
    adcFrame := adc_fram
    frameCnt := frame_cnt

PUB testGetDriveLevels() : nDriveU, nDriveV, nDriveW
'' TESTING USE: the three high-side PWM levels the driver wrote on its latest frame
''
'' Each is the P_PWM_TRIANGLE Y value, valid in 0 to frame_cnt / 2; the low side of the same phase is this plus
'' the dead-gap, so the PWM does not clip while each level is >= 0 and each level plus the dead-gap is <=
'' frame_cnt / 2. Debug-free, so a bench instrument cog may call it.
''
'' @returns nDriveU - phase U's high-side level, PWM counts
'' @returns nDriveV - phase V's high-side level, PWM counts
'' @returns nDriveW - phase W's high-side level, PWM counts

    ' read as one group, for the reason testGetTelemetry() gives: tighter than separate calls, and
    '  still not atomic against the driver's own block copy -- each value is a real level either way
    nDriveU := drive_u
    nDriveV := drive_v
    nDriveW := drive_w

PUB testSetDutyMin(nDutyMin) : eError
'' TESTING USE: set the duty floor the driver holds at rest and never drives below
''
'' @param nDutyMin - the duty floor, 1/16ths of a PWM count [half the dead-gap, in 1/16ths, to the duty ceiling]
'' @returns eError - NO_ERROR, or ERR_BAD_COUNT (also recorded for getError()) for a value outside that range; a rejected call changes nothing

    ' init()'s own floor on duty_min is half the dead-gap, so a value below it is one init() could never produce
    if (nDutyMin < (dead_gap / 2) << 4) or (nDutyMin > duty_max)
        eError := recordError(ERR_BAD_COUNT)
        debug[user.DBGCH_ERROR]("! ERROR: testSetDutyMin() rejected ", sdec_long(nDutyMin))
    else
        duty_min := nDutyMin
        eError := NO_ERROR

PUB testGetStopHallTicks() : stopTicks
'' TESTING USE: snapshot the pending hall-tick stop target set by stopAfterDistance()/stopAfterRotation()/driveForDistance()
''
'' @returns stopTicks - the armed limit's hall ticks, counted from where it was armed (PL-153); 0 when none is pending

    stopTicks := motorStopHallTicks

PUB testGetStopMs() : nMsDeadline
'' TESTING USE: snapshot the pending time limit set by stopAfterTime()
''
'' @returns nMsDeadline - the getms() value at which the stop begins to be at rest by, 0 when none is pending

    nMsDeadline := motorStopMSecs

PUB testGetRpm() : nRpm
'' TESTING USE: return the motor's current RPM, averaged over the hall-tick window
''
'' The window is HALL_WINDOW_SIZE samples, one every WINDOW_PASSES front-cog passes (1/FRONT_LOOP_HZ
'' sec each), so it spans 1 second of motion. Valid only while the front cog (started by start() for
'' a single motor, or by isp_steering_2wheel's start()) is running, and only from at least one full
'' window (~1 sec) after motion starts -- before that the window has not filled and the average
'' understates the true rate.
''
'' @returns nRpm - current RPM, averaged over the ~1 sec hall-tick window

    nRpm := rpm

PUB testGetFrontStats() : nPasses, nLatePasses, nMaxPassTicks, nStackHighWater | longIdx
'' TESTING USE: return the front cog's loop health counters and its stack high-water mark
''
'' @returns nPasses - passes the front cog has started since it was launched
'' @returns nLatePasses - passes that ended within LATE_MARGIN_US of their slot's end (or past it) and were re-anchored, never caught up
'' @returns nMaxPassTicks - the longest pass body seen, in system ticks
'' @returns nStackHighWater - stack longs ever used, of STACK_SIZE_LONGS; STACK_SIZE_LONGS itself means an overflow is possible

' Local Variables:
' @local longIdx - index of the stack long being inspected, from the top down

    nPasses := frontPasses
    nLatePasses := frontLatePasses
    nMaxPassTicks := frontMaxPassTicks
    ' the stack was filled with STACK_SENTINEL before launch and grows upward from its base, so the
    '  highest long that no longer holds the sentinel marks the deepest use
    nStackHighWater := 0
    repeat longIdx from STACK_SIZE_LONGS - 1 to 0
        if taskStack[longIdx] <> STACK_SENTINEL
            nStackHighWater := longIdx + 1
            quit

PUB testGetCurrentLimitState() : nPeakA, nContA, bDeratedNow, nPhaseAvgMa, nLimitK
'' TESTING USE: return the current limits in effect, whether the front cog has derated the fold-back, and the average it judges
''
'' @returns nPeakA - the peak phase-current limit, amps
'' @returns nContA - the continuous phase-current limit, amps
'' @returns bDeratedNow - T/F where T means the driver's fold-back holds the continuous limit, not the peak
'' @returns nPhaseAvgMa - the front cog's ~1 s average of the phase-current lower bound, mA
'' @returns nLimitK - the fold-back factor the driver reads (threshold mV = duty x nLimitK >> 16)

    nPeakA := limitPeakA
    nContA := limitContA
    bDeratedNow := bDerated
    nPhaseAvgMa := phaseAvgMa SAR CURRENT_AVG_SHIFT
    nLimitK := i_limit_k

PUB testGetAccelNow() : nAccel
'' TESTING USE: return the trajectory generator's acceleration, the signed change of the field's increment per drive pass (PL-160)
''
'' The driver's own state (drv_accel_now), block-copied with the status run every PWM frame: 0 at rest and at speed,
'' rising by at most jerk_up (or jerk_dn) a pass while a ramp eases in, never beyond accel_up (or accel_dn) in size but
'' while it unwinds from a limit it left. On the pass the target arrives it reads that pass's last step (at most the
'' jerk), and 0 from the next pass. Same sign as the change it
'' makes to the field's increment (testGetDriveHealth()'s nDrvIncr). The four limits are getRampingValues().
''
'' @returns nAccel - angle-increment units per drive pass, per drive pass; signed

    nAccel := drv_accel_now

PUB testGetAbiAddrs() : pLaunch, pStatus, pParams
'' TEST USE: the hub addresses of the three runs the driver shares with Spin2, so a bench harness can dump them
'' (task 3613, PL-120): the launch run (pinbase, params_ptr, targetAngle, targetIncre), the DRVR_STATUS_LONGS_COUNT
'' status longs the driver writes every pass (then fault), and the DRVR_PARAMS_LONGS_COUNT parameters it reads
''
'' @returns pLaunch - @pinbase
'' @returns pStatus - @drive_u
'' @returns pParams - @offset_fwd

    pLaunch := @pinbase
    pStatus := @drive_u
    pParams := @offset_fwd

PUB testGetMotorCog() : cogValue
'' TESTING USE: snapshot start()/startEx()'s raw motorCog value (AD+) -- (cogid + 1) on
'' success, 0 if coginit() never ran or the object was never started. Exists so a caller can
'' compare this against start()'s own return to help settle whether AD+'s unreliable return
'' comes from start() itself or from the chained assignment that sets motorCog.
''
'' @returns cogValue - the object's raw motorCog value

    cogValue := motorCog


PUB SyncStatus() : eError | startMs
'' Wait until the driver has taken a synchronized command (when configured for synchronization)
''
'' @returns eError - NO_ERROR once the command is taken, or ERR_SYNC_TIMEOUT (also recorded for getError()) after SYNC_TIMEOUT_MS

' Local Variables:
' @local startMs - getms() when the wait began

    ' F-6: bounded. The driver clears the sync bit when it takes the command after ATN, polling once
    '  per drive pass; it never takes one while e-stopped, stopped or not started, so an unbounded
    '  wait here hung the caller's cog.
    eError := NO_ERROR
    startMs := getms()
    repeat while targetIncre & $8000_0000
        if getms() - startMs > SYNC_TIMEOUT_MS
            eError := recordError(ERR_SYNC_TIMEOUT)
            debug[user.DBGCH_ERROR]("! ERROR: SyncStatus(", zstr_(@motorId), ") driver did not take the synchronized command")
            quit

PUB recordCallerError(eCode) : eSameCode
'' INTERNAL USE: record a status an owner received for this motor in this motor's error slot for the calling cog
''
'' For isp_steering_2wheel: its caller records each wheel's front-cog status here, so getError() reports it per wheel.
'' Never called from a front cog.
''
'' @param eCode - NO_ERROR or an ERR_* code
'' @returns eSameCode - {eCode}, so a failing path can record and return in one expression

    eSameCode := recordError(eCode)

PUB getDebugData() : nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars
'' TESTING USE: Return pointers to HDMI-debug data structures for this motor-object instance
''
'' @returns nGroups - number of display groups in the tables
'' @returns pGroupTitles - pointer to the table of group-title string pointers
'' @returns pGroupNames - pointer to the table of variable-name string pointers, by group
'' @returns pGroupVarCts - pointer to the table of variable counts, one per group
'' @returns pGroupVars - pointer to the table of variable-value pointers, by group

    loadDisplayList()
    nGroups := DBG_GROUPS_CT
    pGroupTitles := @pTitlesAr         ' pStr = long[pTitlesAr][grpIdx]
    pGroupVarCts := @pVarCtAr          ' nNbrGrpVars = long[pVarCtAr][grpIdx]
    pGroupNames := @pNamesAr           ' pGrpNameAr = long[pNamesAr][grpIdx], pVarName = long[pNameAr][varIdx]  where varIdx is from 0 to nNbrGrpVars - 1
    pGroupVars := @pValsAr             ' pGrpLongVar = long[pValsAr][grpIdx][varIdx]  where varIdx is from 0 to nNbrGrpVars - 1
    ' DBGCH_HDMI_DUMP (off by default) replaces the runtime showHDMIDebug flag, which nothing ever set TRUE
    debug[user.DBGCH_HDMI_DUMP]("* -------------")
    debug[user.DBGCH_HDMI_DUMP]("* MOTR DAT values: ", uhex_long(@hall), uhex_long_array(@hall, 4))
    debug[user.DBGCH_HDMI_DUMP]("* MOTR VAR values: ", uhex_long(@tvRpm_x10), uhex_long_array(@tvRpm_x10, 4))
    debug[user.DBGCH_HDMI_DUMP]("* NAMEs SOURCE1: ", uhex_long(@nameTitle1), uhex_byte_array(@nameTitle1, dataLen1))
    debug[user.DBGCH_HDMI_DUMP]("* NAMEs SOURCE2: ", uhex_long(@nameTitle2), uhex_byte_array(@nameTitle2, dataLen2))
    debug[user.DBGCH_HDMI_DUMP]("* NAMEs SOURCE3: ", uhex_long(@nameTitle3), uhex_byte_array(@nameTitle3, dataLen3))
    debug[user.DBGCH_HDMI_DUMP]("* -------------")
    debug[user.DBGCH_HDMI_DUMP]("* MOTR DL title: ", uhex_long(@pTitlesAr), uhex_long_array(@pTitlesAr, DBG_GROUPS_CT + 1))
    debug[user.DBGCH_HDMI_DUMP]("* MOTR DL VarCt: ", uhex_long(@pVarCtAr), uhex_long_array(@pVarCtAr, DBG_GROUPS_CT))
    debug[user.DBGCH_HDMI_DUMP]("* MOTR DL Names: ", uhex_long(@pNamesAr), uhex_long_array(@pNamesAr, DBG_GROUPS_CT * DBG_MAX_VARS_IN_GROUP))
    debug[user.DBGCH_HDMI_DUMP]("* MOTR DL Values: ", uhex_long(@pValsAr), uhex_long_array(@pValsAr, DBG_GROUPS_CT * DBG_MAX_VARS_IN_GROUP))
    debug[user.DBGCH_HDMI_DUMP]("* -------------")
    debug[user.DBGCH_HDMI_DUMP]("* MOTR PARM values: ", uhex_long(@nGroups), uhex_long_array(@nGroups, 5))
    debug[user.DBGCH_HDMI_DUMP]("* -------------")
    debug[user.DBGCH_HDMI_DUMP]("* MOTR Sent: ", udec(nGroups), uhex_long(pGroupTitles), uhex_long(pGroupNames), uhex_long(pGroupVarCts), uhex_long(pGroupVars))
    debug[user.DBGCH_HDMI_DUMP]("* =============")

PUB bFrontClearFaultBegin() : bClearing
'' FRONT COG ONLY: begin clearing a FAULTED motor (PL-66); a no-op (F) when not FAULTED -- never waits (PL-161)
''
'' Shared by the single-motor front cog and an owner that must clear several motors' faults together before writing
'' any of their commands (isp_steering_2wheel) -- one fault-clear path either way. The caller holds its request in
'' flight (PST_FAULT_LEFT) and polls isFaulted() once a pass, bounded by bFrontWaitExpired(); it writes the requested
'' command only once the fault has left, and answers ERR_NO_RESPONSE if the bound goes first (the zero stays written).
''
'' @returns bClearing - T/F where T means the motor was FAULTED: a zero command is written and the clear is made

    bClearing := FALSE
    if drv_state == DCS_FAULTED
        ' PL-66: only the front cog can tell a request that just arrived from one still standing, so the
        '  fault-clear edge is made here, not in the driver: fault_clr advances (task 3616), and the
        '  driver's latch releases on the pass it sees the advance (.noEStop -> .resetFault), for every
        '  drive while FAULTED. The caller's in-flight request watches drv_state leave DCS_FAULTED.
        frontStopCommanded()                                                ' PL-52: also clears getPower() while we try
        bClearing := TRUE

PUB bFrontWaitExpired(nStartTicks) : bExpired
'' FRONT COG ONLY: whether an in-flight request's driver wait, begun at {nStartTicks}, has outlived its bound (PL-161)
''
'' The bound is FRONT_SYNC_WAIT_PASSES drive passes, the margin every busy-wait it replaces had: a live driver acts
'' within one drive pass (gettgtincr polls ATN every pass; a clear or a release is seen on the pass after it is made).
'' The front cog polls once a pass, so a wait that never ends is given up on the first pass after the bound.
''
'' @param nStartTicks - getct() when the wait began
'' @returns bExpired - T/F where T means more than FRONT_SYNC_WAIT_PASSES drive passes have gone by since {nStartTicks}

    bExpired := (getct() - nStartTicks) > FRONT_SYNC_WAIT_PASSES * DRIVE_PASS_US * (CLKFREQ / US_PER_SEC)

PUB frontDrive(power, bSync) : eStatus | limitPwr, correctedPower
'' FRONT COG ONLY: write this motor's command for {power}, unless it is protectively or emergency-stopped; the owner sends any ATN
''
'' PL-161 (DRIVER_REV 37): never waits. A FAULTED motor is cleared BEFORE this is called (bFrontClearFaultBegin(), its
'' request held in flight until the fault leaves), so this writes the command as it stands.
''
'' @param power - power [(-100) to 100], saturated to that range and then to setMaxSpeed(); 0 stops
'' @param bSync - T/F where T means the command carries the sync bit and is taken only after its owner's ATN
'' @returns eStatus - NO_ERROR, or the protective code or ERR_EMERGENCY_STOPPED with nothing written; never recorded

' Local Variables:
' @local limitPwr - {power} saturated to [(-100) to 100] and then to the max speed
' @local correctedPower - saturated power with this motor's reversal applied

    eStatus := frontRefusal()               ' refused: a command written now would sit stale and drive on the clear
    if eStatus == NO_ERROR
        limitPwr :=  -100 #> power <# 100
        motorPower := limitPwr := -maxSpeed #> limitPwr <# maxSpeed
        correctedPower := (motorIsReversed) ? 0 - limitPwr : limitPwr
        frontCommand(incrementForPower(correctedPower), bSync)

PUB frontWriteIncrement(nIncre, bSync)
'' FRONT COG ONLY: write a raw driver increment (stops, and the TEST-USE path) with no emergency-stop check
''
'' PL-52: does not update getPower() -- REQ_TEST_INCREMENT writes a raw driver increment, not a commanded
'' power, so motorPower is left exactly as it was. A commanded write, so it also clears a fault (task 3616)
''
'' @param nIncre - the driver angle increment; 0 stops
'' @param bSync - T/F where T means the command carries the sync bit and is taken only after its owner's ATN

    frontCommand(nIncre, bSync)
    releaseFaultLatch()

PUB frontShortfall() : bShort, nAchievedPermille, nCmdGen, bCommanded
'' FRONT COG ONLY: whether this motor's field is held short of its command, and what fraction of it the field achieves
''
'' R18.4 D-6 (DOCs/plans/DRIVE-INTEGRATION-DESIGN.md 5.3). A motor is SHORT when its lag limiter held the
'' field in any of the last SHORT_SLOTS rpm-window slots. While it is, D-5 has walked the field's rate down to
'' what the rotor achieves, so drv_incr_now over the commanded increment IS the achieved fraction, exact and
'' at slot rate -- no 1 s window stands between the shortfall and the reading.
''
'' @returns bShort - T/F where T means the lag limiter held this motor's field within the last SHORT_SLOTS slots
'' @returns nAchievedPermille - the field's rate as a fraction of the commanded rate, 0-1000; 1000 when nothing is commanded
'' @returns nCmdGen - a count that changes whenever a new command is written, so an owner can tell a new command from a scaled one
'' @returns bCommanded - T/F where T means a non-zero command is in force (PL-141: only then is nAchievedPermille a measure)

    bShort, nAchievedPermille := shortfallNow()
    nCmdGen := userCmdGen
    bCommanded := (userCmdIncr <> 0)

PUB testGetDriveFollow() : nCmdIncr, nDrvIncr, bShort, nAchievedPermille, nFollowPct, bFollowOk
'' TESTING USE: the path limiter's view of this motor, beside the rpm window's following reading (R18.4, Visit 8 A-7 / A-8)
''
'' @returns nCmdIncr - the increment last COMMANDED (a path scale never changes it)
'' @returns nDrvIncr - the field's increment per drive pass now
'' @returns bShort - T/F where T means the lag limiter held the field within the last SHORT_SLOTS slots
'' @returns nAchievedPermille - the field's rate as a fraction of the commanded rate, 0-1000
'' @returns nFollowPct - the rpm window's measured rate as a percentage of commanded (testGetFollowing())
'' @returns bFollowOk - T/F where T means that percentage is valid (the window has filled)

    nCmdIncr := userCmdIncr
    nDrvIncr := drv_incr_now
    bShort, nAchievedPermille := shortfallNow()
    nFollowPct := followPctOfCmd
    bFollowOk := bFollowValid

PUB frontScaleCommand(nScalePermille) | scaledIncr
'' FRONT COG ONLY: run this motor at a fraction of its commanded rate, keeping the command itself
''
'' R18.4 D-6: the steering object scales BOTH wheels by one fraction so the platform keeps its path. The
'' command is kept (getPower() still reads what was commanded, C-2), and a stopped, refused or faulted motor
'' is left alone. Writes no ATN: the scaled command is taken on the driver's next pass (D-4). A scaled command is
'' never below DRV_INCR_FLOOR (PL-141): a commanded wheel scaled to zero would read at rest (DCS_STOPPED) while
'' commanded, and would zero the target a blocked wheel's protective stop counts on (bFrontProtect()), as D-5 never
'' walks a field below DRV_INCR_FLOOR either. (It was ramp_min until DRIVER_REV 38 reused that long as jerk_up.)
''
'' @param nScalePermille - the fraction of the commanded rate to run at, 0-1000

' Local Variables:
' @local scaledIncr - the commanded increment scaled to {nScalePermille}, its sign kept

    if (userCmdIncr <> 0) and (frontRefusal() == NO_ERROR) and (drv_state <> DCS_FAULTED)
        scaledIncr := muldiv64(abs(userCmdIncr), (0 #> nScalePermille <# PERMILLE_FULL), PERMILLE_FULL) #> (DRV_INCR_FLOOR <# abs(userCmdIncr))
        if userCmdIncr < 0
            scaledIncr := -scaledIncr
        setTargetAccel(scaledIncr, FALSE)

PUB frontZeroPower()
'' FRONT COG ONLY: write a zero driver command and clear the last commanded power (PL-52)
''
'' Used for a genuine stop (REQ_STOP, and the distance/rotation/time limits), never for a fault: a
'' faulted motor keeps reporting its last commanded power (getPower()'s own doc), since nothing was
'' ever commanded to stop it.

    motorPower := 0
    frontCommand(0, FALSE)

PUB frontStopCommanded()
'' FRONT COG ONLY: a stop the user commanded (REQ_STOP, and the clear before a drive): write a zero command and release
'' a FAULTED driver to the stop mode (task 3616)
''
'' DCS_FAULTED is a latch in the driver: only an advance of fault_clr clears it, and a zero command alone never does.
'' The zero is written first, so the driver pass that sees the advance also reads the zero and comes to rest.
'' A stop the front cog makes on its own (a limit, a timeout, a re-synced fault) uses frontZeroPower() and leaves
'' a fault standing.

    frontZeroPower()
    releaseFaultLatch()

PUB frontRefusal() : eStatus
'' FRONT COG ONLY: return why a drive must be refused now, or NO_ERROR
''
'' @returns eStatus - the latched protective code first, then ERR_EMERGENCY_STOPPED, else NO_ERROR

    eStatus := protectiveCode
    if (eStatus == NO_ERROR) and (isFrontEStopped() == TRUE)
        eStatus := ERR_EMERGENCY_STOPPED

PUB bFrontProtect() : bBlocked | dutyEff, dcMa, phaseMa, nowPos
'' FRONT COG ONLY: once per pass -- the thermal derate of the current limit, and the blocked-motor test
''
'' The phase current is estimated as a lower bound from the DC-link reading and the modulation depth,
'' I_phase >= I_dc / (0.75 x m) with m = duty / (4 x frame_cnt) (DOCs/plans/CURRENT-LIMIT-AND-STOP-DESIGN.md section 3.4).
'' Its ~1 s average above the continuous limit lowers the driver's fold-back to that limit, and the peak
'' limit returns below I_RESTORE_PCT of it. A motor commanded to move that stays at the lag limit with
'' no hall tick for BLOCKED_PASSES is blocked; the caller latches the protective stop. Records no error; a derate's
'' engage and release are logged as EV_CURRENT_LIMIT (R20.1).
''
'' @returns bBlocked - T/F where T means this motor has been blocked for BLOCKED_PASSES

' Local Variables:
' @local dutyEff - the driver's duty, floored at the estimate's m = 0.1 (dutyFloorEst; the fold's own floor may be higher, PL-163)
' @local dcMa - the DC-link current net of the rest zero, mA, never negative (the reading's floor made good: + 0.5 mV)
' @local phaseMa - this pass's phase-current lower bound, mA
' @local nowPos - the driver's hall position this pass

    if rSenseForBoard <> VALUE_NOT_SET
        dutyEff := duty #> dutyFloorEst
        ' DRIVER_REV 40: the reading is floored, so it averages half a count low; half a count is added back (x 2 + 1,
        '  over 2) now the rest zero is the true offset (restZeroFinish()), so the ~1 s average centres on the current
        dcMa := muldiv64(((((sense_i_mV - restZeroSenseMv) << 1) + 1) #> 0), 500, rSenseForBoard)
        phaseMa := muldiv64(dcMa, 16 * frame_cnt, 3 * dutyEff) <# PHASE_MA_MAX
        phaseAvgMa += ((phaseMa << CURRENT_AVG_SHIFT) - phaseAvgMa) SAR CURRENT_AVG_SHIFT
        if (bDerated == FALSE) and (phaseAvgMa >= (limitContA * 1_000) << CURRENT_AVG_SHIFT)
            bDerated := TRUE
            setFoldLimit(limitContA)
            frontQueueEvent(EV_CURRENT_LIMIT, limitContA)                       ' R20.1: the limit now in force, after it is written
        elseif (bDerated == TRUE) and (phaseAvgMa < (limitContA * 10 * I_RESTORE_PCT) << CURRENT_AVG_SHIFT)
            bDerated := FALSE
            setFoldLimit(limitPeakA)
            frontQueueEvent(EV_CURRENT_LIMIT, limitPeakA)

    nowPos := pos
    if ((targetIncre & !SYNC_BIT) <> 0) and (abs(err) >= LAG_SOFT) and (nowPos == blockedPos) and ((drv_state == DCS_SPIN_UP) or (drv_state == DCS_AT_SPEED) or (drv_state == DCS_SPIN_DN))
        blockedPasses++
    else
        blockedPasses := 0
    blockedPos := nowPos
    bBlocked := (blockedPasses >= BLOCKED_PASSES)

PUB frontProtectiveStop(eProtectiveCode)
'' FRONT COG ONLY: secure this motor now and latch a protective stop until clearProtectiveStop()
''
'' The motor stops at once in its stop mode's state: SM_FLOAT coasts, SM_BRAKE shorts the phases (a blocked wheel
'' cannot be held). An emergency stop shorts whatever the stop mode; a protective stop honours it (PL-132).
''
'' @param eProtectiveCode - ERR_PLATFORM_BLOCKED or another -2_0xx cause; any other value latches ERR_PROTECTIVE_STOP

    frontLatchStop(ES_PROTECT)                                                  ' 1. secure at once, in the stop mode's state (PL-132); getPower() reads 0
    if (eProtectiveCode > ERR_PROTECTIVE_STOP) or (eProtectiveCode < ERR_PROTECTIVE_STOP - 99)
        eProtectiveCode := ERR_PROTECTIVE_STOP
    if protectiveCode == NO_ERROR
        protectiveCode := eProtectiveCode                                       ' 2. latch last; the first cause sticks
    blockedPasses := 0

PUB frontClearProtective()
'' FRONT COG ONLY: forget the latched protective cause; the caller then releases the emergency stop that secured the motor
''

    protectiveCode := NO_ERROR
    blockedPasses := 0

PUB frontSetCurrentLimits(peakAmps, contAmps)
'' FRONT COG ONLY: replace both current limits (TEST-USE), and restart the average at the peak limit
''
'' @param peakAmps - the peak phase-current limit, amps
'' @param contAmps - the continuous phase-current limit, amps

    limitPeakA := peakAmps
    limitContA := contAmps
    phaseAvgMa := 0
    bDerated := FALSE
    setFoldLimit(limitPeakA)                                                    ' PL-163: with the fold's duty floor

PUB frontSetHoldLimits(ceilingPct, riseMs, limitMs)
'' FRONT COG ONLY (or init(), before the front cog starts): replace the hold's limits (R19.1)
''
'' @param ceilingPct - the hold's duty ceiling, % of duty_max [1..100]
'' @param riseMs - ms from duty_min to the ceiling while the wheel stays displaced [1..HOLD_RISE_MS_MAX]
'' @param limitMs - ms at the ceiling before the hold hands off to the phase short [1..HOLD_LIMIT_MS_MAX]

    holdCeilPct := ceilingPct                                                   ' R20.1: as set, for getHoldLimits()
    holdRiseMs := riseMs
    holdLimitMs := limitMs
    holdCeilDuty := muldiv64(duty_max, ceilingPct, 100) #> duty_min
    holdRisePasses := muldiv64(riseMs, FRONT_LOOP_HZ, MS_PER_SEC) #> 1
    holdLimitPasses := muldiv64(limitMs, FRONT_LOOP_HZ, MS_PER_SEC) #> 1

PUB frontSetFaultResponse(eMode, brakePct)
'' FRONT COG ONLY (or init(), before the front cog starts): choose the response to a position fault (R19.3)
''
'' @param eMode - FR_SHIPPED or FR_GRADED
'' @param brakePct - the graded short's shorted time, % of each brake period [0..100]; 100 is the full short, 0 a coast

    faultBrakePct := brakePct                                                   ' R20.1: as set, for getFaultResponse()
    fault_mode := eMode
    brake_on := muldiv64(BRAKE_PERIOD_FRAMES, brakePct, 100)                  ' shorted frames per brake period

PUB frontForceFault()
'' FRONT COG ONLY: ask the driver to fault on its next driven frame (TEST-USE, R19.3; testForceFault())
''
'' The driver takes it at its fault test, exactly where a real position fault is taken, so the response is the
'' mode's real response. While the bridge is not driven (coasting, shorted, faulted) the driver drops it.

    force_seq++

PUB bFrontFaultBegan() : bBegan
'' FRONT COG ONLY: whether a fault of either kind -- a driver FAULT, or one it re-synced and is stopping -- began this pass
''
'' Valid after this pass's frontTrack(); an owner that must not drive one wheel stops the others on it (R19.2).
''
'' @returns bBegan - T/F where T means a fault began on this pass

    bBegan := bFaultBegan

PUB frontOpenDrive()
'' FRONT COG ONLY: an accepted drive command opens a drive: getStopReason() reads SR_NONE until a stop ends it (R20.1)
''
'' Call it after the drive's command is written. A refused command must not call it.

    stopReason := SR_NONE
    bDriveOpen := TRUE
    bResyncStopOpen := FALSE

PUB frontRecordStop(eReason)
'' FRONT COG ONLY: the one writer of getStopReason(): record why the open drive ended, and log it as EV_STOP (R20.1)
''
'' Call it after the stop's command is written, so no record delays a stop (D6). First cause wins: with no drive open
'' it records nothing. The one exception is the escalation, which frontNoteFault() makes itself.
''
'' @param eReason - the SR_* that ended the drive

    if bDriveOpen == TRUE
        bDriveOpen := FALSE
        stopReason := eReason
        bResyncStopOpen := (eReason == SR_FAULT_CONTROLLED)                    ' a second fault before rest escalates it
        frontQueueEvent(EV_STOP, eReason)

PUB frontQueueEvent(eKind, nValue) | slotIdx
'' FRONT COG ONLY: the one writer of the event log: queue one event for every reading cog (getEvent(), R20.1)
''
'' Never waits on a reader: a reader more than EV_QUEUE_DEPTH behind loses its own oldest events and is told so.
''
'' @param eKind - the EV_* kind
'' @param nValue - the event's value, meaning per EV_*

' Local Variables:
' @local slotIdx - the ring slot this event is written to

    slotIdx := evHead +// EV_RING_SLOTS
    evKind[slotIdx] := eKind
    evMs[slotIdx] := getms()
    evVal[slotIdx] := nValue
    if (eKind >= EV_STOP) and (eKind <= EV_FOLDBACK)
        evTotal[eKind - EV_STOP]++
    evHead++                                                                    ' LAST: publishes the slot written above

PUB frontEventChecks(nowMs) | nNow, ePackNow
'' FRONT COG ONLY: every WINDOW_PASSES passes, on the phase opposite the rpm window's slot pass -- queue the rate-limited
'' and counted events: missed and illegal hall codes, the pack sensor's status, and the driver's current fold-back (R20.1)
''
'' Each rate-limited kind is queued at most once per EV_RATE_GAP_MS, and carries every count since its last event, so no
'' count is dropped. The fold-back is reported on its engage (value 0), and again once it has been still for
'' EV_RATE_GAP_MS (value: the frames it limited since the engage).
''
'' @param nowMs - getms() for this pass

' Local Variables:
' @local nNow - a driver count read once
' @local ePackNow - the pack sensor's status now

    nNow := hall_missed
    if (nNow <> evLastMissed) and (nowMs - evMissedMs >= EV_RATE_GAP_MS)
        frontQueueEvent(EV_HALL_MISSED, nNow - evLastMissed)
        evLastMissed := nNow
        evMissedMs := nowMs
    nNow := hall_illegal
    nNow := (nNow & HALL_ILL_WORD_MAX) + (nNow >> 16)                           ' the %000 and %111 words, summed
    if (nNow <> evLastIllegal) and (nowMs - evIllegalMs >= EV_RATE_GAP_MS)
        frontQueueEvent(EV_HALL_ILLEGAL, nNow - evLastIllegal)
        evLastIllegal := nNow
        evIllegalMs := nowMs
    if bPackOwned == TRUE
        ePackNow := packStatusFor(packMvFromAvg())                              ' PL-161: converted here, once a slot, never per pass
        if (ePackNow <> evLastPack) and (nowMs - evPackMs >= EV_RATE_GAP_MS)
            frontQueueEvent(EV_PACK, ePackNow)
            evLastPack := ePackNow
            evPackMs := nowMs
    nNow := foldback_frames
    if nNow <> evLastFold
        if bFoldActive == FALSE                                                 ' the engage edge
            bFoldActive := TRUE
            evFoldBase := evLastFold
            frontQueueEvent(EV_FOLDBACK, 0)
        evLastFold := nNow
        evFoldMs := nowMs
    elseif (bFoldActive == TRUE) and (nowMs - evFoldMs >= EV_RATE_GAP_MS)       ' still for the gap: released
        bFoldActive := FALSE
        frontQueueEvent(EV_FOLDBACK, nNow - evFoldBase)

PUB frontNoteStartChecks()
'' FRONT COG ONLY: once per start, after the start checks -- log EV_CHECK_RETRY when a check failed and then passed (R20.1)
''
'' The single motor's start() posts it (REQ_NOTE_START); an owner (isp_steering_2wheel) calls it from its front cog's entry,
'' since its checks finished before that cog existed.

    if healthRecovered <> 0
        frontQueueEvent(EV_CHECK_RETRY, healthRecovered | (healthAttempts << EV_START_ATTEMPT_SHIFT))

PUB frontHold() | nowPos
'' FRONT COG ONLY: once per pass -- the hold at rest in SM_BRAKE (R19.1)
''
'' At rest the driver keeps the field at the stop angle, a spring whose torque grows with the rotor's
'' displacement. While the hall position is off the hold position this raises the duty the driver applies,
'' up to holdCeilDuty, and never lowers it within one rest, so a held load does not hunt. A displacement of
'' HOLD_SLIP_TICKS, or holdLimitPasses at the ceiling, hands the hold off to the phase short (the driver's
'' restBridge); that is reported through getHoldStatus() and stays until the next command.

' Local Variables:
' @local nowPos - the driver's hall position this pass

    if (drv_state <> DCS_STOPPED) or (stop_mode <> SM_BRAKE)
        ' not holding: the next rest starts a new hold, and the driver at rest applies duty_min
        holdState := HS_OFF
        bHoldArmed := FALSE
        hold_short := FALSE
        hold_duty := duty_min
        holdDisp := 0
    else
        nowPos := pos
        if bHoldArmed == FALSE
            bHoldArmed := TRUE                                                  ' this rest's hold position is where it stopped
            holdPos := nowPos
            holdDispPasses := 0
            holdCeilPasses := 0
            hold_duty := duty_min
            holdState := HS_HOLDING
        holdDisp := nowPos - holdPos
        if holdState == HS_HOLDING                                              ' a handed-off hold stays shorted until the next command
            if abs(holdDisp) >= HOLD_SLIP_TICKS
                hold_short := TRUE
                holdState := HS_SLIPPED
                holdSlipEvents++
                frontQueueEvent(EV_HOLD_SLIP, holdDisp)                         ' R20.1: after the hand-off is written
            else
                if holdDisp <> 0                                                ' the duty follows the displaced passes, so the
                    holdDispPasses := (holdDispPasses + 1) <# holdRisePasses    '  ceiling comes after exactly riseMs displaced
                    hold_duty := duty_min + muldiv64(holdCeilDuty - duty_min, holdDispPasses, holdRisePasses)
                if hold_duty < holdCeilDuty
                    holdCeilPasses := 0
                elseif ++holdCeilPasses >= holdLimitPasses
                    hold_short := TRUE
                    holdState := HS_LIMITED
                    holdLimitEvents++
                    frontQueueEvent(EV_HOLD_LIMIT, hold_duty)                   ' R20.1: after the hand-off is written

PUB frontArmWalkGuard()
'' FRONT COG ONLY: arm the current guard for the walk leg just commanded (REQ_WALK, PL-122)
''
'' Call it after the leg's command is written: any later command disarms it (frontCommand()).

    bWalkTripped := FALSE
    bWalkGuardArmed := TRUE

PUB frontWalkBegin(eLeg)
'' FRONT COG ONLY: open walk leg {eLeg}'s record and start watching its position (PL-137, testGetWalkLeg())
''
'' Call it after the leg's command is written and taken, beside frontArmWalkGuard(), and before this pass's tracking:
'' the post position is the one the leg's distance limit counts from (PL-153: where frontSetLimits() armed it; the
'' odometer is no longer reset for a leg). Opening the first leg also empties the second's
'' record, so a second leg never posted reads WALK_NA, never an earlier walk's. The watch runs every pass
'' (frontWalkGuard()) until the next drive command closes it (frontCommand()).
''
'' @param eLeg - WLEG_OUT or WLEG_BACK; any other value opens nothing

    if (eLeg >= WLEG_OUT) and (eLeg <= WLEG_BACK)
        if walkWatchLeg <> WLEG_NONE
            frontWalkClose()                                                    ' the leg's own command already did, unless it was a zero
        if eLeg == WLEG_OUT
            walkLegOpen(WLEG_BACK, WALK_NA)                                     ' the second leg: empty until its own post
        walkLegOpen(eLeg, limitBasePos)                                         ' PL-153: the position the leg's limit was armed at
        wlPostMs[eLeg] := getms()
        walkWatchLeg := eLeg                                                    ' LAST: the watch reads the record above

PUB frontWalkNoteLimit()
'' FRONT COG ONLY: after a distance limit's stop is written (frontZeroPower()), note it in the watched walk leg's record (PL-137)
''
'' The first firing in a leg is kept; the limit's decision (bFrontLimitsDue()) left the stopping ticks it allowed for,
'' and the tracked ticks are unchanged until the next pass's tracking. A no-op with no leg watched.

    if walkWatchLeg <> WLEG_NONE
        if wlLimMs[walkWatchLeg] == WALK_NA
            wlLimPos[walkWatchLeg] := pos
            wlLimTrk[walkWatchLeg] := trkTravelTicks - limitBaseTicks           ' PL-153: the leg's own travel, as the limit counted it
            wlLimStopTk[walkWatchLeg] := limitStopTicks
            wlLimMs[walkWatchLeg] := getms() - wlPostMs[walkWatchLeg]         ' LAST: marks the limit noted

PUB frontWalkGuard() | nNetMv
'' FRONT COG ONLY: once per pass -- end an armed walk leg whose current reaches WALK_I_LIMIT_MA (PL-122), and follow a
'' watched walk leg's position (PL-137, frontWalkWatch())
''
'' A wiring check must not stress what it checks. A zero command would ramp the field down for a few hundred ms more of
'' drive against a wheel that is not following, so the leg ends with this motor's e-stop instead: the driver shorts
'' the phases on its next pass, and the rotor, barely turning, generates almost no current into the short. The walk
'' releases that e-stop once the leg is over (bWalkLeg(), and isp_steering_2wheel's walkLeg()); a user's e-stop taken
'' in the meantime is theirs, and is left alone (frontEStop()).
'' DRIVER_REV 40: the compare needs no half-count correction. The reading r floors the net y it read, and r + 1/2 >= G
'' is r >= G for a whole-mV guard G, which is exactly y >= G. EV_WALK_GUARD carries r as read, so its value is always
'' at least walkGuardMv (testGetWalkGuardMv()).

' Local Variables:
' @local nNetMv - this pass's DC-link sense, net of the rest zero, mV

    if bWalkGuardArmed == TRUE
        nNetMv := sense_i_mV - restZeroSenseMv
        if nNetMv >= walkGuardMv                                                ' DRIVER_REV 40: WALK_I_LIMIT_MA on this board's scale
            frontEStop(TRUE)                                                    ' disarms the guard (frontCommand())
            bWalkTripped := TRUE                                                '  after the e-stop, which would clear it
            frontQueueEvent(EV_WALK_GUARD, nNetMv)                              ' R20.1: after the short is written
            debug[user.DBGCH_FAULT]("-MOT- wiring walk: current ", sdec_long(nNetMv), " mV over the guard, leg shorted")
    if walkWatchLeg <> WLEG_NONE                                                ' PL-137: one compare a pass while no leg is watched
        frontWalkWatch()

PUB isWalkGuardTripped() : bTripped
'' INTERNAL USE: whether the current guard ended the last walk leg (PL-122)
''
'' @returns bTripped - T/F where T means the guard shorted the leg with this motor's e-stop, which is still the guard's

    bTripped := bWalkTripped

PUB testGetWalkGuardMv() : nGuardMv
'' TESTING USE: the wiring walk's current guard in force, on this board's sense scale (DRIVER_REV 40)
''
'' WALK_I_LIMIT_MA converted by the detected board's rSense at start (init()): 150 mV on Rev B, 5 mV on Rev A, never
'' under FOLD_MIN_MV + 1. frontWalkGuard() ends a leg on a net reading at or above it, and EV_WALK_GUARD carries that
'' reading, so a guard event's value is always at least this. A bench criterion judges against this, not against
'' WALK_I_LIMIT_MV, which is Rev B's value only.
''
'' @returns nGuardMv - the guard, mV net of the rest zero; as set by the last start (init())

    nGuardMv := walkGuardMv

PUB isWalkWatched() : bWatched
'' INTERNAL USE: whether a wiring walk leg's position is being watched -- from its post until the next drive command (PL-137)
''
'' @returns bWatched - T/F where T means a walk leg is open on this motor

    bWatched := (walkWatchLeg <> WLEG_NONE)

PUB frontEStop(bEStop)
'' FRONT COG ONLY: latch (T) or release (F) this motor's emergency stop; a zero command is written either way
''
'' @param bEStop - T/F where T latches the emergency stop and F releases it

    if bEStop <> FALSE
        frontLatchStop(ES_HARD)                                                 ' the phases shorted, whatever the stop mode
    else
        frontCommand(0, FALSE)                                                  ' zero first: nothing moves when the latch releases
        e_stop := ES_OFF

PUB frontConfirmStop()
'' FRONT COG ONLY: once per pass, before requests: write a stop again until the driver's command reads zero
''
'' A stop written while the driver is taking an earlier synchronized command can be overwritten by the
'' driver's own write-back of that command (gettgtincr: rdlong, then wrlong with the sync bit cleared).
'' That write-back clears the sync bit, so one re-write on a later pass cannot be overwritten again.

    if bStopUnconfirmed == TRUE
        if (targetIncre & !SYNC_BIT) == 0
            bStopUnconfirmed := FALSE                                           ' the stop is what the driver holds
        else
            setTargetAccel(0, false)                                            ' overwritten: stop again, confirmed next pass

PUB isFrontEStopped() : bEStopped
'' FRONT COG ONLY: return the drive-refusal predicate: the latch is set, or the driver reports DCS_ESTOP
''
'' @returns bEStopped - T/F where T means a drive must be refused; the latch term closes the pass before the driver reports the state

    bEStopped := (e_stop <> FALSE) or (drv_state == DCS_ESTOP)

PUB bFrontTakenSync() : bTaken
'' FRONT COG ONLY: return TRUE once the driver has taken the last synchronized command (its sync bit is clear)
''
'' @returns bTaken - T/F where T means no synchronized command is waiting for this driver

    bTaken := (targetIncre & SYNC_BIT) == 0

PUB frontDriverCogBit() : cogBit
'' FRONT COG ONLY: return this motor's driver cog as a COGATN mask bit
''
'' @returns cogBit - 1 << the driver's cog id, or 0 when no driver runs (never 1 << -1, D1)

    cogBit := 0
    if motorCog <> 0
        cogBit := 1 << (motorCog - 1)

PUB frontTrack(passCount) | eDrvState, nowPos, nStep
'' FRONT COG ONLY: once per pass, latch a new fault's cause and accumulate position tracking; every WINDOW_PASSES passes advance the rpm window
''
'' PL-153: the travel is added every pass, faulted and emergency-stopped included -- a wheel that coasts or is pushed
'' then has travelled -- to the odometer (posTrkHallTicks, reset only by resetTracking() and start()) and to the travel
'' the limits count from their arming (trkTravelTicks, never reset while the front cog runs). Only the rpm window and
'' the HDMI maxima restart every pass while faulted or e-stopped, as they always did.
''
'' @param passCount - the owner's pass counter, advanced by one every pass

' Local Variables:
' @local eDrvState - the driver state read once for this pass
' @local nowPos - the driver's position read once for this pass
' @local nStep - hall ticks moved since the previous pass, either way

    eDrvState := drv_state
    frontNoteFault(eDrvState)
    nowPos := pos
    nStep := absDistanceInTics(nowPos, trackBasePos)
    posTrkHallTicks += nStep                                                    ' the odometer
    trkTravelTicks += nStep                                                     ' the limits' travel
    trackBasePos := nowPos
    if (eDrvState == DCS_FAULTED) or (eDrvState == DCS_ESTOP)
        ' a faulted or emergency-stopped motor restarts its rpm window every pass (PL-153: its odometer is kept)
        resetWindowAccumulators(nowPos)
        LARESET()                                                               ' reset LA tracking
    elseif (passCount +// WINDOW_PASSES) == 0
        updateWindowAccumulators()

PUB frontStopTicks() : nTicks
'' FRONT COG ONLY: return the hall ticks the field still travels if a stop is written now
''
'' PL-161 (DRIVER_REV 39): the DRIVER's own plan of its jerk-limited stop (drv_stop_fp, the PASM planA .. planC and
'' planStage), read from the status run: the front cog computes nothing. The plan is made from the (v, a) the
'' published drive pass left, for a stop taken by the next pass or, if that pass has already read its command, by
'' the one after it (one more pass first, under ANY command: planStage bounds them all); the largest travel. One
'' hall cycle (2^32) is 6 ticks. Rounded down, as before. See frontStopMs() for why the status run's age needs no
'' correction.
''
'' @returns nTicks - the stopping distance in hall ticks; 0 at rest

    nTicks := drv_stop_fp >> STOP_FP_BITS

PUB frontStopMs() : nMs
'' FRONT COG ONLY: return the milliseconds until the field is at rest if a stop is written now
''
'' PL-161 (DRIVER_REV 39): the driver's own plan (drv_stop_passes, the largest of the takes above), at
'' DRIVE_PASS_US each, rounded up. THE AGE: the plan counts passes from the published pass k's own time T_k, and the
'' status run is read at some t >= T_k (it is written only after the pass), so the field's rest, at most
'' T_k + passes x 522.7 us, is at most t + that: counting from now can only over-state the stop (early), never
'' under-state it. Pass k + 2 cannot read its command before T_k + 1_000 us (each pass waits its 500 us CT1
'' deadline), and the plan is published at most ~232 us after T_k (ten PWM frames), so a stop written within ~268 us
'' of the read is taken by pass k + 1 or k + 2, the two cases the plan covers. Both front cogs write a limit's stop
'' before any other work on its path, a few method calls after the read.
''
'' @returns nMs - the stopping time, rounded up; a few ms at rest (a take pass might yet start a drive)

    nMs := msForPasses(drv_stop_passes)

PUB bFrontStopMsReaches(nowMs, nDeadlineMs) : bReaches
'' FRONT COG ONLY: return TRUE when a stop written now leaves the field at rest at or after {nDeadlineMs}: nowMs + frontStopMs() >= nDeadlineMs
''
'' PL-161 (DRIVER_REV 39): the driver's plan, read (frontStopMs()); one compare, no computation.
''
'' @param nowMs - getms() for this pass
'' @param nDeadlineMs - the time limit, a getms() value
'' @returns bReaches - T/F where T means the stop must be written now for the field to be at rest by the deadline

    bReaches := (nowMs + frontStopMs() >= nDeadlineMs)

PUB bFrontStopTicksReaches(nTravelTicks, nLimitTicks) : bReaches
'' FRONT COG ONLY: return TRUE when a stop written now leaves the field at rest at or past {nLimitTicks}: nTravelTicks + frontStopTicks() >= nLimitTicks
''
'' PL-161 (DRIVER_REV 39): the driver's plan, read (frontStopTicks()); one compare, no computation.
''
'' @param nTravelTicks - the hall ticks travelled toward the limit so far
'' @param nLimitTicks - the limit, hall ticks
'' @returns bReaches - T/F where T means the stop must be written now for the motor to be at rest at the limit

    bReaches := (nTravelTicks + frontStopTicks() >= nLimitTicks)

PUB frontSetLimits(nTicks, nMsDeadline)
'' FRONT COG ONLY: arm this motor's stop limits (0 disarms either)
''
'' PL-153: a distance armed here counts the travel from this call (frontTravelNow()), never the odometer, so a second
'' limit or a second driveForDistance() travels its own distance. Arming it again, even to the same count, restarts it.
''
'' @param nTicks - stop once the hall ticks travelled since this call, either way, reach this count; 0 for none
'' @param nMsDeadline - stop once getms() passes this value; 0 for none

    if nTicks > 0
        limitBaseTicks := frontTravelNow()                                      ' first: the limit counts from here
        limitBasePos := pos
    motorStopHallTicks := nTicks
    motorStopMSecs := nMsDeadline

PUB frontSetTimeLimit(nMsDeadline)
'' FRONT COG ONLY: arm (or, with 0, disarm) the time limit alone, leaving an armed distance limit counting from where it was armed
''
'' @param nMsDeadline - stop once getms() passes this value; 0 for none

    motorStopMSecs := nMsDeadline

PUB frontTravelNow() : nTicks
'' FRONT COG ONLY: the hall ticks travelled, either way, since the front cog started, up to this instant (PL-153)
''
'' A limit's base and an owner's platform limit are taken from this, so each counts from the instant it is armed:
'' frontTrack()'s total plus the ticks moved since this pass's tracking. Never reset while the front cog runs.
''
'' @returns nTicks - the travel, hall ticks

    nTicks := trkTravelTicks + absDistanceInTics(pos, trackBasePos)

PUB bFrontLimitsDue(nowMs) : bFired
'' FRONT COG ONLY: return TRUE, and disarm the limit, when a stop written now leaves the motor at rest at its time or distance limit
''
'' The stop begins early by the field's own stopping time or distance at its current speed (frontStopMs(),
'' frontStopTicks()), so the motor is at rest at the limit, not a ramp past it. A limit already inside the
'' stopping distance or time fires at once. The time limit is checked first; the distance limit only while no
'' time limit is armed. The owner writes the stop, then frontWalkNoteLimit(), which reads the stopping ticks a fired
'' distance limit allowed for (PL-137). PL-153: the distance is the travel since the limit was armed (frontSetLimits()).
'' PL-161 (DRIVER_REV 39): the stopping time and distance are the driver's own plan, read from the status run
'' (bFrontStopMsReaches(), bFrontStopTicksReaches()): the front cog computes no stop prediction. Nothing here
'' prints or waits: the owner writes the stop straight after a TRUE, and only then calls frontReportLimit().
''
'' @param nowMs - getms() for this pass
'' @returns bFired - T/F where T means a limit fired in this call and the owner must stop the motor now

    bFired := FALSE
    if motorStopMSecs > 0
        if bFrontStopMsReaches(nowMs, motorStopMSecs) == TRUE
            motorStopMSecs := 0                                                 ' and clear user request
            bLimitByTime := TRUE                                                ' for frontReportLimit(), after the stop's write
            bFired := TRUE
    elseif motorStopHallTicks > 0
        if bFrontStopTicksReaches(trkTravelTicks - limitBaseTicks, motorStopHallTicks) == TRUE  ' PL-153: travel since arming
            motorStopHallTicks := 0                                             ' and clear user request
            limitStopTicks := frontStopTicks()                                  ' PL-137: the decision's own figure (one hub read)
            bLimitByTime := FALSE
            bFired := TRUE

PUB frontReportLimit()
'' FRONT COG ONLY: after a limit's stop is written, report which limit fired (debug output only)
''
'' PL-161 (DRIVER_REV 39): split out of bFrontLimitsDue() so a limit's stop is written before any output: a debug()
'' line takes a variable, possibly long time, and the stop must reach the driver within ~268 us of the plan's read.

    if bLimitByTime == TRUE
        debug[user.DBGCH_SENSE]("-MOT- time limit reached")
    else
        debug[user.DBGCH_SENSE]("-MOT- distance limit reached")

PUB frontWriteStop()
'' FRONT COG ONLY: write a zero command to the driver at once, and nothing else -- a platform limit's first act
''
'' PL-161 (DRIVER_REV 39): the owner of two motors writes both zeros with this before either motor's frontZeroPower(),
'' whose command write is followed by a debug() line; so neither wheel's stop waits behind the other's output. The
'' frontZeroPower() that follows writes the same zero again and does the rest of the stop's bookkeeping.

    targetIncre := 0

PUB frontResetTracking(bWholeWindow) | nowPos
'' FRONT COG ONLY: zero this motor's odometer from its current position (resetTracking()), and optionally the rpm window and HDMI maxima
''
'' PL-153: the odometer only. The travel the limits count keeps running, so an armed limit is not moved.
''
'' @param bWholeWindow - T/F where T also resets the rpm window and the HDMI maxima

' Local Variables:
' @local nowPos - the driver's position, adopted as the new base

    nowPos := pos
    if bWholeWindow <> FALSE
        resetWindowAccumulators(nowPos)
    trkTravelTicks += absDistanceInTics(nowPos, trackBasePos)                   ' the limits' travel is kept up to this instant
    trackBasePos := nowPos
    posTrkHallTicks := 0

PUB frontResetWindow()
'' FRONT COG ONLY: restart the rpm window and the HDMI maxima from the current position, the odometer untouched (PL-153)
''
'' For an owner that restarts the window with a new move (isp_steering_2wheel's distance drive and wiring walk).

    resetWindowAccumulators(pos)
    LARESET()                                                                   ' reset LA tracking

PUB frontStartTracking() | nowPos
'' FRONT COG ONLY: once, as a front cog starts -- zero the odometer, the limits' travel and the rpm window (start())
''

' Local Variables:
' @local nowPos - the driver's position, adopted as the new base

    nowPos := pos
    resetWindowAccumulators(nowPos)
    trackBasePos := nowPos
    posTrkHallTicks := 0
    trkTravelTicks := 0
    limitBaseTicks := 0
    limitBasePos := nowPos

PUB frontResetMax()
'' FRONT COG ONLY: reset the rpm window, the HDMI maxima and the odometer (TEST-USE testResetMaxValues())
''

    frontResetTracking(TRUE)
    LARESET()                                                                   ' reset LA tracking

PUB frontSecure(bEStop)
'' INTERNAL USE: secure this motor by writing directly -- ONLY when no front cog serves it (the caller checks that)
''
'' Used by stopMotor()/emergencyCutoff() with no front cog running, and by an owner whose own front cog is not running.
''
'' @param bEStop - T/F where T also latches the emergency stop

    if bEStop <> FALSE
        e_stop := ES_HARD
    motorPower := 0                                                             ' PL-52: this is a genuine stop
    setTargetAccel(0, false)
    releaseFaultLatch()                                                         ' task 3616: a commanded stop clears a fault

PUB getposTrkHallTicks() : retv
'' INTERNAL USE: return the odometer in hall ticks: the total travel, either way, since the last resetTracking() or start() (PL-153)
''
'' @returns retv - the odometer's hall-tick count, never negative

    retv := posTrkHallTicks

PUB applyStartSettings()
'' INTERNAL USE: apply the program's kept settings (PL-155) once a start's checks have passed, and let the setters act at once from now on
''
'' start() calls it; an owner that starts this motor with startOwned() (isp_steering_2wheel) calls it once its checks
'' pass. The start checks and the rest zero run with the motor floated (init()'s SM_FLOAT), so the kept stop mode is
'' applied only here. stop() ends it: a setter then only stores its value for the next start.

    bSettingsLive := TRUE                                                       ' first: a setter racing this writes the working copy too
    applyUserSettings()
    bRampsStale := TRUE                                                         ' DRIVER_REV 40: the ramp, by the front cog (frontApplyRamps())
    stop_mode := usrStopMode                                                    ' the stop mode last: the checks are over
    if stop_mode <> SM_BRAKE
        stop_mode := SM_FLOAT                                                   ' never set: coast, the default

PUB frontApplyRamps()
'' FRONT COG ONLY: apply this motor's ramp when a setter, the wiring walk or a start has asked (DRIVER_REV 40)
''
'' The one writer of the four working ramp longs once the driver runs. Setters, walkRamps() and applyStartSettings()
'' only write their inputs and then raise bRampsStale (requestRamps()). The flag is lowered BEFORE the inputs are read,
'' so an input written after it is lowered raises it again and the next call applies it: whatever the interleaving,
'' the last apply reads the last inputs. bRampsBusy spans the apply, so a waiting caller can tell that the apply that
'' read its inputs has finished.
''
'' PL-161 budget (DRIVER_REV 40), BY CONSTRUCTION: the owner's loop is its ONLY caller -- no request applies a ramp
'' (a walk leg is posted only after walkRamps(TRUE) has seen its apply) -- and calls it only on an odd phase, which no
'' slot job uses (RAMP_PHASE_BIT), for ONE motor a pass: this object's frontLoop() every odd phase,
'' isp_steering_2wheel's the left wheel on 1 and 5 and the right on 3 and 7 (RAMP_WHEEL_BIT). Its cost: one compare
'' while nothing is asked; else three flag writes and applyRamps() -- at most five calls (applyRamps(), keptRamps() or
'' none, rampsFor(), jerkForAccel() twice), two MULDIV64, about twelve compares and clamps, four hub writes, and NO
'' float: the built-in steps are init()'s (rampBuiltinUp, rampBuiltinDn), no longer converted from mm/s^2 here (that
'' was two builtinStep() chains a wheel, each six calls and 13 float operations, 26 in all). The wait it answers is
'' bounded: a raised flag is applied within 2 passes (this object) or 4 (a steering wheel), about 4 ms at worst,
'' inside REQ_ACK_TIMEOUT_MS.

    if bRampsStale <> FALSE
        bRampsBusy := TRUE                                                      ' first: a caller that sees the flag down waits on this
        bRampsStale := FALSE                                                    ' before the read: a later request is not lost
        applyRamps()
        bRampsBusy := FALSE

PUB ticksForRotation(nRotationCount, eRotationUnits) : eError, nStopTicks | degreesPerTic, ticsPerRotation
'' INTERNAL USE: validate a rotation and convert it to hall ticks, with no side effects and nothing recorded (for isp_steering_2wheel)
''
'' PL-158: DRU_DEGREES rounds to the nearest tick (a remainder of half a tick or more rounds up).
''
'' @param nRotationCount - rotation to travel, at least 1, resolving to at least one hall tick
'' @param eRotationUnits - units of {nRotationCount}: DRU_HALL_TICKS, DRU_DEGREES or DRU_ROTATIONS
'' @returns eError - NO_ERROR, ERR_BAD_COUNT (less than 1, or more hall ticks than a long holds), ERR_BAD_UNITS or ERR_LIMIT_UNRESOLVABLE
'' @returns nStopTicks - the rotation in hall ticks; meaningful only when {eError} is NO_ERROR

' Local Variables:
' @local degreesPerTic - degrees of rotation per hall tick for this motor
' @local ticsPerRotation - hall ticks per rotation for this motor

    eError := NO_ERROR
    nStopTicks := 0
    degreesPerTic, ticsPerRotation := hallTicInfoForMotor()
    if nRotationCount < 1
        eError := ERR_BAD_COUNT
    else
        case eRotationUnits
            DRU_HALL_TICKS:
                nStopTicks := nRotationCount
            DRU_DEGREES:
                ' ticks = degrees / 4 (6.5"), to the nearest tick; the remainder is doubled, never the count, so no overflow
                nStopTicks := nRotationCount / degreesPerTic
                if (nRotationCount // degreesPerTic) * 2 >= degreesPerTic
                    nStopTicks++
            DRU_ROTATIONS:
                ' ticks = rotations * 90 (6.5"); a count whose ticks would not fit a long is refused, not wrapped
                if nRotationCount > POSX / ticsPerRotation
                    eError := ERR_BAD_COUNT
                else
                    nStopTicks := nRotationCount * ticsPerRotation
            other:
                eError := ERR_BAD_UNITS
        if (eError == NO_ERROR) and (nStopTicks < 1)
            eError := ERR_LIMIT_UNRESOLVABLE

PRI readEvent(bAdvance) : eKind, nMs, nValue | cogIdx, nCursor, nHead, nLag, slotIdx
' Read the calling cog's next event from the log (getEvent(), peekEvent()), advancing its cursor only when asked.
'
' Each cog's cursor has one writer, this cog; the ring and its head one writer, the front cog (as getError()'s
' cmdTimeoutSeen). The ring holds EV_QUEUE_DEPTH + 1 slots, and the front cog writes a slot before it publishes the
' head, so the slot it may be rewriting is never one a cog within EV_QUEUE_DEPTH of the head is copying: a copy
' followed by a head still within EV_QUEUE_DEPTH was whole.
'
' @param bAdvance - T/F where T moves this cog's cursor past what is returned (getEvent()), F leaves it (peekEvent())
' @returns eKind - the EV_* kind; EV_NONE when nothing is unread, EV_LOST when events were lost before the next one
' @returns nMs - getms() when the event was queued (for EV_LOST, getms() now); 0 for EV_NONE
' @returns nValue - the event's value, meaning per EV_* (for EV_LOST, how many were lost); 0 for EV_NONE

' Local Variables:
' @local cogIdx - this cog's id, the index of its own cursor
' @local nCursor - the next sequence this cog reads
' @local nHead - the front cog's published head, read once per step
' @local nLag - events queued that this cog has not read
' @local slotIdx - the ring slot of {nCursor}

    cogIdx := COGID()
    if evCursorEpoch[cogIdx] <> evEpoch                                        ' a cursor from an earlier start() is dropped
        evCursor[cogIdx] := 0
        evCursorEpoch[cogIdx] := evEpoch
    eKind := EV_NONE
    nMs := 0
    nValue := 0
    nCursor := evCursor[cogIdx]
    nHead := evHead
    nLag := nHead - nCursor
    if nLag < 0                                                                 ' only if read across a start(): read from the start
        nCursor := 0
        nLag := nHead
    if (nLag > 0) and (nLag <= EV_QUEUE_DEPTH)
        slotIdx := nCursor +// EV_RING_SLOTS
        eKind := evKind[slotIdx]
        nMs := evMs[slotIdx]
        nValue := evVal[slotIdx]
        nHead := evHead                                                         ' again: did the front cog lap the copy?
        nLag := nHead - nCursor
        if (nLag <= EV_QUEUE_DEPTH) and (bAdvance == TRUE)
            evCursor[cogIdx] := nCursor + 1
    if nLag > EV_QUEUE_DEPTH                                                    ' fell behind (or lapped during the copy)
        eKind := EV_LOST
        nMs := getms()
        nValue := nLag - EV_QUEUE_DEPTH
        if bAdvance == TRUE
            evCursor[cogIdx] := nHead - EV_QUEUE_DEPTH                          ' the oldest event still retained is read next

PRI probeLeads(eWithheld) : nPhasesFailed | ePhase, eOther, nSample, nPhaseMv[3], nFollows[3], bDriven[3]
' The start checks' lead probe (R19.4): drive each phase in turn at 50 % with the other two off, and judge each lead.
'
' Called only from runStartChecks(), at rest and before any drive request, so the probe longs have one writer. Leaves
' probe_phase at PRB_NONE and the bridge settled. Records each probe's readings in probeMv (testGetProbe()).
'
' @param eWithheld - PRB_U, PRB_V or PRB_W to leave undriven (TEST-USE), or PRB_NONE
' @returns nPhasesFailed - the HLT_PHASE_* bits of the leads that followed no other phase or could not be driven

' Local Variables:
' @local ePhase - the phase being probed, PRB_U..PRB_W
' @local eOther - a phase index 0..2 while reading or judging
' @local nSample - the reading loop counter
' @local nPhaseMv - this probe's averaged U, V and W readings, mV
' @local nFollows - per phase, the probes in which it followed the driven phase
' @local bDriven - per phase, T/F where T means it read at least CONT_MIN_DRIVEN_MV when it was the one driven

    nPhasesFailed := 0
    longfill(@nFollows, 0, 3)
    longfill(@bDriven, FALSE, 3)
    repeat ePhase from PRB_U to PRB_W
        probe_phase := (ePhase == eWithheld) ? PRB_NONE : ePhase                ' the driver's restBridge takes BR_PROBE on its next pass; a withheld phase stays undriven
        waitms(PROBE_SETTLE_MS)
        longfill(@nPhaseMv, 0, 3)
        repeat nSample from 1 to PROBE_SAMPLES
            nPhaseMv[0] += sense_u_mV
            nPhaseMv[1] += sense_v_mV
            nPhaseMv[2] += sense_w_mV
            waitms(1)
        repeat eOther from 0 to 2
            nPhaseMv[eOther] /= PROBE_SAMPLES
            probeMv[(ePhase - PRB_U) * 3 + eOther] := nPhaseMv[eOther]
        bDriven[ePhase - PRB_U] := (nPhaseMv[ePhase - PRB_U] >= CONT_MIN_DRIVEN_MV)
        repeat eOther from 0 to 2
            if (eOther <> ePhase - PRB_U) and (nPhaseMv[eOther] * 100 >= nPhaseMv[ePhase - PRB_U] * CONT_FOLLOW_PCT) and (bDriven[ePhase - PRB_U] == TRUE)
                nFollows[eOther]++
    probe_phase := PRB_NONE                                                     ' restBridge restores the stop mode's bridge
    waitms(PROBE_SETTLE_MS)
    repeat eOther from 0 to 2
        if (nFollows[eOther] == 0) or (bDriven[eOther] == FALSE)
            nPhasesFailed |= HLT_PHASE_U << eOther

PRI bSenseZeroOutOfBand() : bOut
' Return TRUE when the current sense's rest zero lies outside this board revision's band (HLT_SENSE_ZERO fails).
'
' @returns bOut - T/F where T means restZeroSenseMv is outside the band

    if eDetectedBoard == REV_A
        bOut := (restZeroSenseMv < REST_ZERO_MIN_MV_REVA) or (restZeroSenseMv > REST_ZERO_MAX_MV_REVA)
    else
        bOut := (restZeroSenseMv < REST_ZERO_MIN_MV) or (restZeroSenseMv > REST_ZERO_MAX_MV)

PRI applySenseZero() | nZeroMv
' Hand the driver's per-frame current fold-back the rest offset it nets out (PL-146, DRIVER_REV 37): sense_zero, the
' last long of the parameter run, which the driver reloads every frame.
'
' The offset is restZeroSenseMv, in sense_i_mV's own units (mV), so the driver subtracts it as read. Never negative: a
' negative offset would ADD to every reading and fold back earlier than the raw reading did. And 0 when the rest zero
' is outside this board's band (HLT_SENSE_ZERO fails): a channel reading a railed or dead zero must not be allowed to
' blind the fold-back by that much; the raw compare, as before DRIVER_REV 37, is the safe side. Written only here, by
' the cog running start() (restZeroBegin(), restZeroFinish()), as restZeroSenseMv itself is; one long, written once.

' Local Variables:
' @local nZeroMv - the offset handed over, mV

    nZeroMv := 0
    if bSenseZeroOutOfBand() == FALSE
        nZeroMv := restZeroSenseMv #> 0
    sense_zero := nZeroMv

PRI bHallCodeLegal() : bLegal
' Return TRUE when the hall code the driver last read is legal, neither %000 nor %111.
'
' @returns bLegal - T/F where F means a hall sensor reads dead, unpowered, disconnected or stuck high

    bLegal := ((hall & %111) <> %000) and ((hall & %111) <> %111)

PRI unbiasedMeanMv(nSum, nCount) : nMv | nFloorMean
' DRIVER_REV 40: return the mean of {nCount} FLOORED whole-mV sense readings, made unbiased: round(mean + 0.5).
'
' Each reading is the driver's sar #11 of a finer count, so it lies 0 .. 1 mV under what it read; with the +-3 mV
' noise spreading the true value over several counts that error averages 0.5 mV, and the mean + 0.5 is unbiased. It
' is rounded to a whole mV, round(mean + 0.5) = floor(mean) + 1, with the mean FLOORED, never truncated toward 0 (a
' sum may be negative). restZeroFinish() (the rest zero) and measureWindings() (a winding's net mean) share it, so
' both are the same estimate of the same kind of reading.
'
' @param nSum - the readings' sum, mV
' @param nCount - how many readings, at least 1
' @returns nMv - floor(nSum / nCount) + 1, mV

' Local Variables:
' @local nFloorMean - the readings' mean, floored

    nFloorMean := nSum / nCount                                                 ' truncated toward 0 ...
    if nFloorMean * nCount > nSum
        nFloorMean--                                                            ' ... so floored below 0
    nMv := nFloorMean + 1

PRI measureWindings() | ePair, eFrom, eSink, nLevel, nElapsed, nNet, nSum, nTaken, nStill, nPos, bTripped, nVoltMv, nLimitMv, nMinMv
' TEST USE (R19.4 1e, task 3610): drive each winding pair at WIND_DUTY_PCT and record its resistance (testGetWinding())
'
' Called only from runStartChecks(), at rest and before any front cog commands the driver, so the probe longs have one
' writer. Each pair: the return phase's low side on, then the driven phase at nLevel. Readings are taken only after
' WIND_SETTLE_MS and once the halls have held still for WIND_STILL_MS, since a turning rotor's back-EMF biases the
' current; a hall change discards them and starts again. The pair ends at once if the net DC-link reading passes
' WIND_I_LIMIT_MA. R = d^2 x V / I_dc = (nLevel / F)^2 x V x rSense / net. V is windVoltage()'s, read before the first
' pair and kept for testGetWindingVoltage() (R20.4): the measured pack when the sensor reads one, else the nominal.
' DRIVER_REV 40: the net mean is unbiasedMeanMv()'s, as the rest zero is (it was the truncated mean, 0.5 .. 1.5 mV low).
' The trip compare takes the same half count: a reading r floors the net y it read, so it passes the whole-mV bound n
' when r + 1/2 > n, i.e. r >= n, which is exactly y >= n. Until then it was r > n, i.e. y >= n + 1: one count late
' (6.7 mA on Rev B, the only board that drives a pair). The tripping reading is kept as read (WND_TRIPPED's value).
'
' @local ePair - 0..2: U->V, V->W, W->U
' @local eFrom - the driven phase, PRB_*
' @local eSink - the return phase, PRB_*
' @local nLevel - the driven high side's Y, WIND_DUTY_PCT of the frame's F
' @local nElapsed - ms since the pair was driven
' @local nNet - one reading's DC-link mV over the rest zero
' @local nSum - the settled readings' sum
' @local nTaken - the settled readings taken, at most WIND_SAMPLES
' @local nStill - ms the halls have held one position
' @local nPos - the hall position they held
' @local bTripped - T/F where T means the pair passed WIND_I_LIMIT_MA
' @local nVoltMv - the drive voltage R is computed with, mV (windVoltage())
' @local nLimitMv - WIND_I_LIMIT_MA on this board's sense scale, mV
' @local nMinMv - WIND_MIN_VISIBLE_MA on this board's sense scale, mV

    windVoltSrc, nVoltMv := windVoltage()                                       ' R20.4: at rest, before any pair is driven
    windVoltMv := nVoltMv
    nLevel := muldiv64(frame_cnt / 2, WIND_DUTY_PCT, 100)
    nLimitMv := 0
    nMinMv := 0
    if rSenseForBoard <> VALUE_NOT_SET
        nLimitMv := muldiv64(WIND_I_LIMIT_MA, rSenseForBoard, 1_000)
        nMinMv := muldiv64(WIND_MIN_VISIBLE_MA, rSenseForBoard, 1_000)
    repeat ePair from 0 to 2
        eFrom := PRB_U + ePair
        eSink := PRB_U + ((ePair + 1) // 3)
        bTripped := FALSE
        nSum := 0
        nTaken := 0
        windNetMv[ePair] := 0
        if (rSenseForBoard == VALUE_NOT_SET) or (rSenseForBoard < WIND_MIN_RSENSE)  ' no scale fine enough to read or guard it
            windState[ePair] := WND_NOT_VISIBLE
        elseif (eFrom == testProbeWithhold) or (eSink == testProbeWithhold)     ' a withheld phase neither drives nor returns
            windState[ePair] := WND_NOT_VISIBLE
        else
            probe_y := nLevel                                                   ' the level and the return first: probe_phase starts it
            probe_sink := eSink
            probe_phase := eFrom
            nPos := pos
            nStill := 0
            repeat nElapsed from 1 to WIND_SETTLE_MAX_MS
                waitms(1)
                nNet := sense_i_mV - restZeroSenseMv
                if nNet >= nLimitMv                                             ' DRIVER_REV 40: r + 1/2 > n (was r > n, a count late)
                    bTripped := TRUE
                    quit
                if pos <> nPos                                                  ' the rotor turned: its back-EMF biased what was taken
                    nPos := pos
                    nStill := 0
                    nSum := 0
                    nTaken := 0
                else
                    nStill++
                if (nElapsed > WIND_SETTLE_MS) and (nStill >= WIND_STILL_MS)
                    nSum += nNet
                    nTaken++
                    if nTaken >= WIND_SAMPLES
                        quit
            probe_phase := PRB_NONE                                             ' the pair ends before anything is computed
            probe_sink := PRB_NONE
            probe_y := 0
            if nTaken > 0
                windNetMv[ePair] := unbiasedMeanMv(nSum, nTaken)                ' DRIVER_REV 40: restZeroFinish()'s mean (was the truncated one)
            if bTripped
                windNetMv[ePair] := nNet                                        ' the reading that tripped it, as its compare read it
                windState[ePair] := WND_TRIPPED
            elseif nTaken < WIND_SAMPLES
                windState[ePair] := WND_UNSETTLED
            elseif (windNetMv[ePair] < nMinMv) or (windNetMv[ePair] <= 0)
                windState[ePair] := WND_NOT_VISIBLE
            else
                windMohm[ePair] := muldiv64(nVoltMv * rSenseForBoard, nLevel * nLevel, (frame_cnt / 2) * (frame_cnt / 2)) / windNetMv[ePair]
                windState[ePair] := WND_MEASURED
            waitms(PROBE_SETTLE_MS)                                             ' the winding's current decays before the next pair
    debug[user.DBGCH_LIFECYCLE]("* winding check ", sdec_long_array(@windState, 3), sdec_long_array(@windMohm, 3), sdec_long_array(@windNetMv, 3), sdec_long(windVoltSrc), sdec_long(windVoltMv))

PRI frontLatchStop(eKind)
' FRONT COG ONLY: latch the stop that secures this motor, and write a zero command
'
' @param eKind - ES_HARD (an emergency stop: the phases shorted) or ES_PROTECT (a protective stop: the stop mode's state)

    motorPower := 0                                                             ' PL-52: an e-stop is a genuine stop, not a fault
    bWalkTripped := FALSE                                                       ' PL-122: an e-stop taken now is not the walk guard's to release
    e_stop := eKind                                                             ' one write, so the driver never sees the other kind first
    frontCommand(0, FALSE)

PRI bWalkLeg(eLeg, power) : bOk | startMs
' Drive one leg of checkWiring(): WALK_TICKS at {power} under the current guard, then wait, bounded, for rest.
'
' @param eLeg - WLEG_OUT or WLEG_BACK: the leg's record (PL-137)
' @param power - the leg's power, its sign the direction
' @returns bOk - T/F where T means the leg was driven, came to rest, did not fault and was not shorted by the guard

' Local Variables:
' @local startMs - getms() when the leg was posted

    bOk := (postRequest(REQ_WALK, eLeg, power, 0) == NO_ERROR)                 ' arms the leg's distance, counted from the post
    if bOk == FALSE
        walkNoteLeg(eLeg, FALSE)
    else
        startMs := getms()
        waitms(WALK_START_MS)
        repeat until (drv_state == DCS_STOPPED) or (drv_state == DCS_FAULTED) or (drv_state == DCS_ESTOP) or (getms() - startMs >= WALK_LEG_TIMEOUT_MS)
            waitms(1)
        bOk := (drv_state == DCS_STOPPED)
        walkNoteLeg(eLeg, TRUE)                                                 ' PL-137: before the release or stop below
        if bWalkTripped == TRUE
            postRequest(REQ_CLEAR_ESTOP, 0, 0, 0)                               ' PL-122: the guard's short, released: the leg failed
        elseif bOk == FALSE
            postRequest(REQ_STOP, 0, 0, 0)                                      ' a leg that faulted or timed out ends stopped

PRI frontWalkWatch() | eLeg, nowPos, eDrvState
' FRONT COG: once per pass while a walk leg is watched (frontWalkGuard()) -- follow its position, and note the driver's
' first rest state after the leg's motion (PL-137). Only a moving rotor costs more than two reads.
'
' "After the leg's motion" is the first DCS_SPIN_UP, DCS_AT_SPEED or DCS_SLOW_TO_CHG seen since the post, so neither
' the rest the leg left nor the ramp-down of an earlier motion is read as this leg's stop.

' Local Variables:
' @local eLeg - the WLEG_* watched
' @local nowPos - the driver's position this pass
' @local eDrvState - the driver state this pass

    eLeg := walkWatchLeg
    nowPos := pos
    if nowPos <> wlLastPos[eLeg]
        wlLastPos[eLeg] := nowPos
        wlLastMoveMs[eLeg] := getms() - wlPostMs[eLeg]
        if abs(nowPos - wlPostPos[eLeg]) > abs(wlPeakPos[eLeg] - wlPostPos[eLeg])
            wlPeakPos[eLeg] := nowPos
    if bFaultBegan == TRUE                                                      ' this pass's frontTrack() raised it
        bWlFaultSeen[eLeg] := TRUE
    if wlStopMs[eLeg] == WALK_NA
        eDrvState := drv_state
        if bWlLeftRest[eLeg] == FALSE
            bWlLeftRest[eLeg] := (eDrvState == DCS_SPIN_UP) or (eDrvState == DCS_AT_SPEED) or (eDrvState == DCS_SLOW_TO_CHG)
        elseif (eDrvState == DCS_STOPPED) or (eDrvState == DCS_FAULTED) or (eDrvState == DCS_ESTOP)
            wlStopPos[eLeg] := nowPos
            wlStopMs[eLeg] := getms() - wlPostMs[eLeg]                          ' LAST: marks the stop noted

PRI frontWalkClose() | eLeg
' FRONT COG: end the watched walk leg's watch -- its last reading, taken now, is where the rotor settled (PL-137). Called
' by the next drive command (frontCommand()) and by the next leg's opening (frontWalkBegin()).

' Local Variables:
' @local eLeg - the WLEG_* whose watch ends

    eLeg := walkWatchLeg
    frontWalkWatch()                                                            ' one last reading, at the close
    walkWatchLeg := WLEG_NONE
    bWlClosed[eLeg] := TRUE                                                     ' after the reading: a getter that sees it reads a final pos

PRI walkLegOpen(eLeg, nPostPos)
' Empty walk leg {eLeg}'s front-written record and start it at {nPostPos} (PL-137): frontWalkBegin() on the front cog,
' walkRecordReset() in init() before the front cog exists. Leaves wlPostMs to its caller.
'
' @param eLeg - WLEG_OUT or WLEG_BACK
' @param nPostPos - the position the leg starts from, or WALK_NA for a leg emptied until its own post

    wlPostPos[eLeg] := nPostPos
    wlPeakPos[eLeg] := nPostPos
    wlLastPos[eLeg] := nPostPos
    wlLimMs[eLeg] := wlLimPos[eLeg] := wlLimTrk[eLeg] := wlLimStopTk[eLeg] := WALK_NA
    wlStopMs[eLeg] := wlStopPos[eLeg] := wlLastMoveMs[eLeg] := WALK_NA
    wlLag0[eLeg] := lag_held
    bWlLeftRest[eLeg] := bWlFaultSeen[eLeg] := bWlClosed[eLeg] := FALSE

PRI walkRecordReset() | eLeg
' init(), before the front cog exists: no walk leg recorded and none watched (PL-137).

' Local Variables:
' @local eLeg - WLEG_OUT, then WLEG_BACK

    walkWatchLeg := WLEG_NONE
    limitStopTicks := 0
    repeat eLeg from WLEG_OUT to WLEG_BACK
        walkLegOpen(eLeg, WALK_NA)
        wlPostMs[eLeg] := 0
        wlEnd[eLeg] := WLE_NOT_RUN
        wlEndMs[eLeg] := wlEndPos[eLeg] := wlLagHeld[eLeg] := WALK_NA
        bWlRan[eLeg] := FALSE

PRI bPackPinUsable() : bUsable | nPin
' Return TRUE when this instance may read the pack sensor: user.PACK_SENSOR_FITTED, and user.PACK_SENSE_PIN is a P2 pin
' outside this motor's own pin group AND outside every group another instance has claimed (the AE registry). R20.4:
' both wheels of a steering object read the pin, and a motor board's pin must never be restarted as an ADC -- base+8..13
' drive the gates -- so a pin in EITHER wheel's group is refused by both.
'
' @returns bUsable - T/F where F means the sensor is not fitted, or its pin is not one this instance may read
'
' @local nPin - user.PACK_SENSE_PIN

    nPin := user.PACK_SENSE_PIN
    bUsable := (user.PACK_SENSOR_FITTED <> FALSE) and (nPin >= 0) and (nPin <= 63) and ((nPin < pinbase) or (nPin >= pinbase + 16))
    bUsable &= (gOwnerP0P15 == 0) or (nPin > 15)
    bUsable &= (gOwnerP8P23 == 0) or (nPin < 8) or (nPin > 23)
    bUsable &= (gOwnerP16P31 == 0) or (nPin < 16) or (nPin > 31)
    bUsable &= (gOwnerP32P47 == 0) or (nPin < 32) or (nPin > 47)
    bUsable &= (gOwnerP40P55 == 0) or (nPin < 40) or (nPin > 55)

PRI packCalibrate(nPin)
' Start the pack pin's ADC and take its GIO and VIO readings, then leave it reading the pin (P_ADC_1X): P2AN001's GIO,
' VIO, then the pin, through one path. packMvFromRaw() converts through the two readings taken here. ~1 ms.
'
' @param nPin - the pack sensor pin

    pinstart(nPin, P_ADC | P_ADC_GIO, PACK_ADC_X, 0)
    packGioRaw := packRead(nPin)
    wrpin(nPin, P_ADC | P_ADC_VIO)
    packVioRaw := packRead(nPin)
    wrpin(nPin, P_ADC | P_ADC_1X)

PRI windVoltage() : ePackStatus, nMilliVolts | nPin, nSum
' The drive voltage the winding check computes with (R20.4): the pack sensor's reading when the sensor is fitted, this
' instance may read it (bPackPinUsable()) and it reads a pack now; otherwise the nominal drive voltage (getDriveVoltage()).
'
' THE READING IS TAKEN HERE, AVERAGED. runStartChecks() runs before startPackSense() in every start, and a steering
' object's right wheel never reads the sensor at all, so no front-cog average exists yet. This takes its own:
' packCalibrate(), then PACK_CHECK_READS readings PACK_CHECK_GAP_MS apart, each itself PACK_CAL_SAMPLES SINC2 samples
' after the flush (packRead()) -- the same ~64 ms the front cog's average spans, never one sample. ~70 ms, only when
' the winding check is armed. The pin is left reading (P_ADC_1X), not cleared: startPackSense() starts it again, and
' another object already reading the pin keeps its reading. An instance that already reads it uses its own average.
'
' @returns ePackStatus - PACK_PRESENT when nMilliVolts is the pack's reading; PACK_ABSENT (fitted, read no pack) or
'   PACK_NOT_FITTED (not fitted, or not readable here) when it is the nominal voltage
' @returns nMilliVolts - the voltage, mV
'
' @local nPin - user.PACK_SENSE_PIN
' @local nSum - the readings summed, mV; then their mean

    _, nMilliVolts := getDriveVoltage()
    ePackStatus := PACK_NOT_FITTED
    nPin := user.PACK_SENSE_PIN
    if bPackPinUsable() == TRUE
        if bPackOwned == TRUE
            nSum := packMvFromAvg()
        else
            packCalibrate(nPin)
            nSum := 0
            repeat PACK_CHECK_READS
                waitms(PACK_CHECK_GAP_MS)
                nSum += packMvFromRaw(packRead(nPin))
            nSum /= PACK_CHECK_READS
        ePackStatus := packStatusFor(nSum)
        if ePackStatus == PACK_PRESENT
            nMilliVolts := nSum

PRI packRead(nPin) : nRaw | nSample
' Return the pack pin's reading in its current source, after P2AN001's flush: PACK_FLUSH_SAMPLES discarded, then
' PACK_CAL_SAMPLES averaged.
'
' @param nPin - the pack sensor pin
' @returns nRaw - the averaged SINC2 sample

' Local Variables:
' @local nSample - the sample loop counter

    waitct(getct() + PACK_SAMPLE_CLOCKS * PACK_FLUSH_SAMPLES)
    nRaw := 0
    repeat nSample from 1 to PACK_CAL_SAMPLES
        waitct(getct() + PACK_SAMPLE_CLOCKS)
        nRaw += rdpin(nPin)
    nRaw /= PACK_CAL_SAMPLES

PRI packStatusFor(nPackMv) : ePackStatus
' Return the pack sensor's status for an averaged reading: the one threshold getPackVoltage() and EV_PACK both use.
'
' @param nPackMv - the averaged pack voltage, mV
' @returns ePackStatus - PACK_ABSENT under PACK_ABSENT_MV, else PACK_PRESENT

    ePackStatus := (nPackMv < PACK_ABSENT_MV) ? PACK_ABSENT : PACK_PRESENT

PRI packMvFromRaw(nRaw) : nPackMv
' Return the pack voltage for one pin reading: ratiometric against GIO and VIO, through the divider, calibrated.
'
' @param nRaw - a SINC2 sample in the pin's P_ADC_1X source
' @returns nPackMv - the pack voltage, mV, never negative

    nPackMv := 0
    if packVioRaw > packGioRaw
        nPackMv := muldiv64(nRaw - packGioRaw, PACK_FULL_SCALE_MV, packVioRaw - packGioRaw) #> 0
        nPackMv := muldiv64(nPackMv, PACK_DIVIDER_X100 * user.PACK_SENSE_CAL_PERMILLE, 100 * 1000)

PRI packMvFromAvg() : nPackMv
' Return the pack voltage for the front cog's running average (packAvgRaw): packMvFromRaw()'s conversion, made only
' when a reader asks (PL-161), so the front cog does no arithmetic on the pack but the sum and the average.
'
' The average carries PACK_AVG_SHIFT fraction bits, and they are kept through the conversion: the first step yields
' the pack's hundredths of a mV before calibration (pin mV x PACK_DIVIDER_X100), never a whole pin mV. The old
' per-sample conversion truncated each sample to a whole pin mV first, about 7.8 pack mV a step.
'
' @returns nPackMv - the averaged pack voltage, mV, never negative; 0 when the calibration is unusable

    nPackMv := 0
    if packVioRaw > packGioRaw
        nPackMv := muldiv64(packAvgRaw - (packGioRaw << PACK_AVG_SHIFT), PACK_FULL_SCALE_MV * PACK_DIVIDER_X100, (packVioRaw - packGioRaw) << PACK_AVG_SHIFT) #> 0
        nPackMv := muldiv64(nPackMv, user.PACK_SENSE_CAL_PERMILLE, 100 * 1000)

PRI releasePinBaseClaim()
' AE: free whichever slot this instance currently owns (matched by @pinbase, a stable
' per-instance identity), so re-init or stop()/restart on the same or a different base never
' self-conflicts and never leaks a stale claim.

    if gOwnerP0P15 == @pinbase
        gOwnerP0P15 := 0
    if gOwnerP8P23 == @pinbase
        gOwnerP8P23 := 0
    if gOwnerP16P31 == @pinbase
        gOwnerP16P31 := 0
    if gOwnerP32P47 == @pinbase
        gOwnerP32P47 := 0
    if gOwnerP40P55 == @pinbase
        gOwnerP40P55 := 0

PRI bHoldsPinBaseClaim() : bHeld
' Return TRUE when this instance currently owns a pin-range claim, i.e. a successful init()
' (start()/startEx()/testSetup()) claimed a legal group and stop() has not yet released it.
' A slot only ever holds @pinbase of the instance that claimed it, so an instance that was
' never initialised -- or whose claim was refused -- cannot match.
'
' @returns bHeld - TRUE when one of the gOwner* slots holds this instance's @pinbase

    bHeld := (gOwnerP0P15 == @pinbase) or (gOwnerP8P23 == @pinbase) or (gOwnerP16P31 == @pinbase) or (gOwnerP32P47 == @pinbase) or (gOwnerP40P55 == @pinbase)

PRI bClaimPinBase(eMotorBasePin) : bClaimed
' AE: claim {eMotorBasePin}'s 16-pin range for this instance, first releasing whatever range
' this same instance previously held. Fails (does not claim) if the requested range overlaps a
' range another instance already owns. The only overlapping legal-base pairs are the adjacent
' ones 8 pins apart: (P0_P15, P8_P23), (P8_P23, P16_P31) and (P32_P47, P40_P55); PINS_NO_USE_P24_P39
' is not a legal base (see validBasePinForChoice()) and never enters this check.
'
' @param eMotorBasePin - The base pin ENUM (PINS_*) for adapter board for this motor
' @returns bClaimed - TRUE when the range was claimed; FALSE when another instance already owns an overlapping range

    ' Release first, so a re-init or a restart on the same base never conflicts with
    ' this instance's own previous claim. Each case below must therefore also test its
    ' OWN slot: after the release, a non-zero own-slot can only mean ANOTHER instance
    ' holds it -- which is the identical-base collision, the most obvious one of all.
    releasePinBaseClaim()
    bClaimed := TRUE
    case eMotorBasePin
        PINS_P0_P15:
            if gOwnerP0P15 <> 0 or gOwnerP8P23 <> 0
                bClaimed := FALSE
            else
                gOwnerP0P15 := @pinbase
        PINS_P8_P23:
            if gOwnerP8P23 <> 0 or gOwnerP0P15 <> 0 or gOwnerP16P31 <> 0
                bClaimed := FALSE
            else
                gOwnerP8P23 := @pinbase
        PINS_P16_P31:
            if gOwnerP16P31 <> 0 or gOwnerP8P23 <> 0
                bClaimed := FALSE
            else
                gOwnerP16P31 := @pinbase
        PINS_P32_P47:
            if gOwnerP32P47 <> 0 or gOwnerP40P55 <> 0
                bClaimed := FALSE
            else
                gOwnerP32P47 := @pinbase
        PINS_P40_P55:
            if gOwnerP40P55 <> 0 or gOwnerP32P47 <> 0
                bClaimed := FALSE
            else
                gOwnerP40P55 := @pinbase

PRI setupForStart(eMotorBasePin, eMotorVoltage, eDetectionMode) : eError
' Validate every start argument, then free this instance's previous driver, claim the pin group and init().
'
' @param eMotorBasePin - The base pin ENUM (PINS_*) for adapter board for this motor
' @param eMotorVoltage - The voltage ENUM (PWR_*) for this motor
' @param eDetectionMode - The detection mode ENUM (BRD_*) for this motor
' @returns eError - NO_ERROR when this instance now holds the claim and is initialised, else the recorded ERR_* code

    ' 1. validate, with no side effects: a rejected call leaves a running motor running, unchanged
    eError := NO_ERROR
    if validBasePinForChoice(eMotorBasePin) == INVALID_PIN_BASE
        eError := ERR_BAD_PIN_GROUP
    elseif validVoltageForChoice(eMotorVoltage) == INVALID_VOLTAGE
        eError := ERR_BAD_VOLTAGE
    elseif validDetectModeForChoice(eDetectionMode) == INVALID_DET_MODE
        eError := ERR_BAD_DETECT_MODE
    elseif isAbiLayoutValid() == FALSE
        eError := ERR_ABI_MISMATCH

    if eError == NO_ERROR
        ' 2. D2: free this instance's own driver/sense cog and pin claim before starting fresh
        if motorCog or senseCog or bHoldsPinBaseClaim()
            stop()
        ' 3. AE: an overlapping pin group is a wiring conflict -- two driver cogs would command the shared pins
        if bClaimPinBase(eMotorBasePin) == FALSE
            eError := ERR_PIN_GROUP_IN_USE
            debug[user.DBGCH_ERROR]("! ERROR: pin base ", udec_long(eMotorBasePin), " overlaps a pin range already in use by another motor instance")
        else
            ' 4. every argument is valid and the pins are ours, so init() cannot fail
            init(eMotorBasePin, eMotorVoltage, eDetectionMode)
    else
        debug[user.DBGCH_ERROR]("! ERROR: start rejected ", sdec_long(eError), sdec_long(eMotorBasePin), sdec_long(eMotorVoltage), sdec_long(eDetectionMode))

    eError := recordError(eError)

PRI launchDriver(eMotorBasePin, eMotorVoltage, eDetectionMode, bParked) : eError | driverCogId
' Validate and initialise this instance, then launch its PASM driver cog; a failure leaves nothing running.
'
' @param eMotorBasePin - The base pin ENUM (PINS_*) for adapter board for this motor
' @param eMotorVoltage - The voltage ENUM (PWR_*) for this motor
' @param eDetectionMode - The detection mode ENUM (BRD_*) for this motor
' @param bParked - T/F where T means the driver waits for an ATN before it starts driving
' @returns eError - NO_ERROR when the driver cog runs, else the ERR_* code also recorded for getError() (ERR_BOARD_NOT_DETECTED when auto-detection found no board)

' Local Variables:
' @local driverCogId - the value coginit() returned

    eError := setupForStart(eMotorBasePin, eMotorVoltage, eDetectionMode)
    if (eError == NO_ERROR) and (eDetectedBoard == REV_Unknown)
        ' PL-73: with no board detected there is no current-sense scale, so the driver would run with no
        '  current limit at all. A board is driven only when detected, or when the user forced a revision
        '  (which setupForStart() reports as that revision). stop() releases the claim and the pins.
        stop()
        eError := recordError(ERR_BOARD_NOT_DETECTED)
        debug[user.DBGCH_ERROR]("! ERROR: start refused, no board detected at pin group ", udec_long(eMotorBasePin), " (force BRD_REV_A / BRD_REV_B to drive anyway)")
    if eError == NO_ERROR
        ' pre-launch: setupForStart() stopped any previous driver and front cog, so no other writer exists
        sync_required := bParked
        params_ptr := @offset_fwd   ' point to driver variables
        setTargetAccel(0, false)                            ' do NOT move at startup
        motorStopHallTicks := 0                             ' no stop limit survives a restart
        motorStopMSecs := 0
        bStopUnconfirmed := FALSE                           ' front-owned from launch on; no stop is pending yet

        driverCogId := coginit(NEWCOG, @driver, @pinbase)
        if driverCogId < 0    ' did fail? (documented -1, or the $8000_xxxx form observed under cog exhaustion)
            eError := recordError(ERR_NO_FREE_COG)
            debug[user.DBGCH_ERROR]("!! ERROR filed to start Motor Control task")
            ' PL-36: setupForStart() took this instance's pin-range claim. A failed start must not keep
            '  it, or no other instance can claim the group until this one is stop()ped -- a claim with
            '  no cog behind it. stop() releases the claim and clears the pins; with motorCog still 0
            '  it stops no cog.
            stop()
        else
            motorCog := driverCogId + 1    ' internal representation: cogid + 1 (0 reserved as "not started"), one write
            debug[user.DBGCH_LIFECYCLE]("* Motor COG #", sdec_(driverCogId))

PRI launchFront(bReleaseDriver) : eError | frontCogId, startMs
' Launch this motor's front cog and wait, bounded, for its first pass; a failure stops the driver too.
'
' @param bReleaseDriver - T/F where T means the driver was launched parked and the front cog releases it with one ATN
' @returns eError - NO_ERROR when the front cog runs, else ERR_NO_FREE_COG or ERR_NO_RESPONSE, also recorded for getError()

' Local Variables:
' @local frontCogId - the value cogspin() returned
' @local startMs - getms() when the handshake wait began

    ' pre-launch: no front cog of this instance exists, so these writes have no second writer
    eError := NO_ERROR
    frontPasses := 0
    frontLatePasses := 0
    frontMaxPassTicks := 0
    cmdTimeoutMs := CMD_TIMEOUT_OFF                         ' S-8: off until the user turns it on
    bCmdWatched := FALSE
    cmdTimeoutEvents := 0
    longfill(@cmdTimeoutSeen, 0, COG_SLOT_COUNT)           ' every cog starts even with the (zeroed) count
    longfill(@taskStack, STACK_SENTINEL, STACK_SIZE_LONGS)  ' testGetFrontStats() finds the high-water mark from this

    frontCogId := cogspin(NEWCOG, frontLoop(bReleaseDriver), @taskStack)
    if frontCogId < 0    ' did fail? (documented -1, or the $8000_xxxx form observed under cog exhaustion)
        eError := recordError(ERR_NO_FREE_COG)
        debug[user.DBGCH_ERROR]("!! ERROR filed to start front cog")
        stop()    ' senseCog is still 0: stops the driver and releases the pins
    else
        senseCog := frontCogId + 1    ' internal representation: cogid + 1 (0 reserved as "not started"), one write
        startMs := getms()
        repeat while frontPasses == 0
            if getms() - startMs > FRONT_START_TIMEOUT_MS
                quit
            waitms(REQ_POLL_MS)
        if frontPasses == 0
            eError := recordError(ERR_NO_RESPONSE)
            debug[user.DBGCH_ERROR]("!! ERROR front cog did not start its loop")
            stop()
        else
            debug[user.DBGCH_LIFECYCLE]("* Front COG #", sdec_(frontCogId))

PRI swapHallTables(eSwap) | bitA, bitB, oldCode, newCode, angles[16], deltaBytes[16]
' TEST USE (testSetHallSwap()): permute init()'s copy of the hall tables for two hall-code bits read as swapped. With the
' wires swapped the driver would read P(code), P swapping the two bits, and index its tables with that. So each code's
' entry becomes the entry the swapped reading would have indexed: angle'[c] = angle[P(c)], and
' delta'[old<<3 | new] = delta[P(old)<<3 | P(new)]. Both halves of the angle table (forward, reverse) are permuted.
'
' @param eSwap - HSW_HALLS_01, HSW_HALLS_12 or HSW_HALLS_02
'
' @local bitA - the first swapped hall-code bit
' @local bitB - the second swapped hall-code bit
' @local oldCode - the previous hall code, 0..7
' @local newCode - the current hall code, 0..7
' @local angles - the unpermuted angle table, 16 longs
' @local deltaBytes - the unpermuted delta table, 64 bytes

    case eSwap
        HSW_HALLS_01:
            bitA, bitB := 0, 1
        HSW_HALLS_12:
            bitA, bitB := 1, 2
        other:
            bitA, bitB := 0, 2
    longmove(@angles, @hall_angles, 16)
    bytemove(@deltaBytes, @deltas, 64)
    repeat oldCode from 0 to 7
        LONG[@hall_angles][oldCode] := angles[hallBitsSwapped(oldCode, bitA, bitB)]
        LONG[@hall_angles][8 + oldCode] := angles[8 + hallBitsSwapped(oldCode, bitA, bitB)]
        repeat newCode from 0 to 7
            BYTE[@deltas][(oldCode << 3) | newCode] := BYTE[@deltaBytes][(hallBitsSwapped(oldCode, bitA, bitB) << 3) | hallBitsSwapped(newCode, bitA, bitB)]

PRI hallBitsSwapped(hallCode, bitA, bitB) : swappedCode
' TEST USE: {hallCode} with bits {bitA} and {bitB} exchanged
'
' @param hallCode - a 3-bit hall code
' @param bitA - one bit position, 0..2
' @param bitB - the other bit position, 0..2
' @returns swappedCode - the code with those two bits exchanged

    swappedCode := hallCode & !(DECOD bitA | DECOD bitB)
    swappedCode |= ((hallCode >> bitA) & 1) << bitB
    swappedCode |= ((hallCode >> bitB) & 1) << bitA

PRI init(eMotorBasePin, eMotorVoltage, eDetectionMode) | fwdDegrees, revDegrees, gapInNs, dutyAtFfLine
' Initialise this instance's driver image and state for a validated, claimed start; cannot fail.
'
' @param eMotorBasePin - The base pin ENUM (PINS_*) for adapter board for this motor, already validated and claimed
' @param eMotorVoltage - The voltage ENUM (PWR_*) for this motor, already validated
' @param eDetectionMode - The detection mode ENUM (BRD_*) for this motor, already validated

' Local Variables:
' @local fwdDegrees - forward commutation offset for this motor, in degrees
' @local revDegrees - reverse commutation offset for this motor, in degrees
' @local gapInNs - PWM dead-gap, in nanoseconds
' @local dutyAtFfLine - the duty the feedforward's back-EMF line was measured to reach at its increment (1/16ths)

    ticks1ms   := (CLKFREQ / 1_000)
    ticks1us   := (CLKFREQ / 1_000_000)
    ticks500us := (ticks1ms * 500) / 1_000  ' phrased this way for better result

    pinbase := eMotorBasePin                            ' record base pin number (validated and claimed by setupForStart())

    eUserDetectionMode, bUserForced := getInternalDetectMode(eDetectionMode)

    ' set the mode now used by the driver to condition things (current-sense scaling, etc.)

    eDetectedBoard := getBoardType()

    byte[@motorId] := 0 ' terminate an empty string

    targetAngle := $FFFFFFFF    ' set to not used! (other values only used during testing)

    degrPerTic, hallTicsPerRotation := hallTicInfoForMotor()

    fwdDegrees, revDegrees := offsetsForMotor(user.MOTOR_TYPE)
    writeOffsetsTenths(fwdDegrees * TENTHS_PER_DEGREE, revDegrees * TENTHS_PER_DEGREE)
    ' R18.4: the 6.5in pair is re-derived by the front cog from the measured lead table from its first slot on;
    '  a motor with no lead table keeps its fixed pair, and so does the legacy control build, whose whole
    '  point is the old fixed pair
    bLeadWritePending := TRUE
#ifdef HUB_OFFSETS_LEGACY
    bLeadScheduled := FALSE
#else
    bLeadScheduled := (user.MOTOR_TYPE == MOTR_6_5_INCH)
#endif
    userCmdIncr := 0                    ' R18.4 D-6: nothing commanded, and not short: the driver zeroes lag_held at start
    holdSlotsAgo := SHORT_SLOTS
    lastLagHeldSeen := 0

    debug[user.DBGCH_LIFECYCLE]("MOT: ", udec(fwdDegrees), uhex_long(offset_fwd))
    debug[user.DBGCH_LIFECYCLE]("     ", udec(revDegrees), uhex_long(offset_rev))

    ' new build up our hall angle and position increment table for specific motor
    if user.MOTOR_TYPE == MOTR_6_5_INCH
        longmove(@hall_angles, @hltbAngles, 16)
        bytemove(@deltas, @deltas65, 64)
    else
        longmove(@hall_angles, @hltbAngl4k, 16)
        bytemove(@deltas, @deltas4k, 64)
    if testHallSwap <> HSW_NONE                                                 ' TEST USE: read two halls as swapped, this start only
        swapHallTables(testHallSwap)
        testHallSwap := HSW_NONE

' average is middle plus deflection for forward or reverse
'  responsiveness of motor to desire
'  middle value is angular diff and motor postion relative to hall position
'  deflection is direction and speed dependent
    frame_cnt := (ticks1us * (1_000_000_000 / PWM_RATE_IN_HZ)) / 1_000
    debug[user.DBGCH_LIFECYCLE](" - Calc FRAME: ", udec(frame_cnt))

    ' preload driver values before driver start
    adc_fram    :=    frame_cnt                         ' set ADC to full PWM frame counts
    fram        :=    (frame_cnt / 2) << 16 + 1         ' PWM frame: width=FRAME/2, div sysclk by 1 (no division)
    lutCodePtr  :=    @lutCodeStart                     ' task 3535: hub addr of the LUT start image, block-loaded by the driver at coginit
    planCodePtr :=    @runCodeStart                     ' DRIVER_REV 42: hub addr of the LUT run image, loaded over the start image as it ends

    ' setup driver parameters based on clock rate
    ' A1 / PL-9: both 64010 manuals specify a 250 ns minimum dead-gap regardless of board
    ' revision (MOSFET response time sets the floor, not driver speed), so there is no
    ' per-revision value to select here. The removed conditional intended 52 ns for Rev B,
    ' which would have been ~5x under spec; it never actually took that branch (see A2 --
    ' eDetectedBoard's REV_A/REV_B values can't match a BRD_REV_A/BRD_REV_B comparison), so
    ' every board has always gotten the compliant 260 ns. Deleted, not repaired.
    gapInNs := 260
    dead_gap    := (ticks1us * gapInNs) / 1_000 ' (was OFFSET) 260 of these made into "value nS"
    pwm_limit   := (frame_cnt / 2) - (dead_gap  / 2)    'PWM duty hard limit 1/2 freq of PWM

    ' .. and set up rest
    ' orig higher power code used this
    duty_min    := 100 << 4 #> (dead_gap / 2) << 4
                                                        '    duty_min    := dead_gap << 4 #> dead_gap << 4
                                                        ' Chip's new code adjusted this, why?
                                                        '    duty_min    := 200 << 4 #> dead_gap << 4
    ' THE DUTY CEILING, derived so the PWM cannot clip (task 3604 built it, Visit 9 certified it, task 3605 made
    '  it the drive; LIMITS-RESET-PLAN.md E2). The drive re-centres the three levels on (min + max) / 2 every
    '  frame, so a phase swings at most sqrt(3)/2 of the amplitude either side of bias. The low side's Y is the
    '  high side's plus dead_gap, and P_PWM_TRIANGLE holds Y in 0..F, F = frame_cnt / 2
    '  (p2kbArchSmartPin01000PwmTriangle). Centring bias on the switching window, (F - dead_gap) / 2, leaves the
    '  same room on both rails, and the amplitude that fills it is (F - dead_gap) / sqrt(3), less
    '  SVM_GUARD_COUNTS for the CORDIC's rounding and the floored centring. INVARIANT: every high-side Y stays
    '  >= 0 and every low-side Y <= F. MEASURED at Visit 9: the least room any sampled level left was 2 counts,
    '  the desk's 1-2 (DOCs/plans/servo-model/svm_bound.py).
    ' It replaces duty_max := (pwm_limit << 4) / 2 on a bias of F / 2, which left ~14 % of the amplitude unused
    '  (at 270 MHz: 1_728 against 1_516 counts). The two raises tried on that old bias, 5/8 and 3/4 of pwm_limit,
    '  were recorded as BAD; both clip under it (peaks of 1_641 and 1_970 counts from bias, against the 1_464 the
    '  low side had).
    bias        := ((frame_cnt / 2) - dead_gap) / 2
    duty_max    := muldiv64((frame_cnt / 2) - dead_gap - SVM_GUARD_COUNTS, SVM_INV_ROOT3_PPM, PPM) << 4
    ' The feedforward's back-EMF line was measured against the OLD ceiling, so that duty is kept apart from
    '  duty_max: ff_ceiling scales by the two below, and the slope does not move with the ceiling.
    dutyAtFfLine := (pwm_limit << 4) / 2
    servo_shift := SERVO_ACC_SHIFT                      ' R18.4 D-2: the trim's gain (ff_ceiling follows the power limits, below)
    cfg_ctcks   := ticks500us                           ' drive-pass deadline; the pass runs at the first control pass after it (PL-50, see drvMotor)
    ' PL-155: floated for the rest zero and the start checks, WHATEVER holdAtStop() chose; the program's own stop mode
    '  is applied by applyStartSettings() once the checks pass (usrStopMode is kept, never reset here)
    bSettingsLive := FALSE
    bWalkRamps  := FALSE                                ' DRIVER_REV 40: no walk runs across a start (walkRamps())
    bRampsStale := FALSE                                ' DRIVER_REV 40: applied just below, by this cog: no front cog serves
    bRampsBusy  := FALSE                                '  this motor yet, and a front cog stopped mid-apply left no wait behind
    stop_mode   := SM_FLOAT                             ' enum: [SM_FLOAT, SM_BRAKE]
    e_stop      := ES_OFF
    ' PL-155 / PL-160: the program's kept settings (max speeds, reversal, the ramp) are applied, never reset; init() once
    '  reset them here. The ramp is the built-in one (ACCEL_BUILTIN_MM_S2, DECEL_BUILTIN_MM_S2) until a ramp setter is called.
    applyUserSettings()
    ' DRIVER_REV 40 (PL-161): the built-in rates' steps, converted once here (compile-time configuration, so the same
    '  every start), so no front cog's apply converts mm/s^2 (rampsFor()); a step is at least 1, so never 0 once set
    rampBuiltinUp := builtinStep(ACCEL_BUILTIN_MM_S2, RAMP_ACCEL_BUILTIN_STEP)
    rampBuiltinDn := builtinStep(DECEL_BUILTIN_MM_S2, RAMP_DECEL_BUILTIN_STEP)
    applyRamps()                                        ' the ramp's one write outside the front cog, before the driver runs
    fault := FALSE
    hall_missed := 0            ' hub copies of the driver's integrity counts: no stale values across stop()/start()
    hall_illegal := 0
    drv_incr_now := 0           ' no stale field speed across stop()/start(): the stop timing reads it
    drv_accel_now := 0          ' PL-160: nor a stale acceleration, which the stop timing reads too

    ' init status variables
    loop_ticks := 0
    minDrvTics := 65535
    drv_state := DCS_Unknown

    ' preset HDMI Monitor values
    resetHdmiData()

    debug[user.DBGCH_LIFECYCLE]("* init values ", udec_long(dead_gap), udec_long(pwm_limit), udec_long(adc_fram), udec_long(duty_min), udec_long(duty_max))
    debug[user.DBGCH_LIFECYCLE]("*      values ", udec_long(servo_shift), udec_long(cfg_ctcks))

    circInMM_x10, _ := wheelGeometry()

    ' PL-14: honour the caller's eMotorVoltage parameter instead of silently re-reading the
    ' compile-time user.DRIVE_VOLTAGE. Behaviour-neutral today (every shipped caller already
    ' passes user.DRIVE_VOLTAGE here), but it makes the parameter -- and the caller's own
    ' validVoltageForChoice() check on it -- meaningful, and lets two motors run at different
    ' voltages.
    confgurePowerLimits(eMotorVoltage)
    ' R18.4 D-1: the feedforward's scale is the increment at which the motor's back-EMF would use the whole
    '  duty range. Task 3603 (PL-107): it is the MOTOR's back-EMF line, not the speed ceiling. Until now it
    '  was read from maxFwdIncreAtPwr, so raising the ceiling (LIMITS-RESET-PLAN.md L1) would silently have
    '  weakened the feedforward. The 6.5in line is measured at 18.5 V and scales with the bus voltage.
    '  The Doco motor has no measured line, so its ceiling table stands in, and its ceilings are not moved.
    '  Never 0: the driver divides by it.
    if user.MOTOR_TYPE == MOTR_6_5_INCH
        ff_ceiling := muldiv64(HUB_FF_INCR_AT_NOMINAL, nominalMilliVolts(eMotorVoltage), HUB_FF_NOMINAL_MV)
    else
        ff_ceiling := abs(maxFwdIncreAtPwr)
    ' Task 3604: the driver scales by duty_max, and the line reaches dutyAtFfLine at ff_ceiling, so ff_ceiling
    '  moves with duty_max and the slope does not (1_728 / 1_516 of the line's own figure at 270 MHz).
    ff_ceiling := muldiv64(ff_ceiling, duty_max, dutyAtFfLine)
    ff_ceiling #>= 1

    rSenseForBoard := VALUE_NOT_SET
    if eDetectedBoard == REV_A
        rSenseForBoard := F_REV_A_RSENSE
    elseif eDetectedBoard == REV_B
        rSenseForBoard := F_REV_B_RSENSE
    ' DRIVER_REV 40: the walk's current guard, WALK_I_LIMIT_MA on this board's sense scale (Rev B 150 mV, Rev A 5 mV), never
    '  under FOLD_MIN_MV + 1, the least reading that is a measurement. No board, no scale: that least reading (no driver
    '  starts on an undetected board, so no walk runs on it)
    walkGuardMv := FOLD_MIN_MV + 1
    if rSenseForBoard <> VALUE_NOT_SET
        walkGuardMv #>= muldiv64(WALK_I_LIMIT_MA, rSenseForBoard, 1_000)

    ' S-2: the current limits start at the MOSFET values; nothing is latched or derated at start
    limitPeakA := I_PEAK_A
    limitContA := I_CONT_A
    dutyFloorEst := muldiv64(frame_cnt, 4 * DUTY_FLOOR_PCT, 100)            ' m = duty / (4 * frame_cnt)
    setFoldLimit(limitPeakA)                                                ' i_limit_k, and duty_floor from it (PL-163)
    protectiveCode := NO_ERROR
    faultCause := FC_NONE                                                   ' S-7: no fault since this start
    bWasFaulted := FALSE
    faultIllegalPrev := 0                                                   ' the driver zeroes its counts at start too
    fault_resyncs := 0                                                      ' R19.3: the hub copy, and the front cog's view of it
    foldback_frames := 0                                                    ' R20.1: likewise the fold-back count, which the driver zeroes too
    faultResyncsPrev := 0
    faultResyncEvents := 0
    bFaultBegan := FALSE
    frontSetFaultResponse(FAULT_RESPONSE_DEFAULT, BRAKE_PCT_DEFAULT)         ' before the front cog exists, so no race
    phaseAvgMa := 0
    bDerated := FALSE
    blockedPasses := 0
    blockedPos := 0
    ' R19.4: nothing checked and nothing probed until runStartChecks()
    probe_phase := PRB_NONE
    probe_sink := PRB_NONE                                                  ' R19.4 1e: no return phase, and the probe's own 50 %
    probe_y := 0
    drv_release := FALSE                                                    ' PL-138: the new driver drives; only stop() asks it to let go
    sense_zero := 0                                                         ' PL-146: no rest offset netted until this start measures one
    windState[0] := WND_NOT_RUN                                             ' and no winding reading until a start measures one
    windState[1] := WND_NOT_RUN
    windState[2] := WND_NOT_RUN
    windVoltMv := 0                                                         ' R20.4: nor the voltage one would use
    windVoltSrc := PACK_NOT_FITTED
    force_seq := 0                                                          ' R19.3: the driver's force_seen starts at 0 too
    fault_clr := 0                                                          ' task 3616: and its fault_clr_seen
    healthChecked := 0
    healthFailed := 0
    healthRecovered := 0                                                    ' R20.1: bStartChecksOptOut is kept: it is set before start()
    healthAttempts := 0
    longfill(@probeMv, 0, 9)
    walkFwdTicks := 0
    bWalkGuardArmed := bWalkTripped := FALSE                                    ' PL-122: no walk leg under guard
    walkRevTicks := 0
    walkRecordReset()                                                       ' PL-137: no leg recorded, none watched
    bPackOwned := FALSE                                                     ' R19.5: startPackSense() takes the pin
    packAvgRaw := 0
    ' R19.1: no hold before the front cog runs, so the driver at rest applies duty_min exactly as before
    hold_duty := duty_min
    hold_short := FALSE
    holdState := HS_OFF
    bHoldArmed := FALSE
    holdSlipEvents := 0
    holdLimitEvents := 0
    frontSetHoldLimits(HOLD_CEILING_PCT, HOLD_RISE_MS, HOLD_LIMIT_MS)             ' before the front cog exists, so no race
    ' R20.1: no drive has ended, and the event log is empty. A new epoch makes every reader cog drop its old cursor.
    stopReason := SR_NONE
    bDriveOpen := FALSE
    bResyncStopOpen := FALSE
    evHead := 0
    evEpoch++
    longfill(@evTotal, 0, EV_KINDS_COUNTED)
    evLastMissed := 0                                                       ' the driver's counts restart at 0 with it
    evLastIllegal := 0
    evLastLate := 0                                                         ' launchFront() zeroes frontLatePasses
    evLastPack := PACK_NOT_FITTED                                           ' startPackSense() sets the status it starts with
    evLastFold := 0
    evFoldBase := 0
    bFoldActive := FALSE
    evMissedMs := evIllegalMs := evLateMs := evPackMs := evFoldMs := getms() - EV_RATE_GAP_MS    ' the first of each may go at once

PRI applyUserSettings()
' PL-155: copy the program's kept settings into the working values the front cog reads: init() (before the driver
' runs) and applyStartSettings() (as a start ends). Each kept value is 0 until set -- a VAR is 0 at load -- and 0 reads
' as its default, so nothing needs a first-time initialisation. A setting added to the kept set adds its copy here,
' and its setter the usr* store beside its working write. PL-160: the ramp is copied by applyRamps(); DRIVER_REV 40:
' not from here -- init() calls it itself, and after that only the front cog does (frontApplyRamps()).

    maxSpeed := usrMaxSpeed
    if maxSpeed == 0
        maxSpeed := MAX_SPEED_DEFAULT
    maxSpeed4dist := usrMaxSpeed4dist
    if maxSpeed4dist == 0
        maxSpeed4dist := MAX_SPEED_DEFAULT
    motorIsReversed := usrReversed

CON { PL-160: the jerk-limited ramp's internal limits, in the driver's units }

    ' The built-in rates are ACCEL_BUILTIN_MM_S2 and DECEL_BUILTIN_MM_S2 (public, with RAMP_TAU_MS). With no wheel
    '  diameter configured there is no mm/s^2, and the ramp falls back to these steps: the same two rates on the 6.5in
    '  wheel (5.76 mm per tick, so 0.0294485 mm/s^2 per step, rampStepScale()). Until DRIVER_REV 38 the built-in ramp
    '  was a growing one (1_500 first step, +22 a pass, 200_000 ceiling) and a fixed 50_000 step down.
    RAMP_ACCEL_BUILTIN_STEP = 33_958        ' 1_000 mm/s^2 on the 6.5in wheel
    RAMP_DECEL_BUILTIN_STEP = 49_918        ' 1_470 mm/s^2 on the 6.5in wheel (the old ramp down was 50_000, 1_472)
    ' The largest acceleration limit the generator runs at: setRampingValues() accepts up to RAMP_STEP_MAX but runs above
    '  this at this. 1e6 is about 29_500 mm/s^2 on the 6.5in wheel, three times ACCEL_MAX_MM_S2. It keeps the stop
    '  plan's products (the driver's planA .. planC, PL-161) inside their longs: a jerk-limited ramp lasts at most ~720
    '  passes at any limit, and the jerk is at most ~2_100 (this over RAMP_TAU_MS).
    ACCEL_STEP_CAP          = 1_000_000
    ' The jerk is the limit spread over RAMP_TAU_MS: J = A / TAU_PASSES, TAU_PASSES = RAMP_TAU_MS / 1_000 x
    '  PWM_RATE_IN_HZ / DRIVE_PASS_FRAMES = 478.3 passes at 250 ms. jerkForAccel() computes it as
    '  A x RAMP_JERK_NUM / RAMP_JERK_DEN (= A x 23 / 11_000), rounded.
    RAMP_JERK_NUM           = DRIVE_PASS_FRAMES * 1_000
    RAMP_JERK_DEN           = RAMP_TAU_MS * PWM_RATE_IN_HZ
    ' PL-141 / D-5: the least field increment a path-scaled command runs at, and the floor of the hold decay. It was
    '  ramp_min (built in 1_500) until DRIVER_REV 38 reused that long as jerk_up.
    DRV_INCR_FLOOR          = 1_500
    ' The stop prediction's fixed point: 1/256 of a hall tick. angle x 6 x 256 / 2^32 = angle x 3 / 2^23 (the driver's
    '  stop_fp_; PL-161, DRIVER_REV 39).
    STOP_FP_BITS            = 8
    ' The stop plan saturates beyond this many drive passes (~9 minutes): only a raw setRampingValues() slow-down
    '  step of a few units can ask for a stop that long, and its sums would leave a long. A saturated stop is due at once.
    PLAN_PASSES_MAX         = 1 << 20
    ' PL-161 (DRIVER_REV 39): the driver's stop planner saturates the plan (due at once) when an acceleration away from
    '  rest would take more than this many passes to unwind (a jerk-limited ramp unwinds in ~480 at any limit; only a
    '  jerk lowered mid-ramp asks for more), which keeps its products inside 32 and 64 bits.
    PLAN_UNWIND_MAX         = 1_024

PRI keptRamps() : jerkUp, accelUp, jerkDn, accelDn
' PL-160: return the ramp the program has kept, as the driver's four parameters: the built-in rate for either part never set.
'
' usrAccelStep is 0 until setAcceleration() or setRampingValues() sets the speed-up limit (a set step is at least 1),
' and usrDecelStep 0 until setDeceleration() or setRampingValues() sets the slow-down limit.
'
' @returns jerkUp - the speed-up jerk
' @returns accelUp - the speed-up acceleration limit
' @returns jerkDn - the slow-down jerk
' @returns accelDn - the slow-down acceleration limit

    jerkUp, accelUp, jerkDn, accelDn := rampsFor(usrAccelStep, usrDecelStep)

PRI rampsFor(nUpStep, nDnStep) : jerkUp, accelUp, jerkDn, accelDn
' PL-160: return the driver's four ramp parameters for two acceleration limits, 0 for either meaning its built-in rate.
'
' Each limit is capped at ACCEL_STEP_CAP, and its jerk is the limit spread over RAMP_TAU_MS (jerkForAccel()).
' DRIVER_REV 40 (PL-161): a built-in rate's step is init()'s (rampBuiltinUp, rampBuiltinDn), so a front cog's apply
' does no float. Only a caller before the first start() (getRampingValues()) finds them 0 and converts here; a front
' cog never can, since none serves this motor before init() has set them.
'
' @param nUpStep - the speed-up acceleration limit, driver units; 0: ACCEL_BUILTIN_MM_S2
' @param nDnStep - the slow-down acceleration limit, driver units; 0: DECEL_BUILTIN_MM_S2
' @returns jerkUp - the speed-up jerk
' @returns accelUp - the speed-up acceleration limit
' @returns jerkDn - the slow-down jerk
' @returns accelDn - the slow-down acceleration limit

    accelUp := nUpStep
    if accelUp == 0
        accelUp := rampBuiltinUp
        if accelUp == 0
            accelUp := builtinStep(ACCEL_BUILTIN_MM_S2, RAMP_ACCEL_BUILTIN_STEP)
    accelDn := nDnStep
    if accelDn == 0
        accelDn := rampBuiltinDn
        if accelDn == 0
            accelDn := builtinStep(DECEL_BUILTIN_MM_S2, RAMP_DECEL_BUILTIN_STEP)
    accelUp := 1 #> accelUp <# ACCEL_STEP_CAP
    accelDn := 1 #> accelDn <# ACCEL_STEP_CAP
    jerkUp := jerkForAccel(accelUp)
    jerkDn := jerkForAccel(accelDn)

PRI builtinStep(nRateMmS2, nFallbackStep) : nStep | eError
' PL-160: return a built-in rate's acceleration limit in driver units: from the configured wheel, or the 6.5in wheel's step without one.
'
' @param nRateMmS2 - the built-in rate, mm/s squared
' @param nFallbackStep - the step used when no wheel diameter is configured
' @returns nStep - the acceleration limit, driver units

' Local Variables:
' @local eError - NO_ERROR, or ERR_NO_WHEEL_DIA when the rate cannot be converted

    eError, nStep := rampStepForAccel(nRateMmS2, nRateMmS2, nRateMmS2)
    if eError <> NO_ERROR
        nStep := nFallbackStep

PRI jerkForAccel(nAccel) : nJerk
' PL-160: return the jerk that ramps an acceleration limit in over RAMP_TAU_MS: max(1, round(nAccel / TAU_PASSES)).
'
' Spin2 side only, so the driver divides by nothing per pass to find it.
'
' @param nAccel - the acceleration limit, driver units [1 to ACCEL_STEP_CAP]
' @returns nJerk - the jerk, driver units per pass, at least 1

    nJerk := 1 #> ((muldiv64(nAccel, 2 * RAMP_JERK_NUM, RAMP_JERK_DEN) + 1) >> 1)

PRI applyRamps()
' PL-160: copy the kept ramp into the four working longs the driver block-copies every cycle (the params run), which
' the driver's own stop plan also reads (PL-161, DRIVER_REV 39). A running driver takes a new limit smoothly: an
' acceleration left above a lowered limit unwinds to it at the larger jerk (jerkStep).
' DRIVER_REV 40: while a wiring walk runs (bWalkRamps, walkRamps()) it copies the BUILT-IN ramp instead, so a setter
' called meanwhile keeps its value for the walk's end, which copies the kept ramp back.
' DRIVER_REV 40: ONE WRITER. Called by init() before the driver runs, and after that only by frontApplyRamps() on the
' front cog that serves this motor. Until DRIVER_REV 40 each setter and walkRamps() called it on its own cog, so a
' setter on another cog could read bWalkRamps TRUE, lose the race to the walk's restore and write the built-in ramp
' last, leaving it in force until the next setter or start().

    if bWalkRamps == TRUE
        jerk_up, accel_up, jerk_dn, accel_dn := rampsFor(0, 0)
    else
        jerk_up, accel_up, jerk_dn, accel_dn := keptRamps()

PRI requestRamps() : eError | startMs
' DRIVER_REV 40, any cog but the front cog: ask the front cog that serves this motor to apply the ramp, and wait,
' bounded, until an apply that read this cog's inputs has finished.
'
' Call it after the inputs are written (usrAccelStep, usrDecelStep, bWalkRamps). Raising bRampsStale after them is what
' makes the front cog's next apply read them (frontApplyRamps()). The flag seen down proves a front apply lowered it
' after it was raised here, and that apply reads the inputs afterwards; bRampsBusy, read after the flag, is up until
' that apply ends. So the wait ends only once the ramp is in force, and a setter's read-back (getRampingValues())
' sees it. The front cog applies a raised flag within 2 passes (4 for a steering wheel: RAMP_PHASE_BIT,
' RAMP_WHEEL_BIT), about 4 ms at worst, so REQ_ACK_TIMEOUT_MS holds with room. A front cog that does not serve it
' in that bound (stopping, or not started) ends the wait with ERR_NO_RESPONSE, which the setters do not report: the
' flag stays up, so the front cog applies it on a later pass, and a start applies it.
'
' @returns eError - NO_ERROR once the apply has finished, or ERR_NO_RESPONSE when REQ_ACK_TIMEOUT_MS ran out first

' Local Variables:
' @local startMs - getms() when the wait began

    eError := ERR_NO_RESPONSE
    bRampsStale := TRUE
    startMs := getms()
    repeat
        if bRampsStale == FALSE
            if bRampsBusy == FALSE                                              ' read second: the apply that lowered the flag is over
                eError := NO_ERROR
                quit
        if getms() - startMs > REQ_ACK_TIMEOUT_MS
            quit

PRI msForPasses(nPasses) : nMs
' Return the milliseconds {nPasses} drive passes take, rounded up; 0 for none (frontStopMs()).
'
' @param nPasses - drive passes, 0 to PLAN_PASSES_MAX
' @returns nMs - their time, DRIVE_PASS_US each, plus 1 when there are any

    nMs := 0
    if nPasses > 0
        nMs := nPasses * DRIVE_PASS_US / 1_000 + 1


VAR { * user request values * }

    LONG    eUserSelectedVolts  ' remember the value specified by the user
    LONG    fMotorVolts         ' float representation of user selected volts (used internally)
    LONG    eUserDetectionMode  ' remember the value specified by the user
    LONG    eDetectedBoard      ' remember the board type detected (or overridden)
    LONG    bUserForced         ' T/F: where T means user is NOT using autodetect
    ' limits based on user voltage
    LONG    minFwdIncreAtPwr
    LONG    maxFwdIncreAtPwr
    LONG    minRevIncreAtPwr
    LONG    maxRevIncreAtPwr
    ' user max speeds
    LONG    maxSpeed            ' [1-100] default 75
    LONG    maxSpeed4dist       ' [1-100] default 75
    ' stop point in time based on passing mSec or tick counts
    LONG    motorStopMSecs      ' stop motor when we've passed this time in milliseconds
    LONG    motorStopHallTicks  ' stop motor when we've passed this tick count
    LONG    motorPower          ' remember last power requested
    LONG    motorIsReversed     ' T/F where T means we need to flip direction: FWD <-> REV

    ' values specific to user selected motor
    LONG    degrPerTic
    LONG    hallTicsPerRotation
    LONG    pwm_limit                                   ' max freq of our pwm

    BYTE    motorId[MOTOR_ID_STRLEN+1]

PRI scaledCurrent() : fAmps, fWatts
' Compute the current-sense reading, net of the rest zero (PL-45), shared by getCurrent() and the
' HDMI telemetry (PL-25); records nothing -- the caller decides whether a board-not-detected reading
' is an error (getCurrent()) or just "no measurement" (telemetry).
'
' @returns fAmps - motor current in units of 0.1 mA (amps x 10_000); 0 when the board was never detected
' @returns fWatts - motor power in mW; 0 under the same condition

    ' for REVA gain is 1, R is 0.005
    ' for REVB gain is 50, R is 0.003
    ' gain and R is combined into rSenseForBoard -> RevA rSenseForBoard 5, RevB rSenseForBoard 150
    ' RevB. 10A, through 0,003R -> 0.03mV -> (50gain) -> 1.5V. 20A -> 3V, 10A -> 1.5V, 1A -> 0.15V
    ' RevA. 10A, through 0.005R -> 0.05mV -> (1gain) -> 50mW, 20A -> 0.1V, 10A -> 50mV, 1A -> 5mV
    ' the driver's sense_i_mV is true millivolts (numerator 3300 << 11, restored by sar #11 in the
    '  control loop), and rSenseForBoard is millivolts per amp, so scale up before dividing -- a plain
    '  sense_i_mV / rSenseForBoard would truncate to whole amps
    ' DRIVER_REV 40: the reading is FLOORED (sar #11), so it averages half a count under what it read; half a count is
    '  added back ((net x 2 + 1) x units / 2), as bFrontProtect()'s dcMa does, now the rest zero is the offset itself
    '  (restZeroFinish()). At rest the reading then averages 0 within the zero's rounding, +/-0.5 mV (it read 0 .. +1 mV
    '  for a zero at or above 0, when the zero was the truncated mean and no half count was added).
    '  Signed, never clamped: a clamp at 0 would bias the rest reading up again.
    if rSenseForBoard == VALUE_NOT_SET
        fAmps := 0
        fWatts := 0
    else
        fAmps := (((sense_i_mV - restZeroSenseMv) << 1) + 1) * (CURRENT_UNITS_PER_AMP / 2) / rSenseForBoard  ' in multiples of 0.1mA
        fWatts := round((float(fAmps) *. fMotorVolts)/. F_SCALE_WATTS)              ' in mW

CON { board detection and pin-group geometry }

    DETECT_SENSE_OFFSET  = 4                        ' detection pin is pinbase + 4, which is also the driver's pin_adc_cur_i
    DETECT_CHARGE_MS     = 1                        ' pinhigh() time that charges the Rev B board's 0.1uF capacitor
    DETECT_READ_COUNT    = 500                      ' pinread() samples taken after the pin is released
    DETECT_NODET_MIN_SUM = DETECT_READ_COUNT / 2    ' more highs than this: nothing discharged the pin, no board
    DETECT_REVB_MIN_US   = 20                       ' a pin high for less than this is not a Rev B sense node

    ' ADDPINS cannot cross a 32-pin port boundary, so every 16-pin group operation is two 8-pin calls
    HALF_GROUP_SPAN      = 7                        ' addpins operand: 8 pins
    GROUP_HI_OFFSET      = 8                        ' second half of a 16-pin group

CON ' --- TEST-USE ONLY Methods ---

    DEGREES_PER_TURN      = 360     ' one turn of a commutation offset, in degrees
    DEGREE_NORM_MAX_STEPS = 16      ' bounded add/subtract-360 steps: inputs within +/-5_760 degrees normalise exactly

CON ' --- PRIVATE (Utility) Methods ---

PRI map(inValue, inMin, inMax, outMin, outMax) : nResult | slope
' Maps inValue in range inMin..inMax to new value in range outMin..outMax
'
' @param inValue - the value to map
' @param inMin - the low end of the input range
' @param inMax - the high end of the input range
' @param outMin - the low end of the output range
' @param outMax - the high end of the output range
' @returns nResult - {inValue} mapped into outMin..outMax

' Local Variables:
' @local slope - the output span per unit of input

    nResult := 0
    if (inValue > 0)
        ' treat positive values out-of-bounds
        if (inValue <= inMin)
            nResult := outMin
        elseif (inValue >= inMax)
            nResult :=  outMax
    elseif (inValue < 0)
        ' treat negative values out-of-bounds
        if (inValue >= inMin)
            nResult := outMin
        elseif (inValue <= inMax)
            nResult :=  outMax
    ' NOT  out-of-bounds, so scale the inValue
    if inValue <> 0 and nResult == 0
            slope := (outMax - outMin) / (inMax - inMin)
            nResult := outMin + slope * (inValue - inMin)
    'debug("- map() ", sdec_long(inValue - inMin), sdec_long(inMin) , sdec_long(inMax), sdec_long(inMax - inMin))
    'debug("-       ", sdec_long(slope), sdec_long(outMin) , sdec_long(outMax), sdec_long(outMax - outMin))
    'debug("- map() ", sdec_long(inValue) , " --> ", sdec_long(nResult))

PRI incrementForPower(nUserPower) : nMotorIncre
' Translate a -100 to +100 power to the driver angle increment for this motor's voltage.
'
' @param nUserPower - power [(-100) to 100], already saturated and reversed as needed
' @returns nMotorIncre - driver angle increment; 0 for a stop

    ' Reached only from a started motor: setupForStart() validated the voltage and init() set the
    '  power limits before the driver cog existed, so the limits mapped below are always set.
    if nUserPower < 0
        ' map REV request
        nMotorIncre := map(nUserPower, -1, -100, minRevIncreAtPwr, maxRevIncreAtPwr)
    elseif nUserPower > 0
        ' map FWD request
        nMotorIncre := map(nUserPower, +1, +100, minFwdIncreAtPwr, maxFwdIncreAtPwr)
    else
        ' this is a STOP request
        nMotorIncre := 0    ' stop!

CON { distance units, in hundredths of a mm (unitInMM_x100()), and the float scales rampStepForAccel() uses }

    MM_X100_PER_MM          = 100
    MM_X100_PER_CM          = 1_000
    MM_X100_PER_M           = 100_000
    MM_X100_PER_KM          = 100_000_000
    MM_X100_PER_IN          = 2_540             ' 1 in = 25.4 mm exactly
    MM_X100_PER_FT          = 30_480
    MM_X100_PER_MI          = 160_934_400       ' 1 mi = 1_609.344 m exactly

    F_MM_X100_PER_MM        = 100.0
    F_ANGLE_UNITS_PER_CYCLE = 4_294_967_296.0   ' 2^32: the driver's field angle for one hall (electrical) cycle

PRI unitInMM_x100(eDistanceUnits) : nUnitInMM_x100
' Return one distance unit in hundredths of a mm: the one table every distance a caller commands is converted with.
'
' @param eDistanceUnits - a DDU_* distance unit
' @returns nUnitInMM_x100 - one {eDistanceUnits} in hundredths of a mm; 0 when it is not a DDU_* distance unit

    case eDistanceUnits
        DDU_MM:
            nUnitInMM_x100 := MM_X100_PER_MM
        DDU_CM:
            nUnitInMM_x100 := MM_X100_PER_CM
        DDU_M:
            nUnitInMM_x100 := MM_X100_PER_M
        DDU_KM:
            nUnitInMM_x100 := MM_X100_PER_KM
        DDU_IN:
            nUnitInMM_x100 := MM_X100_PER_IN
        DDU_FT:
            nUnitInMM_x100 := MM_X100_PER_FT
        DDU_MI:
            nUnitInMM_x100 := MM_X100_PER_MI
        other:
            nUnitInMM_x100 := 0

PRI maxDistanceInUnits(nUnitInMM_x100, nTickInMM_x100) : nMaxDistance
' Return the largest distance, in a unit, whose hall-tick count still fits a signed long.
'
' @param nUnitInMM_x100 - one unit in hundredths of a mm, at least 1
' @param nTickInMM_x100 - wheel travel per hall tick in hundredths of a mm, at least 1
' @returns nMaxDistance - the largest accepted distance in that unit

    ' A unit no longer than a tick can never produce more ticks than its own count, so any long fits. The
    '  bound is computed only when it is below POSX, where MULDIV64's quotient is sure to fit a long.
    nMaxDistance := POSX
    if nUnitInMM_x100 > nTickInMM_x100
        nMaxDistance := muldiv64(POSX, nTickInMM_x100, nUnitInMM_x100)

PRI rampStepForAccel(rate, minRate, maxRate) : eError, rampStep | fMmPerSec2PerStep
' Convert an acceleration (or a deceleration) at the wheel rim to the driver ramp step that gives it; records nothing.
'
' @param rate - the rate, mm/s squared
' @param minRate - the smallest rate accepted (ACCEL_MIN_MM_S2 or DECEL_MIN_MM_S2)
' @param maxRate - the largest rate accepted (ACCEL_MAX_MM_S2 or DECEL_MAX_MM_S2)
' @returns eError - NO_ERROR, ERR_NO_WHEEL_DIA when the configured wheel diameter is 0, or ERR_BAD_COUNT for a {rate} outside the range
' @returns rampStep - the driver ramp step per drive pass; meaningful only when {eError} is NO_ERROR

' Local Variables:
' @local fMmPerSec2PerStep - the rim acceleration one ramp step gives, mm/s squared (float); 0.0 with no wheel diameter

    eError := NO_ERROR
    rampStep := 0
    fMmPerSec2PerStep := rampStepScale()
    if fMmPerSec2PerStep == 0.0
        eError := ERR_NO_WHEEL_DIA
    elseif (rate < minRate) or (rate > maxRate)
        eError := ERR_BAD_COUNT
    else
        rampStep := 1 #> round(float(rate) /. fMmPerSec2PerStep)

PRI rateForRampStep(rampStep) : nRate | fMmPerSec2PerStep
' PL-160: convert a driver ramp step back to the rim acceleration it gives, rounded to the nearest mm/s squared.
'
' @param rampStep - the driver ramp step per drive pass
' @returns nRate - mm/s squared; 0 when the configured wheel diameter is 0

' Local Variables:
' @local fMmPerSec2PerStep - the rim acceleration one ramp step gives, mm/s squared (float); 0.0 with no wheel diameter

    nRate := 0
    fMmPerSec2PerStep := rampStepScale()
    if fMmPerSec2PerStep <> 0.0
        nRate := round(float(rampStep) *. fMmPerSec2PerStep)

PRI rampStepScale() : fMmPerSec2PerStep | nTickInMM_x100, fPassesPerSec
' Return the rim acceleration one driver ramp step gives, mm/s squared (float): 0.0 when the wheel diameter is 0.
'
' The driver adds (or takes) the step to the field's increment every drive pass, and one hall cycle (2^32 angle units)
' is HALL_TICKS_PER_CYCLE ticks, so one step accelerates the rim by passes/s^2 x HALL_TICKS_PER_CYCLE x mm/tick / 2^32.
' About 0.02946 mm/s squared on the 6.5in wheel.
'
' @returns fMmPerSec2PerStep - the rim acceleration per step (float), or 0.0

' Local Variables:
' @local nTickInMM_x100 - wheel travel per hall tick in hundredths of a mm, 0 when the wheel diameter is 0
' @local fPassesPerSec - drive passes per second (float)

    fMmPerSec2PerStep := 0.0
    _, nTickInMM_x100 := wheelGeometry()
    if nTickInMM_x100 <> 0
        ' C-1 (certified): one drive pass every DRIVE_PASS_FRAMES PWM frames
        fPassesPerSec := float(PWM_RATE_IN_HZ) /. float(DRIVE_PASS_FRAMES)
        fMmPerSec2PerStep := fPassesPerSec *. fPassesPerSec *. float(HALL_TICKS_PER_CYCLE) *. (float(nTickInMM_x100) /. F_MM_X100_PER_MM) /. F_ANGLE_UNITS_PER_CYCLE

CON { 6.5in hub commutation: hall zero and per-direction lead }

    ' The driver runs a PAIR of commutation offsets, and this is where the 6.5in pair comes from:
    '  offset_fwd = HUB_HALL_ZERO_DEGR + HUB_LEAD_DEGR, applied to NEGATIVE motor increments
    '  offset_rev = HUB_HALL_ZERO_DEGR - HUB_LEAD_DEGR, applied to POSITIVE motor increments
    ' They are kept apart because they mean different things and are found by different means:
    '  HUB_HALL_ZERO_DEGR is where the hall pattern's zero sits relative to true electrical angle,
    '   a property of sensor placement in the wheel and the same for both directions.
    '  HUB_LEAD_DEGR is how far the field leads the rotor, equal in magnitude each way.
    ' A pair forced symmetric about 0 can only be right when the hall zero IS 0; otherwise one
    '  direction leads more than it needs and the other less, which costs torque per amp in one
    '  direction. See DOCs/analyses/BLDC-COMMUTATION-PRINCIPLES.md. Characterised at 18.5V.
    ' The shipped pair is the scanned one, certified at Visit 7b (2026-09-21): against the legacy
    '  pair it took the direction-to-direction current ratio from 2.06 to 1.01 at ladder rungs 2-5
    '  and absolute current at the same commanded rate down 15x to 26x, on both motors. Evidence:
    '  DOCs/analyses/bench/2026-09-21/VISIT-7B-EVALUATION.md.
    ' Build with -D HUB_OFFSETS_LEGACY to select the pre-6.0.0 pair instead, which is how the A/B
    '  recompiles its control leg without editing this file.
#ifdef HUB_OFFSETS_LEGACY
    HUB_HALL_ZERO_DEGR    = 0       ' legacy pre-6.0.0 pair: offset_fwd 43, offset_rev 317
    HUB_LEAD_DEGR         = 43
#else
    HUB_HALL_ZERO_DEGR    = -4      ' shipped pair: offset_fwd 14, offset_rev 338
    HUB_LEAD_DEGR         = 18
#endif

    ' R18.4 dynamic lead (DOCs/plans/DRIVE-INTEGRATION-DESIGN.md 7 C-A, Stephen's ruling 2026-09-22): the lead
    '  that minimises current changes with speed, so the front cog re-derives the pair from a table of lead
    '  against |drv_incr| once per slot. The table was measured at Visit 8 under the R18.4 servo (task 3601),
    '  which moved the minima well below the old servo's 28 / 15.8: 18-23 at an eighth, 3-8 at a quarter,
    '  8 at half and full. HUB_LEAD_DEGR remains the fixed pair init() writes before the front cog runs,
    '  and the legacy build's. Tenths of a degree; points at the
    '  eighth, quarter, half and full 18.5 V rungs, one octave apart, interpolated linearly inside each
    '  octave (within ~1 deg of log-speed interpolation at the measured 12.2 deg per doubling).
    ' Task 3603 (PL-107): the 6.5in back-EMF line the feedforward scales by, kept apart from the speed ceiling.
    '  MEASURED at 18.5 V: steady duty runs 167-174 per 1e6 of increment (Visit 7c ladder), so duty_max is
    '  reached at ~147e6. The power table's rows follow the same line scaled by voltage, to within 2.5 %.
    HUB_FF_INCR_AT_NOMINAL = 147_000_000
    HUB_FF_NOMINAL_MV      = 18_500
    ' Task 3605 (Visit 9): the 6.5in speed ceiling at HUB_FF_NOMINAL_MV and the floor, both MEASURED; the other
    '  voltages' ceilings scale from the first (confgurePowerLimits() gives the rule and the evidence)
    HUB_CEIL_INCR_AT_NOMINAL = 165_000_000
    HUB_CEIL_ROUND           = 500_000
    HUB_FLOOR_INCR           = 100_000

    LEAD_POINTS           = 4
    TENTHS_PER_DEGREE     = 10
    TENTHS_PER_TURN       = 3600
    LEAD_WRITE_SETTLE_MS  = 1       ' a test's second write of its pair, after any in-flight schedule write

DAT ' ---- 6.5in dynamic lead table ----

leadIncrTbl     LONG    18_375_000, 36_750_000, 73_500_000, 147_000_000     ' |drv_incr|, ascending: the 18.5 V eighth, quarter, half and full rungs
' MEASURED at Visit 8 (task 3601; DOCs/analyses/bench/2026-09-22/VISIT-8-EVALUATION.md 3.5), the lead of
'  least net current per speed under the R18.4 servo, both motors and signs, and CONFIRMED at Visit 8b with
'  steps down to -7 deg (VISIT-8B-EVALUATION.md 3.6): all 16 minima bracketed, each value inside its flat region.
leadTenthsTbl   LONG    205                                                 ' eighth: flat 13-23
                LONG    50                                                  ' quarter: flat -2 to 8
                LONG    80                                                  ' half: flat 3-8
                LONG    80                                                  ' full: 8; 13 costs 2x

PRI leadTenthsForIncrement(absIncr) : leadTenths | idx, loTenths, hiTenths, spanIncr, leadStep
' Return the dynamic lead for a field speed, from the lead table: flat outside its ends, interpolated between points.
'
' @param absIncr - the field's increment per drive pass, magnitude
' @returns leadTenths - the lead, in tenths of a degree

' Local Variables:
' @local idx - the table point at or above {absIncr}
' @local loTenths - the lead at the point below
' @local hiTenths - the lead at the point at or above
' @local spanIncr - the increment between the two points
' @local leadStep - how far past the lower point's lead {absIncr} sits, in tenths, as a magnitude

    leadTenths := LONG[@leadTenthsTbl][LEAD_POINTS - 1]                         ' above the table: held flat, never extrapolated
    if absIncr <= LONG[@leadIncrTbl][0]
        leadTenths := LONG[@leadTenthsTbl][0]                                   ' below the table: held flat too
    else
        repeat idx from 1 to LEAD_POINTS - 1
            if absIncr <= LONG[@leadIncrTbl][idx]
                loTenths := LONG[@leadTenthsTbl][idx - 1]
                hiTenths := LONG[@leadTenthsTbl][idx]
                spanIncr := LONG[@leadIncrTbl][idx] - LONG[@leadIncrTbl][idx - 1]
                ' MULDIV64 is unsigned, so the step is scaled as a magnitude and its direction applied after
                leadStep := muldiv64(abs(hiTenths - loTenths), absIncr - LONG[@leadIncrTbl][idx - 1], spanIncr)
                if hiTenths >= loTenths
                    leadTenths := loTenths + leadStep
                else
                    leadTenths := loTenths - leadStep
                quit

PRI writeOffsetsTenths(fwdTenths, revTenths)
' Write the driver's commutation pair, and the whole-degree record the getter returns, from tenths of a degree.
'
' @param fwdTenths - the offset for negative increments, in tenths of a degree, within one turn either way
' @param revTenths - the offset for positive increments, in tenths of a degree, within one turn either way

    fwdTenths := (fwdTenths + TENTHS_PER_TURN) // TENTHS_PER_TURN                ' into 0..3599 (never an operand FRAC has not
    revTenths := (revTenths + TENTHS_PER_TURN) // TENTHS_PER_TURN                '  been shown to handle)
    offset_fwd := fwdTenths frac TENTHS_PER_TURN
    offset_rev := revTenths frac TENTHS_PER_TURN
    offset_fwd_degrees := (fwdTenths + TENTHS_PER_DEGREE / 2) / TENTHS_PER_DEGREE // DEGREES_PER_TURN
    offset_rev_degrees := (revTenths + TENTHS_PER_DEGREE / 2) / TENTHS_PER_DEGREE // DEGREES_PER_TURN

PRI applyFixedOffsets(fwdDegrees, revDegrees)
' Turn the lead schedule off and apply a fixed pair, twice, so the front cog's schedule cannot overwrite it.
'
' @param fwdDegrees - the offset for negative increments, in degrees (normalised into 0..359)
' @param revDegrees - the offset for positive increments, in degrees (normalised into 0..359)

    ' The front cog writes the pair only while bLeadScheduled is TRUE. A write it had already begun when the
    '  flag fell lands within microseconds, so the second write, a millisecond later, is the one that stays.
    bLeadScheduled := FALSE
    writeOffsetsTenths(normalisedDegrees(fwdDegrees) * TENTHS_PER_DEGREE, normalisedDegrees(revDegrees) * TENTHS_PER_DEGREE)
    waitms(LEAD_WRITE_SETTLE_MS)
    writeOffsetsTenths(normalisedDegrees(fwdDegrees) * TENTHS_PER_DEGREE, normalisedDegrees(revDegrees) * TENTHS_PER_DEGREE)

PRI offsetsForMotor(eMotorType) : fwdDegrees, revDegrees | ofsDegr, index
' Return the forward and reverse commutation offsets for a motor type (and, for the Doco motor, the board revision and drive voltage).
'
' @param eMotorType - the motor ENUM (MOTR_*)
' @returns fwdDegrees - commutation offset for negative increments, in degrees
' @returns revDegrees - commutation offset for positive increments, in degrees

' Local Variables:
' @local ofsDegr - the chosen offset, in degrees
' @local index - the drive voltage's row in the Doco offset table

    case eMotorType
      MOTR_DOCO_4KRPM:
        index := lookdown(user.DRIVE_VOLTAGE: PWR_7p4V..PWR_24p0V)
        ' 15 degrees per tic so +- 15 is our offset?
{
            ' 7.4V:  51-54 best, 55 fault?! (Verif) 52 starts better!  B: 28, 33
            ' 11.1V: 52-54 best, 55 fault?! (Verif)                    B: 33, 42, 44, 38
            ' 12V:   52-54 best (Verif)                                B: 39, 42
            ' 14.8V: 51-55 best (Verif)                                B: 40, 44
            ' 18.5V: 51-55 best (Verif)                                B: 36, 24, 44
            ' 22.2V: 51-54 best (Verif)                                B: 37, 51
            ' 24V:   52-58 best (Verif)                                B: 45, 48
}
        if eDetectedBoard == REV_B
          if (ofsDegr := lookup(index: 33, 33, 39, 40, 36, 37, 45)) == 0
              ofsDegr := 45
        else
          if (ofsDegr := lookup(index: 52, 53, 53, 53, 54, 54, 53)) == 0
              ofsDegr := 53
        fwdDegrees := ofsDegr                           ' 0 is bad > 2A!
        revDegrees := 360 - ofsDegr                     ' vs. using 360?
      other:
        ' 4 degrees per tic. The pair is built from the hall zero and the lead rather than
        '  from one number and its negation, so an asymmetric pair can be expressed at all.
        fwdDegrees := normalisedDegrees(HUB_HALL_ZERO_DEGR + HUB_LEAD_DEGR)
        revDegrees := normalisedDegrees(HUB_HALL_ZERO_DEGR - HUB_LEAD_DEGR)
{
        Chips values (orig driver)
         offset_fwd long    280 frac 360
         offset_rev long    230 frac 360
        Doug's motor
        ofsDegr := 20
        fwdDegrees := ofsDegr
        revDegrees := 360 - fwdDegrees
        In the following smaller value is FWD, 360 - smaller is REV
        ofsDegr := 80
        fwdDegrees := ofsDegr                 ' chip #1 fwd 280 / rev 80
        revDegrees := 360 - fwdDegrees
        In the following smaller value is FWD, 360 - smaller is REV
        ofsDegr := 130
        fwdDegrees := ofsDegr                 ' chip #2 fwd 230 / rev 130
        revDegrees := 360 - fwdDegrees
}

PRI normalisedDegrees(inDegrees) : outDegrees | stepCount
' Bring a degree value into 0..359 with bounded add/subtract-360 steps.
'
' @param inDegrees - degree value, any sign
' @returns outDegrees - the same angle in 0..359; an input beyond +/-5_760 degrees is clamped into 0..359 after the bounded steps
'
' @local stepCount - add/subtract steps taken so far

    outDegrees := inDegrees
    stepCount := 0
    repeat while (outDegrees < 0) and (stepCount < DEGREE_NORM_MAX_STEPS)
        outDegrees += DEGREES_PER_TURN
        stepCount += 1
    repeat while (outDegrees >= DEGREES_PER_TURN) and (stepCount < DEGREE_NORM_MAX_STEPS)
        outDegrees -= DEGREES_PER_TURN
        stepCount += 1
    outDegrees := (outDegrees #> 0) <# (DEGREES_PER_TURN - 1)

PRI getInternalDetectMode(eDetectMode) : eValidMode, bUserOverride
' Translate a validated user detection mode to this object's internal mode.
'
' @param eDetectMode - the detection mode ENUM (BRD_*), already validated by setupForStart()
' @returns eValidMode - BRD_AUTO_DET, BRD_REV_A or BRD_REV_B
' @returns bUserOverride - T/F where T means the user forced a board revision instead of auto-detect

    eValidMode := BRD_AUTO_DET
    bUserOverride := FALSE
    CASE eDetectMode
        user.BRD_REV_A:
            eValidMode := BRD_REV_A
            bUserOverride := TRUE
        user.BRD_REV_B:
            eValidMode := BRD_REV_B
            bUserOverride := TRUE

PRI powerTableIndex(eVoltage) : tableIdx
' Return this motor's power-table row for a voltage: the one list both the validator and the limits read.
'
' @param eVoltage - the voltage ENUM (PWR_*) to look up
' @returns tableIdx - the 1-based row in confgurePowerLimits()' tables, 0 when this motor has no row for {eVoltage}

    ' One list per motor, so "validated but not in the table" cannot be written. 6.0V and 25.9V have
    '  no DocoEng row; 25.9V has no 6.5in row.
    if user.MOTOR_TYPE == MOTR_DOCO_4KRPM
        tableIdx := lookdown(eVoltage: PWR_7p4V..PWR_24p0V)
    else
        tableIdx := lookdown(eVoltage: PWR_6p0V..PWR_24p0V)

PRI confgurePowerLimits(userVoltage) | index
' Set this motor's drive limits for a validated voltage.
'
' @param userVoltage - the voltage ENUM (PWR_*), already validated by setupForStart()

' Local Variables:
' @local index - the voltage's row in this motor's power table (never 0: the voltage was validated)

    index := powerTableIndex(userVoltage)
    debug[user.DBGCH_LIFECYCLE]("* ENTRY CFG ", sdec_long(userVoltage), sdec_long(index))

    minFwdIncreAtPwr := VALUE_NOT_SET   ' preset: the DocoEng branch below derives its minimum from this value
    minRevIncreAtPwr := VALUE_NOT_SET

    if user.MOTOR_TYPE == MOTR_DOCO_4KRPM
        ' rows: PWR_7p4V, PWR_11p1V, PWR_12p0V, PWR_14p8V, PWR_18p5V, PWR_22p2V, PWR_24p0V
        if eDetectedBoard == REV_B
            maxFwdIncreAtPwr := lookup(index: -385_000_000, -287_500_000, -485_000_000, -388_000_000, -449_500_000, -420_000_000, -460_000_000)
            maxRevIncreAtPwr := lookup(index:  385_000_000,  287_500_000,  485_000_000,  388_000_000,  449_500_000,  420_000_000,  460_000_000)
        else
            ' 282_000_000 100% anything above yields RPM 1885.0, cts/Sec 754, @0.11A
            ' 545_000_000 100% anything above yields RPM 3645.0, cts/Sec 1458, @0.50A
            ' 335_000_000 100% anything above yields RPM 2242.0, cts/Sec 897, @0.14A
            ' 376_000_000 100% anything above yields RPM 2517.0, cts/Sec 1007, @0.88A
            ' 376_000_000 100% anything above yields RPM 2_745, cts/sec 1_098
            ' 100% anything above yields RPM 2_810, cts/sec 1_124
            ' 100% anything above yields RPM 2_877, cts/sec 1_151
            ' 100% anything above yields RPM 2_940, cts/sec 1_178
            ' 100% anything above yields RPM 3_010, cts/sec 1_204
            ' 100% anything above yields RPM 3_077, cts/sec 1_231
            ' 100% anything above yields RPM 3_145, cts/sec 1_258
            ' 470_000_000 100% anything above yields RPM 2662.0, cts/Sec 1065, @0.89A
            ' 100% anything above yields RPM 3145.0, cts/Sec 1258, @0.78A
            ' 391_000_000 100% anything above yields RPM 2615.0, cts/Sec 1046, @0.620A
            maxFwdIncreAtPwr := lookup(index: -282_000_000, -545_000_000, -335_000_000, -376_000_000, -398_000_000, -470_000_000, -391_000_000)
            maxRevIncreAtPwr := lookup(index:  282_000_000,  545_000_000,  335_000_000,  376_000_000,  398_000_000,  470_000_000,  391_000_000)
        minFwdIncreAtPwr := 0 - minFwdIncreAtPwr
        minRevIncreAtPwr := 544_628                 ' anything below yields NO rotation
    else
        ' rows: PWR_6p0V, PWR_7p4V, PWR_11p1V, PWR_12p0V, PWR_14p8V, PWR_18p5V, PWR_22p2V, PWR_24p0V
        ' Task 3605 (LIMITS-RESET-PLAN.md L1, L5), from Visit 9 (DOCs/analyses/bench/2026-09-23/VISIT-9-EVALUATION.md).
        '  The old table was the OLD drive's fault edges. The R18.4 drive follows far past them unloaded -- to the
        '  harness's 245_000_000 command cap -- but above the point where duty first caps it does so by field
        '  weakening, drawing 3-4 A to spin a lifted wheel, and a slip there dumps current (PL-108). So the ceiling
        '  is not where the wheel stops following.
        ' THE CEILING RULE: the fastest measured speed that keeps the unloaded duty reserve the drive already
        '  shipped with. 147_000_000 ran at 92.7 % of its duty cap (Visit 8b); on the duty ceiling init() now
        '  derives, 165_000_000 runs at 92-93 % (MEASURED at 18.5 V, both motors, both directions). How much of
        '  that reserve survives a load is the floor run's to say (E5).
        ' The other rows are DERIVED: back-EMF rises with speed and the headroom with the supply, so the same
        '  reserve sits at a speed proportional to the voltage -- the old measured rows followed that line to
        '  within 2.5 %. So the table is one measured constant, HUB_CEIL_INCR_AT_NOMINAL, scaled by the supply
        '  and rounded DOWN to HUB_CEIL_ROUND so no row promises more (6.0 V: 53_500_000 ... 24.0 V: 214_000_000).
        ' THE FLOOR: every rung from the old 544_628 ("anything below yields NO rotation") down to 100_000
        '  rotated at exactly its commanded rate, steadily (MEASURED, Visit 9 E4). 100_000 is the lowest tried;
        '  the true floor is lower and unmeasured.
        maxFwdIncreAtPwr := muldiv64(HUB_CEIL_INCR_AT_NOMINAL, nominalMilliVolts(userVoltage), HUB_FF_NOMINAL_MV) / HUB_CEIL_ROUND * HUB_CEIL_ROUND
        maxRevIncreAtPwr := 0 - maxFwdIncreAtPwr
        minFwdIncreAtPwr := HUB_FLOOR_INCR
        minRevIncreAtPwr := 0 - minFwdIncreAtPwr

    eUserSelectedVolts := userVoltage
    fMotorVolts := float(nominalMilliVolts(userVoltage)) /. F_MV_PER_VOLT
    debug[user.DBGCH_LIFECYCLE]("* EXIT 2 CFG ", sdec_long(eUserSelectedVolts), " ", sdec(maxFwdIncreAtPwr), " ", sdec(minFwdIncreAtPwr))

PRI setTargetAccel(nTgtIncr, sync) | inincr
' Write the driver's target increment, with the sync bit set when the driver must wait for its release.
'
' @param nTgtIncr - the signed target increment
' @param sync - 1 to set the sync bit (bit 31), 0 to clear it

' Local Variables:
' @local inincr - the increment as passed, before the sync bit is applied (for the debug line and display)

    inincr := nTgtIncr
    nTgtIncr ZEROX= 30                                  ' clear bit 31
    nTgtIncr |= (sync << 31)                            ' bit 31 set if sync required
    targetIncre := nTgtIncr
    debug[user.DBGCH_COMMAND]("-MOT- ", sdec_long(inincr), " ", uhex_long(nTgtIncr), " ", sdec_(nTgtIncr>>31), " ", sdec_long(sync))
    tvTargetIncreInM := inincr / 10_000

PRI nominalMilliVolts(eVoltage) : nMilliVolts
' Return the nominal supply voltage of a voltage enum, in mV: the one table getDriveVoltage() and the power figures read.
'
' @param eVoltage - the voltage ENUM (PWR_*)
' @returns nMilliVolts - the nominal voltage in mV; 0 for PWR_Unknown or any value that is not a PWR_* voltage

    ' PWR_6p0V is 1, so the enum is itself the 1-based lookup index; LOOKUP returns 0 out of range
    nMilliVolts := lookup(eVoltage: 6_000, 7_400, 11_100, 12_000, 14_800, 18_500, 22_200, 24_000, 25_900)

PRI recordError(eCode) : eSameCode
' Record the calling cog's first error: the ONLY writer of lastError[]; returns the code unchanged.
'
' @param eCode - NO_ERROR or an ERR_* code
' @returns eSameCode - {eCode}, so a failing path can record and return in one expression

    ' Sticky first, and success never writes: only getError() clears a slot, so no later call on
    '  this cog -- successful or not -- can replace the cause that is waiting to be collected.
    if (eCode <> NO_ERROR) and (lastError[COGID()] == NO_ERROR)
        lastError[COGID()] := eCode
    eSameCode := eCode

PRI isAbiLayoutValid() : bValid
' Return TRUE when the Spin2 VAR layout matches every hub offset the PASM driver walks.
'
' @returns bValid - T/F where F means a driver launched on this layout would read or write the wrong longs

    ' the launch block (pinbase, params_ptr, targetAngle, targetIncre) sits right before the status run
    bValid := (@drive_u - @pinbase) == DRVR_LAUNCH_LONGS_COUNT * 4
    ' the driver block-copies DRVR_STATUS_LONGS_COUNT longs from drive_u and writes fault at the next long;
    '  PL-161 (DRIVER_REV 39): the run ends drv_accel_now, drv_stop_passes, drv_stop_fp (the driver's accel_now_,
    '  stop_passes_, stop_fp_), at the indexes the DRVR_STATUS_*_IDX constants name
    bValid &= (@fault - @drive_u) == DRVR_STATUS_LONGS_COUNT * 4
    bValid &= (@drv_accel_now - @drive_u) == DRVR_STATUS_ACCEL_NOW_IDX * 4
    bValid &= (@drv_stop_passes - @drive_u) == DRVR_STATUS_STOP_PASSES_IDX * 4
    bValid &= (@drv_stop_fp - @drive_u) == DRVR_STATUS_STOP_FP_IDX * 4
    bValid &= DRVR_STATUS_STOP_FP_IDX == DRVR_STATUS_LONGS_COUNT - 1
    ' the driver block-copies DRVR_PARAMS_LONGS_COUNT longs starting at offset_fwd, the last sense_zero (PL-146)
    bValid &= (@sense_zero - @offset_fwd) == (DRVR_PARAMS_LONGS_COUNT - 1) * 4
    ' every Spin2-only array the error contract and the front cog add lies outside both runs, so the
    '  driver can never touch it. The stack matters most: it is the only new memory written at 1 kHz.
    bValid &= bOutsideDriverRuns(@lastError[0], @lastError[COG_SLOT_COUNT - 1])
    bValid &= bOutsideDriverRuns(@reqCmd[0], @reqCmd[COG_SLOT_COUNT - 1])
    bValid &= bOutsideDriverRuns(@reqArg1[0], @reqArg1[COG_SLOT_COUNT - 1])
    bValid &= bOutsideDriverRuns(@reqArg2[0], @reqArg2[COG_SLOT_COUNT - 1])
    bValid &= bOutsideDriverRuns(@reqArg3[0], @reqArg3[COG_SLOT_COUNT - 1])
    bValid &= bOutsideDriverRuns(@reqNextSeq[0], @reqNextSeq[COG_SLOT_COUNT - 1])
    bValid &= bOutsideDriverRuns(@reqSeq[0], @reqSeq[COG_SLOT_COUNT - 1])
    bValid &= bOutsideDriverRuns(@ackStatus[0], @ackStatus[COG_SLOT_COUNT - 1])
    bValid &= bOutsideDriverRuns(@ackSeq[0], @ackSeq[COG_SLOT_COUNT - 1])
    bValid &= bOutsideDriverRuns(@frontPasses, @frontPasses)
    bValid &= bOutsideDriverRuns(@frontLatePasses, @frontLatePasses)
    bValid &= bOutsideDriverRuns(@frontMaxPassTicks, @frontMaxPassTicks)
    bValid &= bOutsideDriverRuns(@trackBasePos, @trackBasePos)
    bValid &= bOutsideDriverRuns(@bStopUnconfirmed, @bStopUnconfirmed)
    bValid &= bOutsideDriverRuns(@protectiveCode, @holdLimitMs)                   ' R20.1: the run now ends at holdLimitMs
    bValid &= bOutsideDriverRuns(@taskStack[0], @taskStack[STACK_SIZE_LONGS - 1])
    bValid &= bOutsideDriverRuns(@hallCountsWindow[0], @hallCountsWindow[HALL_WINDOW_SIZE - 1])
    bValid &= bOutsideDriverRuns(@bWindProbe, @windVoltSrc)                       ' R20.4: the run now ends at windVoltSrc
    bValid &= bOutsideDriverRuns(@walkWatchLeg, @bWlRan[WALK_LEGS - 1])          ' PL-137: the walk's per-leg record
    bValid &= bOutsideDriverRuns(@trkTravelTicks, @bSettingsLive)                ' PL-153 / PL-155: the limits' travel, the kept settings
    bValid &= bOutsideDriverRuns(@pendStage, @pendTicks)                         ' PL-161: the front cog's in-flight request
    if bValid == FALSE
        debug[user.DBGCH_ERROR]("! ERROR: driver ABI mismatch: ", udec_long(@drive_u - @pinbase), udec_long(@fault - @drive_u), udec_long(@drv_stop_fp - @drive_u), udec_long(@sense_zero - @offset_fwd))

PRI bOutsideDriverRuns(pFirst, pLast) : bOutside
' Return TRUE when the longs from {pFirst} to {pLast} overlap neither PASM-addressed run.
'
' @param pFirst - hub address of the first long of the Spin2-only array
' @param pLast - hub address of the last long of the Spin2-only array
' @returns bOutside - T/F where F means the driver could read or write part of the array

    ' the launch and status run is @pinbase..@fault (fault follows drv_stop_fp since DRIVER_REV 39); the parameter
    '  run is @offset_fwd..@sense_zero
    bOutside := ((pLast < @pinbase) or (pFirst > @fault)) and ((pLast < @offset_fwd) or (pFirst > @sense_zero))

CON ' --- HDMI Debug Support ---

CON { Constants for HDMI Debug }

    DBG_GROUPS_CT = 3
    DBG_MAX_VARS_IN_GROUP = 7

VAR { Data Structure for HDMI Debug }

    LONG    pTitlesAr[DBG_GROUPS_CT + 1]    ' first value is max vars
    LONG    pVarCtAr[DBG_GROUPS_CT]
    LONG    pNamesAr[DBG_GROUPS_CT * DBG_MAX_VARS_IN_GROUP]
    LONG    pValsAr[DBG_GROUPS_CT*DBG_MAX_VARS_IN_GROUP]

DAT { Literals for HDMI Debug }

' motor drive data
    nameTitle1  BYTE    "Motor Drive",0
    name10      BYTE    "hall",0
    name11      BYTE    "pos",0
    name12      BYTE    "duty",0
    name13      BYTE    "err",0
    name14      BYTE    "lpTicks",0
    name15      BYTE    "state",0
    name16      BYTE    "FAULT",0
nextAddr1
    dataLen1     LONG    @nextAddr1 - @nameTitle1

' motor sense data
    nameTitle2  BYTE    "Motor Sense",0
    name20      BYTE    "RPM10th",0
    name21      BYTE    "RPM",0
    name22      BYTE    "cts/sec",0
    name23      BYTE    "delta",0
    name24      BYTE    "Amp",0
    name25      BYTE    "maxAmp",0
    name26      BYTE    "RPMb10",0
nextAddr2
    dataLen2     LONG    @nextAddr2 - @nameTitle2

' motor rate  data
    nameTitle3  BYTE    "Motor Rate(.1)",0
    name30      BYTE    "RPM",0
    name31      BYTE    "cts/sec",0
    name32      BYTE    "mAmp",0
    name33      BYTE    "mWatt",0
    name34      BYTE    "kM/H",0
    name35      BYTE    "mm/s",0
    name36      BYTE    "Ang/10k",0
nextAddr3
    dataLen3     LONG    @nextAddr3 - @nameTitle3

PRI loadDisplayList() | nGrpOffset, nValsGrpOffset, nVarsInGroup
' do internal one-time setup of driver debug data

' Local Variables:
' @local nGrpOffset - index of the group being loaded
' @local nValsGrpOffset - that group's first index in the name and value tables
' @local nVarsInGroup - variables in that group

    nGrpOffset := 0
    nVarsInGroup := 7
    LONG[@pTitlesAr][nGrpOffset] := @nameTitle1
    LONG[@pVarCtAr][nGrpOffset] := nVarsInGroup
    ' populate the empty name/value ptr tables
    nValsGrpOffset := nGrpOffset * DBG_MAX_VARS_IN_GROUP
    LONG[@pNamesAr][nValsGrpOffset + 0] := @name10
    LONG[@pNamesAr][nValsGrpOffset + 1] := @name11
    LONG[@pNamesAr][nValsGrpOffset + 2] := @name12
    LONG[@pNamesAr][nValsGrpOffset + 3] := @name13
    LONG[@pNamesAr][nValsGrpOffset + 4] := @name14
    LONG[@pNamesAr][nValsGrpOffset + 5] := @name15
    LONG[@pNamesAr][nValsGrpOffset + 6] := @name16
    LONG[@pValsAr][nValsGrpOffset + 0] := @hall
    LONG[@pValsAr][nValsGrpOffset + 1] := @pos
    LONG[@pValsAr][nValsGrpOffset + 2] := @duty
    LONG[@pValsAr][nValsGrpOffset + 3] := @err
    LONG[@pValsAr][nValsGrpOffset + 4] := @loop_ticks
    LONG[@pValsAr][nValsGrpOffset + 5] := @drv_state
    LONG[@pValsAr][nValsGrpOffset + 6] := @fault

    nGrpOffset := 1
    nVarsInGroup := 7
    LONG[@pTitlesAr][nGrpOffset] := @nameTitle2
    LONG[@pVarCtAr][nGrpOffset] := nVarsInGroup
     ' populate the empty name/value ptr tables
    nValsGrpOffset := nGrpOffset * DBG_MAX_VARS_IN_GROUP ' mult by vars in prior group
    LONG[@pNamesAr][nValsGrpOffset + 0] := @name20
    LONG[@pNamesAr][nValsGrpOffset + 1] := @name21
    LONG[@pNamesAr][nValsGrpOffset + 2] := @name22
    LONG[@pNamesAr][nValsGrpOffset + 3] := @name23
    LONG[@pNamesAr][nValsGrpOffset + 4] := @name24
    LONG[@pNamesAr][nValsGrpOffset + 5] := @name25
    LONG[@pNamesAr][nValsGrpOffset + 6] := @name26
    LONG[@pValsAr][nValsGrpOffset + 0] := @tvRpm_x10
    LONG[@pValsAr][nValsGrpOffset + 1] := @rpm
    LONG[@pValsAr][nValsGrpOffset + 2] := @cntsInSec
    LONG[@pValsAr][nValsGrpOffset + 3] := @deltaTicks
    LONG[@pValsAr][nValsGrpOffset + 4] := @sense_i_mV
    LONG[@pValsAr][nValsGrpOffset + 5] := @tvMaxSenseI
    LONG[@pValsAr][nValsGrpOffset + 6] := @tv360rpm_x10

    nGrpOffset := 2
    nVarsInGroup := 7
    LONG[@pTitlesAr][nGrpOffset] := @nameTitle3
    LONG[@pVarCtAr][nGrpOffset] := nVarsInGroup
     ' populate the empty name/value ptr tables
    nValsGrpOffset := nGrpOffset * DBG_MAX_VARS_IN_GROUP ' mult by vars in prior group
    LONG[@pNamesAr][nValsGrpOffset + 0] := @name30
    LONG[@pNamesAr][nValsGrpOffset + 1] := @name31
    LONG[@pNamesAr][nValsGrpOffset + 2] := @name32
    LONG[@pNamesAr][nValsGrpOffset + 3] := @name33
    LONG[@pNamesAr][nValsGrpOffset + 4] := @name34
    LONG[@pNamesAr][nValsGrpOffset + 5] := @name35
    LONG[@pNamesAr][nValsGrpOffset + 6] := @name36
    LONG[@pValsAr][nValsGrpOffset + 0] := @maxRpm
    LONG[@pValsAr][nValsGrpOffset + 1] := @tvMaxCntsInSec
    LONG[@pValsAr][nValsGrpOffset + 2] := @tv_mA
    LONG[@pValsAr][nValsGrpOffset + 3] := @tv_mW
    LONG[@pValsAr][nValsGrpOffset + 4] := @tvMaxkPH_x10
    LONG[@pValsAr][nValsGrpOffset + 5] := @tvMaxMmPerSec_x10
    LONG[@pValsAr][nValsGrpOffset + 6] := @tvTargetIncreInM
{
    LONG[@pValsAr][nValsGrpOffset + 0] := @maxRpm
    LONG[@pValsAr][nValsGrpOffset + 1] := @tvMaxCntsInSec
    LONG[@pValsAr][nValsGrpOffset + 2] := @tvMaxFps_x10
    LONG[@pValsAr][nValsGrpOffset + 3] := @tvMaxMPH_x10
    LONG[@pValsAr][nValsGrpOffset + 4] := @tvMaxkPH_x10
    LONG[@pValsAr][nValsGrpOffset + 5] := @tvMaxMmPerSec_x10
    LONG[@pValsAr][nValsGrpOffset + 6] := @tvTargetIncreInM
}
    ' tell our table size to reader
    nGrpOffset := 3
    LONG[@pTitlesAr][nGrpOffset] := DBG_MAX_VARS_IN_GROUP

CON ' -- TASK: the front cog --

' Front cog constants (R16.3, DOCs/plans/FRONT-COG-IMPLEMENTATION-PLAN.md)
' The front cog is the only cog that commands the driver: it takes the requests the public methods
'  post, tracks position every pass, and enforces the distance and time stops in the same pass it
'  sees them crossed. C-3 (task 3512): at 1 ms a stop is commanded within one pass and taken within
'  one drive pass (522.7 us, PL-50), about 1.5 ms, under one tick at top speed. The DECELERATION
'  distance is unchanged and dominates every distance stop (C-4: 76 ticks from half speed).
    FRONT_LOOP_HZ          = 1_000      ' one pass per ms, on an absolute getct() schedule
    HALL_WINDOW_SIZE       = 125        ' rpm window slots: 125 slots x WINDOW_PASSES passes = 1 s span
    WINDOW_PASSES          = FRONT_LOOP_HZ / HALL_WINDOW_SIZE   ' 8: one window slot every 8 passes (125 Hz)
    ' PL-161: the slot work's phases within WINDOW_PASSES, one job per pass so no pass carries two: 0 the rpm window (and
    '  an owner's path limiter), WINDOW_PASSES / 2 the event checks, PACK_PHASE the pack's fold. An owner may use the
    '  rest (isp_steering_2wheel's state report is on 3 / 4 of the way round).
    PACK_PHASE             = WINDOW_PASSES / 4                  ' 2: the pack samples' fold into the average (frontSamplePack())
    ' DRIVER_REV 40 (PL-161): the ramp's apply (frontApplyRamps()) runs only on a pass whose phase has this bit set, an
    '  ODD phase. Every slot job's phase is even -- 0, PACK_PHASE (2), WINDOW_PASSES / 2 (4) and isp_steering_2wheel's
    '  STATE_PHASE (6) -- for WINDOW_PASSES (8) is a multiple of 8, so no apply shares a pass with slot work. Changing
    '  WINDOW_PASSES to other than a multiple of 8 breaks this: re-derive it then.
    RAMP_PHASE_BIT         = 1
    ' ...and a front cog serving two motors applies one a pass: the left on the odd phases with this bit clear (1, 5),
    '  the right on those with it set (3, 7), so each wheel's apply comes round every 4 passes (isp_steering_2wheel)
    RAMP_WHEEL_BIT         = 2
    DRIVE_PASS_US          = 523       ' one PASM drive pass, 522.7 us rounded up (PL-50)
    FRONT_SYNC_WAIT_PASSES = 4          ' bound on an in-flight request's wait for its driver (fault left, sync taken, e-stop
                                        '  left), in drive passes; polled once a front pass, never waited in one (PL-161)
    REQ_ACK_TIMEOUT_MS     = 20         ' bound on a posted request's answer; the front cog's worst case is 19 ms (the
                                        '  derivation is at bFrontServiceRequests())
    REQ_POLL_MS            = 1          ' caller-side poll period while waiting for an answer
    FRONT_START_TIMEOUT_MS = 100        ' bound on the front cog's first pass after cogspin()
    FRONT_PARK_MS          = 1_000      ' period of the parked front cog's idle wait after EXIT
    LATE_MARGIN_US         = 100        ' a pass with less than this left before its slot ends is late: waitct() is skipped
    US_PER_SEC             = 1_000_000
    MS_PER_SEC             = 1_000

  ' STACK_SIZE_LONGS was 48; the call depth grew by about one frame (an owner's front cog -> frontDrive()
  '  -> incrementForPower() -> map()), and the stack need per frame is not established, so it is doubled
  '  and made observable: testGetFrontStats() reports the high-water mark against STACK_SENTINEL.
  ' R18.4: raised from 128. Visit 4 measured a 114-of-128 peak, and the dynamic lead adds two call levels
  '  under frontTrack() (frontApplyLead() -> writeOffsetsTenths()). Hub RAM is plentiful (doctrine P13);
  '  the next testGetFrontStats() reading re-measures the peak.
  STACK_SIZE_LONGS = 192
  STACK_SENTINEL   = $5A5A_A5A5         ' pre-launch fill of taskStack; a long still holding it was never used
  R360_WINDOW_SIZE = 5

  F_SCALE_WATTS = 10.0
  F_MV_PER_VOLT = 1_000.0           ' nominalMilliVolts() -> the float volts the power figures use
  CURRENT_UNITS_PER_AMP = 10_000    ' getCurrent() reports current in 0.1 mA units (amps x 10_000)

  F_REV_A_RSENSE = 5        ' .005 Ohms
  F_REV_B_RSENSE = 3*50     ' .003 Ohms * gain 50 from INA180B2

  ' PL-45: the rest zero uses the construction the scan and char bench binaries use for their own zero
  '  (200 samples, 5 ms apart). sense_i_mV is a single-PWM-frame ADC read with no averaging in the
  '  driver, so no shorter window is equivalent.
  REST_ZERO_SAMPLE_COUNT = 200
  REST_ZERO_SAMPLE_MS    = 5

  ' PL-45: bound on restZeroBegin()'s wait for the driver's first status block-copy. DERIVED from the
  '  driver's start path: the GIO and VIO calibrations (two widened ADC waits each, 8 frames of ~22.7 us)
  '  plus one frame before the first pass come to under 1 ms at any supported clock; a parked driver's
  '  ATN wait is already released by its owner before this wait begins. 10 ms is a >10x margin for
  '  Spin2 overhead. Not REQ_ACK_TIMEOUT_MS: that bounds a request round trip, a different wait.
  REST_ZERO_READY_TIMEOUT_MS = 10

CON { front cog requests }

    SEQ_IDLE        = 0                 ' reqSeq value meaning "no request outstanding"
    SYNC_BIT        = $8000_0000        ' bit 31 of targetIncre: set with a synchronized command, cleared by the driver when taken

    ' Request codes a caller posts to the front cog (arguments per code):
    '  REQ_ESTOP          - latch the emergency stop and write a zero command
    '  REQ_STOP           - write a zero command
    '  REQ_CLEAR_ESTOP    - write a zero command, release the latch, answer once the driver leaves DCS_ESTOP (bounded)
    '  REQ_DRIVE          - arg1 power, arg3 bSync: refused while emergency-stopped, else drive (sync: ATN, answered once
    '                       taken, bounded)
    '  REQ_DRIVE_DISTANCE - arg1 stop ticks, arg2 power: refused while emergency-stopped, else arm the limit and drive
    '  REQ_LIMIT_TICKS    - arg1 stop ticks: arm the hall-tick stop limit
    '  REQ_LIMIT_TIME     - arg1 getms() deadline, never 0: arm the time stop limit
    '  REQ_RESET_TRACKING - zero the odometer (PL-153: an armed limit keeps counting from its own arming)
    '  REQ_RESET_MAX      - reset the rpm window, the HDMI maxima and the odometer (TEST-USE)
    '  REQ_TEST_INCREMENT - arg1 raw driver increment: refused while emergency-stopped, else written (TEST-USE)
    '  REQ_CLEAR_PROTECT  - release a protective stop: clear the cause, then as REQ_CLEAR_ESTOP
    '  REQ_SET_LIMITS     - arg1 peak amps, arg2 continuous amps: replace the current limits (TEST-USE)
    '  REQ_SET_TIMEOUT    - arg1 ms, or CMD_TIMEOUT_OFF: set the command timeout and restart its clock (S-8)
    '  REQ_SET_HOLD       - arg1 ceiling %, arg2 rise ms, arg3 limit ms: replace the hold's limits (setHoldLimits(), R19.1)
    '  REQ_SET_FAULT      - arg1 FR_* mode, arg2 brake %: choose the response to a position fault (setFaultResponse(), R19.3)
    '  REQ_FORCE_FAULT    - fault the driver on its next driven frame, as if the rotor had lost the field (TEST-USE, R19.3)
    '  REQ_WALK           - arg1 the leg, WLEG_* (PL-137), arg2 power (isp_steering_2wheel: arg2 left, arg3 right power,
    '                       both synchronized): a checkWiring() leg, a signed move of WALK_TICKS under the current guard
    '                       (R19.4, PL-122), whose record then opens (frontWalkBegin())
    '  REQ_EXIT           - answer every open request, acknowledge, and park (stop())
    '  REQ_NOTE_START     - log the start checks' retries (EV_CHECK_RETRY) once start() has succeeded (R20.1); appended
    '                       after REQ_EXIT so no code moves
    #1, REQ_ESTOP, REQ_STOP, REQ_CLEAR_ESTOP, REQ_DRIVE, REQ_DRIVE_DISTANCE, REQ_LIMIT_TICKS, REQ_LIMIT_TIME, REQ_RESET_TRACKING, REQ_RESET_MAX, REQ_TEST_INCREMENT, REQ_CLEAR_PROTECT, REQ_SET_LIMITS, REQ_SET_TIMEOUT, REQ_SET_HOLD, REQ_SET_FAULT, REQ_FORCE_FAULT, REQ_WALK, REQ_EXIT, REQ_NOTE_START

    ' The order a pass applies requests in, by class:
    '  REQ_CLASS_ESTOP - REQ_ESTOP, first, so an e-stop posted with a drive in the same pass refuses the drive
    '  REQ_CLASS_STOP  - REQ_STOP
    '  REQ_CLASS_OTHER - everything else, in slot order
    '  REQ_CLASS_EXIT  - REQ_EXIT, last
    #0, REQ_CLASS_ESTOP, REQ_CLASS_STOP, REQ_CLASS_OTHER, REQ_CLASS_EXIT

    ' PL-161 (DRIVER_REV 37): what a front cog's in-flight request waits for. No front pass waits on a driver: a request
    '  whose driver(s) must act is held in flight, polled once a pass, and answered on the pass that sees it done, or
    '  once its bound (FRONT_SYNC_WAIT_PASSES drive passes, bFrontWaitExpired()) has gone:
    '  PST_NONE        - no request in flight
    '  PST_FAULT_LEFT  - a FAULTED motor's clear was made (bFrontClearFaultBegin()); the driver must leave DCS_FAULTED
    '                    (PL-66) before the request's command is written. Bound gone: ERR_NO_RESPONSE, the zero kept
    '  PST_SYNC_TAKEN  - a synchronized command was written and its ATN sent; the driver must clear SYNC_BIT, having
    '                    taken it. Bound gone: ERR_SYNC_TIMEOUT, and the command is zeroed (audit M)
    '  PST_ESTOP_LEFT  - an emergency stop was released; the driver must leave DCS_ESTOP. Bound gone: ERR_NO_RESPONSE
    #0, PST_NONE, PST_FAULT_LEFT, PST_SYNC_TAKEN, PST_ESTOP_LEFT

VAR { * sense buffer and stack arrays * }
    LONG    taskStack[STACK_SIZE_LONGS]

    ' summing sense values, one slot every WINDOW_PASSES front passes
    LONG    hallCountsWindow[HALL_WINDOW_SIZE]
    LONG    hallWinIndex
    LONG    hallWinEntryCt
    LONG    hallCntsIn8thSec
    LONG    hallWindowSum

    ' R18.1, harvested 2026-09-22: WHETHER THE DRIVE IS FOLLOWING ITS COMMAND. Front cog writes these
    '  once per window slot; any cog reads them through testGetFollowing(). They are OBSERVABLES --
    '  nothing in the control path reads them, and adding them changed no control behaviour.
    '  These are VAR here and deliberately NOT in the PASM-addressed runs: the driver already
    '  publishes the raw material (pos, and the unbounded counters testGetDriveHealth() returns), so
    '  no long crosses the Spin2<->PASM2 boundary for this and the ABI is untouched.
    LONG    followCmdTicksSec   ' commanded hall ticks/s, derived from targetIncre
    LONG    followPctOfCmd      ' measured as a percent of commanded: 100 = following, 0 = stalled
    LONG    bFollowValid        ' T/F where T means the window is full and a non-zero rate was commanded

    LONG    rSenseForBoard
    LONG    dutyFloorEst        ' PL-163: the phase estimate's duty floor, m = 0.1 (init()); the fold's own, duty_floor, may be raised
    LONG    walkGuardMv         ' DRIVER_REV 40: the walk's current guard on this board's sense scale, mV (WALK_I_LIMIT_MA; init())
    LONG    restZeroSenseMv     ' PL-45: sense_i_mV's rest offset, taken floated at start; subtracted by getCurrent()
    LONG    restZeroSampleSum   ' S3: rest-zero accumulator, between restZeroBegin() and restZeroFinish()
    LONG    restZeroSampleCount ' S3: samples restZeroAddSample() has added since restZeroBegin()

CON { test pins for LA measurement }
' Logic Analyzer Instrumentation Code
'{
' if not using Logic Analyzer uncomment these routines
PRI LAINIT()

PRI LARESET()

PRI LALOOPSTART()

PRI LALOOPEND()
'}
{
' if using Logic Analyzer uncomment these routines

    ' PIN_40 - PIN_47 - general LA header
    TEST_BASE_PIN = 40
    TEST_ALL_PINS = TEST_BASE_PIN addpins 7
    TEST_PIN_SENSE_LP = TEST_BASE_PIN + 0                                       ' LA ch0
    TEST_PIN_DRIVE_LP = TEST_BASE_PIN + 1                                       ' LA ch1
    TEST_PIN_MOTR_CTL_LP = TEST_BASE_PIN + 2                                    ' LA ch2
    TEST_PIN_DRIVE_LP2 = TEST_BASE_PIN + 3                                      ' LA ch3
    TEST_PIN_LP_TOGL = TEST_BASE_PIN + 4                                        ' LA ch4
    TEST_PIN_UNKNOWN = TEST_BASE_PIN + 5                                        ' LA ch4

    ' PIN 48, 49 our rot/360 R/P Sensor
    '   (Optical Rotary Encoder 360P/R)
    TEST_BASE2_PIN = 48
    TEST_ALL2_PINS = TEST_BASE2_PIN addpins 1
    TEST_PIN_RP_SNS1 = TEST_BASE2_PIN + 0
    TEST_PIN_RP_SNS2 = TEST_BASE2_PIN + 1

VAR
    LONG loopCtr
    ' summing 360 sensor values at 1 sec period
    LONG    r360CountsWindow[R360_WINDOW_SIZE]
    LONG    r360WinIndex
    LONG    r360WinEntryCt
    LONG    r360degrPerSec
    LONG    r360WindowSum

PRI LAINIT()
    LARESET()
    'pinlow(TEST_PIN_SENSE_LP)

    ' configure our R/P sensor pins
    pinfloat(TEST_ALL2_PINS)    ' set to inputs
    ' configure for quadrature A+B X=run continuous, reset Y
    pinstart(TEST_PIN_RP_SNS1, P_QUADRATURE | P_PLUS1_B, 0, 0)

PRI LARESET()
    longfill(@r360CountsWindow, 0, R360_WINDOW_SIZE)                            ' zero our windowed accum
    r360WinEntryCt := r360WindowSum := r360WinIndex := 0
    r360degrPerSec := 0

PRI LALOOPSTART()
        pinhigh(TEST_PIN_SENSE_LP)
    ' ------------------------------------------
    ' Special 360 cts/Rotation Sensor Code
    '   (Optical Rotary Encoder 360P/R)
    ' https://www.amazon.com/Signswise-Incremental-Encoder-Dc5-24v-Voltage/dp/B00Y9KDDCY
    ' ------------------------------------------
        ' accum our fast & slow windowed values
    if ++loopCtr +// FRONT_LOOP_HZ == 0                                         ' once every second compute slow cts in case we are slow
            ' ---------------------------------------------------------------------------------
            ' Capture 360 Sensor data
            '
            r360degrPerSec := abs(rqpin(TEST_PIN_RP_SNS1) sar 2)  ' divide by 4 to get degrees
            'debug("MTR: ROT ", sdec(r360degrPerSec))
            ' reset reader
            pinfloat(TEST_PIN_RP_SNS1)    ' set to input
            pinhigh(TEST_PIN_RP_SNS1)     ' set to output

            r360WindowSum -= LONG[@r360CountsWindow][r360WinIndex]              ' Remove the oldest entry from the sum
            long [@r360CountsWindow][r360WinIndex] := r360degrPerSec            ' place the newest reading into the window
            r360WindowSum += r360degrPerSec                                     ' Add the newest reading to the sum
            r360WinIndex := (r360WinIndex + 1) +// R360_WINDOW_SIZE             ' Increment the index, and wrap to 0 if it exceeds the window size
            if r360WinEntryCt < R360_WINDOW_SIZE                                ' incr number of samples in sum until is window size
                r360WinEntryCt++

            tv360rpm_x10 := (r360degrPerSec * 60) / 36
            tv360rpm := tv360rpm_x10 / 10

PRI LALOOPEND()
    pinlow(TEST_PIN_SENSE_LP)
'}

{ Front cog request protocol (plan sec 1). No lock is used; every long has exactly one writer.

  Caller (postRequest(), on the calling cog c = COGID()):
    1. withdraw        reqSeq[c] := SEQ_IDLE
    2. write           reqCmd[c], reqArg1..3[c]
    3. fresh sequence  reqNextSeq[c] + 1, skipping SEQ_IDLE
    4. publish, LAST   reqSeq[c] := that sequence
    5. wait, bounded   until ackSeq[c] == its sequence, then read ackStatus[c]; on timeout withdraw

  Front cog (bFrontServiceRequests(), once per pass, per open slot):
    1. seqTaken := reqSeq[c]; empty when SEQ_IDLE or already equal to ackSeq[c]
    2. copy reqCmd/reqArg1..3[c]
    3. re-read reqSeq[c]: changed means the caller withdrew during the copy, so the copy is discarded
    4. apply (securing first, then the rest, then EXIT), producing a status as DATA -- nothing is recorded
    5. answer: ackStatus[c] := status FIRST, then ackSeq[c] := seqTaken

  PL-161 (DRIVER_REV 37): step 4 never waits on the driver. A request whose driver must act first (a fault clear, a
  synchronized take, an e-stop's release) is held IN FLIGHT (pendStage): at most one at a time, polled at the head of
  every pass, and answered (step 5) on the pass that sees it done or its bound gone. While one is in flight no other
  request is taken; they stay posted, and the pass that answers it goes on to take them in the usual order.

  Nothing reachable from frontLoop() calls recordError() or recordCallerError().
}

PRI frontLoop(bReleaseDriver) | ticksPerPass, lateMarginTicks, nextDue, passStartTicks, passBodyTicks, passCount, nowMs, packRawSum, packSamples
' FRONT COG: this motor's loop -- apply posted requests, track position, enforce the stop limits, once per ms.
'
' @param bReleaseDriver - T/F where T means the driver was launched parked and is released here with one ATN

' Local Variables:
' @local ticksPerPass - system ticks in one FRONT_LOOP_HZ pass
' @local lateMarginTicks - LATE_MARGIN_US in system ticks
' @local nextDue - getct() value at which the next pass is due
' @local passStartTicks - getct() when this pass began
' @local passBodyTicks - ticks this pass's body took
' @local passCount - passes run so far, the rpm window's cadence counter
' @local nowMs - getms() once for this pass's limit and timeout checks
' @local packRawSum - the pack pin's raw samples summed since the last fold (PL-161)
' @local packSamples - how many samples packRawSum holds

    ' The entry writes none of targetIncre, e_stop or the stop limits: it adopts them, so a stop
    '  written directly inside start()'s window (no front cog yet) survives the launch.
    ticksPerPass := CLKFREQ / FRONT_LOOP_HZ
    lateMarginTicks := (CLKFREQ / US_PER_SEC) * LATE_MARGIN_US
    passCount := 0
    packRawSum := packSamples := 0
    pendStage := PST_NONE                                                       ' PL-161: no request in flight
    frontStartTracking()                                                        ' PL-153: the odometer and the limits' travel start at 0
    LAINIT()                                                                    ' init LA
    if bReleaseDriver == TRUE
        cogatn(frontDriverCogBit())                                             ' release the parked driver: one ATN, from its owner
    nextDue := getct() + ticksPerPass

    repeat
        passStartTicks := getct()
        frontPasses++                                                           ' heartbeat: start() waits for the first one
        passCount++

        ' 0. a stop written in an earlier pass is confirmed, or written again
        frontConfirmStop()
        if ((passCount +// WINDOW_PASSES) & RAMP_PHASE_BIT) <> 0                ' DRIVER_REV 40: the ramp's one writer, before any
            frontApplyRamps()                                                   '  request, on an odd phase: never a slot job's pass

        ' 1. requests: the one in flight polled first (PL-161: never waited on), then securing, the rest in slot
        '  order, then EXIT
        if bFrontServiceRequests() == TRUE
            quit                                                                ' EXIT acknowledged: park below

        LALOOPSTART()                                                           ' main LA tracking code
        ' 2. tracking, then 3. limits, so a crossing seen in this pass is stopped in this pass
        frontTrack(passCount)
        frontWalkGuard()                                                        ' PL-122: a walk leg's current, checked every pass
        nowMs := getms()
        ' R20.1: each stop's record follows its command write (D6)
        if bFrontLimitsDue(nowMs) == TRUE
            frontZeroPower()                                                    ' PL-52: a distance/time stop clears getPower() too
            frontReportLimit()                                                  ' PL-161: output only after the stop's write
            frontRecordStop(SR_AT_LIMIT)
            frontWalkNoteLimit()                                                ' PL-137: a walk leg's limit, after its stop
        if bFrontCommandTimedOut(nowMs) == TRUE
            frontZeroPower()                                                    ' S-8: stopped as stopMotor() stops, so holdAtStop() applies
            frontRecordStop(SR_LINK_LOST)
        if bFrontProtect() == TRUE                                               ' S-2: current derate; a blocked motor latches a protective stop
            frontProtectiveStop(ERR_PLATFORM_BLOCKED)
            frontRecordStop(SR_BLOCKED)
        frontHold()                                                             ' R19.1: the hold at rest, after this pass's stops
        if bPackOwned == TRUE                                                   ' R19.5, PL-161: the pack pin, one read a pass, summed
            packRawSum += rdpin(user.PACK_SENSE_PIN)                            '  inline -- no call, no conversion
            packSamples++
        if (passCount +// WINDOW_PASSES) == PACK_PHASE                          ' PL-161: folded once a slot, on a pass with no other
            frontSamplePack(packRawSum, packSamples)                            '  slot work
            packRawSum := packSamples := 0
        if (passCount +// WINDOW_PASSES) == WINDOW_PASSES / 2                    ' R20.1: opposite the rpm window's slot pass
            frontEventChecks(nowMs)
            frontLateCheck(nowMs)
        LALOOPEND()                                                             ' let LA know end of loop

        ' 4. accounting, then the absolute schedule
        passBodyTicks := getct() - passStartTicks
        deltaTicks := passBodyTicks
        frontMaxPassTicks := frontMaxPassTicks #> passBodyTicks
        if (nextDue - getct()) < lateMarginTicks
            ' Late. WAITCT waits until the counter MATCHES its target, so a target already past would
            '  wait for the 32-bit counter to wrap (about 16 s). The wait is skipped and the schedule
            '  re-anchored: missed slots are counted, never replayed.
            frontLatePasses++
            nextDue := getct() + ticksPerPass
        else
            waitct(nextDue)
            nextDue += ticksPerPass

    ' EXIT: parked with no output until stop() cogstops this cog. It never returns, so its cog id
    '  cannot be released and reused before that cogstop.
    repeat
        waitms(FRONT_PARK_MS)

PRI bFrontServiceRequests() : bExit | openMask, eClass, slotIdx, slotBit, bTaken, seqTaken, eCmd, nArg1, nArg2, nArg3, eStatus
' FRONT COG: poll the request in flight, then take, apply and answer the open request slots once: REQ_ESTOP, then
' REQ_STOP, then the rest, then EXIT.
'
' PL-161 (DRIVER_REV 37): NOTHING HERE WAITS ON THE DRIVER. A request whose driver must act first (a fault clear, a
' synchronized take, an e-stop's release) is put in flight by its apply (pendStage) and answered by
' frontPollPending() on a later pass. At most one is in flight: while it is, no request is taken -- securing ones
' included, as a request posted during an in-pass wait was never taken before that wait ended -- and within a pass,
' once one goes in flight, the rest stay posted. A live driver acts within one drive pass (523 us), under the ~0.9 ms
' least interval between passes, so a request in flight is answered on the first pass after its apply, and that pass
' goes on to take what was posted meanwhile, securing requests first; a driver that never acts is given up on at most
' 3 passes after.
'
' THE ACKNOWLEDGEMENT BOUND (DERIVED, as DOCs/plans/FRONT-COG-IMPLEMENTATION-PLAN.md 3.6 derives it): a single motor
' leaves at most 6 application cogs (8 less the driver and this cog), so at most 5 requests are ahead of any one. Each
' holds the slot order for at most 3 passes (one stage, its bound gone: the bound is 2.09 ms and passes are at least
' 0.9 ms apart), so one posted behind them is taken by the 15th pass after it and answered by the 18th: 18 ms at the
' nominal 1 ms pass, and seen within the caller's 1 ms poll (19 ms), under REQ_ACK_TIMEOUT_MS (20).
' A request needing two stages (a synchronized drive of a FAULTED motor) adds 3 passes when both bounds go, as the
' two in-pass waits it replaces added 2 x 2.09 ms; with a live driver it is answered on the second pass.
'
' @returns bExit - T/F where T means an EXIT was taken: every open slot has been answered and the loop must park

' Local Variables:
' @local openMask - bit per slot: open at the first sweep and not yet handled in this pass
' @local eClass - the request class being applied (REQ_CLASS_*)
' @local slotIdx - the slot, which is the calling cog's id
' @local slotBit - {slotIdx}'s bit in openMask
' @local bTaken - T/F where T means the slot's copy is one whole, unanswered request
' @local seqTaken - the sequence of the copied request
' @local eCmd - the copied REQ_* code
' @local nArg1 - the copied first argument
' @local nArg2 - the copied second argument
' @local nArg3 - the copied third argument
' @local eStatus - the applied request's status, answered as data

    bExit := FALSE
    if pendStage <> PST_NONE
        frontPollPending()                                                      ' PL-161: answered once its driver has acted, or its bound gone
    if pendStage == PST_NONE                                                    ' still in flight: every request stays posted
        openMask := 0
        repeat slotIdx from 0 to COG_SLOT_COUNT - 1
            seqTaken := reqSeq[slotIdx]
            if (seqTaken <> SEQ_IDLE) and (seqTaken <> ackSeq[slotIdx])
                openMask |= 1 << slotIdx

        if openMask <> 0
            repeat eClass from REQ_CLASS_ESTOP to REQ_CLASS_EXIT
                repeat slotIdx from 0 to COG_SLOT_COUNT - 1
                    slotBit := 1 << slotIdx
                    if (openMask & slotBit) <> 0
                        bTaken, seqTaken, eCmd, nArg1, nArg2, nArg3 := frontTakeSlot(slotIdx)
                        if bTaken == FALSE
                            openMask &= !slotBit                                ' withdrawn by its caller, or already answered
                        elseif requestClass(eCmd) == eClass
                            openMask &= !slotBit
                            ' PL-161: once a request is in flight the rest of this pass's stay posted, EXIT too (it
                            '  would answer the one in flight ERR_NOT_STARTED); taken on the pass that answers it
                            if pendStage == PST_NONE
                                if eClass == REQ_CLASS_EXIT
                                    bExit := TRUE                               ' answered by frontAnswerForExit(), after every other slot
                                else
                                    eStatus := frontApply(eCmd, nArg1, nArg2, nArg3)
                                    if pendStage <> PST_NONE                    ' in flight: answered by frontPollPending()
                                        frontPendHold(slotIdx, seqTaken, eCmd, nArg1, nArg2, nArg3)
                                    else
                                        answerSlot(slotIdx, seqTaken, eStatus)
            if bExit == TRUE
                frontAnswerForExit()

PRI frontAnswerForExit() | slotIdx, bTaken, seqTaken, eCmd, nArg1, nArg2, nArg3, eStatus
' FRONT COG, on EXIT: answer every other open request, then acknowledge each EXIT, so stop() cogstops a cog with nothing left to say.

' Local Variables:
' @local slotIdx - the slot, which is the calling cog's id
' @local bTaken - T/F where T means the slot's copy is one whole, unanswered request
' @local seqTaken - the sequence of the copied request
' @local eCmd - the copied REQ_* code
' @local nArg1 - the copied first argument
' @local nArg2 - the copied second argument
' @local nArg3 - the copied third argument
' @local eStatus - the status answered for a non-EXIT request

    ' securing requests are still applied (neither waits) and answered NO_ERROR; the rest ERR_NOT_STARTED
    repeat slotIdx from 0 to COG_SLOT_COUNT - 1
        bTaken, seqTaken, eCmd, nArg1, nArg2, nArg3 := frontTakeSlot(slotIdx)
        if (bTaken == TRUE) and (eCmd <> REQ_EXIT)
            eStatus := ERR_NOT_STARTED
            if requestClass(eCmd) <> REQ_CLASS_OTHER
                eStatus := frontApply(eCmd, nArg1, nArg2, nArg3)                ' securing: never puts a request in flight
            answerSlot(slotIdx, seqTaken, eStatus)
    ' acknowledged last: the stop() waiting on this may cogstop this cog at once
    repeat slotIdx from 0 to COG_SLOT_COUNT - 1
        bTaken, seqTaken, eCmd, nArg1, nArg2, nArg3 := frontTakeSlot(slotIdx)
        if (bTaken == TRUE) and (eCmd == REQ_EXIT)
            answerSlot(slotIdx, seqTaken, NO_ERROR)

PRI frontTakeSlot(slotIdx) : bTaken, seqTaken, eCmd, nArg1, nArg2, nArg3
' FRONT COG: copy one request slot and prove the copy is one whole, unanswered request.
'
' @param slotIdx - the slot, which is the calling cog's id
' @returns bTaken - T/F where T means the copy below is one whole request that has not been answered
' @returns seqTaken - the sequence the copy belongs to
' @returns eCmd - the copied REQ_* code
' @returns nArg1 - the copied first argument
' @returns nArg2 - the copied second argument
' @returns nArg3 - the copied third argument

    seqTaken := reqSeq[slotIdx]
    eCmd := reqCmd[slotIdx]
    nArg1 := reqArg1[slotIdx]
    nArg2 := reqArg2[slotIdx]
    nArg3 := reqArg3[slotIdx]
    ' re-read LAST: a caller writes its arguments only after withdrawing, and never reuses a sequence,
    '  so an unchanged sequence proves every copy above was taken from one published request
    bTaken := (seqTaken <> SEQ_IDLE) and (seqTaken <> ackSeq[slotIdx]) and (reqSeq[slotIdx] == seqTaken)

PRI answerSlot(slotIdx, seqTaken, eStatus)
' FRONT COG: answer one request: the status first, the acknowledgement last.
'
' @param slotIdx - the slot, which is the calling cog's id
' @param seqTaken - the sequence being answered
' @param eStatus - the request's status, NO_ERROR or an ERR_* code

    ackStatus[slotIdx] := eStatus       ' first, so a caller that sees its sequence reads this answer's status
    ackSeq[slotIdx] := seqTaken

PRI requestClass(eCmd) : eClass
' Return the class that orders a request within a pass.
'
' @param eCmd - a REQ_* code
' @returns eClass - REQ_CLASS_ESTOP, REQ_CLASS_STOP, REQ_CLASS_EXIT, or REQ_CLASS_OTHER for every other code

    case eCmd
        REQ_ESTOP:
            eClass := REQ_CLASS_ESTOP
        REQ_STOP:
            eClass := REQ_CLASS_STOP
        REQ_EXIT:
            eClass := REQ_CLASS_EXIT
        other:
            eClass := REQ_CLASS_OTHER

PRI frontApply(eCmd, nArg1, nArg2, nArg3) : eStatus
' FRONT COG: apply one taken request to this motor; records nothing, the status travels back as data.
'
' PL-161: never waits. A request whose driver must act first is left IN FLIGHT (pendStage <> PST_NONE) and its status
' here is provisional; bFrontServiceRequests() then holds it (frontPendHold()) and frontPollPending() answers it.
'
' @param eCmd - the REQ_* code
' @param nArg1 - first argument, meaning per REQ_*
' @param nArg2 - second argument, meaning per REQ_*
' @param nArg3 - third argument, meaning per REQ_*
' @returns eStatus - NO_ERROR, a protective code or ERR_EMERGENCY_STOPPED; ERR_SYNC_TIMEOUT and ERR_NO_RESPONSE come only from frontPollPending()

    eStatus := NO_ERROR
    ' R20.1: every record (frontOpenDrive(), frontRecordStop()) follows the command its path writes (D6)
    case eCmd
        REQ_ESTOP:
            bCmdWatched := FALSE                                                ' S-8: no open-ended drive to watch
            frontEStop(TRUE)
            frontRecordStop(SR_EMERGENCY)                                       ' here, not in frontEStop(): the walk guard uses that too
        REQ_STOP:
            bCmdWatched := FALSE
            frontStopCommanded()                                                ' PL-52: clears getPower() too; task 3616: and a fault
            frontRecordStop(SR_COMMANDED)
        REQ_CLEAR_ESTOP:
            eStatus := protectiveCode                                           ' a protective stop is released only by its own clear
            if eStatus == NO_ERROR
                frontClearEStopBegin()                                          ' PL-161: in flight until the driver leaves DCS_ESTOP
        REQ_CLEAR_PROTECT:
            if protectiveCode <> NO_ERROR                                       ' with nothing latched, a user's e-stop is not released here
                frontClearProtective()
                frontClearEStopBegin()                                          ' zero command first, then the latch released
        REQ_SET_LIMITS:
            frontSetCurrentLimits(nArg1, nArg2)
        REQ_SET_HOLD:
            frontSetHoldLimits(nArg1, nArg2, nArg3)
        REQ_SET_FAULT:
            frontSetFaultResponse(nArg1, nArg2)
        REQ_FORCE_FAULT:
            frontForceFault()
        REQ_SET_TIMEOUT:
            cmdTimeoutMs := nArg1
            lastDriveMs := getms()                                              ' the clock starts now, never from a stale command
        REQ_DRIVE:
            ' PL-161: frontDriveBegin() writes the command now, or leaves it in flight behind a fault clear; the tail
            '  (frontDriveTail()) runs once the command is written, so each record still follows its write
            eStatus := frontDriveBegin(nArg1, nArg3 <> FALSE)
            if pendStage <> PST_FAULT_LEFT
                frontDriveTail(eCmd, nArg1, nArg2, eStatus)
        REQ_DRIVE_DISTANCE:
            ' atomic: the limit is armed and the motor driven, or neither (I1 item 2)
            eStatus := frontRefusal()
            if eStatus == NO_ERROR
                frontSetLimits(nArg1, motorStopMSecs)                           ' the time limit is kept, as before; PL-153: the
                                                                                '  distance counts from here, not the odometer
                eStatus := frontDriveBegin(nArg2, FALSE)
            if pendStage <> PST_FAULT_LEFT
                frontDriveTail(eCmd, nArg1, nArg2, eStatus)
        REQ_WALK:
            ' PL-122: a checkWiring() leg: as REQ_DRIVE_DISTANCE, then under the current guard;
            '  PL-137: arg1 names the leg, whose record opens once it is driven. DRIVER_REV 40: no ramp is applied
            '  here -- checkWiring() posts a leg only once walkRamps(TRUE) has seen the built-in ramp in force
            bCmdWatched := FALSE
            eStatus := frontRefusal()
            if eStatus == NO_ERROR
                frontSetLimits(WALK_TICKS, 0)                                   ' PL-153: the leg counts from here; the odometer is kept
                eStatus := frontDriveBegin(nArg2, FALSE)
                if pendStage <> PST_FAULT_LEFT
                    frontDriveTail(eCmd, nArg1, nArg2, eStatus)
        REQ_LIMIT_TICKS:
            frontSetLimits(nArg1, motorStopMSecs)                               ' PL-153: counts from here, not the odometer
        REQ_LIMIT_TIME:
            frontSetTimeLimit(nArg1)                                            ' an armed distance keeps counting from its own arming
        REQ_RESET_TRACKING:
            frontResetTracking(FALSE)                                           ' the odometer only: the rpm window and the limits keep running
        REQ_RESET_MAX:
            frontResetMax()
        REQ_TEST_INCREMENT:
            eStatus := frontRefusal()
            if eStatus == NO_ERROR
                frontWriteIncrement(nArg1, FALSE)
            frontWatchCommand((eStatus == NO_ERROR) and (nArg1 <> 0))
            frontNoteDriveCommand(eStatus, nArg1)
        REQ_NOTE_START:
            frontNoteStartChecks()                                              ' R20.1: EV_CHECK_RETRY, from the only writer of the log

PRI frontNoteDriveCommand(eStatus, nPowerOrIncre)
' FRONT COG: after a drive command's apply, open the drive it started or record the stop it made (R20.1).
'
' An accepted non-zero command opens a drive; an accepted zero ends the open one SR_COMMANDED. A command the driver did
' not take (ERR_SYNC_TIMEOUT), or a fault that did not clear (ERR_NO_RESPONSE), leaves the motor zeroed: the program's
' call ended the open drive, SR_COMMANDED. A refused command (protective or emergency stop) wrote nothing and records nothing.
'
' @param eStatus - the apply's status
' @param nPowerOrIncre - the command's power, or its raw increment; 0 is a stop

    if eStatus == NO_ERROR
        if nPowerOrIncre <> 0
            frontOpenDrive()
        else
            frontRecordStop(SR_COMMANDED)
    elseif (eStatus == ERR_SYNC_TIMEOUT) or (eStatus == ERR_NO_RESPONSE)
        frontRecordStop(SR_COMMANDED)

PRI frontLateCheck(nowMs)
' FRONT COG: every WINDOW_PASSES passes -- log this front cog's late passes as EV_LATE_PASS, at most once per
' EV_RATE_GAP_MS, each event carrying every late pass since the last (R20.1).
'
' @param nowMs - getms() for this pass

    if (frontLatePasses <> evLastLate) and (nowMs - evLateMs >= EV_RATE_GAP_MS)
        frontQueueEvent(EV_LATE_PASS, frontLatePasses - evLastLate)
        evLastLate := frontLatePasses
        evLateMs := nowMs

PRI frontWatchCommand(bOpenEnded)
' FRONT COG: record an applied drive command for the command timeout (S-8): every drive is watched, bounded or not
' (PL-143, STEPHEN 2026-09-26 "no carve-outs"); the wiring walk, a start check's own motion, is not a drive.
'
' @param bOpenEnded - T/F where T means the command just applied drives the motor

    bCmdWatched := bOpenEnded
    lastDriveMs := getms()

PRI bFrontCommandTimedOut(nowMs) : bFired
' FRONT COG: return TRUE, and stop watching, when the command timeout is on and a watched drive has had no command within it (S-8).
'
' @param nowMs - getms() for this pass
' @returns bFired - T/F where T means the motor must be stopped now; the timeout has been counted for getError()

    bFired := FALSE
    ' the difference is wrap-safe: getms() wraps after ~49 days, and the timeout is at most a minute. A motor
    '  already stopped (a stop limit fired, or it faulted and was cleared) has nothing left to stop.
    if (cmdTimeoutMs <> CMD_TIMEOUT_OFF) and (bCmdWatched == TRUE) and ((targetIncre & !SYNC_BIT) <> 0) and ((nowMs - lastDriveMs) >= cmdTimeoutMs)
        debug[user.DBGCH_FAULT]("-MOT- command timeout: no drive command in ", udec_long(cmdTimeoutMs), " ms, stopping")
        bCmdWatched := FALSE
        cmdTimeoutEvents++                                                      ' the front cog is this long's only writer
        bFired := TRUE

PRI frontDriveBegin(power, bSync) : eStatus
' FRONT COG: begin a drive request (PL-161): refused; or, FAULTED, its fault cleared first and the request left in
' flight (PST_FAULT_LEFT) with nothing else written; or its command written now (frontDriveWrite()).
'
' @param power - power [(-100) to 100], saturated to that range and then to setMaxSpeed(); 0 stops
' @param bSync - T/F where T means the command is synchronized with this front cog's ATN
' @returns eStatus - NO_ERROR (so far, while in flight), or the protective code or ERR_EMERGENCY_STOPPED with nothing written

    eStatus := frontRefusal()
    if eStatus == NO_ERROR
        if bFrontClearFaultBegin() == TRUE                                      ' PL-66: FAULTED, the clear made
            frontPendBegin(PST_FAULT_LEFT)
        else
            eStatus := frontDriveWrite(power, bSync)

PRI frontDriveWrite(power, bSync) : eStatus
' FRONT COG: write this motor's command for {power}; with {bSync}, release it with one ATN and leave the request in
' flight until the driver has taken it (PST_SYNC_TAKEN) -- never waited on here (PL-161).
'
' @param power - power [(-100) to 100], saturated to that range and then to setMaxSpeed(); 0 stops
' @param bSync - T/F where T means the command is synchronized with this front cog's ATN
' @returns eStatus - NO_ERROR, or the protective code or ERR_EMERGENCY_STOPPED with nothing written

    eStatus := frontDrive(power, bSync)
    if (eStatus == NO_ERROR) and (bSync == TRUE)
        cogatn(frontDriverCogBit())
        frontPendBegin(PST_SYNC_TAKEN)

PRI frontDriveTail(eCmd, nArg1, nArg2, eStatus)
' FRONT COG: a drive request's work after its command is written, or once it has failed (R20.1's records, S-8's watch,
' a walk leg's guard and record) -- the code each REQ_* ran after its drive before PL-161, unchanged.
'
' PL-161: a synchronized command is written, and this runs with NO_ERROR, on the pass the request goes in flight, so a
' stop the front cog makes on its own before the take is seen (a limit, the blocked test) still follows the drive's
' records, as it did when the take was waited for in the pass. If the take then fails, this runs again with
' ERR_SYNC_TIMEOUT, after the zero, and records the stop as before; a drive the program opened is then ended SR_COMMANDED.
'
' @param eCmd - REQ_DRIVE, REQ_DRIVE_DISTANCE or REQ_WALK (any other: nothing)
' @param nArg1 - the request's first argument (REQ_DRIVE: power; REQ_WALK: the leg)
' @param nArg2 - the request's second argument (REQ_DRIVE_DISTANCE and REQ_WALK: power)
' @param eStatus - the drive's status: NO_ERROR, a refusal, ERR_NO_RESPONSE (the fault did not clear) or ERR_SYNC_TIMEOUT

    case eCmd
        REQ_DRIVE:
            frontWatchCommand((eStatus == NO_ERROR) and (nArg1 <> 0))
            frontNoteDriveCommand(eStatus, nArg1)
        REQ_DRIVE_DISTANCE:
            frontNoteDriveCommand(eStatus, nArg2)
            ' PL-143, STEPHEN 2026-09-26 "no carve-outs": the command timeout watches this drive like any other
            frontWatchCommand((eStatus == NO_ERROR) and (nArg2 <> 0))
        REQ_WALK:
            if eStatus == NO_ERROR
                frontArmWalkGuard()
                frontWalkBegin(nArg1)
            else
                frontSetLimits(0, 0)                                            ' not driven: no limit stays armed either
            ' R20.1: a walk leg opens no drive; one left open is ended by the program's own call, checkWiring()
            frontRecordStop(SR_COMMANDED)

PRI frontClearEStopBegin()
' FRONT COG: release this motor's emergency stop, and leave the request in flight until the driver has left DCS_ESTOP
' (PST_ESTOP_LEFT), so a drive posted right after is not refused -- never waited on here (PL-161).

    frontEStop(FALSE)                                                           ' zero command first, then the latch released
    if isEmergency() == TRUE
        frontPendBegin(PST_ESTOP_LEFT)

PRI frontPendBegin(eStage)
' FRONT COG: put the request being applied in flight at {eStage}, its bound starting now (PL-161).
'
' @param eStage - PST_FAULT_LEFT, PST_SYNC_TAKEN or PST_ESTOP_LEFT

    pendStage := eStage
    pendTicks := getct()

PRI frontPendHold(slotIdx, seqTaken, eCmd, nArg1, nArg2, nArg3)
' FRONT COG: keep the request frontApply() left in flight, so frontPollPending() can finish and answer it (PL-161).
'
' @param slotIdx - the request's slot, its caller's COGID()
' @param seqTaken - the sequence it is answered under
' @param eCmd - its REQ_* code
' @param nArg1 - its first argument
' @param nArg2 - its second argument
' @param nArg3 - its third argument

    pendSlot := slotIdx
    pendSeq := seqTaken
    pendCmd := eCmd
    pendArg1 := nArg1
    pendArg2 := nArg2
    pendArg3 := nArg3

PRI frontPollPending() | power, bSync, eStatus
' FRONT COG: once a pass, at the head of the request service: look once at what the request in flight waits for, and
' finish and answer it when the driver has done it, or when its bound (bFrontWaitExpired()) has gone (PL-161).
'
' The condition is read before the bound, as the busy-wait it replaces read it, so a driver that acts on the last pass
' is answered as having acted. Each outcome and status is the one that busy-wait gave; nothing here waits.

' Local Variables:
' @local power - PST_FAULT_LEFT: the power the request's command is written with once the fault has left
' @local bSync - PST_FAULT_LEFT: T/F where T means that command is synchronized
' @local eStatus - the request's status, answered as data

    case pendStage
        PST_ESTOP_LEFT:
            if isEmergency() == FALSE
                frontPendAnswer(NO_ERROR)
            elseif bFrontWaitExpired(pendTicks) == TRUE
                frontPendAnswer(ERR_NO_RESPONSE)                                ' still DCS_ESTOP after the bound
        PST_FAULT_LEFT:
            if drv_state <> DCS_FAULTED
                ' PL-66: the fault has left, so the requested command is written now: REQ_DRIVE's power and sync are
                '  arg1 and arg3, REQ_DRIVE_DISTANCE's and REQ_WALK's power arg2, never synchronized
                power := pendArg2
                bSync := FALSE
                if pendCmd == REQ_DRIVE
                    power := pendArg1
                    bSync := (pendArg3 <> FALSE)
                pendStage := PST_NONE                                           ' a synchronized write puts it back in flight
                eStatus := frontDriveWrite(power, bSync)
                frontDriveTail(pendCmd, pendArg1, pendArg2, eStatus)
                if pendStage == PST_NONE
                    answerSlot(pendSlot, pendSeq, eStatus)
            elseif bFrontWaitExpired(pendTicks) == TRUE
                ' did not clear in the bound: the zero command bFrontClearFaultBegin() wrote stays written
                frontDriveTail(pendCmd, pendArg1, pendArg2, ERR_NO_RESPONSE)
                frontPendAnswer(ERR_NO_RESPONSE)
        PST_SYNC_TAKEN:
            if bFrontTakenSync() == TRUE
                frontPendAnswer(NO_ERROR)
            elseif bFrontWaitExpired(pendTicks) == TRUE
                ' audit M: a command the driver did not take must not be left to be taken later
                frontZeroPower()                                                ' PL-52: a failed take stops the motor too
                frontDriveTail(pendCmd, pendArg1, pendArg2, ERR_SYNC_TIMEOUT)
                frontPendAnswer(ERR_SYNC_TIMEOUT)

PRI frontPendAnswer(eStatus)
' FRONT COG: answer the request in flight with {eStatus}, and end its flight (PL-161).
'
' @param eStatus - its status, NO_ERROR or an ERR_* code

    answerSlot(pendSlot, pendSeq, eStatus)
    pendStage := PST_NONE

PRI postRequest(eCmd, nArg1, nArg2, nArg3) : eStatus | slotIdx, mySeq, startMs, bAnswered
' Post a request to this motor's front cog from the calling cog, and wait, bounded, for its answer; records nothing.
'
' @param eCmd - the REQ_* code
' @param nArg1 - first argument, meaning per REQ_*
' @param nArg2 - second argument, meaning per REQ_*
' @param nArg3 - third argument, meaning per REQ_*
' @returns eStatus - the front cog's status; ERR_NOT_STARTED when no front cog runs (nothing posted) or it was stopped during the wait; ERR_NO_RESPONSE when a running front cog did not answer in time (the outcome is unknown)

' Local Variables:
' @local slotIdx - this cog's slot, its COGID()
' @local mySeq - the sequence this request is published under
' @local startMs - getms() when the wait began
' @local bAnswered - T/F where T means the front cog acknowledged mySeq

    slotIdx := COGID()
    eStatus := ERR_NOT_STARTED
    if senseCog <> 0
        reqSeq[slotIdx] := SEQ_IDLE                                             ' 1. withdraw: nothing earlier from this slot can be taken now
        reqCmd[slotIdx] := eCmd                                                 ' 2. the request
        reqArg1[slotIdx] := nArg1
        reqArg2[slotIdx] := nArg2
        reqArg3[slotIdx] := nArg3
        mySeq := reqNextSeq[slotIdx] + 1                                        ' 3. a fresh, monotonic sequence, never SEQ_IDLE
        if mySeq == SEQ_IDLE
            mySeq++
        reqNextSeq[slotIdx] := mySeq
        reqSeq[slotIdx] := mySeq                                                ' 4. publish, LAST

        bAnswered := FALSE                                                      ' 5. wait, bounded
        startMs := getms()
        repeat
            waitms(REQ_POLL_MS)
            if ackSeq[slotIdx] == mySeq
                bAnswered := TRUE
                quit
            if getms() - startMs > REQ_ACK_TIMEOUT_MS
                quit
        if bAnswered == FALSE
            reqSeq[slotIdx] := SEQ_IDLE                                         ' withdraw: the front cog can no longer take it
            bAnswered := (ackSeq[slotIdx] == mySeq)                             ' answered in the instant before the withdraw
        if bAnswered == TRUE
            eStatus := ackStatus[slotIdx]                                       ' written before ackSeq, so it is this answer's
        elseif senseCog <> 0
            eStatus := ERR_NO_RESPONSE
        ' else: the front cog was stopped while this cog waited, ERR_NOT_STARTED

CON { --- FRONT COG service surface: called only from a front cog (this object's, or its owner's) --- }

PRI currentLimitK(amps) : nK
' Return the driver's fold-back factor for a phase-current limit: threshold mV = duty x nK >> 16.
'
' The driver folds on a whole-mV reading ABOVE that floored threshold (DRIVER_REV 38), i.e. at or above its ceiling.
' The threshold's duty floor comes with it from setFoldLimit(), which keeps it at or above FOLD_MIN_MV (PL-163).
'
' The driver compares the DC-link reading against 0.75 x m x amps x rSense, m = duty / (4 x frame_cnt),
' so nK = 3 x amps x rSense x 65536 / (16 x frame_cnt). With no board detected there is no scale, and
' nK is set so the threshold is above the ADC's range: no fold-back. PL-73: a driver never starts in that
' state (launchDriver() refuses an undetected board); only an instance set up by testSetup() reaches it.
'
' @param amps - the phase-current limit, amps
' @returns nK - the factor, 1..$FFFF

    if rSenseForBoard == VALUE_NOT_SET
        nK := $FFFF
    else
        nK := 1 #> muldiv64(3 * amps * rSenseForBoard, $1_0000, 16 * frame_cnt) <# $FFFF

PRI setFoldLimit(amps) | nK, nFloor
' Set the driver's fold-back to a phase-current limit: i_limit_k, and the fold's duty floor that keeps its threshold at
' or above FOLD_MIN_MV (PL-163, DRIVER_REV 40). init() before the driver runs, then the front cog only.
'
' The floor is max(dutyFloorEst, ceil(FOLD_MIN_MV << 16 / nK)), so floor x nK >> 16 is at least FOLD_MIN_MV (and, nK
' under $1_0000, exactly it when raised); SCA takes 16 bits, so it is capped at $FFFF. The two longs are written in the
' order whose one-frame mix is the lower threshold: a lower nK first (its floor then rises), else the floor first.
'
' @param amps - the phase-current limit, amps

' Local Variables:
' @local nK - the limit's fold-back factor (currentLimitK())
' @local nFloor - the fold's duty floor for it

    nK := currentLimitK(amps)
    nFloor := dutyFloorEst #> (((FOLD_MIN_MV << 16) + nK - 1) / nK) <# $FFFF
    if nK < i_limit_k
        i_limit_k := nK
        duty_floor := nFloor
    else
        duty_floor := nFloor
        i_limit_k := nK

PRI frontCommand(nIncre, bSync)
' FRONT COG: write this motor's driver command, and mark a stop as needing confirmation on the next pass.
'
' @param nIncre - the driver angle increment; 0 stops
' @param bSync - T/F where T means the command carries the sync bit and is taken only after its owner's ATN

    setTargetAccel(nIncre, bSync)
    bWalkGuardArmed := FALSE                                                    ' PL-122: any command ends a walk leg's guard; REQ_WALK re-arms after its own
    bStopUnconfirmed := ((nIncre ZEROX 30) == 0)                               ' any other command supersedes a pending confirmation
    userCmdIncr := nIncre                                                       ' R18.4 D-6: what was COMMANDED, which a path scale never changes
    userCmdGen++                                                                '  and a count an owner reads to see a new command arrive
    if (nIncre <> 0) and (walkWatchLeg <> WLEG_NONE)                            ' PL-137: a drive ends a walk leg's watch; its own stops do not
        frontWalkClose()

PRI releaseFaultLatch()
' FRONT COG: the one place a commanded write releases a FAULTED driver (task 3616): advance fault_clr. Call it
' AFTER the command is written, so the driver pass that sees the advance also reads that command.

    fault_clr++

PRI frontNoteFault(eDrvState) | nIllegalNow, nHallCode, nResyncsNow
' FRONT COG: on the pass the driver first reads DCS_FAULTED, latch why (S-7): FC_HALL when a hall sensor is reading
' %000 or %111, or entered one since the previous pass, else FC_LAG. The front cog is the cause's only writer.
' R19.3: a fault the driver answered with a re-sync (FR_GRADED, halls legal) is FC_LAG too, and this pass writes the
' stop that re-sync is waiting for. Either kind raises bFaultBegan for this pass (bFrontFaultBegan()).
' R20.1: a re-sync ends the open drive SR_FAULT_CONTROLLED (EV_FAULT_RESYNC, EV_STOP); a latched fault ends it
' SR_FAULT_LOST (EV_FAULT, EV_STOP), and escalates an SR_FAULT_CONTROLLED whose stop has not yet reached rest.
'
' @param eDrvState - the driver state read once for this pass

' Local Variables:
' @local nIllegalNow - the driver's hall_illegal long this pass (any change means a new illegal entry)
' @local nHallCode - the hall code the driver last read, from its status copy of hall_ (direction bit dropped)
' @local nResyncsNow - the driver's fault_resyncs long this pass (any change means a new re-synced fault)

    bFaultBegan := FALSE
    nResyncsNow := fault_resyncs
    if nResyncsNow <> faultResyncsPrev
        ' the driver re-seeded its field and is ramping down, reading 0 until a 0 is written: write it, which also
        '  clears getPower(), since the motor is being stopped under control (PL-52's "faulted" is not this)
        faultCause := FC_LAG
        faultResyncEvents++
        bFaultBegan := TRUE
        bCmdWatched := FALSE                                                    ' S-8: nothing open-ended is left to watch
        frontSetLimits(0, 0)                                                    ' a distance or time limit ends with the stop
        frontZeroPower()
        frontQueueEvent(EV_FAULT_RESYNC, FC_LAG)                                ' R20.1: recorded after the stop is written (D6)
        frontRecordStop(SR_FAULT_CONTROLLED)
        debug[user.DBGCH_FAULT]("-MOT- fault: re-synced from the halls, stopping under control")
    faultResyncsPrev := nResyncsNow
    nIllegalNow := hall_illegal
    if (eDrvState == DCS_FAULTED) and (bWasFaulted == FALSE)
        bFaultBegan := TRUE
        ' an illegal code makes the driver's hall angle meaningless, so the lag test trips on it: that fault is
        '  the SENSOR's, and naming it LAG would send the user after a load problem that is not there
        nHallCode := hall & %111
        if (nHallCode == %000) or (nHallCode == %111) or (nIllegalNow <> faultIllegalPrev)
            faultCause := FC_HALL
        else
            faultCause := FC_LAG
        ' R20.1: the driver has already taken the fault's bridge, so nothing here delays it
        frontQueueEvent(EV_FAULT, faultCause)
        if (bDriveOpen == FALSE) and (bResyncStopOpen == TRUE) and (stopReason == SR_FAULT_CONTROLLED)
            ' the one exception to first-wins: a fault latched on the re-synced stop means control was lost
            stopReason := SR_FAULT_LOST
            bResyncStopOpen := FALSE
            frontQueueEvent(EV_STOP, SR_FAULT_LOST)
        else
            frontRecordStop(SR_FAULT_LOST)
    if bResyncStopOpen == TRUE                                                  ' one test a pass unless a re-synced stop is under way
        if eDrvState == DCS_STOPPED
            bResyncStopOpen := FALSE                                            ' the re-synced stop reached rest: no longer escalates
    bWasFaulted := (eDrvState == DCS_FAULTED)
    faultIllegalPrev := nIllegalNow

PRI resetWindowAccumulators(nowPos)
' Reset the rpm window and the HDMI maxima, adopting {nowPos} as the window's prior position.
'
' @param nowPos - the driver's position at the reset

    longfill(@hallCountsWindow, 0, HALL_WINDOW_SIZE)                            ' zero our windowed accum
    hallWinEntryCt := hallWindowSum := hallWinIndex := 0
    hallCntsIn8thSec := 0
    prioro8thSecPos := nowPos                                                   ' reset by adopting current value
    resetHdmiData()

PRI updateWindowAccumulators() | nowPos, nHallCntsInSlot
' Advance the rpm window by one slot from the motion since the previous slot, then refresh the HDMI values.

' Local Variables:
' @local nowPos - the driver's position read once for this slot
' @local nHallCntsInSlot - hall ticks moved since the previous slot

    nowPos := pos
    nHallCntsInSlot := absDistanceInTics(nowPos, prioro8thSecPos)               ' Read the next sensor value
    prioro8thSecPos := nowPos                                                   ' save prior
    hallWindowSum -= LONG[@hallCountsWindow][hallWinIndex]                      ' Remove the oldest entry from the sum
    long [@hallCountsWindow][hallWinIndex] := nHallCntsInSlot                   ' place the newest reading into the window
    hallWindowSum += nHallCntsInSlot                                            ' Add the newest reading to the sum
    hallWinIndex := (hallWinIndex + 1) +// HALL_WINDOW_SIZE                     ' Increment the index, and wrap to 0 if it exceeds the window size
    if hallWinEntryCt < HALL_WINDOW_SIZE                                        ' incr number of samples in sum until is window size
        hallWinEntryCt++

    updateFollowing()                                                           ' R18.1: does the measured rate match the commanded one?
    frontApplyLead()                                                            ' R18.4: the dynamic lead, once per slot
    if lag_held <> lastLagHeldSeen                                              ' R18.4 D-6: slots since the lag limiter last held
        holdSlotsAgo := 0
    elseif holdSlotsAgo < SHORT_SLOTS
        holdSlotsAgo++
    lastLagHeldSeen := lag_held
    updateHdmiData()

PRI shortfallNow() : bShort, nAchievedPermille
' Return whether this motor is short, and the fraction of its command the field achieves (frontShortfall()'s rule).
'
' @returns bShort - T/F where T means the lag limiter held the field within the last SHORT_SLOTS slots
' @returns nAchievedPermille - the field's rate as a fraction of the commanded rate, 0-1000; 1000 when nothing is commanded

    bShort := (holdSlotsAgo < SHORT_SLOTS)
    nAchievedPermille := PERMILLE_FULL
    if userCmdIncr <> 0
        nAchievedPermille := muldiv64(abs(drv_incr_now), PERMILLE_FULL, abs(userCmdIncr)) <# PERMILLE_FULL

PRI frontApplyLead() | leadTenths
' FRONT COG ONLY, once per slot: while the lead schedule is on, write the commutation pair for the field's present speed.
'
' Only the lead moves; the servo's setpoint never does (DOCs/plans/DRIVE-INTEGRATION-DESIGN.md 3.3 and
' 5.3 D-3: the two place the field together, so moving both corrects twice). Keyed on the FIELD's speed,
' drv_incr_now, so the lead follows a ramp rather than jumping to the cruise value at the command. The
' driver re-reads the pair from its parameter block every frame, so no PASM change carries it.

' Local Variables:
' @local leadTenths - the lead for the present field speed, in tenths of a degree

    if bLeadScheduled == TRUE
        leadTenths := leadTenthsForIncrement(abs(drv_incr_now))
        ' written only when the lead changes, or once after the schedule is turned on: the steering front cog
        '  services two motors in the tightest budget in the design (section 4.2), and a flat table never changes
        if (leadTenths <> lastLeadTenths) or (bLeadWritePending == TRUE)
            writeOffsetsTenths(HUB_HALL_ZERO_DEGR * TENTHS_PER_DEGREE + leadTenths, HUB_HALL_ZERO_DEGR * TENTHS_PER_DEGREE - leadTenths)
            lastLeadTenths := leadTenths
            bLeadWritePending := FALSE

PRI updateFollowing() | cmdIncre
' FRONT COG ONLY: compare the measured tick rate against the commanded one, once per window slot.
'
' @local cmdIncre - targetIncre as a SIGNED increment: sync bit removed and the sign restored from
'   bit 30, which is where setTargetAccel()'s ZEROX leaves it
'
' WHY THE DRIVER OWNS THIS AND NOT THE HARNESS. The bench instrument already computed it and proved
' it carries the answer: at the current wall the drive was following at 44-47 % of commanded while
' duty saturated (MEASURED, DOCs/analyses/bench/2026-09-22/). But an observable that lives only in a
' test harness has integrated nothing -- the DRIVE still could not tell whether it was doing what it
' was told. This is that same quantity, computed where the drive can eventually act on it.
'
' HOW IT IS FREE. hallWindowSum is already the ticks moved over the last HALL_WINDOW_SIZE slots, and
' the window spans one second, so the measured rate needs no new accumulator -- it IS that sum. Only
' the commanded side is new, and it is one muldiv64 at the slot rate (125 Hz), not the pass rate.
'
' THE COMMANDED SIDE IS DERIVED, NEVER TABULATED: the field advances targetIncre angle units per
' drive pass, one hall cycle is 2^32 angle units and HALL_TICKS_PER_CYCLE ticks, and the drive runs
' PWM_RATE_IN_HZ / DRIVE_PASS_FRAMES passes per second -- the same three constants rampStepForAccel()
' already derives its own conversion from. The shift pair mirrors distanceForRampDown()'s idiom:
' (incr >> 9) x k / 2^23 is incr x k / 2^32 without overflowing.
'
' NOT A CONTROL CHANGE. Nothing in the drive path reads these; R18.1's rule is that the observables
' land with control behaviour unchanged, and the drive change that uses them is R18.4's.

    followCmdTicksSec := 0
    followPctOfCmd := 0
    bFollowValid := FALSE
    ' RECOVER THE SIGNED INCREMENT WITH SIGNX 30 (task 3594, Visit 7c C-1). This line read
    '  abs(targetIncre) on the RAW word, and the raw word is not a signed increment.
    '
    ' THE ENCODING, from its only writer, setTargetAccel(): `nTgtIncr ZEROX= 30` keeps bits 0..30 and
    '  CLEARS THE SIGN, then bit 31 is overwritten with the sync flag. So the increment's sign lives
    '  in BIT 30, and bit 31 means SYNC and nothing else. abs() on the raw word therefore reads a
    '  REVERSE command as a huge positive number, and the commanded rate came out NEAR-CONSTANT at
    '  ~5,650 ticks/s instead of 49 at an eighth and 98 at a quarter.
    '
    ' MEASURED, and the arithmetic matches the log to the digit: the raw form computed 5_689 at
    '  incre -18_375_000 and 5_640 at -36_750_000, exactly what BS-POINT3 carried
    '  (DOCs/analyses/bench/2026-09-22/VISIT-7C-EVALUATION.md sec 4).
    '
    ' !!! `& !SYNC_BIT` IS NOT THE FIX, though it is what the other three readers use. Those three
    '  only test the result against zero, where a lost sign cannot matter. Here it decides the
    '  magnitude: masking alone still leaves a reverse command reading 5_640, and fixes exactly one
    '  of the four sign/sync combinations. SIGNX 30 strips the sync bit AND restores the sign, and is
    '  correct for all four. The formula and the shift pair were never wrong.
    '
    ' AGAINST THE USER'S COMMAND, NOT THE DRIVER'S (Visit 10 pass 6, R18-DUAL-NOTFOL-D). A path scale
    '  (frontScaleCommand()) writes a scaled targetIncre and keeps userCmdIncr, so a wheel scaled to 8 %
    '  read 105 % here while shortfallNow() read 84 permille of the same command: two "following"
    '  readings, two meanings (D7). targetIncre still gates validity: an e-stop or a stop zeroes it and
    '  leaves userCmdIncr, and a stopped wheel is not "not following".
    cmdIncre := targetIncre SIGNX 30
    if (cmdIncre <> 0) and (userCmdIncr <> 0)
        followCmdTicksSec := muldiv64(abs(userCmdIncr) >> 9, ...
            HALL_TICKS_PER_CYCLE * (PWM_RATE_IN_HZ / DRIVE_PASS_FRAMES), 1 << 23)
    if (hallWinEntryCt >= HALL_WINDOW_SIZE) and (followCmdTicksSec > 0)
        bFollowValid := TRUE
        followPctOfCmd := (hallWindowSum * 100) / followCmdTicksSec

PRI resetHdmiData()
    tvMaxFps_x10 := tvMaxMPH_x10 := tvMaxkPH_x10 := 0
    tvMaxRpmIn10ths := tvMaxCntsInSec := tvMaxMmPerSec_x10 := 0
    tv360rpm_x10 := tv360rpm := 0
    tvMaxSenseI := 0

PRI updateHdmiData() | degreesPerTic, ticsPerRotation, nCircInMM_x10
' Refresh the rpm, speed and power values shown on the HDMI debug display from the rpm window.

' Local Variables:
' @local degreesPerTic - degrees of rotation per hall tick for this motor
' @local ticsPerRotation - hall ticks per rotation for this motor
' @local nCircInMM_x10 - wheel circumference, in tenths of a mm

    ' PL-70: the loop uses the compile-time geometry, never a VAR copy that init() may not have set
    degreesPerTic, ticsPerRotation := hallTicInfoForMotor()
    cntsInSec := hallWindowSum                                                  ' moving sum
    tvRpm_x10 := ((cntsInSec * 60) * 10) / ticsPerRotation
    rpm := tvRpm_x10 / 10

    tvMaxRpmIn10ths := max(tvRpm_x10, tvMaxRpmIn10ths)
    maxRpm := tvMaxRpmIn10ths / 10
    tvMaxCntsInSec := max(cntsInSec, tvMaxCntsInSec)

    tvMaxSenseI := max(sense_i_mV, tvMaxSenseI)
    ' power calcs -- PL-25/PL-45: same scaled, net-of-rest-zero, board-not-detected-safe reading
    '  getCurrent() uses; telemetry records no error, a caller's command does (in getCurrent() alone)
    tv_mA, tv_mW := scaledCurrent()

    if user.WHEEL_DIA_IN_INCH <> 0
        ' pos is in hall-steps of 4Degr each (4deg for 6.5motor, 15deg for doco4k).
        ' circumference of wheel is in mm x10
        '   degrees of rotation is cntsInSec * 4
        '   number of rotations is degrees / 360
        '   dist in mm is (circInMM_x10 * rotations) / 10
        nCircInMM_x10, _ := wheelGeometry()
        mmPerSec_x10 := (((cntsInSec * degreesPerTic) * nCircInMM_x10) / 360)
        ftPerSec_x10 := distConv.mmps2fps(mmPerSec_x10 * 10)
        kmh_x10 := distConv.mmps2kmh(mmPerSec_x10 * 10)
        mph_x10 := distConv.fps2mph(ftPerSec_x10)

        tvMaxMmPerSec_x10 := max(mmPerSec_x10, tvMaxMmPerSec_x10)
        tvMaxFps_x10 := max(ftPerSec_x10, tvMaxFps_x10)
        tvMaxMPH_x10 := max(mph_x10, tvMaxMPH_x10)
        tvMaxkPH_x10 := max(kmh_x10, tvMaxkPH_x10)

PRI max(nLtVal,nRtVal) : nMax
' return max of nLtVal or nRtVal
'
' @param nLtVal - the first value
' @param nRtVal - the second value
' @returns nMax - the larger of the two

    nMax := (nLtVal > nRtVal) ? nLtVal : nRtVal

PRI absDistanceInTics(newPos, priorPos) : nHallTics
' Return the distance between two positions, in hall ticks, always positive. For example:
'  -7 -> -9 = abs(-7 - -9) = abs(2) = 2
'  -11 -> -9 = abs(-11 - -9) = abs(-2) = 2
'  9 -> -9 = abs(9 - -9) + abs(18) = 18
' -9 -> 6 = abs(-9 - 6) = abs(-15) = 15
' -3 -> 6 = abs(-3 - 6) = abs(-9) = 9
' 9 -> 6 = abs(9 - 6) = abs(3) = 3
' 9 -> 12 = abs(9 - 12) = abs(-3) = 3
'
' @param newPos - the current position, hall ticks
' @param priorPos - the earlier position, hall ticks
' @returns nHallTics - the distance between them, hall ticks (always positive)

    nHallTics := abs(priorPos - newPos)

CON ' --- The Motor driver ---

DAT { MOTOR-TYPE TABLES }

' These table represent contants for use in BLDC pasm driver
'  tables specific to a given motor are copied into pasm driver image
'  before the driver is started
'
' old bit shift up by 3 then new bits
'   old is outer index
'   new is inner index

deltas65    BYTE    0, 0, 0, 0, 0, 0, 0, 0  ' Hall-effect-sensor position deltas from (old<<3 | new)
            BYTE    0, 0, 0,-1, 0, 1, 0, 0
            BYTE    0, 0, 0, 1, 0, 0,-1, 0
            BYTE    0, 1,-1, 0, 0, 0, 0, 0
            BYTE    0, 0, 0, 0, 0,-1, 1, 0
            BYTE    0,-1, 0, 0, 1, 0, 0, 0
            BYTE    0, 0, 1, 0,-1, 0, 0, 0
            BYTE    0, 0, 0, 0, 0, 0, 0, 0

deltas4k    BYTE    0, 0, 0, 0, 0, 0, 0, 0  ' old=0 - Hall-effect-sensor position deltas from (old<<3 | new)
            BYTE    0, 0, 0,-1, 0, 1, 0, 0  ' old=1
            BYTE    0, 0, 0, 1, 0, 0,-1, 0  ' old=2
            BYTE    0, 1,-1, 0, 0, 0, 0, 0  ' old=3
            BYTE    0, 0, 0, 0, 0,-1, 1, 0  ' old=4
            BYTE    0,-1, 0, 0, 1, 0, 0, 0  ' old=5
            BYTE    0, 0, 1, 0,-1, 0, 0, 0  ' old=6
            BYTE    0, 0, 0, 0, 0, 0, 0, 0  ' old=7

'   amount of rotation within hall cycle - 6.5" wheel
hltbAngles  LONG    0           '-%000- can't happen forward-direction table
            LONG    0 frac 6    '%001
            LONG    4 frac 6    '%010
            LONG    5 frac 6    '%011
            LONG    2 frac 6    '%100
            LONG    1 frac 6    '%101
            LONG    3 frac 6    '%110
            LONG    0           '-%111- can't happen

hltbAngle2  LONG    0           '-%000- can't happen - reverse-direction table
            LONG    5 frac 6    '%001
            LONG    3 frac 6    '%010
            LONG    4 frac 6    '%011
            LONG    1 frac 6    '%100
            LONG    0 frac 6    '%101
            LONG    2 frac 6    '%110
            LONG    0           '-%111- can't happen


'   amount of rotation within hall cycle - docoEng.com 4kRPM, 24V
hltbAngl4k  LONG    0           '-%000- can't happen - forward-direction table
            LONG    5 frac 6    '%001
            LONG    3 frac 6    '%010
            LONG    4 frac 6    '%011
            LONG    1 frac 6    '%100
            LONG    0 frac 6    '%101
            LONG    2 frac 6    '%110
            LONG    0           '-%111- can't happen

hltbAngl4k2 LONG    0           '-%000- can't happen - reverse-direction table
            LONG    0 frac 6    '%001
            LONG    4 frac 6    '%010
            LONG    5 frac 6    '%011
            LONG    2 frac 6    '%100
            LONG    1 frac 6    '%101
            LONG    3 frac 6    '%110
            LONG    0           '-%111- can't happen


CON { driver interface Constants }

    '  DCS_STOPPED          - motor is stopped
    '  DCS_SPIN_UP          - motor is ramping up to speed, then will be at AT_SPEED
    '  DCS_AT_SPEED         - motor is holding at speed
    '  DCS_SPIN_DN          - motor is stopping, then will be at STOPPED
    '  DCS_SLOW_TO_CHG      - motor is slowing down to change direction, then will be SPEEDING_UP
    '  DCS_FAULTED          - motor faulted (couldn't drive to requested speed)
    '  DCS_ESTOP            - motor in emergency stop (external stop requested)
    '  DCS_RELEASED         - PL-138: stop() asked the driver to let go; its bridge coasted and every pin it drove
    '                         is plain and driven OFF (or input). It parks until stop()'s cogstop, which then
    '                         writes DCS_Unknown, so it is seen only inside stop()
    '
    #0, DCS_Unknown, DCS_STOPPED, DCS_SPIN_UP, DCS_AT_SPEED, DCS_SPIN_DN, DCS_SLOW_TO_CHG, DCS_FAULTED, DCS_ESTOP, DCS_RELEASED

CON { driver internal Constants }

    ' R17.1 / PL-89 (DOCs/plans/STOP-STATE-DESIGN.md): the PASM driver's bridge register holds exactly one of these,
    '  and each state is written so its meaning does not depend on a pin's inversion. The low-side PWM pins are
    '  inverted (pwmn) and a HIGH on a low-side input turns that FET ON (PL-56), so Y = 0 on every pin is SHORT, not off.
    '  BR_DRIVE - PWM switching: the motor is driven, or held at rest in SM_BRAKE (R19.1's hold)
    '  BR_SHORT - high sides Y = 0 (off), low sides Y = 0 (inverted: ON): the phases shorted, a dynamic brake
    '  BR_COAST - high sides Y = 0 (off), low sides Y = frame (inverted: off): all six FETs off, a freewheel
    '  BR_BRAKE - high sides Y = 0 (off), low sides SLICED: every BRAKE_PERIOD_FRAMES frames, the first brake_on
    '             frames are BR_SHORT and the rest BR_COAST -- a GRADED short whose average braking torque is
    '             brake_on / BRAKE_PERIOD_FRAMES of the full short's, at every speed; no rotor angle needed (R19.3).
    '             The slice is far longer than the winding's L/R, so each short slice brakes as the full short
    '             does. It caps the average torque, not the peak current, which is the full short's. Never PWM the
    '             low sides within a frame: with the high sides off that is a boost converter, which conducts only
    '             above a duty of 1 - back-EMF / supply (PL-129). At each switch to coast the winding's current
    '             returns briefly to the supply through the high-side diodes.
    '  BR_PROBE - at rest only, for the start-time continuity check (R19.4): one phase (probe_phase_) switches at
    '             50 % with its dead gap, the other two have all FETs off. No current path exists, so nothing
    '             moves; through the windings the undriven phases' voltages follow the driven one's.
    '  Which state each stop path takes: at rest SM_FLOAT -> BR_COAST, SM_BRAKE -> BR_DRIVE (hold) or, handed
    '  off, BR_SHORT; a fault -> faultResponse (the response mode decides); an e-stop -> BR_SHORT whatever the
    '  stop mode. The table lowy_tbl, indexed by these values, holds each undriven state's low-side Y.
    #0, BR_DRIVE, BR_SHORT, BR_COAST, BR_BRAKE, BR_PROBE

    ' PL-132: the stop latched in e_stop, which the driver reads by kind (estopBridge)
    '  ES_OFF     - no stop latched
    '  ES_HARD    - an emergency stop: the phases shorted, whatever the stop mode (emergencyCutoff(), the walk guard)
    '  ES_PROTECT - a protective stop (frontProtectiveStop()): the stop mode's state at once, SM_FLOAT coasts
    #0, ES_OFF, ES_HARD, ES_PROTECT

    ' R19.4: which phase the continuity probe drives (probe_phase)
    #0, PRB_NONE, PRB_U, PRB_V, PRB_W

    ' TEST USE (task 3613): which two hall-code bits testSetHallSwap() makes the driver read as swapped
    #0, HSW_NONE, HSW_HALLS_01, HSW_HALLS_12, HSW_HALLS_02

    ' R19.3 (task 3609): the response to a position fault (|err| >= 125 while driven), setFaultResponse(); the FR_*
    '  enum is in the public constants (R20.1), its values unchanged: the PASM compares #FR_GRADED
    FAULT_RESPONSE_DEFAULT      = FR_GRADED     ' STEPHEN 2026-09-25 "yes A" (plan R20.1 (1)), on the right wheel's fault
                                            '  cells certifying: they did at Visit 10 pass 5 (BLUNT, GRADED, GRD100, RESYNC)
    BRAKE_PCT_DEFAULT           = 10            ' BR_BRAKE's shorted time, % of each brake period. SIZED at Visit 10 (left, 80 x 10^6,
                                            '  second fault to rest): coast 518 ms / 52 ticks, 10 % 282 / 22, 25 % 84 / 7, 50 % 16 / 2,
                                            '  100 % 10 / 1. 10 % is the gentlest step measured that still halves the coast; torque
                                            '  rises faster than the % because the 10 ms slice is near the winding's L/R
    BRAKE_PERIOD_MS             = 10            ' PROVISIONAL: BR_BRAKE's period, several winding L/R (unmeasured, U-3)
    BRAKE_PERIOD_FRAMES         = PWM_RATE_IN_HZ * BRAKE_PERIOD_MS / 1_000  ' 440 PWM frames at 44 kHz

    ' PL-90: the hall read. The three hall inputs (base+5..7) never straddle the pin-31 port boundary for any legal
    '  base, so ONE read of INA or INB samples all three at the same instant (was three TESTPs, 4 clocks apart).
    REG_INA          = $1FE     ' cog register addresses of the two input ports (p2kb: INA $1FE, INB $1FF), for ALTS
    REG_INB          = $1FF
    PORT_PIN_MASK    = 31       ' a pin's bit within its 32-pin port
    PORT_B_BIT       = 5        ' pin bit 5 set: the pin is in port B (32..63)
    HALL_PIN_SPAN    = 2        ' addpins operand: the three hall inputs
    ' WRPIN %FFF (bits 23:21) = %101: the pin's input is low-pass filtered by the global filt1 before it reaches IN
    '  (p2kbArchSmartPins, input_logic_and_filtering). filt1's reset default is 3 flip-flops clocked every 32nd clock:
    '  a level must hold ~96 clocks (0.48 us at 200 MHz, 0.32 us at 300) to be seen, against >= 2 ms between hall
    '  edges at top speed. Smart-pin mode stays %00000 and DIR stays low: the pins are still plain inputs.
    HALL_IN_FILT1    = %101 << 21
    ' hall_illegal_ holds two saturating 16-bit counts (ALTGW/ALTSW word index): entries into %000 in the low word,
    '  into %111 in the high word, so a dead line (%000) is told from a stuck-high one (%111) with the ABI unchanged
    HALL_ILL_LO_WORD = 0
    HALL_ILL_HI_WORD = 1
    HALL_ILL_WORD_MAX = $FFFF

'44KHz seems to be sweetspot for DocoEng Motor
'    FRAME   = 6_136             ' 44.00 KHz: (---) 1 ADC sample = 1 PWM frame, divide by two for triangle PWM
'22KHz EXPERIMENT
'    FRAME   = 12_273            ' 22.00 KHz: (---) 1 ADC sample = 1 PWM frame, divide by two for triangle PWM
    PWM_RATE_IN_HZ   = 44_000
    DRIVE_PASS_FRAMES   = 23        ' PL-50/C-1: one drive pass every 23 PWM (ADC) frames, about 1913 passes/s
    HALL_TICKS_PER_CYCLE = 6        ' hall ticks in one electrical cycle, the driver's 2^32 field angle

    DRVR_LAUNCH_LONGS_COUNT     = 4         ' pinbase, params_ptr, targetAngle, targetIncre
    DRVR_STATUS_LONGS_COUNT     = 24        ' drive_u .. drv_stop_fp (R20.1 added foldback_frames, PL-160 drv_accel_now, PL-161
                                            '  drv_stop_passes and drv_stop_fp), then fault
    ' PL-161 (DRIVER_REV 39): each appended status long's index in the run (drive_u is 0), for a reader of the raw run
    '  (a bench harness): drv_accel_now is NO LONGER the run's last long
    DRVR_STATUS_ACCEL_NOW_IDX   = 21        ' drv_accel_now, the generator's acceleration
    DRVR_STATUS_STOP_PASSES_IDX = 22        ' drv_stop_passes, the driver's stop plan: drive passes to rest
    DRVR_STATUS_STOP_FP_IDX     = 23        ' drv_stop_fp, the driver's stop plan: field travel to rest, 1/256 hall tick
    DRVR_PARAMS_LONGS_COUNT     = 27        ' offset_fwd .. sense_zero (PL-138 appended drv_release, PL-146 sense_zero)

    ' PL-138 (W4): the driver's release, which stop() asks for before its cogstop (driverRelease, stop())
    RELEASE_WAIT_FRAMES         = 2         ' PWM frames the release holds the bridge COASTING before it drops the gate modes
    RELEASE_TIMEOUT_MARGIN      = 3         ' how many times the worst case stop() waits for DCS_RELEASED before it cogstops anyway
    ' The worst case: the driver tests drv_release once per drive pass (DRIVE_PASS_FRAMES), then holds the coast
    '  RELEASE_WAIT_FRAMES; (23 + 2) frames at 44 kHz = 568 us, so the bound is 1_704 us
    RELEASE_TIMEOUT_US          = (DRIVE_PASS_FRAMES + RELEASE_WAIT_FRAMES) * 1_000_000 / PWM_RATE_IN_HZ * RELEASE_TIMEOUT_MARGIN
    DRV_PIN_SPAN                = 13        ' addpins operand: base+0..13, every pin the driver configures (its all_pins)

    ' The driver's identity for bench logs: a harness prints it in its banner, so a log shows WHICH driver
    '  ran, not only which harness. Hand-bumped whenever this file's behaviour changes -- the PASM, or any
    '  Spin2 the drive depends on -- and never for a comment. First set 2026-09-22 (task 3594).
    DRIVER_REV                  = 42      ' 2: R18.4 -- feedforward + trim servo, every command taken, hold decay, dynamic lead
                                            ' 3: the hold decay stops at ramp_min_, so a stall keeps the lag the protective stop needs
                                            ' 4: the lead table filled from Visit 8 (task 3601); the legacy build keeps its fixed pair
                                            ' 5: the feedforward scale is the motor's back-EMF line, not the speed ceiling (task 3603)
                                            ' 6: the feedforward's slope is held when duty_max moves; the DUTY_MAX_SVM build variant (task 3604)
                                            ' 7: the clip-free duty ceiling is the drive; the 6.5in ceilings 12 % higher, the floor 5.4x lower (task 3605)
                                            ' 8: the hold at rest follows the load, then hands off to the phase short and reports it (task 3608)
                                            ' 9: a selectable fault response: re-sync from the halls and stop, or the graded short BR_BRAKE (task 3609)
                                            ' 10: start-time checks (BR_PROBE lead check, halls, sense zero), getHealth(), checkWiring() (task 3610)
                                            ' 11: the optional pack voltage sensor, getPackVoltage() (task 3611)
                                            ' 12: a re-synced stop stays pending until rest, so a second fault takes the fallback; testForceFault()
                                            ' 13: test-only negatives for the start checks: testSetProbeWithhold(), testSetHallSwap() (task 3613)
                                            ' 14: DCS_FAULTED is a latch: only a commanded stop or drive clears it, never a zero already standing (task 3616)
                                            ' 15: a wiring-walk leg is shorted and fails once its current passes WALK_I_LIMIT_MV (PL-122, task 3618)
                                            ' 16: the Rev B rest-zero band sized from Visit 10 (-20/+40 mV); Rev A keeps -100/+200 (task 3613)
                                            ' 17: BR_BRAKE slices the full short over a 10 ms period, no longer a per-frame low-side PWM (PL-129, task 3620)
                                            ' 18: the hold's duty follows its displaced passes, so it reaches the ceiling in riseMs, not 16 % later (PL-130)
                                            ' 19: a re-synced fault seeds the field in the way it was moving, not the command's sign (task 3609)
                                            ' 20: a protective stop takes the stop mode's state at once (SM_FLOAT coasts); only an e-stop always shorts (PL-132)
                                            ' 21: TEST-USE winding check at start: probe_sink/probe_y (params run 25 longs), testGetWinding() (task 3610)
                                            ' 22: BRAKE_PCT_DEFAULT sized to 10 from Visit 10's graded chain (task 3613)
                                            ' 23: R20.1 -- the fold-back counter (status run 21 longs, foldback_frames), stop reasons,
                                            '     the event log, start() refuses a check still failing after its retries (task 3621)
                                            ' 24: PL-137 -- each wiring-walk leg keeps its own record (testGetWalkLeg()); REQ_WALK's
                                            '     arg1 names the leg, its stop is always WALK_TICKS (task 3610). No PASM change
                                            ' 25: R20.4 -- the winding check computes with the pack sensor's own averaged reading
                                            '     when it reads a pack, else the nominal (testGetWindingVoltage()); testGetPackRaw()
                                            '     for the sensor's calibration; the sensor pin is refused inside ANY claimed motor
                                            '     pin group, not only this motor's own (task 3611). No PASM change
                                            ' 26: PL-137 fix -- isWalkWatched(), so the steering path limiter stays out of a
                                            '     wiring walk and each wheel's verdict is its own (task 3610). No PASM change
                                            ' 27: PL-138 part 1 -- every gate is held OFF through the sense calibration and
                                            '     the ATN park (low sides mode 0 driven low; high sides pwmt in reset), and
                                            '     the low sides take pwmn in driveinit's unbroken run to the DIR raise, so
                                            '     the all-low-sides short shrinks from calibration + park to ~20 clocks
                                            '     (task 3623). PASM (LUT) change; no ABI change
                                            ' 28: PL-141 -- frontShortfall() also returns bCommanded, and a path-scaled
                                            '     command is never below ramp_min, so a scaled wheel cannot read at rest or
                                            '     zero the blocked test's target; the steering limiter engages only for a
                                            '     wheel behind its partner (task 3622). No PASM change
                                            ' 29: PL-138 part 2 -- stop() asks the driver to release (drv_release, params
                                            '     run 26 longs) and waits, bounded, for DCS_RELEASED before its cogstop: the
                                            '     bridge coasts two frames, then every gate pin is plain and driven OFF, so
                                            '     the cogstop no longer cuts a driving bridge (W4) or leaves the low sides
                                            '     in pwmn with DIR low (W3); pinclear right after the cogstop as the
                                            '     backstop (task 3623). PASM (cog + LUT) and ABI change
                                            ' 30: Visit 10 pass 6 -- the following percentage is of the user's command, not the
                                            '     path-scaled one (R18-DUAL-NOTFOL-D); the steering limiter releases only once
                                            '     both fields reach the present scale, so it no longer hunts (PL-144). No PASM change
                                            ' 31: FR_GRADED is the default fault response (Stephen's R20.1 ruling, its condition met
                                            '     at Visit 10 pass 5). No PASM change
                                            ' 32: the command timeout watches every drive, driveForDistance() included (PL-143,
                                            '     Stephen: no carve-outs). No PASM change
                                            ' 33: the public-API audit's release items. PL-153: the odometer is total travel,
                                            '     reset only by resetTracking() and start() (no longer by a fault, an e-stop, a
                                            '     walk or a steering distance move), and every distance or rotation limit counts
                                            '     from its own arming (trkTravelTicks, limitBaseTicks). PL-155: max speeds, the
                                            '     stop mode and the reversal are kept across start() and may be set before it,
                                            '     with getters (isHoldAtStop(), setForwardIsReverse(), isForwardReversed(),
                                            '     getCommandTimeout()). PL-156: isMoveDone(). PL-158: DS_HOLDING only while the
                                            '     hold holds; DRU_DEGREES limits round. PL-159: calibrate() returns
                                            '     ERR_NOT_IMPLEMENTED. No PASM change; no ABI change (the new longs are Spin2-only)
                                            ' 34: THE KICK (PL-78, PL-87, PL-95): the drive pass on which a ramp arrives at a
                                            '     non-zero target advances the field like every AT_SPEED pass, instead of
                                            '     skipping its increment (.endRUpAtSpeed, .endRDnAtTgt jump to .justIncr).
                                            '     PASM change (two jump targets, no instruction added); no ABI change
                                            ' 35: PL-160 (user half) -- setDeceleration() sets ramp_down in mm/s^2
                                            '     [DECEL_MIN_MM_S2..DECEL_MAX_MM_S2], with getAcceleration() and
                                            '     getDeceleration(); setAcceleration(), setDeceleration() and
                                            '     setRampingValues() are kept across start() and may be set before it (the
                                            '     last ramp call wins); the built-in ramp is unchanged until one is called.
                                            '     No PASM change; no ABI change (the new longs are Spin2-only)
                                            ' 36: Visit 10 pass 7. PL-146: the per-frame current fold-back (and its
                                            '     foldback_frames count) acts only while the bridge is driven (BR_DRIVE); an
                                            '     undriven bridge's rest offset no longer counts fold-back frames forever.
                                            '     PASM change (one TJNZ and one label in .noFault); no ABI change. PL-161:
                                            '     the front cog reads the pack pin inline each pass and only sums it; the sum
                                            '     is folded in once per WINDOW_PASSES passes (PACK_PHASE, frontSamplePack()),
                                            '     the average kept in raw counts and converted only when read; the steering
                                            '     front cog's state report runs only when its debug channels compile, once
                                            '     a slot, and it spends no bounded driver wait on a slot-work pass
                                            ' 37: PL-161 residual -- no front cog pass waits on a driver: a request that needs
                                            '     its driver(s) to act (a synchronized drive's take, a fault clear, an e-stop's
                                            '     release) is held in flight across passes and answered on the pass that sees
                                            '     it done, or its FRONT_SYNC_WAIT_PASSES bound gone (single-motor and steering
                                            '     front cogs alike; statuses unchanged). PL-146 residual -- the fold-back
                                            '     compares the DC-link reading net of the rest offset, floored at 0 (sense_zero,
                                            '     params run 27 longs; countIllegal moved to the LUT to pay for it). PASM (cog +
                                            '     LUT) and ABI change
                                            ' 38: PL-160 -- the jerk-limited trajectory generator (jerkStep, LUT): every
                                            '     speed change, start, stop and reversal ramps its acceleration in and out
                                            '     at a limited jerk and lands exactly on its target; the reversal passes
                                            '     through zero without a stop. The four ramp longs are reused in place as
                                            '     accel_up / accel_dn / jerk_up / jerk_dn (params run still 27 longs);
                                            '     drv_accel_now appended to the status run (22 longs, fault after it);
                                            '     built-in rates 1_000 / 1_470 mm/s^2, tau 250 ms; the stop prediction is
                                            '     the generator's closed form (stopPlan()). The fold-back folds only above
                                            '     its threshold's integer count (was at or above a truncated one, which on
                                            '     Rev A under ~2.7 A folded every driven frame). PASM (cog + LUT) and ABI change
                                            ' 39: PL-161 -- the DRIVER plans its own stop, so no front cog computes one:
                                            '     after each drive pass, on the next nine frames' slack (planStage, a
                                            '     third of a plan a frame, to fit 160 MHz), it runs the stop's closed
                                            '     form in integers (planA .. planC: 64-bit sums, QSQRT roots, no float)
                                            '     from the pass's (v, a) and from both ends of the take pass's reachable
                                            '     accelerations (a -/+ Jx: any command, any lag gate), and publishes the
                                            '     largest passes and travel as drv_stop_passes / drv_stop_fp (status
                                            '     run 24 longs, fault
                                            '     after them; DRVR_STATUS_*_IDX). frontStopMs() / frontStopTicks() and
                                            '     bFrontStopMsReaches() / bFrontStopTicksReaches() only read them; the
                                            '     Spin2 stopPlan() and its helpers are gone. x*(E) moved out of jerkStep
                                            '     into xStar, unchanged; the planner's core is a LUT overlay loaded over
                                            '     the spent start sequence (loadOverlay, planCodePtr). PASM (cog + LUT)
                                            '     and ABI change
                                            ' 40: the wiring walk's pass band re-derived for the jerk-limited ramp and
                                            '     the driver's stop plan: a leg passes at WALK_TICKS - WALK_SHORT_TICKS (3)
                                            '     .. WALK_TICKS + WALK_OVERSHOOT_TICKS (5, was 3), i.e. 3 .. 11 ticks (was
                                            '     6 .. 9). At 11.1 V and up the plan now fires a leg's limit ~196 ms in,
                                            '     before the rotor's running lag has built, so a correct leg could rest
                                            '     at 5 and fail HLT_WIRING. Derivation at WALK_SHORT_TICKS. The walk
                                            '     also runs on the built-in ramp whatever the program set (walkRamps(),
                                            '     both objects), the kept ramp put back as it ends: at
                                            '     setAcceleration(1) a leg's limit fired ~8.3 s in, past
                                            '     WALK_LEG_TIMEOUT_MS, and a correct motor failed HLT_WIRING (since
                                            '     DRIVER_REV 35). And PL-163's residual: the fold-back's duty floor is
                                            '     raised (setFoldLimit()) so its threshold is never under FOLD_MIN_MV
                                            '     (4 mV); a Rev A limit of 1 .. 10 A no longer folds on noise at the
                                            '     floor, Rev B and the 27 / 40 A limits are unchanged. Then three
                                            '     fixes by construction. (a) The ramp has ONE WRITER: only the front
                                            '     cog serving the motor runs applyRamps() once the driver runs
                                            '     (frontApplyRamps(), on the passes (d) gives it); the setters
                                            '     and walkRamps() write their inputs, raise bRampsStale and wait,
                                            '     bounded, for the apply (requestRamps()), a start only raises it
                                            '     (applyStartSettings()), so a setter on another
                                            '     cog can no longer interleave with the walk's restore and leave the
                                            '     built-in ramp in force. (b) The walk's current guard is set in amps,
                                            '     WALK_I_LIMIT_MA (1 A, PL-122's own derivation), on each board's sense
                                            '     scale (walkGuardMv): 150 mV on Rev B as before, 5 mV on Rev A, where
                                            '     150 mV was 30 A and never acted. (c) The rest zero is the offset, not
                                            '     the truncated mean of floored readings (0.5 .. 1.5 mV low): mean + 0.5,
                                            '     rounded (restZeroFinish()), and the derate average adds back each
                                            '     reading's half count. FOLD_MIN_MV re-derived on it: still 4. The
                                            '     residuals, by construction. (d) PL-161's pass budget: at most ONE
                                            '     motor's ramp apply a front pass, only on an odd phase, which no slot
                                            '     job uses (RAMP_PHASE_BIT; the steering cog alternates wheels,
                                            '     RAMP_WHEEL_BIT), and no request applies one: a walk leg is posted
                                            '     only once walkRamps(TRUE) has seen the built-in ramp in force
                                            '     (NO_ERROR, else checkWiring() walks nothing, ERR_NO_RESPONSE). The
                                            '     apply does no float: the built-in steps are init()'s (rampBuiltinUp,
                                            '     rampBuiltinDn), so it is at most five calls and two MULDIV64 (was two
                                            '     builtinStep() chains, 26 float operations). A setter's wait is at
                                            '     most 4 passes, inside REQ_ACK_TIMEOUT_MS. (e) getCurrent() (and the
                                            '     HDMI current) adds the reading's half count, as the derate does, so
                                            '     it reads 0 +/-0.5 mV at rest (was 0 .. +1 mV); the winding check's net
                                            '     mean is the rest zero's own estimate (unbiasedMeanMv(), was
                                            '     truncated), and its trip is r >= limit (was r > limit, a count
                                            '     late); the walk guard's r >= guard was already exact.
                                            '     testGetWalkGuardMv() for a bench criterion. (f) The rest-zero bands
                                            '     are derived from the INA180's and the P2 ADC's figures, no longer
                                            '     fitted or guessed (see REST_ZERO_MIN_MV): Rev B -17 .. 36 mV (was
                                            '     -20 .. 40), Rev A -17 .. 17 mV (was -100 .. 200). No PASM change; no
                                            '     ABI change
                                            ' 41: memory reduction WP1 (DOCs/plans/PASM-MEMORY-REDUCTION-PLAN.md, C1):
                                            '     the 21 cog longs dead once the start sequence has run (the entry
                                            '     code, loadOverlay, all_pins, pwmt, pwmn, fram, numerator,
                                            '     sync_required, lutCodePtr, planCodePtr, adc_modes, calibPeriod) are
                                            '     also the homes of 21 registers only the drive loop uses (pl_v .. sp_F,
                                            '     jrk_e .. jrk_lim), and the register block is 21 longs shorter: cog
                                            '     492 -> 471 of 496; LUT 507 and the overlay's 126 unchanged. No
                                            '     instruction changes but one: the first drive pass read err_ before
                                            '     any frame had written it (COGINIT's copy of the hub bytes after the
                                            '     image; with a command pending, the lag gate and LAG_HOLD acted on
                                            '     it), and the start sequence now zeroes it, in the long of a dead
                                            '     store (mov sv_tgt_incr, #0). Proved equivalent to mem-reduce-start by
                                            '     tools/pasm_equiv (2055 scenarios); PASM (cog) change; no ABI change
                                            ' 42: memory reduction WP2 (C2): the LUT holds a START IMAGE (the start
                                            '     sequence and driveinit, 144 longs) until loadOverlay, then a RUN
                                            '     IMAGE loaded over it (every routine used only once the drive loop
                                            '     runs, gettgtincr .. planStage and the stop planner's core, 476
                                            '     longs; planCodePtr now points at runCodeStart). countIllegal, which
                                            '     both call, is back in cog RAM. Cog 471 -> 484 of 496; LUT 507 ->
                                            '     476 of 512; the planner's separate 126-long overlay is gone. No
                                            '     instruction changes, only relocation; the one-time load at start
                                            '     grows by 350 longs. Proved equivalent to mem-reduce-start by
                                            '     tools/pasm_equiv (2055 scenarios); PASM (cog + LUT) change; no ABI
                                            '     change

    ' The duty ceiling init() derives (LIMITS-RESET-PLAN.md E2; tasks 3604, 3605)
    SVM_GUARD_COUNTS            = 4         ' PWM counts kept clear of each rail for the CORDIC's rounding and the floored centring
    SVM_INV_ROOT3_PPM           = 577_350   ' 1 / sqrt(3), parts per million
    PPM                         = 1_000_000

    ' C-5 (DOCs/plans/CURRENT-LIMIT-AND-STOP-DESIGN.md section 3.2): lag thresholds, err_ units (256 per hall cycle)
    LAG_SOFT                    = 80        ' 112.5 deg: the ramp waits for the rotor; the PL-55 duty ceiling lifts
    LAG_HOLD                    = 100       ' 140.6 deg: the field stops advancing (the fault test is at 125)
    ' R18.4 (DOCs/plans/DRIVE-INTEGRATION-DESIGN.md section 5.3): the duty the drive applies is a FEEDFORWARD
    '  from the field's speed (D-1) plus an integral TRIM (D-2). Each frame the trim adds
    '  (|err_| - SERVO_SETPOINT) * (duty_ >> SERVO_DUTY_PRESHIFT) to its accumulator, and
    '  duty_ = duty_ff + (accumulator SAR SERVO_ACC_SHIFT): 1/32 duty per count per frame at duty 8192.
    '  Symmetric and untruncated, so it holds a point; scaled by duty, so its gain follows the stiffness
    '  the rotor has. The servo it replaces held a 21-degree band and hunted at low speed (PL-101, 5.2).
    SERVO_SETPOINT              = 48        ' 67.5 deg: where the old servo settled at every running rung; the
                                            '  LEAD is carried by the offsets, never by moving this (D-3)
    SERVO_DUTY_PRESHIFT         = 4         ' duty_ >> 4 fits MULS's 16 bits and keeps the accumulator in 32
    SERVO_ACC_SHIFT             = 14        ' the trim's gain (init() loads servo_shift from it)
    HOLD_DECAY_SHIFT            = 6         ' D-5: a held pass takes 1/64 off drv_incr, a 33 ms time constant
    SHORT_SLOTS                 = 4         ' D-6: a motor held in any of the last 4 slots (32 ms) is SHORT
    ' R19.1 (task 3608): the hold at rest in SM_BRAKE. The field stays at the stop angle, a spring whose restoring
    '  torque grows with the rotor's displacement; the front cog raises the duty while the hall position is off
    '  the hold position, up to a ceiling, and falls back to the phase short on a slip or after the time limit.
    '  PROVISIONAL values, each settable (setHoldLimits(); its maxima are public), and SIZED UNLOADED (wheels up):
    '  the floor run (R19.8) sizes them under a load.
    HOLD_CEILING_PCT            = 10        ' the hold's duty ceiling, % of duty_max
    HOLD_RISE_MS                = 250       ' ms from duty_min to the ceiling while the wheel stays displaced
    HOLD_SLIP_TICKS             = 2         ' hall ticks off the hold position that count as a slip: 120 deg electrical,
                                            '  a physical margin below the pole slip (the driver's fault test trips near 3)
    HOLD_LIMIT_MS               = 10_000    ' ms at the ceiling before the hold hands off to the phase short
    ' R19.4 (task 3610): the start-time checks (runStartChecks()). PROVISIONAL bands; Visit 10's B-2 and B-3 size them.
    ' The rest-zero bands (HLT_SENSE_ZERO), DERIVED from component data, never from readings (DRIVER_REV 40). A band is
    '  the zero-current readings a HEALTHY chain can reach, plus the estimate's own error. restZeroSenseMv is taken with
    '  the bridge floated, so the shunt carries only MOSFET leakage (uA; 1 mA would be 0.15 mV on Rev B): 0 A.
    '  Sources: TI INA180 datasheet SBOS741H (Jul 2022, ti.com/lit/ds/symlink/ina180.pdf), 7.5 Electrical
    '  Characteristics (TA = 25 C, VS = 5 V) and 8.3.4 Rail-to-Rail Output Swing; P2KB P2AN001 (gotchas); vendor
    '  64010 manuals (BOARD-REVISION-FACTS.md 1.2: Rev A 5 mOhm to the pin, no amplifier; Rev B 3 mOhm x INA180B2,
    '  gain 50 V/V).
    '  (1) INA180 at 0 A, low side (VIN+ = 0 V), referred to input: VOS <= 150 uV (VIN+ = 0 V row), drift <= 1 uV/C
    '      over its -40..125 C span, <= 100 uV from 25 C, PSRR <= 40 uV/V (the board's amp supply is not in the
    '      vendor text, so the part's whole 2.7..5.5 V range, <= 2.3 V from the 5 V test point, <= 92 uV): <= 342
    '      uV; x 50 x (1 + 1% gain error) = 17.3 mV at most. 8.3.4: a positive offset sets the output to offset x
    '      gain, or the swing to GND (VSN, 5 mV max) if larger; a negative one leaves it at that swing, which is at
    '      or above GND. So a healthy Rev B amp outputs 0 .. 17.3 mV at 0 A. Rev A has no amplifier: 0 mV.
    '  (2) Scale: the reading is ratiometric, 3300 x (pin - GIO) / (VIO - GIO), so VIO's error scales only the
    '      pin's own voltage. No VIO tolerance is sourced; 10% is assumed as a conservative bound: <= 1.8 mV on
    '      17.3 mV, 0 on Rev A's 0 mV.
    '  (3) P2 ADC offset at the pin: NO SPECIFICATION exists (the P2 datasheet gives none). P2AN001 carries two
    '      figures, neither a spec: <= 9 mV absolute error, hardware-verified on one pin with the same GIO/VIO
    '      method, positive at low volts; and a ~15 mV pin-to-pin spread, a designer report not yet reproduced.
    '      The wider, 15 mV, is taken in BOTH signs, so the band does not rest on the sign of either.
    '  (4) The estimate: each reading is floored to 1 mV (a count is >= 0.54 mV) and unbiasedMeanMv() returns
    '      floor(mean) + 1: +-1 mV whether or not the noise dithers the floor. The allowance for the mean of
    '      REST_ZERO_SAMPLE_COUNT = 200 readings: +-1 mV, over 8 standard errors (sigma <= 1.73 mV for the +-3 mV
    '      per-frame noise, FOLD_MIN_MV's note; standard error <= 0.12 mV).
    '  Rev B: low 0 - 15 - 1 - 1 = -17 mV; high 17.3 + 1.8 + 15 + 1 + 1 = 36.1 mV, so 36 (the zero is a whole mV).
    '  Rev A: +-(15 + 1 + 1) = +-17 mV.
    '  THE NEGATIVE: what an unhealthy chain reads, all far outside: an open lead to the pin leaves it floating, and
    '  the ADC reads its floating bias point, ~VIO / 2 = ~1650 mV (P2KB, P_ADC, EF-024); an amp output stuck or
    '  shorted high, or a rail stuck high, reads at least VS - 30 mV (VSP), 2670 mV at VS = 2.7 V, clamped to the
    '  3300 mV of VIO above that. NOT excluded, by construction: an amp output shorted to GND, an unpowered amp, or
    '  a Rev A sense node shorted to GND all read ~0, which IS the healthy zero of a one-direction low-side sense;
    '  no rest-zero band can tell them apart, only a driven current can.
    '  CONSISTENCY (not a source): Visit 10's Rev B zeros, left 6.4-9.4 mV, right -0.3-3.1 mV (the manual), read
    '  at most 1 mV higher as DRIVER_REV 40's zero (<= 10.4 mV); all inside -17 .. 36. No Rev A zero is measured.
    REST_ZERO_MIN_MV            = -17       ' Rev B (150 mV/A): the rest zero must lie in this band (derived above)
    REST_ZERO_MAX_MV            = 36        '  (was -20 .. 40, fitted to Visit 10's readings)
    REST_ZERO_MIN_MV_REVA       = -17       ' Rev A (5 mV/A, no amplifier): the band (derived above)
    REST_ZERO_MAX_MV_REVA       = 17        '  (was -100 .. 200, a provisional guess)
    PROBE_SETTLE_MS             = 5         ' ms the probe holds a phase before its readings are taken
    PROBE_SAMPLES               = 4         ' readings averaged per probe, 1 ms apart
    ' R20.1 (task 3621): start() re-checks a failed check before it refuses (setStartChecks()). A retry re-runs only the
    '  refusing checks still failing, in the same driver lifetime: the three lead probes (~40 ms), the hall code with no
    '  new illegal code during the gap, and the rest zero re-captured (~1 s). Worst added time, only on a failure:
    '  START_CHECK_RETRIES x (START_CHECK_RETRY_MS + 1_000 + 40) ms, about 3.9 s per motor.
    START_CHECKS_REFUSE         = HLT_ALL_CHECKS    ' the checks whose failure refuses the start; not HLT_WIRING, not HLT_PACK
    HLT_PHASES                  = HLT_PHASE_U | HLT_PHASE_V | HLT_PHASE_W       ' the three bits one probe of the leads judges
    START_CHECK_RETRIES         = 3         ' PROVISIONAL (Stephen, "provisional 3"): up to 4 attempts; the bench sizes it
    START_CHECK_RETRY_MS        = 250       ' PROVISIONAL: the gap before each retry, so a transient can pass
    ' R20.1 (task 3621): the soft-event log (getEvent()). A ring of EV_QUEUE_DEPTH + 1 slots: the one slot the front cog
    '  may be rewriting is never one a reader within EV_QUEUE_DEPTH of the head can be copying, so a torn copy is detected.
    EV_RING_SLOTS               = EV_QUEUE_DEPTH + 1
    EV_KINDS_COUNTED            = EV_FOLDBACK - EV_STOP + 1     ' getEventTotal(): EV_STOP .. EV_FOLDBACK; EV_NONE and EV_LOST have none
    EV_RATE_GAP_MS              = 1_000     ' PROVISIONAL: the least gap between two rate-limited events of one kind, ms
    EV_START_ATTEMPT_SHIFT      = 8         ' EV_CHECK_RETRY's value: the recovered HLT_* bits | attempts << this
    ' R19.4 1e (task 3610), TEST-USE: the winding check (testSetWindingProbe()). One phase switches at WIND_DUTY_PCT with
    '  the next phase's low side ON, so a steady current I flows through that pair and returns through the DC-link
    '  shunt for the high side's on-time. The shunt's frame average is then I_dc = d x I and I = d x V / R, so
    '  R = d^2 x V / I_dc from today's per-frame reading -- no sub-frame sampling. It moves the rotor to that pair's
    '  alignment (up to half an electrical cycle), which is why it is opt-in.
    WIND_DUTY_PCT               = 5         ' PROVISIONAL: the pair's duty; about 3 A through 0.3 ohm on 18.5 V
    WIND_SETTLE_MS              = 100       ' PROVISIONAL: ms before readings are taken: the rotor's turn to the pair, and L/R
    WIND_STILL_MS               = 30        ' PROVISIONAL: and the halls unchanged this long, so no back-EMF biases a reading
    WIND_SETTLE_MAX_MS          = 300       ' PROVISIONAL: the bound; a pair still turning then reads WND_UNSETTLED. Two wheels'
                                            '  starts run back to back in one steering start(): 2 x 3 x 305 ms stays inside a 4 s stall watchdog
    WIND_SAMPLES                = 8         ' readings averaged per pair, 1 ms apart
    WIND_I_LIMIT_MA             = 400       ' PROVISIONAL: the net DC-link mA that ends a pair at once (~8 A of phase at 5 %; 60 mV on Rev B)
    WIND_MIN_VISIBLE_MA         = 20        ' PROVISIONAL: a net reading under this is NOT_VISIBLE (no current path), never a value
    WIND_MIN_RSENSE             = 50        ' mV per A: a coarser sense scale (Rev A, 5) cannot resolve the pair or guard it, so no pair is driven

    ' R19.4 1e: a winding pair's reading (testGetWinding())
    '  WND_NOT_RUN     - no start has measured it (testSetWindingProbe() was not set)
    '  WND_MEASURED    - nMilliOhms holds the pair's resistance
    '  WND_NOT_VISIBLE - the pair drew under WIND_MIN_VISIBLE_MA (an open lead, a dead switch, a withheld phase), or the
    '                    board's sense scale is under WIND_MIN_RSENSE and the pair was not driven
    '  WND_TRIPPED     - the pair passed WIND_I_LIMIT_MA and was ended: far less resistance than a winding should have
    '  WND_UNSETTLED   - the rotor was still turning (a hall change) when WIND_SETTLE_MAX_MS ran out: its back-EMF
    '                    would bias the reading, so none was taken
    #0, WND_NOT_RUN, WND_MEASURED, WND_NOT_VISIBLE, WND_TRIPPED, WND_UNSETTLED
    CONT_MIN_DRIVEN_MV          = 200       ' the driven phase must read at least this (a dead high side does not)
    CONT_FOLLOW_PCT             = 50        ' an undriven phase follows when it reads at least this % of the driven one
    WALK_TICKS                  = HALL_TICKS_PER_CYCLE  ' checkWiring(): one electrical cycle each way
    WALK_POWER                  = 10        ' PROVISIONAL: the power each leg drives at; Visit 10's B-5 sizes it
    ' A leg passes when its rotor rests WALK_TICKS - WALK_SHORT_TICKS .. WALK_TICKS + WALK_OVERSHOOT_TICKS from where it
    '  started (bJudgeWalk()). DRIVER_REV 40: DERIVED, not fitted. The old band, WALK_TICKS .. +3, assumed the leg's
    '  limit fires late in the leg, when the rotor already trails the field by its running lag, so the lag it trails
    '  by at rest is the same. Under DRIVER_REV 38/39 that no longer holds. At 11.1 V and up, the jerk-limited stop
    '  from the leg's rising ramp is itself ~6 ticks, so the plan fires the limit ~196 ms in, after under one tick
    '  of field travel, before that lag has built. (Desk simulation of jerkStep and planStage, built-in ramp 71 /
    '  33_958 / 104 / 49_918, power 10: at 18.5 V the limit fires at trk 0 with the plan 6.00 and the field at rest
    '  6.82 ticks from the seed, 627 ms after the command. At 6.0 and 7.4 V the leg reaches its speed first and fires
    '  at trk 5 and 4.) So the lag's change counts. In the driver's own arithmetic (to err's 1/256-cycle unit): the
    '  field is seeded at err 0 (initAngleFmHall), and each counted tick lowers err by one tick of angle, so count =
    '  F - err (F the field's travel in ticks; err in ticks = err x 6 / 256). The limit fires at trk_f + floor(P) >=
    '  WALK_TICKS. Both step by at most one a front pass at walk speed, so the sum is at most WALK_TICKS + 1. The field
    '  then travels T, in [P - e, P] (e, the plan's over-statement, is at most 0.07 tick at walk speed). So
    '  the rest count R = trk_f + T + err_f - err_e lies in [WALK_TICKS - e + err_f - err_e,
    '  WALK_TICKS + 2 + err_f - err_e). The driver bounds err at both ends. The field advances only while err <
    '  LAG_HOLD, so err <= 100 + one pass's advance (1.3 at 25.9 V) = 2.38 ticks. The premise, not a gate: before and
    '  after the leg the rotor is never a whole sector (one tick) ahead of the field that pulls it, so err > -1 tick.
    '  (Up to -1.5, the torque's zero at 90 deg, gives the same integers.) Then R > 6 - 0.07 - 1 - 2.38 = 2.55, so
    '  R >= 3 (WALK_SHORT_TICKS 3). And R < 6 + 2 + 2.38 + 1 = 11.38, so R <= 11 (WALK_OVERSHOOT_TICKS 5).
    '  What still fails: the reversed direction (the sign), a rotor that does not follow (0, or +-1 rocking in its
    '  sector: under 3), a dead or crossed hall (the hall counts), a stall (the current guard or the fault test), and
    '  a limit that never fires (WALK_LEG_TIMEOUT_MS). The limit's own accuracy is certified elsewhere, not here.
    WALK_SHORT_TICKS            = 3         ' a leg may rest this far short of its limit and still pass (DRIVER_REV 40)
    WALK_OVERSHOOT_TICKS        = 5         ' a leg may rest this far past its limit and still pass (was 3; DRIVER_REV 40)
    WALK_START_MS               = 20        ' ms a leg waits before it looks for the stop, so it does not read the rest it left
    WALK_LEG_TIMEOUT_MS         = 2_000     ' a leg that has not stopped by then fails
    WALK_I_LIMIT_MA             = 1_000     ' PL-122: a leg whose DC-link current, net of the rest zero, reaches this is shorted and
                                            '  fails. Visit 10 pass 2 MEASURED (Rev B, 150 mV/A) healthy legs at 20-21 mV raw left
                                            '  (rest zero 7-9 mV, so ~13 mV net, 0.087 A) and 12-14 mV right; crossed halls 577,
                                            '  3_858 and 594 mV (3.8 A and up, net). ~10x the healthy peak, a quarter of the least
                                            '  miswired one. DRIVER_REV 40: set in AMPS and converted per detected board
                                            '  (walkGuardMv, init()), as the winding check's WIND_I_LIMIT_MA is. Until then it was
                                            '  150 mV on both boards: on Rev A (5 mV/A) that is 30 A, above even the worst crossed
                                            '  leg (25.7 A), so the guard never acted there. On Rev A 1 A is 5 mV, and the sense
                                            '  resolves it: a reading with no current is at most FOLD_MIN_MV's zero-current bound, 3,
                                            '  and a healthy leg's 0.087 A adds 0.43 mV, so a healthy Rev A leg reads at most 4; the
                                            '  least miswired leg (3.8 A) reads 19 mV. The guard is never set under FOLD_MIN_MV + 1.
    WALK_I_LIMIT_MV             = WALK_I_LIMIT_MA * F_REV_B_RSENSE / 1_000   ' Rev B's guard, 150 mV, kept for callers that
                                            '  name it (test_bench_dual's guard cell); the guard in force is walkGuardMv, per board
    ' PL-137 (task 3610), TEST-USE: each wiring-walk leg keeps its own record (testGetWalkLeg()), so a leg that fails
    '  its judgement says how it ended. Which leg (REQ_WALK's arg1):
    '  WLEG_OUT  - the first leg: checkWiring() drives it at +WALK_POWER (isp_steering_2wheel: the left wheel +, the right -)
    '  WLEG_BACK - the second leg, the other way
    #0, WLEG_OUT, WLEG_BACK
    WALK_LEGS                   = WLEG_BACK + 1
    WLEG_NONE                   = -1        ' walkWatchLeg when no leg's position is being watched
    ' How a leg ended (testGetWalkLeg()'s eEnd), judged at the end of checkWiring()'s wait for it, in this order:
    '  WLE_NOT_RUN - not posted, or the post was refused or not answered: every other reading is WALK_NA
    '  WLE_GUARD   - the walk's current guard shorted the leg (PL-122)
    '  WLE_FAULT   - the driver faulted during the leg: DCS_FAULTED, or a fault it re-synced and stopped
    '  WLE_ESTOP   - an emergency or protective stop that was not the guard's (DCS_ESTOP)
    '  WLE_TIMEOUT - the wheel was still moving when WALK_LEG_TIMEOUT_MS ran out
    '  WLE_LIMIT   - at rest (DCS_STOPPED) after its distance limit fired: the healthy ending
    '  WLE_OTHER   - at rest with no limit fired: stopped for the other wheel's fault, or by a program's stop
    #0, WLE_NOT_RUN, WLE_LIMIT, WLE_TIMEOUT, WLE_GUARD, WLE_FAULT, WLE_ESTOP, WLE_OTHER
    WALK_NA                     = NEGX      ' testGetWalkLeg(): a reading that was not taken
    ' R19.5 (task 3611): the pack voltage sensor, VOLTAGE-SENSOR.md. P2AN001's ratiometric method: the pin, GIO and VIO
    '  read through one ADC path, pin mV = (pin - GIO) / (VIO - GIO) x 3300. SINC2 SAMPLING, not filtering: the front
    '  cog reads once a pass and folds the slot's samples in once every WINDOW_PASSES passes (PL-161, on PACK_PHASE), and
    '  sampling mode completes each conversion in hardware (p2kbArchSmartPin11000AdcInternalClock).
    PACK_ADC_X                  = %00_1101  ' SINC2 sampling, a 2^13-clock sample
    PACK_SAMPLE_CLOCKS          = 1 << 13
    PACK_FLUSH_SAMPLES          = 4         ' samples discarded after a source switch (P2AN001: 3), then
    PACK_CAL_SAMPLES            = 8         '  this many averaged (P2AN001: "sum 8 clean")
    PACK_FULL_SCALE_MV          = 3_300     ' VIO - GIO
    PACK_DIVIDER_X100           = 781       ' pack = pin x 7.81: 10.0k / (68.1k + 10.0k), VOLTAGE-SENSOR.md
    PACK_ABSENT_MV              = 1_000     ' a pack under 1 V is no pack: R4 pulls an unplugged sensor to about 0 V
    PACK_AVG_SHIFT              = 3         ' PL-161: the raw average over about 8 slots, each slot the mean of its
                                            '  WINDOW_PASSES samples, one read a pass (8 x 8 ms = 64 ms; exact time constant
                                            '  59.9 ms, plus the slot mean's 4 ms). It was 6 over single samples (64 x 1 ms;
                                            '  63.5 ms). Same samples, same span, so the same noise; folded an eighth as often
    ' R20.4 (task 3611): the winding check's own pack reading (windVoltage()), taken before any front-cog average exists:
    '  this many packRead()s this far apart, the same ~64 ms the front cog's average spans
    PACK_CHECK_READS            = 16
    PACK_CHECK_GAP_MS           = 4
    PERMILLE_FULL               = 1000      ' D-6: a fraction of the commanded rate, in thousandths

    ' S-2 (same design, section 3.4): phase-current limits from the MOSFET both board revisions use, MCAC85N06Y
    '  (DOCs/analyses/BOARD-REVISION-FACTS.md section 1.4). Protection for the board, not a user setting.
    I_PEAK_A                    = 40        ' 0.75 x the package-limited 54 A at Tc 100 C: the driver loop folds back here
    I_CONT_A                    = 27        ' junction <= 125 C at 50 C ambient, 55 C/W: the front cog derates to this
    I_RESTORE_PCT               = 80        ' the peak limit returns once the average falls below this % of I_CONT_A
    CURRENT_AVG_SHIFT           = 10        ' the average's time constant: 2^10 front passes, about 1 s
    PHASE_MA_MAX                = 1_000_000 ' clamp on one pass's phase estimate, so the scaled average cannot overflow
    DUTY_FLOOR_PCT              = 10        ' the phase estimate's modulation floor, m = 0.1
    ' PL-163 (DRIVER_REV 40): the fold-back decides only on a reading the sense chain can resolve. The driver folds on
    '  a whole-mV net reading ABOVE floor(t), t = max(duty, duty_floor) x i_limit_k >> 16. What zero current can read,
    '  net: sense_i_ is one frame's ADC count scaled to mV and FLOORED (sar #11; the count itself is finer, 3300 mV over
    '  at most frame_cnt counts, >= 0.54 mV). Per-frame noise is +-3 mV (CURRENT-LIMIT-AND-STOP-DESIGN.md 3.4, Rev A;
    '  Rev B's rest offset ~8 mV reached its 11 mV threshold on noise alone, PL-146). The netted zero, restZeroSenseMv,
    '  was the TRUNCATED mean of 200 floored readings, 0.5 .. 1.5 mV under the true offset, so at zero current net <
    '  3 + 1.5 = 4.5 mV. RE-DERIVED when restZeroFinish() made the zero the offset itself (DRIVER_REV 40): it is the
    '  mean + 0.5, rounded, so it lies within 0.5 + d of the offset, d the 200-sample mean's own error (sigma <= 1.73
    '  mV for noise spread over +-3 mV, so d's standard error <= 0.12 mV). At zero current a net reading is then at
    '  most floor(3 + 0.5 + d), 3 for d < 0.5. But the fold acts only on a DRIVEN bridge, which always carries some
    '  current: a healthy, unloaded low-duty leg drew 0.087 A (Visit 10 pass 2's walk, ~13 mV net at 150 mV/A), 0.43 mV
    '  on Rev A, so an unloaded driven Rev A wheel reads at most floor(3.93 + d): 3, or 4 once d >= 0.07. So a reading
    '  of 4 or less is still not a measurement of load, and FOLD_MIN_MV stays 4 (a fold needs 5 mV, 1 A of DC link on
    '  Rev A), now with a full count of margin for d (it was 0.07 mV under the truncated zero). 3 would fold an unloaded
    '  wheel on noise, and 5 would give up protection no premise asks for. The derivation's falsifier is T0-27's
    '  PREMISE_NOISE: an unloaded net reading of FOLD_MIN_MV + 1. The walk's current guard is floored at FOLD_MIN_MV + 1
    '  too (walkGuardMv). setFoldLimit() raises the fold's duty floor for a limit whose threshold there is under
    '  it, so t never falls below FOLD_MIN_MV; above that floor t is unchanged. Rev B (150 mV/A: t >= 11 at 1 A) is never
    '  raised, nor Rev A at 11 A and up, so I_PEAK_A and I_CONT_A are untouched on both boards; only a TEST-USE limit of
    '  1 .. 10 A on Rev A is. Why not skip the fold at the floor instead: the fold cannot cut duty below duty_min (m
    '  ~0.065) anyway, but a skipped fold would also ignore a resolvable overload there. What still protects at a raised
    '  floor: the fold itself on any net reading over 4 mV; duty_min, which bounds a stall to m x V / R; the lag gates
    '  (LAG_SOFT, LAG_HOLD, the fault test) and the blocked stop (BLOCKED_PASSES); and the 1 s derate average, which
    '  resolves under 1 mV since it averages.
    FOLD_MIN_MV                 = 4
    BLOCKED_PASSES              = 1_000     ' ~1 s of front passes held at the lag limit without a hall tick

    SYNC_TIMEOUT_MS             = 50        ' SyncStatus() bound: about 100 drive passes, each polling for ATN

    ' PL-32: GIO/VIO calibration averaging (see the DAT driver's start sequence, around the
    ' calibPeriod comment block). adc_modes uses P_ADC_GIO/P_ADC_VIO with P_COUNT_HIGHS -- a
    ' counting mode, not a SINC2 filter -- so only the front-end-settling term of P2AN001's
    ' "discard 3 (2 SINC2 + 1 front-end), then sum 8 clean" strictly applies here. We widen the
    ' smart pin's count period to ADC_CAL_AVG_FRAMES normal frames and take two such widened
    ' reads: the first (still carrying the switch transient, now diluted 1/ADC_CAL_AVG_FRAMES) is
    ' discarded, the second is kept. That is more discard margin than the 1-frame front-end term
    ' calls for, and the same total frame count P2AN001 sums, without a software summing loop --
    ' the `fit` budget at the end of this DAT block has no room for one (see that line's comment).
    ADC_CAL_AVG_FRAMES          = 8         ' widened-period multiple; P2AN001: "sum 8 clean"
    ADC_CAL_AVG_SHIFT           = 3         ' log2(ADC_CAL_AVG_FRAMES): >> 3 instead of a divide

VAR { * Data Structure for PASM Driver * }

  ' remember these are zeroed at run time
    LONG    motorCog                            ' record ID of cog we start (0 = not started)
    LONG    senseCog                            ' record ID of cog we start (0 = not started)

    LONG    maxDrvTics                          ' accumulators for study of driver
    LONG    minDrvTics

    ' -------------------------------------
    ' VALUES passed to driver at startup
    '
    ' / ----------------------------
    LONG    pinbase                             ' 1 long                must set initially
    LONG    params_ptr                          ' 1 long                must set initially
    LONG    targetAngle                         ' 1 long                TEST used during testing
    LONG    targetIncre                         ' 1 long                must set to cause motion
    ' \ ----------------------------

    ' -------------------------------------
    ' VALUES copied from driver each cycle
    ' 24 (DRVR_STATUS_LONGS_COUNT) longs come from driver, the 25th, "fault" also from driver but only when happens
    '
    ' / ----------------------------
    LONG    drive_u, drive_v, drive_w           ' 3 sequential longs    returns data continually
    LONG    sense_u_mV, sense_v_mV, sense_w_mV, sense_i_mV  ' 4 sequential longs    returns data continually
    LONG    hall, pos                           ' 2 sequential longs    returns data continually
    LONG    duty, err                           ' 2 sequential longs    returns data continually
    LONG    loop_ticks                          ' 1 sequential long     returns control loop duration in ticks continually
    LONG    loop_ctcks                          ' 1 sequential long     returns drive loop duration in ticks continually
    LONG    drv_state                           ' enum [DCS_STOPPED, DCS_SPIN_UP, DCS_AT_SPEED, DCS_SPIN_DN, DCS_SLOW_TO_CHG, DCS_FAULTED, DCS_ESTOP, DCS_RELEASED]
    LONG    hall_missed, hall_illegal           ' 2 sequential longs    hall integrity counts since driver start; hall_illegal is %000 << 0 | %111 << 16 (see getHallIllegalCodes())
    LONG    drv_incr_now                        ' 1 sequential long     the field's angle increment per drive pass, for stop timing
    ' R18.1 (PL-95): two UNBOUNDED health counters. `err` and `duty` both top out -- err is held near
    '  LAG_HOLD by the limiter and bounded by its own +-127 representation, duty saturates at duty_max --
    '  so neither says anything once the drive stops keeping up, which is exactly when we need to know.
    '  These count the passes on which each limit ACTED, which has no ceiling. Differenced over a window
    '  (as `pos` is) they give the fraction of time the drive was out of authority; multiplied by
    '  drv_incr_now, lag_held gives the field advance withheld.
    LONG    lag_held                            ' 1 sequential long     passes where the limiter withheld the field advance
    LONG    duty_capped                         ' 1 sequential long     passes where the duty demand exceeded the cap
    LONG    fault_resyncs                       ' 1 sequential long     R19.3: faults answered by a re-sync and a controlled stop since driver start, unbounded
    LONG    foldback_frames                     ' 1 sequential long     R20.1: frames the per-frame current fold-back lowered the duty since driver start, unbounded
    LONG    drv_accel_now                       ' 1 sequential long     PL-160: the generator's acceleration, the signed change of drv_incr_now per drive pass
    LONG    drv_stop_passes                     ' 1 sequential long     PL-161 (DRIVER_REV 39): the driver's stop plan -- drive passes to rest for a stop written now
    LONG    drv_stop_fp                         ' 1 sequential long     PL-161: and the field's travel to rest, 1/256 hall tick (frontStopMs(), frontStopTicks())
    ' \ ----------------------------
    LONG    fault                               ' 1 sequential long     written TRUE ($FFFF_FFFF) on every fault, re-synced or not; see faultResponse

VAR { * Data for Motor Position Tracking * }
    LONG    posTrkHallTicks

    LONG    circInMM_x10

    LONG    prioro8thSecPos

VAR { * HDMI Data for Motor Position Tracking * }
    LONG    tvRpm_x10
    LONG    rpm
    LONG    maxRpm
    LONG    cntsInSec
    LONG    deltaTicks
    LONG    tvMaxRpmIn10ths
    LONG    tvMaxFps_x10
    LONG    tvMaxMPH_x10
    LONG    tvMaxkPH_x10
    LONG    tvMaxMmPerSec_x10
    LONG    tvMaxCntsInSec
    LONG    tvTargetIncreInM
    LONG    tvMaxSenseI
    LONG    tv360rpm_x10
    LONG    tv360rpm
    LONG    tv_mA      'aadddd = xx.dddd A
    LONG    tv_mW     'wwwddd= www.ddd W
    LONG    mmPerSec_x10
    LONG    ftPerSec_x10
    LONG    kmh_x10
    LONG    mph_x10

VAR  {  Motor Parameters  }

' -----------------------------------
' VALUES copied to driver each cycle
' -----------------------------------
' TABLE of 27 (DRVR_PARAMS_LONGS_COUNT) parameters the pasm2 driver reads every cycle, offset_fwd .. sense_zero:
'  append only at the END, and change DRVR_PARAMS_LONGS_COUNT, the PASM register block (offset_fwd_ ..) and
'  isAbiLayoutValid() with it
    LONG    offset_fwd      ' 96 frac 360 (Doug's motor)
    LONG    offset_rev      ' 228 frac 360 (Doug's motor)
    LONG    duty_min        ' was 100 << 4 #> OFFSET << 4 but now runtime loaded
    LONG    duty_max        ' was PWMLIM << 4 <# PWMLIM << 4 but now runtime loaded
    LONG    servo_shift     ' R18.4 D-2: the trim's accumulator shift (SERVO_ACC_SHIFT)
    LONG    ff_ceiling      ' R18.4 D-1: the motor's back-EMF line (task 3603), NOT the speed ceiling; feedforward = |drv_incr| * duty_max / this
    LONG    dead_gap        ' delay between driving h/l side of driver (never drive both at once)
    LONG    accel_dn        ' PL-160: the slow-down acceleration limit, the most drv_incr changes per pass while |drv_incr| falls (was ramp_down)
    LONG    cfg_ctcks      ' # clock ticks of the 500 uSec drive-pass deadline (the pass runs every 23 ADC frames, PL-50)
    LONG    stop_mode       ' control / user setting, enum: [SM_FLOAT, SM_BRAKE]
    LONG    e_stop          ' ES_* (PL-132): ES_OFF, or the kind of stop latched; any other value stops all motor function
    LONG    accel_up        ' PL-160: the speed-up acceleration limit, the most drv_incr changes per pass while |drv_incr| grows (was ramp_max)
    LONG    jerk_up         ' PL-160: the speed-up jerk, the most that acceleration changes per pass (was ramp_min); applyRamps()
    LONG    jerk_dn         ' PL-160: the slow-down jerk (was ramp_inc); applyRamps() derives both from their limits and RAMP_TAU_MS
    LONG    i_limit_k       ' S-2: current-limit threshold factor (currentLimitK()); init() before start, then the front cog only
    LONG    duty_floor      ' S-2: the fold-back's duty floor: m = 0.1, raised so its threshold is never under FOLD_MIN_MV (PL-163, setFoldLimit())
    LONG    hold_duty       ' R19.1: the duty applied at rest (DCS_STOPPED); front-written, duty_min when not holding
    LONG    hold_short      ' R19.1: T/F where T means the hold at rest (SM_BRAKE) has handed off to the phase short
    LONG    fault_mode      ' R19.3: FR_SHIPPED or FR_GRADED, the response to a position fault
    LONG    brake_on        ' R19.3: BR_BRAKE's shorted frames per BRAKE_PERIOD_FRAMES (frontSetFaultResponse())
    LONG    probe_phase     ' R19.4: PRB_* the continuity probe drives at rest; written only by the start-time self-test
    LONG    force_seq       ' R19.3 TEST-USE: front-written, advanced by testForceFault(); the driver faults once per advance
    LONG    fault_clr       ' task 3616: front-written, advanced by frontStopCommanded(); a FAULTED driver clears once per advance
    LONG    probe_sink      ' R19.4 1e TEST-USE: PRB_* whose low side the probe holds ON (the winding check's return), PRB_NONE for none
    LONG    probe_y         ' R19.4 1e TEST-USE: the probed phase's high-side Y (its duty), 0 for the continuity probe's 50 %
    LONG    drv_release     ' PL-138: T/F where T asks the driver to release (coast, drop its gate modes, report DCS_RELEASED
                            '  and park); init() writes FALSE before the launch, and only stop() writes TRUE, once no front
                            '  cog exists
    LONG    sense_zero      ' PL-146 (DRIVER_REV 37): the DC-link rest offset the fold-back nets out, mV (sense_i_mV's
                            '  units), never negative; written only with restZeroSenseMv (applySenseZero()), 0 when it
                            '  is unmeasured or out of band. The LAST long of the run

' -----------------------------------
    LONG    frame_cnt       ' clock-tics for period of PWM_RATE_IN_HZ

VAR { Offset tracking for independent setter/getter }
    LONG    offset_fwd_degrees   ' last-applied forward offset, in degrees
    LONG    offset_rev_degrees   ' last-applied reverse offset, in degrees
    LONG    bLeadScheduled       ' R18.4: T/F where T means the front cog writes the pair from the lead table
    LONG    bLeadWritePending    ' R18.4: T/F where T means the front cog must write the pair on its next slot, changed or not
    LONG    lastLeadTenths       ' R18.4: the lead the front cog last wrote, in tenths (valid once a write is made)

VAR { R18.4 D-6: what the path limiter reads }
    LONG    userCmdIncr          ' the increment last COMMANDED (a path scale never writes this)
    LONG    userCmdGen           ' advanced by every command written, so an owner sees a new one arrive
    LONG    holdSlotsAgo         ' rpm-window slots since the lag limiter last held the field, saturating at SHORT_SLOTS
    LONG    lastLagHeldSeen      ' lag_held as the previous slot read it

CON { error record }

    COG_SLOT_COUNT = 8          ' one error slot per P2 cog, indexed by COGID()

VAR { error record -- Spin2 only, never addressed by the PASM driver }
    ' Placed after every PASM-addressed run so it cannot shift one; isAbiLayoutValid() refuses a
    '  start if it ever lands inside one. Written only by recordError(), cleared only by getError().
    LONG    lastError[COG_SLOT_COUNT]   ' per calling cog: first error not yet collected, NO_ERROR when none

VAR { front cog request slots -- Spin2 only, never addressed by the PASM driver }
    ' Placed after every PASM-addressed run, like the error record; isAbiLayoutValid() checks each array.
    '  One slot per calling cog, indexed by COGID(). Every long has exactly one writer (see postRequest()).
    LONG    reqCmd[COG_SLOT_COUNT]      ' caller-written: REQ_* code
    LONG    reqArg1[COG_SLOT_COUNT]     ' caller-written: arguments, meaning per REQ_*
    LONG    reqArg2[COG_SLOT_COUNT]
    LONG    reqArg3[COG_SLOT_COUNT]
    LONG    reqNextSeq[COG_SLOT_COUNT]  ' caller-written: this cog's own sequence counter, never SEQ_IDLE once used
    LONG    reqSeq[COG_SLOT_COUNT]      ' caller-written LAST: SEQ_IDLE, or the published sequence
    LONG    ackStatus[COG_SLOT_COUNT]   ' front-written FIRST: NO_ERROR or ERR_* for the answered request
    LONG    ackSeq[COG_SLOT_COUNT]      ' front-written LAST: the sequence it answered
    LONG    frontPasses                 ' front-written heartbeat (zeroed by start before the launch)
    LONG    frontLatePasses             ' front-written: passes that ended within LATE_MARGIN_US of their slot's end
    LONG    frontMaxPassTicks           ' front-written: longest pass body, in ticks
    LONG    trackBasePos                ' front-written: pos at the previous tracking pass
    LONG    bStopUnconfirmed            ' front-written: T/F where T means a stop was written and not yet read back as zero
    LONG    protectiveCode              ' front-written (init() before start): NO_ERROR, or the latched protective cause
    LONG    limitPeakA                  ' front-written (init() before start): the peak phase-current limit in effect, amps
    LONG    limitContA                  ' front-written (init() before start): the continuous phase-current limit, amps
    LONG    phaseAvgMa                  ' front-written: average phase-current estimate, mA << CURRENT_AVG_SHIFT
    LONG    bDerated                    ' front-written: T/F where T means i_limit_k holds the continuous limit
    LONG    blockedPasses               ' front-written: consecutive passes held at the lag limit without a hall tick
    LONG    blockedPos                  ' front-written: pos at the previous pass, for the blocked test
    LONG    cmdTimeoutMs                ' front-written (start() before launch): S-8 command timeout, ms; CMD_TIMEOUT_OFF when off
    LONG    lastDriveMs                 ' front-written: getms() when the last drive command was applied, or the timeout set
    LONG    bCmdWatched                 ' front-written: T/F where T means a drive is being watched by the timeout (PL-143: every drive)
    LONG    cmdTimeoutEvents            ' front-written: command timeouts taken since start()
    LONG    faultCause                  ' front-written (init() before start): FC_* of the most recent fault since start
    LONG    bWasFaulted                 ' front-written: T/F where T means the driver read DCS_FAULTED on the previous pass
    LONG    faultIllegalPrev            ' front-written: the driver's hall_illegal long on the previous pass
    LONG    healthChecked               ' R19.4: HLT_* bits start() checked; written only by runStartChecks()
    LONG    healthFailed                ' R19.4: HLT_* bits that failed
    LONG    probeMv[9]                  ' R19.4: per probed phase U, V, W: the U, V and W readings, mV (TEST-USE)
    LONG    walkFwdTicks                ' R19.4: checkWiring()'s first leg, raw hall ticks (TEST-USE)
    LONG    walkRevTicks                ' R19.4: checkWiring()'s second leg, raw hall ticks (TEST-USE)
    LONG    bWalkGuardArmed             ' front-written (PL-122): T/F where T means a walk leg is driving under the current guard
    LONG    bWalkTripped                ' front-written (PL-122): T/F where T means the guard shorted the last leg (and its e-stop is the guard's)
    LONG    testProbeWithhold           ' TEST-USE: PRB_* the next runStartChecks() leaves undriven; PRB_NONE once it has run
    LONG    testHallSwap                ' TEST-USE: HSW_* the next init() applies to the hall tables; HSW_NONE once applied
    LONG    bWindProbe                  ' TEST-USE (R19.4 1e): T/F where T means the next runStartChecks() measures the windings
    LONG    windState[3]                ' R19.4 1e: WND_* per pair U->V, V->W, W->U, from the last start that measured them
    LONG    windMohm[3]                 ' R19.4 1e: each WND_MEASURED pair's resistance, milliohms
    LONG    windNetMv[3]                ' R19.4 1e: each pair's averaged DC-link reading over the rest zero, mV
    LONG    windVoltMv                  ' R20.4: the drive voltage those resistances were computed with, mV; 0 until measured
    LONG    windVoltSrc                 ' R20.4: where it came from: PACK_PRESENT (the sensor), else PACK_ABSENT / PACK_NOT_FITTED (nominal)
    LONG    bPackOwned                  ' R19.5: T/F where T means this instance reads the pack sensor (startPackSense())
    LONG    packGioRaw                  ' R19.5: the pin's GIO reading, taken at start
    LONG    packVioRaw                  ' R19.5: the pin's VIO reading, taken at start
    LONG    packAvgRaw                  ' R19.5: front-written: the pin's SINC2 reading, averaged, << PACK_AVG_SHIFT (PL-161: raw
                                        '  counts, converted to mV only when read -- packMvFromAvg())
    LONG    faultResyncsPrev            ' front-written (R19.3): the driver's fault_resyncs long on the previous pass
    LONG    faultResyncEvents           ' front-written (R19.3): faults answered by a re-sync and a controlled stop since start
    LONG    bFaultBegan                 ' front-written (R19.3): T/F where T means a fault of either kind began this pass
    ' R19.1 (task 3608): the hold at rest. Front-written, and init() sets each before start
    LONG    holdState                   ' HS_* now
    LONG    bHoldArmed                  ' T/F where T means this rest has a hold position
    LONG    holdPos                     ' pos where this rest began
    LONG    holdDisp                    ' pos - holdPos, this pass
    LONG    holdCeilPasses              ' consecutive passes with hold_duty at the ceiling
    LONG    holdCeilDuty                ' the ceiling, in duty counts (HOLD_CEILING_PCT of duty_max)
    LONG    holdRisePasses              ' displaced passes from duty_min to the ceiling (riseMs; PL-130)
    LONG    holdDispPasses              ' displaced passes this rest, at most holdRisePasses
    LONG    holdLimitPasses             ' passes at the ceiling before the hand-off to the short
    LONG    holdSlipEvents              ' holds ended by a slip since start, unbounded
    LONG    holdLimitEvents             ' holds ended by the time limit since start, unbounded
    LONG    cmdTimeoutSeen[COG_SLOT_COUNT]  ' per calling cog, written only by that cog's getError(): timeouts it has been told of
    ' R20.1 (task 3621): stop reasons (getStopReason()). Front-written (frontRecordStop(), frontOpenDrive()); init() before start
    LONG    stopReason                  ' SR_* of the last drive that ended; SR_NONE while one is open, or since start()
    LONG    bDriveOpen                  ' T/F where T means an accepted drive command has not yet been ended by a stop
    LONG    bResyncStopOpen             ' T/F where T means the last drive ended SR_FAULT_CONTROLLED and has not reached rest
    ' R20.1: the soft-event log (getEvent()). The ring, its head and the totals are front-written; init() empties them
    LONG    evKind[EV_RING_SLOTS]       ' EV_* per slot; slot = sequence +// EV_RING_SLOTS
    LONG    evMs[EV_RING_SLOTS]         ' getms() when queued
    LONG    evVal[EV_RING_SLOTS]        ' the event's value, meaning per EV_*
    LONG    evHead                      ' events queued this lifetime; written LAST in each queue (the publish)
    LONG    evEpoch                     ' this lifetime's number, advanced by init(), so a reader drops a cursor from an earlier one
    LONG    evTotal[EV_KINDS_COUNTED]   ' per kind, EV_STOP .. EV_FOLDBACK: events queued this lifetime; never lost
    LONG    evCursor[COG_SLOT_COUNT]    ' per reading cog, written only by that cog's getEvent(): the next sequence it reads
    LONG    evCursorEpoch[COG_SLOT_COUNT]   ' per reading cog, likewise: the evEpoch its cursor belongs to
    LONG    evLastMissed                ' front-written: hall_missed as last reported by EV_HALL_MISSED
    LONG    evMissedMs                  ' front-written: getms() of the last EV_HALL_MISSED
    LONG    evLastIllegal               ' front-written: hall_illegal's two words summed, as last reported by EV_HALL_ILLEGAL
    LONG    evIllegalMs                 ' front-written: getms() of the last EV_HALL_ILLEGAL
    LONG    evLastLate                  ' front-written: frontLatePasses as last reported by EV_LATE_PASS
    LONG    evLateMs                    ' front-written: getms() of the last EV_LATE_PASS
    LONG    evLastPack                  ' front-written (startPackSense() before it reads): the PACK_* last reported
    LONG    evPackMs                    ' front-written: getms() of the last EV_PACK
    LONG    evLastFold                  ' front-written: foldback_frames as last read
    LONG    evFoldBase                  ' front-written: foldback_frames before the engage now reported
    LONG    evFoldMs                    ' front-written: getms() when the fold-back count last grew
    LONG    bFoldActive                 ' front-written: T/F where T means an EV_FOLDBACK engage awaits its release
    ' R20.1: start() refusal and retries (runStartChecks(), setStartChecks())
    LONG    healthRecovered             ' HLT_* refusing bits that failed in an attempt and passed in the last; written only by runStartChecks()
    LONG    healthAttempts              ' attempts the last runStartChecks() made, 1 .. START_CHECK_RETRIES + 1
    LONG    bStartChecksOptOut          ' T/F where T means start() does not refuse (setStartChecks(FALSE)); NOT reset by init()
    LONG    testProbeWithholdFirst      ' TEST-USE: PRB_* the next runStartChecks() leaves undriven in its FIRST attempt only
    ' R20.1: the fault response and the hold limits as set (front-written by their front* setters; init() before start)
    LONG    faultBrakePct               ' the graded short's %, as set (brake_on holds frames)
    LONG    holdCeilPct                 ' the hold's ceiling, % of duty_max, as set
    LONG    holdRiseMs                  ' the hold's rise, ms, as set
    LONG    holdLimitMs                 ' the hold's time limit, ms, as set

VAR { PL-137: the wiring walk's per-leg record (testGetWalkLeg()) -- Spin2 only, never addressed by the PASM driver }
    ' Indexed by WLEG_*. init() empties it before start. Front-written: frontWalkBegin() opens a leg, frontWalkWatch()
    '  follows it every pass, frontWalkNoteLimit() notes its limit, frontWalkClose() ends the watch. Walker-written (the
    '  cog in checkWiring(), through walkNoteLeg()): the end fields, bWlRan LAST. Every long has exactly one writer.
    LONG    walkWatchLeg                ' front-written: the WLEG_* whose position is being watched, WLEG_NONE for none
    LONG    limitStopTicks              ' front-written: the stopping ticks the distance limit allowed for when it last fired
    LONG    wlPostMs[WALK_LEGS]         ' front-written: getms() when the leg's command was written and taken
    LONG    wlPostPos[WALK_LEGS]        ' front-written: pos the leg's distance limit counts from (the tracking reset)
    LONG    wlPeakPos[WALK_LEGS]        ' front-written: the pos furthest from wlPostPos while watched
    LONG    wlLimMs[WALK_LEGS]          ' front-written: ms from the post to the distance limit firing; WALK_NA if it did not
    LONG    wlLimPos[WALK_LEGS]         ' front-written: pos right after the limit's stop was written
    LONG    wlLimTrk[WALK_LEGS]         ' front-written: the tracked hall ticks (summed |steps|) the limit fired on
    LONG    wlLimStopTk[WALK_LEGS]      ' front-written: the stopping ticks the limit allowed for
    LONG    wlStopMs[WALK_LEGS]         ' front-written: ms from the post to the driver's first rest state after moving
    LONG    wlStopPos[WALK_LEGS]        ' front-written: pos at that pass
    LONG    wlLastPos[WALK_LEGS]        ' front-written: pos as last watched: the settled position once bWlClosed
    LONG    wlLastMoveMs[WALK_LEGS]     ' front-written: ms from the post to the last change of pos while watched
    LONG    wlLag0[WALK_LEGS]           ' front-written: lag_held at the post
    LONG    bWlLeftRest[WALK_LEGS]      ' front-written: T/F where T means the driver has reported this leg's motion
    LONG    bWlFaultSeen[WALK_LEGS]     ' front-written: T/F where T means a fault of either kind began while watched
    LONG    bWlClosed[WALK_LEGS]        ' front-written: T/F where T means the watch ended at the next drive command
    LONG    wlEnd[WALK_LEGS]            ' walker-written: WLE_*
    LONG    wlEndMs[WALK_LEGS]          ' walker-written: ms from the post to the end of the wait
    LONG    wlEndPos[WALK_LEGS]         ' walker-written: pos at the end of the wait
    LONG    wlLagHeld[WALK_LEGS]        ' walker-written: lag_held passes from the post to the end of the wait
    LONG    bWlRan[WALK_LEGS]           ' walker-written LAST: T/F where T means the leg was posted and taken

VAR { PL-153 / PL-155: the limits' travel, and the program's kept settings -- Spin2 only, never addressed by the PASM driver }
    ' Placed after every PASM-addressed run, like the error record; isAbiLayoutValid() checks the block.
    LONG    trkTravelTicks              ' front-written: hall ticks travelled either way since the front cog started; never reset
                                        '  while it runs (the odometer, posTrkHallTicks, is reset by resetTracking())
    LONG    limitBaseTicks              ' front-written: frontTravelNow() when the distance limit was armed
    LONG    limitBasePos                ' front-written: pos when the distance limit was armed (a walk leg's post position)
    LONG    bLimitByTime                ' front-written: T/F where T means the last limit bFrontLimitsDue() fired was the time limit
    ' The program's kept settings (PL-155), written by their setters on any cog, read by applyUserSettings() and the
    '  getters. NOT reset by init(), stop() or start(). 0 until set, and 0 reads as the default.
    LONG    usrMaxSpeed                 ' setMaxSpeed() [1..100]; 0: MAX_SPEED_DEFAULT
    LONG    usrMaxSpeed4dist            ' setMaxSpeedForDistance() [1..100]; 0: MAX_SPEED_DEFAULT
    LONG    usrStopMode                 ' holdAtStop(): SM_BRAKE or SM_FLOAT; 0 (SM_Unknown): SM_FLOAT
    LONG    usrReversed                 ' setForwardIsReverse(): T/F; 0: not reversed
    LONG    usrAccelStep                ' PL-160: the speed-up acceleration limit, driver units (setAcceleration(), setRampingValues()); 0: built in
    LONG    usrDecelStep                ' PL-160: the slow-down acceleration limit, driver units (setDeceleration(), setRampingValues()); 0: built in
    LONG    usrAccel                    ' PL-160: the rate setAcceleration() was given, mm/s^2; 0: none (built in, or raw)
    LONG    usrDecel                    ' PL-160: the rate setDeceleration() was given, mm/s^2; 0: none (built in, or raw)
    LONG    bWalkRamps                  ' DRIVER_REV 40: T/F where T means a wiring walk runs, so applyRamps() applies the built-in ramp (walkRamps()); init() clears it
    LONG    bRampsStale                 ' DRIVER_REV 40: T/F where T means the ramp's inputs changed: raised on any cog (requestRamps()), lowered only by the front cog's apply (frontApplyRamps()) and init()
    LONG    bRampsBusy                  ' DRIVER_REV 40: front-written: T/F where T means frontApplyRamps() is applying; init() clears it
    LONG    rampBuiltinUp               ' DRIVER_REV 40: ACCEL_BUILTIN_MM_S2 as a driver step, set by init() so no front cog converts it (rampsFor()); 0 before the first start
    LONG    rampBuiltinDn               ' DRIVER_REV 40: DECEL_BUILTIN_MM_S2 likewise
    LONG    bSettingsLive             ' T/F where T means a start has applied the kept settings, so a setter writes the working value too

VAR { PL-161: this object's front cog's one in-flight request -- Spin2 only, never addressed by the PASM driver }
    ' Placed after every PASM-addressed run, like the error record; isAbiLayoutValid() checks the block. Front-written
    '  only (bFrontServiceRequests()); an owner's front cog (isp_steering_2wheel) keeps its own and never uses these.
    LONG    pendStage                   ' PST_NONE, or the driver condition the request waits for (PST_*)
    LONG    pendSlot                    ' the request's slot (its caller's COGID())
    LONG    pendSeq                     ' the sequence it is answered under
    LONG    pendCmd                     ' its REQ_* code
    LONG    pendArg1                    ' its arguments, as taken
    LONG    pendArg2
    LONG    pendArg3
    LONG    pendTicks                   ' getct() when the present stage began (bFrontWaitExpired())

DAT  {  Motor DRIVER  }
'
' PASM Driver Program
'
                org     0

                ' DRIVER_REV 41 (memory reduction WP1, C1): the 21 cog longs that are dead once the start sequence
                '  has run -- these five entry longs, loadOverlay's four, eight start-only constants, adc_modes' three
                '  and calibPeriod -- are also the homes of 21 registers that only the drive loop uses: the stop
                '  planner's 17 (pl_v .. sp_F) and four of jerkStep's (jrk_e .. jrk_lim). Each such register carries
                '  a second label at its start-only long. Each is first accessed by a WRITE, only after loadOverlay
                '  has jumped to drvMotor, and no instruction of the start sequence names any of them, so the two
                '  uses of each long never overlap (proved equivalent to mem-reduce-start by tools/pasm_equiv).
                '  A debug interrupt saves and restores cog $000..$00F (p2kbArchDebugInterrupt), so a -d build
                '  keeps the registers here as well.
driver                                                  ' (C1) and pl_v, once the drive loop runs
pl_v            mov     drv_state_, #DCS_STOPPED        ' motor is currently stopped
{
                ' Logic Analyzer Instrumentation Code
                drvl    motrCtlLpPnFld                  ' preset test pins to low
                drvl    drvrTmrPnFld                    ' preset test pins to low
'                drvl    drvrTmr2PnFld                  ' preset test pins to low
'}
                ' task 3535 (fixed layout defect found in review): the one-time start sequence
                ' (pin setup through the initial checkstop, plus driveinit) never overlaps
                ' .drvMotor/.ctlMotor, so it is loaded into LUT RAM ($200-$3FF) instead
                ' of staying resident in cog RAM, freeing cog longs for upcoming work. DRIVER_REV
                ' 42 (memory reduction WP2, C2): this loads only the START IMAGE (lutCodeStart ..
                ' lutCodeEnd); loadOverlay then loads the RUN IMAGE (runCodeStart .. runCodeEnd)
                ' over it, and the start image calls nothing in the run image. Every
                ' register/constant/table it touches still lives in cog RAM ($000-$1FF); only
                ' the instructions moved -- D/S operand fields address $000-$1FF the same whether
                ' the executing code is in cog or LUT. lutCodePtr is filled in by init() (Spin2)
                ' before coginit, exactly like the motor tables are. PTRB (not PTRA) carries the
                ' block-load pointer: PTRA is still walking the @pinbase launch block just below
                ' and must reach it unchanged.
                '
                ' IMPORTANT: the org $200 block (lutCodeStart..lutCodeEnd, below the `fit 496`
                ' near the end of this DAT) must sit AFTER every org-0 item in the file, never
                ' between them. COGINIT copies cog $000-$1F7 from hub RAM contiguously starting
                ' at @driver (p2kbSpin2Coginit); the hub image is laid out strictly in source
                ' order regardless of ORG value, so any hub bytes interposed between two org-0
                ' items shift every later org-0 label's hub address away from its cog address,
                ' and COGINIT would then load the wrong hub bytes into that cog register. Keeping
                ' the LUT block textually after `fit 496` keeps the org-0 image's hub layout
                ' contiguous and matching its cog addresses, 1:1.
pl_a            mov     ptrb, lutCodePtr                ' hub address of the LUT-resident code (set by init())
pl_P            setq2   #(lutCodeEnd - lutCodeStart - 1) ' block-load size, in longs, minus 1
pl_Ul           rdlong  0, ptrb                          ' hub -> LUT: D is a LUT-relative address (0-511) under
                                                        ' SETQ2's block-to-LUT mode, so D=0 is LUT address 0,
                                                        ' i.e. cog address $200 -- lutCodeStart's own address,
                                                        ' since it is the very first instruction placed there
pl_Uh           jmp     #lutCodeStart                   ' enter LUT-resident start sequence
                                                        ' NOTE: lutCodeStart/lutCodeEnd, and wait4adc, checkstop,
                                                        ' initAngleFmHall, gettgtincr, driveinit, drvMotor, are
                                                        ' plain (non-dot) labels: PASM2 local (dot-prefixed)
                                                        ' labels are scoped to the nearest preceding global label,
                                                        ' and these are all referenced from both the LUT-resident
                                                        ' block and the cog-resident block, so they must be
                                                        ' globally visible (task 3535). .shortBridge and
                                                        ' .checkstopfloatoff stay dot-local: nothing outside cog
                                                        ' RAM calls them.

    ' =========================================================================
    '  MOTOR DRIVE LOOP - one pass every 23 ADC frames: about 1913 passes/s (522.7 uSec) at 200, 270 or 300 MHz.
    '       cfg_ctcks_ is a 500 uSec deadline, but CT1 is tested (jnct1) only at the end of each frame-aligned
    '       .ctlMotor pass, and 22 truncated frames fall just short of it, so the pass runs on the 23rd (PL-50).
    '       Every per-pass rate (drv_incr, the ramps) is therefore per 522.7 uSec, not per 500.
    '       time to adjust angle...
    ' -------------------------------------------------------------------------
drvMotor                                                ' global (task 3535): entered via cross-boundary jmp from the LUT-resident loader
                getct   ctrlSrtTix                      ' remember when we started this loop
                mov     lag_s, err_                     ' C-5: signed lag, + when the rotor trails the field in the
                testb   drv_incr, #31               wc  '  direction of motion (err_ is angle_ - rotor angle), - when
    if_c        neg     lag_s                           '  the rotor leads; read by the holds and the duty ceiling below
{
                ' Logic Analyzer Instrumentation Code
                drvh    drvrTmrPnFld                    ' HIGH while doing drive determination

'                outnot  drvrTmr2PnFld                  ' toggle TEST marker pin
'                outnot  drvrTmr2PnFld                  ' toggle TEST marker pin
'}
'
' with emergency stop we quickly stop and then ignore everything else until eStop request is removed!
'
                or      e_stop_, e_stop_            wz  ' Q: Emergency Stop Requested? (T/F - where T means stop!)
    if_z        jmp     #.noEStop                       ' No: continue on..
.eStop
                cmp     drv_state_, #DCS_ESTOP      wz  ' Q: Are we already Emergency Stopped?
    if_z        jmp     #.endRqst                       ' YES, motor is at ESTOP, just exit (w/o increment)
                call    #estopBridge                    ' "immediately stop": ES_HARD shorts whatever the stop mode, ES_PROTECT honours it
                call    #.clearRun                      ' PL-57: no running increment survives an e-stop
                mov     drv_state_, #DCS_ESTOP          ' mark that we are stopped
                jmp     #.endRqst                       ' motor now at ESTOP, just exit (w/o increment)
.noEStop
                cmp     drv_state_, #DCS_ESTOP      wz  ' Q: were we emergency stopped?
    if_z        mov     drv_state_, #DCS_STOPPED        ' YES, reset to simply stopped so we start out pins correctly
    if_z        call    #checkstop                      ' PL-57: and set drive pwm per stop mode, as .resetFault does
                mov     sv_tgt_incr, tgt_incr

                call    #gettgtincr                     ' get rate of increment ( +/- drive power, or 0 stop)
                ' task 3616: DCS_FAULTED is a LATCH. It clears only when the front cog advances fault_clr_ (a commanded
                '  stop or drive, frontStopCommanded()), never because the command reads 0: a re-synced stop has
                '  already written 0, so a fault during it once cleared on the next pass and its fallback never held.
                '  The front cog writes its 0 before advancing fault_clr_, so the clearing pass reads that 0.
                cmp     drv_state_, #DCS_FAULTED    wz  ' Q: is MOTOR faulted?
    if_nz       jmp     #.notFaulted                    ' NO, go take the command
                cmp     fault_clr_, fault_clr_seen  wz  ' Q: has the front cog cleared the fault?
    if_z        jmp     #.endRqst                       ' NO, still FAULTED: no command is taken, the fault's bridge stays
.resetFault
                call    #.clearRun                      ' zero the running state (shared with the e-stop entry, PL-57)
                mov     drv_state_, #DCS_STOPPED        ' reset fault -> to stopped
                call    #checkstop                      ' set drive pwm according to stop mode
.notFaulted
                mov     fault_clr_seen, fault_clr_      ' consumed: and when not FAULTED, a clear has nothing to clear
                ' PL-160 (DRIVER_REV 38): ONE jerk-limited trajectory generator (jerkStep, LUT) runs every pass the motor is
                '  not at rest, whatever the state, and takes every command as it stands -- so, as PL-104 (R18.4 D-4)
                '  required, a new request is taken in EVERY state. It replaces the SPIN_UP / SPIN_DN / SLOW_TO_CHG ramps,
                '  which stepped the acceleration on and off in one pass at both ends of every ramp; the states are now
                '  only what the generator reports. A reversal passes through zero in one continuous ramp: only a start
                '  from DCS_STOPPED seeds the field from the halls (driveFromRest), never the pass that crosses zero.
                cmp     drv_state_, #DCS_STOPPED    wz  ' Q: at rest?
    if_nz       jmp     #.running                       ' NO: the generator runs
                tjnz    tgt_incr, #.fromRest            ' at rest, and a drive asked for: start from rest
                call    #restBridge                     ' at rest: the stop mode's bridge, and the hold's hand-off (LUT-resident)
                jmp     #.endRqst                       ' motor at STOP, just exit (w/o increment)
{
' -------------------------------------------------------------------------
'  TEST-EXERCISER SUPPORT CODE (alternate input path (angle) for TESTing!)
'  DRIVER_REV 38: it ran on a new request (.newCmd); no path reaches this place now, so re-enabling it needs a new entry
                rdlong  tmp_angle_, ptra[-2]           ' get desired targetAngle for test (tgt_incr is temp variable in this case)
                cmp     tmp_angle_, maxNeg          wz  ' Q: do we have a request?
    if_nz       mov     angle_, tmp_angle_              ' YES, post this value to driver
    if_nz       wrlong  maxNeg, ptra[-2]                ' YES, tell user we got this value
    if_nz       jmp     #.endRqst                       ' YES, go position motor there (is absolute, so no incre!)
                ' NO? then just fall thru
'  END OF TEST-EXERCISER SUPPORT CODE
' -------------------------------------------------------------------------
'}
.fromRest       call    #driveFromRest                  ' a bridge left coasting or shorted at rest is re-aligned and driven (LUT)
.running        call    #jerkStep                       ' PL-160: v, a and the state for this pass (LUT); C = the field is at rest
                ' PL-78 / PL-87 / PL-95 (DRIVER_REV 34), THE KICK, kept: the pass a ramp arrives at its target advances the
                '  field like every AT_SPEED pass after it -- jerkStep returns C = 0 on the arrival pass, so it falls to
                '  .justIncr (the LAG_HOLD gate, the lag_held count and holdDecay) like any other running pass. Skipping
                '  that one increment once dropped a whole drv_incr of field phase at every arrival (12.3 deg electrical at
                '  147e6) and rang the load angle at ~18 Hz: the current kick at every speed change. Only the stop's own
                '  arrival (C = 1: the field is at rest) takes .endAtZero, where the field correctly stops.
    if_nc       jmp     #.justIncr                      ' JMP has no flag effect (p2kbPasm2Jmp); .justIncr sets its own C
.endAtZero
                ' at target but it is zero so we are STOPPED!
                mov     drv_state_, #DCS_STOPPED        ' report that we are stopped
                mov     duty_, duty_min_                ' reset duty
                mov     fault_stop, #0                  ' R19.3: a re-synced fault's stop is complete at rest; commands are taken again
                ' if we are to freewheel the motor let's float all drive pins

                call    #.checkstopfloatoff             ' set drive off according to stop mode
                jmp     #.endRqst                       ' motor STOPPED, just exit (w/o increment)

    ' -------------------------------------------------------------------------
.justIncr   ' just do our increment of angle and we're done!
                cmps    lag_s, #LAG_HOLD            wc  ' C-5: the field advances only while the rotor trails it by
    if_c        add     angle_, drv_incr                '  less than LAG_HOLD, so |err_| stays under the 125 fault test
    if_nc       add     lag_held_, #1                   ' R18.1: and when it does NOT advance, that is the one thing err
                                                        '  cannot report -- err is pinned at the hold. Count it instead.
    if_nc       call    #holdDecay                      ' R18.4 D-5: a held field falls toward the rate the rotor achieves
'                debug("DRV: ", uhex_(drive_pins), " A:(", sdec_(angle_), ") += DI:(", sdec_(drv_incr), ")")

.endRqst
                mov     drv_incr_s_, drv_incr           ' publish the field's increment (block-copied with the status run)
                mov     plan_stage, #1                  ' PL-161: plan the stop from this pass's (v, a) on the next nine frames
                call    #passEnd                        ' PL-138: a release asked for leaves here, and never returns; else
                                                        '  R18.4 D-1: the duty this pass's field speed needs (LUT-resident)
                ' PL-55: duty ceiling -- during a ramp-down, duty scales with the field's speed (duty0 * |drv_incr|
                '  / incr0) so drive voltage falls with back-EMF; lifted whenever the rotor trails by LAG_SOFT
                mov     duty_cap_, duty_max_
                cmp     drv_state_, #DCS_SPIN_DN     wz  ' Q: ramping down?
    if_nz       cmp     drv_state_, #DCS_SLOW_TO_CHG wz
    if_nz       jmp     #.capDone                       ' NO: no ceiling beyond duty_max_
                cmps    lag_s, #LAG_SOFT             wc  ' Q: rotor trailing by LAG_SOFT or more? (NC)
    if_nc       jmp     #.capDone                       ' YES: the motor needs the torque, no ceiling
                or      incr0, incr0                 wz  ' Q: no recorded start speed? (never divide by 0)
    if_z        jmp     #.capDone
                abs     tmpY, drv_incr
                qmul    duty0, tmpY                     ' 64-bit duty0 * |drv_incr|
                getqx   tmpY
                getqy   tmpX
                setq    tmpX
                qdiv    tmpY, incr0                     ' / incr0
                getqx   duty_cap_
                fles    duty_cap_, duty_max_            ' the ceiling never rises above duty_max_
                fges    duty_cap_, duty_min_            '  nor below duty_min_
.capDone
                getct   loop_ctcks_                     ' how long was this pass? send to host
                sub     loop_ctcks_, ctrlSrtTix
                ' reset timer (schedule next control loop run)
                mov     ctrlEndTix, ctrlSrtTix
                addct1  ctrlEndTix, cfg_ctcks_
{
                ' Logic Analyzer Instrumentation Code
                drvl    drvrTmrPnFld                    ' LOW drive determination complete
                jmp    #.ctlMotor                       ' done, fall thru
'}

    ' =========================================================================
    ' this or
    ' =========================================================================
{
                cmp     prior_drv_, drv_incr          wz
    if_z        jmp     #.noDrvIncr
                mov     delta_incr_, prior_drv_
                subs    delta_incr_, drv_incr
                mov     prior_drv_, drv_incr
.noDrvIncr
                cmp     prior_angle_, angle_          wz
    if_z        jmp     #.noAngle
                mov     tmpX, angle_
                subs    tmpX, prior_angle_
                debug("DRV: ", uhex_(drive_pins), " A=(", sdec_(angle_), ") DA=(", sdec_(tmpX), ") TI=(", sdec_(tgt_incr), ") DI=(", sdec_(delta_incr_), ")")
                mov     prior_angle_, angle_
.noAngle

.ctlMotor
                jmp     #.loop                      ' main loop

    ' =========================================================================
    ' this - special DRIVE TEST CODE
    ' =========================================================================
'}
.ctlMotor

    ' =========================================================================
    '  MOTOR Speed Maintenance Loop - runs at 43.9 kHz (22.8 uSec period)
    '       keep our error rate low...
    ' -------------------------------------------------------------------------
                getct   drvrSrtTix                      ' remember when we started this loop

                call    #wait4adc                      ' allow ADC rest period (wait for sample ready), also wait for start of ctl loop
                rdpin   sense_u_, pin_adc_u_i           ' pin samples done, read them
                rdpin   sense_v_, pin_adc_v_i
                rdpin   sense_w_, pin_adc_w_i
                rdpin   sense_i_, pin_adc_cur_i

                sub     sense_u_, gio_levels+0          ' compute (numerator * (pin_level - gio_level)) >> 11
                muls    sense_u_, scl_levels+0
                sar     sense_u_, #11

                sub     sense_v_, gio_levels+1
                muls    sense_v_, scl_levels+1
                sar     sense_v_, #11

                sub     sense_w_, gio_levels+2
                muls    sense_w_, scl_levels+2
                sar     sense_w_, #11

                sub     sense_i_, gio_levels+3
                muls    sense_i_, scl_levels+3
                sar     sense_i_, #11

                mov     tmpY, duty_                     ' feed three CORDIC operations to get phase drive levels
                shr     tmpY, #4
                mov     tmpX, angle_                    ' requested angle
                qrotate tmpY, tmpX
                add     tmpX, third                     ' 120 degrees further
                qrotate tmpY, tmpX
                add     tmpX, third                     ' 240 degress further
                qrotate tmpY, tmpX

                getqy   drive_u_                        ' get three CORDIC results, duty/16*SIN(angle_+N*120degree) (N->0,1,2): QROTATE with no SETQ, GETQY is Y
                getqy   drive_v_
                getqy   drive_w_
' used when tracking down PWM drive problem...
'                mov     driveUsav_, drive_u_           ' copy for later display

                mov     tmpX, drive_u_                  ' get smallest drive level into tmpX
                cmps    tmpX, drive_v_              wc
    if_nc       mov     tmpX, drive_v_
                cmps    tmpX, drive_w_              wc
    if_nc       mov     tmpX, drive_w_

                mov     tmpY, drive_u_                  ' get largest drive level into tmpY
                cmps    tmpY, drive_v_              wc
    if_c        mov     tmpY, drive_v_
                cmps    tmpY, drive_w_              wc
    if_c        mov     tmpY, drive_w_

                add     tmpX, tmpY                      ' sum smallest and largest, then divide by 2
                sar     tmpX, #1

                sub     drive_u_, tmpX                  ' subtract difference from drive levels
                sub     drive_v_, tmpX                  ' offset round the average drive pwm
                sub     drive_w_, tmpX

                add     drive_u_, bias                  ' add center-bias and dead-time offsets to update PWMs
                add     drive_v_, bias                  ' center around the triangle counter
                add     drive_w_, bias                  ' the counter runs from the frame period down to 1 and back up, each PWM period
                                                        ' the output is high while the counter is at or below Y, so Y = 0 is constant LOW and
                                                        ' Y = frame is constant HIGH (p2kbArchSmartPin01000PwmTriangle); the low-side pins are
                                                        ' inverted (pwmn), and a HIGH on a low-side input turns that FET ON (PL-56)

                cmp     bridge, #BR_DRIVE           wz  ' Z: the bridge is driven this frame (R17.1: see the BR_* constants)
    if_nz       call    #undrivenPins                   ' undriven: each state's pin values (LUT-resident; leaves Z, which follows)
                add     drive_u_, dead_gap_             ' make sure low side turns off (inverted) earlier than high side turns on (non-inverted)
    if_z        wypin   drive_u_, pin_pwm_u_l           ' safety on driver board make sure high side off if both low and high side are high, in case of an error
                sub     drive_u_, dead_gap_             ' shouldn't happen with dead-gap
    if_z        wypin   drive_u_, pin_pwm_u_h

                add     drive_v_, dead_gap_             ' dead-gap was OFFSET
    if_z        wypin   drive_v_, pin_pwm_v_l
                sub     drive_v_, dead_gap_             ' dead-gap was OFFSET
    if_z        wypin   drive_v_, pin_pwm_v_h

                add     drive_w_, dead_gap_             ' dead-gap was OFFSET
    if_z        wypin   drive_w_, pin_pwm_w_l
                sub     drive_w_, dead_gap_             ' dead-gap was OFFSET
    if_z        wypin   drive_w_, pin_pwm_w_h

                alts    hall_port                       ' PL-90: the next S is INA or INB, chosen once at driver start
                mov     tmpX, 0-0                       ' ONE read: all three (filtered) hall lines from the same instant
                shr     tmpX, hall_shift                ' U to bit 0, V to bit 1, W to bit 2: the old W,V,U TESTP/RCL order
                and     tmpX, #%111
                shl     hall_, #3                       ' last pass's code becomes "old"
                or      hall_, tmpX
                and     hall_, #%111_111                ' (old << 3 | new) [_x_:ooo:nnn]
                altgb   hall_, #deltas                  ' load byte deltas[hall_] -> [-1, 0, 1]
                getbyte tmpY
                signx   tmpY, #7                        ' sign-extend bit7
                add     pos_, tmpY                      ' add to current pos_

                ' hall integrity counters: hall_ is (old << 3 | new), tmpY is the table delta
                '  counts EVENTS: a missed transition (legal -> different legal, no step), or an entry into
                '  an illegal code (%000/%111); an illegal code is never also counted as a missed transition
                mov     tmpX, hall_                     ' tmpX := old<<3 | new
                shr     tmpX, #3                        ' tmpX := old
                xor     tmpX, hall_                     ' low 3 bits := old ^ new
                test    tmpX, #%111                 wz  ' Q: hall code unchanged since last pass?
    if_z        jmp     #.hallCounted                   ' YES (NORMAL): nothing to count
                cmp     tmpY, #0                    wz  ' Q: did the table report a step (delta <> 0)?
    if_nz       jmp     #.hallCounted                   ' YES: legal adjacent transition, already in pos_
                mov     tmpY, hall_                     ' tmpY := old<<3 | new (delta no longer needed)
                and     tmpY, #%111                     ' tmpY := new
                call    #countIllegal                   ' Z: changed INTO %000 or %111, counted in that code's own word
    if_z        jmp     #.hallCounted                   ' ...never also a missed transition
                mov     tmpY, hall_
                shr     tmpY, #3                        ' tmpY := old
                cmp     tmpY, #%000                 wz  ' Q: leaving an illegal code (already counted on entry)?
    if_nz       cmp     tmpY, #%111                 wz
    if_nz       add     hall_missed_, #1                ' legal -> different legal with no step: missed transition
.hallCounted
                setq    #DRVR_PARAMS_LONGS_COUNT-1      ' load fresh parameter table (DRVR_PARAMS_LONGS_COUNT longs)
                rdlong  params_ptr_+1, params_ptr_

                cmpm    angle_, prior_angle         wcz ' if angle has changed, forward or reverse?
    if_nz       wrc     fwdrev                          ' if angle hasn't changed then use last forward/reverse
                mov     prior_angle, angle_

                testb   fwdrev, #0                  wc  ' determine error
                bitc    hall_, #3                       ' forward or reverse half of the hall_angles table
                and     hall_, #%1111                   ' remove hall input from last time to stay in bounds
                alts    hall_, #hall_angles
                mov     err_, 0-0
    if_c        add     err_, offset_fwd_               ' hall sensor offsets
    if_nc       add     err_, offset_rev_
                subr    err_, angle_                    ' difference from requested angle
                sar     err_, #24

                abs     tmpY, err_                      ' fault? tmpY is absolute difference from hall angle to requested angle
                cmp     tmpY, #125                  wc  ' less than ~176deg differ from requested? is ok
                tjnz    bridge, #.noFault               ' the bridge is not driven: no fault (e.g. a wheel turned by hand)
    if_c        cmp     force_seq_, force_seen      wz  ' R19.3 TEST-USE: no natural fault -- was one forced (testForceFault())?
    if_c_and_z  jmp     #.noFault                       ' NO: no fault this frame
                mov     force_seen, force_seq_          ' a fault takes any forced request (undrivenPins drops one made while undriven)
                call    #faultResponse                  ' at FAULT: report it, and respond per fault_mode_ (LUT-resident, R19.3)

.noFault        tjnz    bridge, #.servoTrim             ' PL-146 (DRIVER_REV 36): the fold-back acts only on a driven bridge
                                                        '  (BR_DRIVE is 0). Undriven, sense_i_ is the board's rest offset
                                                        '  (left ~8 mV), over a 1 A threshold at the duty floor (~11 mV)
                                                        '  on noise alone; it counted foldback_frames every frame at rest,
                                                        '  so EV_FOLDBACK never released. Skipped here: the compare, the
                                                        '  duty cut and the count. The trim runs as on any unfolded frame,
                                                        '  and .dutyLimits then applies duty_min_ and re-derives servo_acc,
                                                        '  as it always did for an undriven bridge. TJNZ changes no flag
                                                        '  (p2kbPasm2Tjnz), and from the undriven jump above tmpY still
                                                        '  holds |err_|. A fault taken on this frame has already set the
                                                        '  fault's bridge, so its frame skips too, as undriven hereafter.
                mov     fold_net, sense_i_              ' PL-146 (DRIVER_REV 37): the DC-link reading NET of the board's
                sub     fold_net, sense_zero_           '  rest offset, floored at 0. A driven bridge at rest (SM_BRAKE)
                fges    fold_net, #0                    '  read the raw offset (left ~8 mV) against a ~11 mV threshold at
                                                        '  1 A: counted on noise. sense_zero_ is the front's restZeroSenseMv
                                                        '  (0 when unmeasured or out of band), mV as sense_i_ is; sense_i_
                                                        '  itself stays raw, since it is reported (sense_i_mV). FGES is a
                                                        '  signed floor (p2kbPasm2Fges); no flag is written until the CMPS.
                mov     tmpX, duty_                     ' S-2: the MOSFET current limit, on a lower bound of phase current:
                fges    tmpX, duty_floor_               '  I_dc >= 0.75 * m * I_peak, m = duty_ / (4 * frame_cnt), floored
                sca     tmpX, i_limit_k_                '  threshold (mV) = max(duty_, duty_floor_) * i_limit_k_ >> 16
                cmps    fold_net, tmpX              wcz ' Q: the net reading OVER the limit's count? (NC and NZ) SCA hands
                                                        '  the threshold to this S (p2kbPasm2Sca), so tmpX itself is unread.
                                                        '  DRIVER_REV 38: the reading is a whole mV count and the threshold t a
                                                        '  real one that SCA floors, so "reading >= t" is exactly "reading >
                                                        '  floor(t)" (= reading >= ceil(t)) but for a t that is a whole count,
                                                        '  where it folds one count late. The old "at or over floor(t)" folded
                                                        '  up to a count early -- and, at t < 1 (Rev A, 5 mV/A: t = 0.375 x amps
                                                        '  at the duty floor, so a limit under ~2.7 A), on every driven frame,
                                                        '  since fold_net is never below 0. Rounding would not mend t < 0.5.
                                                        '  DRIVER_REV 40 (PL-163): duty_floor_ is raised for such a limit so
                                                        '  t >= FOLD_MIN_MV (4): a reading of 4 mV or less is inside the
                                                        '  chain's noise and zero error, so it folds nothing (setFoldLimit())
    if_nc_and_nz mov    tmpY, duty_                     ' YES: fold back ~1.6 % per frame, and skip the servo this frame
    if_nc_and_nz shr    tmpY, #6
    if_nc_and_nz sub    duty_, tmpY
    if_nc_and_nz add    foldback_cnt_, #1               ' R20.1: counted (EV_FOLDBACK). No WC/WZ: C and Z still select the jump
                                                        '  below. Cancelled on a normal frame, which still spends its 2 clocks
                                                        '  (p2kbPasm2ConditionalExecution: same time whatever the condition)
    if_nc_and_nz jmp    #.dutyLimits
                ' R18.4 D-2 (DOCs/plans/DRIVE-INTEGRATION-DESIGN.md 5.3): an integral TRIM above the feedforward.
                '  Symmetric and untruncated, so it holds a POINT (PL-101's band is gone), and scaled by duty,
                '  so its gain follows the stiffness the rotor has -- an integral-only loop is stable only
                '  below a gain that stiffness supports, and at low duty the old servo was above it (5.2).
.servoTrim      sub     tmpY, #SERVO_SETPOINT           ' |err_| - setpoint, signed (tmpY holds |err_| from the fault test)
                mov     tmpX, duty_
                shr     tmpX, #SERVO_DUTY_PRESHIFT      ' duty in MULS's 16 bits; keeps servo_acc inside 32 at duty_max_
                muls    tmpY, tmpX
                add     servo_acc, tmpY
                mov     duty_, servo_acc
                sar     duty_, servo_shift_             ' the trim...
                add     duty_, duty_ff                  ' ...rides on the feedforward, which carries the back-EMF (D-1)
                cmp     drv_state_, #DCS_STOPPED    wz  ' R19.1: at rest the front cog's hold law sets the duty, not the trim;
    if_z        mov     duty_, hold_duty_               '  the fold-back above still lowers it frame by frame when over the limit
.dutyLimits
                cmp     bridge, #BR_DRIVE           wz  ' R17.1: an undriven bridge applies no duty, so the servo must not wind duty_
    if_nz       mov     duty_, duty_min_                '  up to duty_max_ against an error it cannot correct -- telemetry reads what is applied
                fles    duty_, duty_cap_            wc  ' keep duty within limits (duty_cap_ is duty_max_ except while ramping down, PL-55)
    if_c        add     duty_capped_, #1                ' R18.1: FLES WC sets C when the limit was ENFORCED, so the clamp
                                                        '  itself reports the one thing duty_ cannot -- once it pins at the
                                                        '  cap it says only "still pinned" (PL-95). No extra compare, and
                                                        '  nothing between here and the next flag write reads C.
                fges    duty_, duty_min_
                ' D-2 anti-windup, ONE for every limiter above and the current fold-back: when the applied duty is
                '  not what feedforward + trim asked for, the trim is re-derived from what was applied, so the
                '  accumulator never holds a demand a limiter refused
                mov     tmpX, servo_acc
                sar     tmpX, servo_shift_
                add     tmpX, duty_ff
                cmp     tmpX, duty_                 wz  ' Q: did a limiter change the demand?
    if_nz       mov     servo_acc, duty_
    if_nz       sub     servo_acc, duty_ff
    if_nz       shl     servo_acc, servo_shift_

                getct   loop_dtcks_                     ' how long was this iteration? send to host
                sub     loop_dtcks_, drvrSrtTix

                setq    #DRVR_STATUS_LONGS_COUNT-1      ' write drive[3]/sense[4]/hall/pos/duty/err/ticks[2]/state/hall_missed/hall_illegal/drv_incr/lag_held/duty_capped/fault_resyncs/foldback_cnt/accel_now/stop_passes/stop_fp to hub
                wrlong  drive_u_, ptra
                tjz     plan_stage, #.loop              ' PL-161 (DRIVER_REV 39): the stop plan, on the two frames after a drive
                call    #planStage                      '  pass, in the frame's slack after its status write (LUT)
.loop           jnct1   #.ctlMotor                      ' if not time for drv loop just go to ctl loop
                jmp     #drvMotor

    ' =========================================================================
    '  PRIVATE (Utiility) Subroutines
    ' -------------------------------------------------------------------------
    ' gettgtincr and driveinit moved to the LUT (task 3535): gettgtincr is
    ' called only from drvMotor (cog-resident, calls across the boundary), and
    ' is in the LUT run image (runCodeStart..runCodeEnd); driveinit is called
    ' only from the start sequence, and is in the LUT start image
    ' (lutCodeStart..lutCodeEnd). Both are below the `fit 496` line.
    '
    ' .shortBridge and .checkstopfloatoff stay dot-local (task 3535): nothing
    ' outside cog RAM calls them, so they don't need to be globally visible
    ' the way checkstop/wait4adc/initAngleFmHall/gettgtincr/driveinit/
    ' drvMotor/lutCodeStart/lutCodeEnd do. R19.1 moved the drive-from-rest
    ' entry (was .checkstopfloaton) into the LUT as driveFromRest, beside
    ' restBridge; R19.3 moved the fault's bridge choice (was .faultBridge)
    ' into the LUT as faultResponse.

    ' PL-55's capture of where a ramp-down starts (was .capStart) is jerkStep's, inline, since DRIVER_REV 38.

.clearRun                                               ' zero the running state, so the next start ramps up from zero
                mov     drv_incr, #0                    '  called by .resetFault and by the e-stop entry: before PL-57 the
                mov     accel_now_, #0                  '  e-stop kept drv_incr, and a restart at the same speed declared
                mov     fwdrev, #0                      '  AT_SPEED against a stopped wheel and faulted. PL-160: and no acceleration
                mov     fault_stop, #0                  ' R19.3: an e-stop or a fault reset also ends a re-synced fault's stop
    _ret_       mov     angle_, #0                      ' .rampUp's drv_incr == 0 path re-seeds the angle from the halls

.checkstopfloatoff                                      ' now at rest: the bridge takes the user's stop mode
                skip    #%001100                        ' same as checkstop without initAngleFmHall and duty reset
checkstop                                               ' the bridge takes the user's stop mode (holdAtStop())
                cmp     stop_mode_, #SM_FLOAT       wz  ' Q: what is new stop mode, should motor be freewheeling?
                modz    _nz                         wz  ' invert Z, allows skipping invert by floaton
    if_z        call    #initAngleFmHall                ' make sure angle set correctly, so motor doesn't jerk when enters ctlMotor
    if_z        mov     duty_, duty_min_                ' reset duty, reduces jerk if not fully aligned
    if_z        mov     bridge, #BR_DRIVE               ' SM_BRAKE: driven -- held at duty_min at rest
    if_nz       mov     bridge, #BR_COAST               ' SM_FLOAT: all six FETs off, a freewheel (was Y = 0 on all six: a short, PL-89)
                ret

wait4adc
.wait4adcAgn    testp   pin_adc_cur_i               wc  ' wait for ADC sample to be avail. (wtg on 4th pin set up)
    if_nc       jmp     #.wait4adcAgn
.noWait4adc     ret

loadOverlay                                             ' PL-161 (DRIVER_REV 39): the start sequence's last jump. Its LUT longs are
pl_Dl           mov     ptrb, planCodePtr               '  spent, so DRIVER_REV 42 (C2) block-loads the whole RUN IMAGE over them
pl_Dh           setq2   #(runCodeEnd - runCodeStart - 1) '  (runCodeStart .. runCodeEnd, below `fit 496`), from cog RAM, since the
pl_n            rdlong  0, ptrb                         '  LUT code this overwrites is the code that jumped here; then the drive
pl_f            jmp     #drvMotor                       '  loop starts. DRIVER_REV 41 (C1): these four longs are then pl_Dl .. pl_f

planFp                                                  ' PL-161: the plan's field travel in 1/256 hall tick, from its two sums:
                mov     pl_t, pl_Ul                     '  6 x SUM = 3 U + D (run), and the tick fixed point is SUM x 6 / 2^32
                mov     pl_q, pl_Uh                     '  x 256 = 6 x SUM / 2^24. Out: pl_t, saturated at POSX. Writes C.
                shl     pl_t, #1                    wc
                rcl     pl_q, #1                        ' 2U
                add     pl_t, pl_Ul                 wc
                addx    pl_q, pl_Uh                     ' 3U
                add     pl_t, pl_Dl                 wc
                addx    pl_q, pl_Dh                     ' 3U + D, never below 0 (it is 6 x a sum of speeds)
                shr     pl_t, #24
                cmp     pl_q, ##$0080_0000          wc  ' Q: under 2^55, so the quotient fits a long (C)?
                shl     pl_q, #8
                or      pl_t, pl_q
    if_nc       mov     pl_t, ##$7FFF_FFFF              ' NO: saturated
                ret

planCorner                                              ' PL-161: planA's corner (see planA), here for room: a stop read
                mov     pl_t, pl_a                      '  just before a reversal's crossing stops the field AT zero. n, the least
                shl     pl_t, #1                        '  with n alpha - J n (n + 1) / 2 >= V; n - 1 passes from alpha - J down
                sub     pl_t, jerk_dn_                  '  by J, and the n-th at rest. B = 2 alpha - J
                qmul    pl_t, pl_t
                getqx   pl_u
                getqy   pl_q                            ' B^2
                qmul    pl_v, jerk_dn_
                getqx   pl_c
                getqy   pl_d                            ' J V
                shl     pl_d, #3                        ' 8 J V, 64-bit
                mov     pl_n, pl_c
                shr     pl_n, #29
                or      pl_d, pl_n
                shl     pl_c, #3
                sub     pl_u, pl_c                  wc
                subx    pl_q, pl_d                      ' B^2 - 8 J V, at least 0 in the corner
                qsqrt   pl_u, pl_q
                getqx   pl_n                            ' its floor root
                subr    pl_n, pl_t                      ' B - isqrt, at least 1
                mov     pl_u, jerk_dn_
                shl     pl_u, #1                        ' 2J
                add     pl_n, pl_u
                sub     pl_n, #1
                qdiv    pl_n, pl_u
                getqx   pl_n                            ' n = ceil((B - isqrt) / 2J): the least n, or one over it
                mov     pl_c, pl_n
                sub     pl_c, #1                        ' n - 1
                mov     pl_u, pl_c
                add     pl_u, #1
                mul     pl_u, pl_c
                shr     pl_u, #1                        ' (n - 1) n / 2
                qmul    pl_u, jerk_dn_
                getqx   pl_u
                qmul    pl_c, pl_a
                getqx   pl_q                            ' (n - 1) alpha
                sub     pl_q, pl_u                      ' what n - 1 passes shed
                cmps    pl_q, pl_v                  wc  ' Q: already V (NC)?
    if_nc       mov     pl_n, pl_c                      ' YES: n - 1 is the least
                add     pl_P, #1                        ' the crossing pass, at rest
                sub     pl_n, #1
                mov     pl_f, pl_a
                sub     pl_f, jerk_dn_                  ' alpha - J, then down by J
                neg     pl_d, jerk_dn_
                call    #run                            ' (n - 1, alpha - J, -J)
    _ret_       modc    _set                        wc  ' C = 1: the plan is complete (planA's return, which jumped here)

    ' DRIVER_REV 42 (memory reduction WP2, C2): countIllegal is back in cog RAM (DRIVER_REV 37 had moved it to the
    '  LUT). It is the one routine both images need -- the start sequence calls it once, .ctlMotor on a hall change the
    '  table did not step -- so it can live in neither LUT image. Unchanged; reached only by CALL.
countIllegal                                            ' PL-90: count an entry into illegal code tmpY (0..7) in its own word
                mov     tmpX, #HALL_ILL_HI_WORD         '  of hall_illegal_ -- %000 low, %111 high -- saturating, so one
                cmp     tmpY, #%000                 wz  '  word never carries into the other. Returns Z set when counted,
    if_z        mov     tmpX, #HALL_ILL_LO_WORD         '  Z clear for a legal code. Global: .ctlMotor calls it on a hall
    if_nz       cmp     tmpY, #%111                 wz  '  change the table did not step, and the start sequence (LUT start
    if_nz       ret                                     '  image) once. A legal code: nothing counted, Z clear.
                altgw   tmpX, #hall_illegal_            ' this code's 16-bit count
                getword tmpY
                cmp     tmpY, ##HALL_ILL_WORD_MAX   wz  ' Q: saturated?
    if_nz       add     tmpY, #1
                altsw   tmpX, #hall_illegal_
                setword tmpY
    _ret_       modz    _set                        wz  ' Z: counted, whatever the saturation test left in Z

initAngleFmHall
                ' init angle & prior from current motor position
                testb   tgt_incr, #31               wc  ' Q: from rest, the command's way: FWD or REV? (bCY=REV)
initAngleFmHallC                                        ' entry with C already set (bCY=REV): faultResponse's re-sync
                alts    hall_port                       ' PL-90: one read of INA or INB, all three hall lines at one instant
                mov     hall_, 0-0
                shr     hall_, hall_shift               ' U to bit 0, V to bit 1, W to bit 2 (the old TESTP/RCL order)
                bitc    hall_, #3                       ' point to correct FWD/REV half of table
                and     hall_, #%1111                   ' keep the code and the direction bit, drop the port's other pins
                alts    hall_, #hall_angles
                mov     angle_, 0-0
    if_c        add     angle_, offset_fwd_             ' adjust phase offset for hall sensor
    if_nc       add     angle_, offset_rev_             ' can spin up in either direction
    _ret_       mov     prior_angle, angle_             ' show we are already here
'
' =========================================================================
'  DRIVER_REV 41 (C1): each START-ONLY constant below is also the home of a drive-loop register, labelled on the
'   line above it (see the note at `driver`). drive_pins, adc_pins, adc_fram, bias, third and maxNeg are read by
'   the drive loop or driverRelease, so they host nothing.
pl_d                                            ' (C1) the run's change of acceleration per pass
all_pins        LONG    (13 << 6) + 0           ' all-pins variable (0 addpins 13) needs ADD/OR of basepin, skip last 2 pwm pins, not used
drive_pins      LONG    (5 << 6) + 8            ' drive-pins variable (+8 addpins 5) needs ADD of basepin, skip last 2 pwm pins, not used
adc_pins        LONG    (4 << 6) + 0            ' drive-pins variable (+0 addpins 4) needs ADD/OR of basepin, note total of 5 pins, adc_x not used
pl_c                                            ' (C1) the rise's candidates (cap)
pwmt            LONG    %000_000000_01_01000_0  ' PWM true (P_PWM_TRIANGLE | P_OE: TT = %01, output enabled REGARDLESS of DIR; PL-138)
pl_t                                            ' (C1) the planner's scratch
pwmn            LONG    %001_000000_01_01000_0  ' PWM not (P_INVERT_OUTPUT | P_PWM_TRIANGLE | P_OE): with DIR low it outputs HIGH, ON
adc_fram        LONG    0                       ' set ADC to full PWM frame counts [was: LONG    FRAME]
pl_u                                            ' (C1) the planner's scratch
fram            LONG    0                       ' PWM frame: width=FRAME/2, div sysclk by 1 (no division) [was: LONG (FRAME / 2) << 16 + 1 ]
bias            LONG    0                       ' PWM center-frame bias [was: LONG    FRAME / 4]
third           LONG    1 FRAC 3                ' 120 degrees
pl_q                                            ' (C1) the planner's scratch
numerator       LONG    3300 << 11              ' ADC scale numerator: 3300 mV in fixed point, the control loop's sar #11 returns millivolts
maxNeg          LONG    $FFFF_FFFF              ' 32-bits of one (max negative signed value)
sc_v                                            ' (C1) the take pass's v' (an end of its range), for its own advance
sync_required   LONG    0                       ' non zero if motor loop should wait to start
sp_P                                            ' (C1) the largest passes so far (the m = 1 plan, then each take pass's)
lutCodePtr      LONG    0                       ' hub addr of the LUT start image (task 3535); set by init()
sp_F                                            ' (C1) and the largest travel, 1/256 tick
planCodePtr     LONG    0                       ' PL-161 (DRIVER_REV 39): hub addr of the LUT run image (DRIVER_REV 42; was the planner overlay); set by init()

    ' -----------------------------------
    ' Logic Analyzer Instrumentation Code
    ' -----------------------------------
{
motrCtlLpPnFld  LONG    TEST_PIN_MOTR_CTL_LP addpins 0  ' convert to pinfield
drvrTmrPnFld    LONG    TEST_PIN_DRIVE_LP addpins 0  ' convert to pinfield
drvrTmr2PnFld   LONG    TEST_PIN_DRIVE_LP2 addpins 0  ' convert to pinfield
drvrTgglPnFld   LONG    TEST_PIN_LP_TOGL addpins 0  ' convert to pinfield
drvrTggl2PnFld  LONG   TEST_PIN_UNKNOWN addpins 0  ' convert to pinfield
'}

jrk_e                                      ' (C1) E, the speed still to change, |tgt_incr - drv_incr|
adc_modes       LONG    p_adc_gio | p_count_highs  ' +0 : adc modes, by state (start only)
jrk_s           LONG    p_adc_vio | p_count_highs  ' +1 ; (C1) jrk_s: 1 when s, the way the generator pushes, is negative
jrk_j           LONG    p_adc_1x | p_count_highs   ' +2 ; (C1) jrk_j: J, the jerk of the side toward s

' turn motor to view hall sequence ...  learn in known direction
'   efficient: low current draw at given speed

' max frequency is this...
' max ramp rate is this...

' old bit shift up by 3 then new bits
'   old is outer index
'   new is inner index
deltas          BYTE    0,  0,  0,  0,  0,  0,  0,  0  ' Hall-effect-sensor position deltas from (old<<3 | new)
                BYTE    0,  0,  0, -1,  0,  1,  0,  0
                BYTE    0,  0,  0,  1,  0,  0, -1,  0
                BYTE    0,  1, -1,  0,  0,  0,  0,  0
                BYTE    0,  0,  0,  0,  0, -1,  1,  0
                BYTE    0, -1,  0,  0,  1,  0,  0,  0
                BYTE    0,  0,  1,  0, -1,  0,  0,  0
                BYTE    0,  0,  0,  0,  0,  0,  0,  0

' 32bit angles
'  6.5" wheel
'    1 wheel revolution is 360 degrees
'   90 tics per 360 degrees
'    1 tic is 4 degrees
'    6 tics per tic-cycle
'   15 tic-cycles per 360 degrees
'   30 pole motor
'    1 tic-cycle is 24 degrees
'
'  docoEng.com 4k RPM 24v motor
'    1 shaft revolution is 360 degrees
'   24 tics per 360 degrees
'    1 tic is 15 degrees
'    6 tics per tic-cycle
'    4 tic-cycles per 360 degrees
'    8 pole motor
'    1 tic-cycle is 90 degrees
'
'   amount of rotation within hall cycle - 6.5" wheel
hall_angles     LONG    0           '-%000- can't happen forward-direction table
                LONG    0 frac 6    '%001
                LONG    4 frac 6    '%010
                LONG    5 frac 6    '%011
                LONG    2 frac 6    '%100
                LONG    1 frac 6    '%101
                LONG    3 frac 6    '%110
                LONG    0           '-%111- can't happen

                LONG    0           '-%000- can't happen - reverse-direction table
                LONG    5 frac 6    '%001
                LONG    3 frac 6    '%010
                LONG    4 frac 6    '%011
                LONG    1 frac 6    '%100
                LONG    0 frac 6    '%101
                LONG    2 frac 6    '%110
                LONG    0           '-%111- can't happen

tmpX            res 1       ' miscellaneous
tmpY            res 1
fold_net        res 1       ' PL-146 (DRIVER_REV 37): the fold-back's net reading, sense_i_ - sense_zero_ floored at 0 (.noFault)
calibPeriod                 ' PL-32: widened ADC count period, start-of-driver GIO/VIO calibration only; and (C1)
jrk_lim         res 1       '  jrk_lim, A, the acceleration limit of the side toward s, once the drive loop runs
' measurements
drvrSrtTix      res 1
ctrlSrtTix      res 1
ctrlEndTix      res 1
' driver inputs
tgt_incr        res 1       ' current user requested target increment
sv_tgt_incr     res 1       ' holding area for prior value
' control loop variables
drv_incr        res 1       ' current driver increment (v); its acceleration a is accel_now_, in the status run
' PL-160 (DRIVER_REV 38): jerkStep's working registers, live only within the call (was prior_incr and the old ramp's three).
'  DRIVER_REV 41 (C1): jrk_e, jrk_s and jrk_j live at adc_modes' three longs and jrk_lim at calibPeriod's; jrk_x stays here
jrk_x           res 1       ' x*(E): the largest acceleration a pure ramp-out at J lands from

' driver actual
angle_          res 1       ' current driver angle
prior_angle     res 1       ' prior driver angle
fwdrev          res 1       ' driver current direction used for indexing into hall angle table
bridge          res 1       ' R17.1: the bridge state this frame, one of the BR_* states (see their CON)
' R19.3: lowy_tbl -- each undriven bridge state's low-side Y, indexed by BR_* from BR_SHORT; keep these three in order
lowy_tbl        res 1       ' [BR_SHORT] 0: low sides constantly on (set at start)
coast_y         res 1       ' [BR_COAST] R17.1: the PWM frame value; Y = frame holds a pin constantly HIGH (set once at start)
lowy_brake      res 1       ' [BR_BRAKE] 0 (on) in a period's first brake_on_ frames, else coast_y (off); undrivenPins, per frame
lowy_probe      res 1       ' [BR_PROBE] coast_y: every low side off, then undrivenPins switches the probed phase (set at start)
fault_stop      res 1       ' R19.3: T/F where T means a re-synced fault's stop is pending: commands read as 0 until at rest
force_seen      res 1       ' R19.3 TEST-USE: the last force_seq_ a fault took
brake_frame     res 1       ' PL-129: the undriven frame's place in BR_BRAKE's period, 0..BRAKE_PERIOD_FRAMES-1
fault_clr_seen  res 1       ' task 3616: the last fault_clr_ a drive pass consumed
curr_stop       res 1       ' current stop mode
lag_s           res 1       ' C-5: signed lag this pass, + when the rotor trails the field in the direction of motion
duty_cap_       res 1       ' PL-55: duty ceiling, duty_max_ except while ramping down
duty0           res 1       ' PL-55: duty_ where the current ramp-down started
incr0           res 1       ' PL-55: |drv_incr| where the current ramp-down started
duty_ff         res 1       ' R18.4 D-1: the duty this pass's field speed needs, from feedForward
servo_acc       res 1       ' R18.4 D-2: the trim's accumulator; duty_ = duty_ff + servo_acc SAR servo_shift_
' debug variables
{
tmp_angle_      res 1       ' TEST: holding area while validating angle
prior_angle_    res 1
delta_incr_     res 1
prior_drv_      res 1
'}

' temp hold areas
' used when tracking down PWM drive problem...
'driveUsav_      res 1       ' unmodified value from cordic math

' PIN names -  single-pin variables, 14 pins, pwm x is not used
pin_adc_u_i     res 1       ' basepin + 0
pin_adc_v_i     res 1       ' basepin + 1
pin_adc_w_i     res 1       ' basepin + 2
pin_adc_x_i     res 1       ' basepin + 3
pin_adc_cur_i   res 1       ' basepin + 4
pin_hall_u      res 1       ' basepin + 5
pin_hall_v      res 1       ' basepin + 6
pin_hall_w      res 1       ' basepin + 7
pin_pwm_u_l     res 1       ' basepin + 8
pin_pwm_u_h     res 1       ' basepin + 9
pin_pwm_v_l     res 1       ' basepin + 10
pin_pwm_v_h     res 1       ' basepin + 11
pin_pwm_w_l     res 1       ' basepin + 12
pin_pwm_w_h     res 1       ' basepin + 13
hall_port       res 1       ' PL-90: REG_INA or REG_INB, the port holding the three hall inputs (set once at start)
hall_shift      res 1       ' PL-90: pin_hall_u's bit within that port (set once at start)

'  ADC variables
gio_levels      res 4
vio_levels                      ' vio and scl are never used at the same time, so overlap
scl_levels      res 4
' ------------------------------
'  PRECISE FORMAT:
'   copied in-to driver each loop iteration
params_ptr_ res 1           ' params_ptr must be followed by:
offset_fwd_ res 1           '  27 (DRVR_PARAMS_LONGS_COUNT) parameters, offset_fwd_ .. sense_zero_, in the hub run's order
offset_rev_ res 1
duty_min_   res 1           ' minimum duty cycle for pwm
duty_max_   res 1           ' maximum duty cycle for pwm
servo_shift_ res 1          ' R18.4 D-2: the trim's accumulator shift (SERVO_ACC_SHIFT)
ff_ceiling_ res 1           ' R18.4 D-1: the ceiling increment the feedforward scales duty_max_ by
dead_gap_   res 1           ' gap between driving high and low side pwm
accel_dn_   res 1           ' PL-160: the slow-down acceleration limit, A while |v| falls (was ramp_down_)
cfg_ctcks_  res 1           ' clocks for drv loop
stop_mode_  res 1           ' float or brake mode
e_stop_     res 1           ' ES_*: ES_OFF, or the kind of stop latched (PL-132); non-zero stops all motor function
accel_up_   res 1           ' PL-160: the speed-up acceleration limit, A while |v| grows (was ramp_max_)
jerk_up_    res 1           ' PL-160: the speed-up jerk, J while |v| grows (was ramp_min_)
jerk_dn_    res 1           ' PL-160: the slow-down jerk, J while |v| falls (was ramp_inc_)
i_limit_k_  res 1           ' S-2: current-limit threshold factor, mV per duty count << 16 (see currentLimitK())
duty_floor_ res 1           ' S-2: the duty below which the fold's estimate is floored: m = 0.1, raised by setFoldLimit() (PL-163)
hold_duty_  res 1           ' R19.1: the duty applied at rest (DCS_STOPPED), front-written
hold_short_ res 1           ' R19.1: T/F where T means the hold at rest (SM_BRAKE) has handed off to the phase short
fault_mode_ res 1           ' R19.3: FR_SHIPPED or FR_GRADED
brake_on_   res 1           ' R19.3: BR_BRAKE's shorted frames per BRAKE_PERIOD_FRAMES (PL-129)
probe_phase_ res 1          ' R19.4: PRB_* the continuity probe drives at rest (restBridge, undrivenPins)
force_seq_  res 1           ' R19.3 TEST-USE: advanced by testForceFault(); a driven frame whose force_seen differs faults
fault_clr_  res 1           ' task 3616: advanced by the front cog to clear DCS_FAULTED; a drive pass whose fault_clr_seen differs clears it
probe_sink_ res 1           ' R19.4 1e TEST-USE: PRB_* whose low side the probe holds ON, PRB_NONE for none
probe_y_    res 1           ' R19.4 1e TEST-USE: the probed phase's high-side Y, 0 for 50 % (bias)
drv_release_ res 1          ' PL-138: non-zero asks for the release (passEnd -> driverRelease)
sense_zero_ res 1           ' PL-146 (DRIVER_REV 37): the DC-link rest offset, mV, the fold-back nets out; the LAST parameter

' ------------------------------
'  PRECISE FORMAT:
'   copied out-of driver each loop iteration
drive_u_    res 1           ' 24 (DRVR_STATUS_LONGS_COUNT) contiguous longs for return data structure
drive_v_    res 1
drive_w_    res 1
sense_u_    res 1
sense_v_    res 1
sense_w_    res 1
sense_i_    res 1
hall_       res 1
pos_        res 1
duty_       res 1
err_        res 1
loop_dtcks_ res 1
loop_ctcks_ res 1
drv_state_  res 1           ' enum: DCS_STOPPED, DCS_SPIN_UP, DCS_AT_SPEED, DCS_SPIN_DN, etc
hall_missed_  res 1         ' hall code changed with no countable single step (missed transition), zeroed at driver start
hall_illegal_ res 1         ' entries into an illegal hall code, %000 in the low word, %111 in the high (PL-90), zeroed at driver start
drv_incr_s_ res 1           ' copy of drv_incr, the field's increment per drive pass, for the front cog's stop timing
lag_held_   res 1           ' R18.1: passes where the limiter withheld the field advance -- unbounded, zeroed at driver start
duty_capped_ res 1          ' R18.1: passes where the duty demand exceeded the cap -- unbounded, zeroed at driver start
fault_resyncs_ res 1        ' R19.3: faults answered by a re-sync and a controlled stop -- unbounded, zeroed at driver start
foldback_cnt_ res 1         ' R20.1: frames the current fold-back lowered duty_ -- unbounded, zeroed at driver start (hub foldback_frames)
accel_now_  res 1           ' PL-160 (DRIVER_REV 38): the generator's acceleration a, the signed change of drv_incr per drive pass --
                            '  jerkStep's state (hub drv_accel_now); zeroed at driver start and at rest
stop_passes_ res 1          ' PL-161 (DRIVER_REV 39): the stop plan's drive passes to rest, from the pass after the one that set it
                            '  (hub drv_stop_passes); planStage writes it nine frames after each drive pass, zeroed at driver start
stop_fp_    res 1           ' PL-161: the stop plan's field travel to rest, 1/256 hall tick, the LAST status long (hub drv_stop_fp)
' fault is here... (but external only)
' PL-161 (DRIVER_REV 39): the stop planner's working registers (planStage, planA .. planC, run, rampOut, planFp)
plan_stage      res 1       ' 0 idle; 1 .. 9: the stage the next frame runs (.endRqst sets 1 every drive pass)
' DRIVER_REV 41 (C1): the other 17 live at start-only longs (see the note at `driver`), each labelled there:
'  at the entry code, pl_v   in: v; then V, the speed as each run starts
'                     pl_a   in: a; then alpha, the acceleration toward rest
'                     pl_P   the plan's passes
'                     pl_Ul, pl_Uh   the U sum, (n - 1) V + (n + 1) v_end over the runs, 64-bit (low, high)
'  at loadOverlay,    pl_Dl, pl_Dh   the D sum, d (n^3 - n) / 2 over the runs, 64-bit signed (low, high)
'                     pl_n   the run's passes
'                     pl_f   the run's first acceleration toward rest (signed)
'  at the constants,  pl_d (all_pins), pl_c (pwmt), pl_t (pwmn), pl_u (fram), pl_q (numerator),
'                     sc_v (sync_required), sp_P (lutCodePtr), sp_F (planCodePtr)

' $1f8 for reg cogs
    fit     496  ' 484 USED, 12 FREE, 2026-09-27 (DRIVER_REV 42, memory reduction WP2: countIllegal's 13 longs back in cog
                 ' RAM, C2; 471 at DRIVER_REV 41, WP1; 492 at DRIVER_REV 39/40, 403 at DRIVER_REV 38) -- read from the
                 ' compiler, never hand-counted (a hand count here once ran ~80 short): `pnut-ts -l isp_bldc_motor.spin2`,
                 ' PLAN_STAGE's VALUE, whose top 12 bits are its cog address ($1E3, the last register, so USED is $1E4). LUT
                 ' code runs at cog speed (2 clocks, p2kb p2kbPasm2ExecutionModes) but instruction operands reach only cog
                 ' RAM, so REGISTERS are what this budget is for; code can live in the LUT images below (task 3535), read
                 ' the same way (DRIVER_REV 42): the start image, lutCodeStart $200 to lutCodeEnd $290, 144 longs, and the
                 ' run image loaded over it, runCodeStart $200 to runCodeEnd $3DC, 476 of 512 longs (36 free). Until
                 ' DRIVER_REV 41 the LUT held 507 resident longs, with the planner's 126-long overlay over the start sequence.

' =========================================================================
'  LUT CODE ($200-$3FF), TWO IMAGES AT THE SAME ADDRESSES (DRIVER_REV 42, memory reduction WP2, C2):
'  - the START IMAGE, lutCodeStart .. lutCodeEnd: the start sequence (task 3535) and driveinit, block-loaded by the
'    entry code at coginit (lutCodePtr);
'  - the RUN IMAGE, runCodeStart .. runCodeEnd: every routine the drive loop uses (gettgtincr, the per-drive-pass
'    routines R18.4 added, PL-160's jerkStep, the bridge routines, the release, and PL-161's stop planner), block-
'    loaded over the start image by loadOverlay (cog RAM, planCodePtr) as the start sequence's last act.
'  The partition is by call graph: the start image calls only cog RAM (wait4adc, countIllegal, checkstop and its
'  initAngleFmHall, loadOverlay) and its own driveinit; nothing in cog RAM or the run image calls into the start
'  image. So no run-image address is reached before the load, and no start-image address after it. countIllegal,
'  the one routine both need, lives in cog RAM. LUT use is the larger image; the start image costs none.
'  LUT code runs at cog speed, but operands reach only cog RAM, so every REGISTER stays above and any CODE may live
'  here (P13); crossing between the two is an ordinary 4-clock branch.
'
'  MUST stay textually after the `fit 496` line above: this block's hub bytes
'  must not sit between two org-0 items (see the note at the loader's `jmp
'  #lutCodeStart`, above) -- COGINIT's contiguous cog-$000-$1F7-from-hub copy
'  depends on the org-0 image's hub layout being unbroken.
' =========================================================================
                org     $200

lutCodeStart
                rdlong  tmpX, ptra++                    ' get base pin
                or      all_pins, tmpX                  '  finish the all-pins variable
                add     drive_pins, tmpX                '  finish the drive-pins variable
                add     adc_pins, tmpX                  '  finish the adc-pins variable

                mov     tmpY, #0                        ' make the single-pin variables
.pin            altd    tmpY, #pin_adc_u_i              ' only 14, dont use last 2
                mov     0-0, tmpX
                add     tmpX, #1
                incmod  tmpY, #13                   wc
    if_nc       jmp     #.pin

                ' PL-90: the three hall inputs sit in one 32-pin port for every legal base, so choose that port and
                '  the shift once, here; every hall read is then one INA/INB read (see REG_INA)
                mov     hall_shift, pin_hall_u
                and     hall_shift, #PORT_PIN_MASK      ' pin_hall_u's bit within its port
                mov     hall_port, #REG_INA
                testb   pin_hall_u, #PORT_B_BIT     wc  ' Q: pins 32..63, port B?
    if_c        mov     hall_port, #REG_INB
                ' PL-90: filter each hall input through global filt1 (HALL_IN_FILT1). DIR is low, as it always is on
                '  these pins, which is the state WRPIN requires; the smart-pin mode stays %00000 (a plain input)
                mov     tmpY, pin_hall_u
                or      tmpY, #(HALL_PIN_SPAN << 6)     ' pin_hall_u addpins 2: all three hall inputs
                wrpin   ##HALL_IN_FILT1, tmpY

                rdlong  params_ptr_, ptra++             ' get parameters pointer
                add     ptra, #2*4                      '  point to return data, targetIncre is at long index [-1]
                                                        '                        targetAngle is at long index [-2]

                dirl    all_pins                        ' disable PWM and ADC pins for configuration

                ' PL-138: every gate is held OFF, actively, from here to driveinit (the sense calibration, and the park
                '  waiting for ATN). pwmt/pwmn are P_OE modes, whose output is enabled REGARDLESS OF DIR, and a PWM smart
                '  pin held in reset (DIR low) outputs LOW (p2kbArchSmartPins, p2kbArchSmartPin01000PwmTriangle):
                '  - a high side in pwmt with DIR low outputs LOW, so it is OFF, and may wait there;
                '  - a low side in pwmn with DIR low would output HIGH, which is ON: all three low sides ON is a phase
                '    short no bridge state asked for. So the low sides are NOT put in pwmn here: they stay plain pins
                '    (mode 0) driven LOW (OFF) until driveinit gives them their mode, right before the DIR raise.
                wrpin   pwmt, pin_pwm_u_h               ' high sides: PWM true, off while DIR is low
                wrpin   pwmt, pin_pwm_v_h
                wrpin   pwmt, pin_pwm_w_h
                outl    pin_pwm_u_l                     ' low sides: OUT low, then mode 0 (never assume an earlier lifetime's
                outl    pin_pwm_v_l                     '  release or pinclear cleared its pwmn: stop() may not have run), then
                outl    pin_pwm_w_l                     '  DIR high -- driven LOW, which is OFF
                wrpin   #0, pin_pwm_u_l
                wrpin   #0, pin_pwm_v_l
                wrpin   #0, pin_pwm_w_l
                dirh    pin_pwm_u_l
                dirh    pin_pwm_v_l
                dirh    pin_pwm_w_l

                wxpin   fram, drive_pins                '  and set PWM frame width, too, matches adc period
                wypin   #0, drive_pins                  ' high sides Y = 0 (off) once driveinit raises their DIR
                mov     coast_y, fram                   ' R17.1: the frame period is X[31:16]; Y = frame holds a triangle-PWM
                shr     coast_y, #16                    '  pin constantly HIGH (p2kbArchSmartPin01000PwmTriangle), BR_COAST's low-side value
                mov     lowy_probe, coast_y             ' R19.4: BR_PROBE starts from all low sides off, as COAST does

                ' ADC setup - GIO level
                wrpin   adc_modes+0, adc_pins           ' switch ADC to GIO calibration

                ' PL-32 (P2AN001 source_switch_flush): a single-frame read after a source switch
                ' carries the switch's settling transient and is not safe to keep for the cog's
                ' lifetime -- see PL-32 for the measured per-start zero drift this caused. Rather
                ' than software-loop N separate 1-frame reads (the fit budget below has no room
                ' for that loop; see the ABI-adjacent size note at the driver's `fit` line), widen
                ' the smart pin's own count period to ADC_CAL_AVG_FRAMES normal frames, so ONE
                ' hardware-integrated read here sums that many clean samples in silicon. The first
                ' widened frame still carries the switch transient (now diluted 1/ADC_CAL_AVG_FRAMES
                ' by the longer window) so it is discarded like any other flush read, satisfying
                ' P2AN001's discard-then-sum shape with more margin, not less. calibPeriod is a
                ' driver working register (not part of the Spin2<->PASM2 ABI); tmpX/tmpY are
                ' re-initialized before .ctlMotor runs.
                mov     calibPeriod, adc_fram
                shl     calibPeriod, #ADC_CAL_AVG_SHIFT ' calibPeriod := adc_fram * ADC_CAL_AVG_FRAMES
                wxpin   calibPeriod, adc_pins           ' count period widened for calibration only
                wypin   #0, adc_pins

                dirh    adc_pins                        ' enable ADC pins to use adc

                call    #wait4adc                      ' 1st widened frame: still carries the switch
                rdpin   tmpX, pin_adc_cur_i             ' transient (diluted) -- discard it

                call    #wait4adc                      ' 2nd widened frame: settled, hardware-summed
                rdpin   gio_levels+0, pin_adc_u_i       ' over ADC_CAL_AVG_FRAMES normal-frame periods
                rdpin   gio_levels+1, pin_adc_v_i
                rdpin   gio_levels+2, pin_adc_w_i
                rdpin   gio_levels+3, pin_adc_cur_i
                shr     gio_levels+0, #ADC_CAL_AVG_SHIFT ' back to a single-frame-equivalent count
                shr     gio_levels+1, #ADC_CAL_AVG_SHIFT ' (power-of-two average, sum / ADC_CAL_AVG_FRAMES)
                shr     gio_levels+2, #ADC_CAL_AVG_SHIFT
                shr     gio_levels+3, #ADC_CAL_AVG_SHIFT

                ' ADC setup - VIO level
                dirl    adc_pins                        ' disable ADC pins for configuration
                wrpin   adc_modes+1, adc_pins           ' switch ADC to VIO calibration
                dirh    adc_pins                        ' enable ADC to use adc
                                                         ' (count period is still calibPeriod: WXPIN
                                                         ' persists across a WRPIN mode change, exactly
                                                         ' as the original single-frame code relied on)

                call    #wait4adc                      ' discard the switch transient (as for GIO, above)
                rdpin   tmpX, pin_adc_cur_i

                call    #wait4adc                      ' settled, hardware-summed frame
                rdpin   vio_levels+0, pin_adc_u_i
                rdpin   vio_levels+1, pin_adc_v_i
                rdpin   vio_levels+2, pin_adc_w_i
                rdpin   vio_levels+3, pin_adc_cur_i
                shr     vio_levels+0, #ADC_CAL_AVG_SHIFT
                shr     vio_levels+1, #ADC_CAL_AVG_SHIFT
                shr     vio_levels+2, #ADC_CAL_AVG_SHIFT
                shr     vio_levels+3, #ADC_CAL_AVG_SHIFT

                sub     vio_levels+0, gio_levels+0      ' sub gio from vio to get range
                sub     vio_levels+1, gio_levels+1      ' sub gio from vio to get range
                sub     vio_levels+2, gio_levels+2      ' sub gio from vio to get range
                sub     vio_levels+3, gio_levels+3      ' sub gio from vio to get range

                qdiv    numerator, vio_levels+0         ' calculate our values from readings
                qdiv    numerator, vio_levels+1
                qdiv    numerator, vio_levels+2
                qdiv    numerator, vio_levels+3

                getqx   scl_levels+0                    ' getqx waits for the results, but need to get result before next is written
                getqx   scl_levels+1
                getqx   scl_levels+2
                getqx   scl_levels+3


                ' finally, configure the current sense pins for main loop
                dirl    adc_pins                        ' disable ADC pins for configuration
                wxpin   adc_fram, adc_pins              ' restore the normal (un-widened) count period,
                                                         ' see the calibPeriod comment block, above

                 ' ADC setup for actual values
               wrpin   adc_modes+2, adc_pins            ' switch ADC to pin sampling

                testb   sync_required, #0           wc  ' do we need to wait for attention?
    if_c        waitatn                                 ' Y: wait to be atn by caller

                call    #driveinit                     ' enable ADC and PWM pins, leaving the hall pins undriven
                                                        ' from now on, the adc and pwm run continously

                mov     pos_, #0                        ' reset pos
                mov     hall_missed_, #0                ' integrity counts restart with every driver start
                mov     hall_illegal_, #0
                mov     lag_held_, #0                   ' R18.1: the health counters restart with them
                mov     duty_capped_, #0
                mov     fault_resyncs_, #0              ' R19.3: and the re-sync count, with no stop pending,
                mov     foldback_cnt_, #0               ' R20.1: and the fold-back count,
                mov     fault_stop, #0
                mov     force_seen, #0                  '  and no forced fault (init() zeroes force_seq too),
                mov     fault_clr_seen, #0              '  and no fault clear (init() zeroes fault_clr too)
                mov     lowy_tbl, #0                    '  and BR_SHORT's low-side Y (lowy_tbl's first entry),
                mov     brake_frame, #0                 '  and BR_BRAKE's period at its start (PL-129)
                alts    hall_port                      ' prime hall_ from a real read: first control pass then sees old == new
                mov     hall_, 0-0                      '  (PL-90: one INA/INB read; hall pins are inputs, nothing ever raises their DIR)
                shr     hall_, hall_shift
                and     hall_, #%111
                mov     tmpY, hall_                     ' a sensor already reading an illegal code at start is counted
                call    #countIllegal                   '  now, in its own word -- old == new on the first pass cannot
                mov     loop_dtcks_, #0                 ' just in case
                mov     loop_ctcks_, #0                 ' just in case
                mov     drv_incr, #0                    ' reset incr to stopped
                mov     accel_now_, #0                  ' PL-160: and no acceleration (the generator's state)
                mov     stop_passes_, #0                ' PL-161: and no stop to plan until the first drive pass plans one
                mov     stop_fp_, #0
                mov     plan_stage, #0
                mov     tgt_incr, #0                    ' just in case
                mov     err_, #0                        ' DRIVER_REV 41: the first drive pass runs before any frame, and its
                                                        '  `mov lag_s, err_` read COGINIT's copy of whatever hub bytes follow
                                                        '  the image: with a command already pending, the lag gate and
                                                        '  LAG_HOLD acted on it. The rotor has not moved: no lag. This long
                                                        '  was `mov sv_tgt_incr, #0`, a dead store: sv_tgt_incr's one reader,
                                                        '  gettgtincr, has one caller, .noEStop, which writes it just before
                                                        '  that call on every pass
                mov     fwdrev, #0                      ' just in case
                mov     angle_, #0                      ' just in case
                mov     prior_angle, angle_             ' .ctlMotor's first cmpm reads prior_angle; only initAngleFmHall
                                                        '  sets it, and at start checkstop calls it only in SM_BRAKE (its
                                                        '  modz _nz inverts the SM_FLOAT test) -- so a start in SM_FLOAT,
                                                        '  the default, read a register COGINIT never initialised (task
                                                        '  3535 review; direction corrected 2026-09-14)

                ' do initial read of parms so control loop can use them
                setq    #DRVR_PARAMS_LONGS_COUNT-1      ' load fresh parameter table (DRVR_PARAMS_LONGS_COUNT longs)
                rdlong  params_ptr_+1, params_ptr_

                mov     duty_, duty_min_                ' reset duty
                mov     duty_cap_, duty_max_            ' PL-55: no ceiling before the first drive pass sets it
                mov     incr0, #0                       ' PL-55: no ramp-down recorded yet
                mov     duty_ff, #0                     ' R18.4 D-1: no field speed yet, so no feedforward
                mov     servo_acc, duty_                ' R18.4 D-2: the trim starts at what is applied, duty_min_
                shl     servo_acc, servo_shift_
                mov     curr_stop, stop_mode_           ' save current stop mode
                call    #checkstop                     ' set drive on or off according to stop mode

                jmp     #loadOverlay                    ' boundary crossing: LUT -> cog RAM; DRIVER_REV 42: the run image is
                                                        '  loaded over this start image there, then the 2 kHz loop begins

    ' -------------------------------------------------------------------------
    ' driveinit also moved here (task 3535): it is used only by the start
    ' sequence just above, so it is part of the start image. It is never fallen
    ' into -- it is reached only by CALL -- so its position after the jmp above
    ' is dead space, same as the equivalent cog-resident layout.
    ' -------------------------------------------------------------------------
driveinit                                               ' init drive pwm
                dirh    adc_pins                        ' enable ADC pins (base+0..4)
                ' PL-138: the low sides take pwmn only here, in one unbroken run up to the DIR raise. WRPIN needs DIR low
                '  (p2kbPasm2Wrpin), and a pwmn pin with DIR low outputs HIGH (ON), so from the first WRPIN below to the
                '  dirh the low sides are ON: 10 instructions, about 20 clocks (74 ns at 270 MHz), under the boards'
                '  250 ns minimum dead time. The high sides are OFF throughout (pwmt in reset outputs LOW), so no phase
                '  has both sides on. Nothing may be inserted in this run: no wait, call or branch.
                dirl    pin_pwm_u_l
                dirl    pin_pwm_v_l
                dirl    pin_pwm_w_l
                wrpin   pwmn, pin_pwm_u_l               ' low side is inverted: the window opens here
                wrpin   pwmn, pin_pwm_v_l
                wrpin   pwmn, pin_pwm_w_l
                wxpin   fram, pin_pwm_u_l               ' the frame width, as the high sides have it
                wxpin   fram, pin_pwm_v_l
                wxpin   fram, pin_pwm_w_l
                wypin   coast_y, pin_pwm_u_l            ' R17.1: the bridge comes up COASTING when DIR rises -- with Y = 0 on the
                wypin   coast_y, pin_pwm_v_l            '  inverted low sides it came up SHORTED for the frame before the control
                wypin   coast_y, pin_pwm_w_l            '  loop first wrote the stop mode's state
                dirh    drive_pins                      ' enable PWM pins (base+8..13): the window closes here
                                                        ' the ADC and PWM smart pins are never disabled after this.
                                                        ' Never DIRH the whole 0..13 range: it spans the hall inputs (base+5..7) and
                                                        ' drives them low, and the first hall read after start then sees an illegal code
                                                        ' before the 3.9k pull-up recovers. ADC enabled two instructions ahead of PWM is
                                                        ' harmless: each ADC count spans exactly one PWM frame (adc_fram = frame_cnt), and
                                                        ' a whole period of a periodic signal integrates the same at any start phase.
    _ret_       mov     bridge, #BR_DRIVE               ' driven; checkstop, called before the control loop, sets the stop mode's state

lutCodeEnd                                              ' the LUT START IMAGE ends here (task 3535; DRIVER_REV 42)

                fit     $400  ' LUT RAM boundary; the start image is 144 of 512 longs, read from the compiler 2026-09-27 at DRIVER_REV 42 (LUTCODEEND's VALUE)

' =========================================================================
'  THE LUT RUN IMAGE (DRIVER_REV 42, memory reduction WP2, C2): every routine that runs only once the drive loop has
'  started, the stop planner's core included (until DRIVER_REV 41 that core was a separate 126-long overlay over the
'  spent start sequence, the rest resident beneath it). loadOverlay (cog RAM) block-loads it over the start image,
'  from planCodePtr (set by init()), then enters the drive loop. Nothing may call into this block before that load:
'  the start image and the cog routines it calls reach no label here. Like the start image, it must stay after every
'  org-0 item in the file.
' =========================================================================
                org     $200
runCodeStart

gettgtincr                                              ' task 3535: used only by drvMotor (cog-resident; a cross-boundary call)
                rdlong  tgt_incr, ptra[-1]              ' get rate of increment ( +/- drive power, or 0 stop)
                tjz     fault_stop, #.take              ' R19.3: no re-synced fault's stop pending: take the command as written
    _ret_       mov     tgt_incr, #0                    '  pending: the driver reads 0 until it is at rest (.endAtZero clears it)
.take           testb   tgt_incr, #31               wc  ' bit 31 is used to carry sync info
    if_c        pollatn                             wz  ' need to sync, but dont want to wait so if atn not ready
    if_c_and_nz mov     tgt_incr, sv_tgt_incr           ' reset tgt_incr, if wanting atn and not received it yet
    if_c_and_z  bitl    tgt_incr, #31                   ' have the atn, so
    if_c_and_z  wrlong  tgt_incr, ptra[-1]              ' let caller know we have taken it by clearing sync bit
    _ret_       signx   tgt_incr, #30                   ' sign extend back to normal tgt_incr

passEnd                                                 ' called once per drive pass, at .endRqst, which every path of the pass reaches
                tjnz    drv_release_, #driverRelease    ' PL-138: stop() asked for the release. This pass's bridge state is decided
                                                        '  and no pin has taken it yet (.ctlMotor writes the Y values next), so the
                                                        '  release overrides whichever BR_* state it is, e-stop and fault included.
                                                        '  A JMP out of this CALL: driverRelease never returns. Else fall through
feedForward                                             ' R18.4 D-1: duty_ff := |drv_incr| * duty_max_ / ff_ceiling_, at most duty_max_
                abs     tmpY, drv_incr                  '  Steady duty is the back-EMF line, measured at 167-174 per 1e6 of
                qmul    tmpY, duty_max_                 '  increment on both motors (DRIVE-INTEGRATION-DESIGN.md 5.1), and
                getqx   tmpY                            '  duty_max_ over the power table's ceiling increment is that line
                getqy   tmpX                            '  (165 at 18.5 V) -- so the servo no longer integrates the ramp's
                setq    tmpX                            '  rising voltage demand, only what is left. Per drive pass; the
                qdiv    tmpY, ff_ceiling_               '  64-bit product's high long stays far below the divisor.
                getqx   duty_ff
    _ret_       fles    duty_ff, duty_max_

holdDecay                                               ' R18.4 D-5: called on a pass the lag limiter held the field. While
                cmp     drv_state_, #DCS_AT_SPEED   wz  '  running or spinning up, the field's rate falls toward the rate the
    if_z        mov     drv_state_, #DCS_SPIN_UP        '  rotor achieves, so the release of a load is a ramp back up, never a
                cmp     drv_state_, #DCS_SPIN_UP    wz  '  step (PL-160: jerkStep ramps it back, from an acceleration its lag
                abs     tmpX, drv_incr                  '  gate has already eased toward 0). A stop or a direction change in
                cmp     tmpX, ##DRV_INCR_FLOOR      wc  '  progress is left alone. NEVER TO ZERO: a field decayed to 0 would
    if_z_and_nc mov     tmpY, drv_incr                  '  read as at rest and zero the lag the blocked-motor protective stop
    if_z_and_nc sar     tmpY, #HOLD_DECAY_SHIFT         '  needs. So the decay stops at DRV_INCR_FLOOR (was ramp_min_, which
    if_z_and_nc sub     drv_incr, tmpY                  '  DRIVER_REV 38 reused as jerk_up_). The compare is unconditional:
                ret                                     '  an AUGS'd instruction is not given a condition here

    ' -------------------------------------------------------------------------
    ' PL-160 (DRIVER_REV 38): THE JERK-LIMITED TRAJECTORY GENERATOR, once per drive pass while not at rest (drvMotor's
    '  .running). State: v = drv_incr and a = accel_now_, the signed change of v per pass. Parameters: the speed-up
    '  pair (accel_up_, jerk_up_) and the slow-down pair (accel_dn_, jerk_dn_); applyRamps() makes each jerk its limit
    '  over RAMP_TAU_MS, so nothing here divides to find one.
    '  Each pass, with e = tgt - v, s = sign(e) (or -sign(a) when e is 0), E = |e| and alpha = s a:
    '   - the side toward s grows |v| when v is 0 or has s's sign (the speed-up pair), else sheds it (the slow-down
    '     pair): J and A are that side's;
    '   - x*(E) = the largest alpha from which a pure ramp-out at J (alpha, alpha - J, ... while positive) changes v by
    '     at most E: m the largest with J m (m + 1) / 2 <= E, h = m (m + 1) / 2, x* = (E + J h) / (m + 1) (floored);
    '   - U = the jerk-limited step toward A: alpha + J, at most A; from above A (a lowered limit, or the side a
    '     reversal's crossing hands over) alpha - Jx, at least A; and an alpha on the far side of s (alpha < 0, still
    '     pushing the other way) unwinds by Jx to exactly 0. Jx = max(jerk_up_, jerk_dn_): an acceleration outside
    '     its own side's ramp unwinds at the larger jerk, so a stop read mid-speed-up never coasts on for seconds;
    '   - the lag gate: with the field ahead of the rotor by LAG_SOFT or more in the way a pushes (sign(a) x err_, or
    '     s x err_ at a = 0), U is instead alpha - J, at least 0: the acceleration eases to 0 rather than freezing
    '     (the old ramps froze the increment, a step of acceleration);
    '   - alpha' = min(U, max(alpha - J, x*)): as hard as the jerk and the limit allow, but never beyond x*, so the
    '     ramp-out lands v exactly on the target; then a' = s alpha' and v' = v + a'.
    '  A stop (target 0) never takes v through zero: v' at or past it is v = 0, a = 0, at rest (C = 1). That costs an
    '  acceleration step only when a stop is read just before a reversal's crossing, the one case x* < alpha - J.
    '  A drive's arrival (v' = target) is AT_SPEED and returns C = 0, so the field advances on the arrival pass (the
    '  DRIVER_REV 34 kick fix); a keeps that last step (at most J) and the next pass at the target ends it at 0, as it
    '  ends any |a| up to Jx there (a larger one, a new target set at v mid-ramp, is pushed against). The state is only
    '  reported: SLOW_TO_CHG while v' is on the
    '  far side of zero from the target, SPIN_UP while |v'| < |target|, else SPIN_DN; a reversal crosses zero in one
    '  continuous ramp and never stops there. planA .. planC (the stop planner, PL-161) are this rule's closed form,
    '  for the front cogs' limits.
    '  Uses tmpX, tmpY, jrk_*; one QDIV, QSQRT, QMUL and QDIV (about 230 clocks); C is the result, Z is not kept.
    ' -------------------------------------------------------------------------
jerkStep
                mov     jrk_e, tgt_incr
                subs    jrk_e, drv_incr             wz  ' e := tgt - v  (Z: e is 0; |tgt|, |v| < 2^30, so no overflow)
    if_nz       mov     tmpY, jrk_e                     ' s: toward the target ...
    if_nz       jmp     #.haveS
                abs     tmpY, accel_now_                ' at the target: an arrival's last step (at most J) ends here,
                mov     tmpX, jerk_up_                  '  a jerk of at most Jx, as does any |a| up to Jx
                fge     tmpX, jerk_dn_                  ' Jx
                cmp     tmpX, tmpY                  wc  ' Q: |a| > Jx (a new target set at v, mid-ramp)?
    if_nc       jmp     #.steady                        ' NO: at speed, a := 0
                neg     tmpY, accel_now_                ' YES: ... or, e being 0, against a
.haveS          testb   tmpY, #31                   wc  ' C: s < 0
                wrc     jrk_s                           ' jrk_s := 1 when s < 0 (WRC writes no flag)
                abs     jrk_e                           ' E := |e| (no flag written)
    if_c        neg     accel_now_                      ' alpha := s a, in place; a' is written back below
                ' the side toward s: the speed-up pair when v is 0 or has s's sign, else the slow-down pair
                testb   drv_incr, #31               wc  ' C: v < 0
                testb   jrk_s, #0                   xorc ' C: v's sign is not s's, so pushing toward s sheds |v|
                cmp     drv_incr, #0                wz  ' Z: v is 0 (either way grows |v|)
    if_c_and_nz mov     jrk_j, jerk_dn_
    if_c_and_nz mov     jrk_lim, accel_dn_
    if_nc_or_z  mov     jrk_j, jerk_up_
    if_nc_or_z  mov     jrk_lim, accel_up_
                fge     jrk_j, #1                       ' J is at least 1 (applyRamps() ensures it; the QDIV needs it)
                call    #xStar                          ' x*(E), the largest alpha a pure ramp-out at J lands from (PL-161,
                                                        '  DRIVER_REV 39: the same instructions, moved out for the stop planner)
                ' U, the jerk-limited step toward A
                mov     tmpY, jerk_up_
                fge     tmpY, jerk_dn_                  ' Jx := max(jerk_up_, jerk_dn_)
                mov     tmpX, accel_now_
                cmps    accel_now_, #0              wc  ' Q: alpha < 0, a still pushing away from s?
    if_c        add     tmpX, tmpY                      '  YES: it unwinds by Jx, to exactly 0 at most
    if_c        fles    tmpX, #0
    if_c        jmp     #.haveU
                cmps    jrk_lim, accel_now_         wc  ' Q: A < alpha, above this side's limit?
    if_nc       add     tmpX, jrk_j                     '  NO: up by J, to A at most
    if_nc       fles    tmpX, jrk_lim
    if_c        sub     tmpX, tmpY                      '  YES: down by Jx, to A at least
    if_c        fges    tmpX, jrk_lim
.haveU          ' the lag gate (C-5's LAG_SOFT): the rotor lag in the way a pushes
                mov     jrk_e, err_                     ' (E is spent)
                testb   jrk_s, #0                   wc
    if_c        neg     jrk_e                           ' s x err_ ...
                cmps    accel_now_, #0              wc
    if_c        neg     jrk_e                           ' ... x sign(alpha): sign(a) x err_, or s x err_ when a is 0
                cmps    jrk_e, #LAG_SOFT            wc  ' Q: the field ahead of the rotor by LAG_SOFT or more, a's way?
    if_c        jmp     #.notHeld
                cmps    accel_now_, #0              wc  ' YES: alpha >= 0 eases toward 0 by J (alpha < 0 already
    if_nc       mov     tmpX, accel_now_                '  unwinds toward 0); the increment keeps moving, never a
    if_nc       sub     tmpX, jrk_j                     '  step of acceleration
    if_nc       fges    tmpX, #0
.notHeld        mov     tmpY, accel_now_
                sub     tmpY, jrk_j                     ' alpha - J, the least the jerk allows
                fges    tmpY, jrk_x                     ' max(alpha - J, x*)
                fles    tmpY, tmpX                      ' alpha' := min(U, max(alpha - J, x*))
                mov     accel_now_, tmpY
                testb   jrk_s, #0                   wc
    if_c        neg     accel_now_                      ' a' := s alpha'
                mov     tmpY, drv_incr                  ' v, kept for the stop's zero test
                adds    drv_incr, accel_now_            ' v' := v + a'
                tjnz    tgt_incr, #.driving             ' a drive's target: its arrival and state below
                cmp     drv_incr, #0                wz  ' the stop: Q: v' at zero, or through it?
                testb   drv_incr, #31               wc
                testb   tmpY, #31                   xorc ' C: v' and v differ in sign
    if_c_or_z   jmp     #.atRest
                mov     tmpX, #DCS_SPIN_DN              ' not yet: slowing to the stop
                jmp     #.report
.atRest         mov     drv_incr, #0                    ' at rest: the field stops AT zero, never through it
                mov     accel_now_, #0
    _ret_       modc    _set                        wc  ' C = 1: at rest (the caller's .endAtZero)
.driving        cmp     drv_incr, tgt_incr          wz  ' Q: arrived? (a keeps this pass's step, at most J; the next pass,
    if_z        mov     tmpX, #DCS_AT_SPEED             '  at the target, ends it -- a zeroed here would let a new command
    if_z        jmp     #.report                        '  on that next pass step the acceleration by up to 2J)
                mov     tmpX, #DCS_SLOW_TO_CHG
                testb   drv_incr, #31               wc
                testb   tgt_incr, #31               xorc ' C: v' and the target differ in sign
                cmp     drv_incr, #0                wz
    if_c_and_nz jmp     #.report                        ' v' on the far side of zero: a reversal before its crossing
                mov     tmpX, #DCS_SPIN_UP
                abs     tmpY, drv_incr
                abs     jrk_e, tgt_incr
                cmp     tmpY, jrk_e                 wc  ' Q: |v'| < |target|?
    if_nc       mov     tmpX, #DCS_SPIN_DN
.report         cmp     tmpX, #DCS_SPIN_DN          wz  ' PL-55: record where a ramp-down starts, for the duty ceiling,
    if_nz       cmp     tmpX, #DCS_SLOW_TO_CHG      wz  '  on the pass the state first turns down (was .capStart, taken
    if_nz       jmp     #.stateOut                      '  on each slowing request; a ramp-down now continues its line)
                cmp     drv_state_, #DCS_SPIN_DN    wz
    if_nz       cmp     drv_state_, #DCS_SLOW_TO_CHG wz
    if_nz       mov     duty0, duty_
    if_nz       abs     incr0, drv_incr
.stateOut       mov     drv_state_, tmpX
    _ret_       modc    _clr                        wc  ' C = 0: the field advances this pass (.justIncr)
.steady         mov     accel_now_, #0                  ' at speed: v unchanged, a ended
                mov     drv_state_, #DCS_AT_SPEED
    _ret_       cmp     tgt_incr, #1                wc  ' C = 1 only for a target of 0 with the field at 0 (at rest)

undrivenPins                                            ' R19.3/R19.4: once per frame while the bridge is not driven; writes C only,
                mov     force_seen, force_seq_          '  R19.3: a forced fault asked for while undriven is dropped, never kept for later
                cmp     brake_frame, brake_on_      wc  ' PL-129: C = this frame is in BR_BRAKE's shorted slice, and the
                incmod  brake_frame, #BRAKE_PERIOD_FRAMES - 1  '  period advances (entering BR_BRAKE sets it to 0, a shorted frame)
    if_c        mov     lowy_brake, #0                  '  shorted slice: low sides on, as BR_SHORT
    if_nc       mov     lowy_brake, coast_y             '  the rest: all six off, as BR_COAST
                wypin   #0, drive_pins                  '  so the caller's Z survives. Y = 0 on all six: high sides off, low sides on,
                alts    bridge, #lowy_tbl - BR_SHORT    '  then each low side takes its state's Y from lowy_tbl: SHORT 0 (on),
                mov     tmpX, 0-0                       '  COAST frame (off: all six FETs off), BRAKE 0 or frame (the slice above:
                wypin   tmpX, pin_pwm_u_l               '  the graded short), PROBE frame (off)
                wypin   tmpX, pin_pwm_v_l
                wypin   tmpX, pin_pwm_w_l
                cmp     bridge, #BR_PROBE           wc  ' Q: the continuity probe?
    if_nc       tjnz    probe_phase_, #.probe           ' YES, with a phase to drive
                ret
.probe          mov     tmpX, probe_phase_              ' the probed phase's pins: u_l,u_h / v_l,v_h / w_l,w_h are consecutive
                sub     tmpX, #PRB_U
                shl     tmpX, #1
                mov     tmpY, bias                      ' 50 %, the low side complementary with its dead gap, exactly as the drive
                cmp     probe_y_, #1                wc  '  writes a phase whose level is 0 (see the BR_DRIVE writes in .ctlMotor);
    if_nc       mov     tmpY, probe_y_                  '  R19.4 1e: or the winding check's own level (C only: Z is the caller's)
                add     tmpY, dead_gap_
                alts    tmpX, #pin_pwm_u_l
                wypin   tmpY, 0-0                       ' low side: the level plus the dead gap, complementary
                sub     tmpY, dead_gap_
                alts    tmpX, #pin_pwm_u_h
                wypin   tmpY, 0-0                       ' high side: the level
                tjz     probe_sink_, #.probeEnd         ' R19.4 1e: a return phase asked for?
                mov     tmpX, probe_sink_               ' YES: its low side ON (Y = 0, inverted), its high side already off,
                sub     tmpX, #PRB_U                    '  so the probed phase's current returns through the DC-link shunt
                shl     tmpX, #1
                alts    tmpX, #pin_pwm_u_l
                wypin   #0, 0-0
.probeEnd       ret

restBridge                                              ' R19.1: once per drive pass while a stop request finds the motor at rest
                tjz     probe_phase_, #.noProbe         ' R19.4: the start-time continuity probe asked for?
    _ret_       mov     bridge, #BR_PROBE               ' YES: undrivenPins switches the probed phase
.noProbe        cmp     bridge, #BR_PROBE           wz  ' Q: a probe just ended?
    if_z        call    #checkstop                      ' YES: the bridge takes the stop mode's state again
                cmp     curr_stop, stop_mode_       wz  ' Q: did the stop mode change at rest?
    if_nz       mov     curr_stop, stop_mode_           ' YES: the bridge takes the new mode now
    if_nz       call    #checkstop
                cmp     stop_mode_, #SM_BRAKE       wz  ' Q: holding at rest?
    if_nz       ret                                     ' NO: SM_FLOAT coasts, there is nothing to hold
                tjz     hold_short_, #driveFromRest     ' the hold is wanted: a bridge left shorted is re-aligned and driven
    _ret_       mov     bridge, #BR_SHORT               ' the front cog handed the hold off (slip or time limit): phases shorted

driveFromRest                                           ' R19.1: about to drive from rest, or to hold again after a hand-off
                cmp     bridge, #BR_DRIVE           wz  ' Q: already driven? (SM_BRAKE held at rest keeps its field)
    if_z        ret
                mov     duty_, duty_min_                ' coasting or shorted: reset duty, which reduces jerk if not fully aligned,
                mov     bridge, #BR_DRIVE               '  drive the bridge,
                jmp     #initAngleFmHall                '  and seed the field from the halls (the rotor moved); returns to our caller

faultResponse                                           ' R19.3: called from the fault test, |err_| >= 125 while driven. Uses tmpX
                wrlong  maxNeg, ptra[DRVR_STATUS_LONGS_COUNT] '  only (tmpY carries |err_| on to the servo). Every fault is reported
                cmp     fault_mode_, #FR_GRADED     wz  ' Q: the graded response?
    if_nz       jmp     #.blunt                         ' NO: FR_SHIPPED takes the stop mode's fault bridge at once
                tjnz    fault_stop, #.blunt             ' a second fault on a re-synced stop: control is gone
                mov     tmpX, hall_
                and     tmpX, #%111                     ' this pass's hall code
                cmp     tmpX, #%000                 wz
    if_nz       cmp     tmpX, #%111                 wz
    if_z        jmp     #.blunt                         ' an illegal code: the halls cannot re-seed the field
                mov     fault_stop, #1                  ' RE-SYNC: commands read as 0 until the front cog's stop arrives, so the
                add     fault_resyncs_, #1              '  driver ramps down; counted, so the front cog writes that stop and reports it;
                testb   fwdrev, #0                  wc  '  and the field is re-seeded from the halls in the way the field was moving,
                jmp     #initAngleFmHallC               '  not the command's (a ramp to zero reads 0, FWD). Returns to our caller
.blunt          mov     fault_stop, #0                  ' a hard fault ends any pending re-sync stop: the latch below governs now
                mov     drv_state_, #DCS_FAULTED       ' the driver is FAULTED until the front cog clears it (fault_clr_)
                mov     bridge, #BR_SHORT               ' FR_SHIPPED brakes with the full short,
                cmp     fault_mode_, #FR_GRADED     wz
    if_z        mov     bridge, #BR_BRAKE               '  FR_GRADED with the graded one,
    if_z        mov     brake_frame, #0                 '  opening on its shorted slice (PL-129; the only entry to BR_BRAKE)
                cmp     stop_mode_, #SM_FLOAT       wz
    if_z        mov     bridge, #BR_COAST               '  and SM_FLOAT coasts in either mode
                ret

estopBridge                                             ' PL-132: called once, as the stop latches (writes Z)
                mov     bridge, #BR_SHORT               ' ES_HARD, and ES_PROTECT under SM_BRAKE: the phases shorted
                cmp     e_stop_, #ES_PROTECT        wz  ' Q: a protective stop?
    if_z        cmp     stop_mode_, #SM_FLOAT       wz  ' YES: and the user chose to coast?
    if_z        mov     bridge, #BR_COAST               ' YES: all six FETs off
                ret

driverRelease                                           ' PL-138 (W3, W4): reached only from passEnd, once stop() has set drv_release.
                                                        '  Every gate is OFF throughout, but for each low side's one-instruction
                                                        '  window in step 3 (and each gate pin is undriven for the one instruction
                                                        '  between its WRPIN #0 and its DRVL). Never returns
                ' 1. COAST, as BR_COAST does: high sides Y = 0 (off), low sides Y = coast_y (inverted: off). A triangle
                '    PWM pin takes a new Y at its next frame start (p2kbArchSmartPins live_update_behavior, pwm_triangle),
                '    and each write here only turns a FET OFF, so no order of them puts both sides of a phase ON.
                wypin   #0, pin_pwm_u_h
                wypin   #0, pin_pwm_v_h
                wypin   #0, pin_pwm_w_h
                wypin   coast_y, pin_pwm_u_l
                wypin   coast_y, pin_pwm_v_l
                wypin   coast_y, pin_pwm_w_l
                ' 2. hold the coast RELEASE_WAIT_FRAMES frames. adc_fram is frame_cnt clocks and a triangle frame is
                '    2 x (frame_cnt / 2) <= frame_cnt, and WAITX waits 2 + D clocks (p2kbPasm2Waitx): so every pin has
                '    captured its coast Y within the first frame and output it for at least one whole frame after.
                mov     tmpX, #RELEASE_WAIT_FRAMES
.coast          waitx   adc_fram
                djnz    tmpX, #.coast
                ' 3. every gate is OFF. Each gate pin now drops its smart mode and is held driven OFF, as part 1 holds
                '    the low sides until driveinit. WRPIN needs DIR low (p2kbPasm2Wrpin), a PWM pin in reset outputs LOW
                '    (p2kbArchSmartPin01000PwmTriangle), and mode 0 with DIR low drives nothing (p2kbArchSmartPins,
                '    smart_pin_off: DIR enables output). Per pin: DIRL, WRPIN #0, then DRVL, which sets OUT low and DIR
                '    high in one instruction (p2kbPasm2Drvl): driven LOW, OFF.
                '    High sides (pwmt): LOW in reset, so never ON in this sequence.
                dirl    pin_pwm_u_h
                wrpin   #0, pin_pwm_u_h
                drvl    pin_pwm_u_h
                dirl    pin_pwm_v_h
                wrpin   #0, pin_pwm_v_h
                drvl    pin_pwm_v_h
                dirl    pin_pwm_w_h
                wrpin   #0, pin_pwm_w_h
                drvl    pin_pwm_w_h
                '    Low sides (pwmn): an inverted PWM pin in reset outputs HIGH, which is ON, from its DIRL to its WRPIN:
                '    one instruction apart, 2 clocks (7.4 ns at 270 MHz) if WRPIN reaches the pin with DIR's 3-clock
                '    latency (p2kbPasm2Drvl gives DIR's; p2kb gives none for WRPIN). One low side at a time, every high
                '    side OFF: no phase has both sides on and no two low sides are on together, so no two FETs are
                '    ever ON at once. Nothing may go between a DIRL and its WRPIN.
                dirl    pin_pwm_u_l                     ' U low side ON: the window opens
                wrpin   #0, pin_pwm_u_l                 '  mode 0, DIR low: undriven, the window closes
                drvl    pin_pwm_u_l                     '  driven LOW, OFF
                dirl    pin_pwm_v_l
                wrpin   #0, pin_pwm_v_l
                drvl    pin_pwm_v_l
                dirl    pin_pwm_w_l
                wrpin   #0, pin_pwm_w_l
                drvl    pin_pwm_w_l
                dirl    adc_pins                        ' the ADC pins (inputs): reset, then plain
                wrpin   #0, adc_pins                    ' (the hall inputs keep their filter until stop()'s pinclear)
                mov     drv_state_, #DCS_RELEASED       ' only now, so DCS_RELEASED means every gate is let go
                setq    #DRVR_STATUS_LONGS_COUNT-1      ' the status run, once, as .ctlMotor writes it: stop() waits for this
                wrlong  drive_u_, ptra
.park           waitatn                                 ' parked, doing nothing, until stop()'s cogstop. Nothing ATNs a released
                jmp     #.park                          '  driver, and one that did would only go round again (p2kbPasm2Waitatn)

    ' -------------------------------------------------------------------------
    ' PL-161 (DRIVER_REV 39): x*(E), jerkStep's own arithmetic, moved out of it unchanged so the stop planner shares it.
    '  In: jrk_e = E (0 <= E < 2^31), jrk_j = J (at least 1). Out: jrk_x = x*(E), the largest acceleration from which a
    '  pure ramp-out at J (x, x - J, ... while positive) changes the speed by at most E: m the largest with
    '  J m (m + 1) / 2 <= E, h = m (m + 1) / 2, x* = (E + J h) / (m + 1), floored. Uses tmpX, tmpY; writes C only.
    '  One QDIV, QSQRT, QMUL and QDIV, each waited for before the next is issued.
    ' -------------------------------------------------------------------------
xStar
                mov     tmpY, jrk_e
                shl     tmpY, #1                        ' 2E: E < 2^31, so no bit is lost
                qdiv    tmpY, jrk_j
                getqx   tmpY                            ' t := 2E / J
                qsqrt   tmpY, #0                        ' {0, t} (p2kbPasm2Qsqrt: S is the high long)
                getqx   tmpX                            ' m := isqrt(t) ...
                mov     jrk_x, tmpX
                add     jrk_x, #1
                mul     jrk_x, tmpX                     ' m (m + 1): E < 2^31 and J >= 1, so m < 65_536 and
                cmp     tmpY, jrk_x                 wc  '  MUL's 16 x 16 bits hold both factors. Q: t < m (m + 1)?
    if_c        sub     tmpX, #1                        ' ... the largest m with m (m + 1) <= t, i.e. J m (m + 1) / 2 <= E
                mov     tmpY, tmpX
                add     tmpY, #1                        ' m + 1
                mov     jrk_x, tmpY
                mul     jrk_x, tmpX
                shr     jrk_x, #1                       ' h := m (m + 1) / 2
                qmul    jrk_x, jrk_j
                getqx   jrk_x                           ' J h, at most E
                add     jrk_x, jrk_e                    ' E + J h, at most 2E
                qdiv    jrk_x, tmpY
    _ret_       getqx   jrk_x                           ' x* := (E + J h) / (m + 1)

    ' -------------------------------------------------------------------------
    ' PL-161 (DRIVER_REV 39): one run of the stop plan -- n passes whose acceleration toward rest is first, first + d,
    '  first + 2d, ... -- added to the plan. In: pl_n = n (0: nothing), pl_f = first (signed), pl_d = d (signed; 0, or
    '  n at most 65_535), pl_v = V, the speed as the run starts. Out: pl_P += n; pl_v = the speed as it ends,
    '  v_end = V - n first - d n (n - 1) / 2; and the run's travel, SUM(i = 1..n) v_i with v_i = V - i first -
    '  d i (i - 1) / 2 = n V - first n (n + 1) / 2 - d (n^3 - n) / 6, kept as 6 x SUM = 3 [(n - 1) V + (n + 1) v_end]
    '  + d (n^3 - n) / 2 (exact: no division), in two 64-bit sums: pl_Uh:pl_Ul += (n - 1) V + (n + 1) v_end and
    '  pl_Dh:pl_Dl += d (n^3 - n) / 2. Keeps pl_n and pl_c.
    '  Up to five QMULs, each waited for before the next is issued. Uses pl_t, pl_u, pl_q; writes C and Z.
    ' -------------------------------------------------------------------------
run
                cmp     pl_n, #0                    wz  ' Q: an empty run?
    if_z        ret
                add     pl_P, pl_n                      ' its passes
                mov     pl_t, pl_n
                sub     pl_t, #1
                qmul    pl_t, pl_v                      ' (n - 1) V, 64-bit
                getqx   pl_q
                getqy   pl_u
                add     pl_Ul, pl_q                 wc
                addx    pl_Uh, pl_u
                abs     pl_t, pl_f                  wc  ' |first|; C: first < 0
                qmul    pl_t, pl_n                      ' n |first|: at most V + |first|, inside a long
                getqx   pl_q
    if_c        neg     pl_q                            ' n first (GETQX and QMUL leave C)
                sub     pl_v, pl_q
                mov     pl_t, pl_n
                sub     pl_t, #1
                mul     pl_t, pl_n                      ' n (n - 1): exact for n < 65_536, and only ever multiplied by d,
                shr     pl_t, #1                        '  which is 0 in the one run longer (the plateau)
                abs     pl_q, pl_d                  wc  ' |d|; C: d < 0
                qmul    pl_t, pl_q                      ' |d| n (n - 1) / 2, inside a long
                getqx   pl_u
    if_c        neg     pl_u
                sub     pl_v, pl_u                      ' V := v_end
                mov     pl_t, pl_n
                add     pl_t, #1
                qmul    pl_t, pl_v                      ' (n + 1) v_end, 64-bit
                getqx   pl_q
                getqy   pl_u
                add     pl_Ul, pl_q                 wc
                addx    pl_Uh, pl_u
                tjz     pl_d, #.runEnd                  ' d = 0 (the plateau, and the unwind's last pass): no d term
                mov     pl_t, pl_n
                mul     pl_t, pl_n
                sub     pl_t, #1                        ' n^2 - 1 (n < 65_536 whenever d is not 0)
                qmul    pl_t, pl_n
                getqx   pl_t                            ' n^3 - n, inside a long for n < 1_625
                shr     pl_t, #1                        ' (n^3 - n) / 2: (n - 1) n (n + 1) is even
                abs     pl_q, pl_d
                qmul    pl_t, pl_q                      ' |d| (n^3 - n) / 2, 64-bit
                getqx   pl_q
                getqy   pl_u
                testb   pl_d, #31                   wz  ' Z: d < 0
    if_nz       add     pl_Dl, pl_q                 wc
    if_nz       addx    pl_Dh, pl_u
    if_z        sub     pl_Dl, pl_q                 wc
    if_z        subx    pl_Dh, pl_u
.runEnd         ret

    ' -------------------------------------------------------------------------
    ' PL-161 (DRIVER_REV 39): THE STOP PLAN, computed by the driver so the front cogs only read it. Called from
    '  .ctlMotor's loop, after a frame's status write, on the nine frames after each drive pass (plan_stage 1 .. 9),
    '  one third of one plan a frame (planA, planB, planC), so a frame's worst case fits its slack at 160 MHz:
    '  - stages 1-3: the plan from this pass's (v, a) -- a stop the next pass takes (m = 1);
    '  - stages 4-6 and 7-9: the plan after a TAKE PASS -- the next pass having already read its command, so the stop
    '    is taken by the pass after (m = 2) -- at each end of the take pass's reachable accelerations, a' = a - Jx and
    '    a' = a + Jx (v' = v + a'), plus the take pass itself (one pass, |v'| of travel).
    '  THE TAKE PASS UNDER ANY COMMAND: whatever that pass reads (the command this pass took, a new one the front wrote
    '  after this pass read its own, a synchronized command released since, a stop) and whatever its lag gate does,
    '  jerkStep gives a' within [a - Jx, a + Jx], Jx = max(jerk_up_, jerk_dn_): alpha' >= min(U, alpha - J) >=
    '  alpha - Jx and alpha' <= U <= alpha + Jx on every branch (the unwind, above the limit, the rise, the lag
    '  gate), and at a target |a| <= Jx gives 0; a stop reaching rest only shortens it. The plan after the take pass
    '  is longest at an end of that range (from rest out to either end it only grows: more speed, more push away
    '  from rest), so the two ends bound every command without knowing which one the pass will read.
    '  stop_passes_ is the largest passes-to-rest of the three, counted from the pass after this one; stop_fp_ the
    '  largest travel, 1/256 hall tick. Published by the status write of the tenth frame after the pass (~230 us).
    ' -------------------------------------------------------------------------
planStage
                jmprel  plan_stage                      ' to the stage's entry below (1 .. 9)
                ret                                     ' 0: none (never called with 0)
                jmp     #.a0                            ' 1: m = 1, planA
                jmp     #.b                             ' 2: planB
                jmp     #.c0                            ' 3: planC, kept as the m = 1 figure
                jmp     #.aLo                           ' 4: m = 2 at a' = a - Jx, planA
                jmp     #.b                             ' 5: planB
                jmp     #.cT                            ' 6: planC, folded in
                jmp     #.aHi                           ' 7: m = 2 at a' = a + Jx, planA
                jmp     #.b                             ' 8: planB
                jmp     #.cT                            ' 9: planC, folded in, and published
.a0             mov     pl_v, drv_incr
                mov     pl_a, accel_now_
                call    #planA
    if_c        jmp     #.fin0                          ' the plan ended in planA (at rest, the corner, saturated)
    _ret_       mov     plan_stage, #2
.b              call    #planB
    _ret_       add     plan_stage, #1
.c0             call    #planC
.fin0           call    #planFp
                mov     sp_P, pl_P                      ' the m = 1 figure: the running maximum starts here
                mov     sp_F, pl_t
    _ret_       mov     plan_stage, #4
.aLo            mov     pl_a, jerk_up_
                fge     pl_a, jerk_dn_
                neg     pl_a                            ' -Jx
                jmp     #.aT
.aHi            mov     pl_a, jerk_up_
                fge     pl_a, jerk_dn_                  ' +Jx
.aT             add     pl_a, accel_now_                ' a' = a -/+ Jx
                mov     pl_v, drv_incr
                add     pl_v, pl_a                      ' v' = v + a'
                mov     sc_v, pl_v                      ' kept for the take pass's own advance
                call    #planA
    if_c        jmp     #.fold
    _ret_       add     plan_stage, #1
.cT             call    #planC
.fold           add     pl_P, #1                        ' the take pass itself,
                abs     pl_t, sc_v                      '  whose advance is |v'|: 6 |v'| = 3 x (2 |v'|), into the U sum
                shl     pl_t, #1
                add     pl_Ul, pl_t                 wc
                addx    pl_Uh, #0
                call    #planFp
                fge     sp_P, pl_P                      ' the largest passes (unsigned max)
                fge     sp_F, pl_t                      ' the largest travel
                cmp     plan_stage, #7              wc  ' Q: the low end (stage 4 or 6) just done?
    if_c        mov     plan_stage, #7                  ' YES: the high end next
    if_c        ret
                mov     stop_passes_, sp_P              ' NO: both ends done -- publish
                fle     stop_passes_, ##PLAN_PASSES_MAX
                mov     stop_fp_, sp_F
    _ret_       mov     plan_stage, #0

    ' PL-161 (DRIVER_REV 39): the stop planner's core, planA .. rampOut, was a separate overlay over the spent start
    '  sequence until DRIVER_REV 41; since DRIVER_REV 42 (C2) it is ordinary run-image code, loaded with the rest.

    ' -------------------------------------------------------------------------
    ' planA .. planC: the passes and the field travel of the driver's own jerk-limited stop, read at the next pass, from
    '  (v, a) = (pl_v, pl_a), in closed form -- DRIVER_REV 38's Spin2 stopPlan() (PL-160), in integers. The stop runs
    '  jerkStep with target 0: each pass alpha' = min(U, max(alpha - J, x*(E))), E the speed still to shed, where
    '  f(x) = x + (x - J) + ... (terms while positive) is what one pass at x then a pure ramp-out at J sheds, and
    '  x*(E) the largest x with f(x) <= E (xStar). So the stop is at most five runs, each of alpha in arithmetic
    '  progression -- with A = accel_dn_, J = jerk_dn_, Jx = max(jerk_up_, J), V = |v| and alpha = -a sign(v)
    '  at most A:
    '   the corner (alpha - J > x*(V), a stop read just before a reversal's crossing): n, the least with
    '    n alpha - J n (n + 1) / 2 >= V, from the 64-bit root: n = ceil((B - isqrt(B^2 - 8 J V)) / 2J), B = 2 alpha - J,
    '    one pass fewer when n - 1 already reaches V (isqrt is at most one below the root, so n is at most one over);
    '    n - 1 passes from alpha - J down by J, and the n-th at rest;
    '   else 1a. alpha < 0: k = ceil(-alpha / Jx) passes, the first k - 1 from alpha + Jx up by Jx, the k-th at 0
    '    (k over PLAN_UNWIND_MAX saturates the plan);
    '   1b. the rise from y1 = alpha + J up by J, capped at cap = (A - y1) / J + 1 candidates: with R = V - f(y1), the
    '    candidate i fits while J i^2 + 2 y1 i <= R, i.e. (J i + y1)^2 <= y1^2 + J R, so the last is
    '    i = (isqrt(y1^2 + J R) - y1) / J, exactly, and the rise is min(cap, i + 1) (0 when R < 0);
    '   2. the plateau at A when the rise reached cap: (V - f(A)) / A + 1 passes while V >= f(A) (over PLAN_PASSES_MAX
    '    saturates);
    '   3. the ramp-out from x0 = x*(V) down by J: ceil(x0 / J) passes, and one more when J divides x0 and V > f(x0).
    '  Out: pl_P passes (the rest pass included), and the travel as 6 x SUM in pl_Uh:pl_Ul and pl_Dh:pl_Dl (run).
    '  Every square root is QSQRT's 64-bit floor, so no step is float and no correction loop is needed.
    '  Run in three parts on three frames (planStage), the state kept in the pl_ registers between them: planA (the
    '  corner, or the unwind; returns C = 1 when the plan is already complete), planB (the rise), planC (the plateau
    '  and the ramp-out).
    ' -------------------------------------------------------------------------
planA
                mov     pl_P, #0
                mov     pl_Ul, #0
                mov     pl_Uh, #0
                mov     pl_Dl, #0
                mov     pl_Dh, #0
                abs     pl_v, pl_v                  wcz ' V := |v|; C: v < 0; Z: at rest
    if_z        jmp     #.done                          ' at rest: no passes, no travel
    if_nc       neg     pl_a                            ' alpha, toward rest: -a for a forward field
                fles    pl_a, accel_dn_                 ' at most A
                mov     jrk_j, jerk_dn_
                mov     jrk_e, pl_v
                call    #xStar                          ' x*(V)
                mov     pl_f, pl_a
                sub     pl_f, jerk_dn_                  ' alpha - J
                cmps    jrk_x, pl_f                 wc  ' Q: x*(V) < alpha - J, the corner?
    if_c        jmp     #planCorner                     ' (cog RAM, for room; it returns for us, with C = 1)
                cmps    pl_a, #0                    wc  ' 1a. Q: alpha < 0, still pushing away from rest?
    if_nc       ret                                     ' NO: C = 0, planB next
                mov     pl_d, jerk_up_
                fge     pl_d, jerk_dn_                  ' Jx
                mov     pl_t, pl_d
                sub     pl_t, #1
                sub     pl_t, pl_a                      ' Jx - 1 - alpha
                qdiv    pl_t, pl_d
                getqx   pl_n                            ' k = ceil(-alpha / Jx)
                cmp     pl_n, ##PLAN_UNWIND_MAX + 1 wc  ' Q: an unwind too long to sum (a limit lowered mid-ramp)?
    if_nc       jmp     #planSat
                sub     pl_n, #1
                mov     pl_f, pl_a
                add     pl_f, pl_d                      ' alpha + Jx, then up by Jx
                call    #run
                mov     pl_n, #1                        ' the k-th pass, at 0
                mov     pl_f, #0
                mov     pl_d, #0
                call    #run
                mov     pl_a, #0
    _ret_       modc    _clr                        wc  ' C = 0: planB next
.done   _ret_   modc    _set                        wc  ' C = 1: the plan is complete

planB           mov     pl_f, pl_a
                add     pl_f, jerk_dn_                  ' 1b. y1
                mov     pl_c, #0                        ' cap
                mov     pl_n, #0                        ' the rise
                cmps    accel_dn_, pl_f             wc  ' Q: A < y1, no candidate?
    if_c        jmp     #.riseRun
                mov     pl_t, accel_dn_
                sub     pl_t, pl_f
                qdiv    pl_t, jerk_dn_
                getqx   pl_c
                add     pl_c, #1                        ' cap
                mov     pl_t, pl_f
                call    #rampOut                        ' f(y1)
                subr    pl_t, pl_v                      ' R = V - f(y1)
                cmps    pl_t, #0                    wc
    if_c        jmp     #.riseRun                       ' R < 0: no pass of the rise fits
                qmul    pl_f, pl_f
                getqx   pl_u
                getqy   pl_q                            ' y1^2
                qmul    pl_t, jerk_dn_
                getqx   pl_t
                getqy   pl_d                            ' J R
                add     pl_u, pl_t                  wc
                addx    pl_q, pl_d                      ' y1^2 + J R, 64-bit
                qsqrt   pl_u, pl_q
                getqx   pl_t                            ' its floor root, at least y1
                sub     pl_t, pl_f
                qdiv    pl_t, jerk_dn_
                getqx   pl_n
                add     pl_n, #1
                fle     pl_n, pl_c                      ' the rise: min(cap, i + 1)
.riseRun        mov     pl_d, jerk_dn_
                jmp     #run                            ' (the rise, y1, J); run keeps pl_n and pl_c for planC

planC           cmp     pl_n, pl_c                  wz  ' 2. Q: did the rise reach A?
    if_nz       jmp     #.rampOut
                mov     pl_t, accel_dn_
                call    #rampOut                        ' f(A)
                subr    pl_t, pl_v                      ' V - f(A)
                cmps    pl_t, #0                    wc
    if_c        jmp     #.rampOut
                qdiv    pl_t, accel_dn_
                getqx   pl_n
                add     pl_n, #1                        ' the plateau's passes
                cmp     pl_n, ##PLAN_PASSES_MAX + 1 wc
    if_nc       jmp     #planSat
                mov     pl_f, accel_dn_
                mov     pl_d, #0
                call    #run
.rampOut        cmp     pl_v, #0                    wz  ' 3. Q: any speed left?
    if_z        ret
                mov     jrk_e, pl_v
                call    #xStar                          ' x0 = x*(V)
                mov     pl_f, jrk_x
                mov     pl_t, pl_f
                add     pl_t, jerk_dn_
                sub     pl_t, #1
                qdiv    pl_t, jerk_dn_
                getqx   pl_n                            ' ceil(x0 / J)
                getqy   pl_u                            ' J - 1 exactly when J divides x0
                mov     pl_q, jerk_dn_
                sub     pl_q, #1
                cmp     pl_u, pl_q                  wz  ' Q: J divides x0?
    if_z        mov     pl_t, pl_f
    if_z        call    #rampOut                        ' f(x0) (rampOut writes no flag)
    if_z        cmp     pl_t, pl_v                  wc  ' Q: f(x0) < V: the remainder takes its own last pass?
    if_z_and_c  add     pl_P, #1
                neg     pl_d, jerk_dn_
                jmp     #run                            ' (ceil(x0 / J), x0, -J); run's return is ours
planSat         modc    _set                        wc  ' a plan too long to count (C = 1: complete): a limit fires at once
                mov     pl_P, ##PLAN_PASSES_MAX
    _ret_       mov     pl_Uh, ##$0100_0000             ' 6 x SUM >= 2^56 (any D is under 2^44): planFp saturates it

    ' -------------------------------------------------------------------------
    ' rampOut: f(x) = x + (x - J) + (x - 2J) + ... (terms while positive), the speed one pass at x sheds followed by a
    '  pure ramp-out at J (planB, planC). In: pl_t = x (1 to A). Out: pl_t. With t = ceil(x / J) - 1 = (x - 1) / J,
    '  f = (t + 1) x - J t (t + 1) / 2. Uses pl_u, pl_q; writes no flag (the caller's Z and C survive).
    ' -------------------------------------------------------------------------
rampOut
                mov     pl_q, pl_t
                sub     pl_q, #1
                qdiv    pl_q, jerk_dn_
                getqx   pl_q                            ' t
                mov     pl_u, pl_q
                add     pl_u, #1
                qmul    pl_u, pl_t
                getqx   pl_t                            ' (t + 1) x, inside a long (x <= A, t < A / J + 1)
                mul     pl_u, pl_q                      ' t (t + 1)
                shr     pl_u, #1
                qmul    pl_u, jerk_dn_
                getqx   pl_u
    _ret_       sub     pl_t, pl_u

runCodeEnd                                              ' the LUT RUN IMAGE ends here (DRIVER_REV 42)

                fit     $400  ' LUT RAM boundary; the run image is 476 of 512 longs, read from the compiler 2026-09-27 at DRIVER_REV 42 (RUNCODEEND's VALUE)

