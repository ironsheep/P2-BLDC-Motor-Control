CON

  #true,  ON, OFF
  #false, NO, YES

' possible switch states
  #0, SST_UNKNOWN, SST_OFF, SST_MID, SST_ON

' numbered channels [0-17] -> [1-18]
  #0, CH_00, CH_01, CH_02, CH_03, CH_04, CH_5, CH_06, CH_07
  #8, CH_08, CH_09, CH_10, CH_11, CH_12, CH_13, CH_14, CH_15
  #16, CH_16, CH_17

  MAX_CHANNELS = CH_17 + 1

' same channels, named
  #0, CTL_NADA, CTL_RT_JOY_HZ, CTL_RT_JOY_VT  ' 251 - 1024ish - 1807
  #3, CTL_LT_JOY_VT, CTL_LT_JOY_HZ  ' 251 - 1024ish - 1783
  #5, CTL_VRA, CTL_VRB
  #7, CTL_SW_A, CTL_SW_B, CTL_SW_C, CTL_SW_D

' number of controls for which we track min/max range
  MAX_CTLS = CTL_SW_D + 1

' a debug line built at run time (lineBegin()): its buffer, a local of the method printing it, and its longest text
  LINE_LONGS = 20
  LINE_MAX_CHARS = LINE_LONGS * 4 - 1

OBJ

'    main                                                       ' * master Spin cog
    sbus    : "jm_sbus_rx"                                      ' * s.bus serial input/decoding
    'term    : "isp_serial_singleton"                         ' debug terminal output

' * uses cog when loaded


dat

    Defaults        word    1023, 1023,    0, 1023,    0,    0,    0,    0,    0
                    word       0,    0, 1023, 1023, 1023, 1023, 1023,    0,    0

' NOTE: in following: 0th channel min/max is not used - these are defaults used when cal is not run
'  if your FlySky reports diff values run call in your code and then adjust these values (unless you always want to run cal.)
'  or call starttx and pass in a min/max table
    ctlMinValue     word    0, 246, 248, 250, 254, 240
                    word    240, 240, 240, 240, 240
    ctlMaxValue     word    0, 1807, 1801, 1766, 1786, 1807
                    word    1807, 1807, 1807, 1807, 1807

    validswitches   byte    CTL_SW_A, CTL_SW_B, CTL_SW_C, CTL_SW_D, CTL_NADA
    valid3Ways      byte    CTL_SW_C, CTL_NADA

    bShowDebug      BYTE    FALSE

    pctlMinValue    long    0
    pctlMaxValue    long    0
    pvalidswitches  long    0
    pvalid3Ways     long    0
    maxctrls        long    0

PUB null()
    '' This is not a top-level object
''

pub start(desiredRxPin) : cog
'' Start the SBus receiver on {desiredRxPin} using default channel calibration
''
'' @param desiredRxPin - the pin wired to the receiver's S.BUS output
'' @returns cog - the S.BUS receiver cog's id + 1, or 0 when no cog started

  cog := starttx(desiredRxPin, @ctlMinValue, @ctlMaxValue, @validswitches, @valid3Ways, MAX_CTLS)

pub starttx(desiredRxPin, pctlMin, pctlMax, pvalidsw, pvalid3W, tmaxctrls) : cog
'' Configure IO and objects for application
'' config of min/max channel values
'' config allowed switch and 3way switches
''
'' @param desiredRxPin - the pin wired to the receiver's S.BUS output
'' @param pctlMin - pointer to the table of per-control minimum readings (words)
'' @param pctlMax - pointer to the table of per-control maximum readings (words)
'' @param pvalidsw - pointer to the CTL_NADA-terminated list of switch channels
'' @param pvalid3W - pointer to the CTL_NADA-terminated list of 3-position switch channels
'' @param tmaxctrls - controls in the min/max tables
'' @returns cog - the S.BUS receiver cog's id + 1, or 0 when no cog started

    longmove(@pctlMinValue, @pctlMin, 5)
    bShowDebug := FALSE ' default
    cog := sbus.start(desiredRxPin, @Defaults)                                ' start s.bus rx
    if cog == 0
        showText(@"!!ERROR!!  failed to start SBUS Cog")
    waitms(250)
    showSbus()

pub stop()
    '' Stop cogs, release pins
''

    sbus.stop()

PUB showDebug(bEnable) | lineBuf[LINE_LONGS]
    '' TESTING: show, hide debug output
''
'' @param bEnable - T/F where T turns this object's debug output on

' Local Variables:
' @local lineBuf - the debug line being built (see lineBegin())

    if bEnable <> FALSE ' force 0 or -1
        bEnable := TRUE
    if bShowDebug <> bEnable
        ' prints "- showDebug(0) - now OFF" or "- showDebug(-1) - now ON"
        lineBegin(@lineBuf, @"- showDebug(")
        lineSdec(@lineBuf, bEnable)
        lineText(@lineBuf, (not bEnable) ? @") - now OFF" : @") - now ON")
        showText(@lineBuf)
   bShowDebug := bEnable

PUB readChannel(chan) : retValue | validChan
    '' Return value of given FlySky Control
''
'' @param chan - the receiver channel [1-18]
'' @returns retValue - the channel's raw value [0-2047]

' Local Variables:
' @local validChan - {chan} clamped to a legal channel

    validChan := 1 #> chan <# MAX_CHANNELS                      ' legal SBUS Rcvr channel
    retValue := sbus.read(validChan)                        ' get value from receiver [0-2047]
    if bShowDebug
        'term.fstr2(string("- readChannel(%d) - %d\r\n"), chan, retValue)
        showChanRead(@"- readChannel(", chan, @"retValue = ", retValue)

PUB isSwitchOn(swChan) : bOnState
    '' Return T/F where T = switch is ON [swA, swB, swC, swD]
''
'' @param swChan - the switch channel (CTL_SW_A to CTL_SW_D)
'' @returns bOnState - T/F where T means the switch is ON

    bOnState := readSwitch(swChan) == SST_ON

PUB isSwitchOff(swChan) : bOffState
    '' Return T/F where T = switch is OFF [swA, swB, swC, swD]
''
'' @param swChan - the switch channel (CTL_SW_A to CTL_SW_D)
'' @returns bOffState - T/F where T means the switch is OFF

    bOffState := readSwitch(swChan) == SST_OFF

PUB isSwitchMiddle(swChan) : bMiddleState
    '' Return T/F where T = switch is in Middle position (only useful for swC)
''
'' @param swChan - the switch channel (CTL_SW_A to CTL_SW_D)
'' @returns bMiddleState - T/F where T means the switch is in its middle position

    bMiddleState := readSwitch(swChan) == SST_MID
    'debug("- isSwitchMiddle() = ", sdec_Long_(bMiddleState))

PUB readSwitch(swChan) : eSwState
    '' Read switch value and decode into switch state (2-pos sw) [if 3-pos divert to other routine]
''
'' @param swChan - the switch channel (CTL_SW_A to CTL_SW_D)
'' @returns eSwState - SST_ON, SST_MID or SST_OFF; SST_OFF for a channel that is not a switch of that kind

    ifnot checkSwitch(swChan)                                                   ' legal SBUS Rxcvr channel
      eSwState := SST_OFF
      swChan := 0                                                               ' for debug below
    elseif check3Way(swChan)
        eSwState := readSw3Way(swChan)                                          ' a 3-pos switch decodes three states
    else
        eSwState := readChannel(swChan) > 1023 ? SST_OFF : SST_ON
    if bShowDebug
        showChanRead(@"- readSwitch(", swChan, @"eSwState = ", eSwState)

PUB readSw3Way(swChan) : eSwState | rawValue
    '' Read 3-pos switch value and decode into switch state
''
'' @param swChan - the switch channel (CTL_SW_A to CTL_SW_D)
'' @returns eSwState - SST_ON, SST_MID or SST_OFF; SST_OFF for a channel that is not a switch of that kind

' Local Variables:
' @local rawValue - the channel's raw value [0-2047]

    ifnot check3Way(swChan)
      eSwState := SST_OFF                                                       ' not a 3-pos switch: OFF (the unset raw
      swChan := 0                                                               '  value 0 used to decode as ON here)
    else
        rawValue := readChannel(swChan)
        if rawValue < 684   ' bottom 3rd of 0-2047
            eSwState := SST_ON
        else
            eSwState := rawValue < 1367 ? SST_MID : SST_OFF ' bottom 2/3 rds or top 3rd?
    if bShowDebug
        'term.fstr2(string("- readSw3Way(%d) - %d\r\n"), validSwChan, eSwState)
        showChanRead(@"- readSw3Way(", swChan, @"eSwState = ", eSwState)

PUB hasSignal() : bSignal
'' Return T/F where T means the receiver is getting frames from the transmitter (F on frame loss or failsafe)
''
'' @returns bSignal - T/F where F means the channel values are stale or failsafe defaults and must not drive anything

    ' jm_sbus_rx reports the two conditions separately: has_signal() is frames arriving, in_failsafe()
    '  is the receiver substituting its failsafe values because the transmitter is gone
    bSignal := (sbus.has_signal() <> FALSE) and (sbus.in_failsafe() == FALSE)

PUB showSbus()
    '' Show status indication
''

    if (sbus.has_signal())
        'term.fstr0(string("- SBUS OK Online\r\n"))
        showText(@"- SBUS OK Online")
    else
        if (sbus.in_failsafe())
            'term.fstr0(string("- SBUS Error FAILSAFE\r\n"))
            showText(@"- SBUS Error FAILSAFE")
        else
            'term.fstr0(string("- SBUS Error FRAME LOST\r\n"))
            showText(@"- SBUS Error FRAME LOST")

PUB manualCalibrate()
    '' Prompt and let user set controls to get best readings...
''

    'term.fstr0(string("- Calibration - flip swA DOWN to start\r\n"))
    showText(@"- Calibration - flip swA DOWN to start")
    repeat
        if isSwitchOn(CTL_SW_A)
            quit

    'term.fstr0(string("- Calibrate Right Joystick\r\n"))
    showText(@" ")
    showText(@"- Calibrate Right Joystick")
    calJoyStick(CTL_RT_JOY_HZ, CTL_RT_JOY_VT)

    'term.fstr0(string("- Calibrate Left Joystick\r\n"))
    showText(@" ")
    showText(@"- Calibrate Left Joystick")
    calJoyStick(CTL_LT_JOY_HZ, CTL_LT_JOY_VT)

    'term.fstr0(string("- Calibrate Switch A\r\n"))
    showText(@" ")
    showText(@"- Calibrate Switch A")
    calSwitch(CTL_SW_A)
    'term.fstr0(string("- Calibrate Switch b\r\n"))
    showText(@" ")
    showText(@"- Calibrate Switch B")
    calSwitch(CTL_SW_B)
    'term.fstr0(string("- Calibrate Switch C\r\n"))
    showText(@" ")
    showText(@"- Calibrate Switch C")
    calSwitch(CTL_SW_C)
    'term.fstr0(string("- Calibrate Switch D\r\n"))
    showText(@" ")
    showText(@"- Calibrate Switch D")
    calSwitch(CTL_SW_D)

    'term.fstr0(string("- Calibrate Variable A\r\n"))
    showText(@" ")
    showText(@"- Calibrate Variable A")
    calVariable(CTL_VRA)
    'term.fstr0(string("- Calibrate Variable B\r\n"))
    showText(@" ")
    showText(@"- Calibrate Variable B")
    calVariable(CTL_VRB)

    'term.fstr0(string("- END Calibration - flip swA UP to end\r\n"))
    showText(@"- END Calibration - flip swA UP to end")
    showText(@" ")
    repeat
        if isSwitchOn(CTL_SW_A)
            quit


PUB chanMinMax(chan) : minVal, maxVal | validChan
    '' Return calculated min max for given channel
''
'' @param chan - the control channel
'' @returns minVal - the lowest reading recorded for the channel
'' @returns maxVal - the highest reading recorded for the channel

' Local Variables:
' @local validChan - {chan} clamped to a tracked control

    validChan := 0 #> chan <# maxctrls - 1                                      ' legal SBUS Rxcvr channel
    minVal := WORD [pctlMinValue][validChan]
    maxVal := WORD [pctlMaxValue][validChan]

PRI checkctl(swChan, pctllist) : validctl | index
' Return TRUE when a channel appears in a CTL_NADA-terminated list of channels.
'
' @param swChan - the switch channel (CTL_SW_A to CTL_SW_D)
' @param pctllist - pointer to a CTL_NADA-terminated list of channels
' @returns validctl - TRUE when {swChan} is in the list

' Local Variables:
' @local index - index of the list entry being compared

    validctl := FALSE
    index := 0
    repeat until byte[pctllist][index] == CTL_NADA
        if byte[pctllist][index++] == swChan
            validctl := TRUE
            quit

PRI checkSwitch(swChan) : validSwitch
' Return TRUE when a channel is one of the configured switches.
'
' @param swChan - the switch channel (CTL_SW_A to CTL_SW_D)
' @returns validSwitch - TRUE when {swChan} is a configured switch

    validSwitch := checkctl(swChan, pvalidswitches)
    'debug("- checkswitch(", udec_(swChan), ") - ", udec(validswitch))

PRI check3Way(swChan) : valid3Way
' Return TRUE when a channel is one of the configured 3-position switches.
'
' @param swChan - the switch channel (CTL_SW_A to CTL_SW_D)
' @returns valid3Way - TRUE when {swChan} is a configured 3-position switch

    valid3Way := checkctl(swChan, pvalid3Ways)
    'debug("- check3Way(", udec_(swChan), ") - ", udec(valid3Way))

PRI calJoyStick(hzJoyChan, vtJoyChan)
' Calibrate horiz and vert joy stick controls
'
' @param hzJoyChan - the joystick's horizontal channel
' @param vtJoyChan - the joystick's vertical channel

    calJoyStickHz(hzJoyChan)
    calJoyStickVt(vtJoyChan)

PRI calJoyStickVt(vtJoyChan) | legalChan, priorPosn, currPosn, newPosn, deltaPosn, bHaveGoodValue, nSampleCt, chanMin, chanMax
' Calibrate vert joy stick controls
'
' @param vtJoyChan - the joystick's vertical channel

' Local Variables:
' @local legalChan - the channel when it is one this calibration accepts, else 0
' @local priorPosn - the previous reading, -1 before the first
' @local currPosn - the reading being examined
' @local newPosn - the latest reading
' @local deltaPosn - the change between two readings
' @local bHaveGoodValue - TRUE once the readings have settled
' @local nSampleCt - consecutive settled readings
' @local chanMin - the channel's recorded minimum
' @local chanMax - the channel's recorded maximum

    legalChan := 0
    if vtJoyChan == CTL_RT_JOY_VT || vtJoyChan == CTL_LT_JOY_VT
        legalChan := vtJoyChan
    if legalChan <> 0
        repeat 3
            'term.fstr0(string("\r\n- Push Stick FULL UP\r\n"))
            showText(@"- Push Stick FULL UP")
            waitms(2000)
            currPosn := sbus.read(legalChan)                                      ' get value from receiver
            'term.fstr2(string("- init UP chan%d = %d\r\n"), legalChan, currPosn)
            bHaveGoodValue := FALSE
            nSampleCt := 0
            priorPosn := -1
            repeat while not bHaveGoodValue
                newPosn := sbus.read(legalChan)                                      ' get value from receiver
                deltaPosn := abs(currPosn - newPosn)
                'term.fstr3(string("- large UP chan%d = %d (%d)\r\n"), legalChan, newPosn, deltaPosn)
                if newPosn < 1030
                    next    ' insiginificant move, read again
                'term.fstr2(string("- UP chan%d = %d\r\n"), legalChan, newPosn)
                updMinMaxValueForChan(newPosn, legalChan)
                if priorPosn == -1
                    priorPosn := newPosn
                deltaPosn := abs(newPosn - priorPosn)
                if deltaPosn < 5
                    nSampleCt++
                if nSampleCt > 2
                    bHaveGoodValue := TRUE
                'term.fstr3(string("   DBG deltaPosn = %d, nSampleCt = %d, bHaveGoodValue = %d\r\n"), deltaPosn, nSampleCt, bHaveGoodValue)
                priorPosn := newPosn
            'term.fstr0(string("\r\n- Push Stick FULL DOWN\r\n"))
            showText(@"- Push Stick FULL DOWN")
            waitms(2000)
            bHaveGoodValue := FALSE
            nSampleCt := 0
            priorPosn := -1
            repeat while not bHaveGoodValue
                newPosn := sbus.read(legalChan)                                      ' get value from receiver
                deltaPosn := abs(currPosn - newPosn)
                if newPosn > 1020
                    next    ' insiginificant move, read again
                'term.fstr2(string("- DN chan%d = %d\r\n"), legalChan, newPosn)
                updMinMaxValueForChan(newPosn, legalChan)
                if priorPosn == -1
                    priorPosn := newPosn
                deltaPosn := abs(newPosn - priorPosn)
                if deltaPosn < 5
                    nSampleCt++
                if nSampleCt > 2
                    bHaveGoodValue := TRUE
                priorPosn := newPosn
        chanMin, chanMax := chanMinMax(legalChan)
        'term.fstr3(string("- END CAL: Chan%d Vert MIN=%d MAX=%d\r\n\r\n"), legalChan, chanMin, chanMax)
        showCalEnd(legalChan, @" Vert MIN=", chanMin, chanMax)
        waitms(5000)


PRI calJoyStickHz(hzJoyChan) | legalChan, priorPosn, currPosn, newPosn, deltaPosn, bHaveGoodValue, nSampleCt, chanMin, chanMax
' Calibrate horiz joy stick controls
'
' @param hzJoyChan - the joystick's horizontal channel

' Local Variables:
' @local legalChan - the channel when it is one this calibration accepts, else 0
' @local priorPosn - the previous reading, -1 before the first
' @local currPosn - the reading being examined
' @local newPosn - the latest reading
' @local deltaPosn - the change between two readings
' @local bHaveGoodValue - TRUE once the readings have settled
' @local nSampleCt - consecutive settled readings
' @local chanMin - the channel's recorded minimum
' @local chanMax - the channel's recorded maximum

    legalChan := 0
    if hzJoyChan == CTL_RT_JOY_HZ || hzJoyChan == CTL_LT_JOY_HZ
        legalChan := hzJoyChan
    if legalChan <> 0
        repeat 3
            'term.fstr0(string("\r\n- Push Stick FULL RIGHT\r\n"))
            showText(@"- Push Stick FULL RIGHT")
            waitms(2000)
            currPosn := sbus.read(legalChan)                                      ' get value from receiver
            'term.fstr2(string("- init RT chan%d = %d\r\n"), legalChan, currPosn)
            bHaveGoodValue := FALSE
            nSampleCt := 0
            priorPosn := -1
            repeat while not bHaveGoodValue
                newPosn := sbus.read(legalChan)                                      ' get value from receiver
                deltaPosn := abs(currPosn - newPosn)
                'term.fstr3(string("- large RT chan%d = %d (%d)\r\n"), legalChan, newPosn, deltaPosn)
                if newPosn < 1030
                    next    ' insiginificant move, read again
                'term.fstr2(string("- RT chan%d = %d\r\n"), legalChan, newPosn)
                updMinMaxValueForChan(newPosn, legalChan)
                if priorPosn == -1
                    priorPosn := newPosn
                deltaPosn := abs(newPosn - priorPosn)
                if deltaPosn < 5
                    nSampleCt++
                if nSampleCt > 2
                    bHaveGoodValue := TRUE
                'term.fstr3(string("   DBG deltaPosn = %d, nSampleCt = %d, bHaveGoodValue = %d\r\n"), deltaPosn, nSampleCt, bHaveGoodValue)
                priorPosn := newPosn
            'term.fstr0(string("\r\n- Push Stick FULL LEFT\r\n"))
            showText(@"- Push Stick FULL LEFT")
            waitms(2000)
            bHaveGoodValue := FALSE
            nSampleCt := 0
            priorPosn := -1
            repeat while not bHaveGoodValue
                newPosn := sbus.read(legalChan)                                      ' get value from receiver
                deltaPosn := abs(currPosn - newPosn)
                if newPosn > 1030
                    next    ' insiginificant move, read again
                'term.fstr2(string("- LT chan%d = %d\r\n"), legalChan, newPosn)
                updMinMaxValueForChan(newPosn, legalChan)
                if priorPosn == -1
                    priorPosn := newPosn
                deltaPosn := abs(newPosn - priorPosn)
                if deltaPosn < 5
                    nSampleCt++
                if nSampleCt > 2
                    bHaveGoodValue := TRUE
                priorPosn := newPosn
        chanMin, chanMax := chanMinMax(legalChan)
        'term.fstr3(string("- END CAL: Chan%d Horiz MIN=%d MAX=%d\r\n\r\n"), legalChan, chanMin, chanMax)
        showCalEnd(legalChan, @" Horiz MIN=", chanMin, chanMax)
        waitms(5000)

PRI calSwitch(swChan) | legalChan, currPosn, newPosn, deltaPosn, loopNbr, chanMin, chanMax, lineBuf[LINE_LONGS]
' Calibrate a switch channel: record its range over four operator flips.
'
' @param swChan - the switch channel (CTL_SW_A to CTL_SW_D)

' Local Variables:
' @local legalChan - the channel when it is one this calibration accepts, else 0
' @local currPosn - the reading being examined
' @local newPosn - the latest reading
' @local deltaPosn - the change between two readings
' @local loopNbr - which of the four flips this is
' @local chanMin - the channel's recorded minimum
' @local chanMax - the channel's recorded maximum
' @local lineBuf - the debug line being built (see lineBegin())

    legalChan := 0
    if swChan >= CTL_SW_A && swChan <= CTL_SW_D
        legalChan := swChan
    if legalChan <> 0
        repeat loopNbr from 1 to 4
            currPosn := sbus.read(legalChan)                                      ' get initial value from receiver
            'term.fstr2(string("- Flip SWITCH #%d of 4 (try #%d of 4)\r\n"), swChan - CTL_SW_A, loopNbr)
            lineBegin(@lineBuf, @"- Flip SWITCH #")
            lineUdec(@lineBuf, swChan - CTL_SW_A)
            lineText(@lineBuf, @" of 4 (try #")
            lineUdec(@lineBuf, loopNbr)
            lineText(@lineBuf, @" of 4)")
            showText(@lineBuf)
            waitms(1500)
            repeat  ' loop until significant change
                newPosn := sbus.read(legalChan)                                      ' get new value from receiver
                updMinMaxValueForChan(newPosn, legalChan)
                'deltaPosn := currPosn - newPosn
                deltaPosn := abs(currPosn - newPosn)
                'term.fstr1(string("   DBG deltaPosn = %d\r\n"), deltaPosn)
                ' if switch flipped... end this tight loop and move to next...
                if deltaPosn > 1000  ' we use 1000 so that we can ignore SwC mid position
                    ' have Switch flip
                    quit
                waitms(250) ' pause before next read
        chanMin, chanMax := chanMinMax(legalChan)
        'term.fstr3(string("- END CAL: Chan%d MIN=%d MAX=%d\r\n\r\n"), legalChan, chanMin, chanMax)
        showCalEnd(legalChan, @" MIN=", chanMin, chanMax)
        waitms(5000)
    else
        'term.fstr1(string("- ERROR: Bad SWITCH ID: Chan%d\r\n"), legalChan)
        lineBegin(@lineBuf, @"- ERROR: Bad SWITCH ID: Chan")
        lineUdec(@lineBuf, legalChan)
        showText(@lineBuf)


PRI calVariable(varChan) | legalChan, priorPosn, currPosn, deltaPosn, bHaveGoodValue, nSampleCt, chanMin, chanMax
' Calibrate a variable control: record its range as the operator turns it end to end.
'
' @param varChan - the variable-control channel (CTL_VRA or CTL_VRB)

' Local Variables:
' @local legalChan - the channel when it is one this calibration accepts, else 0
' @local priorPosn - the previous reading, -1 before the first
' @local currPosn - the reading being examined
' @local deltaPosn - the change between two readings
' @local bHaveGoodValue - TRUE once the readings have settled
' @local nSampleCt - consecutive settled readings
' @local chanMin - the channel's recorded minimum
' @local chanMax - the channel's recorded maximum

    legalChan := 0
    if varChan >= CTL_VRA && varChan <= CTL_VRB
        legalChan := varChan
    if legalChan <> 0
        repeat 3
            'term.fstr0(string("\r\n- Rotate to Min or Max\r\n"))
            showText(@"- Rotate to Min or Max")
            waitms(2000)
            bHaveGoodValue := FALSE
            nSampleCt := 0
            priorPosn := -1
            repeat while not bHaveGoodValue
                currPosn := sbus.read(legalChan)                                      ' get value from receiver
                'term.fstr2(string("- chan%d = %d\r\n"), legalChan, currPosn)
                updMinMaxValueForChan(currPosn, legalChan)
                if priorPosn == -1
                    priorPosn := currPosn
                deltaPosn := abs(currPosn - priorPosn)
                if deltaPosn < 5
                    nSampleCt++
                if nSampleCt > 2
                    bHaveGoodValue := TRUE
                priorPosn := currPosn
            'term.fstr0(string("\r\n- Rotate to Other end of range\r\n"))
            showText(@"- Rotate to Other end of range")
            waitms(2000)
            bHaveGoodValue := FALSE
            nSampleCt := 0
            priorPosn := -1
            repeat while not bHaveGoodValue
                currPosn := sbus.read(legalChan)                                      ' get value from receiver
                'term.fstr2(string("- other chan%d = %d\r\n"), legalChan, currPosn)
                updMinMaxValueForChan(currPosn, legalChan)
                if priorPosn == -1
                    priorPosn := currPosn
                deltaPosn := abs(currPosn - priorPosn)
                if deltaPosn < 5
                    nSampleCt++
                if nSampleCt > 2
                    bHaveGoodValue := TRUE
                priorPosn := currPosn
        chanMin, chanMax := chanMinMax(legalChan)
        'term.fstr3(string("- END CAL: Chan%d MIN=%d MAX=%d\r\n\r\n"), legalChan, chanMin, chanMax)
        showCalEnd(legalChan, @" MIN=", chanMin, chanMax)
        waitms(5000)

PRI updMinMaxValueForChan(chanValue, chan) : minVal, maxVal | currMinValue, currMaxValue, newValue, validChan
' upd min max for given channel
'
' @param chanValue - the reading to fold into the channel's range
' @param chan - the control channel
' @returns minVal - the channel's minimum after the update
' @returns maxVal - the channel's maximum after the update

' Local Variables:
' @local currMinValue - the channel's minimum before the update
' @local currMaxValue - the channel's maximum before the update
' @local newValue - the candidate new minimum or maximum
' @local validChan - {chan} clamped to a tracked control

    validChan := 0 #> chan <# maxctrls - 1                                      ' legal SBUS Rxcvr channel
    'term.fstr2(string("- UPD Val: Chan%d Val = %d\r\n"), validChan, chanValue)
    if chan == validChan
        currMinValue, currMaxValue := chanMinMax(validChan)
        minVal, maxVal := currMinValue, currMaxValue
        newValue := MIN(chanValue, currMinValue)
        if currMinValue <> newValue
            'term.fstr3(string("- chan%d MIN %d -> %d\r\n"), chan, currMinValue, newValue)
            showRangeChange(chan, @" MIN ", currMinValue, newValue)
            WORD [pctlMinValue][validChan] := newValue
            minVal := newValue

        newValue := MAX(chanValue, currMaxValue)
        if currMaxValue <> newValue
            'term.fstr3(string("- chan%d MAX %d -> %d\r\n"), chan, currMaxValue, newValue)
            showRangeChange(chan, @" MAX ", currMaxValue, newValue)
            WORD [pctlMaxValue][validChan] := newValue
            maxVal := newValue

PRI showChanRead(pLead, chan, pLabel, nValue) | lineBuf[LINE_LONGS]
' Print one channel read: "<lead><chan>) - <label><value>", e.g. "- readChannel(3) - retValue = 1_024".
'
' @param pLead - pointer to the text before the channel number
' @param chan - the channel read
' @param pLabel - pointer to the value's label, e.g. "retValue = "
' @param nValue - the value read

' Local Variables:
' @local lineBuf - the debug line being built (see lineBegin())

    lineBegin(@lineBuf, pLead)
    lineUdec(@lineBuf, chan)
    lineText(@lineBuf, @") - ")
    lineText(@lineBuf, pLabel)
    lineUdec(@lineBuf, nValue)
    showText(@lineBuf)

PRI showCalEnd(legalChan, pRange, chanMin, chanMax) | lineBuf[LINE_LONGS]
' Print a calibration's result: "- END CAL: Chan<chan><range><min> MAX=<max>".
'
' @param legalChan - the channel calibrated
' @param pRange - pointer to the text before the minimum: " Vert MIN=", " Horiz MIN=" or " MIN="
' @param chanMin - the channel's recorded minimum
' @param chanMax - the channel's recorded maximum

' Local Variables:
' @local lineBuf - the debug line being built (see lineBegin())

    lineBegin(@lineBuf, @"- END CAL: Chan")
    lineUdec(@lineBuf, legalChan)
    lineText(@lineBuf, pRange)
    lineUdec(@lineBuf, chanMin)
    lineText(@lineBuf, @" MAX=")
    lineUdec(@lineBuf, chanMax)
    showText(@lineBuf)

PRI showRangeChange(chan, pWhich, nOldValue, nNewValue) | lineBuf[LINE_LONGS]
' Print a change to a channel's recorded range: "- chan<chan><which><old> -> <new>".
'
' @param chan - the channel
' @param pWhich - pointer to " MIN " or " MAX "
' @param nOldValue - the recorded value before
' @param nNewValue - the recorded value now

' Local Variables:
' @local lineBuf - the debug line being built (see lineBegin())

    lineBegin(@lineBuf, @"- chan")
    lineUdec(@lineBuf, chan)
    lineText(@lineBuf, pWhich)
    lineUdec(@lineBuf, nOldValue)
    lineText(@lineBuf, @" -> ")
    lineUdec(@lineBuf, nNewValue)
    showText(@lineBuf)

PRI lineBegin(pLine, pText)
' Start a debug line in the buffer at {pLine} (LINE_LONGS longs, a local of the caller, so each cog builds its own)
' with {pText}. Each debug() statement is compiled into its own record, and a -d image drops every record that lies
' too far into it (DOCs/procedures/PLOT-DISPLAY-RULES.md, rules 1-2); lines built here, with ordinary code, all
' print through the one debug() in showText().
'
' @param pLine - pointer to the line buffer
' @param pText - pointer to the line's first text

    byte[pLine][0] := 0
    lineText(pLine, pText)

PRI lineText(pLine, pText) | nLen
' Append zero-terminated text to a debug line, dropping anything past LINE_MAX_CHARS.
'
' @param pLine - pointer to the line buffer
' @param pText - pointer to the text

' Local Variables:
' @local nLen - the line's length

    nLen := strsize(pLine)
    repeat strsize(pText)
        if nLen < LINE_MAX_CHARS
            byte[pLine][nLen++] := byte[pText++]
    byte[pLine][nLen] := 0

PRI lineUdec(pLine, nValue) | nPlace, nDigits, digitText
' Append {nValue} as an unsigned decimal, as udec_() prints it: an underscore every three digits (1_024).
'
' @param pLine - pointer to the line buffer
' @param nValue - the value, taken as unsigned

' Local Variables:
' @local nPlace - the place value of the digit being appended (1, 10, 100 ...)
' @local nDigits - digits still to append
' @local digitText - one character and its terminator, for lineText()

    nPlace := 1
    nDigits := 1
    repeat while (nPlace < 1_000_000_000) and ((nValue +/ nPlace) >= 10)    ' +/ and +// are the unsigned divides
        nPlace *= 10
        nDigits++
    repeat
        digitText := "0" + ((nValue +/ nPlace) +// 10)                         ' the digit, then a zero byte
        lineText(pLine, @digitText)
        nPlace /= 10
        nDigits--
        if (nDigits > 0) and (nDigits // 3 == 0)
            lineText(pLine, @"_")
    until nDigits == 0

PRI lineSdec(pLine, nValue)
' Append {nValue} as a signed decimal, as sdec_() prints it (-1).
'
' @param pLine - pointer to the line buffer
' @param nValue - the value

    if nValue < 0
        lineText(pLine, @"-")
        nValue := 0 - nValue            ' -2_147_483_648 stays $8000_0000, which lineUdec() prints as 2_147_483_648
    lineUdec(pLine, nValue)

PRI showText(pText)
' Print one line of text: this object's one debug() statement (lineBegin() says why).
'
' @param pText - pointer to the zero-terminated text

    debug(zstr_(pText))

PRI MIN(ltVal, rtVal) : minValue
' Return the smaller of two values.
'
' @param ltVal - the first value
' @param rtVal - the second value
' @returns minValue - the smaller of the two

    minValue := ltVal < rtVal ? ltVal : rtVal

PRI MAX(ltVal, rtVal) : maxValue
' Return the larger of two values.
'
' @param ltVal - the first value
' @param rtVal - the second value
' @returns maxValue - the larger of the two

    maxValue := ltVal < rtVal ? rtVal : ltVal

{
pri map(value, inmin, inmax, outmin, outmax) : result
    ' Maps value in range inmin..inmax to new value in range outmin..outmax
    if (value <= inmin)
        result := outmin
    elseif (value >= inmax)
        result :=  outmax
    else
        result :=  (value - inmin) * (outmax - outmin) / (inmax - inmin) + outmin
'}
con { license }

