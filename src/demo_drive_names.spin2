'' =================================================================================================
''
''   File....... demo_drive_names.spin2
''   Purpose.... Turn the drive's reported values into words, for the demos' debug output
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2026 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Sep 2026
''   Updated.... 26 Sep 2026
''
''   The demos ask the drive why a drive ended (getStopReason()), what it handled on its own (getEvent()), what its
''   start checks found (getHealth()) and why a command was refused (getError()). Each answer is a number; this object
''   only names it, so a demo's output reads "SR_AT_LIMIT" instead of "42". It makes no calls to the drive itself: the
''   demos make those, where you can see them. Copy it into your own project if your output wants the same words.
''
''   Every name comes from the motor object's own constants, so a value added to the library can never be misnamed
''   here -- at worst it reads "?".
''
'' =================================================================================================

CON { the bits healthBit() names }

    HEALTH_BITS = (encod mtr.HLT_PACK) + 1                      ' HLT_HALLS (bit 0) .. HLT_PACK, the highest check bit

OBJ { the constants only: nothing here starts or calls a motor }

    mtr     :   "isp_bldc_motor"

PUB stopReason(eReason) : pName
'' Return the name of a stop reason, getStopReason()'s SR_* value
''
'' @param eReason - an SR_* value
'' @returns pName - pointer to its name, or to "?" for any other value

    pName := lookupz(eReason - mtr.SR_NONE : @"SR_NONE", @"SR_COMMANDED", @"SR_AT_LIMIT", @"SR_FAULT_CONTROLLED", @"SR_FAULT_LOST", @"SR_BLOCKED", @"SR_LINK_LOST", @"SR_EMERGENCY", @"SR_PARTNER")
    if (eReason < mtr.SR_NONE) or (eReason > mtr.SR_PARTNER)
        pName := @"?"

PUB eventKind(eKind) : pName
'' Return the name of an event kind, getEvent()'s EV_* value
''
'' @param eKind - an EV_* value
'' @returns pName - pointer to its name, or to "?" for any other value

    pName := lookupz(eKind - mtr.EV_NONE : @"EV_NONE", @"EV_LOST", @"EV_STOP", @"EV_FAULT_RESYNC", @"EV_FAULT", @"EV_HOLD_SLIP", @"EV_HOLD_LIMIT", @"EV_CURRENT_LIMIT", @"EV_PATH_LIMIT", @"EV_HALL_MISSED", @"EV_HALL_ILLEGAL", @"EV_WALK_GUARD", @"EV_LATE_PASS", @"EV_PACK", @"EV_CHECK_RETRY", @"EV_FOLDBACK")
    if (eKind < mtr.EV_NONE) or (eKind > mtr.EV_FOLDBACK)
        pName := @"?"

PUB healthBit(nBit) : pName
'' Return the name of one getHealth() check, by its bit number: getHealth() returns a mask of HLT_* bits, and bit
'' {nBit} of it is the check named here
''
'' @param nBit - the bit number, 0 (HLT_HALLS) to HEALTH_BITS - 1 (HLT_PACK)
'' @returns pName - pointer to its name, or to "?" for any other bit

    pName := lookupz(nBit : @"HLT_HALLS", @"HLT_SENSE_ZERO", @"HLT_PHASE_U", @"HLT_PHASE_V", @"HLT_PHASE_W", @"HLT_WIRING", @"HLT_PACK")
    if (nBit < 0) or (nBit >= HEALTH_BITS)
        pName := @"?"

PUB errorName(eError) : pName
'' Return the name of an error code, getError()'s (or a command's) ERR_* value
''
'' @param eError - NO_ERROR or an ERR_* value
'' @returns pName - pointer to its name, or to "?" for any other value

    if eError == mtr.NO_ERROR
        pName := @"NO_ERROR"
    elseif eError == mtr.ERR_PROTECTIVE_STOP
        pName := @"ERR_PROTECTIVE_STOP"
    elseif eError == mtr.ERR_PLATFORM_BLOCKED
        pName := @"ERR_PLATFORM_BLOCKED"
    elseif (eError <= mtr.ERR_BAD_PIN_GROUP) and (eError >= mtr.ERR_START_CHECK_FAILED)
        pName := lookupz(mtr.ERR_BAD_PIN_GROUP - eError : @"ERR_BAD_PIN_GROUP", @"ERR_PIN_GROUP_IN_USE", @"ERR_BAD_VOLTAGE", @"ERR_BAD_DETECT_MODE", @"ERR_NO_FREE_COG", @"ERR_ABI_MISMATCH", @"ERR_NOT_STARTED", @"ERR_NO_SENSE_TASK", @"ERR_BAD_UNITS", @"ERR_BAD_COUNT", @"ERR_NO_WHEEL_DIA", @"ERR_LIMIT_UNRESOLVABLE", @"ERR_SYNC_TIMEOUT", @"ERR_BUSY", @"ERR_FAULT_NOT_CLEARED", @"ERR_EMERGENCY_STOPPED", @"ERR_NO_RESPONSE", @"ERR_BOARD_NOT_DETECTED", @"ERR_COMMAND_TIMEOUT", @"ERR_START_CHECK_FAILED")
    else
        pName := @"?"

PUB faultResponse(eMode) : pName
'' Return the name of a fault response, getFaultResponse()'s FR_* value
''
'' @param eMode - FR_SHIPPED or FR_GRADED
'' @returns pName - pointer to its name, or to "?" for any other value

    pName := lookupz(eMode - mtr.FR_SHIPPED : @"FR_SHIPPED", @"FR_GRADED")
    if (eMode < mtr.FR_SHIPPED) or (eMode > mtr.FR_GRADED)
        pName := @"?"

PUB packStatus(eStatus) : pName
'' Return the name of a pack sensor status, getPackVoltage()'s PACK_* value
''
'' @param eStatus - PACK_NOT_FITTED, PACK_ABSENT or PACK_PRESENT
'' @returns pName - pointer to its name, or to "?" for any other value

    pName := lookupz(eStatus - mtr.PACK_NOT_FITTED : @"PACK_NOT_FITTED", @"PACK_ABSENT", @"PACK_PRESENT")
    if (eStatus < mtr.PACK_NOT_FITTED) or (eStatus > mtr.PACK_PRESENT)
        pName := @"?"

CON { license }
