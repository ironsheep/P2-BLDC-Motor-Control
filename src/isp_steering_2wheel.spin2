CON { forward our interface constants }

  ' board connection Enum
    MOTOR_TYPE     = user.MOTOR_TYPE

  ' board connection Enum
    PINS_P0_P15     = ltWheel.PINS_P0_P15
    PINS_P8_P23     = ltWheel.PINS_P8_P23
    PINS_P16_P31    = ltWheel.PINS_P16_P31
    PINS_P32_P47    = ltWheel.PINS_P32_P47
    PINS_P40_P55    = ltWheel.PINS_P40_P55

    ' Driver Supported Voltages Enum
    '  Lipo battery sizes: 2s-7.4v, 3s-11.1v, 4s-14.8v, 5s-18.5v, 6s-22.2v, 7s-25.9v
    PWR_6p0V      = ltWheel.PWR_6p0V
    PWR_7p4V    = ltWheel.PWR_7p4V
    PWR_11p1V   = ltWheel.PWR_11p1V
    PWR_12p0V     = ltWheel.PWR_12p0V
    PWR_14p8V   = ltWheel.PWR_14p8V
    PWR_18p5V   = ltWheel.PWR_18p5V
    PWR_22p2V   = ltWheel.PWR_22p2V
    PWR_24p0V     = ltWheel.PWR_24p0V
    PWR_25p9V     = ltWheel.PWR_25p9V

  ' Driver Distance-Units Enum
    DDU_Unknown     = ltWheel.DDU_Unknown
    DDU_IN          = ltWheel.DDU_IN
    DDU_MM          = ltWheel.DDU_MM
    DDU_CM          = ltWheel.DDU_CM
    DDU_FT          = ltWheel.DDU_FT
    DDU_M           = ltWheel.DDU_M
    DDU_KM          = ltWheel.DDU_KM
    DDU_MI          = ltWheel.DDU_MI

  ' Driver Rotation-Units Enum
    DRU_Unknown     = ltWheel.DRU_Unknown
    DRU_DEGREES     = ltWheel.DRU_DEGREES
    DRU_ROTATIONS   = ltWheel.DRU_ROTATIONS
    DRU_HALL_TICKS  = ltWheel.DRU_HALL_TICKS

  ' Driver Time-Unit Enum
    DTU_Unknown     = ltWheel.DTU_Unknown
    DTU_MILLISEC    = ltWheel.DTU_MILLISEC
    DTU_SEC         = ltWheel.DTU_SEC

  ' Driver Status Enum
    DS_Unknown      = ltWheel.DS_Unknown
    DS_MOVING       = ltWheel.DS_MOVING
    DS_HOLDING      = ltWheel.DS_HOLDING
    DS_OFF          = ltWheel.DS_OFF
    DS_FAULTED      = ltWheel.DS_FAULTED
    DS_ESTOP        = ltWheel.DS_ESTOP

  ' Driver State Enum
    DCS_Unknown     = ltWheel.DCS_Unknown
    DCS_STOPPED     = ltWheel.DCS_STOPPED
    DCS_SPIN_UP     = ltWheel.DCS_SPIN_UP
    DCS_AT_SPEED    = ltWheel.DCS_AT_SPEED
    DCS_SPIN_DN     = ltWheel.DCS_SPIN_DN
    DCS_SLOW_TO_CHG = ltWheel.DCS_SLOW_TO_CHG
    DCS_FAULTED     = ltWheel.DCS_FAULTED
    DCS_ESTOP       = ltWheel.DCS_ESTOP

    ' return value when user makes bad choice
    INVALID_MOTOR       = ltWheel.INVALID_MOTOR

    ' return value when user makes bad choice
    INVALID_PIN_BASE    = ltWheel.INVALID_PIN_BASE

    ' return value when user makes bad choice
    INVALID_VOLTAGE     = ltWheel.INVALID_VOLTAGE

    ' return value when user makes bad choice
    INVALID_DET_MODE     = ltWheel.INVALID_DET_MODE

  ' Error codes (meanings: isp_bldc_motor.spin2's CON block)
    NO_ERROR                = ltWheel.NO_ERROR
    ERR_BAD_PIN_GROUP       = ltWheel.ERR_BAD_PIN_GROUP
    ERR_PIN_GROUP_IN_USE    = ltWheel.ERR_PIN_GROUP_IN_USE
    ERR_BAD_VOLTAGE         = ltWheel.ERR_BAD_VOLTAGE
    ERR_BAD_DETECT_MODE     = ltWheel.ERR_BAD_DETECT_MODE
    ERR_NO_FREE_COG         = ltWheel.ERR_NO_FREE_COG
    ERR_ABI_MISMATCH        = ltWheel.ERR_ABI_MISMATCH
    ERR_NOT_STARTED         = ltWheel.ERR_NOT_STARTED
    ERR_NO_SENSE_TASK       = ltWheel.ERR_NO_SENSE_TASK
    ERR_BAD_UNITS           = ltWheel.ERR_BAD_UNITS
    ERR_BAD_COUNT           = ltWheel.ERR_BAD_COUNT
    ERR_NO_WHEEL_DIA        = ltWheel.ERR_NO_WHEEL_DIA
    ERR_LIMIT_UNRESOLVABLE  = ltWheel.ERR_LIMIT_UNRESOLVABLE
    ERR_SYNC_TIMEOUT        = ltWheel.ERR_SYNC_TIMEOUT
    ERR_BUSY                = ltWheel.ERR_BUSY
    ERR_FAULT_NOT_CLEARED   = ltWheel.ERR_FAULT_NOT_CLEARED
    ERR_EMERGENCY_STOPPED   = ltWheel.ERR_EMERGENCY_STOPPED
    ERR_NO_RESPONSE         = ltWheel.ERR_NO_RESPONSE
    ERR_BOARD_NOT_DETECTED  = ltWheel.ERR_BOARD_NOT_DETECTED
    ERR_PROTECTIVE_STOP     = ltWheel.ERR_PROTECTIVE_STOP
    ERR_PLATFORM_BLOCKED    = ltWheel.ERR_PLATFORM_BLOCKED

OBJ { our Motors }

    ltWheel     :   "isp_bldc_motor"                    ' left wheel drive
    rtWheel     :   "isp_bldc_motor"                    ' right wheel drive
#ifdef BENCH_CFG
    user        :   "isp_bldc_motor_userconfig_bench"   ' bench configuration (-D BENCH_CFG), PL-33: mirrors isp_bldc_motor.spin2's OBJ switch
#else
    user        :   "isp_bldc_motor_userconfig"         ' driver configuration
#endif
    distConv    :   "isp_dist_utils"                    ' distance conversion utils

CON { DEBUG channels -- the mask and the channel names come from the user config }

    DEBUG_MASK = user.STEER_DBG_MASK            ' DEBUG[user.DBGCH_*] compiles only when its bit is set

PUB null()
'' This is not a top-level object
''

PUB start(leftBasePin, rightBasePin, driveVoltage, leftDetectMode, rightDetectMode) : ok | ltcog, rtcog, frontCogId, startMs, idx, bLeftReady, bRightReady
'' Start our drive cogs connected to our left and right motor control pin-sets, and the front cog that owns them (3 cogs)
''
'' PL-45: once both drivers start, this blocks for about 1 s while it samples both wheels' current-sense
'' rest zero together (getCurrent() nets it out); a driver that fails to start returns before that
''
'' @param leftBasePin - The base pin ENUM (PINS_*) for the left motor's adapter board
'' @param rightBasePin - The base pin ENUM (PINS_*) for the right motor's adapter board
'' @param driveVoltage - The voltage ENUM (PWR_*) for both motors
'' @param leftDetectMode - The detection mode ENUM (BRD_*) for the left motor
'' @param rightDetectMode - The detection mode ENUM (BRD_*) for the right motor
'' @returns ok - The COG ID of the front (sense) cog (0-7) on success, or (-1) if either motor or the front cog failed to start; getError() names the cause and the wheel

' Local Variables:
' @local ltcog - the left driver's cog id, or -1
' @local rtcog - the right driver's cog id, or -1
' @local frontCogId - the value cogspin() returned
' @local startMs - getms() when the front cog handshake wait began
' @local idx - the rest-zero sample loop counter
' @local bLeftReady - T/F where T means the left wheel's restZeroBegin() confirmed a real reading
' @local bRightReady - T/F where T means the right wheel's restZeroBegin() confirmed a real reading

    ticks1ms   := (clkfreq / 1_000)
    ticks1us   := (clkfreq / 1_000_000)

    ' iff HDMI is needed, then we need this!
    'if clkfreq <> 270_000_000
    '    debug("!! ERROR bad CLOCK value")
    '    repeat ' halt here

    ok := -1
    if senseCog    ' D2: free this instance's own front cog (EXIT, then cogstop) before starting a fresh pair
        stopFrontCog()

    ' both drivers start parked for this object's ATN, and neither starts a front cog of its own
    ltcog := ltWheel.startOwned(leftBasePin, driveVoltage, leftDetectMode)
    ltWheel.testSetMotorId(@"ltMot")
    rtcog := rtWheel.startOwned(rightBasePin, driveVoltage, rightDetectMode)
    rtWheel.testSetMotorId(@"rtMot")

    if (ltcog < 0) or (rtcog < 0)
        ' D1/PL-22: never build or send a cog mask from a failed start -- 1<<-1 hits bit 31 via
        ' PASM2 SHL's 5-bit count, and COGATN only selects cogs 0-7 -- so stop whatever did
        ' start and report failure instead
        if ltcog >= 0
            ltWheel.stop()
        if rtcog >= 0
            rtWheel.stop()
        debug[user.DBGCH_ERROR]("!! ERROR filed to start left/right drive cog(s)")
    else
        rtWheel.forwardIsReverse()
        cogmask := (1<<ltcog)|(1<<rtcog)
        waitms(100)
        debug[user.DBGCH_LIFECYCLE](" sendatn: ", sdec(ltcog), " ", sdec(rtcog))
        ' lockstep: one ATN releases both parked drivers together. It is sent here, on the caller's
        '  cog, before the front cog exists, so no second caller of COGATN can exist yet.
        cogatn(cogmask)

        ' PL-45: both drivers are now released and floated, and neither has been driven yet. One
        '  bounded readiness wait per wheel (REST_ZERO_READY_TIMEOUT_MS), then one shared ~1 s loop
        '  sampling both wheels every tick.
        bLeftReady := (ltWheel.restZeroBegin() == NO_ERROR)
        bRightReady := (rtWheel.restZeroBegin() == NO_ERROR)
        repeat idx from 1 to ltWheel.REST_ZERO_SAMPLE_COUNT
            waitms(ltWheel.REST_ZERO_SAMPLE_MS)
            if bLeftReady == TRUE
                ltWheel.restZeroAddSample()
            if bRightReady == TRUE
                rtWheel.restZeroAddSample()
        ltWheel.restZeroFinish()
        rtWheel.restZeroFinish()

        ' pre-launch: no front cog of this instance exists, so these writes have no second writer
        ' one formula for the wheel, owned by the motor object (0 when the configured diameter is 0)
        _, tickInMM_x100 := ltWheel.wheelGeometry()

        ' init user tracking vars
        motorStopHallTicks := 0
        motorStopMSecs := 0
        rqstPower := 0
        rqstLtPower := 0
        rqstRtPower := 0
        rqstDirection := 0
        userCutoff := FALSE
        notUsed := 0
        frontPasses := 0
        frontLatePasses := 0
        frontMaxPassTicks := 0
        longfill(@taskStack, STACK_SENTINEL, STACK_SIZE_LONGS)   ' PL-75: this object's own size; testGetFrontStats() finds the high-water mark from this

        frontCogId := cogspin(NEWCOG, frontLoop(), @taskStack)
        if frontCogId < 0    ' did fail? (documented -1, or the $8000_xxxx form observed under cog exhaustion)
            ltWheel.stop()   ' a failed start leaves nothing running: release both motor cogs and their pins
            rtWheel.stop()
            recordError(ERR_NO_FREE_COG)
            debug[user.DBGCH_ERROR]("!! ERROR filed to start front cog")
        else
            senseCog := frontCogId + 1    ' internal representation: cogid + 1 (0 reserved as "not started"), one write
            startMs := getms()
            repeat while frontPasses == 0
                if getms() - startMs > ltWheel.FRONT_START_TIMEOUT_MS
                    quit
                waitms(ltWheel.REQ_POLL_MS)
            if frontPasses == 0
                recordError(ERR_NO_RESPONSE)
                debug[user.DBGCH_ERROR]("!! ERROR front cog did not start its loop")
                stop()
            else
                ok := frontCogId    ' public contract: the front (sense) cog's id (0-7)

PUB stop() : eError
'' Stop our front cog first, then the left/right drive cogs, and release allocated pins
''
'' @returns eError - NO_ERROR; stopping always succeeds, on a started or an unstarted instance

    if senseCog
        stopFrontCog()
    ltWheel.stop()
    rtWheel.stop()
    eError := NO_ERROR

PRI stopFrontCog() | eStatus
' Ask the front cog to EXIT, wait bounded for its acknowledgement, then cogstop it; never refuses.
'

' Local Variables:
' @local eStatus - the EXIT request's result: NO_ERROR when acknowledged

    ' PL-41: the front cog answers every open request, acknowledges, and parks with no output, so the
    '  cogstop cannot cut a debug line. Without an answer in the bound it is stopped anyway.
    eStatus, _, _ := postRequest(ltWheel.REQ_EXIT, BOTH_MOTORS, 0, 0, 0)
    if eStatus <> NO_ERROR
        debug[user.DBGCH_ERROR]("! ERROR: steering front cog did not acknowledge EXIT; stopping anyway")
    cogstop(senseCog - 1)
    senseCog := 0

PUB setAcceleration(rate) : eError
'' Updates the ramping speed of the motors
''
'' @param rate - the desired acceleration rate in ticks per second
'' @returns eError - NO_ERROR, or the first wheel's ERR_* code (also recorded for getError())

    eError := firstError(ltWheel.setAcceleration(rate), rtWheel.setAcceleration(rate))

PUB setMaxSpeed(speed) : eError
'' Limit top-speed to {speed}
''
'' @param speed - top speed [1 to 100]; a value outside the range is saturated to it
'' @returns eError - NO_ERROR, or the first wheel's ERR_* code (also recorded for getError())

    eError := firstError(ltWheel.setMaxSpeed(speed), rtWheel.setMaxSpeed(speed))

PUB setMaxSpeedForDistance(speed) : eError
'' Limit top-speed of driveDistance() operations to {speed}
''
'' @param speed - top speed [1 to 100]; a value outside the range is saturated to it
'' @returns eError - NO_ERROR, or the first wheel's ERR_* code (also recorded for getError())

    eError := firstError(ltWheel.setMaxSpeedForDistance(speed), rtWheel.setMaxSpeedForDistance(speed))

PUB calibrate() : eError
'' NOT WORKING: (we may need this?)
'' have motor drivers determine fixed-offset constants
''
'' @returns eError - NO_ERROR

    eError := firstError(ltWheel.calibrate(), rtWheel.calibrate())

PUB holdAtStop(bEnable) : eError
'' Informs the motor drivers to actively hold position (bEnable=true) or coast (bEnable=false) once AT REST
''
'' PL-58: chooses hold or release only at rest. Every stop commanded from speed follows each driver's own ramp
'' regardless of this setting; MEASURED (Visit 2) both settings take the same distance to stop from a given speed.
''
'' @param bEnable - T/F where T means hold position at rest and F means coast
'' @returns eError - NO_ERROR, or the first wheel's ERR_* code (also recorded for getError())

    eError := firstError(ltWheel.holdAtStop(bEnable), rtWheel.holdAtStop(bEnable))

PUB resetTracking() : eError | eStatus, eLeftStatus, eRightStatus
'' Resets the position tracking values returned by getDistance() and getRotations()
''  Effectively: use current position as home from now on
''
'' @returns eError - NO_ERROR once the front cog has applied the reset, or ERR_NOT_STARTED / ERR_NO_RESPONSE, also recorded for getError()

' Local Variables:
' @local eStatus - the front cog's platform status
' @local eLeftStatus - the front cog's status for the left wheel
' @local eRightStatus - the front cog's status for the right wheel

    eStatus, eLeftStatus, eRightStatus := postRequest(ltWheel.REQ_RESET_TRACKING, BOTH_MOTORS, 0, 0, 0)
    eError := recordRequestResult(eStatus, eLeftStatus, eRightStatus)

CON { --- Subsystem Control --- }

PUB driveDirection(power, direction) : eError
'' Control the speed and direction of your robot using the {power} and {direction} inputs.
'' Turns both motors on at {power, [(-100) to 100]} but adjusted by {direction, [(-100) to 100]}.
'' AFFECTED BY: setAcceleration(), setMaxSpeed(), holdAtStop()
''
'' @param power - power [(-100) to 100], saturated to that range; 0 stops
'' @param direction - direction [(-100) to 100], saturated to that range; 0 is straight ahead
'' @returns eError - NO_ERROR, or the ERR_* code also recorded for getError(); see driveAtPower()

    rqstPower, rqstDirection := power, direction        ' calculate effective power based on direction
    eError := driveAtPower(calcPowerForDirection(power, direction))

PUB driveForDistance(leftDistance, rightDistance, eDistanceUnits) : eError | shorterDistance, nStopTicks, maxLtSpeed, maxRtSpeed, eStatus, eLeftStatus, eRightStatus
'' Control the forward direction or rate of turn of your robot using the {leftDistance} and {rightDistance} inputs.
'' Turn both motors on then turn them off again when either reaches the specified distance {leftDistance} or
''  {rightDistance}, where {*distance} is in {distanceUnits} [DDU_IN, DDU_FT, DDU_CM, or DDU_M].
'' AFFECTED BY: setAcceleration(), setMaxSpeedForDistance(), holdAtStop()
''
'' @param leftDistance - distance for the left wheel, at least 1
'' @param rightDistance - distance for the right wheel, at least 1
'' @param eDistanceUnits - units of both distances: DDU_MM, DDU_CM, DDU_IN, DDU_FT or DDU_M
'' @returns eError - NO_ERROR, or the ERR_* code also recorded for getError() (ERR_EMERGENCY_STOPPED while a wheel is emergency-stopped); on any error neither the limit is armed nor the motors started

' Local Variables:
' @local shorterDistance - the smaller of the two distances, where both wheels stop
' @local nStopTicks - the shorter distance in hall ticks
' @local maxLtSpeed - the left wheel's max speed for distance
' @local maxRtSpeed - the right wheel's max speed for distance
' @local eStatus - the front cog's platform status
' @local eLeftStatus - the front cog's status for the left wheel
' @local eRightStatus - the front cog's status for the right wheel

    ' validate on this cog, then one request: the front cog resets tracking, arms the limit and drives
    '  both wheels together, or refuses all of it (I1 item 2)
    shorterDistance := leftDistance < rightDistance ? leftDistance : rightDistance
    eError, nStopTicks := ticksForDistance(shorterDistance, eDistanceUnits)
    if eError <> NO_ERROR
        eError := recordError(eError)
        debug[user.DBGCH_ERROR]("! ERROR: driveForDistance() rejected ", sdec_long(eError), sdec_long(shorterDistance), sdec_long(eDistanceUnits))
    else
        maxLtSpeed := ltWheel.getMaxSpeedForDistance()
        maxRtSpeed := rtWheel.getMaxSpeedForDistance()
        rqstLtPower, rqstRtPower := maxLtSpeed, maxRtSpeed
        eStatus, eLeftStatus, eRightStatus := postRequest(ltWheel.REQ_DRIVE_DISTANCE, BOTH_MOTORS, nStopTicks, maxLtSpeed, maxRtSpeed)
        eError := recordRequestResult(eStatus, eLeftStatus, eRightStatus)

PUB driveAtPower(leftPower, rightPower) : eError | eStatus, eLeftStatus, eRightStatus
'' Control the speed and direction of your robot using the {leftPower} and {rightPower} inputs.
'' Turns left motor on at {leftPower} and right at {rightPower}. Where {*Power} are in the range [(-100) to 100].
'' AFFECTED BY: setAcceleration(), setMaxSpeed(), holdAtStop()
''
'' @param leftPower - left motor power [(-100) to 100], saturated to that range; 0 stops
'' @param rightPower - right motor power [(-100) to 100], saturated to that range; 0 stops
'' @returns eError - NO_ERROR, ERR_NOT_STARTED, ERR_NO_RESPONSE, or a wheel's ERR_EMERGENCY_STOPPED / ERR_SYNC_TIMEOUT (all recorded for getError()); on an emergency stop nothing is written, on ERR_SYNC_TIMEOUT both motors are stopped

' Local Variables:
' @local eStatus - the front cog's platform status
' @local eLeftStatus - the front cog's status for the left wheel
' @local eRightStatus - the front cog's status for the right wheel

    eError := NO_ERROR
    if senseCog == 0
        ' started means both drivers and the front cog run
        eError := recordError(ERR_NOT_STARTED)
        debug[user.DBGCH_ERROR]("! ERROR: driveAtPower() motors not started")
    else
        rqstLtPower, rqstRtPower := leftPower, rightPower
        if (leftPower <> (-100 #> leftPower <# 100)) or (rightPower <> (-100 #> rightPower <# 100))
            debug[user.DBGCH_WARNING]("! WARNING: driveAtPower() power out of range (corrected):", sdec_long(leftPower), sdec_long(rightPower), " - must be [-100 to +100]")
        ' the front cog writes both commands with the sync bit, releases both drivers with one ATN and
        '  waits, bounded; if either does not take its command both are stopped (audit M)
        eStatus, eLeftStatus, eRightStatus := postRequest(ltWheel.REQ_DRIVE, BOTH_MOTORS, leftPower, rightPower, TRUE)
        eError := recordRequestResult(eStatus, eLeftStatus, eRightStatus)

PUB stopAfterRotation(nRotationCount, eRotationUnits) : eError | nStopTicks, degreesPerTic, ticsPerRotation, eStatus, eLeftStatus, eRightStatus
'' Stops both motors so they are at rest when either motor reaches {rotationCount} of {rotationUnits} [DRU_HALL_TICKS, DRU_DEGREES, or DRU_ROTATIONS].
'' USE WITH: driveDirection(), driveAtPower()
''
'' The stop begins early, by the distance each wheel's ramp-down needs at its current speed, so the platform comes
'' to rest at the limit (within about two hall ticks), not past it. A limit shorter than that distance stops at once.
''
'' @param nRotationCount - rotation to travel, at least 1, resolving to at least one hall tick
'' @param eRotationUnits - units of {nRotationCount}: DRU_HALL_TICKS, DRU_DEGREES or DRU_ROTATIONS
'' @returns eError - NO_ERROR, or the ERR_* code also recorded for getError(); a rejected call leaves any armed limit in place

' Local Variables:
' @local nStopTicks - the requested rotation in hall ticks
' @local degreesPerTic - degrees of rotation per hall tick for this motor
' @local ticsPerRotation - hall ticks per rotation for this motor
' @local eStatus - the front cog's platform status
' @local eLeftStatus - the front cog's status for the left wheel
' @local eRightStatus - the front cog's status for the right wheel

    ' validate everything, then commit: nothing is changed until every check has passed
    eError := NO_ERROR
    nStopTicks := 0
    degreesPerTic, ticsPerRotation := ltWheel.hallTicInfoForMotor()
    case eRotationUnits
        DRU_HALL_TICKS:
            nStopTicks := nRotationCount
        DRU_DEGREES:
            ' ticks = degrees / 4
            nStopTicks := nRotationCount / degreesPerTic
        DRU_ROTATIONS:
            ' ticks = rotations * 90
            nStopTicks := nRotationCount * ticsPerRotation
        other:
            eError := ERR_BAD_UNITS

    if nRotationCount < 1
        eError := ERR_BAD_COUNT
    elseif eError == NO_ERROR
        if nStopTicks < 1
            eError := ERR_LIMIT_UNRESOLVABLE
        elseif senseCog == 0
            ' F-5c: start() would erase it, so a limit set before start() is refused, not silently lost
            eError := ERR_NOT_STARTED

    if eError == NO_ERROR
        debug[user.DBGCH_COMMAND](" stopAfterRotation: ", udec(nRotationCount), " ", udec(degreesPerTic), " ", udec(ticsPerRotation), " ", udec(nStopTicks))
        ' the front cog arms it, keeping the tracking as it is
        eStatus, eLeftStatus, eRightStatus := postRequest(ltWheel.REQ_LIMIT_TICKS, BOTH_MOTORS, nStopTicks, FALSE, 0)
        eError := recordRequestResult(eStatus, eLeftStatus, eRightStatus)
    else
        eError := recordError(eError)
        debug[user.DBGCH_ERROR]("! ERROR: stopAfterRotation() rejected ", sdec_long(eError), sdec_long(nRotationCount), sdec_long(eRotationUnits))

PUB stopAfterDistance(nDistance, eDistanceUnits) : eError | nStopTicks, eStatus, eLeftStatus, eRightStatus
'' Stops the motors so they are at rest when one of them reaches {distance} specified in {distanceUnits} [DDU_MM, DDU_CM, DDU_IN, DDU_FT, DDU_M].
'' USE WITH: driveDirection(), driveAtPower()
''
'' The stop begins early, by the distance each wheel's ramp-down needs at its current speed, so the platform comes
'' to rest at the limit (within about two hall ticks), not past it. A limit shorter than that distance stops at once.
''
'' @param nDistance - distance to travel, at least 1, resolving to at least one hall tick
'' @param eDistanceUnits - units of {nDistance}: DDU_MM, DDU_CM, DDU_IN, DDU_FT or DDU_M
'' @returns eError - NO_ERROR, or the ERR_* code also recorded for getError(); a rejected call leaves any armed limit and the tracking in place

' Local Variables:
' @local nStopTicks - the requested distance in hall ticks
' @local eStatus - the front cog's platform status
' @local eLeftStatus - the front cog's status for the left wheel
' @local eRightStatus - the front cog's status for the right wheel

    ' validate everything, then commit: nothing is changed until every check has passed
    eError, nStopTicks := ticksForDistance(nDistance, eDistanceUnits)
    if eError == NO_ERROR
        ' F-4: tracking restarts only for an accepted limit, which counts from here; the front cog
        '  resets the tracking and arms the limit as one action
        eStatus, eLeftStatus, eRightStatus := postRequest(ltWheel.REQ_LIMIT_TICKS, BOTH_MOTORS, nStopTicks, TRUE, 0)
        eError := recordRequestResult(eStatus, eLeftStatus, eRightStatus)
    else
        eError := recordError(eError)
        debug[user.DBGCH_ERROR]("! ERROR: stopAfterDistance() rejected ", sdec_long(eError), sdec_long(nDistance), sdec_long(eDistanceUnits))

PRI ticksForDistance(nDistance, eDistanceUnits) : eError, nStopTicks | fValue
' Validate a platform distance request and convert it to hall ticks, with no side effects and nothing recorded.
'
' @param nDistance - distance to travel, at least 1, resolving to at least one hall tick
' @param eDistanceUnits - units of {nDistance}: DDU_MM, DDU_CM, DDU_IN, DDU_FT or DDU_M
' @returns eError - NO_ERROR, ERR_BAD_COUNT, ERR_NOT_STARTED, ERR_NO_WHEEL_DIA, ERR_BAD_UNITS or ERR_LIMIT_UNRESOLVABLE
' @returns nStopTicks - the requested distance in hall ticks; meaningful only when {eError} is NO_ERROR

' Local Variables:
' @local fValue - the requested distance in mm (float), for the inch and foot units

    eError := NO_ERROR
    nStopTicks := 0
    if nDistance < 1
        eError := ERR_BAD_COUNT
    elseif senseCog == 0
        ' F-5c: start() would erase it, so a limit set before start() is refused, not silently lost
        eError := ERR_NOT_STARTED
    elseif tickInMM_x100 == 0
        ' start() ran, so a zero travel-per-tick means the configured wheel diameter is 0
        eError := ERR_NO_WHEEL_DIA
    else
        ' convert distance to ticks (will stop at ticks limit)
        ' Distance is translated to Hall ticks and compared with left and right motor hall ticks
        ' The motor ticks are from start but reset on fault or estop.
        ' If a fault occurs, will stop immedetely and hall ticks are reset on the faulting motor.
        ' task 3502: numerators carry an extra x10 to match tickInMM_x100's x100 scale (was x10).
        '  Largest assumed input is 1000 m: DDU_M's intermediate is then 1000 * 1000 * 100 =
        '  100_000_000, safely inside a signed LONG (max 2_147_483_647).
        case eDistanceUnits
            DDU_MM:
                nStopTicks := (nDistance * 100) / tickInMM_x100
            DDU_CM:
                nStopTicks := (nDistance * 10 * 100) / tickInMM_x100
            DDU_IN:
                fValue := distConv.fIn2mm(nDistance)
                nStopTicks := round(fValue *. 100.0) / tickInMM_x100
            DDU_FT:
                fValue := distConv.fIn2mm(nDistance * 12)
                nStopTicks := round(fValue *. 100.0) / tickInMM_x100
            DDU_M:
                ' F, mirrored from isp_bldc_motor.spin2 (task 3502): 1 m = 1000 mm, not 100 -- the prior
                '  "* 100" stopped DDU_M at one tenth of the distance DDU_CM/DDU_MM give for the same
                '  physical distance.
                nStopTicks := (nDistance * 1000 * 100) / tickInMM_x100
            other:
                eError := ERR_BAD_UNITS
        if (eError == NO_ERROR) and (nStopTicks < 1)
            eError := ERR_LIMIT_UNRESOLVABLE

PUB stopAfterTime(nTime, eTimeUnits) : eError | timeNow, nStopMSecs, eStatus, eLeftStatus, eRightStatus
'' Stops the motors so they are at rest when {time} specified in {timeUnits} [DTU_MILLISEC or DTU_SEC] has elapsed.
'' USE WITH: driveDirection(), driveAtPower()
''
'' The stop begins early, by the time the slower wheel's ramp-down needs at its current speed, so the platform is at
'' rest by the limit (within a few milliseconds). A limit shorter than that time stops at once.
''
'' @param nTime - time to run, at least 1
'' @param eTimeUnits - units of {nTime}: DTU_MILLISEC or DTU_SEC
'' @returns eError - NO_ERROR, or the ERR_* code also recorded for getError(); a rejected call leaves any armed limit in place

' Local Variables:
' @local timeNow - getms() when the limit was computed
' @local nStopMSecs - the getms() value at which the motors stop, never 0 (0 means no limit)
' @local eStatus - the front cog's platform status
' @local eLeftStatus - the front cog's status for the left wheel
' @local eRightStatus - the front cog's status for the right wheel

    ' validate everything, then commit: nothing is changed until every check has passed
    eError := NO_ERROR
    timeNow := getms()
    nStopMSecs := 0
    if nTime < 1
        eError := ERR_BAD_COUNT
    elseif senseCog == 0
        ' F-5c: start() would erase it, so a limit set before start() is refused, not silently lost
        eError := ERR_NOT_STARTED
    else
        case eTimeUnits
            DTU_MILLISEC:
                nStopMSecs := timeNow + nTime
            DTU_SEC:
                nStopMSecs := timeNow + (nTime * 1_000)
            other:
                eError := ERR_BAD_UNITS

    if eError == NO_ERROR
        if nStopMSecs == 0
            nStopMSecs := 1
        debug[user.DBGCH_COMMAND]("* stop motor at ", udec_long(nStopMSecs), ", now: ", udec_long(timeNow))
        eStatus, eLeftStatus, eRightStatus := postRequest(ltWheel.REQ_LIMIT_TIME, BOTH_MOTORS, nStopMSecs, 0, 0)
        eError := recordRequestResult(eStatus, eLeftStatus, eRightStatus)
    else
        eError := recordError(eError)
        debug[user.DBGCH_ERROR]("! ERROR: stopAfterTime() rejected ", sdec_long(eError), sdec_long(nTime), sdec_long(eTimeUnits))

PUB stopMotors() : eError
'' Stops both motors, killing any motion that was still in progress
'' PL-58: the stop itself always follows each driver's ramp; holdAtStop() only selects hold vs. coast once AT REST
''
'' @returns eError - NO_ERROR; stopping always succeeds

    rqstPower := rqstLtPower := rqstRtPower := 0
    secureWheels(BOTH_MOTORS, FALSE)
    eError := NO_ERROR

PUB emergencyCutoff() : eError
'' EMERGENCY-Stop - Immediately stop both motors, killing any motion that was still in progress
''
'' The emergency stop latches: drives are refused with ERR_EMERGENCY_STOPPED until clearEmergency().
''
'' @returns eError - NO_ERROR; stopping always succeeds

    rqstPower := rqstLtPower := rqstRtPower := 0
    userCutoff := TRUE
    debug[user.DBGCH_FAULT]("--------WHEELS EMERGENCY STOP--------")
    secureWheels(BOTH_MOTORS, TRUE)
    eError := NO_ERROR

PUB clearEmergency() : eError | eStatus, eLeftStatus, eRightStatus
'' Remove emergency override allowing motors to be driven again; both motors stay stopped until commanded
''
'' @returns eError - NO_ERROR once both drivers have left their emergency stop; a wheel's protective code while a protective stop is latched (clearProtectiveStop() releases that); or ERR_NOT_STARTED / ERR_NO_RESPONSE; also recorded for getError() (a wheel's code in that wheel's slot)

' Local Variables:
' @local eStatus - the front cog's platform status
' @local eLeftStatus - the front cog's status for the left wheel
' @local eRightStatus - the front cog's status for the right wheel

    ' the front cog writes zero commands before releasing the latches, so nothing moves on the clear
    eStatus, eLeftStatus, eRightStatus := postRequest(ltWheel.REQ_CLEAR_ESTOP, BOTH_MOTORS, 0, 0, 0)
    eError := recordRequestResult(eStatus, eLeftStatus, eRightStatus)
    if eError == NO_ERROR
        userCutoff := FALSE
        debug[user.DBGCH_FAULT]("--------clear EMERGENCY--------")
    else
        debug[user.DBGCH_ERROR]("! ERROR: clearEmergency() not cleared ", sdec_long(eError))

PUB getProtectiveStop() : eLeftCode, eRightCode
'' Return each wheel's latched protective stop cause, without clearing it
''
'' A cause on either wheel secures both, so both normally report the same code.
''
'' @returns eLeftCode - the left wheel's protective code (ERR_PLATFORM_BLOCKED or another -2_0xx cause), NO_ERROR when none
'' @returns eRightCode - the right wheel's protective code, NO_ERROR when none

    eLeftCode := ltWheel.getProtectiveStop()
    eRightCode := rtWheel.getProtectiveStop()

PUB clearProtectiveStop() : eError | eStatus, eLeftStatus, eRightStatus
'' Acknowledge a protective stop on both wheels: both stay stopped and may be driven again
''
'' While a protective stop is latched every drive is refused with its code, and clearEmergency() does not release it.
''
'' @returns eError - NO_ERROR once released, or ERR_NOT_STARTED / ERR_NO_RESPONSE, also recorded for getError() (a wheel's code in that wheel's slot)

' Local Variables:
' @local eStatus - the front cog's platform status
' @local eLeftStatus - the front cog's status for the left wheel
' @local eRightStatus - the front cog's status for the right wheel

    ' the front cog writes zero commands before releasing, so nothing moves on the clear
    eStatus, eLeftStatus, eRightStatus := postRequest(ltWheel.REQ_CLEAR_PROTECT, BOTH_MOTORS, 0, 0, 0)
    eError := recordRequestResult(eStatus, eLeftStatus, eRightStatus)
    if eError == NO_ERROR
        userCutoff := FALSE

PUB testSetCurrentLimits(peakAmps, contAmps) : eError | eStatus, eLeftStatus, eRightStatus
'' TEST USE: replace both wheels' peak and continuous phase-current limits (so a wheels-lifted rig can reach them)
''
'' @param peakAmps - the peak limit the drivers fold back at, amps [1..I_PEAK_A]
'' @param contAmps - the continuous limit the front cog derates to, amps [1..peakAmps]
'' @returns eError - NO_ERROR, ERR_BAD_COUNT for a limit out of range, or ERR_NOT_STARTED / ERR_NO_RESPONSE, also recorded for getError()

' Local Variables:
' @local eStatus - the front cog's platform status
' @local eLeftStatus - the front cog's status for the left wheel
' @local eRightStatus - the front cog's status for the right wheel

    if (peakAmps < 1) or (peakAmps > ltWheel.I_PEAK_A) or (contAmps < 1) or (contAmps > peakAmps)
        eError := recordError(ERR_BAD_COUNT)
    else
        eStatus, eLeftStatus, eRightStatus := postRequest(ltWheel.REQ_SET_LIMITS, BOTH_MOTORS, peakAmps, contAmps, 0)
        eError := recordRequestResult(eStatus, eLeftStatus, eRightStatus)

PRI secureWheels(motorMask, bEStop) | eStatus
' SECURING: stop (or emergency-stop) the selected wheels; never records, never refuses.
'
' @param motorMask - the wheels to secure: LEFT_MOTOR_BIT, RIGHT_MOTOR_BIT or BOTH_MOTORS
' @param bEStop - T/F where T also latches each selected wheel's emergency stop

' Local Variables:
' @local eStatus - the posted request's platform status

    ' I6. With the front cog running, it applies the request first in its next pass. With no front cog
    '  (not started, inside start(), after stop()) no second writer exists, so each wheel is secured
    '  directly; the same happens, reported, if a running front cog did not answer in time.
    if bEStop == TRUE
        eStatus, _, _ := postRequest(ltWheel.REQ_ESTOP, motorMask, 0, 0, 0)
    else
        eStatus, _, _ := postRequest(ltWheel.REQ_STOP, motorMask, 0, 0, 0)
    if eStatus <> NO_ERROR
        if eStatus == ERR_NO_RESPONSE
            debug[user.DBGCH_ERROR]("! ERROR: steering front cog did not answer; securing directly")
        if (motorMask & LEFT_MOTOR_BIT) <> 0
            ltWheel.frontSecure(bEStop)
        if (motorMask & RIGHT_MOTOR_BIT) <> 0
            rtWheel.frontSecure(bEStop)

CON { --- Subsystem Status --- }

PUB getError() : eError, eLeftError, eRightError
'' Return and clear this cog's first recorded errors: the steering object's own, and each wheel's
''
'' @returns eError - this cog's first ERR_* code raised by the steering object itself, NO_ERROR when none; cleared by this call
'' @returns eLeftError - this cog's first ERR_* code raised by the left wheel, NO_ERROR when none; cleared by this call
'' @returns eRightError - this cog's first ERR_* code raised by the right wheel, NO_ERROR when none; cleared by this call

    ' Three results, because the wheels can fail differently and one combined code would lose one of them.
    '  Each wheel's slot for this cog is private to this object, so this is the only call that drains it.
    eLeftError := ltWheel.getError()
    eRightError := rtWheel.getError()
    eError := lastError[COGID()]
    lastError[COGID()] := NO_ERROR

PUB getDistance(eDistanceUnits) : leftDistanceInUnits, rightDistanceInUnits
'' Returns the distance in {distanceUnits} [DDU_MM, DDU_CM, DDU_IN, DDU_FT, DDU_M, DDU_KM, DDU_MI] travelled by each motor since last reset
''
'' @param eDistanceUnits - units of the returned distances: DDU_MM, DDU_CM, DDU_IN, DDU_FT, DDU_M, DDU_KM or DDU_MI
'' @returns leftDistanceInUnits - left wheel distance; 0, with ERR_BAD_UNITS or ERR_NO_WHEEL_DIA recorded for getError(), when it cannot be measured
'' @returns rightDistanceInUnits - right wheel distance; 0, with ERR_BAD_UNITS or ERR_NO_WHEEL_DIA recorded for getError(), when it cannot be measured

    debug[user.DBGCH_SENSE]("- gdi ", sdec_long(ltWheel.getposTrkHallTicks()), sdec_long(rtWheel.getposTrkHallTicks()))
    leftDistanceInUnits := convertDistance(ltWheel.getposTrkHallTicks(), eDistanceUnits)
    rightDistanceInUnits := convertDistance(rtWheel.getposTrkHallTicks(), eDistanceUnits)

PRI convertDistance(nValue, eDistanceUnits) : nDistanceInUnits | fValue
' Returns the distance in {distanceUnits} [DDU_MM, DDU_CM, DDU_IN, DDU_FT, DDU_M, DDU_KM, DDU_MI] travelled by this motor since last reset
'
' @param nValue - the wheel's tracked hall ticks
' @param eDistanceUnits - units of the returned distance
' @returns nDistanceInUnits - the distance; 0, with the ERR_* code recorded, when it cannot be measured

' Local Variables:
' @local fValue - the distance in mm (float), before the final unit conversion

    nDistanceInUnits := 0
    if user.WHEEL_DIA_IN_INCH == 0.0
        recordError(ERR_NO_WHEEL_DIA)
        debug[user.DBGCH_ERROR]("! ERROR: distance calcs not supported as wheel dia. is ZERO!!")
    else
        ' before start() travel-per-tick is 0, but so is every tracked tick count, so 0 is the true distance
        ' task 3502: fValue is millimetres -- ticks x (mm per tick x100) / 100. Before 6.0.0 this
        '  multiplied by the x10 constant and never divided the x10 back out, so every arm below
        '  reported ten times the distance travelled (isp_bldc_motor.spin2 getDistance() divides
        '  correctly). It uses the same tickInMM_x100 as stopAfterDistance(), so the two stay
        '  inverses of each other.
        fValue := float(nValue) *. float(tickInMM_x100) /. 100.0
        case eDistanceUnits
            DDU_MM:
                nDistanceInUnits := round(fValue)
            DDU_CM:
                nDistanceInUnits := round(fValue /. 10.0)
            DDU_M:
                nDistanceInUnits := round(fValue /. 1000.0)                                             ' in M
            DDU_KM:
                nDistanceInUnits := round(fValue /. 1000.0 /. 1000.0)                                   ' in kM
            DDU_IN:
                nDistanceInUnits := round(distConv.fMm2inFloat(fValue))            '
            DDU_FT:
                nDistanceInUnits := round(distConv.fMm2inFloat(fValue) /. 12.0)                         ' in FT
            DDU_MI:
                nDistanceInUnits := round(distConv.fMm2inFloat(fValue) /. 12.0 /. 5280.0)               ' in MI
            other:
                recordError(ERR_BAD_UNITS)
                debug[user.DBGCH_ERROR]("! ERROR: invalid distanceUnits Value:", udec_long(eDistanceUnits))

PUB getRotationCount(eRotationUnits) : leftRotationCount, rightRotationCount
'' Returns accumulated {*RotationCount} in {rotationUnits} [DRU_DEGREES, DRU_ROTATIONS], since last reset, for each of the motors.
''
'' @param eRotationUnits - units of the returned rotations: DRU_HALL_TICKS, DRU_DEGREES or DRU_ROTATIONS
'' @returns leftRotationCount - left wheel rotation; 0, with ERR_BAD_UNITS recorded for getError(), when the units are not DRU_*
'' @returns rightRotationCount - right wheel rotation; 0, with ERR_BAD_UNITS recorded for getError(), when the units are not DRU_*

    debug[user.DBGCH_SENSE]("- grc ", sdec_long(ltWheel.getposTrkHallTicks()), sdec_long(rtWheel.getposTrkHallTicks()))
    leftRotationCount := convertRotationCount(ltWheel.getposTrkHallTicks(), eRotationUnits)
    rightRotationCount := convertRotationCount(rtWheel.getposTrkHallTicks(), eRotationUnits)

PRI convertRotationCount(nValue, eRotationUnits) : rotationCount | degreesPerTic, ticsPerRotation
' Returns accumulated {rotationCount} in {rotationUnits} [DRU_DEGREES, DRU_ROTATIONS, or DRU_HALL_TICKS], since last reset, for this motor.
'
' @param nValue - the wheel's tracked hall ticks
' @param eRotationUnits - units of the returned rotation
' @returns rotationCount - the rotation; 0, with ERR_BAD_UNITS recorded, when the units are not DRU_*

' Local Variables:
' @local degreesPerTic - degrees of rotation per hall tick for this motor
' @local ticsPerRotation - hall ticks per rotation for this motor

    rotationCount := 0

    degreesPerTic, ticsPerRotation := ltWheel.hallTicInfoForMotor()

    case eRotationUnits
        DRU_HALL_TICKS:
            rotationCount := nValue
        DRU_DEGREES:
            ' degrees = ticks * 15, 4
            rotationCount := nValue * degreesPerTic
        DRU_ROTATIONS:
            ' rotations = ticks / 24, 90
            rotationCount := nValue / ticsPerRotation
        other:
            recordError(ERR_BAD_UNITS)
            debug[user.DBGCH_ERROR]("! ERROR: invalid rotationUnits Value:", udec_long(eRotationUnits))

PUB getPower() : leftPower, rightPower
'' Returns the last specified power value [-100 thru +100] for each of the motors (will be zero if the motor is stopped).
''

    leftPower := ltWheel.getPower()
    rightPower := rtWheel.getPower()

PUB getCurrent() : nLtAmps, nLtWatts, nRtAmps, nRtWatts
'' Returns the latest current sense values for each motor
''

    nLtAmps, nLtWatts := ltWheel.getCurrent()
    nRtAmps, nRtWatts := rtWheel.getCurrent()

PUB getHallIntegrityCounts() : nLtMissed, nLtIllegal, nRtMissed, nRtIllegal
'' Return the hall-sensor integrity counts for each motor since the motors were last started
''
'' @returns nLtMissed - left motor: times the hall code changed without a countable single step
'' @returns nLtIllegal - left motor: times the hall sensors entered an illegal code (%000 or %111)
'' @returns nRtMissed - right motor: times the hall code changed without a countable single step
'' @returns nRtIllegal - right motor: times the hall sensors entered an illegal code (%000 or %111)

    nLtMissed, nLtIllegal := ltWheel.getHallIntegrityCounts()
    nRtMissed, nRtIllegal := rtWheel.getHallIntegrityCounts()

PUB getStatus() : eLeftStatus, eRightStatus
'' Returns status of motor drive state for each motor: enumerated constant: DS_MOVING, DS_HOLDING or DS_OFF
''

    eLeftStatus := ltWheel.getStatus()
    eRightStatus := rtWheel.getStatus()

PRI getDriverState() : eLeftState, eRightState
' Returns status of motor-driver state for each motor: enumerated constants: DCS_*
    eLeftState := ltWheel.getDriverState()
    eRightState := rtWheel.getDriverState()

PRI getFaultStatus() : bLeftStatus, bRightStatus
' Returns status of motor-driver fault-state for each motor: T/F
'  S-5: a read only. Each wheel's fault latch (isFaultSignal()) is the sticky record that a fault
'  happened, so nothing here clears it; only the motor object's clearFaultSignal() or a restart does.
    bLeftStatus := ltWheel.isFaulted()
    bRightStatus := rtWheel.isFaulted()

PUB getMaxSpeed() : nSpeed
'' Returns the last specified {maxSpeed}
''

    ' NOTE: they both contain same value so return only right-wheel value
    'nSpeed := ltWheel.getMaxSpeed()  ' return last specified user value
    nSpeed := rtWheel.getMaxSpeed()  ' return last specified user value

PUB getMaxSpeedForDistance() : nSpeed4dist
'' Returns the last specified {maxSpeedForDistance}
''

    ' NOTE: they both contain same value so return only right-wheel value
    'nSpeed4dist := ltWheel.getMaxSpeedForDistance()  ' return last specified user value
    nSpeed4dist := rtWheel.getMaxSpeedForDistance()  ' return last specified user value

PUB getLeftDebugData() : nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars
'' Return pointers to HDMI-debug data structures for LEFT motor-object instance
''

    nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars := ltWheel.getDebugData()

PUB getRightDebugData() : nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars
'' Return pointers to HDMI-debug data structures for LEFT motor-object instance
''

    nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars := rtWheel.getDebugData()

CON { --- PUBLIC Utility Methods --- }

PUB validBasePinForChoice(userBasePin) : legalBasePin
'' VALIDATE users' base-pin choice returns legalBasePin or INVALID_PIN_BASE
''

    legalBasePin := ltWheel.validBasePinForChoice(userBasePin)

PUB validVoltageForChoice(userVoltage) : legalVoltage
'' VALIDATE users' voltage choice returns legalVoltage or INVALID_VOLTAGE
''

    legalVoltage := ltWheel.validVoltageForChoice(userVoltage)

PUB validMotorForChoice(userMotor) : legalMotor
'' VALIDATE users' motor choice returns legalMotor or INVALID_MOTOR
''

    legalMotor := ltWheel.validMotorForChoice(userMotor)

PUB validDetectModeForChoice(userDetMode) : legalMode
'' VALIDATE users' detection mode choice returns legalMode or INVALID_DET_MODE
''

    legalMode := ltWheel.validDetectModeForChoice(userDetMode)

CON ' --- TEST-USE ONLY Methods ---

{
    Bench-harness pass-throughs. These are NOT product API and are deliberately absent from
    DRIVE-OBJECTS.md. They exist so a test top-level can reach each wheel's driver state,
    fault latch and raw telemetry: a test cannot simply declare its own isp_bldc_motor,
    because that second instance would fight this object's two for the same pins.

    Mirrors the TEST-USE ONLY convention already used in isp_bldc_motor.spin2.
}

PUB testGetDriverState() : eLeftState, eRightState
'' TESTING USE: return motor-driver state for each motor
''
'' @returns eLeftState - state of left-motor driver: enumerated constant DCS_*
'' @returns eRightState - state of right-motor driver: enumerated constant DCS_*

    eLeftState := ltWheel.getDriverState()
    eRightState := rtWheel.getDriverState()

PUB testGetBoardTypes() : eLeftBoard, eRightBoard
'' TESTING USE: return the detected driver-board revision for each motor
''
'' @returns eLeftBoard - board revision of the left motor: enumerated constant REV_*
'' @returns eRightBoard - board revision of the right motor: enumerated constant REV_*

    eLeftBoard := ltWheel.getBoardType()
    eRightBoard := rtWheel.getBoardType()

PUB testGetFaultStatus() : bLtFaulted, bLtSignal, bRtFaulted, bRtSignal
'' TESTING USE: return fault state and fault signal for each motor, without side effects
''
'' @returns bLtFaulted - T/F where T means the left motor has faulted
'' @returns bLtSignal - T/F where T means the left motor's fault signal is latched
'' @returns bRtFaulted - T/F where T means the right motor has faulted
'' @returns bRtSignal - T/F where T means the right motor's fault signal is latched

    ' NOTE: a read with no side effects. The fault latch (bLtSignal/bRtSignal) stays set after the
    '  fault state (bLtFaulted/bRtFaulted) clears, until clearFaultSignal() or a restart, so a test
    '  can see that a fault happened after the motor has recovered.
    bLtFaulted := ltWheel.isFaulted()
    bLtSignal := ltWheel.isFaultSignal()
    bRtFaulted := rtWheel.isFaulted()
    bRtSignal := rtWheel.isFaultSignal()

PUB testGetRawHallTicks() : nLeftPos, nRightPos
'' TESTING USE: return the raw driver-maintained tick count for each motor
''
'' @returns nLeftPos - raw hall-tick count for the left motor
'' @returns nRightPos - raw hall-tick count for the right motor

    nLeftPos := ltWheel.getRawHallTicks()
    nRightPos := rtWheel.getRawHallTicks()

PUB testLeftGetTelemetry() : nDuty, nErr, nSenseI, nSenseU, nSenseV, nSenseW, eDrvrState, bDidFault
'' TESTING USE: snapshot the LEFT motor's per-cycle driver status values in a single call
''
'' @returns nDuty - latest duty value reported by the driver
'' @returns nErr - latest position-error value reported by the driver
'' @returns nSenseI - latest current-sense reading, in mV
'' @returns nSenseU - latest phase-U sense reading, in mV
'' @returns nSenseV - latest phase-V sense reading, in mV
'' @returns nSenseW - latest phase-W sense reading, in mV
'' @returns eDrvrState - state of driver: enumerated constant DCS_*
'' @returns bDidFault - T/F where T means the driver has faulted

    nDuty, nErr, nSenseI, nSenseU, nSenseV, nSenseW, eDrvrState, bDidFault := ltWheel.testGetTelemetry()

PUB testRightGetTelemetry() : nDuty, nErr, nSenseI, nSenseU, nSenseV, nSenseW, eDrvrState, bDidFault
'' TESTING USE: snapshot the RIGHT motor's per-cycle driver status values in a single call
''
'' @returns nDuty - latest duty value reported by the driver
'' @returns nErr - latest position-error value reported by the driver
'' @returns nSenseI - latest current-sense reading, in mV
'' @returns nSenseU - latest phase-U sense reading, in mV
'' @returns nSenseV - latest phase-V sense reading, in mV
'' @returns nSenseW - latest phase-W sense reading, in mV
'' @returns eDrvrState - state of driver: enumerated constant DCS_*
'' @returns bDidFault - T/F where T means the driver has faulted

    nDuty, nErr, nSenseI, nSenseU, nSenseV, nSenseW, eDrvrState, bDidFault := rtWheel.testGetTelemetry()

PUB testLeftGetResults() : nMaxRPM, maxTics, bDidFault, max_mV
'' TESTING USE: return results of a test pass for the LEFT motor
''
'' @returns nMaxRPM - highest RPM seen during the pass
'' @returns maxTics - highest hall-tick count seen in one second during the pass
'' @returns bDidFault - T/F where T means the motor faulted during the pass
'' @returns max_mV - highest current-sense reading seen during the pass, in mV

    nMaxRPM, maxTics, bDidFault, max_mV := ltWheel.testGetResults()

PUB testRightGetResults() : nMaxRPM, maxTics, bDidFault, max_mV
'' TESTING USE: return results of a test pass for the RIGHT motor
''
'' @returns nMaxRPM - highest RPM seen during the pass
'' @returns maxTics - highest hall-tick count seen in one second during the pass
'' @returns bDidFault - T/F where T means the motor faulted during the pass
'' @returns max_mV - highest current-sense reading seen during the pass, in mV

    nMaxRPM, maxTics, bDidFault, max_mV := rtWheel.testGetResults()

PUB testLeftGetRpm() : nRpm
'' TESTING USE: return the LEFT motor's current RPM, averaged over its hall-tick window
''
'' @returns nRpm - current RPM, averaged over the ~1 sec hall-tick window; see
''  isp_bldc_motor.spin2's testGetRpm() for the sense-task precondition

    nRpm := ltWheel.testGetRpm()

PUB testRightGetRpm() : nRpm
'' TESTING USE: return the RIGHT motor's current RPM, averaged over its hall-tick window
''
'' @returns nRpm - current RPM, averaged over the ~1 sec hall-tick window; see
''  isp_bldc_motor.spin2's testGetRpm() for the sense-task precondition

    nRpm := rtWheel.testGetRpm()

PUB testLeftDriveAtMotorIncrement(motorIncre) : eError | eStatus, eLeftStatus, eRightStatus
'' TESTING USE: drive the LEFT motor at a raw increment
''
'' @param motorIncre - signed raw driver increment; sign selects the commutation offset
'' @returns eError - NO_ERROR, ERR_NOT_STARTED / ERR_NO_RESPONSE, or the wheel's ERR_EMERGENCY_STOPPED (also recorded for getError())

' Local Variables:
' @local eStatus - the front cog's platform status
' @local eLeftStatus - the front cog's status for the left wheel
' @local eRightStatus - the front cog's status for the right wheel

    ' NOTE: this path bypasses incrementForPower() and the reversed-motor flag, so the sign
    '  passed here is the sign the driver sees.
    eStatus, eLeftStatus, eRightStatus := postRequest(ltWheel.REQ_TEST_INCREMENT, LEFT_MOTOR_BIT, motorIncre, 0, 0)
    eError := recordRequestResult(eStatus, eLeftStatus, eRightStatus)

PUB testRightDriveAtMotorIncrement(motorIncre) : eError | eStatus, eLeftStatus, eRightStatus
'' TESTING USE: drive the RIGHT motor at a raw increment
''
'' @param motorIncre - signed raw driver increment; sign selects the commutation offset
'' @returns eError - NO_ERROR, ERR_NOT_STARTED / ERR_NO_RESPONSE, or the wheel's ERR_EMERGENCY_STOPPED (also recorded for getError())

' Local Variables:
' @local eStatus - the front cog's platform status
' @local eLeftStatus - the front cog's status for the left wheel
' @local eRightStatus - the front cog's status for the right wheel

    ' NOTE: see testLeftDriveAtMotorIncrement() - the reversed-motor flag is bypassed here.
    eStatus, eLeftStatus, eRightStatus := postRequest(ltWheel.REQ_TEST_INCREMENT, RIGHT_MOTOR_BIT, motorIncre, 0, 0)
    eError := recordRequestResult(eStatus, eLeftStatus, eRightStatus)

PUB testLeftSetFwdRevOffsets(newOfsDegr, bFwdIsInverse) : eError
'' TESTING USE: set the LEFT motor's commutation offsets so we can characterize current draw
''
'' @param newOfsDegr - commutation offset, in degrees
'' @param bFwdIsInverse - T/F where T means forward is the inverse of reverse
'' @returns eError - NO_ERROR

    eError := ltWheel.testSetFwdRevOffsets(newOfsDegr, bFwdIsInverse)

PUB testRightSetFwdRevOffsets(newOfsDegr, bFwdIsInverse) : eError
'' TESTING USE: set the RIGHT motor's commutation offsets so we can characterize current draw
''
'' @param newOfsDegr - commutation offset, in degrees
'' @param bFwdIsInverse - T/F where T means forward is the inverse of reverse
'' @returns eError - NO_ERROR

    eError := rtWheel.testSetFwdRevOffsets(newOfsDegr, bFwdIsInverse)

PUB testLeftSetFwdRevIndep(fwdDegrees, revDegrees) : eError
'' TESTING USE: set the LEFT motor's forward and reverse commutation offsets independently
''
'' @param fwdDegrees - commutation offset for negative increments, in degrees
'' @param revDegrees - commutation offset for positive increments, in degrees
'' @returns eError - NO_ERROR

    eError := ltWheel.testSetFwdRevIndep(fwdDegrees, revDegrees)

PUB testRightSetFwdRevIndep(fwdDegrees, revDegrees) : eError
'' TESTING USE: set the RIGHT motor's forward and reverse commutation offsets independently
''
'' @param fwdDegrees - commutation offset for negative increments, in degrees
'' @param revDegrees - commutation offset for positive increments, in degrees
'' @returns eError - NO_ERROR

    eError := rtWheel.testSetFwdRevIndep(fwdDegrees, revDegrees)

PUB testLeftGetFwdRevIndep() : fwdDegrees, revDegrees
'' TESTING USE: return the LEFT motor's currently-applied forward and reverse offsets
''
'' @returns fwdDegrees - commutation offset for negative increments, in degrees
'' @returns revDegrees - commutation offset for positive increments, in degrees

    fwdDegrees, revDegrees := ltWheel.testGetFwdRevIndep()

PUB testRightGetFwdRevIndep() : fwdDegrees, revDegrees
'' TESTING USE: return the RIGHT motor's currently-applied forward and reverse offsets
''
'' @returns fwdDegrees - commutation offset for negative increments, in degrees
'' @returns revDegrees - commutation offset for positive increments, in degrees

    fwdDegrees, revDegrees := rtWheel.testGetFwdRevIndep()

PUB testLeftSetLimit(newMaxLimit) : eError
'' TESTING USE: set the LEFT motor's override increment limit
''
'' @param newMaxLimit - maximum raw driver increment allowed at full power
'' @returns eError - NO_ERROR

    eError := ltWheel.testSetLimit(newMaxLimit)

PUB testRightSetLimit(newMaxLimit) : eError
'' TESTING USE: set the RIGHT motor's override increment limit
''
'' @param newMaxLimit - maximum raw driver increment allowed at full power
'' @returns eError - NO_ERROR

    eError := rtWheel.testSetLimit(newMaxLimit)

PUB testLeftSetMotorReversed(bEnable) : eError
'' TESTING USE: set -or clear- the LEFT motor's reversed-motor flag
''
'' @param bEnable - T/F where T means forward and reverse are swapped for this motor
'' @returns eError - NO_ERROR

    eError := ltWheel.testSetMotorReversed(bEnable)

PUB testRightSetMotorReversed(bEnable) : eError
'' TESTING USE: set -or clear- the RIGHT motor's reversed-motor flag
''
'' @param bEnable - T/F where T means forward and reverse are swapped for this motor
'' @returns eError - NO_ERROR

    ' NOTE: start() calls forwardIsReverse() on the right wheel. Clearing it here is how a
    '  test measures both wheels on the same commutation offset.
    eError := rtWheel.testSetMotorReversed(bEnable)

PUB testLeftResetFault() : eError | pollIdx
'' TESTING USE: reset the LEFT motor's fault indicator tripped during test
''
'' @returns eError - NO_ERROR, or ERR_FAULT_NOT_CLEARED (recorded in the left wheel's slot for getError()) when the driver had not stopped by the end of the wait

' Local Variables:
' @local pollIdx - polls of the driver state taken so far

    ' PL-28(a): the driver leaves DCS_FAULTED only through a stop request. The stop is the securing
    '  path (posted to the front cog, never written here while it runs); the fault latch and the wait
    '  are on this cog, as the motor object's testResetFault() does them.
    eError := NO_ERROR
    if ltWheel.isFaultSignal() == TRUE
        debug[user.DBGCH_TEST]("STEER: reset left fault...")
        secureWheels(LEFT_MOTOR_BIT, FALSE)
        ltWheel.clearFaultSignal()
        waitms(FAULT_CLEAR_SETTLE_MS)
        repeat pollIdx from 1 to FAULT_CLEAR_POLLS
            if ltWheel.isStopped() == TRUE
                quit
            waitms(FAULT_CLEAR_POLL_MS)
        if ltWheel.isStopped() == FALSE
            eError := ltWheel.recordCallerError(ERR_FAULT_NOT_CLEARED)
            debug[user.DBGCH_TEST]("STEER: left fault reset wait ended still not stopped")
    else
        debug[user.DBGCH_TEST]("STEER: testLeftResetFault() NOT faulted!?")

PUB testRightResetFault() : eError | pollIdx
'' TESTING USE: reset the RIGHT motor's fault indicator tripped during test
''
'' @returns eError - NO_ERROR, or ERR_FAULT_NOT_CLEARED (recorded in the right wheel's slot for getError()) when the driver had not stopped by the end of the wait

' Local Variables:
' @local pollIdx - polls of the driver state taken so far

    ' see testLeftResetFault()
    eError := NO_ERROR
    if rtWheel.isFaultSignal() == TRUE
        debug[user.DBGCH_TEST]("STEER: reset right fault...")
        secureWheels(RIGHT_MOTOR_BIT, FALSE)
        rtWheel.clearFaultSignal()
        waitms(FAULT_CLEAR_SETTLE_MS)
        repeat pollIdx from 1 to FAULT_CLEAR_POLLS
            if rtWheel.isStopped() == TRUE
                quit
            waitms(FAULT_CLEAR_POLL_MS)
        if rtWheel.isStopped() == FALSE
            eError := rtWheel.recordCallerError(ERR_FAULT_NOT_CLEARED)
            debug[user.DBGCH_TEST]("STEER: right fault reset wait ended still not stopped")
    else
        debug[user.DBGCH_TEST]("STEER: testRightResetFault() NOT faulted!?")

PUB testLeftResetMaxValues() : eError | eStatus, eLeftStatus, eRightStatus
'' TESTING USE: reset the LEFT motor's accumulated maximum sense values
''
'' @returns eError - NO_ERROR once the front cog has applied the reset, or ERR_NOT_STARTED / ERR_NO_RESPONSE (also recorded for getError())

' Local Variables:
' @local eStatus - the front cog's platform status
' @local eLeftStatus - the front cog's status for the left wheel
' @local eRightStatus - the front cog's status for the right wheel

    eStatus, eLeftStatus, eRightStatus := postRequest(ltWheel.REQ_RESET_MAX, LEFT_MOTOR_BIT, 0, 0, 0)
    eError := recordRequestResult(eStatus, eLeftStatus, eRightStatus)

PUB testRightResetMaxValues() : eError | eStatus, eLeftStatus, eRightStatus
'' TESTING USE: reset the RIGHT motor's accumulated maximum sense values
''
'' @returns eError - NO_ERROR once the front cog has applied the reset, or ERR_NOT_STARTED / ERR_NO_RESPONSE (also recorded for getError())

' Local Variables:
' @local eStatus - the front cog's platform status
' @local eLeftStatus - the front cog's status for the left wheel
' @local eRightStatus - the front cog's status for the right wheel

    eStatus, eLeftStatus, eRightStatus := postRequest(ltWheel.REQ_RESET_MAX, RIGHT_MOTOR_BIT, 0, 0, 0)
    eError := recordRequestResult(eStatus, eLeftStatus, eRightStatus)

PUB testGetFrontStats() : nPasses, nLatePasses, nMaxPassTicks, nStackHighWater | longIdx
'' TESTING USE: return the steering front cog's loop health counters and its stack high-water mark
''
'' PL-75: the mark is measured against THIS object's STACK_SIZE_LONGS, which a caller reads as
'' steering.STACK_SIZE_LONGS -- it is NOT the motor object's. This cog services TWO wheels and is
'' sized separately. A mark equal to that size means the reading is SATURATED: the sentinel is gone
'' everywhere, so "used all of it" and "used more than all of it" cannot be told apart.
''
'' @returns nPasses - passes the front cog has started since it was launched
'' @returns nLatePasses - passes that overran their slot and were re-anchored, never caught up
'' @returns nMaxPassTicks - the longest pass body seen, in system ticks
'' @returns nStackHighWater - stack longs ever used, of this object's STACK_SIZE_LONGS

' Local Variables:
' @local longIdx - index of the stack long being inspected, from the top down

    nPasses := frontPasses
    nLatePasses := frontLatePasses
    nMaxPassTicks := frontMaxPassTicks
    ' the stack was filled with STACK_SENTINEL before launch and grows upward from its base
    ' PL-75: scanned against THIS object's size -- scanning a 256-long stack to 128 would cap the
    '  mark at 128 and make the instrument blind to the overflow it exists to detect (doctrine D2:
    '  a discovery failure must never render as a value)
    nStackHighWater := 0
    repeat longIdx from STACK_SIZE_LONGS - 1 to 0
        if taskStack[longIdx] <> STACK_SENTINEL
            nStackHighWater := longIdx + 1
            quit

PUB testLeftGetRampingValues() : minRamp, maxRamp, incRamp, decrRamp
'' TESTING USE: return the LEFT motor's ramping parameters
''
''  setAcceleration() is the only ramp write this object offers and it replaces incRamp alone, so a test
''  that changes the ramp reads all four back to prove what it restored.
''
'' @returns minRamp - ramp_min, the increment added on the first drive pass
'' @returns maxRamp - ramp_max, the increment ceiling
'' @returns incRamp - ramp_inc, added to the ramp every drive pass
'' @returns decrRamp - ramp_down, the fixed ramp-down step

    minRamp, maxRamp, incRamp, decrRamp := ltWheel.getRampingValues()

PUB testRightGetRampingValues() : minRamp, maxRamp, incRamp, decrRamp
'' TESTING USE: return the RIGHT motor's ramping parameters
''
'' @returns minRamp - ramp_min, the increment added on the first drive pass
'' @returns maxRamp - ramp_max, the increment ceiling
'' @returns incRamp - ramp_inc, added to the ramp every drive pass
'' @returns decrRamp - ramp_down, the fixed ramp-down step

    minRamp, maxRamp, incRamp, decrRamp := rtWheel.getRampingValues()

PUB testLeftGetCurrentLimitState() : nPeakA, nContA, bDeratedNow, nPhaseAvgMa, nLimitK
'' TESTING USE: return the LEFT motor's current limits, derate state, judged average and fold-back factor
''
'' @returns nPeakA - the peak phase-current limit, amps
'' @returns nContA - the continuous phase-current limit, amps
'' @returns bDeratedNow - T/F where T means the driver's fold-back holds the continuous limit, not the peak
'' @returns nPhaseAvgMa - the front cog's ~1 s average of the phase-current lower bound, mA
'' @returns nLimitK - the fold-back factor the driver reads

    nPeakA, nContA, bDeratedNow, nPhaseAvgMa, nLimitK := ltWheel.testGetCurrentLimitState()

PUB testRightGetCurrentLimitState() : nPeakA, nContA, bDeratedNow, nPhaseAvgMa, nLimitK
'' TESTING USE: return the RIGHT motor's current limits, derate state, judged average and fold-back factor
''
'' @returns nPeakA - the peak phase-current limit, amps
'' @returns nContA - the continuous phase-current limit, amps
'' @returns bDeratedNow - T/F where T means the driver's fold-back holds the continuous limit, not the peak
'' @returns nPhaseAvgMa - the front cog's ~1 s average of the phase-current lower bound, mA
'' @returns nLimitK - the fold-back factor the driver reads

    nPeakA, nContA, bDeratedNow, nPhaseAvgMa, nLimitK := rtWheel.testGetCurrentLimitState()

CON { --- PRIVATE Utility Methods --- }

VAR { error record }
    LONG    lastError[ltWheel.COG_SLOT_COUNT]   ' per calling cog: the steering object's first error not yet collected, NO_ERROR when none

CON { front cog requests -- the protocol and REQ_* codes are the motor object's (isp_bldc_motor.spin2) }

    ' Owned motors, as indexes into ackMotorStatus[] and as bits in a request's motor mask:
    '  LEFT_MOTOR_IDX / LEFT_MOTOR_BIT   - the left wheel (ltWheel)
    '  RIGHT_MOTOR_IDX / RIGHT_MOTOR_BIT - the right wheel (rtWheel)
    '  BOTH_MOTORS                       - both wheels
    OWNED_MOTOR_MAX = 2
    #0, LEFT_MOTOR_IDX, RIGHT_MOTOR_IDX
    LEFT_MOTOR_BIT  = 1 << LEFT_MOTOR_IDX
    RIGHT_MOTOR_BIT = 1 << RIGHT_MOTOR_IDX
    BOTH_MOTORS     = LEFT_MOTOR_BIT | RIGHT_MOTOR_BIT

    ' testLeft/RightResetFault(): the wait for a faulted driver to reach DCS_STOPPED after its stop
    FAULT_CLEAR_SETTLE_MS = 30          ' values clear in 20 ms; extra time before the first check
    FAULT_CLEAR_POLL_MS   = 2           ' between checks
    FAULT_CLEAR_POLLS     = 1_000       ' checks before giving up (about 2 s)

VAR { front cog request slots -- one per calling cog, indexed by COGID(); every long has exactly one writer }
    LONG    reqCmd[ltWheel.COG_SLOT_COUNT]      ' caller-written: REQ_* code
    LONG    reqMask[ltWheel.COG_SLOT_COUNT]     ' caller-written: owned-motor selector, bit i = motor i
    LONG    reqArg1[ltWheel.COG_SLOT_COUNT]     ' caller-written: arguments, meaning per REQ_*
    LONG    reqArg2[ltWheel.COG_SLOT_COUNT]
    LONG    reqArg3[ltWheel.COG_SLOT_COUNT]
    LONG    reqNextSeq[ltWheel.COG_SLOT_COUNT]  ' caller-written: this cog's own sequence counter
    LONG    reqSeq[ltWheel.COG_SLOT_COUNT]      ' caller-written LAST: SEQ_IDLE, or the published sequence
    LONG    ackStatus[ltWheel.COG_SLOT_COUNT]   ' front-written: the platform status (NO_ERROR, or ERR_NOT_STARTED on EXIT)
    LONG    ackMotorStatus[ltWheel.COG_SLOT_COUNT * OWNED_MOTOR_MAX]  ' front-written FIRST: per owned motor, [slot * OWNED_MOTOR_MAX + motor]
    LONG    ackSeq[ltWheel.COG_SLOT_COUNT]      ' front-written LAST: the sequence it answered
    LONG    frontPasses                         ' front-written heartbeat (zeroed by start before the launch)
    LONG    frontLatePasses                     ' front-written: passes that overran their slot
    LONG    frontMaxPassTicks                   ' front-written: longest pass body, in ticks

PRI recordRequestResult(eStatus, eLeftStatus, eRightStatus) : eError
' Record a posted request's result on this cog: the platform status in this object's slot, each wheel's status in that wheel's slot.
'
' @param eStatus - the platform status (NO_ERROR, ERR_NOT_STARTED or ERR_NO_RESPONSE)
' @param eLeftStatus - the left wheel's status
' @param eRightStatus - the right wheel's status
' @returns eError - {eStatus} when it is an error, else the left wheel's code when it failed, else the right's

    recordError(eStatus)
    ltWheel.recordCallerError(eLeftStatus)
    rtWheel.recordCallerError(eRightStatus)
    eError := eStatus
    if eError == NO_ERROR
        eError := firstError(eLeftStatus, eRightStatus)

PRI recordError(eCode) : eSameCode
' Record the calling cog's first steering error: the ONLY writer of lastError[]; returns the code unchanged.
'
' @param eCode - NO_ERROR or an ERR_* code
' @returns eSameCode - {eCode}, so a failing path can record and return in one expression

    ' Sticky first, and success never writes: only getError() clears a slot. Errors a wheel raises
    '  are recorded in that wheel's own slot, so this slot holds only what this object detected.
    if (eCode <> NO_ERROR) and (lastError[COGID()] == NO_ERROR)
        lastError[COGID()] := eCode
    eSameCode := eCode

PRI firstError(eLeftError, eRightError) : eError
' Combine the two wheels' results for one command: the left wheel's code when it failed, else the right's.
'
' @param eLeftError - the left wheel's result
' @param eRightError - the right wheel's result
' @returns eError - NO_ERROR when both succeeded; each wheel's code is already recorded in its own slot

    eError := (eLeftError <> NO_ERROR) ? eLeftError : eRightError

PRI calcPowerForDirection(power, direction) : ltPower, rtPower | limitPwr, limitDir, reducedPower
' determine porportional power based on direction
    limitPwr :=  -100 #> power <# 100
    limitDir :=  -100 #> direction <# 100
    reducedPower := ((100 - abs(limitDir)) * limitPwr) / 100                    ' calculate reduced power for turning
    {
      Let's better handle small changes of direction
      when turning towards a direction
        motor on other side stays at power
        motor on direction towards reduces in power as direction increases
        e.g. if turning towards right, left motor stays at power, right motor is reduced
        Note: doesn't spin in place, since reduced power motor doesn't reverse
    }
    ltPower := ((limitDir <= 0)) ? limitPwr : reducedPower                      ' which side if either should be reducedpower
    rtPower := ((limitDir >= 0)) ? limitPwr : reducedPower
    debug[user.DBGCH_COMMAND]("* calcPowerForDirection(", sdec_long(power), ", ", sdec_long(direction), ") -> ", sdec_long(ltPower), sdec_long(rtPower))

PUB isReady() : bState
'' Return T/F where T means the both motor cogs are running
''

    bState := ltWheel.isReady() and rtWheel.isReady()

PUB isStopped() : bState
'' Return T/F where T means the both motors are stopped
''

    bState := ltWheel.isStopped() and rtWheel.isStopped()

PUB isStarting() : bState
'' Return T/F where T means the either motor is spinning up
''

    bState := ltWheel.isStarting() or rtWheel.isStarting()

PUB isTurning() : bState
'' Return T/F where T means the either motor is rotating
''

    bState := ltWheel.isTurning() or rtWheel.isTurning()

PUB isFaulted() : bState
'' Return T/F where T means either motor is faulted now (a motor's fault clears when a stop or a different power is commanded)
''
'' @returns bState - T/F where T means the left or the right motor driver is faulted

    bState := ltWheel.isFaulted() or rtWheel.isFaulted()

PUB isEmergency() : bState
'' Return T/F where T means either motor is emergency-stopped
''
'' @returns bState - T/F where T means the left or the right motor driver is emergency-stopped

    bState := ltWheel.isEmergency() or rtWheel.isEmergency()

CON { -- TASK: the steering front cog -- }

' The front cog is the owner of both wheels: the only cog that commands their drivers, tracks their
'  position and enforces the platform's distance and time stops, once per ms on the motor object's
'  schedule constants (FRONT_LOOP_HZ). C-3 (task 3512): a stop is commanded in the pass its limit is
'  seen and taken within one drive pass, about 1.5 ms. The DECELERATION distance is unchanged and
'  dominates every distance stop (C-4: 76 ticks from half speed).

' PL-75: THIS COG NEEDS ITS OWN STACK SIZE, and until now it borrowed the motor object's.
'  isp_bldc_motor's STACK_SIZE_LONGS sizes a front cog that services ONE wheel. This one services
'  TWO through the front*() routines, so one constant cannot describe both call depths.
'  MEASURED at Visit 4: the single-motor front cog peaked at 114 of 128 and passed; THIS cog
'  reported 128 of 128 -- its high-water mark had reached its whole allocation.
'  A SATURATED READING IS THE DANGER, not the number. The mark is found by looking for surviving
'  STACK_SENTINEL longs, so once every sentinel is gone, "used exactly all of it" and "used MORE
'  than all of it" are indistinguishable -- and what lies immediately past taskStack is this
'  object's own tracking state (deltaTicks, tickInMM_x100), which every reported distance depends on.
'  So this is sized with real headroom, for the same reason and by the same reasoning that took the
'  motor object's constant from 48 to 128: the per-frame need is still not established, so make it
'  generous AND observable. testGetFrontStats() reports the mark; the NEXT reading is the one that
'  finally measures the true requirement, because it will not be saturated.
  STACK_SIZE_LONGS = 256                ' PL-75: was ltWheel.STACK_SIZE_LONGS (128), measured saturated
  STACK_SENTINEL   = ltWheel.STACK_SENTINEL   ' the fill pattern stays shared: it is a protocol value, not a size

VAR { time values & arrays }

    long    ticks1ms
    long    ticks1us

    long    senseCog                    ' the front cog: cogid + 1, 0 when not running

    long    taskStack[STACK_SIZE_LONGS]     ' PL-75: this object's own size, not the motor object's

VAR { Data for Motor Position Tracking }
    long    deltaTicks
    ' task 3502: mm-per-tick carried at x100 (not x10) -- see isp_bldc_motor.spin2's
    '  wheelGeometry() for why. 0 until start() sets it.
    long    tickInMM_x100
    '  --------------------------

    ' USER REQUESTS
    '  Position Tracking vars
    long    motorStopHallTicks
    long    motorStopMSecs
    '  Drive vars
    long    rqstPower
    long    rqstDirection
    long    rqstLtPower
    long    rqstRtPower
    long    userCutoff

    ' bitmask of motor cogs, used to sync updated to the 2 motors
    long    cogmask

    long    notUsed

CON { test pins for LA measurement }
'{
' if not using Logic Analyzer uncomment these routines
PRI LAINIT()

PRI LALOOPSTART()

PRI LALOOPEND()
'}
{
' if using Logic Analyzer uncomment these routines
    ' PIN_56 - PIN_63
    TEST_BASE_PIN        = 56
    TEST_PINS_ALL        = TEST_BASE_PIN addpins 7
    TEST_PIN_SNS_LOOP    = TEST_BASE_PIN + 0                                    ' LA grey
    TEST_PIN_SNS_LP_ACTV = TEST_BASE_PIN + 1                                    ' LA red

PRI LAINIT()
    pinlow(TEST_PIN_SNS_LOOP)
    pinlow(TEST_PIN_SNS_LP_ACTV)

PRI LALOOPSTART()
    pintoggle(TEST_PIN_SNS_LOOP)                                                ' set HI
    pintoggle(TEST_PIN_SNS_LP_ACTV)                                             ' start of active side
    pintoggle(TEST_PIN_SNS_LOOP)                                                ' set low   - start of loop

PRI LALOOPEND()
    pintoggle(TEST_PIN_SNS_LP_ACTV)                                             ' end of active side
'}

{ Steering front cog. The request protocol is the motor object's (see isp_bldc_motor.spin2 above
  its frontLoop()), with a motor mask per request and a status per owned motor:

  answer order: ackMotorStatus[slot * OWNED_MOTOR_MAX + motor] FIRST, then ackStatus[slot], then ackSeq[slot]

  The per-wheel work is the motor object's front*() routines, called only from this cog's call graph.
  Nothing reachable from frontLoop() calls recordError() or recordCallerError().
}

PRI frontLoop() | ticksPerPass, lateMarginTicks, nextDue, passStartTicks, passBodyTicks, passCount, bLeftBlocked, bRightBlocked
' FRONT COG: the platform's loop -- apply posted requests, track both wheels, enforce the platform stop limits and the current protection, once per ms.
'

' Local Variables:
' @local ticksPerPass - system ticks in one FRONT_LOOP_HZ pass
' @local lateMarginTicks - LATE_MARGIN_US in system ticks
' @local nextDue - getct() value at which the next pass is due
' @local passStartTicks - getct() when this pass began
' @local passBodyTicks - ticks this pass's body took
' @local passCount - passes run so far, the wheels' rpm window cadence counter
' @local bLeftBlocked - T/F where T means the left wheel has been blocked long enough to latch a protective stop
' @local bRightBlocked - T/F where T means the right wheel has been blocked long enough to latch a protective stop

    ' The entry writes no wheel command, e-stop or limit: it adopts them, so a stop written directly
    '  inside start()'s window survives the launch. The drivers were released before this cog existed.
    ticksPerPass := CLKFREQ / ltWheel.FRONT_LOOP_HZ
    lateMarginTicks := (CLKFREQ / ltWheel.US_PER_SEC) * ltWheel.LATE_MARGIN_US
    passCount := 0
    ltWheel.frontResetTracking(TRUE)
    rtWheel.frontResetTracking(TRUE)
    LAINIT()
    nextDue := getct() + ticksPerPass

    repeat
        passStartTicks := getct()
        frontPasses++                                                           ' heartbeat: start() waits for the first one
        passCount++

        ' 0. a stop written in an earlier pass is confirmed, or written again
        ltWheel.frontConfirmStop()
        rtWheel.frontConfirmStop()

        ' 1. requests: securing first, then the rest in slot order, then EXIT
        if frontServiceRequests() == TRUE
            quit                                                                ' EXIT acknowledged: park below

        LALOOPSTART()
        ' 2. tracking, then 3. limits, so a crossing seen in this pass is stopped in this pass
        ltWheel.frontTrack(passCount)
        rtWheel.frontTrack(passCount)
        if frontPlatformLimitsDue(getms()) == TRUE
            ltWheel.frontZeroPower()                                            ' PL-52: a distance/time stop clears getPower() too
            rtWheel.frontZeroPower()
        ' S-2: each wheel's current derate runs every pass; a blocked wheel secures BOTH (a platform never drives one wheel)
        bLeftBlocked := ltWheel.frontProtect()
        bRightBlocked := rtWheel.frontProtect()
        if (bLeftBlocked == TRUE) or (bRightBlocked == TRUE)
            ltWheel.frontProtectiveStop(ERR_PLATFORM_BLOCKED)
            rtWheel.frontProtectiveStop(ERR_PLATFORM_BLOCKED)
        showDriveStatesOnChange()
        LALOOPEND()

        ' 4. accounting, then the absolute schedule
        passBodyTicks := getct() - passStartTicks
        deltaTicks := passBodyTicks
        frontMaxPassTicks := frontMaxPassTicks #> passBodyTicks
        if (nextDue - getct()) < lateMarginTicks
            ' Late. WAITCT waits until the counter MATCHES its target, so a target already past would
            '  wait for the 32-bit counter to wrap. The wait is skipped and the schedule re-anchored:
            '  missed slots are counted, never replayed.
            frontLatePasses++
            nextDue := getct() + ticksPerPass
        else
            waitct(nextDue)
            nextDue += ticksPerPass

    ' EXIT: parked with no output until stop() cogstops this cog; it never returns, so its cog id
    '  cannot be released and reused before that cogstop
    repeat
        waitms(ltWheel.FRONT_PARK_MS)

PRI frontPlatformLimitsDue(nowMs) : bFired
' FRONT COG: return TRUE, and disarm the limit, when a stop written now leaves the platform at rest at its time limit or either wheel at rest at the distance limit.
'
' Each wheel's stop begins early by its own stopping distance, and the time stop by the longer of the two stopping times.
'
' @param nowMs - getms() for this pass
' @returns bFired - T/F where T means a limit fired and both wheels must be stopped now

    ' if both time and distance are armed, the time is checked until it passes, then the distance
    bFired := FALSE
    if (motorStopMSecs > 0) and (nowMs + (ltWheel.frontStopMs() #> rtWheel.frontStopMs()) >= motorStopMSecs)
        debug[user.DBGCH_SENSE]("-STEER- time limit reached")
        motorStopMSecs := 0                                                     ' and clear user request
        bFired := TRUE
    elseif motorStopHallTicks > 0
        if (ltWheel.getposTrkHallTicks() + ltWheel.frontStopTicks() >= motorStopHallTicks) or (rtWheel.getposTrkHallTicks() + rtWheel.frontStopTicks() >= motorStopHallTicks)
            debug[user.DBGCH_SENSE]("-STEER- distance limit reached")
            motorStopHallTicks := 0                                             ' and clear user request
            bFired := TRUE

PRI frontServiceRequests() : bExit | openMask, eClass, slotIdx, slotBit, bTaken, seqTaken, eCmd, motorMask, nArg1, nArg2, nArg3, bWaited, bDidWait, eStatus, eLeftStatus, eRightStatus
' FRONT COG: take, apply and answer the open request slots once: REQ_ESTOP, then REQ_STOP, then the rest, then EXIT.
'
' @returns bExit - T/F where T means an EXIT was taken: every open slot has been answered and the loop must park

' Local Variables:
' @local openMask - bit per slot: open at the first sweep and not yet handled in this pass
' @local eClass - the request class being applied (REQ_CLASS_*)
' @local slotIdx - the slot, which is the calling cog's id
' @local slotBit - {slotIdx}'s bit in openMask
' @local bTaken - T/F where T means the slot's copy is one whole, unanswered request
' @local seqTaken - the sequence of the copied request
' @local eCmd - the copied REQ_* code
' @local motorMask - the copied owned-motor selector
' @local nArg1 - the copied first argument
' @local nArg2 - the copied second argument
' @local nArg3 - the copied third argument
' @local bWaited - T/F where T means a request has already spent this pass's one bounded wait
' @local bDidWait - T/F where T means the request just applied waited
' @local eStatus - the applied request's platform status
' @local eLeftStatus - the applied request's left wheel status
' @local eRightStatus - the applied request's right wheel status

    bExit := FALSE
    openMask := 0
    repeat slotIdx from 0 to ltWheel.COG_SLOT_COUNT - 1
        seqTaken := reqSeq[slotIdx]
        if (seqTaken <> ltWheel.SEQ_IDLE) and (seqTaken <> ackSeq[slotIdx])
            openMask |= 1 << slotIdx

    if openMask <> 0
        bWaited := FALSE
        repeat eClass from ltWheel.REQ_CLASS_ESTOP to ltWheel.REQ_CLASS_EXIT
            repeat slotIdx from 0 to ltWheel.COG_SLOT_COUNT - 1
                slotBit := 1 << slotIdx
                if (openMask & slotBit) <> 0
                    bTaken, seqTaken, eCmd, motorMask, nArg1, nArg2, nArg3 := frontTakeSlot(slotIdx)
                    if bTaken == FALSE
                        openMask &= !slotBit                                    ' withdrawn by its caller, or already answered
                    elseif requestClass(eCmd) == eClass
                        openMask &= !slotBit
                        ' At most one bounded wait per pass: a second waiting request is left posted, and
                        '  taken in the next pass. Non-waiting requests are applied regardless.
                        if eClass == ltWheel.REQ_CLASS_EXIT
                            bExit := TRUE                                       ' answered by frontAnswerForExit(), after every other slot
                        elseif (bWaited == FALSE) or (requestWaits(eCmd, nArg3) == FALSE)
                            eStatus, eLeftStatus, eRightStatus, bDidWait := frontApply(eCmd, motorMask, nArg1, nArg2, nArg3)
                            if bDidWait == TRUE
                                bWaited := TRUE
                            answerSlot(slotIdx, seqTaken, eStatus, eLeftStatus, eRightStatus)
        if bExit == TRUE
            frontAnswerForExit()

PRI frontAnswerForExit() | slotIdx, bTaken, seqTaken, eCmd, motorMask, nArg1, nArg2, nArg3, eStatus
' FRONT COG, on EXIT: answer every other open request, then acknowledge each EXIT, so stop() cogstops a cog with nothing left to say.
'

' Local Variables:
' @local slotIdx - the slot, which is the calling cog's id
' @local bTaken - T/F where T means the slot's copy is one whole, unanswered request
' @local seqTaken - the sequence of the copied request
' @local eCmd - the copied REQ_* code
' @local motorMask - the copied owned-motor selector
' @local nArg1 - the copied first argument
' @local nArg2 - the copied second argument
' @local nArg3 - the copied third argument
' @local eStatus - the platform status answered for a non-EXIT request

    ' securing requests are still applied (neither waits) and answered NO_ERROR; the rest ERR_NOT_STARTED
    repeat slotIdx from 0 to ltWheel.COG_SLOT_COUNT - 1
        bTaken, seqTaken, eCmd, motorMask, nArg1, nArg2, nArg3 := frontTakeSlot(slotIdx)
        if (bTaken == TRUE) and (eCmd <> ltWheel.REQ_EXIT)
            eStatus := ERR_NOT_STARTED
            if requestClass(eCmd) <> ltWheel.REQ_CLASS_OTHER
                eStatus, _, _, _ := frontApply(eCmd, motorMask, nArg1, nArg2, nArg3)
            answerSlot(slotIdx, seqTaken, eStatus, NO_ERROR, NO_ERROR)
    ' acknowledged last: the stop() waiting on this may cogstop this cog at once
    repeat slotIdx from 0 to ltWheel.COG_SLOT_COUNT - 1
        bTaken, seqTaken, eCmd, motorMask, nArg1, nArg2, nArg3 := frontTakeSlot(slotIdx)
        if (bTaken == TRUE) and (eCmd == ltWheel.REQ_EXIT)
            answerSlot(slotIdx, seqTaken, NO_ERROR, NO_ERROR, NO_ERROR)

PRI frontTakeSlot(slotIdx) : bTaken, seqTaken, eCmd, motorMask, nArg1, nArg2, nArg3
' FRONT COG: copy one request slot and prove the copy is one whole, unanswered request.
'
' @param slotIdx - the slot, which is the calling cog's id
' @returns bTaken - T/F where T means the copy below is one whole request that has not been answered
' @returns seqTaken - the sequence the copy belongs to
' @returns eCmd - the copied REQ_* code
' @returns motorMask - the copied owned-motor selector
' @returns nArg1 - the copied first argument
' @returns nArg2 - the copied second argument
' @returns nArg3 - the copied third argument

    seqTaken := reqSeq[slotIdx]
    eCmd := reqCmd[slotIdx]
    motorMask := reqMask[slotIdx]
    nArg1 := reqArg1[slotIdx]
    nArg2 := reqArg2[slotIdx]
    nArg3 := reqArg3[slotIdx]
    ' re-read LAST: a caller writes its arguments only after withdrawing, and never reuses a sequence,
    '  so an unchanged sequence proves every copy above was taken from one published request
    bTaken := (seqTaken <> ltWheel.SEQ_IDLE) and (seqTaken <> ackSeq[slotIdx]) and (reqSeq[slotIdx] == seqTaken)

PRI answerSlot(slotIdx, seqTaken, eStatus, eLeftStatus, eRightStatus)
' FRONT COG: answer one request: the per-wheel statuses first, then the platform status, the acknowledgement last.
'
' @param slotIdx - the slot, which is the calling cog's id
' @param seqTaken - the sequence being answered
' @param eStatus - the platform status, NO_ERROR or an ERR_* code
' @param eLeftStatus - the left wheel's status
' @param eRightStatus - the right wheel's status

    ackMotorStatus[slotIdx * OWNED_MOTOR_MAX + LEFT_MOTOR_IDX] := eLeftStatus
    ackMotorStatus[slotIdx * OWNED_MOTOR_MAX + RIGHT_MOTOR_IDX] := eRightStatus
    ackStatus[slotIdx] := eStatus
    ackSeq[slotIdx] := seqTaken

PRI requestClass(eCmd) : eClass
' Return the class that orders a request within a pass.
'
' @param eCmd - a REQ_* code
' @returns eClass - REQ_CLASS_ESTOP, REQ_CLASS_STOP, REQ_CLASS_EXIT, or REQ_CLASS_OTHER for every other code

    case eCmd
        ltWheel.REQ_ESTOP:
            eClass := ltWheel.REQ_CLASS_ESTOP
        ltWheel.REQ_STOP:
            eClass := ltWheel.REQ_CLASS_STOP
        ltWheel.REQ_EXIT:
            eClass := ltWheel.REQ_CLASS_EXIT
        other:
            eClass := ltWheel.REQ_CLASS_OTHER

PRI requestWaits(eCmd, nArg3) : bWaits
' Return TRUE for a request whose apply may spend a bounded in-pass wait on the drivers.
'
' @param eCmd - a REQ_* code
' @param nArg3 - the request's third argument (bSync for REQ_DRIVE)
' @returns bWaits - T/F where T means a synchronized REQ_DRIVE, a REQ_DRIVE_DISTANCE (always synchronized here), a
'  REQ_CLEAR_ESTOP or REQ_CLEAR_PROTECT, or any REQ_DRIVE while either wheel is FAULTED (PL-66's fault-clear wait)

    bWaits := (eCmd == ltWheel.REQ_CLEAR_ESTOP) or (eCmd == ltWheel.REQ_CLEAR_PROTECT) or (eCmd == ltWheel.REQ_DRIVE_DISTANCE) or ((eCmd == ltWheel.REQ_DRIVE) and ((nArg3 <> FALSE) or (ltWheel.getDriverState() == ltWheel.DCS_FAULTED) or (rtWheel.getDriverState() == ltWheel.DCS_FAULTED)))

PRI frontApply(eCmd, motorMask, nArg1, nArg2, nArg3) : eStatus, eLeftStatus, eRightStatus, bDidWait | bLeft, bRight
' FRONT COG: apply one taken request to the selected wheels; records nothing, the statuses travel back as data.
'
' @param eCmd - the REQ_* code
' @param motorMask - the owned-motor selector: LEFT_MOTOR_BIT, RIGHT_MOTOR_BIT or BOTH_MOTORS
' @param nArg1 - first argument, meaning per REQ_*
' @param nArg2 - second argument, meaning per REQ_*
' @param nArg3 - third argument, meaning per REQ_*
' @returns eStatus - the platform status: NO_ERROR
' @returns eLeftStatus - the left wheel's status: NO_ERROR, ERR_EMERGENCY_STOPPED, ERR_SYNC_TIMEOUT or ERR_NO_RESPONSE
' @returns eRightStatus - the right wheel's status: NO_ERROR, ERR_EMERGENCY_STOPPED, ERR_SYNC_TIMEOUT or ERR_NO_RESPONSE
' @returns bDidWait - T/F where T means this request spent a bounded wait on the drivers

' Local Variables:
' @local bLeft - T/F where T means the left wheel is selected
' @local bRight - T/F where T means the right wheel is selected

    ' Request arguments here:
    '  REQ_DRIVE          - arg1 left power, arg2 right power, arg3 bSync
    '  REQ_DRIVE_DISTANCE - arg1 stop ticks, arg2 left power, arg3 right power (always synchronized; tracking reset)
    '  REQ_LIMIT_TICKS    - arg1 stop ticks, arg2 bResetTracking
    '  REQ_LIMIT_TIME     - arg1 getms() deadline
    '  REQ_TEST_INCREMENT - arg1 raw increment, for the one selected wheel
    eStatus := NO_ERROR
    eLeftStatus := NO_ERROR
    eRightStatus := NO_ERROR
    bDidWait := FALSE
    bLeft := (motorMask & LEFT_MOTOR_BIT) <> 0
    bRight := (motorMask & RIGHT_MOTOR_BIT) <> 0
    case eCmd
        ltWheel.REQ_ESTOP:
            if bLeft == TRUE
                ltWheel.frontEStop(TRUE)
            if bRight == TRUE
                rtWheel.frontEStop(TRUE)
        ltWheel.REQ_STOP:
            if bLeft == TRUE
                ltWheel.frontZeroPower()                                       ' PL-52: a commanded stop clears getPower() too
            if bRight == TRUE
                rtWheel.frontZeroPower()
        ltWheel.REQ_CLEAR_ESTOP:
            ' a protective stop is released only by its own clear
            if bLeft == TRUE
                eLeftStatus := ltWheel.getProtectiveStop()
            if bRight == TRUE
                eRightStatus := rtWheel.getProtectiveStop()
            if (eLeftStatus == NO_ERROR) and (eRightStatus == NO_ERROR)
                eLeftStatus, eRightStatus, bDidWait := frontClearEStops(bLeft, bRight)
        ltWheel.REQ_CLEAR_PROTECT:
            ' only a wheel with a latched protective stop is released: a user's e-stop is not released here
            bLeft &= (ltWheel.getProtectiveStop() <> NO_ERROR)
            bRight &= (rtWheel.getProtectiveStop() <> NO_ERROR)
            if bLeft == TRUE
                ltWheel.frontClearProtective()
            if bRight == TRUE
                rtWheel.frontClearProtective()
            eLeftStatus, eRightStatus, bDidWait := frontClearEStops(bLeft, bRight)
        ltWheel.REQ_SET_LIMITS:
            if bLeft == TRUE
                ltWheel.frontSetCurrentLimits(nArg1, nArg2)
            if bRight == TRUE
                rtWheel.frontSetCurrentLimits(nArg1, nArg2)
        ltWheel.REQ_DRIVE:
            eLeftStatus, eRightStatus, bDidWait := frontDriveWheels(bLeft, bRight, nArg1, nArg2, nArg3 <> FALSE)
        ltWheel.REQ_DRIVE_DISTANCE:
            ' atomic: tracking reset, limit armed and wheels driven, or none of it (I1 item 2)
            eLeftStatus, eRightStatus := frontRefusals(bLeft, bRight)
            if (eLeftStatus == NO_ERROR) and (eRightStatus == NO_ERROR)
                frontResetPlatformTracking()
                motorStopHallTicks := nArg1                                     ' the time limit is kept, as before
                eLeftStatus, eRightStatus, bDidWait := frontDriveWheels(bLeft, bRight, nArg2, nArg3, TRUE)
        ltWheel.REQ_LIMIT_TICKS:
            if nArg2 <> FALSE
                frontResetPlatformTracking()                                    ' F-4: the limit counts from here
            motorStopHallTicks := nArg1
        ltWheel.REQ_LIMIT_TIME:
            motorStopMSecs := nArg1
        ltWheel.REQ_RESET_TRACKING:
            frontResetPlatformTracking()
        ltWheel.REQ_RESET_MAX:
            if bLeft == TRUE
                ltWheel.frontResetMax()
            if bRight == TRUE
                rtWheel.frontResetMax()
        ltWheel.REQ_TEST_INCREMENT:
            eLeftStatus, eRightStatus := frontRefusals(bLeft, bRight)
            if (eLeftStatus == NO_ERROR) and (eRightStatus == NO_ERROR)
                if bLeft == TRUE
                    ltWheel.frontWriteIncrement(nArg1, FALSE)
                if bRight == TRUE
                    rtWheel.frontWriteIncrement(nArg1, FALSE)

PRI frontRefusals(bLeft, bRight) : eLeftStatus, eRightStatus
' FRONT COG: return the refusal (protective code, else ERR_EMERGENCY_STOPPED) for each selected wheel that must refuse a drive.
'
' @param bLeft - T/F where T means the left wheel is selected
' @param bRight - T/F where T means the right wheel is selected
' @returns eLeftStatus - the left wheel's refusal when it is selected, else NO_ERROR
' @returns eRightStatus - the right wheel's refusal when it is selected, else NO_ERROR

    eLeftStatus := NO_ERROR
    eRightStatus := NO_ERROR
    if bLeft == TRUE
        eLeftStatus := ltWheel.frontRefusal()
    if bRight == TRUE
        eRightStatus := rtWheel.frontRefusal()

PRI frontZeroSelected(bLeft, bRight)
' FRONT COG: zero each selected wheel's commanded power (PL-52) -- the platform-level "do not drive
' one wheel" fallback shared by frontDriveWheels()'s failure paths.
'
' @param bLeft - T/F where T means the left wheel is zeroed
' @param bRight - T/F where T means the right wheel is zeroed

    if bLeft == TRUE
        ltWheel.frontZeroPower()
    if bRight == TRUE
        rtWheel.frontZeroPower()

PRI frontClearFaults(bLeft, bRight) : eLeftStatus, eRightStatus, bDidWait | bLeftDidWait, bRightDidWait
' FRONT COG: clear a FAULTED state on each selected wheel, bounded (PL-66); a no-op per wheel if not FAULTED.
' Both selected wheels are cleared before frontDriveWheels() writes either one's command: a
' platform must not decide, on one wheel's fault-clear result, whether to drive the other.
'
' @param bLeft - T/F where T means the left wheel is selected
' @param bRight - T/F where T means the right wheel is selected
' @returns eLeftStatus - NO_ERROR, or ERR_NO_RESPONSE when the left wheel was FAULTED and did not clear in the bound
' @returns eRightStatus - NO_ERROR, or ERR_NO_RESPONSE when the right wheel was FAULTED and did not clear in the bound
' @returns bDidWait - T/F where T means either wheel spent a bounded fault-clear wait

' Local Variables:
' @local bLeftDidWait - T/F where T means the left wheel spent a fault-clear wait
' @local bRightDidWait - T/F where T means the right wheel spent a fault-clear wait

    eLeftStatus := NO_ERROR
    eRightStatus := NO_ERROR
    bDidWait := FALSE
    if bLeft == TRUE
        eLeftStatus, bLeftDidWait := ltWheel.frontClearFault()
        if bLeftDidWait == TRUE
            bDidWait := TRUE
    if bRight == TRUE
        eRightStatus, bRightDidWait := rtWheel.frontClearFault()
        if bRightDidWait == TRUE
            bDidWait := TRUE

PRI frontDriveWheels(bLeft, bRight, leftPower, rightPower, bSync) : eLeftStatus, eRightStatus, bDidWait | atnMask, bLeftTaken, bRightTaken, bLeftDidWait, bRightDidWait
' FRONT COG: drive the selected wheels, or refuse them all while any is emergency-stopped or fails to
' clear a fault; with {bSync}, one ATN and one bounded wait.
' INVARIANT: a platform never drives one selected wheel while refusing the other -- every path
'  below either writes and releases both selected wheels' commands together, or zeroes both and
'  writes neither. PL-66: both selected wheels' faults are cleared together, before either's command
'  is written, so one wheel's failed clear can never leave the other driving alone.
'
' @param bLeft - T/F where T means the left wheel is selected
' @param bRight - T/F where T means the right wheel is selected
' @param leftPower - left motor power [(-100) to 100], saturated to that range; 0 stops
' @param rightPower - right motor power [(-100) to 100], saturated to that range; 0 stops
' @param bSync - T/F where T means both commands are released together by one ATN
' @returns eLeftStatus - NO_ERROR (see INVARIANT: not driven does not always mean an error of its own), ERR_EMERGENCY_STOPPED, ERR_NO_RESPONSE (a FAULTED left wheel did not clear) or ERR_SYNC_TIMEOUT
' @returns eRightStatus - NO_ERROR (see INVARIANT), ERR_EMERGENCY_STOPPED, ERR_NO_RESPONSE (a FAULTED right wheel did not clear) or ERR_SYNC_TIMEOUT
' @returns bDidWait - T/F where T means a bounded wait (a fault clear on either wheel, the sync take, or both) was spent

' Local Variables:
' @local atnMask - the selected drivers' cog bits
' @local bLeftTaken - T/F where T means the left driver took its command in the bound
' @local bRightTaken - T/F where T means the right driver took its command in the bound
' @local bLeftDidWait - T/F where T means the left wheel's write spent a (residual) fault-clear wait
' @local bRightDidWait - T/F where T means the right wheel's write spent a (residual) fault-clear wait

    bDidWait := FALSE
    ' a platform never drives one wheel: while any selected wheel is emergency-stopped nothing is written
    eLeftStatus, eRightStatus := frontRefusals(bLeft, bRight)
    if (eLeftStatus == NO_ERROR) and (eRightStatus == NO_ERROR)
        eLeftStatus, eRightStatus, bDidWait := frontClearFaults(bLeft, bRight)     ' PL-66: clear BOTH selected wheels first
        if (eLeftStatus <> NO_ERROR) or (eRightStatus <> NO_ERROR)
            ' one selected wheel's fault did not clear -- the invariant forbids driving the other
            '  alone, so neither is written; the failing wheel carries ERR_NO_RESPONSE, the other
            '  keeps NO_ERROR (nothing wrong with it) but is not driven either
            frontZeroSelected(bLeft, bRight)
        else
            atnMask := 0
            if bLeft == TRUE
                ' frontDrive() re-checks FAULTED itself: harmless here (already cleared above), and
                '  it re-clears (its own bounded wait) in the narrow case a fault reappeared at rest
                '  between frontClearFaults() and this write
                eLeftStatus, bLeftDidWait := ltWheel.frontDrive(leftPower, bSync)
                if bLeftDidWait == TRUE
                    bDidWait := TRUE
            if bRight == TRUE
                eRightStatus, bRightDidWait := rtWheel.frontDrive(rightPower, bSync)
                if bRightDidWait == TRUE
                    bDidWait := TRUE
            if (eLeftStatus == NO_ERROR) and (eRightStatus == NO_ERROR)
                if bLeft == TRUE
                    atnMask |= ltWheel.frontDriverCogBit()
                if bRight == TRUE
                    atnMask |= rtWheel.frontDriverCogBit()
                if bSync == TRUE
                    bDidWait := TRUE
                    cogatn(atnMask)                                                ' lockstep: both drivers take their commands together
                    bLeftTaken, bRightTaken := frontWaitForDrivers(ltWheel.WAIT_SYNC_TAKEN, bLeft, bRight)
                    if (eLeftStatus == NO_ERROR) and (bLeftTaken == FALSE)
                        eLeftStatus := ERR_SYNC_TIMEOUT
                    if (eRightStatus == NO_ERROR) and (bRightTaken == FALSE)
                        eRightStatus := ERR_SYNC_TIMEOUT
                    if (bLeftTaken == FALSE) or (bRightTaken == FALSE)
                        ' audit M: a platform with one wheel driving pivots, so neither wheel keeps a
                        '  command the other did not take (each stop is confirmed on the next pass)
                        frontZeroSelected(bLeft, bRight)
            else
                ' one wheel's write itself failed (the narrow re-fault-at-rest race noted above) --
                '  the invariant still holds: zero both selected wheels rather than leave the platform
                '  driving the one that did succeed
                frontZeroSelected(bLeft, bRight)

PRI frontClearEStops(bLeft, bRight) : eLeftStatus, eRightStatus, bDidWait | bLeftLeft, bRightLeft
' FRONT COG: release the selected wheels' emergency stops and wait, bounded, until each driver has left DCS_ESTOP.
'
' @param bLeft - T/F where T means the left wheel is selected
' @param bRight - T/F where T means the right wheel is selected
' @returns eLeftStatus - NO_ERROR, or ERR_NO_RESPONSE when the left driver still reports DCS_ESTOP after the bound
' @returns eRightStatus - NO_ERROR, or ERR_NO_RESPONSE when the right driver still reports DCS_ESTOP after the bound
' @returns bDidWait - T/F where T means the bounded wait was spent

' Local Variables:
' @local bLeftLeft - T/F where T means the left driver has left DCS_ESTOP (or is not selected)
' @local bRightLeft - T/F where T means the right driver has left DCS_ESTOP (or is not selected)

    eLeftStatus := NO_ERROR
    eRightStatus := NO_ERROR
    bDidWait := FALSE
    ' each: zero command first, then the latch released, so nothing moves on the clear
    if bLeft == TRUE
        ltWheel.frontEStop(FALSE)
    if bRight == TRUE
        rtWheel.frontEStop(FALSE)
    ' answered only once the drivers have left the state, so a drive posted right after is not refused
    if ((bLeft == TRUE) and (ltWheel.isEmergency() == TRUE)) or ((bRight == TRUE) and (rtWheel.isEmergency() == TRUE))
        bDidWait := TRUE
        bLeftLeft, bRightLeft := frontWaitForDrivers(ltWheel.WAIT_ESTOP_LEFT, bLeft, bRight)
        if bLeftLeft == FALSE
            eLeftStatus := ERR_NO_RESPONSE
        if bRightLeft == FALSE
            eRightStatus := ERR_NO_RESPONSE

PRI frontWaitForDrivers(eWaitFor, bLeft, bRight) : bLeftDone, bRightDone | waitStartTicks, waitBoundTicks
' FRONT COG: busy-wait, bounded to FRONT_SYNC_WAIT_PASSES drive passes, for each selected driver to reach a condition.
'
' @param eWaitFor - WAIT_SYNC_TAKEN or WAIT_ESTOP_LEFT (the motor object's enum)
' @param bLeft - T/F where T means the left driver is waited for
' @param bRight - T/F where T means the right driver is waited for
' @returns bLeftDone - T/F where F means the left driver is selected and did not reach the condition in the bound
' @returns bRightDone - T/F where F means the right driver is selected and did not reach the condition in the bound

' Local Variables:
' @local waitStartTicks - getct() when the wait began
' @local waitBoundTicks - the bound, in system ticks

    ' a live driver answers within one drive pass (gettgtincr polls ATN every pass), so the bound is a 4x margin
    waitBoundTicks := ltWheel.FRONT_SYNC_WAIT_PASSES * ltWheel.DRIVE_PASS_US * (CLKFREQ / ltWheel.US_PER_SEC)
    waitStartTicks := getct()
    repeat
        bLeftDone := TRUE
        bRightDone := TRUE
        if eWaitFor == ltWheel.WAIT_SYNC_TAKEN
            if bLeft == TRUE
                bLeftDone := ltWheel.frontTakenSync()
            if bRight == TRUE
                bRightDone := rtWheel.frontTakenSync()
        else
            if bLeft == TRUE
                bLeftDone := (ltWheel.isEmergency() == FALSE)
            if bRight == TRUE
                bRightDone := (rtWheel.isEmergency() == FALSE)
        if ((bLeftDone == TRUE) and (bRightDone == TRUE)) or ((getct() - waitStartTicks) > waitBoundTicks)
            quit

PRI frontResetPlatformTracking()
' FRONT COG: restart both wheels' tracking, rpm windows and HDMI maxima from their current positions.
'

    ltWheel.frontResetTracking(TRUE)
    rtWheel.frontResetTracking(TRUE)

PRI postRequest(eCmd, motorMask, nArg1, nArg2, nArg3) : eStatus, eLeftStatus, eRightStatus | slotIdx, mySeq, startMs, bAnswered
' Post a request to the steering front cog from the calling cog, and wait, bounded, for its answer; records nothing.
'
' @param eCmd - the REQ_* code
' @param motorMask - the owned-motor selector: LEFT_MOTOR_BIT, RIGHT_MOTOR_BIT or BOTH_MOTORS
' @param nArg1 - first argument, meaning per REQ_*
' @param nArg2 - second argument, meaning per REQ_*
' @param nArg3 - third argument, meaning per REQ_*
' @returns eStatus - the front cog's platform status; ERR_NOT_STARTED when no front cog runs (nothing posted) or it was stopped during the wait; ERR_NO_RESPONSE when a running front cog did not answer in time (the outcome is unknown)
' @returns eLeftStatus - the front cog's status for the left wheel; NO_ERROR when unanswered
' @returns eRightStatus - the front cog's status for the right wheel; NO_ERROR when unanswered

' Local Variables:
' @local slotIdx - this cog's slot, its COGID()
' @local mySeq - the sequence this request is published under
' @local startMs - getms() when the wait began
' @local bAnswered - T/F where T means the front cog acknowledged mySeq

    slotIdx := COGID()
    eStatus := ERR_NOT_STARTED
    eLeftStatus := NO_ERROR
    eRightStatus := NO_ERROR
    if senseCog <> 0
        reqSeq[slotIdx] := ltWheel.SEQ_IDLE                                     ' 1. withdraw: nothing earlier from this slot can be taken now
        reqCmd[slotIdx] := eCmd                                                 ' 2. the request
        reqMask[slotIdx] := motorMask
        reqArg1[slotIdx] := nArg1
        reqArg2[slotIdx] := nArg2
        reqArg3[slotIdx] := nArg3
        mySeq := reqNextSeq[slotIdx] + 1                                        ' 3. a fresh, monotonic sequence, never SEQ_IDLE
        if mySeq == ltWheel.SEQ_IDLE
            mySeq++
        reqNextSeq[slotIdx] := mySeq
        reqSeq[slotIdx] := mySeq                                                ' 4. publish, LAST

        bAnswered := FALSE                                                      ' 5. wait, bounded
        startMs := getms()
        repeat
            waitms(ltWheel.REQ_POLL_MS)
            if ackSeq[slotIdx] == mySeq
                bAnswered := TRUE
                quit
            if getms() - startMs > ltWheel.REQ_ACK_TIMEOUT_MS
                quit
        if bAnswered == FALSE
            reqSeq[slotIdx] := ltWheel.SEQ_IDLE                                 ' withdraw: the front cog can no longer take it
            bAnswered := (ackSeq[slotIdx] == mySeq)                             ' answered in the instant before the withdraw
        if bAnswered == TRUE
            ' all written before ackSeq, so they are this answer's
            eLeftStatus := ackMotorStatus[slotIdx * OWNED_MOTOR_MAX + LEFT_MOTOR_IDX]
            eRightStatus := ackMotorStatus[slotIdx * OWNED_MOTOR_MAX + RIGHT_MOTOR_IDX]
            eStatus := ackStatus[slotIdx]
        elseif senseCog <> 0
            eStatus := ERR_NO_RESPONSE
        ' else: the front cog was stopped while this cog waited, ERR_NOT_STARTED

PUB showDriveStates()
'' for TESTING dump curr drive states
''

    reportMotorStatus()
    reportDrvStatus()
    reportFaultStatus()

PRI reportDrvStatus() | ltState, rtState
    ltState, rtState := getDriverState()
    showDriverState(ltState, @"ltMot")
    showDriverState(rtState, @"rtMot")

PRI reportMotorStatus() | ltStatus, rtStatus
    ltStatus, rtStatus := getStatus()
    showStatus(ltStatus, @"ltMot")
    showStatus(rtStatus, @"rtMot")

PRI reportFaultStatus() | bLeftStatus, bRightStatus
    bLeftStatus, bRightStatus := getFaultStatus()
    showFaultStatus(bLeftStatus, @"ltMot", false)       ' false = only show if faulted
    showFaultStatus(bRightStatus, @"rtMot", false)

PRI showDriveStatesOnChange()
    reportDrvStatusOnChange()
    reportMotorStatusOnChange()
    reportMotorFaultOnChange()

PRI reportDrvStatusOnChange() | ltState, rtState
    ltState, rtState := getDriverState()
    if priorLtState <> ltState
        showDriverState(ltState, @"ltMot")
        priorLtState := ltState

    if priorRtState <> rtState
        showDriverState(rtState, @"rtMot")
        priorRtState := rtState

PRI reportMotorStatusOnChange() | ltStatus, rtStatus
    ltStatus, rtStatus := getStatus()
    if priorLtStatus <> ltStatus
        showStatus(ltStatus, @"ltMot")
        priorLtStatus := ltStatus

    if priorRtStatus <> rtStatus
        showStatus(rtStatus, @"rtMot")
        priorRtStatus := rtStatus

PRI reportMotorFaultOnChange() | bLeftStatus, bRightStatus
    bLeftStatus, bRightStatus := getFaultStatus()
    if priorLtFault <> bLeftStatus
        showFaultStatus(bLeftStatus, @"ltMot", true)       ' force output
        priorLtFault := bLeftStatus

    if priorRtFault <> bRightStatus
        showFaultStatus(bRightStatus, @"rtMot", true)
        priorRtFault := bRightStatus

DAT { debug strings }

    dsUnknown       BYTE    "dsUnk",0
    dsMOVING        BYTE    "dsMov",0
    dsHOLDING       BYTE    "dsHld",0
    dsOFF           BYTE    "dsOff",0
    dsFAULTED       BYTE    "dsFlt",0
    dsESTOP         BYTE    "dsEStp",0
    dsOther         BYTE    "?ds0x"
    dsOtherVal      BYTE    "00-[CODE]?",0

    dcsUnknown      BYTE    "dcsUnk",0
    dcsSTOPPED      BYTE    "dcsSTOPPED",0
    dcsSPIN_UP      BYTE    "dcsSPIN_UP",0
    dcsAT_SPEED     BYTE    "dcsAT_SPEED",0
    dcsSPIN_DN      BYTE    "dcsSPIN_DN",0
    dcsSLOW_TO_CHG  BYTE    "dcsSLOW_TO_CHG",0
    dcsFAULTED      BYTE    "dcsFAULTED",0
    dcsESTOP        BYTE    "dcsESTOP",0
    dcsOther        BYTE    "?dcs0x"
    dcsOtherVal     BYTE    "00-[CODE]?",0

    pStatVal        LONG    0
    priorLtStatus   LONG    -1
    priorRtStatus   LONG    -1
    priorLtState    LONG    -1
    priorRtState    LONG    -1
    priorLtFault   LONG    -3
    priorRtFault   LONG    -3


PRI showDriverState(eState, pMsg)
    case eState
        DCS_Unknown:
            pStatVal := @dcsUnknown
        DCS_STOPPED:
            pStatVal := @dcsSTOPPED
        DCS_SPIN_UP:
            pStatVal := @dcsSPIN_UP
        DCS_AT_SPEED:
            pStatVal := @dcsAT_SPEED
        DCS_SPIN_DN:
            pStatVal := @dcsSPIN_DN
        DCS_SLOW_TO_CHG:
            pStatVal := @dcsSLOW_TO_CHG
        DCS_FAULTED:
            pStatVal := @dcsFAULTED
        DCS_ESTOP:
            pStatVal := @dcsESTOP
        other:
            placeAsciiDigits(@dcsOtherVal, eState)
            pStatVal := @dcsOther
    debug[user.DBGCH_SENSE]("- STATE ", zstr_(pMsg), ": ", zstr_(pStatVal))

PRI showStatus(eStatus, pMsg)
    case eStatus
        DS_Unknown:
            pStatVal := @dsUnknown
        DS_MOVING:
            pStatVal := @dsMOVING
        DS_HOLDING:
            pStatVal := @dsHOLDING
        DS_OFF:
            pStatVal := @dsOFF
        DS_FAULTED:
            pStatVal := @dsFAULTED
        DS_ESTOP:
            pStatVal := @dsESTOP
        other:
            placeAsciiDigits(@dsOtherVal, eStatus)
            pStatVal := @dsOther
    debug[user.DBGCH_SENSE]("- STATUS ", zstr_(pMsg), ": ", zstr_(pStatVal))

PRI showFaultStatus(bStatus, pMsg, bForceOutput)
    if bStatus == true
        debug[user.DBGCH_FAULT]("- FAULT! ", zstr_(pMsg))
    elseif bStatus == false and bForceOutput == true
        debug[user.DBGCH_FAULT]("- no FAULT ", zstr_(pMsg))

PRI placeAsciiDigits(pStrBytes, byt) | hiNyb, lowNyb
        hiNyb := byt & $f0 >> 4 + $30
        if hiNyb > $39
            hiNyb += 7
        lowNyb := byt & $0f      + $30
        if lowNyb > $39
            lowNyb += 7
        BYTE [pStrBytes][0] := hiNyb
        BYTE [pStrBytes][1] := lowNyb


PRI MAX(nLtVal,nRtVal) : nMax
' return max of nLtVal or nRtVal
    nMax := (nLtVal > nRtVal) ? nLtVal : nRtVal

CON { --- HDMI Debug Support --- }

CON { Constants for HDMI Debug }

    DBG_GROUPS_CT = 1
    DBG_MAX_VARS_IN_GROUP = 7

VAR { Data Structure for HDMI Debug }

    LONG    pTitlesAr[DBG_GROUPS_CT + 1]    ' first value is max vars
    LONG    pVarCtAr[DBG_GROUPS_CT]
    LONG    pNamesAr[DBG_GROUPS_CT * DBG_MAX_VARS_IN_GROUP]
    LONG    pValsAr[DBG_GROUPS_CT*DBG_MAX_VARS_IN_GROUP]

DAT { Literals for HDMI Debug }

' user stearing data
'---+-----------+---+---+---+-------------------+---+---+---+---+---+-----------+
nameTitle1      BYTE    "Steering",0
name10          BYTE    "power",0
name11          BYTE    "direc.",0
name12          BYTE    "ltPwr",0
name13          BYTE    "rtPwr",0
name14          BYTE    "stpTck",0
name15          BYTE    "stpmSec",0
name16          BYTE    "Cutoff",0
nextAddr1
dataLen1        LONG    @nextAddr1 - @nameTitle1

PRI loadDisplayList() | nGrpOffset, nValsGrpOffset, nVarsInGroup
' do internal one-time setup of driver debug data
    nGrpOffset := 0
    nVarsInGroup := 7
    LONG[@pTitlesAr][nGrpOffset] := @nameTitle1
    LONG[@pVarCtAr][nGrpOffset] := nVarsInGroup
    ' populate the empty name/value ptr tables
    nValsGrpOffset := nGrpOffset * DBG_MAX_VARS_IN_GROUP
    LONG[@pNamesAr][nValsGrpOffset + 0] := @name10
    LONG[@pNamesAr][nValsGrpOffset + 1] := @name11
    LONG[@pNamesAr][nValsGrpOffset + 2] := @name12
    LONG[@pNamesAr][nValsGrpOffset + 3] := @name13
    LONG[@pNamesAr][nValsGrpOffset + 4] := @name14
    LONG[@pNamesAr][nValsGrpOffset + 5] := @name15
    LONG[@pNamesAr][nValsGrpOffset + 6] := @name16
    LONG[@pValsAr][nValsGrpOffset + 0] := @rqstPower
    LONG[@pValsAr][nValsGrpOffset + 1] := @rqstDirection
    LONG[@pValsAr][nValsGrpOffset + 2] := @rqstLtPower
    LONG[@pValsAr][nValsGrpOffset + 3] := @rqstRtPower
    LONG[@pValsAr][nValsGrpOffset + 4] := @motorStopHallTicks
    LONG[@pValsAr][nValsGrpOffset + 5] := @motorStopMSecs
    LONG[@pValsAr][nValsGrpOffset + 6] := @userCutoff

    ' tell our table size to reader
    nGrpOffset := 1
    LONG[@pTitlesAr][nGrpOffset] := DBG_MAX_VARS_IN_GROUP

PUB getDebugData() : nGroups, pGroupTitles, pGroupNames, pGroupVarCts, pGroupVars | tmpAbsPtr
'' Return pointers to HDMI-debug data structures for this motor-object instance
''

    loadDisplayList()
    nGroups := DBG_GROUPS_CT
    pGroupTitles := @pTitlesAr         ' pStr = long[pTitlesAr][grpIdx]
    pGroupVarCts := @pVarCtAr          ' nNbrGrpVars = long[pVarCtAr][grpIdx]
    pGroupNames := @pNamesAr           ' pGrpNameAr = long[pNamesAr][grpIdx], pVarName = long[pNameAr][varIdx]  where varIdx is from 0 to nNbrGrpVars - 1
    pGroupVars := @pValsAr             ' pGrpLongVar = long[pValsAr][grpIdx][varIdx]  where varIdx is from 0 to nNbrGrpVars - 1
    ' DBGCH_HDMI_DUMP (off by default) replaces the runtime showHDMIDebug flag, which nothing ever set TRUE
    debug[user.DBGCH_HDMI_DUMP]("* -------------")
    debug[user.DBGCH_HDMI_DUMP]("* NAMEs SOURCE1: ", uhex_long(@nameTitle1), uhex_byte_array(@nameTitle1, dataLen1))
    debug[user.DBGCH_HDMI_DUMP]("* -------------")
    debug[user.DBGCH_HDMI_DUMP]("* Steer DL title: ", uhex_long(@pTitlesAr), uhex_long_array(@pTitlesAr, DBG_GROUPS_CT + 1))
    debug[user.DBGCH_HDMI_DUMP]("* Steer DL VarCt: ", uhex_long(@pVarCtAr), uhex_long_array(@pVarCtAr, DBG_GROUPS_CT))
    debug[user.DBGCH_HDMI_DUMP]("* Steer DL Names: ", uhex_long(@pNamesAr), uhex_long_array(@pNamesAr, DBG_GROUPS_CT * DBG_MAX_VARS_IN_GROUP))
    debug[user.DBGCH_HDMI_DUMP]("* Steer DL Values: ", uhex_long(@pValsAr), uhex_long_array(@pValsAr, DBG_GROUPS_CT * DBG_MAX_VARS_IN_GROUP))
    debug[user.DBGCH_HDMI_DUMP]("* -------------")
    debug[user.DBGCH_HDMI_DUMP]("* Steer PARM values: ", uhex_long(@nGroups), uhex_long_array(@nGroups, 5))
    debug[user.DBGCH_HDMI_DUMP]("* -------------")
    debug[user.DBGCH_HDMI_DUMP]("* Steer Sent: ", udec(nGroups), uhex_long(pGroupTitles), uhex_long(pGroupNames), uhex_long(pGroupVarCts), uhex_long(pGroupVars))
    debug[user.DBGCH_HDMI_DUMP]("* =============")



