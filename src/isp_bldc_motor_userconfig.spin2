''   Updated.... 16 Sep 2023
''
''  (This FILE only contains hardware constants, NO CODE, is used by the BLDC Motor driver software)
'' =================================================================================================
''
''  NOTE: ADJUST THIS FILE to describe the Voltage at which you are driving the motors and
''    where the driver boards are connected
''
''  !!  Make your changes ONLY at (2) below !!
''

CON { Hardware Description }

'  (1) Fixed CONSTANTS known by BLDC Motor Driver
'     --- DO NOT ADJUST ---

' Names of supported Motors
#0, MOTR_6_5_INCH, MOTR_DOCO_4KRPM

' Names of supported PinGroups
'   (added NO_USE) to make enum work, but you can't connect to it. ;-)
#0[8], PINS_P0_P15, PINS_P8_P23, PINS_P16_P31, PINS_NO_USE_P24_P39, PINS_P32_P47, PINS_P40_P55

' Names of supported voltages
#0, PWR_Unknown, PWR_6p0V, PWR_7p4V, PWR_11p1V, PWR_12p0V, PWR_14p8V, PWR_18p5V, PWR_22p2V, PWR_24p0V, PWR_25p9V
'  NOTE: Lipo battery sizes: 2s-7.4v, 3s-11.1v, 4s-14.8v, 5s-18.5v, 6s-22.2v, 7s-25.9v
'
' Board Detection Mode for BLDC driver boards
#30, BRD_AUTO_DET, BRD_REV_A, BRD_REV_B

' DEBUG output channels of isp_bldc_motor and isp_steering_2wheel (DEBUG[n]); set which are
'   compiled in with MOTOR_DBG_MASK / STEER_DBG_MASK in the "DEBUG output" section below
#0, DBGCH_ERROR, DBGCH_WARNING, DBGCH_FAULT, DBGCH_LIFECYCLE, DBGCH_DETECT, DBGCH_COMMAND, DBGCH_SENSE, DBGCH_VALIDATE, DBGCH_TEST, DBGCH_HDMI_DUMP


' Which voltages each motor supports, and its top speed at each, is in MOTOR_CHOICE.md.
'   A voltage the configured motor does not support is refused by start() (ERR_BAD_VOLTAGE).
'   Today: the DocoEng motor has no PWR_6p0V row, and neither motor has a PWR_25p9V row.
'

'     --- DO NOT ADJUST ---

' Motor Facts:

'   ---- 6.5" Wheel - BLDC built-in
'      4 degrees per hall tic
'
'   ---- Bare Motor - docoEng.com
'    24 hall tics / per rotation
'    15 degr per hall tic
'

'  6.5" wheel
'    1 wheel revolution is 360 degrees
'   90 tics per 360 degrees
'    4 degrees per hall tic
'    6 tics per tic-cycle
'   15 tic-cycles per 360 degrees
'    1 tic-cycle is 24 degrees
'     750 Max RPM, 24V

'  docoEng.com 4k RPM 24v motor
'    1 shaft revolution is 360 degrees
'   24 tics per 360 degrees
'   15 degrees per hall tic
'    6 tics per tic-cycle
'    4 tic-cycles per 360 degrees
'    1 tic-cycle is 90 degrees
'   4,000 max RPM,  24V

' Configuration Variables:
'
'  Describe which motor you connected:
'   MOTOR_TYPE = {supported motor id/name}
'
'  Describe a single motor system with:
'   ONLY_MOTOR_BASE = {base pin group}
'
'  Alternatively, Describe a dual motor system with:
'   LEFT_MOTOR_BASE = {base pin group name}
'   RIGHT_MOTOR_BASE = {base pin group name}
'
'  Describe the power you are driving the motors with:
'   DRIVE_VOLTAGE = {supported voltage name}
'
'  Describe the diameter of your wheels
'   WHEEL_DIA_IN_INCH = {fractional diameter in inches}
'    NOTE: value of zero disables diameter based motor sensor control and status
'
'  This driver can automatically recognize the RevA and RevB boards.
'  Configure Board detection for a single motor system with:
'   ONLY_BOARD_TYPE = {autodetect or override}
'
'  Alternatively, Configure Board detection for a dual motor system with:
'   LEFT_BOARD_TYPE = {autodetect or override}
'   RIGHT_BOARD_TYPE = {autodetect or override}
'
'  We suggest you always use BRD_AUTO_DET
'
'  If for some reason you wish to force a given board type you can override this
'  board detection with : [ BRD_REV_A | BRD_REV_B ]
'
'    BE WARNED! specifying a type which does NOT match your hardware will cause the
'    driver to NOT WORK!
'   (2) Please configure your settings below here
'
'  This file holds TWO configurations, and your top-level program selects one of them by
'  putting these lines at the very top of its file, before anything else:
'
'     A single-motor program (uses isp_bldc_motor directly):
'       #DEFINE CFG_SINGLE_MOTOR
'       #IFDEF __PNUT_TS__
'       #PRAGMA EXPORTDEF CFG_SINGLE_MOTOR
'       #ENDIF
'
'     A two-wheel program (uses isp_steering_2wheel):
'       #DEFINE CFG_DUAL_MOTOR
'       #IFDEF __PNUT_TS__
'       #PRAGMA EXPORTDEF CFG_DUAL_MOTOR
'       #ENDIF
'
'  The demos already carry theirs. Edit the configuration your program selects to describe
'  your hardware. A program that selects neither will not compile, and the error says what
'  to add.
'
'  Building with PNut instead of PNut-TS? PNut cannot carry your program's selection into this
'  file (#PRAGMA EXPORTDEF is a PNut-TS feature), so make the selection here instead: remove the
'  leading ' from the ONE line below that matches your program. PNut-TS ignores these two lines,
'  so they can never contradict a program's own selection. (Or give PNut -D CFG_SINGLE_MOTOR or
'  -D CFG_DUAL_MOTOR on its command line and leave these lines as they are.)

#IFNDEF __PNUT_TS__
'#DEFINE CFG_SINGLE_MOTOR
'#DEFINE CFG_DUAL_MOTOR
#ENDIF


#IFDEF CFG_SINGLE_MOTOR

' ---- single-motor configuration: demo_single_motor, and your single-motor programs ----

    MOTOR_TYPE = MOTR_DOCO_4KRPM

    ONLY_MOTOR_BASE = PINS_P16_P31

    DRIVE_VOLTAGE = PWR_12p0V

    WHEEL_DIA_IN_INCH = 0.0   ' no wheel attached (floating point constant)

    ONLY_BOARD_TYPE = BRD_AUTO_DET

    ' ---- a check of the pin group above (do not edit). If the compiler stops on the CHECK_ line
    '  below with "Divide by zero", the comment on that line says what to change above.
    ONLY_IS_A_PIN_GROUP = (ONLY_MOTOR_BASE == PINS_P0_P15) or (ONLY_MOTOR_BASE == PINS_P8_P23) or (ONLY_MOTOR_BASE == PINS_P16_P31) or (ONLY_MOTOR_BASE == PINS_P32_P47) or (ONLY_MOTOR_BASE == PINS_P40_P55)
    CHECK_ONLY_PIN_GROUP = 1 / -ONLY_IS_A_PIN_GROUP     ' ONLY_MOTOR_BASE is not a pin group: use PINS_P0_P15, PINS_P8_P23, PINS_P16_P31, PINS_P32_P47 or PINS_P40_P55

#ELSEIFDEF CFG_DUAL_MOTOR

' ---- two-wheel configuration: demo_dual_motor*, isp_steering_serial, and your two-wheel programs ----
'  (pins for the Edge Breakout Board #64029)

    MOTOR_TYPE = MOTR_6_5_INCH

    LEFT_MOTOR_BASE = PINS_P16_P31
    RIGHT_MOTOR_BASE = PINS_P32_P47

    DRIVE_VOLTAGE = PWR_18p5V

    WHEEL_DIA_IN_INCH = 6.5   ' 6.5 inches (floating point constant)

    LEFT_BOARD_TYPE = BRD_AUTO_DET
    RIGHT_BOARD_TYPE = BRD_AUTO_DET

    ' ---- checks of the pin groups above (do not edit). If the compiler stops on a CHECK_ line
    '  below with "Divide by zero", the comment on that line says what to change above.
    LEFT_IS_A_PIN_GROUP = (LEFT_MOTOR_BASE == PINS_P0_P15) or (LEFT_MOTOR_BASE == PINS_P8_P23) or (LEFT_MOTOR_BASE == PINS_P16_P31) or (LEFT_MOTOR_BASE == PINS_P32_P47) or (LEFT_MOTOR_BASE == PINS_P40_P55)
    RIGHT_IS_A_PIN_GROUP = (RIGHT_MOTOR_BASE == PINS_P0_P15) or (RIGHT_MOTOR_BASE == PINS_P8_P23) or (RIGHT_MOTOR_BASE == PINS_P16_P31) or (RIGHT_MOTOR_BASE == PINS_P32_P47) or (RIGHT_MOTOR_BASE == PINS_P40_P55)
    GROUPS_DO_NOT_OVERLAP = abs (LEFT_MOTOR_BASE - RIGHT_MOTOR_BASE) >= 16       ' a board uses its base pin and the 15 above it
    CHECK_LEFT_PIN_GROUP = 1 / -LEFT_IS_A_PIN_GROUP     ' LEFT_MOTOR_BASE is not a pin group: use PINS_P0_P15, PINS_P8_P23, PINS_P16_P31, PINS_P32_P47 or PINS_P40_P55
    CHECK_RIGHT_PIN_GROUP = 1 / -RIGHT_IS_A_PIN_GROUP   ' RIGHT_MOTOR_BASE is not a pin group: use PINS_P0_P15, PINS_P8_P23, PINS_P16_P31, PINS_P32_P47 or PINS_P40_P55
    CHECK_GROUPS_APART = 1 / -GROUPS_DO_NOT_OVERLAP     ' LEFT_MOTOR_BASE and RIGHT_MOTOR_BASE share pins: pick two groups whose pin ranges do not overlap (e.g. PINS_P16_P31 and PINS_P32_P47)

#ELSE
#IFDEF __PNUT_TS__
#ERROR No configuration selected: put #DEFINE CFG_SINGLE_MOTOR and #PRAGMA EXPORTDEF CFG_SINGLE_MOTOR (or the same with CFG_DUAL_MOTOR) at the top of your top-level file (see DEVELOP.md)
#ENDIF
#ENDIF

{  Example settings -- copy the values you need into the configuration above

' A single 6.5" hub motor
    MOTOR_TYPE = MOTR_6_5_INCH
    ONLY_MOTOR_BASE = PINS_P16_P31
    DRIVE_VOLTAGE = PWR_12p0V
    WHEEL_DIA_IN_INCH = 6.5   ' 6.5 inches (floating point constant)
    ONLY_BOARD_TYPE = BRD_AUTO_DET

' Two 6.5" hub motors on the Mini Edge Breakout Board (#64019)
    MOTOR_TYPE = MOTR_6_5_INCH
    LEFT_MOTOR_BASE = PINS_P0_P15
    RIGHT_MOTOR_BASE = PINS_P16_P31
    DRIVE_VOLTAGE = PWR_18p5V
    WHEEL_DIA_IN_INCH = 6.5   ' 6.5 inches (floating point constant)
    LEFT_BOARD_TYPE = BRD_AUTO_DET
    RIGHT_BOARD_TYPE = BRD_AUTO_DET

' Two DocoEng motors with 3" wheels
    MOTOR_TYPE = MOTR_DOCO_4KRPM
    LEFT_MOTOR_BASE = PINS_P16_P31
    RIGHT_MOTOR_BASE = PINS_P32_P47
    DRIVE_VOLTAGE = PWR_11p1V
    WHEEL_DIA_IN_INCH = 3.0   ' 3.0 inches (floating point constant)
    LEFT_BOARD_TYPE = BRD_AUTO_DET
    RIGHT_BOARD_TYPE = BRD_AUTO_DET
}


CON { DEBUG output }

'  Choose which DEBUG output the motor and steering objects compile in (works with any config above).
'   A channel whose bit is clear generates NO code. Keep ERROR, WARNING and FAULT enabled.
'   MOTOR_DBG_MASK - isp_bldc_motor.spin2
'   STEER_DBG_MASK - isp_steering_2wheel.spin2

    MOTOR_DBG_MASK = DECOD DBGCH_ERROR | DECOD DBGCH_WARNING | DECOD DBGCH_FAULT | DECOD DBGCH_LIFECYCLE | DECOD DBGCH_DETECT | DECOD DBGCH_COMMAND | DECOD DBGCH_SENSE | DECOD DBGCH_VALIDATE | DECOD DBGCH_TEST
    STEER_DBG_MASK = DECOD DBGCH_ERROR | DECOD DBGCH_WARNING | DECOD DBGCH_FAULT | DECOD DBGCH_LIFECYCLE | DECOD DBGCH_DETECT | DECOD DBGCH_COMMAND | DECOD DBGCH_SENSE | DECOD DBGCH_VALIDATE | DECOD DBGCH_TEST

CON { pack voltage sensor }

'  The optional pack voltage sensor (VOLTAGE-SENSOR.md): a resistor divider from the battery to one P2 pin.
'   PACK_SENSOR_FITTED    - TRUE once you have built it and wired it to PACK_SENSE_PIN; FALSE (no sensor) ignores the pin
'   PACK_SENSE_PIN        - the P2 pin the sensor's yellow lead goes to: clear of your motor boards' pin groups
'   PACK_SENSE_CAL_PERMILLE - the one-time calibration: 1000 until you calibrate; then 1000 x meter / getPackVoltage()

    PACK_SENSOR_FITTED = FALSE
    PACK_SENSE_PIN = 48
    PACK_SENSE_CAL_PERMILLE = 1000

' ------------------------ Adjust your configuration ABOVE here -------------------------------------
'

PUB null()      ' This is not a top level object

CON { license }

