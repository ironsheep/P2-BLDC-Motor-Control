CON

  MAX_COUNT = 10

PUB doThing(paramOne, paramTwo) : status | localOne
'' Do a thing with two parameters and report status.
''
'' @param paramOne - first input
'' @param paramTwo - second input
'' @returns status - SUCCESS (0) or error

' Local Variables:
' @local localOne - scratch value

    status := paramOne + paramTwo + localOne

PRI helper(inputVal) : outputVal
' Helper method, PRI docs use single-quote.
'
' @param inputVal - input value
' @returns outputVal - output value

    outputVal := inputVal * 2

PUB stopSimple()
'' Stop cogs and release pins assigned to this motor.
''

    stopFlag := TRUE

PUB withInlineNoteBeforeCode()
'' Pins the C3c blind spot: a blank line separates the doc from a
'' trailing ' comment, and the comment sits directly before the code --
'' this is conformant (the blank line IS present, just not immediately
'' adjacent to the first code line) and must NOT fire C3c.
''

    ' start the housekeeping sequence
    stopFlag := FALSE

CON { license }

