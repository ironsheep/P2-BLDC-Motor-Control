CON

  MAX_COUNT = 10

PUB doThing(paramOne, paramTwo) : status
'' Do a thing -- WRONG: paramTwo has no @param tag.
''
'' @param paramOne - first input
'' @returns status - result code

    status := paramOne + paramTwo

