'' =================================================================================================
''
''   File....... S5.1.spin2
''   Purpose.... Style-gate self-test fixture -- a return value never assigned breaks Rule 5.1
''   Authors.... Stephen M Moraco
''   E-mail..... stephen@ironsheep.biz
''   Started.... 18 Sep 2026
''   Updated.... 18 Sep 2026
''
'' =================================================================================================

CON

  MAX_COUNT = 10

PUB doThing(paramOne) : status | localVal
'' Do a thing -- WRONG: status is never assigned.
''
'' @param paramOne - first input
'' @returns status - result code

' Local Variables:
' @local localVal - scratch value

    localVal := paramOne

PUB countBoth(paramOne) : firstCount, secondCount
'' Count two ways -- a multiple assignment and a 'return' each assign, and pass.
''
'' @param paramOne - first input
'' @returns firstCount - the first count
'' @returns secondCount - the second count

    firstCount, secondCount := paramOne, MAX_COUNT

CON { license }

