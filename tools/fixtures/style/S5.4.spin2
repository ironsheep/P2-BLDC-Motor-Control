'' =================================================================================================
''
''   File....... S5.4.spin2
''   Purpose.... Style-gate self-test fixture -- a boolean-returning method not named as a query breaks Rule 5.4
''   Authors.... Stephen M Moraco
''   E-mail..... stephen@ironsheep.biz
''   Started.... 18 Sep 2026
''   Updated.... 18 Sep 2026
''
'' =================================================================================================

CON

  MAX_COUNT = 10

PUB checkThing(paramOne) : bOverLimit
'' Report whether a thing is over the limit -- WRONG: a boolean query is named is/has/b.
''
'' @param paramOne - first input
'' @returns bOverLimit - T/F where T means over the limit

    bOverLimit := (paramOne > MAX_COUNT)

PUB isOverLimit(paramOne) : bOverLimit
'' Report whether a thing is over the limit -- named as a query, and passes.
''
'' @param paramOne - first input
'' @returns bOverLimit - T/F where T means over the limit

    bOverLimit := (paramOne > MAX_COUNT)

CON { license }

