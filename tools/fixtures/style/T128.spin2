CON

  MAX_COUNT = 10

PUB doThing(paramOne) : status
'' Draw a label -- WRONG: the ')' inside the quoted text ends the debug() call.
''
'' @param paramOne - first input
'' @returns status - result code

    debug(`panel 'speed (mm/s)' SIZE 200 100)
    status := paramOne

