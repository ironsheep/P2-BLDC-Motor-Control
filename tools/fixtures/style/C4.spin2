CON

  MAX_COUNT = 10

PUB doThing(paramOne) : status
'' Do a thing.
''

    status := helper(paramOne)

PRI helper(inputVal) : outputVal
'' Helper method -- WRONG: PRI docs must use ' not ''
''

    outputVal := inputVal

CON { license }

