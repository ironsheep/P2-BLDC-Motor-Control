'' =================================================================================================
''
''   File....... S5.3.spin2
''   Purpose.... Style-gate self-test fixture -- a return inside a repeat breaks Rule 5.3
''   Authors.... Stephen M Moraco
''   E-mail..... stephen@ironsheep.biz
''   Started.... 18 Sep 2026
''   Updated.... 18 Sep 2026
''
'' =================================================================================================

CON

  MAX_COUNT = 10

PUB doThing(paramOne) : status | loopIdx
'' Find a thing -- WRONG: leaves the loop with return.
''
'' @param paramOne - the value to find
'' @returns status - result code

' Local Variables:
' @local loopIdx - loop index

    status := 0
    repeat loopIdx from 0 to MAX_COUNT
        if loopIdx == paramOne
            return

CON { license }

