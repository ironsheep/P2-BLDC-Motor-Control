'' =================================================================================================
''
''   File....... S1.9.spin2
''   Purpose.... Style-gate self-test fixture -- an OBJ override of a constant this file also defines breaks Rule 1.9
''   Authors.... Stephen M Moraco
''   E-mail..... stephen@ironsheep.biz
''   Started.... 18 Sep 2026
''   Updated.... 18 Sep 2026
''
'' =================================================================================================

CON

  CHILD_LIMIT = child.CHILD_LIMIT

OBJ

  child : "lib/fixture_child" | CHILD_LIMIT = 5

PUB doThing(paramOne) : status
'' Do a thing.
''
'' @param paramOne - first input
'' @returns status - result code

    status := paramOne + CHILD_LIMIT

CON { license }

