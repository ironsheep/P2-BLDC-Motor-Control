''   Updated.... 18 Sep 2026
''
'' =================================================================================================

CON

  MAX_COUNT = 10

PUB isOverLimit(paramOne) : bOverLimit
'' Report whether a thing is over the limit -- WRONG: 1 is not TRUE.
''
'' @param paramOne - first input
'' @returns bOverLimit - T/F where T means over the limit

    bOverLimit := FALSE
    if paramOne > MAX_COUNT
        bOverLimit := 1

CON { license }

