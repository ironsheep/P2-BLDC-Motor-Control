CON ' ---- Configuration ----

  ' This is a bare separator line with no label text
  ' ===================================================
  ' This has a label: Motor Settings
  ' ===================================================
  MAX_COUNT = 10

  { This separator line is inside a brace comment block
    ' ===================================================
    It should NOT fire because braces exclude their contents
    ' ===================================================
  }

  ' Another bare separator line with underscores
  ' ___________________________________________________
  TIMEOUT = 5000

PUB doThing(paramOne) : status
'' Do a thing.
''

    status := paramOne

CON { license }

