CON

  MAX_COUNT = 10

PUB doThing(paramOne) : status | spareVal
'' Do a thing.
''
'' @param paramOne - first input
'' @returns status - result code

' Local Variables:
' @local spareVal - WRONG: never used

    status := paramOne

PUB formatThree(pFmt, argOne, argTwo, argThree) : status
'' Format through the first argument's address -- the arguments after it are used through it, and pass.
''
'' @param pFmt - format text
'' @param argOne - first argument
'' @param argTwo - second argument
'' @param argThree - third argument
'' @returns status - result code

    status := formatAll(pFmt, @argOne)

CON { license }

