''   File....... S3.1.spin2
''   Purpose.... Style-gate self-test fixture -- a file that opens with VAR instead of CON breaks Rule 3.1
''   Authors.... Stephen M Moraco
''   E-mail..... stephen@ironsheep.biz
''   Started.... 18 Sep 2026
''   Updated.... 18 Sep 2026
''
'' =================================================================================================

VAR

  LONG counterVal

CON

  MAX_COUNT = 10

PUB doThing(paramOne) : status
'' Do a thing.
''
'' @param paramOne - first input
'' @returns status - result code

    counterVal := MAX_COUNT
    status := paramOne

CON { license }

