'' =================================================================================================
''
''   File....... T29.spin2
''   Purpose.... Style-gate self-test fixture -- a ? : with a method call in a branch breaks the project rule PL-29 (T29)
''   Authors.... Stephen M Moraco
''   E-mail..... stephen@ironsheep.biz
''   Started.... 18 Sep 2026
''   Updated.... 18 Sep 2026
''
'' =================================================================================================

CON

  MAX_COUNT = 10

DAT

  sTrue   BYTE  "TRUE", 0
  sFalse  BYTE  "FALSE", 0

PUB doThing(paramOne) : status
'' Do a thing -- WRONG: both limitOf() and paramOne are evaluated.
''
'' @param paramOne - first input
'' @returns status - result code

    status := (paramOne > MAX_COUNT) ? limitOf(paramOne) : paramOne

PUB textOf(bFlag) : pText
'' Select a string -- values only, and passes, even with a call later on the line.
''
'' @param bFlag - the flag to name
'' @returns pText - pointer to TRUE or FALSE

    pText := bFlag ? @sTrue : @sFalse
    debug("flag ", zstr_(bFlag ? @sTrue : @sFalse), " at ", udec_(getms()))

PRI limitOf(inputVal) : outputVal
' Clamp to the limit.
'
' @param inputVal - input value
' @returns outputVal - clamped value

    outputVal := inputVal <# MAX_COUNT

CON { license }

