CON

  MAX_COUNT = 10

PUB doThing(paramOne) : status | localOne
'' Do a thing.
''
'' @param paramOne - input
'' @returns status - result code
'' @local localOne - scratch value (WRONG: '' instead of ')

    status := paramOne + localOne

