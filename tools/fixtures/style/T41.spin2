'' =================================================================================================
''
''   File....... T41.spin2
''   Purpose.... Style-gate self-test fixture -- a bench program's cog start/stop outside a quiet window breaks the project rule PL-41 (T41)
''   Authors.... Stephen M Moraco
''   E-mail..... stephen@ironsheep.biz
''   Started.... 18 Sep 2026
''   Updated.... 18 Sep 2026
''
'' =================================================================================================

CON

  STACK_LONGS = 32

OBJ

    benchLog : "isp_bench_log"

VAR

    LONG    idleStack[STACK_LONGS]

PUB quietStart() : spunCog
'' Start a cog inside a quiet window -- passes.
''
'' @returns spunCog - the started cog's id

    benchLog.cogEventBegin()
    spunCog := cogspin(NEWCOG, idleLoop(), @idleStack)
    benchLog.cogEventEnd()
    debug("started ", sdec_(spunCog))

PUB loudStop(spunCog)
'' Stop a cog with a print just before it -- WRONG: no quiet window opens the stop.
''
'' @param spunCog - the cog to stop

    debug("stopping ", sdec_(spunCog))
    cogstop(spunCog)

PRI idleLoop()
' Idle forever.

    repeat
        waitms(1000)

