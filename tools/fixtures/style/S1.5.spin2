CON

  MAX_COUNT = 10

PUB doThing(paramOne) : status | stopAll
'' Do a thing.
''
'' @param paramOne - first input
'' @returns status - result code

' Local Variables:
' @local stopAll - WRONG: shadows the method stopAll()

    stopAll := paramOne
    status := stopAll

PUB stopAll()
'' Stop everything.
''

    counterVal := MAX_COUNT

CON { license }

