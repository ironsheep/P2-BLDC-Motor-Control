'' =================================================================================================
''
''   File....... S2.4.spin2
''   Purpose.... Style-gate self-test fixture -- a child object's constant copied into a local CON breaks Rule 2.4
''   Authors.... Stephen M Moraco
''   E-mail..... stephen@ironsheep.biz
''   Started.... 18 Sep 2026
''   Updated.... 18 Sep 2026
''
'' =================================================================================================

CON

  CHILD_LIMIT = child.CHILD_LIMIT     ' a reference: passes
  CHILD_MODE  = 1                     ' WRONG: a copy of child.CHILD_MODE

OBJ

  child : "lib/fixture_child"

PUB doThing(paramOne) : status
'' Do a thing.
''
'' @param paramOne - first input
'' @returns status - result code

    status := paramOne + CHILD_MODE

CON { license }

