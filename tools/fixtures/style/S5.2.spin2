CON

  MAX_COUNT = 10

PUB doThing(paramOne) : status
'' Do a thing -- WRONG: two exits.
''
'' @param paramOne - first input
'' @returns status - result code

    status := 0
    if paramOne > MAX_COUNT
        return
    status := paramOne

CON { license }

