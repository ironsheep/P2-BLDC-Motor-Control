CON

  MAX_COUNT = 10

PRI helper(inputVal) : outputVal
' Helper method.
'
' @param inputVal - input value
' @returns outputVal - output value

    outputVal := inputVal * 2

PUB doThing(paramOne) : status
'' Do a thing -- WRONG: this PUB follows a PRI.
''
'' @param paramOne - first input
'' @returns status - result code

    status := helper(paramOne)

CON { license }

