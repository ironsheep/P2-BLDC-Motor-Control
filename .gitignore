# pnut-ts build artifacts -- .bin, .lst and .map (the last already covered
# above). test/bench-run.sh deliberately LEAVES these in place after a run so
# a binary can be re-loaded or a listing read by hand; they are regenerable
# and should never be committed.
*.bin
*.lst
# pnut-ts -i preprocessor output
*__pre.spin2

# Claude Code agent artifacts — configuration, not what this repo ships.
# Using these motor objects does not require an agent. (central skills v10(d))
.claude/
CLAUDE.md
.todo-mcp/
tasks/

# Dev container: local mounts, the MCP server list (both carry host paths) and
# the pnut-ts compiler zip baked into the image (large, not source).
.mcp.json
.devcontainer/docker-compose.override.yml
.devcontainer/*.zip
/pythonSrc/__pycache__
__pycache__/
# .github/scripts/make-release.sh output (the release's zips and notes)
/dist/
*.gz

